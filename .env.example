# Web3Forms API Key (get from web3forms.com)
PUBLIC_WEB3FORMS_KEY=your_access_key_here

# ClaudeKit Referral URL
PUBLIC_CLAUDEKIT_REFERRAL_URL=https://claudekit.cc/?ref=OMG49S8R

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Facebook / Meta Pixel ID
PUBLIC_FB_PIXEL_ID=

# Deals Giveaway API (Cloudflare Worker base URL — no trailing slash)
PUBLIC_GIVEAWAY_API_URL=https://your-giveaway-api.example.workers.dev

# ClaudeKit coupon claim window deadline (ISO 8601; used for auto countdown on /guides/deals)
PUBLIC_CLAUDEKIT_COUPON_END_AT=2026-05-24T23:59:59+07:00

# Surface the "Campaign ended" announcement banner on /guides/deals.
# Set to "true" when the CK coupon campaign has fully wrapped up. Leave unset
# or "false" to keep the active-campaign layout (claim widget, hero, etc.).
PUBLIC_DEALS_CAMPAIGN_ENDED=false
# Optional override for the headline stats shown in the ended banner.
PUBLIC_DEALS_CAMPAIGN_CLAIMED=80
PUBLIC_DEALS_CAMPAIGN_TOTAL=80

# Cloudflare Turnstile Site Key (use 1x00000000000000000000AA for local "always pass")
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
