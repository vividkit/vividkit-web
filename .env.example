# Web3Forms API Key (get from web3forms.com)
PUBLIC_WEB3FORMS_KEY=your_access_key_here

# Site URL (for meta tags)
PUBLIC_SITE_URL=https://vividkit.dev

# ClaudeKit Referral URL
PUBLIC_CLAUDEKIT_REFERRAL_URL=https://claudekit.cc/?ref=OMG49S8R

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Facebook / Meta Pixel ID
PUBLIC_FB_PIXEL_ID=

# Deals Giveaway API (Cloudflare Worker base URL — no trailing slash)
PUBLIC_GIVEAWAY_API_URL=https://your-giveaway-api.example.workers.dev

# Cloudflare Turnstile Site Key (use 1x00000000000000000000AA for local "always pass")
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
