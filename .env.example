# ClaudeKit Referral URL
PUBLIC_CLAUDEKIT_REFERRAL_URL=https://claudekit.cc?ref=vividkit

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_ID=

# Facebook / Meta Pixel ID
PUBLIC_FB_PIXEL_ID=
