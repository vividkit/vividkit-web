{
  "name": "tender-transit",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run verify:agentkit && astro build",
    "postbuild": "node scripts/generate-llms-full.mjs && node scripts/check-agentkit-content.mjs --postbuild",
    "check:agentkit-content": "node scripts/check-agentkit-content.mjs",
    "check:agentkit-types": "node scripts/check-agentkit-type-delta.mjs",
    "test:agentkit-content": "node --test tests/**/*.test.mjs",
    "verify:agentkit": "npm run test:agentkit-content && npm run check:agentkit-content && npm run check:agentkit-types",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@vercel/analytics": "^1.6.1",
    "alpinejs": "^3.15.2",
    "astro": "^6.0.2",
    "lucide-astro": "^0.555.0",
    "puppeteer": "^24.32.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/vercel": "^10.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/alpinejs": "^3.13.11",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
