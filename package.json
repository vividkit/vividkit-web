{
  "name": "tender-transit",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run verify:agentkit && astro build",
    "postbuild": "node scripts/sync-legacy-archive-assets.mjs && node scripts/generate-llms-full.mjs && node scripts/check-agentkit-content.mjs --postbuild && npm run test:agentkit-postbuild && node scripts/check-agentkit-dist-channel-isolation.mjs && node scripts/check-legacy-archive-boundary.mjs --postbuild --check",
    "check:agentkit-content": "node scripts/check-agentkit-content.mjs",
    "check:agentkit-types": "node scripts/check-agentkit-type-delta.mjs",
    "check:agentkit-ui": "node scripts/check-agentkit-guide-ui.mjs",
    "check:agentkit-truth-bundle": "node scripts/build-agentkit-truth-audit-bundle.mjs --check",
    "check:legacy-archive": "node scripts/verify-legacy-archive-provenance.mjs --mode auto && node scripts/check-legacy-archive-boundary.mjs --check",
    "verify:exact-toolchain": "node scripts/verify-exact-toolchain.mjs",
    "test:agentkit-content": "node --test tests/**/*.test.mjs",
    "test:agentkit-postbuild": "node --test tests/content/guide-route-manifest.test.mjs tests/content/agentkit-llm-export.test.mjs",
    "verify:agentkit": "npm run test:agentkit-content && npm run check:agentkit-content && npm run check:agentkit-types && npm run check:agentkit-truth-bundle && npm run check:legacy-archive",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/space-grotesk": "^5.2.10",
    "@vercel/analytics": "^1.6.1",
    "alpinejs": "^3.15.2",
    "astro": "7.1.0",
    "lucide-astro": "^0.555.0",
    "puppeteer": "24.43.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/vercel": "11.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/alpinejs": "^3.13.11",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
