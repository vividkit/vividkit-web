---
// FlowchartGuide header: page title, version toggle buttons, and interactive decision tree
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@legacy-ck/i18n/utils';
import FlowchartInteractive from "../FlowchartInteractive.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
const t = useTranslations(currentLang);
---

<!-- Page Header -->
<div class="text-center space-y-4">
  <h2 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
    {t("guides.flowchart.title")}
  </h2>
  <p
    class="text-lg text-slate-600 dark:text-slate-400 max-w-3xl mx-auto leading-relaxed"
  >
    {
      isVi ? (
        <>
          Hướng dẫn toàn diện để chọn command phù hợp dựa trên use case của bạn.
        </>
      ) : (
        <>A comprehensive decision tree for ClaudeKit newcomers.</>
      )
    }
  </p>
</div>

<!-- Kit Toggle (Engineer / Marketing) -->
<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h2
    class="text-2xl font-bold flex items-center gap-3 text-slate-900 dark:text-white"
  >
    <svg
      class="w-7 h-7 text-cyan-600 dark:text-cyan-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    {isVi ? "Chọn Bộ Công Cụ" : "Select Kit"}
  </h2>

  <div
    class="flex items-center gap-2 p-1 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700"
  >
    <button
      id="fc-btn-engineer"
      class="fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 bg-teal-500 text-white shadow-sm"
      data-version="engineer"
    >
      <span class="flex items-center gap-1.5">
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        {t("commands.v25.tab_v25")}
      </span>
    </button>
    <button
      id="fc-btn-marketing"
      class="fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700"
      data-version="marketing"
    >
      <span class="flex items-center gap-1.5">
        <svg
          class="w-4 h-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"
          ></path>
        </svg>
        {t("commands.v25.tab_v24")}
      </span>
    </button>
  </div>
</div>

<!-- Quick Reference Decision Tree (Interactive SVG) - Engineer Kit only -->
<div id="fc-decision-tree" class="glass-card rounded-2xl p-6 sm:p-8">
  <h3
    class="text-xl font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-2"
  >
    <svg
      class="w-5 h-5 text-cyan-500"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        d="M4 6h16M4 12h10M4 18h16"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <circle cx="18" cy="12" r="3"></circle>
    </svg>
    {isVi ? "Sơ Đồ Quyết Định Tương Tác" : "Interactive Decision Tree"}
  </h3>
  <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">
    {
      isVi
        ? "Click vào bất kỳ node hoặc đường path nào để highlight lộ trình đến command. Hoặc click vào các command button ở trên để xem đường đi tương ứng."
        : "Click on any node or path to highlight the route to that command. Or click the command buttons above to see their corresponding paths."
    }
  </p>
  <FlowchartInteractive lang={currentLang} />
</div>
