---
// FlowchartGuide Marketing Kit common workflows section
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
---

<!-- Marketing Common Workflows -->
<div class="glass-card rounded-2xl p-6 sm:p-8">
  <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
    <svg class="w-5 h-5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" stroke-linecap="round" stroke-linejoin="round"></polyline>
    </svg>
    {isVi ? "Marketing Workflows" : "Marketing Workflows"}
  </h3>

  <div class="grid md:grid-cols-2 gap-6">
    <!-- Workflow 1: Content Campaign -->
    <div class="p-5 rounded-xl bg-purple-500/5 border border-purple-200 dark:border-purple-500/20">
      <h4 class="font-bold text-purple-700 dark:text-purple-400 mb-3">
        {isVi ? "Workflow 1: Content Campaign" : "Workflow 1: Content Campaign"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono">
        <p>1. <code class="text-violet-600 dark:text-violet-400">/ck:brainstorm</code> → {isVi ? "Tìm ideas" : "Find ideas"}</p>
        <p>2. <code class="text-purple-600 dark:text-purple-400">/ckm:plan</code> → {isVi ? "Lên kế hoạch" : "Create plan"}</p>
        <p>3. <code class="text-pink-600 dark:text-pink-400">/ckm:write:good</code> → {isVi ? "Viết content" : "Write content"}</p>
        <p>4. <code class="text-purple-600 dark:text-purple-400">/ckm:social</code> → {isVi ? "Schedule posts" : "Schedule posts"}</p>
        <p>5. <code class="text-blue-600 dark:text-blue-400">/ckm:analyze</code> → {isVi ? "Đo lường" : "Measure results"}</p>
      </div>
    </div>

    <!-- Workflow 2: Email Campaign -->
    <div class="p-5 rounded-xl bg-pink-500/5 border border-pink-200 dark:border-pink-500/20">
      <h4 class="font-bold text-pink-700 dark:text-pink-400 mb-3">
        {isVi ? "Workflow 2: Email Campaign" : "Workflow 2: Email Campaign"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono">
        <p>1. <code class="text-blue-600 dark:text-blue-400">/ckm:persona</code> → {isVi ? "Xác định audience" : "Define audience"}</p>
        <p>2. <code class="text-purple-600 dark:text-purple-400">/ckm:email</code> → {isVi ? "Design flow" : "Design email flow"}</p>
        <p>3. <code class="text-pink-600 dark:text-pink-400">/ckm:write:cro</code> → {isVi ? "Viết copy" : "Write CRO copy"}</p>
        <p>4. <code class="text-purple-600 dark:text-purple-400">/ckm:campaign</code> → {isVi ? "Launch" : "Launch campaign"}</p>
        <p>5. <code class="text-teal-600 dark:text-teal-400">/ckm:analyze</code> → {isVi ? "Đo hiệu suất" : "Measure performance"}</p>
      </div>
    </div>

    <!-- Workflow 3: Product Launch -->
    <div class="p-5 rounded-xl bg-emerald-500/5 border border-emerald-200 dark:border-emerald-500/20">
      <h4 class="font-bold text-emerald-700 dark:text-emerald-400 mb-3">
        {isVi ? "Workflow 3: Product Launch" : "Workflow 3: Product Launch"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono">
        <p>1. <code class="text-blue-600 dark:text-blue-400">/ckm:competitor</code> → {isVi ? "Research market" : "Research market"}</p>
        <p>2. <code class="text-emerald-600 dark:text-emerald-400">/ckm:play</code> → {isVi ? "Lên playbook launch" : "Build launch playbook"}</p>
        <p>3. <code class="text-emerald-600 dark:text-emerald-400">/ckm:persona</code> → {isVi ? "Xác định audience" : "Define audience personas"}</p>
        <p>4. <code class="text-pink-600 dark:text-pink-400">/ckm:write:good</code> → {isVi ? "Create assets" : "Create content"}</p>
        <p>5. <code class="text-purple-600 dark:text-purple-400">/ckm:campaign</code> → {isVi ? "Execute launch" : "Execute launch"}</p>
      </div>
    </div>

    <!-- Workflow 4: SEO Content -->
    <div class="p-5 rounded-xl bg-blue-500/5 border border-blue-200 dark:border-blue-500/20">
      <h4 class="font-bold text-blue-700 dark:text-blue-400 mb-3">
        {isVi ? "Workflow 4: SEO Content" : "Workflow 4: SEO Content Strategy"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono">
        <p>1. <code class="text-blue-600 dark:text-blue-400">/ckm:seo</code> → {isVi ? "Keyword research" : "Keyword research"}</p>
        <p>2. <code class="text-blue-600 dark:text-blue-400">/ckm:competitor</code> → {isVi ? "Content gaps" : "Find content gaps"}</p>
        <p>3. <code class="text-purple-600 dark:text-purple-400">/ckm:plan</code> → {isVi ? "Content calendar" : "Content calendar"}</p>
        <p>4. <code class="text-pink-600 dark:text-pink-400">/ckm:write:blog</code> → {isVi ? "Write articles" : "Write articles"}</p>
        <p>5. <code class="text-blue-600 dark:text-blue-400">/ckm:funnel</code> → {isVi ? "Optimize flow" : "Optimize conversion"}</p>
      </div>
    </div>
  </div>
</div>
