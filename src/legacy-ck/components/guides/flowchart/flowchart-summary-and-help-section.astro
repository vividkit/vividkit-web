---
// FlowchartGuide summary cheat sheet and "not sure" help section
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@legacy-ck/i18n/utils';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
const t = useTranslations(currentLang);
---

  <!-- Summary Cheat Sheet -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3
      class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2"
    >
      <svg
        class="w-5 h-5 text-rose-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M8 7h8M8 11h8M8 15h5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Cheat Sheet Tóm tắt" : "Summary Cheat Sheet"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th
              class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
              >{isVi ? "Tình huống" : "Scenario"}</th
            >
            <th
              class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
              >Command</th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Build something mới hoàn toàn"
                  : '"I need to build something new from scratch"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-amber-600 dark:text-amber-400">/ck:bootstrap</code
              ></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Có ý tưởng nhưng chưa biết approach"
                  : '"I have an idea but not sure how to approach it"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-violet-600 dark:text-violet-400"
                >/ck:brainstorm</code
              ></td
            ></tr
          >
          <tr class="fc-stable-content"
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Biết chính xác muốn gì, làm nhanh"
                  : '"I know exactly what I want, do it fast"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-emerald-600 dark:text-emerald-400">/ck:cook</code
              ></td
            ></tr
          >
          <tr class="fc-stable-content"
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Muốn plan kỹ trước khi code"
                  : '"I want to plan carefully before coding"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-purple-600 dark:text-purple-400"
                >/ck:plan → /ck:cook</code
              ></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Có lỗi, không biết tại sao"
                  : "\"Something's broken, I don't know why\""
              }</td
            ><td class="py-2 px-4"
              ><code class="text-orange-600 dark:text-orange-400"
                >/ck:debug → /ck:fix</code
              ></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Có lỗi, biết nguyên nhân"
                  : '"Something\'s broken, I know what it is"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-red-600 dark:text-red-400">/ck:fix</code></td
            ></tr
          >
          <tr class="fc-stable-content"
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{isVi ? "Cần lưu work" : '"I need to save my work"'}</td
            ><td class="py-2 px-4"
              ><code class="text-indigo-600 dark:text-indigo-400">/ck:git cm</code>
              {isVi ? "hoặc" : "or"}
              <code class="text-indigo-600 dark:text-indigo-400">/ck:git cp</code
              ></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Cần hiểu codebase"
                  : '"I need to understand this codebase"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-cyan-600 dark:text-cyan-400">/ck:docs init</code
              ></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi ? "Cần advice kiến trúc" : '"I need architectural advice"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-blue-600 dark:text-blue-400">/ck:ask</code></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi ? "Có gì thay đổi gần đây?" : '"What changed recently?"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-cyan-600 dark:text-cyan-400">/ck:watzup</code></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{isVi ? "Xem plans trực quan" : '"View my plans visually"'}</td
            ><td class="py-2 px-4"
              ><code class="text-pink-600 dark:text-pink-400">/ck:plans-kanban</code>
              {isVi ? "hoặc" : "or"}
              <code class="text-pink-600 dark:text-pink-400">/ck:preview</code></td
            ></tr
          >
          <tr
            ><td class="py-2 px-4 text-slate-600 dark:text-slate-400"
              >{
                isVi
                  ? "Mình mới học, giải thích dùng từ ngữ dễ hiểu chút nhé"
                  : '"I\'m new, slow down explanations"'
              }</td
            ><td class="py-2 px-4"
              ><code class="text-blue-600 dark:text-blue-400"
                >/coding-level 1</code
              ></td
            ></tr
          >
        </tbody>
      </table>
    </div>
  </div>

