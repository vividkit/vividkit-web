---
// CommandsGuide: top-level composition of all commands guide sub-components
import { useTranslations } from '@legacy-ck/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import CommandsHeroBanner from "./commands/commands-hero-banner.astro";
import CommandsMigrationTable from "./commands/commands-migration-table.astro";
import CommandsSymbolsLegend from "./commands/commands-symbols-legend.astro";
import CommandsCategoriesGrid from "./commands/commands-categories-grid.astro";
import CommandsDocsNote from "./commands/commands-docs-note.astro";
import {
  engineerMigrationExtra,
  marketingMigrationExtra,
  marketingRenamedMkt,
  marketingRenamedShared,
} from "@legacy-ck/data/guides/commands-migration";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const isVi = currentLang === "vi";
const tBridge = (en: string, vi: string) => isVi ? vi : en;
const engineerExtraCount = engineerMigrationExtra.length;
const marketingExtraCount = marketingMigrationExtra.length + marketingRenamedMkt.length + marketingRenamedShared.length;

const quickNavItems = [
  {
    href: "#whats-new-section",
    labelKey: "commands.nav.migration",
    descKey: "commands.nav.migration_desc",
    accent: "text-amber-700 dark:text-amber-300",
    border: "hover:border-amber-300 hover:bg-amber-50/60 dark:hover:border-amber-300/40 dark:hover:bg-amber-950/20",
    icon: '<path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path>',
  },
  {
    href: "#commands-symbols",
    labelKey: "commands.nav.legend",
    descKey: "commands.nav.legend_desc",
    accent: "text-teal-700 dark:text-teal-300",
    border: "hover:border-teal-300 hover:bg-teal-50/60 dark:hover:border-teal-300/40 dark:hover:bg-teal-950/20",
    icon: '<rect x="4" y="5" width="3.5" height="3.5" rx="0.6"></rect><path d="M10 6.75h10"></path><rect x="4" y="10.25" width="3.5" height="3.5" rx="0.6"></rect><path d="M10 12h10"></path><rect x="4" y="15.5" width="3.5" height="3.5" rx="0.6"></rect><path d="M10 17.25h10"></path>',
  },
  {
    href: "#commands-catalog",
    labelKey: "commands.nav.catalog",
    descKey: "commands.nav.catalog_desc",
    accent: "text-cyan-700 dark:text-cyan-300",
    border: "hover:border-cyan-300 hover:bg-cyan-50/60 dark:hover:border-cyan-300/40 dark:hover:bg-cyan-950/20",
    icon: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>',
  },
];
---

<style>
  @keyframes pulse-slow {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
  .pulse-icon {
    animation: pulse-slow 3s ease-in-out infinite;
  }
  @keyframes flow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  .flow-arrow {
    animation: flow 2s ease-in-out infinite;
  }
</style>

<div class="space-y-8 mt-6">
  <!-- Page Header -->
  <div class="text-center space-y-4">
    <h2
      class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight flex items-center justify-center gap-3"
    >
      {t("guides.commands.title")}
    </h2>
    <div class="flex items-center justify-center gap-3 flex-wrap">
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {t("guides.commands.description")}
      </p>
    </div>
  </div>

  <!-- Hero banner: /ck: prefix explanation -->
  <section id="commands-prefix" class="scroll-mt-32">
    <CommandsHeroBanner lang={currentLang} />
  </section>

  <!-- Quick navigation -->
  <nav
    class="rounded-2xl border border-slate-200 bg-white/80 p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900/60"
    aria-label={t("commands.nav.aria")}
  >
    <div class="mb-3 flex items-center justify-between gap-3">
      <div>
        <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
          {t("commands.nav.eyebrow")}
        </div>
        <div class="mt-1 text-sm font-semibold text-slate-800 dark:text-slate-200">
          {t("commands.nav.title")}
        </div>
      </div>
      <span class="hidden rounded-full bg-teal-50 px-3 py-1 text-[11px] font-medium text-teal-700 dark:bg-teal-900/30 dark:text-teal-300 sm:inline-flex">
        {t("commands.nav.hint")}
      </span>
    </div>
    <div class="grid gap-2 sm:grid-cols-3">
      {quickNavItems.map((item) => (
        <a
          href={item.href}
          class={`group min-h-[92px] rounded-xl border border-slate-200 bg-slate-50 p-3 transition dark:border-slate-800 dark:bg-slate-950/40 ${item.border}`}
        >
          <div class="mb-2 flex items-center gap-2">
            <span class={`flex h-7 w-7 items-center justify-center rounded-lg bg-white shadow-sm dark:bg-slate-900 ${item.accent}`}>
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </span>
            <span class={`font-mono text-[11px] font-bold ${item.accent}`}>
              {t(item.labelKey as any)}
            </span>
          </div>
          <span class="block text-[11px] leading-snug text-slate-500 dark:text-slate-400">
            {t(item.descKey as any)}
          </span>
        </a>
      ))}
    </div>
  </nav>

  <!-- What's New: v2.14.0 migration table -->
  <CommandsMigrationTable lang={currentLang} />

  <!-- Understanding Symbols: ⚡ token weight tiers -->
  <section id="commands-symbols" class="scroll-mt-32">
    <CommandsSymbolsLegend lang={currentLang} />
  </section>

  <!-- Command categories grid with Engineer / Marketing Kit toggle -->
  <section id="commands-catalog" class="scroll-mt-32">
    <CommandsCategoriesGrid lang={currentLang} />
  </section>

  <!-- Official docs link -->
  <CommandsDocsNote lang={currentLang} />

  <section class="rounded-2xl border border-cyan-200 bg-cyan-50/80 p-5 dark:border-cyan-500/25 dark:bg-cyan-500/10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">
          {tBridge("Related guide", "Guide liên quan")}
        </p>
        <h2 class="mt-1 text-lg font-bold text-slate-950 dark:text-white">Finding Your Unknowns</h2>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-700 dark:text-slate-300">
          {tBridge(
            "Not sure which command category you need? Finding Your Unknowns maps each kind of unknown to the right ClaudeKit command before you browse the full catalog.",
            "Chưa chắc cần category lệnh nào? Finding Your Unknowns ánh xạ từng loại unknown vào đúng lệnh ClaudeKit trước khi bạn duyệt cả catalog."
          )}
        </p>
      </div>
      <a
        href={translatePath("/legacy/guides/finding-unknowns")}
        class="inline-flex min-h-10 shrink-0 items-center justify-center rounded-lg bg-cyan-600 px-4 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300"
      >
        {tBridge("Open Finding Your Unknowns", "Mở Finding Your Unknowns")}
      </a>
    </div>
  </section>
</div>

<script>
  // Version toggle: Engineer Kit vs Marketing Kit tabs
  document.addEventListener("DOMContentLoaded", () => {
    const btnEngineer = document.getElementById("btn-engineer");
    const btnMarketing = document.getElementById("btn-marketing");
    const categoriesEngineer = document.getElementById("categories-engineer");
    const categoriesMarketing = document.getElementById("categories-marketing");

    if (!btnEngineer || !btnMarketing || !categoriesEngineer || !categoriesMarketing) return;

    const activeClasses = "bg-teal-500 text-white shadow-sm";
    const inactiveClasses = "text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700";
    const activeMarketingClasses = "bg-purple-500 text-white shadow-sm";

    function setVersion(version: "engineer" | "marketing") {
      if (version === "engineer") {
        categoriesEngineer.classList.remove("hidden");
        categoriesMarketing.classList.add("hidden");
        btnEngineer.className = `version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeClasses}`;
        btnMarketing.className = `version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      } else {
        categoriesEngineer.classList.add("hidden");
        categoriesMarketing.classList.remove("hidden");
        btnMarketing.className = `version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeMarketingClasses}`;
        btnEngineer.className = `version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      }
      localStorage.setItem("commands-kit", version);
    }

    // Restore saved preference (migrate old keys)
    const savedVersion = localStorage.getItem("commands-kit") || localStorage.getItem("commands-version");
    if (savedVersion === "engineer" || savedVersion === "v25" || savedVersion === "stable") {
      setVersion("engineer");
    } else if (savedVersion === "marketing" || savedVersion === "v24" || savedVersion === "beta") {
      setVersion("marketing");
    }

    btnEngineer.addEventListener("click", () => setVersion("engineer"));
    btnMarketing.addEventListener("click", () => setVersion("marketing"));

    // Migration Guide: Engineer/Marketing tab switching
    const migrationTabEngineer = document.getElementById("migration-tab-engineer");
    const migrationTabMarketing = document.getElementById("migration-tab-marketing");
    const migrationPanelEngineer = document.getElementById("migration-panel-engineer");
    const migrationPanelMarketing = document.getElementById("migration-panel-marketing");

    if (migrationTabEngineer && migrationTabMarketing && migrationPanelEngineer && migrationPanelMarketing) {
      const activeMigTabClasses = "bg-teal-500 text-white shadow-sm";
      const activeMigTabMktClasses = "bg-purple-500 text-white shadow-sm";
      const inactiveMigTabClasses = "text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700";

      function setMigrationTab(tab: "engineer" | "marketing") {
        if (tab === "engineer") {
          migrationPanelEngineer.classList.remove("hidden");
          migrationPanelMarketing.classList.add("hidden");
          migrationTabEngineer.className = `migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 ${activeMigTabClasses}`;
          migrationTabMarketing.className = `migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 ${inactiveMigTabClasses}`;
        } else {
          migrationPanelEngineer.classList.add("hidden");
          migrationPanelMarketing.classList.remove("hidden");
          migrationTabMarketing.className = `migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 ${activeMigTabMktClasses}`;
          migrationTabEngineer.className = `migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 ${inactiveMigTabClasses}`;
        }
      }

      migrationTabEngineer.addEventListener("click", () => setMigrationTab("engineer"));
      migrationTabMarketing.addEventListener("click", () => setMigrationTab("marketing"));
    }

    // Migration table expand/collapse
    const migrationToggle = document.getElementById("migration-toggle-btn");
    const migrationRows = document.getElementById("migration-extra-rows");
    const migrationIcon = document.getElementById("migration-toggle-icon");
    const migrationText = document.getElementById("migration-toggle-text");

    if (migrationToggle && migrationRows && migrationIcon && migrationText) {
      let isExpanded = false;

      migrationToggle.addEventListener("click", () => {
        if (!isExpanded) {
          migrationRows.style.display = "";
          migrationRows.style.opacity = "0";
          migrationRows.style.transition = "opacity 0.3s ease";
          requestAnimationFrame(() => { migrationRows.style.opacity = "1"; });
          migrationIcon.style.transform = "rotate(180deg)";
          migrationText.textContent = "Show less";
        } else {
          migrationRows.style.opacity = "0";
          setTimeout(() => {
            migrationRows.style.display = "none";
            migrationIcon.style.transform = "";
            migrationText.textContent = `Show all migrations (${engineerExtraCount} more)`;
            const whatsNewSection = document.getElementById("whats-new-section");
            if (whatsNewSection) {
              whatsNewSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }, 250);
        }
        isExpanded = !isExpanded;
      });

      migrationIcon.style.transition = "transform 0.3s ease";
    }

    // Marketing Kit migration table expand/collapse
    const migrationMktToggle = document.getElementById("migration-mkt-toggle-btn");
    const migrationMktRows = document.getElementById("migration-mkt-extra-rows");
    const migrationMktIcon = document.getElementById("migration-mkt-toggle-icon");
    const migrationMktText = document.getElementById("migration-mkt-toggle-text");

    if (migrationMktToggle && migrationMktRows && migrationMktIcon && migrationMktText) {
      let isMktExpanded = false;

      migrationMktToggle.addEventListener("click", () => {
        if (!isMktExpanded) {
          migrationMktRows.style.display = "";
          migrationMktRows.style.opacity = "0";
          migrationMktRows.style.transition = "opacity 0.3s ease";
          requestAnimationFrame(() => { migrationMktRows.style.opacity = "1"; });
          migrationMktIcon.style.transform = "rotate(180deg)";
          migrationMktText.textContent = "Show less";
        } else {
          migrationMktRows.style.opacity = "0";
          setTimeout(() => {
            migrationMktRows.style.display = "none";
            migrationMktIcon.style.transform = "";
            migrationMktText.textContent = `Show all migrations (${marketingExtraCount} more)`;
            const whatsNewSection = document.getElementById("whats-new-section");
            if (whatsNewSection) {
              whatsNewSection.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }, 250);
        }
        isMktExpanded = !isMktExpanded;
      });

      migrationMktIcon.style.transition = "transform 0.3s ease";
    }
  });
</script>
