---
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import { useTranslations } from '@legacy-ck/i18n/utils';
import InsideClaudeKitArticleShell from './InsideClaudeKitArticleShell.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const blogPostUrl = currentLang === 'en'
  ? 'https://claudekit.thieunv.space/en/posts/guard-rails-in-claude-code-and-claudekit'
  : 'https://claudekit.thieunv.space/posts/guard-rails-in-claude-code-and-claudekit';

const copy = currentLang === 'vi'
  ? {
      kicker: 'Safety & Guard Rails',
      summary:
        'Guard rail không làm model thông minh hơn — nó kiểm tra hành động trước khi tool thật sự chạy. Bài này mổ xẻ 4 lớp guard, 7 nhóm guard rail và những chỗ vẫn hở trong ClaudeKit.',
      sections: {
        introCase: 'Case: task nhỏ, quyền quá rộng',
        vsPrompt: 'Guard rail vs lời dặn trong prompt',
        layers: '4 lớp guard',
        flow: 'Flow một tool call qua guard',
        exitCodes: 'Exit code quyết định chặn hay không',
        groups: '7 nhóm guard rail trong CK',
        hooks: 'Bốn hook đáng soi kỹ',
        taxonomy: 'Đọc trạng thái hook theo 3 nhãn',
        gaps: '8 chỗ vẫn hở (known gaps)',
        checklist: '6 câu kiểm tra trước khi tin guard rail',
        readMore: 'Đọc bài viết đầy đủ',
      },
      introLede:
        'Giao agent một việc nhỏ: sửa validation trong một module. Nó quét thêm vài thư mục cho chắc, mở file config nhạy cảm, rồi tiện tay gom vài cleanup không liên quan vào cùng một PR. Test vẫn pass — nhưng context đã lẫn file rác, secret có thể đã vào transcript, review thì loãng.',
      introCols: { without: 'Không guard rail', with: 'Có guard rail' },
      introRows: [
        { without: 'Glob quá rộng, context bẩn', with: 'scout-block exit 2, gợi ý thu hẹp pattern' },
        { without: 'cat .env, secret vào transcript', with: 'privacy-block exit 2 + hỏi user approval' },
        { without: 'Cleanup ngoài scope, review loãng', with: 'rule / hard-gate kéo về task chính' },
        { without: 'Test pass nên ship luôn', with: 'simplify / review gate soi lại diff trước ship' },
      ],
      vsCols: { aspect: 'Khía cạnh', guard: 'Guard rail', prompt: 'Lời dặn trong prompt' },
      vsRows: [
        { aspect: 'Chạy ở đâu', guard: 'Harness, ngoài model', prompt: 'Trong context, model đọc' },
        { aspect: 'Ép buộc', guard: 'Code chặn thật (block tool)', prompt: 'Model tự nguyện tuân' },
        { aspect: 'Khi context dài', guard: 'Vẫn chạy', prompt: 'Dễ bị quên / trượt' },
        { aspect: 'Khi model hiểu lệch', guard: 'Vẫn chặn (nếu không crash)', prompt: 'Lệch theo model' },
        { aspect: 'Sửa đổi', guard: 'Cần đụng code/config', prompt: 'Sửa text là xong' },
      ],
      vsNote:
        'Hai thứ không loại trừ nhau. Việc rủi ro cao dùng guard rail; việc mang tính phong cách (commit format, comment convention) thì lời dặn là đủ.',
      layers: [
        {
          name: 'Hook (code)',
          enforce: 'Chặn thật',
          tone: 'emerald',
          desc: 'Script harness tự gọi tại các mốc lifecycle. Trả exit 2 thì tool KHÔNG chạy. Đây là lớp chặn thật duy nhất.',
          caveat: 'Nhưng fail-open: hook crash thì Claude Code cho qua, guard tắt âm thầm.',
        },
        {
          name: 'Rule (CLAUDE.md)',
          enforce: 'Lời dặn',
          tone: 'blue',
          desc: 'Text được inject vào context mỗi prompt. Định hướng hành vi, dễ thêm/sửa, không cần redeploy.',
          caveat: 'Không có exit 2 nào ép. Model mạnh tuân tốt hơn, prompt user có thể đè.',
        },
        {
          name: 'Hard-gate (XML)',
          enforce: 'Lời dặn mạnh',
          tone: 'amber',
          desc: '<HARD-GATE> nằm trong skill markdown, giữ trình tự (code trước plan, ship trước review). Signal mạnh hơn rule thường.',
          caveat: 'Vẫn là lời dặn, không phải hook. Có dòng "User override".',
        },
        {
          name: 'Guard skill (user gọi)',
          enforce: 'User chủ động',
          tone: 'violet',
          desc: 'Chạy khi user gõ slash command: /ck:security-scan, /ck:predict, /ck:scenario, /ck:ship.',
          caveat: 'Không gọi thì không chạy. Là lớp chủ động, không tự động.',
        },
      ],
      flowSteps: [
        { label: 'User prompt', note: 'Prompt gate (UserPromptSubmit) có thể chặn + nhắc sửa', tone: 'slate' },
        { label: 'Model quyết định gọi tool', note: 'Read / Bash / Edit / Write ...', tone: 'blue' },
        { label: 'Pre-tool hook (scout / privacy)', note: 'exit 2 → tool KHÔNG chạy, trả lý do về model', tone: 'amber' },
        { label: 'Tool exec', note: 'exit 0 → đọc / ghi / chạy thật trên máy', tone: 'emerald' },
        { label: 'Post-tool hook', note: 'validate, scan, nhắc bước kế (PostToolUse / Stop)', tone: 'cyan' },
      ],
      flowResult: '→ Kết quả về model, đã qua các lớp kiểm',
      exitCodes: [
        { code: 'exit 0', verb: 'Cho chạy', desc: 'Tool chạy bình thường. stdout đọc làm JSON output.', tone: 'emerald' },
        { code: 'exit 2', verb: 'Chặn thật', desc: 'Tool không chạy. Bỏ stdout, đẩy stderr về model làm thông báo lỗi.', tone: 'rose' },
        { code: 'exit 1 / khác', verb: 'Lỗi, KHÔNG chặn', desc: 'Báo lỗi rồi tool VẪN chạy tiếp. Dùng nhầm exit 1 = guard tưởng bật mà thực ra mở.', tone: 'amber' },
      ],
      exitNote: 'Chỉ exit 2 mới chặn thật. Hook muốn enforce policy phải dùng đúng exit 2.',
      groupsCols: { group: 'Nhóm', mech: 'Cơ chế', example: 'Ví dụ', enforce: 'Ép buộc' },
      groups: [
        { group: 'Chặn file/path', mech: 'PreToolUse', example: 'scout-block', enforce: 'Code, fail-open' },
        { group: 'Chặn sai bước', mech: 'UserPromptSubmit', example: 'simplify-gate', enforce: 'Code' },
        { group: 'Thêm context', mech: 'UserPromptSubmit', example: 'dev-rules-reminder', enforce: 'Code' },
        { group: 'Giữ tên sạch', mech: 'Pre/Post/Stop', example: 'descriptive-name', enforce: 'Code, nhắc' },
        { group: 'Hard-gate skill', mech: 'XML markdown', example: '<HARD-GATE>', enforce: 'Lời dặn' },
        { group: 'Rule lời dặn', mech: 'CLAUDE.md', example: 'review-audit', enforce: 'Lời dặn' },
        { group: 'Guard skill', mech: 'User gọi', example: 'ck:security-scan', enforce: 'User' },
      ],
      hooks: [
        {
          name: 'scout-block',
          tone: 'blue',
          problem: 'Agent đọc node_modules/, glob **/*.ts ở root, cat dist/ — đốt token, context bẩn.',
          gap: 'Build command (npm/go/cargo build) luôn được cho qua. Fail-open khi hook crash.',
        },
        {
          name: 'privacy-block',
          tone: 'rose',
          problem: 'Agent đụng .env, id_rsa, *.pem — secret lộ vào transcript. Exit 2 + bắt AskUserQuestion.',
          gap: 'Bash tool được miễn, chỉ cảnh báo. Pattern secret hard-code, không config thêm được.',
        },
        {
          name: 'simplify-gate',
          tone: 'amber',
          problem: 'Diff phình > 400 LOC / > 8 file / 1 file > 200 LOC khi prompt có ship/merge/pr/deploy.',
          gap: 'Fresh install CHƯA chặn: cần bật simplify.gate.enabled=true. "ship on Friday" cũng bị bỏ qua.',
        },
        {
          name: 'workflow-artifact-gate',
          tone: 'violet',
          problem: 'Kiểm 5 file JSON (context, risk, verification, review, adversarial) trước ship/push/pr/deploy.',
          gap: 'Là gate mạnh nhất nhưng PHẢI opt-in: wire trong settings.json + bật trong .ck.json.',
        },
      ],
      taxonomy: [
        { label: 'script file', desc: 'File .cjs có nằm trong .claude/hooks/. Có file CHƯA nghĩa là hook đang chạy.' },
        { label: 'wired', desc: 'settings.json đã gắn script vào lifecycle event. Không wire thì Claude Code không gọi.' },
        { label: 'runtime flag', desc: 'Khi đã được gọi, code đọc .ck.json / default / ENV để quyết có chạy tiếp không (vd: privacyBlock, simplify.gate.enabled).' },
      ],
      taxonomyNote:
        'isHookEnabled() chỉ tắt khi hooks.<name> là false. Key thiếu thường xem là enabled. Đừng gom mọi thứ thành "mặc định bật/tắt".',
      gaps: [
        'File-access guard nằm ở hook (scout-block / privacy-block), không phải permissions.deny riêng.',
        'Bash được miễn privacy-block — chỉ warn, không qua approval flow.',
        'workflow-artifact-gate cần opt-in. Gate mạnh nhất không chạy nếu chưa bật.',
        'simplify-gate mặc định chưa chặn. Cần bật simplify.gate.enabled rõ ràng.',
        'simplify-gate trượt bằng phrasing — "ship on Friday" được bỏ qua.',
        '.ckignore có thể negate node_modules bằng ! allowlist. Kiểm tra trực tiếp.',
        'Rule là lời dặn — Claude có thể lệch khi prompt user đè.',
        'HARD-GATE XML cũng là lời dặn, có "User override". Không có exit 2 nào ép.',
      ],
      gapsExtra:
        'Và: không có rate-limit / quota guard. Agent mất kiểm soát có thể call hàng nghìn Read/Bash; giới hạn nằm ở Claude Code / provider / billing, không ở guard rail.',
      checklist: [
        'settings.json đang gắn hook nào vào lifecycle nào?',
        '.ck.json đã disable hook nào? (cả outer + inner config)',
        'Session Claude Code hiện tại có đang bỏ qua permission prompt không?',
        'Có project .ckignore override không? node_modules có bị ! allowlist không?',
        'Rule files trong CLAUDE.md có đầy đủ không?',
        'Có hook nào đang crash âm thầm trong session này không (check stderr)?',
      ],
      versionNote:
        'Snapshot theo Engineer Kit stable claudekit-engineer@2.20.0, bản này đã bỏ 2 hook Agent Teams (task-completed-handler, teammate-idle-handler) có trong 2.19.x. Danh sách hook có thể đổi khi upstream release version mới.',
      hooksCtaText: 'Xem chi tiết từng hook trong guide Custom Hooks',
      readMoreText:
        'Đọc bản đầy đủ với bản đồ ClaudeKit hooks theo lifecycle, snippet settings.json / .ck.json, cơ chế từng hook và phân tích sâu các gap →',
      readMoreCta: 'Đọc bài viết đầy đủ',
    }
  : {
      kicker: 'Safety & Guard Rails',
      summary:
        "A guard rail doesn't make the model smarter — it checks the action before the tool actually runs. This article breaks down the 4 guard layers, 7 guard-rail groups, and the gaps that remain in ClaudeKit.",
      sections: {
        introCase: 'Case: small task, too-broad permissions',
        vsPrompt: 'Guard rail vs prompt instruction',
        layers: 'The 4 guard layers',
        flow: 'A tool call passing through guards',
        exitCodes: 'Exit codes decide block or not',
        groups: '7 guard-rail groups in CK',
        hooks: 'Four hooks worth a close look',
        taxonomy: 'Read hook state by 3 labels',
        gaps: '8 known gaps',
        checklist: '6 checks before you trust a guard rail',
        readMore: 'Read the full article',
      },
      introLede:
        'You hand the agent a small job: fix validation in one module. To be safe it scans a few more directories, opens a sensitive config file, then sweeps a couple of unrelated cleanups into the same PR. Tests still pass — but the context now has junk files, a secret may have hit the transcript, and the review is diluted.',
      introCols: { without: 'Without guard rail', with: 'With guard rail' },
      introRows: [
        { without: 'Glob too broad, dirty context', with: 'scout-block exit 2, suggests narrowing the pattern' },
        { without: 'cat .env, secret in transcript', with: 'privacy-block exit 2 + asks user approval' },
        { without: 'Out-of-scope cleanup, diluted review', with: 'rule / hard-gate pulls back to the main task' },
        { without: 'Tests pass, so ship it', with: 'simplify / review gate re-checks the diff before ship' },
      ],
      vsCols: { aspect: 'Aspect', guard: 'Guard rail', prompt: 'Prompt instruction' },
      vsRows: [
        { aspect: 'Where it runs', guard: 'Harness, outside the model', prompt: 'In context, model reads it' },
        { aspect: 'Enforcement', guard: 'Code blocks for real (blocks tool)', prompt: 'Model voluntarily complies' },
        { aspect: 'Long context', guard: 'Still runs', prompt: 'Easily forgotten / drifts' },
        { aspect: 'Model misreads', guard: 'Still blocks (unless it crashes)', prompt: 'Drifts with the model' },
        { aspect: 'Changing it', guard: 'Needs code/config edits', prompt: 'Just edit the text' },
      ],
      vsNote:
        'The two are not mutually exclusive. Use guard rails for high-risk actions; for stylistic things (commit format, comment convention) an instruction is enough.',
      layers: [
        {
          name: 'Hook (code)',
          enforce: 'Real block',
          tone: 'emerald',
          desc: 'A script the harness invokes at lifecycle moments. Return exit 2 and the tool does NOT run. This is the only real blocking layer.',
          caveat: 'But fail-open: if the hook crashes, Claude Code lets it through — the guard turns off silently.',
        },
        {
          name: 'Rule (CLAUDE.md)',
          enforce: 'Instruction',
          tone: 'blue',
          desc: 'Text injected into context on each prompt. Steers behavior, easy to add/edit, no redeploy needed.',
          caveat: 'No exit 2 forces it. Stronger models comply better; a user prompt can override it.',
        },
        {
          name: 'Hard-gate (XML)',
          enforce: 'Strong instruction',
          tone: 'amber',
          desc: '<HARD-GATE> lives in skill markdown, preserving sequence (plan before code, review before ship). A stronger signal than a plain rule.',
          caveat: "Still an instruction, not a hook. It carries a 'User override' line.",
        },
        {
          name: 'Guard skill (user-invoked)',
          enforce: 'User-initiated',
          tone: 'violet',
          desc: 'Runs when the user types a slash command: /ck:security-scan, /ck:predict, /ck:scenario, /ck:ship.',
          caveat: "If not invoked, it doesn't run. It's an active layer, not automatic.",
        },
      ],
      flowSteps: [
        { label: 'User prompt', note: 'Prompt gate (UserPromptSubmit) can block + ask for a fix', tone: 'slate' },
        { label: 'Model decides to call a tool', note: 'Read / Bash / Edit / Write ...', tone: 'blue' },
        { label: 'Pre-tool hook (scout / privacy)', note: 'exit 2 → tool does NOT run, reason returned to model', tone: 'amber' },
        { label: 'Tool exec', note: 'exit 0 → real read / write / run on the machine', tone: 'emerald' },
        { label: 'Post-tool hook', note: 'validate, scan, nudge next step (PostToolUse / Stop)', tone: 'cyan' },
      ],
      flowResult: '→ Result returns to the model, having passed the guard layers',
      exitCodes: [
        { code: 'exit 0', verb: 'Allow', desc: 'Tool runs normally. stdout is read as JSON output.', tone: 'emerald' },
        { code: 'exit 2', verb: 'Real block', desc: 'Tool does not run. stdout dropped, stderr returned to the model as an error.', tone: 'rose' },
        { code: 'exit 1 / other', verb: 'Error, does NOT block', desc: 'Reports an error, but the tool STILL runs. Misusing exit 1 = a guard you think is on but is actually open.', tone: 'amber' },
      ],
      exitNote: 'Only exit 2 truly blocks. A hook that wants to enforce policy must use exit 2.',
      groupsCols: { group: 'Group', mech: 'Mechanism', example: 'Example', enforce: 'Enforcement' },
      groups: [
        { group: 'Block file/path', mech: 'PreToolUse', example: 'scout-block', enforce: 'Code, fail-open' },
        { group: 'Block wrong step', mech: 'UserPromptSubmit', example: 'simplify-gate', enforce: 'Code' },
        { group: 'Inject context', mech: 'UserPromptSubmit', example: 'dev-rules-reminder', enforce: 'Code' },
        { group: 'Keep names clean', mech: 'Pre/Post/Stop', example: 'descriptive-name', enforce: 'Code, nudge' },
        { group: 'Hard-gate skill', mech: 'XML markdown', example: '<HARD-GATE>', enforce: 'Instruction' },
        { group: 'Rule instruction', mech: 'CLAUDE.md', example: 'review-audit', enforce: 'Instruction' },
        { group: 'Guard skill', mech: 'User-invoked', example: 'ck:security-scan', enforce: 'User' },
      ],
      hooks: [
        {
          name: 'scout-block',
          tone: 'blue',
          problem: 'Agent reads node_modules/, globs **/*.ts at root, cats dist/ — burns tokens, dirties context.',
          gap: 'Build commands (npm/go/cargo build) always pass through. Fail-open when the hook crashes.',
        },
        {
          name: 'privacy-block',
          tone: 'rose',
          problem: 'Agent touches .env, id_rsa, *.pem — secret leaks into transcript. Exit 2 + forces AskUserQuestion.',
          gap: 'Bash tool is exempt, only warned. Secret patterns are hard-coded, no config to add more.',
        },
        {
          name: 'simplify-gate',
          tone: 'amber',
          problem: 'Diff bloats > 400 LOC / > 8 files / a single file > 200 LOC when the prompt has ship/merge/pr/deploy.',
          gap: "Fresh install does NOT block: needs simplify.gate.enabled=true. 'ship on Friday' is also skipped.",
        },
        {
          name: 'workflow-artifact-gate',
          tone: 'violet',
          problem: 'Checks 5 JSON files (context, risk, verification, review, adversarial) before ship/push/pr/deploy.',
          gap: 'The strongest gate, but MUST be opted in: wire it in settings.json + enable it in .ck.json.',
        },
      ],
      taxonomy: [
        { label: 'script file', desc: 'A .cjs file exists in .claude/hooks/. Having the file does NOT mean the hook is running.' },
        { label: 'wired', desc: 'settings.json has attached the script to a lifecycle event. Not wired, Claude Code never calls it.' },
        { label: 'runtime flag', desc: 'Once invoked, code reads .ck.json / default / ENV to decide whether to proceed (e.g. privacyBlock, simplify.gate.enabled).' },
      ],
      taxonomyNote:
        'isHookEnabled() only turns off when hooks.<name> is false. A missing key is usually treated as enabled. Don\'t collapse everything into "on/off by default".',
      gaps: [
        'File-access guard lives in hooks (scout-block / privacy-block), not a separate permissions.deny.',
        'Bash is exempt from privacy-block — only warned, no approval flow.',
        'workflow-artifact-gate needs opt-in. The strongest gate does not run unless enabled.',
        "simplify-gate doesn't block by default. You must explicitly set simplify.gate.enabled.",
        "simplify-gate slips on phrasing — 'ship on Friday' is skipped.",
        '.ckignore can negate node_modules with a ! allowlist. Check it directly.',
        'Rules are instructions — Claude can drift when a user prompt overrides.',
        "HARD-GATE XML is also an instruction, with a 'User override'. No exit 2 enforces it.",
      ],
      gapsExtra:
        'Also: there is no rate-limit / quota guard. A runaway agent can fire thousands of Read/Bash calls; limits live in Claude Code / provider / billing, not in this guard rail.',
      checklist: [
        'Which hooks does settings.json wire to which lifecycle?',
        'Which hooks has .ck.json disabled? (both outer + inner config)',
        'Is the current Claude Code session skipping permission prompts?',
        'Any project .ckignore override? Is node_modules ! allowlisted?',
        'Are the rule files in CLAUDE.md complete?',
        'Is any hook crashing silently in this session (check stderr)?',
      ],
      versionNote:
        'Snapshot of Engineer Kit stable claudekit-engineer@2.20.0, which dropped the 2 Agent Teams hooks (task-completed-handler, teammate-idle-handler) present in 2.19.x. The hook list may change when upstream ships a new version.',
      hooksCtaText: 'See each hook in detail in the Custom Hooks guide',
      readMoreText:
        'Read the full version with the ClaudeKit hooks lifecycle map, settings.json / .ck.json snippets, per-hook mechanics, and a deep analysis of the gaps →',
      readMoreCta: 'Read full article',
    };

// Tailwind tone → class lookups (kept explicit so classes survive the JIT scan)
const toneBadge: Record<string, string> = {
  emerald: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-200',
  blue: 'bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200',
  amber: 'bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-200',
  violet: 'bg-violet-100 text-violet-800 dark:bg-violet-900/50 dark:text-violet-200',
  rose: 'bg-rose-100 text-rose-800 dark:bg-rose-900/50 dark:text-rose-200',
  cyan: 'bg-cyan-100 text-cyan-800 dark:bg-cyan-900/50 dark:text-cyan-200',
  slate: 'bg-slate-200 text-slate-800 dark:bg-slate-700 dark:text-slate-200',
};
const toneBorder: Record<string, string> = {
  emerald: 'border-l-emerald-500',
  blue: 'border-l-blue-500',
  amber: 'border-l-amber-500',
  violet: 'border-l-violet-500',
  rose: 'border-l-rose-500',
  cyan: 'border-l-cyan-500',
  slate: 'border-l-slate-400',
};
---

<InsideClaudeKitArticleShell
  lang={currentLang}
  kicker={copy.kicker}
  title={t('guides.home.inside_claudekit.topic_4.title')}
  summary={copy.summary}
  slug="guard-rails"
>
  <section class="rounded-2xl border border-cyan-200 bg-cyan-50/80 p-5 dark:border-cyan-500/25 dark:bg-cyan-500/10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">
          UI Review Gate
        </p>
        <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-700 dark:text-slate-300">
          {currentLang === 'vi'
            ? 'Một số guard rail chặn tool bằng code. UI Review Gate thêm lớp người duyệt trong browser trước khi agent đi tiếp.'
            : 'Some guard rails block tools with code. UI Review Gate adds a human browser review before the agent continues.'}
        </p>
      </div>
      <a
        href={translatePath('/legacy/guides/ui-review-gate')}
        class="inline-flex min-h-10 shrink-0 items-center justify-center rounded-lg bg-cyan-600 px-4 text-sm font-bold text-white shadow-sm transition hover:bg-cyan-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300"
      >
        {currentLang === 'vi' ? 'Mở guide' : 'Open guide'}
      </a>
    </div>
  </section>

  <!-- Section 1: Intro case comparison -->
  <section id="intro-case" class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
    <div class="mb-4 flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-900/50">
