---
// CLI guide FAQ: native disclosure cards, no JS. Mirrors deals-faq layout.
// Answers contain inline HTML (code chips, links) — rendered via set:html.
import { useTranslations } from '@legacy-ck/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const faqs = [
  { q: t('cli.faq.q1'), a: t('cli.faq.a1') },
  { q: t('cli.faq.q2'), a: t('cli.faq.a2') },
  { q: t('cli.faq.q3'), a: t('cli.faq.a3') },
];
---

<section class="space-y-5">
  <div class="flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-violet-700 dark:text-violet-300">{t('cli.faq.kicker')}</p>
      <h2 class="mt-2 font-heading text-2xl font-black text-slate-950 dark:text-white sm:text-3xl">
        {t('cli.faq.title')}
      </h2>
    </div>
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    {faqs.map((faq, i) => (
      <details class={`group rounded-2xl border bg-white/80 p-0 shadow-sm shadow-slate-900/[0.03] transition hover:border-violet-300 dark:bg-slate-900/70 dark:hover:border-violet-800 ${i === 0 ? 'border-emerald-200 dark:border-emerald-900/60' : 'border-slate-200 dark:border-slate-800'}`}>
        <summary class="flex min-h-20 cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 select-none">
          <span class="text-base font-bold leading-6 text-slate-950 dark:text-white">
            {faq.q}
          </span>
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition group-open:rotate-180 group-open:bg-violet-100 group-open:text-violet-700 dark:bg-slate-800 dark:text-slate-400 dark:group-open:bg-violet-950 dark:group-open:text-violet-300">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5">
          <p
            class="border-t border-slate-200 pt-4 text-sm leading-7 text-slate-600 dark:border-slate-800 dark:text-slate-400 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-slate-100 [&_code]:dark:bg-slate-800/80 [&_strong]:text-slate-900 [&_strong]:dark:text-slate-200"
            set:html={faq.a}
          />
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }

  details > summary::marker {
    display: none;
  }
</style>
