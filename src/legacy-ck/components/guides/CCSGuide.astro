---
// CCSGuide - Main composition component
// Flow: Overview → Key Features → Cheatsheet → Configure (Decision Tree | Dashboard) → Workflows
import { getLangFromUrl, type Language } from '@/i18n';

import CCSOverviewSection from './ccs/ccs-overview-section.astro';
import CCSKeyFeaturesSection from './ccs/ccs-key-features-section.astro';
import CCSCheatsheetSection from './ccs/ccs-cheatsheet-section.astro';
import CCSConfigureProvidersSection from './ccs/ccs-configure-providers-section.astro';
import CCSWorkflowsSection from './ccs/ccs-workflows-section.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
---

<div class="space-y-8 mt-6">
  <CCSOverviewSection lang={currentLang} />
  <CCSKeyFeaturesSection lang={currentLang} />
  <CCSCheatsheetSection lang={currentLang} />
  <CCSConfigureProvidersSection lang={currentLang} />
  <CCSWorkflowsSection lang={currentLang} />
</div>
