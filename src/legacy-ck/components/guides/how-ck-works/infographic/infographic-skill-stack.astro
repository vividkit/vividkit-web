---
// Skill and agent stack badges with colored dots
import type { SkillStackBadge } from '@legacy-ck/data/guides/how-ck-works';
import type { Language } from '@/i18n';

interface Props {
  badges: SkillStackBadge[];
  lang: Language;
}

const { badges, lang } = Astro.props;
const isVi = lang === 'vi';

// Skip if no badges
if (!badges || badges.length === 0) return null;

// Type colors for badge dots
const typeColors: Record<string, string> = {
  agent: 'bg-green-500',
  skill: 'bg-amber-500',
  tool: 'bg-blue-500',
};
---

<div class="mb-8">
  <h2 class="text-xs font-semibold text-gray-500 dark:text-white/40 uppercase tracking-wider mb-3">
    {isVi ? 'SKILL & AGENT STACK' : 'SKILL & AGENT STACK'}
  </h2>

  <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-4">
    <p class="text-sm text-gray-600 dark:text-white/60 mb-3">
      {isVi ? 'Skills và agents được sử dụng trong phiên làm việc:' : 'Skills and agents used during sessions:'}
    </p>

    <div class="flex flex-wrap gap-2">
      {badges.map(badge => (
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-gray-100 dark:bg-white/10 rounded-full text-sm text-gray-800 dark:text-white/80">
          <span class={`w-2 h-2 rounded-full ${typeColors[badge.type] || 'bg-gray-400'}`}></span>
          {badge.name}
        </span>
      ))}
    </div>

    <!-- Legend -->
    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-white/5 flex flex-wrap items-center gap-4 text-xs text-gray-500 dark:text-white/40">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        Agent
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        Skill
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        Tool
      </span>
      <span class="ml-auto italic">
        {isVi ? '• Tất cả tuỳ chọn — kích hoạt theo context' : '• All optional — activated based on context'}
      </span>
    </div>
  </div>
</div>
