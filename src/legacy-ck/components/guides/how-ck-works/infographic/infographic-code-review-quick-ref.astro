---
// Purpose-built Quick Ref layout for /ck:code-review — adversarial 3-stage review.
// Mirrors the ck-cook / ck-fix visual grammar so all command-level skills feel consistent.
import type { SkillInfographic, ProcessFlowStep } from '@legacy-ck/data/guides/how-ck-works';
import type { Language } from '@/i18n';

interface Props {
  data: SkillInfographic;
  lang: Language;
}

type Tone = {
  rail: string;
  chip: string;
  label: string;
  surface: string;
};

interface ProcessGroup {
  label: string;
  kicker: string;
  steps: ProcessFlowStep[];
  tone: Tone;
}

type ModeCard = {
  flag: string;
  title: string;
  desc: string;
  prompt: string;
  when: string;
  expected: string;
  accent: string;
};

type RuleCard = {
  title: string;
  desc: string;
  marker: string;
};

type SamplePrompt = {
  label: string;
  command: string;
  when: string;
  expected: string;
  recommended?: boolean;
};

type Guardrail = {
  thought: string;
  reality: string;
  accent: string;
};

const { data, lang } = Astro.props;
const isVi = lang === 'vi';
const commandText = data.command;

const commonText = {
  hardGate: isVi ? 'Gate bắt buộc' : 'Required Gate',
  process: isVi ? 'Review map' : 'Review Map',
  modes: isVi ? 'Input mode' : 'Input Modes',
  samplePrompt: isVi ? 'Prompt mẫu' : 'Sample Prompt',
  useWhen: isVi ? 'Dùng khi' : 'Use when',
  expected: isVi ? 'Kết quả' : 'Expected',
  recommended: isVi ? 'Khuyến nghị' : 'Recommended',
  output: isVi ? 'Artifact tạo ra' : 'Artifacts Produced',
  stack: isVi ? 'Stack được gọi khi cần' : 'Stack Used When Needed',
  guardrails: isVi ? 'Shortcut bị chặn' : 'Shortcuts Blocked',
  thought: isVi ? 'Suy nghĩ' : 'Thought',
  reality: isVi ? 'Thực tế' : 'Reality',
  finalProof: isVi ? 'Bằng chứng để kết thúc' : 'Proof Required To Finish',
  modePrompt: isVi ? 'Lệnh mẫu' : 'Prompt',
};

const tones: Record<string, Tone> = {
  resolve: {
    rail: 'bg-sky-400',
    chip: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-950/35 dark:text-sky-200 dark:ring-sky-800/60',
    label: 'text-sky-700 dark:text-sky-300',
    surface: 'bg-sky-50/55 ring-sky-100 dark:bg-sky-950/12 dark:ring-sky-900/35',
  },
  spec: {
    rail: 'bg-emerald-400',
    chip: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-200 dark:ring-emerald-800/60',
    label: 'text-emerald-700 dark:text-emerald-300',
    surface: 'bg-emerald-50/55 ring-emerald-100 dark:bg-emerald-950/12 dark:ring-emerald-900/35',
  },
  quality: {
    rail: 'bg-violet-400',
    chip: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/35 dark:text-violet-200 dark:ring-violet-800/60',
    label: 'text-violet-700 dark:text-violet-300',
    surface: 'bg-violet-50/55 ring-violet-100 dark:bg-violet-950/12 dark:ring-violet-900/35',
  },
  adversarial: {
    rail: 'bg-rose-400',
    chip: 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-950/35 dark:text-rose-200 dark:ring-rose-800/60',
    label: 'text-rose-700 dark:text-rose-300',
    surface: 'bg-rose-50/55 ring-rose-100 dark:bg-rose-950/12 dark:ring-rose-900/35',
  },
};

const config = {
  eyebrow: isVi ? 'Tóm tắt nhanh / Lệnh review' : 'Quick Ref / Review command',
  context: isVi ? 'Sau /ck:cook hoặc /ck:fix, trước /ck:ship' : 'After /ck:cook or /ck:fix, before /ck:ship',
  summary: isVi
    ? 'Dùng khi cần review code với rigor đối kháng. Resolve input mode, qua spec compliance gate, scout edge case, code-reviewer sub-agent, rồi adversarial red-team chủ động phá code trước khi verify + report.'
    : 'Use it when code needs adversarial-rigor review. Resolve input mode, pass the spec-compliance gate, scout edge cases, run the code-reviewer sub-agent, then let the adversarial red-team actively try to break the code before verify + report.',
  hardGateItems: isVi
    ? [
        { label: 'Spec gate', detail: 'Stage 1 spec compliance PHẢI pass trước Stage 2 quality review.' },
        { label: 'Adversarial luôn bật', detail: 'Stage 3 red-team chạy MỌI lần. Scope gate chỉ miễn khi ≤2 files / ≤30 lines / không security.' },
        { label: 'Bằng chứng mới', detail: 'Không claim done nếu chưa rerun: tests pass + build success với output mới.' },
        { label: 'Critical chặn merge', detail: 'Mọi critical finding phải resolved trước khi merge — không skip, không "should/probably".' },
        { label: '3-cycle limit', detail: 'Tối đa 3 vòng fix → re-review. Vượt ngưỡng phải escalate user.' },
      ]
    : [
        { label: 'Spec gate', detail: 'Stage 1 spec compliance MUST pass before Stage 2 quality review.' },
        { label: 'Adversarial always-on', detail: 'Stage 3 red-team runs on EVERY review. Scope gate exempts only ≤2 files / ≤30 lines / no security.' },
        { label: 'Fresh evidence', detail: 'No "done" claim without rerunning: tests pass + build success with new output.' },
        { label: 'Critical blocks merge', detail: 'Every critical finding must be resolved before merge — no skipping, no "should/probably".' },
        { label: '3-cycle limit', detail: 'Max 3 fix → re-review cycles. Past that, escalate to the user.' },
      ],
  processDesc: isVi
    ? 'Bốn lane: xác định input + diff, qua spec gate, quality review với scout, rồi adversarial red-team + verify + report.'
    : 'Four lanes: resolve input + diff, pass the spec gate, run quality review with scout, then adversarial red-team + verify + report.',
  modesDesc: isVi
    ? 'Input mode quyết định target review. Pick một mode — agent auto-detect từ argument, hoặc AskUserQuestion nếu mơ hồ. Code-review không có "fast/auto" flag, mọi mode đều qua đủ 3 stage.'
    : 'Input mode picks the review target. Pick ONE — agent auto-detects from the argument, or AskUserQuestion when ambiguous. No "fast/auto" flag — every mode runs through all 3 stages.',
  heroFlow: isVi
    ? ['Input + diff', 'Spec gate', 'Quality + scout', 'Adversarial + report']
    : ['Input + diff', 'Spec gate', 'Quality + scout', 'Adversarial + report'],
  ruleCards: isVi
    ? [
        { title: 'Spec-first gate', desc: 'Stage 1 phải pass — không bỏ qua sang Stage 2 khi spec chưa khớp.', marker: 'bg-emerald-400' },
        { title: 'Adversarial always-on', desc: 'Stage 3 red-team chạy mọi lần. Scope gate chỉ miễn trivial.', marker: 'bg-rose-400' },
        { title: 'Bằng chứng mới', desc: 'Không claim done nếu chưa rerun tests/build với output mới.', marker: 'bg-violet-400' },
      ]
    : [
        { title: 'Spec-first gate', desc: 'Stage 1 must pass — never skip to Stage 2 with spec mismatch.', marker: 'bg-emerald-400' },
        { title: 'Adversarial always-on', desc: 'Stage 3 red-team runs every time. Scope gate exempts only trivial.', marker: 'bg-rose-400' },
        { title: 'Fresh evidence', desc: 'No "done" claim without rerunning tests/build with new output.', marker: 'bg-violet-400' },
      ],
  groups: [
    { label: isVi ? 'Resolve' : 'Resolve', kicker: isVi ? 'Input mode + diff acquisition' : 'Input mode + diff acquisition', steps: data.processFlow.slice(0, 2), tone: tones.resolve },
    { label: isVi ? 'Spec gate' : 'Spec gate', kicker: isVi ? 'Stage 1 — code khớp plan/spec?' : 'Stage 1 — code matches plan/spec?', steps: data.processFlow.slice(2, 3), tone: tones.spec },
    { label: isVi ? 'Quality' : 'Quality', kicker: isVi ? 'Scout edge case + Stage 2 code-reviewer' : 'Scout edge cases + Stage 2 code-reviewer', steps: data.processFlow.slice(3, 5), tone: tones.quality },
    { label: isVi ? 'Adversarial + Prove' : 'Adversarial + Prove', kicker: isVi ? 'Stage 3 red-team, verify, report' : 'Stage 3 red-team, verify, report', steps: data.processFlow.slice(5), tone: tones.adversarial },
  ] as ProcessGroup[],
  modes: isVi
    ? [
        { flag: '#123', title: 'PR mode', desc: 'Fetch full PR diff qua gh pr diff #N.', prompt: '/ck:code-review #123', when: 'Review một PR đã mở trên GitHub.', expected: 'Diff toàn bộ PR → 3-stage review → recommendation APPROVE / REQUEST CHANGES / BLOCK.', accent: 'border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-800/55 dark:bg-sky-950/25 dark:text-sky-200' },
        { flag: '--pending', title: 'Pending', desc: 'Review staged + unstaged changes trong working tree.', prompt: '/ck:code-review --pending', when: 'Trước commit, sau khi /ck:cook hoặc /ck:fix xong.', expected: 'git diff (staged + unstaged) → 3-stage review → findings inline.', accent: 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800/55 dark:bg-emerald-950/25 dark:text-emerald-200' },
        { flag: 'abc1234', title: 'Commit', desc: 'Review một commit cụ thể qua git show <sha>.', prompt: '/ck:code-review abc1234', when: 'Audit commit cũ, post-mortem regression.', expected: 'Diff đúng commit đó → 3-stage review tập trung phạm vi commit.', accent: 'border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-800/55 dark:bg-violet-950/25 dark:text-violet-200' },
        { flag: 'codebase parallel', title: 'Codebase parallel', desc: 'Ultrathink edge case, rồi spawn nhiều adversarial reviewer song song.', prompt: '/ck:code-review codebase parallel', when: 'Audit sâu — security review, hardening trước launch.', expected: 'Nhiều reviewer scope khác nhau, dedupe + prioritize theo severity.', accent: 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-800/55 dark:bg-rose-950/25 dark:text-rose-200' },
      ]
    : [
        { flag: '#123', title: 'PR mode', desc: 'Fetch full PR diff via gh pr diff #N.', prompt: '/ck:code-review #123', when: 'Reviewing an open GitHub PR.', expected: 'Full PR diff → 3-stage review → APPROVE / REQUEST CHANGES / BLOCK recommendation.', accent: 'border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-800/55 dark:bg-sky-950/25 dark:text-sky-200' },
        { flag: '--pending', title: 'Pending', desc: 'Review staged + unstaged changes in the working tree.', prompt: '/ck:code-review --pending', when: 'Before commit, right after /ck:cook or /ck:fix.', expected: 'git diff (staged + unstaged) → 3-stage review → inline findings.', accent: 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800/55 dark:bg-emerald-950/25 dark:text-emerald-200' },
        { flag: 'abc1234', title: 'Commit', desc: 'Review a specific commit via git show <sha>.', prompt: '/ck:code-review abc1234', when: 'Auditing an old commit, post-mortem regression.', expected: 'That commit\'s diff → 3-stage review scoped to the commit.', accent: 'border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-800/55 dark:bg-violet-950/25 dark:text-violet-200' },
        { flag: 'codebase parallel', title: 'Codebase parallel', desc: 'Ultrathink edge cases, then spawn adversarial reviewers in parallel.', prompt: '/ck:code-review codebase parallel', when: 'Deep audits — security review, pre-launch hardening.', expected: 'Multiple scoped reviewers, dedupe + prioritize by severity.', accent: 'border-rose-200 bg-rose-50 text-rose-800 dark:border-rose-800/55 dark:bg-rose-950/25 dark:text-rose-200' },
      ],
  prompts: isVi
    ? [
        { label: 'Pending', recommended: true, command: '/ck:code-review --pending', when: 'Vừa làm xong /ck:cook hoặc /ck:fix, chưa commit.', expected: 'Review tất cả staged + unstaged trước khi commit / ship.' },
        { label: 'PR review', command: '/ck:code-review #42', when: 'PR đã mở, cần adversarial review trước merge.', expected: 'Findings nhóm theo severity + verdict cho từng item.' },
        { label: 'Codebase audit', command: '/ck:code-review codebase parallel', when: 'Pre-launch hoặc security audit toàn project.', expected: 'Nhiều reviewer scope khác nhau, severity-dedupe trong report.' },
      ]
    : [
        { label: 'Pending', recommended: true, command: '/ck:code-review --pending', when: 'Just finished /ck:cook or /ck:fix, not yet committed.', expected: 'Reviews all staged + unstaged before commit / ship.' },
        { label: 'PR review', command: '/ck:code-review #42', when: 'PR is open, needs adversarial review before merge.', expected: 'Findings grouped by severity + verdict per item.' },
        { label: 'Codebase audit', command: '/ck:code-review codebase parallel', when: 'Pre-launch or whole-project security audit.', expected: 'Multiple scoped reviewers, severity-dedupe in the report.' },
      ],
  guardrails: isVi
    ? [
        { thought: 'Code compile được là review pass', reality: 'Stage 1 spec compliance phải verify intent khớp plan/spec — compile không nói lên gì cả.', accent: 'border-emerald-200 bg-emerald-50/70 dark:border-emerald-800/50 dark:bg-emerald-950/18' },
        { thought: 'Diff nhỏ, skim qua là được', reality: 'Adversarial Stage 3 vẫn bắt buộc trừ khi đúng scope gate (≤2 files, ≤30 lines, không security).', accent: 'border-rose-200 bg-rose-50/70 dark:border-rose-800/50 dark:bg-rose-950/18' },
        { thought: 'Tests pass nghĩa là an toàn merge', reality: 'Critical findings vẫn chặn merge. Cần fresh evidence cho cả build + tests, không tin "should/probably".', accent: 'border-violet-200 bg-violet-50/70 dark:border-violet-800/50 dark:bg-violet-950/18' },
      ]
    : [
        { thought: 'Code compiles → review passes', reality: 'Stage 1 spec compliance must verify intent matches plan/spec — compile says nothing.', accent: 'border-emerald-200 bg-emerald-50/70 dark:border-emerald-800/50 dark:bg-emerald-950/18' },
        { thought: 'Small diff, just skim it', reality: 'Adversarial Stage 3 is still mandatory unless the scope gate hits (≤2 files, ≤30 lines, no security).', accent: 'border-rose-200 bg-rose-50/70 dark:border-rose-800/50 dark:bg-rose-950/18' },
        { thought: 'Tests pass = safe to merge', reality: 'Critical findings still block merge. Need fresh build + test evidence — no "should/probably".', accent: 'border-violet-200 bg-violet-50/70 dark:border-violet-800/50 dark:bg-violet-950/18' },
      ],
};

const ruleCards = config.ruleCards as RuleCard[];
const processGroups = config.groups;
const modes = config.modes as ModeCard[];
const samplePrompts = (data.promptExamples || []).map(p => ({
  label: isVi ? p.labelVi : p.labelEn,
  command: p.command,
  when: isVi ? p.whenVi : p.whenEn,
  expected: isVi ? p.expectedVi : p.expectedEn,
  recommended: p.recommended,
})) as SamplePrompt[];
const guardrails = config.guardrails as Guardrail[];
const modeListClass = 'mt-4 space-y-3';
const modeCardClass = 'grid gap-4 rounded-xl border p-4 lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-stretch';
const stackPreview = data.skillStack?.slice(0, 10) || [];
const outputItems = (isVi ? data.reportOutput?.descVi : data.reportOutput?.descEn)
  ?.split('•')
  .map(item => item.trim())
  .filter(Boolean) || [];
const outputPattern = isVi ? data.reportOutput?.patternVi : data.reportOutput?.patternEn;
const proofItems = isVi
  ? [
      'Stage 1 spec compliance pass',
      'Stage 2 code-reviewer pass (standards / security / perf)',
      'Stage 3 adversarial findings adjudicated (Accept / Reject / Defer)',
      'Fresh tests + build evidence (exit 0, 0 failures)',
      'Không còn critical finding chưa giải quyết',
    ]
  : [
      'Stage 1 spec compliance pass',
      'Stage 2 code-reviewer pass (standards / security / perf)',
      'Stage 3 adversarial findings adjudicated (Accept / Reject / Defer)',
      'Fresh test + build evidence (exit 0, 0 failures)',
      'No unresolved critical findings',
    ];

const renderInlineCode = (value = '') => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code class="rounded bg-white/80 px-1.5 py-0.5 font-mono text-[0.82em] text-amber-950 ring-1 ring-amber-200 dark:bg-amber-950/45 dark:text-amber-100 dark:ring-amber-700/60">$1</code>');
---

<div class="space-y-8">
  <header class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm ring-1 ring-white/60 dark:border-white/10 dark:bg-slate-950/55 dark:ring-white/5">
    <div class="pointer-events-none absolute inset-0 opacity-80 dark:opacity-100">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-400 via-violet-300 to-rose-400"></div>
      <div class="absolute inset-0 bg-[linear-gradient(115deg,rgba(14,165,233,0.10),transparent_30%,rgba(139,92,246,0.08)_60%,rgba(244,63,94,0.10))] dark:bg-[linear-gradient(115deg,rgba(14,165,233,0.16),transparent_30%,rgba(139,92,246,0.10)_62%,rgba(244,63,94,0.13))]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.10)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_72%)]"></div>
    </div>

    <div class="relative grid gap-0 xl:grid-cols-[minmax(0,1fr)_330px]">
      <div class="min-w-0 p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <p class="rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider ring-1 bg-violet-500/10 text-violet-700 ring-violet-500/20 dark:text-violet-300">{config.eyebrow}</p>
          <p class="rounded-full bg-white/70 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200 dark:bg-white/[0.06] dark:text-slate-300 dark:ring-white/10">{config.context}</p>
        </div>

        <div class="mt-5">
          <h2 class="font-mono text-3xl font-semibold leading-none text-slate-950 dark:text-white sm:text-4xl">{commandText}</h2>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-650 dark:text-slate-300">{config.summary}</p>
        </div>

        <div class="mt-6 grid gap-2 sm:grid-cols-4">
          {config.heroFlow.map((item, index) => (
            <div class="relative rounded-xl border border-slate-200 bg-white/75 px-3 py-3 dark:border-white/10 dark:bg-white/[0.055]">
              {index < config.heroFlow.length - 1 && <span class="absolute right-[-9px] top-1/2 z-10 hidden h-px w-4 bg-slate-300 dark:bg-white/20 sm:block"></span>}
              <span class="font-mono text-[11px] text-slate-400">0{index + 1}</span>
              <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="relative border-t border-amber-200 bg-amber-50/80 p-5 dark:border-amber-800/50 dark:bg-amber-950/25 xl:border-l xl:border-t-0">
        <div class="flex items-center gap-2">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-60"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span>
          </span>
          <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-200">{commonText.hardGate}</p>
        </div>
        <ol class="mt-3 space-y-2">
          {(config.hardGateItems as { label: string; detail: string }[]).map((item, index) => (
            <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2.5 rounded-lg border border-amber-200/70 bg-white/65 p-2.5 ring-1 ring-amber-100/60 dark:border-amber-800/40 dark:bg-amber-950/30 dark:ring-amber-900/30">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 font-mono text-[11px] font-bold text-white shadow-sm shadow-amber-500/30 dark:bg-amber-400 dark:text-amber-950">{index + 1}</span>
              <div class="min-w-0">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-900 dark:text-amber-200">{item.label}</p>
                <p class="mt-0.5 text-xs leading-5 text-amber-950/85 dark:text-amber-100/85" set:html={renderInlineCode(item.detail)} />
              </div>
            </li>
          ))}
        </ol>
      </aside>
    </div>

    <div class="relative grid border-t border-slate-200 bg-slate-50/80 dark:border-white/10 dark:bg-slate-950/35 sm:grid-cols-3">
      {ruleCards.map(rule => (
        <div class="border-b border-slate-200 p-4 last:border-b-0 dark:border-white/10 sm:border-b-0 sm:border-r sm:last:border-r-0">
          <div class="flex items-start gap-3">
            <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${rule.marker}`}></span>
            <div>
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{rule.title}</p>
              <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{rule.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <div class="border-b border-slate-200 p-5 dark:border-white/10">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.process}</h3>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{config.processDesc}</p>
    </div>
    <div class="divide-y divide-slate-200 dark:divide-white/10">
      {processGroups.map((group, groupIndex) => (
        <div class="relative grid gap-4 p-5 lg:grid-cols-[10rem_minmax(0,1fr)]">
          <div class="flex items-start gap-3 lg:block">
            <span class={`mt-1 block h-10 w-1.5 shrink-0 rounded-full ${group.tone.rail} lg:h-12 lg:w-2`}></span>
            <div class="min-w-0 lg:mt-3">
              <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${group.tone.chip}`}>0{groupIndex + 1}</span>
              <p class={`mt-2 text-base font-semibold ${group.tone.label}`}>{group.label}</p>
              <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">{group.kicker}</p>
            </div>
          </div>
          <ol class="grid gap-3 sm:grid-cols-2">
            {group.steps.map(step => (
              <li class={`grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 rounded-xl p-3.5 ring-1 transition duration-200 hover:-translate-y-0.5 hover:shadow-sm ${group.tone.surface}`}>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white font-mono text-xs font-semibold text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/75 dark:text-slate-200 dark:ring-white/10">{step.number}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-5 text-slate-950 dark:text-white">{isVi ? step.titleVi : step.titleEn}</span>
                  {step.descEn && <span class="mt-1 block text-xs leading-5 text-slate-600 dark:text-slate-400">{isVi ? step.descVi : step.descEn}</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.modes}</h3>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{config.modesDesc}</p>
      <div class={modeListClass}>
        {modes.map(mode => (
          <article class={`${modeCardClass} ${mode.accent}`}>
            <div class="min-w-0 rounded-lg bg-white/55 p-3 ring-1 ring-black/5 dark:bg-slate-950/24 dark:ring-white/10">
              <div class="min-w-0">
                <code class="inline-flex max-w-full break-words rounded-lg bg-white/75 px-2.5 py-1 font-mono text-sm font-semibold ring-1 ring-black/5 dark:bg-white/10 dark:ring-white/10">{mode.flag}</code>
                <p class="mt-2 text-sm font-semibold">{mode.title}</p>
              </div>
              <p class="mt-3 text-xs leading-5 opacity-85">{mode.desc}</p>
            </div>
            <div class="min-w-0 rounded-lg bg-white/70 p-3 ring-1 ring-black/5 dark:bg-slate-950/30 dark:ring-white/10">
              <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{commonText.modePrompt}</p>
              <code class="mt-1.5 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{mode.prompt}</code>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                <p class="text-xs leading-5 text-slate-650 dark:text-slate-300"><span class="font-semibold text-slate-900 dark:text-white">{commonText.useWhen}: </span>{mode.when}</p>
                <p class="text-xs leading-5 text-slate-650 dark:text-slate-300"><span class="font-semibold text-slate-900 dark:text-white">{commonText.expected}: </span>{mode.expected}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.samplePrompt}</h3>
      <div class="mt-4 space-y-3">
        {samplePrompts.map(prompt => (
          <article class={`grid gap-3 rounded-xl border p-4 ring-1 lg:grid-cols-[10rem_minmax(0,1fr)] ${prompt.recommended ? 'border-emerald-200 bg-emerald-50/65 ring-emerald-100 dark:border-emerald-700/45 dark:bg-emerald-950/15 dark:ring-emerald-900/30' : 'border-slate-200 bg-slate-50/80 ring-white/70 dark:border-white/10 dark:bg-white/[0.04] dark:ring-white/5'}`}>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600 ring-1 ring-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:ring-white/10">{prompt.label}</span>
                {prompt.recommended && <span class="rounded-full bg-emerald-500 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white shadow-sm shadow-emerald-500/20 dark:bg-emerald-400 dark:text-emerald-950">{commonText.recommended}</span>}
              </div>
            </div>
            <div class="min-w-0">
              <code class="block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{prompt.command}</code>
              <div class="mt-3 grid gap-3 sm:grid-cols-2">
                <p class="text-xs leading-5 text-slate-650 dark:text-slate-300"><span class="font-semibold text-slate-900 dark:text-white">{commonText.useWhen}: </span>{prompt.when}</p>
                <p class="text-xs leading-5 text-slate-650 dark:text-slate-300"><span class="font-semibold text-slate-900 dark:text-white">{commonText.expected}: </span>{prompt.expected}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="space-y-5">
    <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
      <div class="border-b border-slate-200 p-5 dark:border-white/10">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
          <div class="min-w-0">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.output}</h3>
            <p class="mt-3 text-base font-semibold leading-6 text-slate-900 dark:text-white">{isVi ? data.reportOutput?.titleVi : data.reportOutput?.titleEn}</p>
          </div>
          {outputPattern && <code class="block w-fit max-w-full whitespace-normal break-words rounded-xl px-4 py-2.5 font-mono text-xs leading-5 ring-1 bg-violet-50 text-violet-800 ring-violet-200 dark:bg-violet-950/25 dark:text-violet-200 dark:ring-violet-800/45">{outputPattern}</code>}
        </div>
      </div>
      <div class="grid gap-3 p-5 md:grid-cols-2">
        {outputItems.map((item, index) => (
          <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 rounded-xl border border-slate-200 bg-slate-50/75 p-3 dark:border-white/10 dark:bg-white/[0.035]">
            <span class="flex h-8 w-8 items-center justify-center rounded-full font-mono text-[11px] font-semibold ring-1 bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/30 dark:text-violet-200 dark:ring-violet-800/45">{index + 1}</span>
            <p class="text-sm leading-6 text-slate-650 dark:text-slate-300">{item}</p>
          </div>
        ))}
      </div>
    </article>

    <aside class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_330px]">
      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.stack}</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {stackPreview.map(item => (
            <span class="rounded-full bg-white px-2.5 py-1 text-xs text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:ring-white/10">{item.name}</span>
          ))}
        </div>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.finalProof}</h3>
        <ol class="mt-3 space-y-2">
          {proofItems.map((item, index) => (
            <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-2 text-xs leading-5 text-slate-600 dark:text-slate-400">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 font-mono text-[10px] font-semibold text-slate-600 ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-300 dark:ring-white/10">{index + 1}</span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </aside>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <div class="border-b border-slate-200 p-5 dark:border-white/10">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{commonText.guardrails}</h3>
    </div>
    <div class="divide-y divide-slate-200 dark:divide-white/10">
      {guardrails.map((item, index) => (
        <div class={`grid gap-4 p-4 lg:grid-cols-[3rem_minmax(0,0.9fr)_minmax(0,1.15fr)] lg:items-start ${item.accent}`}>
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white font-mono text-[11px] font-semibold text-slate-600 ring-1 ring-black/5 dark:bg-slate-950/65 dark:text-slate-300 dark:ring-white/10">{index + 1}</span>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{commonText.thought}</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-slate-950 dark:text-white">{item.thought}</p>
          </div>
          <div class="min-w-0">
            <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{commonText.reality}</p>
            <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-300">{item.reality}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</div>
