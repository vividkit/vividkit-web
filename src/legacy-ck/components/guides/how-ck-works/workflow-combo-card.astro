---
// Single combo card showing title, description, and skill sequence
// Used by workflow-combo-grid.astro - receives combo data and renders interactive card
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
---

<!--
  This component is rendered dynamically via Alpine.js template
  The actual card template is defined here for reference but rendered in combo-grid
-->

<template id="combo-card-template">
  <div
    class="group bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-5 cursor-pointer transition-all hover:shadow-lg dark:hover:shadow-none"
    :class="[
      selectedCombo === combo.id ? 'ring-2 ring-offset-2 dark:ring-offset-gray-900' : '',
      `hover:border-${combo.accentColor}-500/50`,
      selectedCombo === combo.id ? `ring-${combo.accentColor}-500` : ''
    ]"
    @click="selectCombo(combo.id)"
  >
    <!-- Header -->
    <div class="flex items-start gap-3 mb-3">
      <div
        class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0"
        :class="`bg-${combo.accentColor}-500/10`"
      >
        <svg
          class="w-5 h-5"
          :class="`text-${combo.accentColor}-500`"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          x-html="combo.icon"
        ></svg>
      </div>
      <div class="min-w-0">
        <h3 class="font-semibold text-gray-900 dark:text-white truncate" x-text="isVi ? combo.titleVi : combo.titleEn"></h3>
        <p class="text-xs text-gray-500 dark:text-white/50">
          <span x-text="combo.scenarios.length"></span>
          <span x-text="isVi ? ' bước' : ' steps'"></span>
        </p>
      </div>
    </div>

    <!-- Description -->
    <p class="text-sm text-gray-600 dark:text-white/70 mb-4 line-clamp-2" x-text="isVi ? combo.descVi : combo.descEn"></p>

    <!-- Skill sequence badges -->
    <div class="flex flex-wrap gap-1.5">
      <template x-for="(scenarioId, i) in combo.scenarios" :key="scenarioId">
        <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs rounded-full bg-gray-100 dark:bg-white/10 text-gray-700 dark:text-white/70 transition-colors group-hover:bg-gray-200 dark:group-hover:bg-white/15">
          <span
            class="w-4 h-4 flex items-center justify-center rounded-full text-[10px] font-medium text-white"
            :class="`bg-${combo.accentColor}-500`"
            x-text="i + 1"
          ></span>
          <span x-text="'/ck:' + scenarioId"></span>
        </span>
      </template>
    </div>

    <!-- Tip (if exists) -->
    <template x-if="combo.tipEn">
      <div class="mt-3 pt-3 border-t border-gray-100 dark:border-white/5">
        <p class="text-xs text-gray-500 dark:text-white/40 flex items-start gap-1.5">
          <svg class="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span x-text="isVi ? combo.tipVi : combo.tipEn"></span>
        </p>
      </div>
    </template>
  </div>
</template>

<!--
  Note: This template is used by workflow-combo-grid.astro
  The actual rendering happens in the grid component using Alpine's x-for
-->
