---
// Animated pipeline view — horizontal nodes connected by arrows
// Renders steps for the currently selected scenario
// Alpine.js state managed by parent HowItWorksGuide
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

// scenarios, typeColors, colorMap are inherited from parent HowItWorksGuide x-data
---

<div>
  {/* Controls row */}
  <div class="flex items-center justify-between mb-6 gap-3">
    <div class="flex items-center gap-2">
      {/* Play/Pause button */}
      <button
        x-on:click="togglePlay()"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 text-gray-600 dark:text-white/70 hover:text-gray-900 dark:hover:text-white text-xs font-medium transition-all"
        type="button"
        x-bind:aria-label="isPlaying ? (isVi ? 'Tạm dừng' : 'Pause') : (isVi ? 'Chạy' : 'Play')"
      >
        <template x-if="!isPlaying">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        </template>
        <template x-if="isPlaying">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
        </template>
        <span x-text="isPlaying ? (isVi ? 'Tạm dừng' : 'Pause') : (isVi ? 'Chạy' : 'Play')"></span>
      </button>

      {/* Next button */}
      <button
        x-on:click="nextStep()"
        x-bind:disabled="currentStep >= totalSteps - 1"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 text-gray-600 dark:text-white/70 hover:text-gray-900 dark:hover:text-white text-xs font-medium transition-all disabled:opacity-30 disabled:cursor-not-allowed"
        type="button"
        x-bind:aria-label="isVi ? 'Bước tiếp theo' : 'Next step'"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <span>{isVi ? 'Tiếp' : 'Next'}</span>
      </button>

      {/* Reset button */}
      <button
        x-on:click="resetPipeline()"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-gray-100/50 dark:bg-white/5 border border-gray-200 dark:border-white/10 hover:border-gray-300 dark:hover:border-white/20 text-gray-600 dark:text-white/70 hover:text-gray-900 dark:hover:text-white text-xs font-medium transition-all"
        type="button"
        x-bind:aria-label="isVi ? 'Đặt lại' : 'Reset'"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        <span>{isVi ? 'Đặt lại' : 'Reset'}</span>
      </button>
    </div>

    {/* Step counter */}
    <span class="text-xs text-gray-500 dark:text-white/40 font-mono" x-show="currentStep >= 0">
      <span x-text="currentStep + 1"></span> / <span x-text="totalSteps"></span>
    </span>
  </div>

  {/* Pipeline nodes — vertical timeline */}
  <div class="w-full max-w-lg mx-auto py-4">
    <div class="flex flex-col items-stretch gap-0 relative">
      <template x-for="(step, index) in steps" x-bind:key="step.id">
        <div class="flex flex-col" x-bind:class="{ 'items-end': step.isSubAgent, 'items-start': !step.isSubAgent }">
          
          {/* Node */}
          <button
            x-on:click="selectStep(index)"
            x-bind:class="{
              'opacity-40 scale-[0.98]': stepState(index) === 'waiting',
              'opacity-100 scale-100 ring-2 z-10 shadow-md': stepState(index) === 'active',
              'opacity-90 scale-100': stepState(index) === 'completed',
              [getColorClass(step.color, 'ring')]: stepState(index) === 'active',
              'w-[85%]': step.isSubAgent,
              'w-full': !step.isSubAgent
            }"
            class="pipeline-node relative flex items-center gap-4 p-4 rounded-xl border border-gray-200 dark:border-white/10 backdrop-blur-sm bg-white dark:bg-white/5 shadow-sm dark:shadow-none transition-all duration-500 ease-out cursor-pointer hover:bg-gray-50 dark:hover:bg-white/8 text-left"
            type="button"
            x-bind:aria-label="step.name"
            role="button"
            tabindex="0"
            x-on:keydown.enter="selectStep(index)"
            x-on:keydown.space.prevent="selectStep(index)"
          >
            {/* Sub-agent Connection UI */}
            <div x-show="step.isSubAgent" class="absolute -top-6 -left-6 md:-left-8 bottom-1/2 flex flex-col justify-end w-6 md:w-8">
               <div class="w-full border-b-2 border-l-2 border-dashed border-gray-300 dark:border-white/20 h-full rounded-bl-xl"></div>
            </div>

            {/* "Spawned by Main Agent" label for sub-agents — hidden before pipeline starts */}
            <div x-show="step.isSubAgent && currentStep >= 0" class="absolute -top-5 left-4 flex items-center gap-1.5">
              <svg class="w-3 h-3 text-gray-400 dark:text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
              <span class="text-[10px] text-gray-400 dark:text-white/30 font-mono" x-text="isVi ? 'được gọi bởi agent chính' : 'spawned by main agent'"></span>
            </div>

            {/* Checkmark overlay for completed steps */}
            <div
              x-show="stepState(index) === 'completed'"
              x-transition
              class="absolute -right-2 -top-2 w-6 h-6 rounded-full bg-white dark:bg-black border border-gray-200 dark:border-white/10 flex items-center justify-center shadow-md dark:shadow-lg"
            >
              <div class="w-full h-full rounded-full bg-green-100 dark:bg-green-500/20 flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-green-500 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>

            {/* Icon */}
            <div class="shrink-0">
              <div x-bind:class="'w-12 h-12 rounded-lg flex items-center justify-center ' + getColorClass(step.color, 'iconBg')">
                <svg
                  x-bind:class="'w-6 h-6 ' + getColorClass(step.color, 'iconText')"
                  fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                  x-html="step.icon"
                ></svg>
              </div>
            </div>

            {/* Text Information */}
            <div class="flex-1 min-w-0">
              <div class="flex flex-col md:flex-row md:items-center gap-1.5 md:gap-3 mb-1">
                <span class="text-gray-900 dark:text-white/90 font-medium whitespace-nowrap truncate" x-text="localizeStepName(step.name)"></span>
                <span
                  x-bind:class="'w-fit text-[10px] font-medium px-2 py-0.5 rounded-full ' + getColorClass(step.color, 'iconBg') + ' ' + getColorClass(step.color, 'iconText')"
                  x-text="step.type === 'agent' ? (step.isSubAgent ? (isVi ? 'Agent phụ' : 'Sub-Agent') : (isVi ? 'Agent chính' : 'Main Agent')) : (isVi ? typeColors[step.type]?.labelVi : typeColors[step.type]?.label)"
                ></span>
              </div>
              <p class="text-xs text-gray-500 dark:text-white/50 truncate" x-text="isVi ? step.descVi : step.descEn"></p>
            </div>
          </button>

          {/* Vertical Arrow connector (not on last item) */}
          <div
            x-show="index < steps.length - 1"
            class="w-full flex"
            x-bind:class="{
              'h-12': steps[index+1]?.isSubAgent,
              'h-8': !steps[index+1]?.isSubAgent,
              'justify-end pr-[50%]': step.isSubAgent && steps[index+1]?.isSubAgent,
              'justify-center': (!step.isSubAgent && !steps[index+1]?.isSubAgent) || (!step.isSubAgent && steps[index+1]?.isSubAgent) || (step.isSubAgent && !steps[index+1]?.isSubAgent),
              'pl-[15%]': !step.isSubAgent && steps[index+1]?.isSubAgent,
              'pr-[15%]': step.isSubAgent && !steps[index+1]?.isSubAgent
            }"
          >
            <svg class="w-6 h-full pipeline-arrow" viewBox="0 0 24 32" fill="none" preserveAspectRatio="none"
              x-bind:class="{
                'text-gray-400 dark:text-white/40': stepState(index) === 'completed',
                'text-gray-200 dark:text-white/20': stepState(index) !== 'completed' && currentStep >= 0,
                'text-transparent': currentStep < 0,
              }"
            >
              <line x1="12" y1="0" x2="12" y2="24" stroke="currentColor" stroke-width="2"
                stroke-dasharray="24"
                x-bind:stroke-dashoffset="stepState(index) === 'completed' || stepState(index + 1) === 'active' ? '0' : '24'"
                style="transition: stroke-dashoffset 0.4s ease-out"
              />
              <polyline points="6,18 12,24 18,18" stroke="currentColor" stroke-width="2" fill="none"
                x-bind:opacity="currentStep < 0 ? '0' : (stepState(index) === 'completed' || stepState(index + 1) === 'active' ? '1' : '0.3')"
                style="transition: opacity 0.3s ease-out"
              />
            </svg>
          </div>
        </div>
      </template>
    </div>
  </div>

  {/* Progress bar */}
  <div class="mt-4 h-1 rounded-full bg-gray-200 dark:bg-white/5 overflow-hidden" x-show="currentStep >= 0">
    <div
      class="h-full rounded-full bg-gradient-to-r from-purple-500 via-blue-500 to-green-500 transition-all duration-500 ease-out"
      x-bind:style="'width: ' + (totalSteps > 0 ? ((currentStep + 1) / totalSteps) * 100 : 0) + '%'"
    ></div>
  </div>
</div>

<!-- Data is injected inline in parent HowItWorksGuide x-data -->

<style>
  @media (prefers-reduced-motion: reduce) {
    .pipeline-node {
      transition: none !important;
    }
    .pipeline-arrow line,
    .pipeline-arrow polyline {
      transition: none !important;
    }
  }
</style>
