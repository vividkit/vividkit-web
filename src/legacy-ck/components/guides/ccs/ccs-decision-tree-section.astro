---
// CCS Decision Tree section — header, group legend, embedded interactive flowchart
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@legacy-ck/i18n/utils';
import FlowchartInteractiveCCS from "../FlowchartInteractiveCCS.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const legendItems = [
  { key: 'anthropic', dot: 'bg-purple-500', label: t('ccs.decision_tree.group_anthropic') },
  { key: 'openai', dot: 'bg-cyan-500', label: t('ccs.decision_tree.group_openai') },
  { key: 'google', dot: 'bg-red-500', label: t('ccs.decision_tree.group_google') },
  { key: 'cloud_ai', dot: 'bg-amber-500', label: t('ccs.decision_tree.group_cloud_ai') },
  { key: 'ide', dot: 'bg-blue-500', label: t('ccs.decision_tree.group_ide') },
  { key: 'local', dot: 'bg-green-500', label: t('ccs.decision_tree.group_local') },
];
---

<section id="decision-tree" class="scroll-mt-24">
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-indigo-500/10 to-blue-500/10 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 rounded-full bg-indigo-500/20 flex items-center justify-center">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-slate-800 dark:text-slate-200">
          {t('ccs.decision_tree.title')}
        </h3>
      </div>
      <p class="text-slate-600 dark:text-slate-400 ml-13 pl-0">
        {t('ccs.decision_tree.subtitle')}
      </p>
    </div>

    <div class="p-6 space-y-4">
      <!-- CLI-only scope callout -->
      <div class="flex items-start gap-2 p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
        <svg class="w-4 h-4 text-blue-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p class="text-xs text-blue-700 dark:text-blue-300">{t('ccs.decision_tree.cli_only_note')}</p>
      </div>

      <p class="text-sm text-slate-600 dark:text-slate-400">
        {t('ccs.decision_tree.intro')}
      </p>

      <!-- Provider-centric legend -->
      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600 dark:text-slate-400">
        {legendItems.map(item => (
          <div class="flex items-center gap-2">
            <span class:list={[item.dot, 'w-3 h-3 rounded-full']} />
            <span class="font-medium">{item.label}</span>
          </div>
        ))}
      </div>

      <FlowchartInteractiveCCS lang={currentLang} />
    </div>
  </div>
</section>
