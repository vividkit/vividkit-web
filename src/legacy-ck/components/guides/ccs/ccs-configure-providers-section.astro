---
// CCSGuide — Configure Your Providers: two-option card (Decision Tree vs Dashboard)
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@legacy-ck/i18n/utils';
import CCSDecisionTreeSection from './ccs-decision-tree-section.astro';
import CCSDashboardSection from './ccs-dashboard-section.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- Configure Your Providers Section -->
<div class="space-y-6" x-data="{ configMode: 'tree' }">
  <!-- Section Header -->
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-violet-500/10 to-blue-500/10 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center font-bold text-violet-600 dark:text-violet-400 border-2 border-violet-500/50">
          2
        </div>
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">
          {t('ccs.guide.configure_title')}
        </h3>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 ml-[52px]">
        {t('ccs.guide.configure_desc')}
      </p>
    </div>

    <!-- Two-Option Toggle -->
    <div class="p-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Option A: Manual via Decision Tree -->
        <button
          @click="configMode = 'tree'"
          :class="configMode === 'tree'
            ? 'border-violet-500 dark:border-violet-400 bg-violet-50 dark:bg-violet-500/10 shadow-md ring-2 ring-violet-500/20'
            : 'border-slate-200 dark:border-slate-700 bg-white/50 dark:bg-slate-900/50 hover:border-violet-300 dark:hover:border-violet-500/30'"
          class="relative p-5 rounded-xl border-2 text-left transition-all group cursor-pointer"
        >
          <!-- Active indicator -->
          <div
            x-show="configMode === 'tree'"
            class="absolute top-3 right-3 w-6 h-6 rounded-full bg-violet-500 flex items-center justify-center"
          >
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>

          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-violet-100 dark:bg-violet-900/40 flex items-center justify-center border border-violet-200 dark:border-violet-800 shadow-sm">
              <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="4 17 10 11 4 5"/>
                <line x1="12" y1="19" x2="20" y2="19"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-800 dark:text-slate-200 text-sm">{t('ccs.guide.option_tree_title')}</h4>
              <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-violet-500/10 text-violet-600 dark:text-violet-400">{t('ccs.guide.option_tree_badge')}</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('ccs.guide.option_tree_desc')}
          </p>
        </button>

        <!-- Option B: UI via Dashboard -->
        <button
          @click="configMode = 'dashboard'"
          :class="configMode === 'dashboard'
            ? 'border-blue-500 dark:border-blue-400 bg-blue-50 dark:bg-blue-500/10 shadow-md ring-2 ring-blue-500/20'
            : 'border-slate-200 dark:border-slate-700 bg-white/50 dark:bg-slate-900/50 hover:border-blue-300 dark:hover:border-blue-500/30'"
          class="relative p-5 rounded-xl border-2 text-left transition-all group cursor-pointer"
        >
          <!-- Active indicator -->
          <div
            x-show="configMode === 'dashboard'"
            class="absolute top-3 right-3 w-6 h-6 rounded-full bg-blue-500 flex items-center justify-center"
          >
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </div>

          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center border border-blue-200 dark:border-blue-800 shadow-sm">
              <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <path d="M3 9h18M9 21V9"/>
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-slate-800 dark:text-slate-200 text-sm">{t('ccs.guide.option_dashboard_title')}</h4>
              <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400">{t('ccs.guide.option_dashboard_badge')}</span>
            </div>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            {t('ccs.guide.option_dashboard_desc')}
          </p>
        </button>
      </div>
    </div>
  </div>

  <!-- Content: Decision Tree (shown when tree is selected) -->
  <div x-show="configMode === 'tree'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
    <CCSDecisionTreeSection lang={currentLang} />
  </div>

  <!-- Content: Dashboard (shown when dashboard is selected) -->
  <div x-show="configMode === 'dashboard'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
    <CCSDashboardSection lang={currentLang} />
  </div>
</div>
