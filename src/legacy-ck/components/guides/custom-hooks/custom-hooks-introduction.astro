---
import type { customHooksTranslations } from "@legacy-ck/data/guides/custom-hooks/custom-hooks-translations";

interface Stat {
  label: string;
  value: number;
}

interface Props {
  t: (typeof customHooksTranslations)["en"];
  stats: Stat[];
}

const { t, stats } = Astro.props;

const toneClass = {
  emerald: "border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-500/25 dark:bg-emerald-500/10 dark:text-emerald-200",
  red: "border-red-200 bg-red-50 text-red-800 dark:border-red-500/25 dark:bg-red-500/10 dark:text-red-200",
  violet: "border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-500/25 dark:bg-violet-500/10 dark:text-violet-200",
  amber: "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-200",
} as const;

const flowSteps = [
  { number: "01", title: t.flowMomentTitle, desc: t.flowMomentDesc },
  { number: "02", title: t.flowContextTitle, desc: t.flowContextDesc },
  { number: "03", title: t.flowGuardrailTitle, desc: t.flowGuardrailDesc },
  { number: "04", title: t.flowResultTitle, desc: t.flowResultDesc },
] as const;

const outcomes = [
  { title: t.outcomeAllowTitle, desc: t.outcomeAllowDesc, tone: "emerald" },
  { title: t.outcomeBlockTitle, desc: t.outcomeBlockDesc, tone: "red" },
  { title: t.outcomeInjectTitle, desc: t.outcomeInjectDesc, tone: "violet" },
  { title: t.outcomeRememberTitle, desc: t.outcomeRememberDesc, tone: "amber" },
] as const;
---

<section class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/60">
  <div class="p-5 sm:p-7">
    <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-start">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase text-blue-600 dark:text-blue-400">
          {t.heroEyebrow}
        </p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
          {t.pageTitle}
        </h1>
        <p class="mt-3 text-lg font-semibold leading-7 text-slate-800 dark:text-slate-100">
          {t.guardrailsLead}
        </p>
        <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
          {t.pageSubtitle}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 text-sm text-slate-600 dark:text-slate-400 lg:max-w-xs lg:justify-end" aria-label={t.heroMetaLabel}>
        {stats.map((stat) => (
          <span data-hooks-stat class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 dark:border-slate-700 dark:bg-slate-950/40">
            <span class="font-semibold text-slate-950 dark:text-white">{stat.value}</span> {stat.label}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="border-y border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-950/35 sm:p-5">
    <div class="mx-auto max-w-5xl">
      <img
        src="/legacy/guides/hooks/claudekit-hooks-guardrails-flow.svg"
        alt={t.guardrailsDiagramAlt}
        width="960"
        height="600"
        class="hooks-guardrails-diagram-light h-auto w-full rounded-lg border border-slate-200 bg-white"
        loading="eager"
        decoding="async"
      />
      <img
        src="/legacy/guides/hooks/claudekit-hooks-guardrails-flow-dark.svg"
        alt={t.guardrailsDiagramAlt}
        width="960"
        height="600"
        class="hooks-guardrails-diagram-dark h-auto w-full rounded-lg border border-slate-800 bg-slate-950"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="p-5 sm:p-7">
    <div class="max-w-3xl">
      <h2 class="text-xl font-bold tracking-tight text-slate-950 dark:text-white">
        {t.flowTitle}
      </h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
        {t.flowDesc}
      </p>
    </div>

    <div class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      {flowSteps.map((step) => (
        <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/35">
          <div class="text-xs font-bold text-blue-600 dark:text-blue-400">{step.number}</div>
          <h3 class="mt-2 text-sm font-bold text-slate-950 dark:text-white">{step.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-4 rounded-lg border border-blue-200 bg-blue-50 px-4 py-3 dark:border-blue-500/25 dark:bg-blue-500/10">
      <h3 class="text-sm font-bold text-blue-950 dark:text-blue-100">{t.guardrailsTemplateTitle}</h3>
      <p class="mt-1 text-sm leading-6 text-blue-800 dark:text-blue-200">{t.guardrailsTemplateDesc}</p>
    </div>

    <div class="mt-5">
      <h3 class="text-sm font-bold text-slate-950 dark:text-white">{t.outcomesTitle}</h3>
      <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
        {outcomes.map((item) => (
          <div class={`rounded-lg border px-3 py-3 ${toneClass[item.tone]}`}>
            <div class="text-sm font-bold">{item.title}</div>
            <div class="mt-1 text-sm leading-5 opacity-85">{item.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hooks-guardrails-diagram-light {
    display: block;
  }

  .hooks-guardrails-diagram-dark {
    display: none;
  }

  :global(html.dark) .hooks-guardrails-diagram-light {
    display: none;
  }

  :global(html.dark) .hooks-guardrails-diagram-dark {
    display: block;
  }
</style>
