  <section class="overflow-hidden rounded-xl border border-cyan-200 bg-cyan-50/45 shadow-sm dark:border-cyan-500/30 dark:bg-cyan-950/15">
    <div class="grid gap-5 p-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
      <div class="flex min-w-0 items-start gap-3">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-cyan-200 bg-white text-cyan-700 dark:border-cyan-500/30 dark:bg-slate-950/70 dark:text-cyan-300">
          <MonitorUp class="h-[18px] w-[18px]" stroke-width={2.2} />
        </span>
        <div class="min-w-0">
          <h3 class="text-xl font-bold text-slate-950 dark:text-white">{t('Want Remote Control to share this route too?', 'Muốn Remote Control dùng chung route này?')}</h3>
          <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-700 dark:text-slate-300">
            {t('This page only covers Codex App request routing. Remote Control has its own Codex path because it also needs an app server, remote identity checks, and session handoff behavior.', 'Page này chỉ cover request routing của Codex App. Remote Control có luồng Codex riêng vì còn cần app server, remote identity checks, và session handoff behavior.')}
