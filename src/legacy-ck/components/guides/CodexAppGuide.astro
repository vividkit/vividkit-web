              <h4 class="text-sm font-bold text-slate-950 dark:text-white">{card.title}</h4>
              <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{card.body}</p>
            </div>
            <TerminalSnippet code={card.code} label={card.label} compact />
          </div>
        </article>
      ))}

      <article class="min-w-0 rounded-xl border border-amber-200 bg-amber-50/35 p-4 dark:border-amber-500/30 dark:bg-amber-950/10">
        <div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(220px,0.55fr)_minmax(0,1.45fr)] xl:items-start">
