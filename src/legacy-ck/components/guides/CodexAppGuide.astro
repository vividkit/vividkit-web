            />
            <ul class="mt-3 grid gap-1 text-xs leading-5 text-slate-700 dark:text-slate-300 sm:grid-cols-2">
              <li>{t('Open a new PowerShell session.', 'Mở PowerShell session mới.')}</li>
              <li>{t('Confirm the user env value exists.', 'Confirm user env value tồn tại.')}</li>
              <li>{t('Restart Codex App.', 'Restart Codex App.')}</li>
              <li>{t('Run `codex doctor` before relying on it.', 'Chạy `codex doctor` trước khi dùng chính thức.')}</li>
            </ul>
