          <a href="#routing-setup" class="inline-flex min-h-9 items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-bold text-slate-700 transition hover:border-cyan-300 hover:text-cyan-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-cyan-500/50 dark:hover:text-cyan-300">
            {t('Back to recommended setup', 'Quay lại setup khuyến nghị')}
            <ArrowRight class="h-3.5 w-3.5" stroke-width={2.2} />
          </a>
        </div>
      </div>
    </div>

    <div class="grid gap-4 p-5">
      <div class="min-w-0 rounded-xl border border-amber-200 bg-amber-50/60 p-4 dark:border-amber-500/30 dark:bg-amber-950/15">
