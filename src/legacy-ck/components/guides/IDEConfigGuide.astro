---
// IDEConfigGuide - composition parent, delegates to sub-components
import { useTranslations } from '@legacy-ck/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import IdeConfigHeroAndSetup from './ide-config/ide-config-hero-and-setup.astro';
import IdeConfigProviderConfigs from './ide-config/ide-config-provider-configs.astro';
import IdeConfigModelAndTips from './ide-config/ide-config-model-and-tips.astro';
import IdeConfigAdvancedAndFooter from './ide-config/ide-config-advanced-and-footer.astro';
import { ArrowRight, Cable, CheckCircle2, Clock3 } from 'lucide-astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isVi = currentLang === 'vi';
const label = (en: string, vi: string) => isVi ? vi : en;

// fullExample uses a translation string so must be built here in the parent
const fullExample = `"claudeCode.environmentVariables": [
  {"name": "MAX_THINKING_TOKENS", "value": "32000"},

  // ${t('ide_config.guide.step2_comment_example')}
  // ${t('ide_config.guide.step2_comment_see_providers')}
  {"name": "ANTHROPIC_BASE_URL", "value": "http://127.0.0.1:8317/api/provider/agy"},
  {"name": "ANTHROPIC_AUTH_TOKEN", "value": "ccs-internal-managed"},
  {"name": "ANTHROPIC_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_OPUS_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_SONNET_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_HAIKU_MODEL", "value": "gemini-claude-sonnet-4-5"}
]`;
---

<div class="space-y-8 mt-6" data-guide-tabs data-default-tab="claude">
  <section class="rounded-2xl border border-slate-200 bg-white/90 p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/70">
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">
          {label('IDE extension routes', 'Luồng IDE extension')}
        </p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          {label('Pick the extension surface', 'Chọn extension surface')}
        </h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-slate-600 dark:text-slate-400">
        {label('Claude Code extension is ready today. Codex extension is on the roadmap.', 'Claude Code extension dùng được ngay. Codex extension đang chuẩn bị.')}
      </p>
    </div>

    <div class="grid gap-2 rounded-xl border border-slate-200 bg-slate-50/80 p-2 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:grid-cols-2" role="tablist" aria-label={label('IDE extension routes', 'Luồng IDE extension')}>
      <button
        type="button"
        data-tab-button="claude"
        role="tab"
        aria-selected="true"
        class="ide-runtime-tab-active group flex min-h-16 cursor-pointer items-center justify-between gap-3 rounded-xl border px-4 py-3 text-left transition duration-200 hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300"
      >
        <span class="flex min-w-0 items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-current/20 bg-white/70 dark:bg-slate-950/50">
            <Cable class="h-4 w-4" stroke-width={2.2} />
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-bold">{label('Claude Code', 'Claude Code')}</span>
            <span class="mt-0.5 block text-xs leading-5 opacity-75">vs-code-extension</span>
          </span>
        </span>
        <span class="ide-runtime-tab-current shrink-0 items-center gap-1 rounded-full border border-current/20 bg-white/70 px-2.5 py-1 text-[11px] font-bold dark:bg-slate-950/45">
          <CheckCircle2 class="h-3.5 w-3.5" stroke-width={2.2} />
          {label('Viewing', 'Đang xem')}
        </span>
        <span class="ide-runtime-tab-action shrink-0 items-center gap-1 rounded-full border border-current/20 px-2.5 py-1 text-[11px] font-bold">
          {label('Open', 'Xem')}
          <ArrowRight class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" stroke-width={2.2} />
        </span>
      </button>

      <button
        type="button"
        data-tab-button="codex"
        role="tab"
        aria-selected="false"
        class="ide-runtime-tab-idle group flex min-h-16 cursor-pointer items-center justify-between gap-3 rounded-xl border px-4 py-3 text-left transition duration-200 hover:-translate-y-0.5 active:translate-y-0 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300"
      >
        <span class="flex min-w-0 items-center gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-current/20 bg-white/70 dark:bg-slate-950/50">
            <Clock3 class="h-4 w-4" stroke-width={2.2} />
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-bold">{label('Codex', 'Codex')}</span>
            <span class="mt-0.5 block text-xs leading-5 opacity-75">{label('coming-soon', 'sắp-ra-mắt')}</span>
          </span>
        </span>
        <span class="ide-runtime-tab-current shrink-0 items-center gap-1 rounded-full border border-current/20 bg-white/70 px-2.5 py-1 text-[11px] font-bold dark:bg-slate-950/45">
          <CheckCircle2 class="h-3.5 w-3.5" stroke-width={2.2} />
          {label('Viewing', 'Đang xem')}
        </span>
        <span class="ide-runtime-tab-action shrink-0 items-center gap-1 rounded-full border border-current/20 px-2.5 py-1 text-[11px] font-bold">
          {label('Open', 'Xem')}
          <ArrowRight class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" stroke-width={2.2} />
        </span>
      </button>
    </div>
  </section>

  <div data-tab-panel="claude">
    <div class="space-y-8">
      <IdeConfigHeroAndSetup lang={currentLang} fullExample={fullExample} />
      <IdeConfigProviderConfigs lang={currentLang} />
      <IdeConfigModelAndTips lang={currentLang} />
      <IdeConfigAdvancedAndFooter lang={currentLang} />
    </div>
  </div>

  <div data-tab-panel="codex" hidden>
    <section class="rounded-xl border border-cyan-200 bg-white p-6 shadow-sm dark:border-cyan-500/30 dark:bg-slate-950/70">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.16em] text-cyan-700 dark:border-cyan-500/30 dark:bg-cyan-950/40 dark:text-cyan-300">
          {label('Coming Soon', 'Sắp ra mắt')}
        </div>
        <h2 class="mt-4 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
          {label('Codex Extension setup', 'Cấu hình Codex Extension')}
        </h2>
        <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-400">
          {label(
            'A dedicated setup guide for the Codex IDE extension is on the way.',
            'Hướng dẫn cấu hình dành riêng cho Codex IDE extension đang được chuẩn bị.'
          )}
        </p>
      </div>
    </section>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-guide-tabs]').forEach(group => {
      const buttons = Array.from(group.querySelectorAll('[data-tab-button]'));
      const panels = Array.from(group.querySelectorAll('[data-tab-panel]'));
      const activate = (tab) => {
        buttons.forEach(button => {
          const active = button.getAttribute('data-tab-button') === tab;
          button.setAttribute('aria-selected', String(active));
          button.classList.toggle('ide-runtime-tab-active', active);
          button.classList.toggle('ide-runtime-tab-idle', !active);
        });
        panels.forEach(panel => {
          panel.hidden = panel.getAttribute('data-tab-panel') !== tab;
        });
      };
      buttons.forEach(button => {
        button.addEventListener('click', () => activate(button.getAttribute('data-tab-button')));
      });
      activate(group.getAttribute('data-default-tab') || buttons[0]?.getAttribute('data-tab-button'));
    });

    document.querySelectorAll('.copy-btn').forEach(btn => {
      if (btn.getAttribute('data-copy-bound') === 'true') return;
      btn.setAttribute('data-copy-bound', 'true');
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
          }
          setTimeout(() => {
            if (copyIcon && checkIcon) {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  });
</script>

<style>
  :global(.ide-runtime-tab-active) {
    border-color: rgba(14, 116, 144, 0.46);
    background: linear-gradient(135deg, rgb(236 254 255), rgb(255 255 255));
    color: rgb(15 23 42);
    box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.08), 0 16px 34px -28px rgba(14, 116, 144, 0.55);
  }

  :global(.dark .ide-runtime-tab-active) {
    border-color: rgba(34, 211, 238, 0.28);
    background: rgba(8, 47, 73, 0.42);
    color: white;
  }

  :global(.ide-runtime-tab-idle) {
    border-color: rgb(226 232 240);
    background: rgb(248 250 252);
    color: rgb(71 85 105);
  }

  :global(.ide-runtime-tab-idle:hover) {
    border-color: rgba(14, 116, 144, 0.32);
    background: rgb(255 255 255);
    color: rgb(15 23 42);
  }

  :global(.dark .ide-runtime-tab-idle) {
    border-color: rgb(30 41 59);
    background: rgba(15, 23, 42, 0.48);
    color: rgb(203 213 225);
  }

  :global(.dark .ide-runtime-tab-idle:hover) {
    border-color: rgba(34, 211, 238, 0.26);
    background: rgba(15, 23, 42, 0.76);
    color: white;
  }

  :global(.ide-runtime-tab-current) {
    display: none;
  }

  :global(.ide-runtime-tab-action) {
    display: inline-flex;
  }

  :global(.ide-runtime-tab-active .ide-runtime-tab-current) {
    display: inline-flex;
  }

  :global(.ide-runtime-tab-active .ide-runtime-tab-action) {
    display: none;
  }
</style>
