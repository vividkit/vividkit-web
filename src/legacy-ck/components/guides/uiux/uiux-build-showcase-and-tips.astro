---
// UIUX Guide - What You Can Build, Design Styles Showcase, and Tips for Non-Tech Users
import { useTranslations } from '@legacy-ck/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- What You Can Build Section -->
<div class="space-y-6">
  <h2 class="text-2xl font-bold flex items-center gap-3 text-slate-900 dark:text-white">
      <svg class="w-7 h-7 text-pink-500 dark:text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2v20M2 12h20"/>
        <circle cx="12" cy="12" r="4"/>
      </svg>
      {t('uiux.guide.build.title')}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Landing Pages -->
      <div class="bg-gradient-to-r from-pink-50/50 to-rose-50/50 dark:from-pink-900/10 dark:to-rose-900/10 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden hover:border-pink-500/30 transition-colors cursor-pointer p-5">
          <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-pink-100 dark:bg-pink-500/20">
              <svg class="w-6 h-6 text-pink-600 dark:text-pink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path d="M3 9h18"/>
              </svg>
              </div>
              <h3 class="text-lg font-bold text-pink-600 dark:text-pink-400">{t('uiux.guide.build.landing.title')}</h3>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">{t('uiux.guide.build.landing.desc')}</p>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
              <div class="flex items-center gap-2"><span class="text-pink-400">•</span> {t('uiux.guide.build.landing.list1')}</div>
              <div class="flex items-center gap-2"><span class="text-pink-400">•</span> {t('uiux.guide.build.landing.list2')}</div>
              <div class="flex items-center gap-2"><span class="text-pink-400">•</span> {t('uiux.guide.build.landing.list3')}</div>
              <div class="flex items-center gap-2"><span class="text-pink-400">•</span> {t('uiux.guide.build.landing.list4')}</div>
          </div>
      </div>

      <!-- Dashboards -->
      <div class="bg-gradient-to-r from-cyan-50/50 to-blue-50/50 dark:from-cyan-900/10 dark:to-blue-900/10 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden hover:border-cyan-500/30 transition-colors cursor-pointer p-5">
          <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-cyan-100 dark:bg-cyan-500/20">
              <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="9"/>
                  <rect x="14" y="3" width="7" height="5"/>
                  <rect x="14" y="12" width="7" height="9"/>
                  <rect x="3" y="16" width="7" height="5"/>
              </svg>
              </div>
              <h3 class="text-lg font-bold text-cyan-600 dark:text-cyan-400">{t('uiux.guide.build.dashboard.title')}</h3>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">{t('uiux.guide.build.dashboard.desc')}</p>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
              <div class="flex items-center gap-2"><span class="text-cyan-400">•</span> {t('uiux.guide.build.dashboard.list1')}</div>
              <div class="flex items-center gap-2"><span class="text-cyan-400">•</span> {t('uiux.guide.build.dashboard.list2')}</div>
              <div class="flex items-center gap-2"><span class="text-cyan-400">•</span> {t('uiux.guide.build.dashboard.list3')}</div>
              <div class="flex items-center gap-2"><span class="text-cyan-400">•</span> {t('uiux.guide.build.dashboard.list4')}</div>
          </div>
      </div>

      <!-- Portfolios -->
      <div class="bg-gradient-to-r from-purple-50/50 to-indigo-50/50 dark:from-purple-900/10 dark:to-indigo-900/10 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden hover:border-purple-500/30 transition-colors cursor-pointer p-5">
          <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-purple-100 dark:bg-purple-500/20">
              <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
              </div>
              <h3 class="text-lg font-bold text-purple-600 dark:text-purple-400">{t('uiux.guide.build.portfolio.title')}</h3>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">{t('uiux.guide.build.portfolio.desc')}</p>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
              <div class="flex items-center gap-2"><span class="text-purple-400">•</span> {t('uiux.guide.build.portfolio.list1')}</div>
              <div class="flex items-center gap-2"><span class="text-purple-400">•</span> {t('uiux.guide.build.portfolio.list2')}</div>
              <div class="flex items-center gap-2"><span class="text-purple-400">•</span> {t('uiux.guide.build.portfolio.list3')}</div>
              <div class="flex items-center gap-2"><span class="text-purple-400">•</span> {t('uiux.guide.build.portfolio.list4')}</div>
          </div>
      </div>

      <!-- Mobile Apps -->
      <div class="bg-gradient-to-r from-orange-50/50 to-amber-50/50 dark:from-orange-900/10 dark:to-amber-900/10 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden hover:border-orange-500/30 transition-colors cursor-pointer p-5">
          <div class="flex items-center gap-3 mb-4 pb-4 border-b border-slate-200 dark:border-slate-800">
              <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-orange-100 dark:bg-orange-500/20">
              <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                  <line x1="12" y1="18" x2="12.01" y2="18"/>
              </svg>
              </div>
              <h3 class="text-lg font-bold text-orange-600 dark:text-orange-400">{t('uiux.guide.build.mobile.title')}</h3>
          </div>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">{t('uiux.guide.build.mobile.desc')}</p>
          <div class="space-y-1 text-xs text-slate-500 dark:text-slate-400">
              <div class="flex items-center gap-2"><span class="text-orange-400">•</span> {t('uiux.guide.build.mobile.list1')}</div>
              <div class="flex items-center gap-2"><span class="text-orange-400">•</span> {t('uiux.guide.build.mobile.list2')}</div>
              <div class="flex items-center gap-2"><span class="text-orange-400">•</span> {t('uiux.guide.build.mobile.list3')}</div>
              <div class="flex items-center gap-2"><span class="text-orange-400">•</span> {t('uiux.guide.build.mobile.list4')}</div>
          </div>
      </div>
  </div>
</div>

<!-- Design Styles Showcase -->
<div class="glass-card rounded-xl overflow-hidden">
  <div class="p-6 bg-gradient-to-r from-amber-50/50 to-orange-50/50 dark:from-amber-500/10 dark:to-orange-500/10 border-b border-slate-200 dark:border-slate-800">
    <h2 class="text-2xl font-bold font-heading text-amber-600 dark:text-amber-400 flex items-center gap-3">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      {t('uiux.guide.styles.title')}
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-500 mt-2">{t('uiux.guide.styles.subtitle')}</p>
  </div>
  <div class="p-6 grid grid-cols-2 md:grid-cols-4 gap-3">
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-indigo-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-indigo-600 dark:text-indigo-400 mb-1">{t('uiux.guide.style.glassmorphism')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.glassmorphism_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-purple-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-purple-600 dark:text-purple-400 mb-1">{t('uiux.guide.style.minimalism')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.minimalism_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-pink-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-pink-600 dark:text-pink-400 mb-1">{t('uiux.guide.style.aurora')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.aurora_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-cyan-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-cyan-600 dark:text-cyan-400 mb-1">{t('uiux.guide.style.dark_mode')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.dark_mode_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-emerald-600 dark:text-emerald-400 mb-1">{t('uiux.guide.style.neumorphism')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.neumorphism_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-amber-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-amber-600 dark:text-amber-400 mb-1">{t('uiux.guide.style.brutalism')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.brutalism_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-rose-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-rose-600 dark:text-rose-400 mb-1">{t('uiux.guide.style.claymorphism')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.claymorphism_desc')}</div>
      </div>
      <div class="p-3 rounded-lg bg-surface-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-blue-500/30 transition-colors cursor-pointer">
          <div class="text-sm font-medium text-blue-600 dark:text-blue-400 mb-1">{t('uiux.guide.style.more')}</div>
          <div class="text-xs text-slate-500">{t('uiux.guide.style.more_desc')}</div>
      </div>
  </div>
</div>

<!-- Tips for Non-Tech Users -->
<div class="bg-gradient-to-br from-emerald-500/10 via-green-500/10 to-teal-500/10 rounded-xl border border-emerald-200 dark:border-emerald-500/30 p-8">
   <h2 class="text-2xl font-bold text-emerald-600 dark:text-emerald-400 mb-6 flex items-center gap-3">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
      {t('uiux.guide.tips.title')}
   </h2>
   <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-lg border border-emerald-500/10 flex items-start gap-3">
          <svg class="w-6 h-6 text-emerald-500 dark:text-emerald-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <div>
            <div class="font-bold text-emerald-700 dark:text-emerald-300 mb-1">{t('uiux.guide.tips.1.title')}</div>
            <p class="text-xs text-slate-600 dark:text-slate-400">{t('uiux.guide.tips.1.desc')}</p>
          </div>
      </div>
      <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-lg border border-emerald-500/10 flex items-start gap-3">
          <svg class="w-6 h-6 text-green-500 dark:text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <div>
            <div class="font-bold text-emerald-700 dark:text-emerald-300 mb-1">{t('uiux.guide.tips.2.title')}</div>
            <p class="text-xs text-slate-600 dark:text-slate-400">{t('uiux.guide.tips.2.desc')}</p>
          </div>
      </div>
      <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-lg border border-emerald-500/10 flex items-start gap-3">
          <svg class="w-6 h-6 text-teal-500 dark:text-teal-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <div>
            <div class="font-bold text-emerald-700 dark:text-emerald-300 mb-1">{t('uiux.guide.tips.3.title')}</div>
            <p class="text-xs text-slate-600 dark:text-slate-400">{t('uiux.guide.tips.3.desc')}</p>
          </div>
      </div>
      <div class="bg-white/50 dark:bg-slate-900/50 p-4 rounded-lg border border-emerald-500/10 flex items-start gap-3">
          <svg class="w-6 h-6 text-cyan-500 dark:text-cyan-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <div>
            <div class="font-bold text-emerald-700 dark:text-emerald-300 mb-1">{t('uiux.guide.tips.4.title')}</div>
            <p class="text-xs text-slate-600 dark:text-slate-400">{t('uiux.guide.tips.4.desc')}</p>
          </div>
      </div>
   </div>
</div>
