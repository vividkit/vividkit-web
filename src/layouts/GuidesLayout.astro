---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import TabNavigation from '@/components/guides/TabNavigation.astro';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  activeTab:
    | 'index'
    | 'cli'
    | 'ccs'
    | 'ck-with-codex'
    | 'codex-app'
    | 'remote-control'
    | 'ui-review-gate'
    | 'ide-config'
    | 'coexistence'
    | 'workflows'
    | 'flowchart'
    | 'commands'
    | 'cli-commands'
    | 'uiux'
    | 'session-recovery'
    | 'permissions'
    | 'hooks'
    | 'promotions'
    | 'donate'
    | 'what-is-claudekit'
    | 'fix-logs'
    | 'migrate'
    | 'how-ck-works'
    | 'claude-mechanics'
    | 'inside-claudekit'
    | 'inside-claudekit-plan-modes'
    | 'inside-claudekit-frontend-design'
    | 'inside-claudekit-getting-started'
    | 'inside-claudekit-guard-rails'
    | 'deals'
    | 'lucky-draw';
  lang?: Language;
}

const { title, description, canonicalPath, activeTab, lang } = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const isInsideClaudeKitArticle = [
  'inside-claudekit-plan-modes',
  'inside-claudekit-frontend-design',
  'inside-claudekit-getting-started',
  'inside-claudekit-guard-rails',
].includes(activeTab);
const showSidebar = !isInsideClaudeKitArticle;
const isWideSidebarGuide = activeTab === 'codex-app';
---

<MainLayout
  title={title}
  description={description}
  canonical={canonicalPath || `/guides${activeTab !== 'index' ? '/' + activeTab : ''}`}
  lang={currentLang}
>
  <Header lang={currentLang} />

  <div class:list={[
    'mx-auto px-4 lg:px-0 pt-28 pb-12 min-h-screen',
    showSidebar ? (isWideSidebarGuide ? 'max-w-7xl' : 'max-w-6xl') : 'max-w-7xl',
  ]}>
    <div class:list={[showSidebar && (isWideSidebarGuide ? 'lg:flex lg:gap-8 xl:gap-10' : 'lg:flex lg:gap-12')]}>
      {showSidebar && (
        <div class="lg:w-64 lg:shrink-0 z-30">
          <TabNavigation activeTab={activeTab} lang={currentLang} />
        </div>
      )}

      <main class:list={[showSidebar ? 'flex-1 min-w-0' : 'min-w-0']}>
        <slot />
      </main>
    </div>
  </div>

  <Footer lang={currentLang} />
</MainLayout>
