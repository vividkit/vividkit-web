---
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import TabNavigation from '@/components/guides/TabNavigation.astro';
import type { GuideActiveTab } from '@/types/guides';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  activeTab: GuideActiveTab;
  lang?: Language;
}

const { title, description, canonicalPath, activeTab, lang } = Astro.props;

const currentLang = lang || getLangFromUrl(Astro.url);
const isInsideClaudeKitArticle = [
  'inside-claudekit-plan-modes',
  'inside-claudekit-frontend-design',
  'inside-claudekit-getting-started',
  'inside-claudekit-guard-rails',
].includes(activeTab);
const showSidebar = !isInsideClaudeKitArticle;
const isWideSidebarGuide = activeTab === 'codex-app';

const agentkitCanonicalMap: Record<string, string> = {
  agentkit: '/guides/agentkit',
  'agentkit-how-it-works': '/guides/agentkit/how-it-works',
  'agentkit-building-blocks': '/guides/agentkit/building-blocks',
  'agentkit-runtime-support': '/guides/agentkit/runtime-support',
  'agentkit-desktop-app': '/guides/agentkit/desktop-app',
  'agentkit-getting-started': '/guides/agentkit/getting-started',
  'agentkit-configuration': '/guides/agentkit/configuration',
  'agentkit-cli-commands': '/guides/agentkit/cli-commands',
  'agentkit-skills': '/guides/agentkit/skills',
  'agentkit-statusline': '/guides/agentkit/statusline',
  'agentkit-updating': '/guides/agentkit/updating',
  'agentkit-troubleshooting': '/guides/agentkit/troubleshooting',
  'agentkit-clean-cutover-from-claudekit': '/guides/agentkit/clean-cutover-from-claudekit',
  'migrate-claudekit-to-agentkit': '/guides/migrate-claudekit-to-agentkit',
};

const resolvedCanonical =
  canonicalPath ||
  agentkitCanonicalMap[activeTab] ||
  (activeTab === 'index' ? '/guides' : `/guides/${activeTab}`);
---

<MainLayout
  title={title}
  description={description}
  canonical={resolvedCanonical}
  lang={currentLang}
>
  <Header lang={currentLang} />

  <div class:list={[
    'mx-auto px-4 lg:px-0 pt-28 pb-12 min-h-screen',
    showSidebar ? (isWideSidebarGuide ? 'max-w-7xl' : 'max-w-6xl') : 'max-w-7xl',
  ]}>
    <div class:list={[showSidebar && (isWideSidebarGuide ? 'lg:flex lg:gap-8 xl:gap-10' : 'lg:flex lg:gap-12')]}>
      {showSidebar && (
        <div class="lg:w-64 lg:shrink-0 z-30">
          <TabNavigation activeTab={activeTab} lang={currentLang} />
        </div>
      )}

      <main class:list={[showSidebar ? 'flex-1 min-w-0' : 'min-w-0']}>
        <slot />
      </main>
    </div>
  </div>

  <Footer lang={currentLang} />
</MainLayout>
