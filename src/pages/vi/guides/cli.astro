---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import CLIGuide from '@/components/guides/CLIGuide.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`Hướng dẫn AgentKit CLI - ${t('site.title')}`}
  description="Cài AgentKit ak CLI, đăng nhập, quản lý kit cho Claude Code hoặc Codex và cập nhật từng lifecycle an toàn."
  canonicalPath="/vi/guides/cli"
  activeTab="cli"
  lang="vi"
>
  <CLIGuide lang={lang} />
</GuidesLayout>
