---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import CodexAppGuide from '@/components/guides/CodexAppGuide.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.codex_app.title')} - ${t('site.title')}`}
  description={t('guides.codex_app.description')}
  activeTab="codex-app"
  lang="vi"
>
  <CodexAppGuide lang="vi" />
</GuidesLayout>
