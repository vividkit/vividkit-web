---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import CursorGuide from '@/components/guides/CursorGuide.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.cursor.title')} - ${t('site.title')}`}
  description={t('guides.cursor.description')}
  canonicalPath="/guides/cursor"
  activeTab="cursor"
  lang="vi"
>
  <CursorGuide lang="vi" />
</GuidesLayout>
