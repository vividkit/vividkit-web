---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import InsideClaudeKitGuide from '@/components/guides/InsideClaudeKitGuide.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.inside_claudekit.title')} - ${t('site.title')}`}
  description={t('guides.inside_claudekit.description')}
  canonicalPath="/guides/inside-claudekit"
  activeTab="inside-claudekit"
  lang="vi"
>
  <InsideClaudeKitGuide lang="vi" />
</GuidesLayout>
