---
import { insideClaudeKitTopics } from '@/data/guides/inside-claudekit';

// Check if this topic is disabled
const topic = insideClaudeKitTopics.find((t) => t.slug === 'frontend-design');
if (topic?.disabled) {
  return Astro.redirect('/vi/guides/inside-claudekit');
}

import GuidesLayout from '@/layouts/GuidesLayout.astro';
import InsideClaudeKitFrontendDesignArticle from '@/components/guides/inside-claudekit/InsideClaudeKitFrontendDesignArticle.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.home.inside_claudekit.topic_2.title')} - ${t('site.title')}`}
  description={t('guides.home.inside_claudekit.topic_2.desc')}
  canonicalPath="/guides/inside-claudekit/frontend-design"
  activeTab="inside-claudekit-frontend-design"
  lang="vi"
>
  <InsideClaudeKitFrontendDesignArticle lang="vi" />
</GuidesLayout>
