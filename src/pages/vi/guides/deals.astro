---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import DealsGuide from '@/components/guides/DealsGuide.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.deals.title')} - Tiết kiệm 60% ClaudeKit | VividKit`}
  description={t('guides.deals.description')}
  activeTab="deals"
  lang="vi"
>
  <DealsGuide lang="vi" />
</GuidesLayout>
