---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';
import SetupWizardRoot from '@/components/guides/setup-wizard/setup-wizard-root.astro';

const lang: Language = 'vi';
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.setup_wizard.title')} - ${t('site.title')}`}
  description={t('guides.setup_wizard.description')}
  activeTab="setup-wizard"
  lang="vi"
>
  <SetupWizardRoot locale="vi" />
</GuidesLayout>
