---
import LegacyGuidesLayout from '@/layouts/LegacyGuidesLayout.astro';
import LegacyGuideStub from '@/components/guides/legacy/LegacyGuideStub.astro';
import LegacyClaudeMechanicsGuide from '@/components/guides/legacy/LegacyClaudeMechanicsGuide.astro';
import LegacyCoexistenceGuide from '@/components/guides/legacy/LegacyCoexistenceGuide.astro';
import LegacyCkWithCodexGuide from '@/components/guides/legacy/LegacyCkWithCodexGuide.astro';
import LegacyBatchBGuideBody from '@/components/guides/legacy/LegacyBatchBGuideBody.astro';
import LegacyBatchCGuideBody from '@/components/guides/legacy/LegacyBatchCGuideBody.astro';
import {
  getLegacyGuideEntry,
  LEGACY_BATCH_B_SUFFIXES,
  LEGACY_BATCH_C_SUFFIXES,
  LEGACY_GUIDE_CATALOG,
} from '@/data/guides/legacy-guide-catalog';
import { getLangFromUrl } from '@/i18n';

export function getStaticPaths() {
  return LEGACY_GUIDE_CATALOG.map((entry) => ({
    params: { slug: entry.suffix },
  }));
}

const lang = getLangFromUrl(Astro.url);
const suffix = Astro.params.slug ?? '';
const entry = getLegacyGuideEntry(suffix);
const isVi = lang === 'vi';
const frozen = entry?.freezeStatus === 'frozen' || entry?.freezeStatus === 'isolated';
const isBatchB = (LEGACY_BATCH_B_SUFFIXES as readonly string[]).includes(suffix);
const isBatchC = (LEGACY_BATCH_C_SUFFIXES as readonly string[]).includes(suffix);
const title = entry
  ? `${isVi ? entry.titleVi : entry.titleEn} (ClaudeKit archive)`
  : 'ClaudeKit archive';
const description = frozen
  ? (isVi
    ? 'Bản archive ClaudeKit đã isolate — nội dung lịch sử để tra cứu. Guide hiện tại nằm dưới /guides.'
    : 'Isolated ClaudeKit archive content for reference. Current guidance lives under /guides.')
  : (isVi
    ? 'Trang archive ClaudeKit (stub). Nội dung isolated sẽ được bổ sung ở batch sau.'
    : 'ClaudeKit archive stub. Isolated content will land in a follow-up batch.');
---

<LegacyGuidesLayout
  title={title}
  description={description}
  legacySuffix={suffix}
  currentGuideSuffix={entry?.currentGuideSuffix ?? suffix}
  lang={lang}
>
  {suffix === 'claude-mechanics' ? (
    <LegacyClaudeMechanicsGuide lang={lang} />
  ) : suffix === 'coexistence' ? (
    <LegacyCoexistenceGuide lang={lang} />
  ) : suffix === 'ck-with-codex' ? (
    <LegacyCkWithCodexGuide lang={lang} />
  ) : isBatchB ? (
    <LegacyBatchBGuideBody suffix={suffix} lang={lang} />
  ) : isBatchC ? (
    <LegacyBatchCGuideBody suffix={suffix} lang={lang} />
  ) : (
    <LegacyGuideStub suffix={suffix} lang={lang} />
  )}
</LegacyGuidesLayout>
