---
import MainLayout from '@/layouts/MainLayout.astro';
import { getLangFromUrl, useTranslatedPath } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const isVi = lang === 'vi';

const copy = isVi
  ? {
      eyebrow: 'Lỗi 404',
      title: 'Trang không tồn tại',
      desc: 'Trang bạn đang tìm có thể đã bị di chuyển, ẩn đi, hoặc chưa từng tồn tại. Quay về trang chủ để tiếp tục khám phá.',
      home: 'Về trang chủ',
      guides: 'Xem Guides',
    }
  : {
      eyebrow: 'Error 404',
      title: 'Page not found',
      desc: 'The page you are looking for may have been moved, hidden, or never existed. Head back home to continue exploring.',
      home: 'Back to home',
      guides: 'Browse Guides',
    };
---

<MainLayout
  title={copy.title}
  description={copy.desc}
  canonical="/404"
  lang={lang}
>
  <main class="relative isolate min-h-[calc(100vh-4rem)] overflow-hidden bg-white dark:bg-slate-950">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(99,102,241,0.12),transparent_55%)] dark:bg-[radial-gradient(circle_at_top,rgba(99,102,241,0.18),transparent_55%)]"></div>

    <div class="mx-auto flex min-h-[calc(100vh-4rem)] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 backdrop-blur dark:border-slate-700/80 dark:bg-slate-900/60 dark:text-slate-400">
        {copy.eyebrow}
      </span>

      <h1 class="mt-6 bg-gradient-to-br from-indigo-500 via-purple-500 to-fuchsia-500 bg-clip-text text-7xl font-black tracking-tight text-transparent sm:text-8xl">
        404
      </h1>

      <h2 class="mt-4 text-2xl font-bold text-slate-900 sm:text-3xl dark:text-white">
        {copy.title}
      </h2>

      <p class="mt-3 max-w-xl text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {copy.desc}
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={translatePath('/')}
          class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition-all hover:-translate-y-0.5 hover:bg-slate-800 hover:shadow-xl dark:bg-white dark:text-slate-900 dark:shadow-white/10 dark:hover:bg-slate-100"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
          {copy.home}
        </a>
        <a
          href={translatePath('/guides')}
          class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/80 px-5 py-2.5 text-sm font-semibold text-slate-700 backdrop-blur transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700 dark:border-slate-700/80 dark:bg-slate-900/60 dark:text-slate-300 dark:hover:border-indigo-500/50 dark:hover:bg-indigo-950/40 dark:hover:text-indigo-300"
        >
          {copy.guides}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
      </div>
    </div>
  </main>
</MainLayout>
