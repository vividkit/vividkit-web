        <div class="flex flex-wrap items-end gap-6">
          <div class="text-center">
            <Zap class="w-4 h-4 text-blue-500 mx-auto" />
            <p class="text-xs text-slate-500 mt-2">w-4 h-4</p>
            <p class="text-[10px] text-slate-400">16px</p>
