          <div class="text-center">
            <Zap class="w-5 h-5 text-blue-500 mx-auto" />
            <p class="text-xs text-slate-500 mt-2">w-5 h-5</p>
            <p class="text-[10px] text-slate-400">20px</p>
          </div>
          <div class="text-center">
            <Zap class="w-6 h-6 text-blue-500 mx-auto" />
            <p class="text-xs text-slate-500 mt-2">w-6 h-6</p>
            <p class="text-[10px] text-slate-400">24px</p>
          </div>
          <div class="text-center">
            <Zap class="w-8 h-8 text-blue-500 mx-auto" />
            <p class="text-xs text-slate-500 mt-2">w-8 h-8</p>
            <p class="text-[10px] text-slate-400">32px</p>
          </div>
        </div>
      </div>
