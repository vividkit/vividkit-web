---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import ClaudeMechanicsGuide from '@/components/guides/ClaudeMechanicsGuide.astro';
import { getLangFromUrl } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
---

<GuidesLayout
  title="Claude Mechanics - Understanding CLAUDE.md & Config"
  description="Learn how CLAUDE.md works, understand the config hierarchy, and see what ck init creates. Visual guide for non-technical users."
  activeTab="claude-mechanics"
  lang={lang}
>
  <div class="mt-6 pb-20">
    <ClaudeMechanicsGuide lang={lang} />
  </div>
</GuidesLayout>
