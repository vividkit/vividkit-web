---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import GuidesHomePage from '@/components/guides/GuidesHomePage.astro';
import { getLangFromUrl } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
---

<GuidesLayout
  title="VividKit Guides - Your AI Coding Journey"
  description="Explore ClaudeKit guides for beginners to advanced users. Find pathways for getting started, exploring features, understanding config, and more."
  activeTab="index"
  lang={lang}
>
  <GuidesHomePage lang={lang} />
</GuidesLayout>
