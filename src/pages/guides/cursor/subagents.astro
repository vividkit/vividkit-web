---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import CursorArticle from '@/components/guides/cursor/CursorArticle.astro';
import { cursorArticles } from '@/data/guides/cursor';
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';

const lang: Language = 'en';
const t = useTranslations(lang);
const article = cursorArticles.subagents;
---

<GuidesLayout
  title={`${article.title.en} - ${t('site.title')}`}
  description={article.summary.en}
  canonicalPath="/guides/cursor/subagents"
  activeTab="cursor-subagents"
  lang="en"
>
  <CursorArticle slug="subagents" lang="en" />
</GuidesLayout>
