---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import WhatIsAgentKitGuide from '@/components/guides/agentkit/WhatIsAgentKitGuide.astro';
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.agentkit.title')} - VividKit Guides`}
  description={t('guides.agentkit.description')}
  canonicalPath="/guides/agentkit"
  activeTab="agentkit"
  lang={lang}
>
  <WhatIsAgentKitGuide lang={lang} />
</GuidesLayout>
