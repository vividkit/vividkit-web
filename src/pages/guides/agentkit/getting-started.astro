---
import GuidesLayout from '@/layouts/GuidesLayout.astro';
import AgentKitGettingStartedGuide from '@/components/guides/agentkit/AgentKitGettingStartedGuide.astro';
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl } from '@/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<GuidesLayout
  title={`${t('guides.agentkit.getting_started.title')} - VividKit Guides`}
  description={t('guides.agentkit.getting_started.description')}
  canonicalPath="/guides/agentkit/getting-started"
  activeTab="agentkit-getting-started"
  lang={lang}
>
  <AgentKitGettingStartedGuide lang={lang} />
</GuidesLayout>
