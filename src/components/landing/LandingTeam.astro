---
import TeamBot from './TeamBot.astro';
import { landingContent, TEAMMATE_COLORS } from '@/data/landing-content';
import type { Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const c = landingContent[lang].team;
---

<section id="team" class="vkl-section">
  <div class="vkl-wrap">
    <p class="vkl-eyebrow">{c.eyebrow}</p>
    <h2 class="vkl-h2">{c.title}</h2>
    <p class="vkl-lead">{c.lead}</p>

    <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {c.members.map((p) => (
        <li class="vkl-panel p-5 flex gap-4 items-start">
          <TeamBot id={p.id} size={64} class="-my-1" />
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h3 class="text-[17px] font-bold">{p.name}</h3>
              <span class="text-[13px] font-semibold" style={`color:${TEAMMATE_COLORS[p.id]}`}>{p.role}</span>
              {p.optional && <span class="vkl-pill vkl-pill-muted">{c.optionalTag}</span>}
            </div>
            <p class="mt-1.5 text-[14px] leading-relaxed text-[var(--vk-ink2)]">{p.does}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Person colours are tuned for light surfaces; lift them on dark. */
  :global(.dark) li span[style] { filter: brightness(1.6) saturate(0.9); }
</style>
