---
import { landingContent, BUILDER_LINKS } from '@/data/landing-content';
import { useTranslatedPath, type Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const c = landingContent[lang].start;
const g = landingContent[lang].guides;
const translatePath = useTranslatedPath(lang);
const installUrl = `${BUILDER_LINKS.docs[lang]}/getting-started/requirements`;
---

<section id="get-started" class="vkl-section">
  <div class="vkl-wrap">
    <div class="vkl-panel p-6 md:p-10 grid gap-10 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h2 class="vkl-h2">{c.title}</h2>
        <p class="vkl-lead">{c.lead}</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <span class="vkl-btn vkl-btn-soon" aria-disabled="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {c.ctaPrimary}
          </span>
          <a href={installUrl} target="_blank" rel="noopener noreferrer" class="vkl-btn vkl-btn-quiet">{c.ctaSecondary}</a>
        </div>
      </div>

      <div class="grid gap-6">
        <div>
          <h3 class="text-[13px] font-semibold text-[var(--vk-ink3)]">{c.needsTitle}</h3>
          <ul class="mt-3 grid gap-2">
            {c.needs.map((n) => (
              <li class="flex gap-3 text-[14.5px] leading-relaxed">
                <svg viewBox="0 0 16 16" class="w-4 h-4 mt-1 shrink-0 text-[var(--vk-acc)]" aria-hidden="true"><path d="M3.5 8.2l3 3 6-6.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {n}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-[13px] font-semibold text-[var(--vk-ink3)]">{c.systemsTitle}</h3>
          <ul class="mt-3 rounded-[10px] bg-[var(--vk-inset)] shadow-[var(--vk-ring)] divide-y divide-[var(--vk-line-strong)]">
            {c.systems.map((s) => (
              <li class="flex items-center justify-between gap-4 px-4 py-2.5 text-[14px]">
                <span class="font-semibold">{s.name}</span>
                <span class={s.ok ? 'text-[var(--vk-ok)]' : 'text-[var(--vk-ink3)]'}>{s.status}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-3 vkl-panel p-5 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <div class="flex-1">
        <h3 class="text-[15px] font-semibold">{g.title}</h3>
        <p class="mt-1 text-[14px] leading-relaxed text-[var(--vk-ink2)]">{g.body}</p>
      </div>
      <a href={translatePath('/guides')} class="vkl-btn vkl-btn-quiet shrink-0">{g.cta}</a>
    </div>
  </div>
</section>
