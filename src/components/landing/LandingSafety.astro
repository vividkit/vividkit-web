---
import { landingContent, BUILDER_LINKS } from '@/data/landing-content';
import type { Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const c = landingContent[lang].safety;
const safetyUrl = `${BUILDER_LINKS.docs[lang]}/guide/safety`;
---

<section id="safety" class="vkl-section">
  <div class="vkl-wrap">
    <p class="vkl-eyebrow">{c.eyebrow}</p>
    <h2 class="vkl-h2">{c.title}</h2>
    <p class="vkl-lead">{c.lead}</p>

    <ul class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {c.items.map((s) => (
        <li class="vkl-panel p-5">
          <svg viewBox="0 0 16 16" class="w-4 h-4 text-[var(--vk-ok)]" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="currentColor" opacity=".14"/><path d="M5 8.2l2 2 4-4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h3 class="mt-3 text-[16px] font-semibold">{s.title}</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-[var(--vk-ink2)]">{s.body}</p>
        </li>
      ))}
    </ul>

    <div class="mt-3 vkl-panel p-5 flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
      <div class="flex-1">
        <h3 class="text-[15px] font-semibold">{c.autoTitle}</h3>
        <p class="mt-1 text-[14px] leading-relaxed text-[var(--vk-ink2)]">{c.autoBody}</p>
      </div>
      <a href={safetyUrl} target="_blank" rel="noopener noreferrer" class="vkl-btn vkl-btn-quiet shrink-0">{c.more}</a>
    </div>
  </div>
</section>
