---
// A static, faithful sketch of the app's issue screen (sidebar, relay track,
// question card, running inspector). Decorative: hidden from screen readers.
import TeamBot from './TeamBot.astro';
import { landingContent, type TeammateId } from '@/data/landing-content';
import type { Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const m = landingContent[lang].mock;
const team: TeammateId[] = ['cora', 'ada', 'dee', 'ben', 'tess', 'ivy'];
const names: Record<TeammateId, string> = { cora: 'Cora', ada: 'Ada', dee: 'Dee', ben: 'Ben', tess: 'Tess', ivy: 'Ivy' };
---

<div class="mock" aria-hidden="true">
  <!-- Window bar -->
  <div class="mock-bar">
    <span></span><span></span><span></span>
  </div>

  <div class="mock-body">
    <!-- Sidebar -->
    <aside class="mock-side">
      <div class="side-item side-row">
        <span>{m.inbox}</span>
        <span class="count vkl-mono">2</span>
      </div>
      <div class="side-label">{m.projects}</div>
      <div class="side-item side-active">
        <span class="proj-mark">K</span>
        <span>{m.project}</span>
      </div>
      <div class="side-label">{m.team}</div>
      {team.map((id) => (
        <div class="side-member">
          <TeamBot id={id} size={8} />
          <span class="flex-1">{names[id]}</span>
          <span class={id === 'ben' ? 'st-working' : id === 'ada' ? 'st-wait' : 'st-idle'}>{m.teamStatus[id]}</span>
        </div>
      ))}
    </aside>

    <!-- Main panel -->
    <section class="mock-main">
      <div class="mock-head">
        <span class="crumb">{m.project} <span class="sep">/</span> <span class="vkl-mono">{m.issueId}</span></span>
      </div>

      <div class="mock-content">
        <div class="title-row">
          <h3 class="issue-title">{m.issueTitle}</h3>
          <span class="vkl-pill vkl-pill-acc">{m.state}</span>
        </div>

        <!-- Relay track -->
        <div class="relay">
          {m.stages.map((s) => (
            s.state === 'working' ? (
              <div class="stage-card vkl-live">
                <TeamBot id="ben" size={30} />
                <div>
                  <div class="stage-name">{s.name}</div>
                  <div class="stage-sub">{s.sub}</div>
                </div>
              </div>
            ) : (
              <div class={`stage ${s.state}`}>
                <div class="stage-name">
                  {s.state === 'done' ? (
                    <svg viewBox="0 0 16 16" class="glyph ok"><circle cx="8" cy="8" r="6.5" fill="currentColor" opacity=".14"/><path d="M5 8.2l2 2 4-4.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <svg viewBox="0 0 16 16" class="glyph next"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.2 2.2"/></svg>
                  )}
                  {s.name}
                </div>
                <div class="stage-sub">{s.sub}</div>
              </div>
            )
          ))}
          <div class="stage gate">
            <div class="stage-name">
              <svg viewBox="0 0 16 16" class="glyph"><rect x="3.5" y="7" width="9" height="6.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5.2a2.5 2.5 0 015 0V7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              {m.gate}
            </div>
          </div>
        </div>

        <!-- Question card -->
        <div class="question">
          <div class="q-label">{m.askLabel}</div>
          <div class="q-from">
            <TeamBot id="ada" size={28} />
            <span>{m.askFrom}</span>
          </div>
          <p class="q-text">{m.askText}</p>
          <div class="q-options">
            {m.options.map((o, i) => (
              <span class="q-opt"><kbd class="vkl-mono">{i + 1}</kbd>{o}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Inspector -->
    <aside class="mock-insp">
      <div class="insp-head">{m.running}</div>
      <div class="run-card vkl-live">
        <div class="run-top">
          <TeamBot id="ben" size={32} />
          <div class="flex-1">
            <div class="run-title">{m.runTitle}</div>
            <div class="run-rt vkl-mono">claude-code</div>
          </div>
          <span class="vkl-dot-live"></span>
        </div>
        <div class="run-log vkl-mono">
          {m.log.map((l) => (
            <div><span class="t">{l.time}</span>{l.text}</div>
          ))}
        </div>
        <span class="stop">{m.stop}</span>
      </div>
    </aside>
  </div>
</div>

<style>
  .mock {
    background: var(--vk-chrome);
    border-radius: 16px;
    box-shadow: var(--vk-shadow-float);
    overflow: hidden;
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    user-select: none;
  }
  .mock-bar { display: flex; gap: 6px; padding: 12px 14px 4px; }
  .mock-bar span { width: 10px; height: 10px; border-radius: 999px; background: var(--vk-line-strong); }
  .mock-body { display: grid; grid-template-columns: 188px 1fr 236px; gap: 0; padding: 0 8px 8px 0; min-height: 420px; }

  .mock-side { padding: 8px 10px 8px 12px; display: flex; flex-direction: column; gap: 2px; color: var(--vk-ink2); }
  .side-item { display: flex; align-items: center; gap: 8px; height: 28px; padding: 0 8px; border-radius: 9px; }
  .side-row { justify-content: space-between; }
  .side-active { background: var(--vk-panel); box-shadow: var(--vk-shadow-raise); color: var(--vk-ink); }
  .count { height: 18px; min-width: 18px; padding: 0 5px; border-radius: 999px; font-size: 10.5px; display: inline-flex; align-items: center; justify-content: center; background: var(--vk-warn-soft); color: var(--vk-warn); box-shadow: inset 0 0 0 1px var(--vk-warn-line); }
  .side-label { font-size: 11.5px; font-weight: 600; color: var(--vk-ink3); padding: 14px 8px 4px; }
  .proj-mark { width: 18px; height: 18px; border-radius: 5px; background: var(--vk-person-3); color: #fff; font-size: 10px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .side-member { display: flex; align-items: center; gap: 8px; height: 24px; padding: 0 8px; font-size: 12.5px; }
  .side-member > span:last-child { font-size: 11.5px; color: var(--vk-ink3); }
  .side-member .st-working { color: var(--vk-acc); }
  .side-member .st-wait { color: var(--vk-warn); }

  .mock-main { background: var(--vk-panel); border-radius: 14px 0 0 14px; box-shadow: var(--vk-shadow-card); margin-top: 0; display: flex; flex-direction: column; min-width: 0; }
  .mock-head { height: 44px; display: flex; align-items: center; padding: 0 18px; box-shadow: inset 0 -1px 0 var(--vk-line-strong); }
  .crumb { color: var(--vk-ink3); font-size: 12.5px; }
  .crumb .sep { opacity: 0.5; margin: 0 4px; }
  .mock-content { padding: 20px 18px; display: flex; flex-direction: column; gap: 18px; }
  .title-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .issue-title { font-size: 21px; font-weight: 650; letter-spacing: -0.028em; color: var(--vk-ink); }

  .relay { display: flex; align-items: center; gap: 10px 16px; flex-wrap: wrap; padding: 4px 0; }
  .stage { flex: none; }
  .stage-name { display: flex; align-items: center; gap: 6px; font-weight: 600; color: var(--vk-ink); white-space: nowrap; }
  .stage-sub { font-size: 11.5px; color: var(--vk-ink3); margin-top: 2px; white-space: nowrap; }
  .stage.next .stage-name { color: var(--vk-ink2); }
  .stage.gate .stage-name { color: var(--vk-ink3); font-weight: 500; font-size: 12px; }
  .stage-card { flex: none; display: flex; align-items: center; gap: 8px; height: 46px; padding: 0 12px 0 8px; border-radius: 14px; background: var(--vk-panel); box-shadow: var(--vk-shadow-float), inset 0 0 0 1px var(--vk-acc-line); }
  .stage-card .stage-sub { color: var(--vk-acc); }
  .glyph { width: 13px; height: 13px; flex: none; color: var(--vk-ink3); }
  .glyph.ok { color: var(--vk-ok); }

  .question { background: var(--vk-panel); border-radius: 16px; box-shadow: var(--vk-shadow-float); padding: 16px; max-width: 520px; }
  .q-label { font-size: 12px; font-weight: 600; color: var(--vk-warn); }
  .q-from { display: flex; align-items: center; gap: 4px; margin-top: 8px; font-size: 12.5px; font-weight: 600; color: var(--vk-ink2); }
  .q-text { margin-top: 6px; font-size: 15.5px; font-weight: 650; line-height: 1.45; color: var(--vk-ink); }
  .q-options { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .q-opt { display: inline-flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px 0 8px; border-radius: 10px; background: var(--vk-inset); box-shadow: var(--vk-ring); font-size: 13px; color: var(--vk-ink); }
  .q-opt kbd { width: 18px; height: 18px; border-radius: 5px; background: var(--vk-panel); box-shadow: var(--vk-shadow-raise); font-size: 10.5px; display: inline-flex; align-items: center; justify-content: center; color: var(--vk-ink2); }

  .mock-insp { background: var(--vk-inset); border-radius: 0 14px 14px 0; box-shadow: var(--vk-shadow-card); padding: 14px 12px; display: flex; flex-direction: column; gap: 10px; }
  .insp-head { font-size: 11.5px; font-weight: 600; color: var(--vk-ink3); }
  .run-card { background: var(--vk-panel); border-radius: 14px; box-shadow: var(--vk-shadow-raise); padding: 10px; display: flex; flex-direction: column; gap: 10px; }
  .run-top { display: flex; align-items: center; gap: 6px; }
  .run-title { font-weight: 650; color: var(--vk-ink); }
  .run-rt { font-size: 10.5px; color: var(--vk-ink3); }
  .run-log { background: var(--vk-log-bg); border-radius: 8px; padding: 8px; font-size: 10.5px; line-height: 1.75; color: var(--vk-log-ink); }
  .run-log > div { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .run-log .t { color: var(--vk-log-dim); margin-right: 8px; }
  .stop { align-self: flex-start; display: inline-flex; align-items: center; height: 28px; padding: 0 10px; border-radius: 10px; font-size: 12px; font-weight: 600; color: var(--vk-danger); background: var(--vk-danger-soft); }

  @media (max-width: 1023px) {
    .mock-body { grid-template-columns: 1fr 220px; padding-left: 8px; }
    .mock-side { display: none; }
    .mock-main { border-radius: 14px 0 0 14px; }
  }
  @media (max-width: 680px) {
    .mock-body { grid-template-columns: 1fr; padding: 0 8px 8px; min-height: 0; }
    .mock-insp { display: none; }
    .mock-main { border-radius: 14px; }
    .issue-title { font-size: 18px; }
  }
</style>
