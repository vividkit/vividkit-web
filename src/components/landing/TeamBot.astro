---
// Teammate avatar as in the app: a 3D bot from 28px up, a colour dot below.
// Bot images are rendered from the app's own bot-avatars package.
import { TEAMMATE_COLORS, type TeammateId } from '@/data/landing-content';

interface Props {
  id: TeammateId;
  size?: number;
  class?: string;
}

const { id, size = 32, class: className = '' } = Astro.props;
---

{size >= 28 ? (
  <img
    src={`/landing/bots/${id}.webp`}
    width={size}
    height={size}
    alt=""
    loading="lazy"
    decoding="async"
    class={`shrink-0 ${className}`}
    style={`width:${size}px;height:${size}px`}
  />
) : (
  <span
    aria-hidden="true"
    class={`inline-block shrink-0 rounded-full ${className}`}
    style={`width:${size}px;height:${size}px;background:${TEAMMATE_COLORS[id]}`}
  />
)}
