---
import TeamBot from './TeamBot.astro';
import { landingContent } from '@/data/landing-content';
import type { Language } from '@/i18n';

interface Props { lang: Language }
const { lang } = Astro.props;
const c = landingContent[lang].how;
---

<section id="how" class="vkl-section">
  <div class="vkl-wrap">
    <p class="vkl-eyebrow">{c.eyebrow}</p>
    <h2 class="vkl-h2">{c.title}</h2>
    <p class="vkl-lead">{c.lead}</p>

    <ol class="mt-12 grid gap-3 md:grid-cols-5">
      {c.steps.map((s) => (
        <li class="vkl-panel p-5 flex flex-col gap-3">
          {s.who === 'you' ? (
            <span class="you-mark" aria-hidden="true">
              <svg viewBox="0 0 16 16" class="w-4 h-4"><rect x="3.5" y="7" width="9" height="6.5" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5.5 7V5.2a2.5 2.5 0 015 0V7" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            </span>
          ) : (
            <TeamBot id={s.who} size={40} />
          )}
          <h3 class="text-[16px] font-semibold leading-snug">{s.title}</h3>
          <p class="text-[14px] leading-relaxed text-[var(--vk-ink2)]">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .you-mark {
    width: 40px; height: 40px; border-radius: 12px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--vk-warn-soft); color: var(--vk-warn);
    box-shadow: inset 0 0 0 1px var(--vk-warn-line);
  }
</style>
