---
// VividKit Builder landing page. The dark stages, console replay, safety bento and team row come
// from the vividkit.app home page; the rest introduces the product in more depth. The console and
// the team row are React islands so the bots and the run log move as they do on vividkit.app.
import MainLayout from '@/layouts/MainLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import {
  ArrowRight,
  BadgeCheck,
  Briefcase,
  Check,
  CalendarClock,
  ChevronDown,
  CircleCheck,
  Clock,
  Eye,
  FileCheck2,
  FolderGit2,
  GitBranch,
  Github,
  Hourglass,
  Layers,
  Lightbulb,
  Mail,
  MessageSquareText,
  MessagesSquare,
  Monitor,
  Puzzle,
  Rocket,
  ShieldCheck,
  Store,
  Terminal,
  Users,
  X,
} from 'lucide-astro';
import Highlight from './Highlight.astro';
import WaitlistForm from './WaitlistForm.astro';
import { AgentConsole } from './agent-console';
import { HomeBento } from './home-bento';
import { TeamShowcase } from './team-list';
import { CONTACT, landingContent, type AudienceIcon, type FlowIcon, type StackIcon, type WhyIcon } from '@/data/landing-content';
import { useTranslatedPath, type Language } from '@/i18n';
import '@/styles/landing.css';

interface Props { lang: Language }
const { lang } = Astro.props;
const c = landingContent[lang];
const translatePath = useTranslatedPath(lang);

const FLOW_ICONS: Record<FlowIcon, typeof Eye> = {
  message: MessageSquareText,
  file: FileCheck2,
  branch: GitBranch,
  eye: Eye,
  shield: ShieldCheck,
};
const WHY_ICONS: Record<WhyIcon, typeof Eye> = { chat: MessagesSquare, evidence: BadgeCheck, shield: ShieldCheck };
const AUDIENCE_ICONS: Record<AudienceIcon, typeof Eye> = { store: Store, rocket: Rocket, briefcase: Briefcase, users: Users };
const PATH_ICONS = [FolderGit2, Lightbulb];
const STACK_ICONS: Record<StackIcon, typeof Eye> = { claude: Terminal, kit: Puzzle, app: Monitor, more: Layers };
const STATUS_ICONS = { now: CircleCheck, beta: CalendarClock, later: Hourglass } as const;
---

<MainLayout title={c.meta.title} description={c.meta.description} canonical={lang === 'vi' ? '/vi/' : '/'} lang={lang}>
  <div class="vkh">
    <Header lang={lang} />

    <main class="vk-home">
      <!-- Hero -->
      <section id="hero" class="vk-stage">
        <div class="vk-stage-glow" aria-hidden="true"></div>
        <div class="vk-hero">
          <div class="vk-hero-text">
            <span class="vk-badge">
              <span class="vk-live-dot"></span>
              {c.hero.badge}
            </span>
            <h1>
              {c.hero.title[0]}<span class="vk-gradient-text">{c.hero.title[1]}</span>{c.hero.title[2]}
            </h1>
            <p class="vk-lead">{c.hero.lead}</p>
            <div class="vk-actions">
              <a href="#waitlist" class="vk-btn-primary">
                {c.waitlist.join}
                <ArrowRight size={16} />
              </a>
              <span class="vk-btn-soon">
                <Clock size={16} />
                {c.hero.soon}
                <small>· {c.hero.soonWhen}</small>
              </span>
            </div>
            <p class="vk-runs-on">{c.hero.noDownload}</p>
            <p class="vk-runs-on">{c.hero.runsOn}</p>
          </div>
          <figure class="vk-hero-figure">
            <div data-theme="dark">
              <AgentConsole client:visible lang={lang} />
            </div>
            <figcaption class="vk-figcaption">{c.hero.illustration}</figcaption>
          </figure>
        </div>
      </section>

      <!-- Why -->
      <section id="why" class="vk-section">
        <p class="vk-eyebrow">{c.why.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.why.title} /></h2>
        <p class="vk-section-lead">{c.why.lead}</p>
        <ul class="vk-why">
          {c.why.items.map((w) => {
            const Icon = WHY_ICONS[w.icon];
            return (
              <li>
                <div class="vk-why-before">
                  <X size={14} />
                  <div><small>{c.why.beforeLabel}</small><span>{w.before}</span></div>
                </div>
                <div class="vk-why-after">
                  <span class="vk-flow-icon"><Icon size={18} /></span>
                  <h3>{w.title}</h3>
                  <p>{w.body}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>

      <!-- Audience -->
      <section id="who" class="vk-section">
        <p class="vk-eyebrow">{c.audience.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.audience.title} /></h2>
        <p class="vk-section-lead">{c.audience.lead}</p>
        <ul class="vk-people">
          {c.audience.people.map((p) => {
            const Icon = AUDIENCE_ICONS[p.icon];
            return (
              <li>
                <Icon size={20} />
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </li>
            );
          })}
        </ul>
        <div class="vk-paths">
          {c.audience.paths.map((p, i) => {
            const Icon = PATH_ICONS[i];
            return (
              <div class="vk-path">
                <span class="vk-path-icon"><Icon size={20} /></span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- How it works -->
      <section id="how" class="vk-section">
        <p class="vk-eyebrow">{c.flow.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.flow.title} /></h2>
        <p class="vk-section-lead">{c.flow.lead}</p>
        <ol class="vk-flowline">
          {c.flow.steps.map(([icon, title, body]) => {
            const Icon = FLOW_ICONS[icon];
            return (
              <li>
                <span class="vk-flow-icon"><Icon size={18} /></span>
                <b>{title}</b>
                <small>{body}</small>
              </li>
            );
          })}
        </ol>
      </section>

      <!-- Status: what exists today, what the beta should include, what comes after -->
      <section id="status" class="vk-section">
        <p class="vk-eyebrow">{c.status.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.status.title} /></h2>
        <p class="vk-section-lead">{c.status.lead}</p>
        <div class="vk-status">
          {c.status.columns.map((col) => {
            const Icon = STATUS_ICONS[col.tone];
            return (
              <div class="vk-status-col" data-tone={col.tone}>
                <h3><Icon size={18} />{col.label}</h3>
                <ul>
                  {col.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            );
          })}
        </div>
        <p class="vk-fine vk-center">{c.status.note}</p>
      </section>

      <!-- Built on: the real role of Claude Code, AgentKit and VividKit -->
      <section id="stack" class="vk-section">
        <p class="vk-eyebrow">{c.stack.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.stack.title} /></h2>
        <p class="vk-section-lead">{c.stack.lead}</p>
        <ul class="vk-people">
          {c.stack.items.map((item) => {
            const Icon = STACK_ICONS[item.icon];
            return (
              <li>
                <Icon size={20} />
                <h3>{item.name}</h3>
                <p class="vk-role">{item.role}</p>
                <p>{item.body}</p>
              </li>
            );
          })}
        </ul>
        <p class="vk-fine vk-center">{c.stack.fine}</p>
      </section>

      <!-- Team -->
      <section id="team" class="vk-section">
        <p class="vk-eyebrow">{c.team.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.team.title} /></h2>
        <p class="vk-section-lead">{c.team.lead}</p>
        <TeamShowcase client:visible lang={lang} />
      </section>

      <!-- Workflows -->
      <section id="workflows" class="vk-section">
        <p class="vk-eyebrow">{c.workflows.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.workflows.title} /></h2>
        <p class="vk-section-lead">{c.workflows.lead}</p>
        <ul class="vk-workflows">
          {c.workflows.items.map((w) => (
            <li data-later={!w.inBeta || undefined}>
              <h3>
                {w.name}
                {!w.inBeta && <span class="vk-tag">{c.workflows.laterTag}</span>}
              </h3>
              <p>{w.when}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Safety -->
      <section id="safety" class="vk-section">
        <p class="vk-eyebrow">{c.safety.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.safety.title} /></h2>
        <p class="vk-section-lead">{c.safety.lead}</p>
        <HomeBento lang={lang} />
        <p class="vk-fine vk-center">{c.safety.illustration}</p>
        <div class="vk-note">
          <div>
            <h3>{c.safety.autoTitle}</h3>
            <p>{c.safety.autoBody}</p>
          </div>
        </div>
      </section>

      <!-- Runtimes and requirements -->
      <section id="runtimes" class="vk-section">
        <div class="vk-split">
          <div class="vk-split-card">
            <p class="vk-eyebrow vk-left">{c.runtimes.eyebrow}</p>
            <h2 class="vk-card-title"><Highlight text={c.runtimes.title} /></h2>
            <p class="vk-card-lead">{c.runtimes.lead}</p>
            <ul class="vk-chips">
              {c.runtimes.verified.map((r) => (
                <li><Check size={14} />{r}</li>
              ))}
            </ul>
            <p class="vk-fine">{c.runtimes.fine}</p>
          </div>
          <div class="vk-split-card">
            <p class="vk-eyebrow vk-left">{c.start.eyebrow}</p>
            <h2 class="vk-card-title"><Highlight text={c.start.title} /></h2>
            <p class="vk-card-lead">{c.start.lead}</p>
            <h3 class="vk-mini-label">{c.start.needsTitle}</h3>
            <ul class="vk-needs">
              {c.start.needs.map((n) => (
                <li><Check size={15} />{n}</li>
              ))}
            </ul>
            <h3 class="vk-mini-label">{c.start.systemsTitle}</h3>
            <ul class="vk-systems">
              {c.start.systems.map((s) => (
                <li data-ok={s.ok}>
                  <span>{s.name}</span>
                  <em>{s.status}</em>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="vk-section">
        <p class="vk-eyebrow">{c.faq.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.faq.title} /></h2>
        <div class="vk-faq">
          {c.faq.items.map((f) => (
            <details>
              <summary>
                {f.q}
                <ChevronDown size={18} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Closing band -->
      <section id="waitlist" class="vk-stage vk-cta">
        <div class="vk-stage-glow" aria-hidden="true"></div>
        <span class="vk-badge">
          <span class="vk-live-dot"></span>
          {c.hero.soon} · {c.hero.soonWhen}
        </span>
        <h2><Highlight text={c.cta.title} /></h2>
        <p>{c.cta.lead}</p>
        <WaitlistForm lang={lang} />
      </section>

      <!-- About: founder and contact -->
      <section id="about" class="vk-section">
        <p class="vk-eyebrow">{c.about.eyebrow}</p>
        <h2 class="vk-section-title"><Highlight text={c.about.title} /></h2>
        <p class="vk-section-lead">{c.about.lead}</p>
        <div class="vk-paths">
          <div class="vk-path">
            <span class="vk-path-icon vk-initials" aria-hidden="true">TN</span>
            <div>
              <h3>{c.about.founder.name}</h3>
              <p class="vk-role">{c.about.founder.role}</p>
              <p>{c.about.founder.body}</p>
              <a class="vk-link" href={CONTACT.founderGithub} target="_blank" rel="noopener noreferrer">
                <Github size={16} />
                {c.about.founder.github}
                <span class="sr-only">: {c.about.founder.name}</span>
              </a>
            </div>
          </div>
          <div class="vk-path">
            <span class="vk-path-icon"><Mail size={20} /></span>
            <div>
              <h3>{c.about.contact.title}</h3>
              <p>{c.about.contact.body}</p>
              <a class="vk-link" href={`mailto:${CONTACT.email}`}>
                <Mail size={16} />
                {CONTACT.email}
              </a>
              <br />
              <a class="vk-link vk-link-tight" href={CONTACT.orgGithub} target="_blank" rel="noopener noreferrer">
                <Github size={16} />
                {c.about.contact.github}
              </a>
            </div>
          </div>
        </div>
        <p class="vk-fine vk-center">{c.about.independent}</p>
      </section>

      <!-- Resources: the guides stay a separate part of the site -->
      <section id="guides" class="vk-section">
        <div class="vk-note">
          <div>
            <p class="vk-eyebrow vk-left">{c.guides.eyebrow}</p>
            <h2 class="vk-card-title"><Highlight text={c.guides.title} /></h2>
            <p>{c.guides.lead}</p>
            <ul class="vk-guide-links">
              {c.guides.links.map((l) => (
                <li><a href={translatePath(l.path)}>{l.label}</a></li>
              ))}
            </ul>
            <p class="vk-fine">{c.guides.fine}</p>
          </div>
          <a href={translatePath('/guides')} class="vk-btn-quiet">
            {c.guides.cta}
            <ArrowRight size={16} />
          </a>
        </div>
      </section>
    </main>
  </div>
  <Footer lang={lang} />
</MainLayout>
