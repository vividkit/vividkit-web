      {isVi ? 'Không có skill NEW trong kit này' : 'No NEW skills in this kit'}
    </p>
    <p data-ak-common-empty class="hidden rounded-2xl border border-dashed border-sky-300/70 bg-sky-50/50 px-4 py-8 text-center text-sm text-slate-600 dark:border-sky-500/30 dark:bg-sky-950/20 dark:text-slate-300">
      {isVi ? 'Không có skill COMMON trong kit này' : 'No COMMON skills in this kit'}
    </p>
  </div>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Tiếp theo' : 'Related guides'}
    links={[
      {
        href: '/guides/agentkit/workflows',
        label: isVi ? 'Workflows — chuỗi skill' : 'Workflows — skill chains',
        desc: isVi
          ? 'Khi nào nối plan → cook → fix → ship (và --advice)'
          : 'When to chain plan → cook → fix → ship (and --advice)',
      },
      {
        href: '/guides/agentkit/cli-commands',
        label: isVi ? 'CLI ak nhanh' : 'AgentKit CLI quick ref',
        desc: isVi ? 'Các lệnh ak: install, update, kit…' : 'ak commands: install, update, kit…',
      },
      {
        href: '/guides/agentkit/building-blocks',
        label: isVi ? 'Kit, Skill, Agent, Hook' : 'Kits, Skills, Agents, Hooks',
        desc: isVi ? 'Chọn đúng khối xây dựng' : 'Pick the right building block',
      },
      {
        href: '/guides/agentkit/getting-started',
        label: isVi ? 'Cài AgentKit' : 'Install AgentKit',
        desc: isVi ? 'Cài CLI ak và kit đầu tiên' : 'Install ak CLI and your first kit',
      },
    ]}
  />
</div>

<script>
  function bindAkSkillsUi() {
    const root = document.querySelector('[data-ak-skills-root]');
    if (!root || root.getAttribute('data-bound')) return;
    root.setAttribute('data-bound', '1');

    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-ak-kit-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-ak-kit-panel]');
    const newBtn = root.querySelector<HTMLButtonElement>('[data-ak-new-filter]');
    const commonBtn = root.querySelector<HTMLButtonElement>('[data-ak-common-filter]');

    const styleChip = (
      btn: HTMLButtonElement | null,
      on: boolean,
      countSel: string,
      onBtn: string,
      offBtn: string,
      onCount: string,
      offCount: string,
    ) => {
      if (!btn) return;
      const activeKit = root.querySelector('[data-ak-kit-tab][aria-selected="true"]')?.getAttribute('data-ak-kit-tab') || 'engineer';
      const countEl = btn.querySelector(countSel);
      if (countEl) {
        countEl.textContent = btn.getAttribute(activeKit === 'marketing' ? 'data-count-marketing' : 'data-count-engineer') || '0';
        countEl.className = on ? onCount : offCount;
      }
      btn.className = on ? onBtn : offBtn;
    };

    const applySkillFilters = () => {
      const newOn = newBtn?.getAttribute('aria-pressed') === 'true';
      const commonOn = commonBtn?.getAttribute('aria-pressed') === 'true';
      const filtering = newOn || commonOn;
      const attr = newOn ? 'data-new' : commonOn ? 'data-common' : '';

      styleChip(
        newBtn,
        newOn,
        '[data-ak-new-count]',
        'inline-flex items-center gap-1.5 rounded-md border border-amber-500 bg-amber-500 px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wide text-white shadow-sm shadow-amber-500/30 transition',
        'inline-flex items-center gap-1.5 rounded-md border border-amber-300 bg-amber-50 px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wide text-amber-800 transition hover:border-amber-400 dark:border-amber-500/40 dark:bg-amber-950/40 dark:text-amber-200',
        'rounded bg-white/25 px-1 font-mono text-[10px] font-semibold normal-case tracking-normal text-white',
        'rounded bg-amber-200/80 px-1 font-mono text-[10px] font-semibold normal-case tracking-normal text-amber-900 dark:bg-amber-500/20 dark:text-amber-100',
      );
      styleChip(
        commonBtn,
        commonOn,
        '[data-ak-common-count]',
        'inline-flex items-center gap-1.5 rounded-md border border-sky-600 bg-sky-600 px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wide text-white shadow-sm shadow-sky-500/30 transition',
        'inline-flex items-center gap-1.5 rounded-md border border-sky-300 bg-sky-50 px-2.5 py-1.5 text-[11px] font-bold uppercase tracking-wide text-sky-800 transition hover:border-sky-400 dark:border-sky-500/40 dark:bg-sky-950/40 dark:text-sky-200',
        'rounded bg-white/25 px-1 font-mono text-[10px] font-semibold normal-case tracking-normal text-white',
        'rounded bg-sky-200/80 px-1 font-mono text-[10px] font-semibold normal-case tracking-normal text-sky-900 dark:bg-sky-500/20 dark:text-sky-100',
      );

      root.querySelectorAll('[data-ak-kit-panel]').forEach((panel) => {
        panel.querySelectorAll('[data-ak-skill-card]').forEach((card) => {
          const match = !attr || card.getAttribute(attr) === 'true';
          card.classList.toggle('hidden', Boolean(filtering && !match));
        });
        panel.querySelectorAll('[data-ak-skill-group]').forEach((group) => {
          const visible = [...group.querySelectorAll('[data-ak-skill-card]')].some((c) => !c.classList.contains('hidden'));
          group.classList.toggle('hidden', Boolean(filtering && !visible));
          const count = group.querySelector('[data-ak-group-count]');
          if (count) {
            count.textContent = filtering && attr
              ? String(group.querySelectorAll(`[data-ak-skill-card][${attr}="true"]`).length)
              : (count.getAttribute('data-total') || '0');
          }
        });
        panel.querySelectorAll('[data-ak-beta-preview]').forEach((el) => {
          el.classList.toggle('hidden', filtering);
        });
        const newEmpty = panel.querySelector('[data-ak-new-empty]');
        if (newEmpty) {
          const any = panel.querySelectorAll('[data-ak-skill-card][data-new="true"]').length > 0;
          newEmpty.classList.toggle('hidden', !newOn || any);
        }
        const commonEmpty = panel.querySelector('[data-ak-common-empty]');
        if (commonEmpty) {
          const any = panel.querySelectorAll('[data-ak-skill-card][data-common="true"]').length > 0;
          commonEmpty.classList.toggle('hidden', !commonOn || any);
        }
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-ak-kit-tab');
        tabs.forEach((t) => {
          const selected = t === tab;
          t.setAttribute('aria-selected', selected ? 'true' : 'false');
          const kit = t.getAttribute('data-ak-kit-tab');
          if (selected && kit === 'engineer') {
            t.className = 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-teal-600 text-white shadow-md shadow-teal-500/20';
          } else if (selected && kit === 'marketing') {
            t.className = 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-fuchsia-600 text-white shadow-md shadow-fuchsia-500/20';
          } else {
            t.className = 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300';
          }
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-ak-kit-panel') !== id);
        });
        applySkillFilters();
      });
    });

    newBtn?.addEventListener('click', () => {
      const next = newBtn.getAttribute('aria-pressed') !== 'true';
      newBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
      if (next) commonBtn?.setAttribute('aria-pressed', 'false');
      applySkillFilters();
    });
    commonBtn?.addEventListener('click', () => {
      const next = commonBtn.getAttribute('aria-pressed') !== 'true';
      commonBtn.setAttribute('aria-pressed', next ? 'true' : 'false');
      if (next) newBtn?.setAttribute('aria-pressed', 'false');
      applySkillFilters();
    });

    root.querySelectorAll<HTMLButtonElement>('.ak-copy-btn:not([data-bound])').forEach((btn) => {
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('ring-2', 'ring-teal-400/50');
          window.setTimeout(() => btn.classList.remove('ring-2', 'ring-teal-400/50'), 800);
        } catch (e) {
          console.error(e);
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', bindAkSkillsUi);
  document.addEventListener('astro:page-load', bindAkSkillsUi);
</script>
