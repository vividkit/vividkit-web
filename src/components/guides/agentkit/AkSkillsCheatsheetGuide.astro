function groupLabel(key: string) {
  const row = groupLabels[key];
  if (!row) return { title: key, desc: '' };
  return {
    title: isVi ? row.vi : row.en,
    desc: isVi ? row.descVi : row.descEn,
  };
}

function skillDesc(s: AkSkillEntry | AkBetaPreviewItem) {
  if (isVi && s.descriptionVi) return s.descriptionVi;
  return s.description;
}

function groupSkills(skills: AkSkillEntry[], order: AkGroupMeta[]) {
  const map = new Map<string, AkSkillEntry[]>();
  for (const s of skills) {
    const list = map.get(s.category) || [];
    list.push(s);
    map.set(s.category, list);
  }
  for (const list of map.values()) {
    list.sort((a, b) => {
      const sa = a.step ?? 999;
      const sb = b.step ?? 999;
      if (sa !== sb) return sa - sb;
      const oa = a.order ?? 999;
      const ob = b.order ?? 999;
      if (oa !== ob) return oa - ob;
      return a.command.localeCompare(b.command);
    });
  }
  return order
    .filter((g) => map.has(g.key) && (map.get(g.key)?.length || 0) > 0)
    .map((g) => ({
      meta: g,
      skills: map.get(g.key) || [],
      label: groupLabel(g.key),
      styles: colorStyles[g.color] || colorStyles.gray,
      icon: groupIcons[g.icon] || groupIcons.utils,
    }));
}

const engGroups = groupSkills(akEngineerSkills, akEngineerGroupOrder);
const mktGroups = groupSkills(akMarketingSkills, akMarketingGroupOrder);
const engNewCount = akEngineerSkills.filter((s) => s.isNew).length;
const mktNewCount = akMarketingSkills.filter((s) => s.isNew).length;
const engCommonCount = akEngineerSkills.filter((s) => s.isCommon).length;
const mktCommonCount = akMarketingSkills.filter((s) => s.isCommon).length;


