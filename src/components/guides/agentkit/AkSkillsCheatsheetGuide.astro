---
import { getLangFromUrl, type Language } from '@/i18n';
import {
  akEngineerSkills,
  akMarketingSkills,
  akEngineerSkillCount,
  akMarketingSkillCount,
  type AkSkillEntry,
} from '@/data/guides/agentkit-skills-cheatsheet';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

const categoryLabels: Record<string, { en: string; vi: string }> = {
  utilities: { en: 'Utilities', vi: 'Tiện ích' },
  'dev-tools': { en: 'Dev tools', vi: 'Công cụ dev' },
  frontend: { en: 'Frontend', vi: 'Frontend' },
  backend: { en: 'Backend', vi: 'Backend' },
  database: { en: 'Database', vi: 'Database' },
  security: { en: 'Security', vi: 'Bảo mật' },
  infrastructure: { en: 'Infrastructure', vi: 'Hạ tầng' },
  'ai-ml': { en: 'AI / ML', vi: 'AI / ML' },
  frameworks: { en: 'Frameworks', vi: 'Frameworks' },
  multimedia: { en: 'Multimedia', vi: 'Multimedia' },
  marketing: { en: 'Marketing', vi: 'Marketing' },
  other: { en: 'Other', vi: 'Khác' },
};

function catLabel(cat: string) {
  const row = categoryLabels[cat];
  if (!row) return cat;
  return isVi ? row.vi : row.en;
}

function skillDesc(s: AkSkillEntry) {
  if (isVi && s.descriptionVi) return s.descriptionVi;
  return s.description;
}

function groupByCategory(skills: AkSkillEntry[]) {
  const map = new Map<string, AkSkillEntry[]>();
  for (const s of skills) {
    const list = map.get(s.category) || [];
    list.push(s);
    map.set(s.category, list);
  }
  const preferred = [
    'utilities',
    'dev-tools',
    'frontend',
    'backend',
    'database',
    'infrastructure',
    'security',
    'ai-ml',
    'frameworks',
    'multimedia',
    'marketing',
    'other',
  ];
  const keys = [
    ...preferred.filter((k) => map.has(k)),
    ...[...map.keys()].filter((k) => !preferred.includes(k)).sort(),
  ];
  return keys.map((k) => ({ cat: k, skills: map.get(k) || [] }));
}

const engGroups = groupByCategory(akEngineerSkills);
const mktGroups = groupByCategory(akMarketingSkills);

const legend = isVi
  ? [
      { sample: 'archive', label: 'Subcommand', desc: 'Nhánh skill: /ak:plan archive', tone: 'purple' },
      { sample: '[task]', label: 'Argument', desc: 'Tham số vị trí / placeholder', tone: 'slate' },
      { sample: '--fast', label: 'Flag', desc: 'Tùy chọn dạng --flag', tone: 'teal' },
      { sample: 'hint', label: 'argument-hint', desc: 'Cú pháp đầy đủ từ SKILL.md', tone: 'amber' },
    ]
  : [
      { sample: 'archive', label: 'Subcommand', desc: 'Skill branch: /ak:plan archive', tone: 'purple' },
      { sample: '[task]', label: 'Argument', desc: 'Positional / placeholder args', tone: 'slate' },
      { sample: '--fast', label: 'Flag', desc: 'Dash options like --flag', tone: 'teal' },
      { sample: 'hint', label: 'argument-hint', desc: 'Full syntax from SKILL.md', tone: 'amber' },
    ];

const chipTone: Record<string, string> = {
  purple: 'bg-purple-100 text-purple-700 border-purple-200 dark:bg-purple-900/30 dark:text-purple-300 dark:border-purple-800',
  slate: 'bg-slate-200 text-slate-700 border-slate-300 dark:bg-slate-700 dark:text-slate-300 dark:border-slate-600',
  teal: 'bg-teal-100 text-teal-700 border-teal-200 dark:bg-teal-900/30 dark:text-teal-300 dark:border-teal-800',
  amber: 'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:border-amber-800',
};
---

<div class="space-y-8 mt-6" data-ak-skills-root>
  <section class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-stone-50 shadow-sm dark:border-white/10 dark:bg-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_15%,rgba(20,184,166,0.14),transparent_30%),radial-gradient(circle_at_85%_10%,rgba(168,85,247,0.12),transparent_28%)]"></div>
    <div class="relative space-y-6 p-6 sm:p-8 lg:p-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-violet-200 bg-white/70 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.24em] text-violet-700 shadow-sm dark:border-violet-400/20 dark:bg-white/5 dark:text-violet-300">
        <span class="h-2 w-2 rounded-full bg-violet-500"></span>
        {isVi ? 'Bảng skill' : 'Skills cheatsheet'}
      </div>
      <div class="max-w-3xl space-y-3">
        <h1 class="font-heading text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl dark:text-white">
          {isVi ? 'AgentKit Skills — Engineer & Marketing' : 'AgentKit Skills — Engineer & Marketing'}
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-300">
          {isVi
            ? 'Catalog skill theo kit, kèm subcommand / argument / flag. Claude Code & Cursor: /ak:<skill> · Codex: $ak:<skill>.'
            : 'Skill catalog by kit with subcommands, args, and flags. Claude Code & Cursor: /ak:<skill> · Codex: $ak:<skill>.'}
        </p>
        <p class="text-sm text-slate-500 dark:text-slate-400">
          {isVi
            ? 'Engineer = core + skill engineer. Marketing có skill domain riêng. Không giả định 1:1 với /ck:*. Metadata lấy từ argument-hint và SKILL.md của kit.'
            : 'Engineer = core + engineer skills. Marketing owns domain skills. Do not assume 1:1 with /ck:*. Metadata from kit argument-hint and SKILL.md.'}
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-teal-200/80 bg-teal-50/80 p-4 dark:border-teal-500/20 dark:bg-teal-950/30">
          <div class="font-mono text-3xl font-bold text-teal-800 dark:text-teal-200">{akEngineerSkillCount}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-teal-700/80 dark:text-teal-300/80">Engineer</div>
        </div>
        <div class="rounded-2xl border border-fuchsia-200/80 bg-fuchsia-50/80 p-4 dark:border-fuchsia-500/20 dark:bg-fuchsia-950/30">
          <div class="font-mono text-3xl font-bold text-fuchsia-800 dark:text-fuchsia-200">{akMarketingSkillCount}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-fuchsia-700/80 dark:text-fuchsia-300/80">Marketing</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/80 p-4 dark:border-white/10 dark:bg-white/[0.04]">
          <div class="font-mono text-2xl font-bold text-slate-900 dark:text-white">/ak: · $ak:</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">{isVi ? 'Cú pháp' : 'Syntax'}</div>
        </div>
      </div>

      <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-white/10 dark:bg-white/[0.04]">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-500">{isVi ? 'Chú thích chip' : 'Chip legend'}</div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {legend.map((item) => (
            <div class="flex items-start gap-2 rounded-xl border border-slate-100 bg-slate-50/80 px-3 py-2 dark:border-white/5 dark:bg-slate-900/40">
              <code class={`mt-0.5 shrink-0 rounded border px-1.5 py-0.5 font-mono text-[10px] ${chipTone[item.tone]}`}>{item.sample}</code>
              <div>
                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">{item.label}</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">{item.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex flex-wrap gap-2" role="tablist" aria-label="Kit">
        <button type="button" data-ak-kit-tab="engineer" class="ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-teal-600 text-white shadow-md shadow-teal-500/20" aria-selected="true">
          Engineer Kit
        </button>
        <button type="button" data-ak-kit-tab="marketing" class="ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300" aria-selected="false">
          Marketing Kit
        </button>
      </div>
    </div>
  </section>

  {/* Engineer panel */}
  <div data-ak-kit-panel="engineer" class="space-y-5">
    {engGroups.map(({ cat, skills }) => (
      <section class="scroll-mt-32 overflow-hidden rounded-[1.65rem] border border-teal-200/70 bg-gradient-to-br from-teal-50/50 to-white shadow-sm dark:border-teal-500/20 dark:from-teal-950/20 dark:to-slate-950">
        <div class="flex items-center justify-between border-b border-teal-200/50 px-5 py-4 dark:border-teal-500/15">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">{catLabel(cat)}</h2>
          <span class="font-mono text-sm text-teal-700 dark:text-teal-300">{skills.length}</span>
        </div>
        <div class="grid gap-3 p-4 sm:grid-cols-2 xl:grid-cols-3 sm:p-5">
          {skills.map((s) => (
            <article class="group flex flex-col rounded-2xl border border-slate-200/80 bg-white/90 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-teal-300 dark:border-white/10 dark:bg-slate-950/60 dark:hover:border-teal-500/30">
              <div class="flex items-start justify-between gap-2">
                <code class="rounded-lg bg-teal-100 px-2 py-1 font-mono text-xs font-bold text-teal-800 dark:bg-teal-500/15 dark:text-teal-200">{s.command}</code>
                <button type="button" class="ak-copy-btn shrink-0 rounded-lg border border-slate-200 p-1.5 text-slate-400 hover:border-teal-300 hover:text-teal-600 dark:border-white/10 dark:hover:border-teal-400/30" data-code={s.command} title="Copy" aria-label={`Copy ${s.command}`}>
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </div>
              <p class="mt-1 font-mono text-[10px] text-slate-400">{s.commandCodex}</p>
              {s.argumentHint && (
                <p class="mt-1.5 font-mono text-[10px] leading-4 text-amber-700/90 dark:text-amber-300/90 break-all">
                  <span class="opacity-60">{s.command}</span>{' '}{s.argumentHint}
                </p>
              )}
              <p class="mt-2 flex-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{skillDesc(s)}</p>
              {(s.subcommands?.length || s.args?.length || s.flags?.length) ? (
                <div class="mt-2 space-y-1.5 border-t border-slate-100 pt-2 dark:border-slate-800/60">
                  {s.subcommands && s.subcommands.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.subcommands.map((sub) => (
                        <code class="rounded border border-purple-200 bg-purple-100 px-1 py-0.5 font-mono text-[9px] text-purple-700 dark:border-purple-800 dark:bg-purple-900/30 dark:text-purple-300">{sub}</code>
                      ))}
                    </div>
                  )}
                  {s.args && s.args.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.args.map((arg) => (
                        <code class="rounded border border-slate-300 bg-slate-200 px-1 py-0.5 font-mono text-[9px] text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">{arg}</code>
                      ))}
                    </div>
                  )}
                  {s.flags && s.flags.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.flags.map((flag) => (
                        <code class="rounded border border-teal-200 bg-teal-100 px-1 py-0.5 font-mono text-[9px] text-teal-700 dark:border-teal-800 dark:bg-teal-900/30 dark:text-teal-300">{flag}</code>
                      ))}
                    </div>
                  )}
                </div>
              ) : null}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  {/* Marketing panel */}
  <div data-ak-kit-panel="marketing" class="hidden space-y-5">
    {mktGroups.map(({ cat, skills }) => (
      <section class="scroll-mt-32 overflow-hidden rounded-[1.65rem] border border-fuchsia-200/70 bg-gradient-to-br from-fuchsia-50/50 to-white shadow-sm dark:border-fuchsia-500/20 dark:from-fuchsia-950/20 dark:to-slate-950">
        <div class="flex items-center justify-between border-b border-fuchsia-200/50 px-5 py-4 dark:border-fuchsia-500/15">
          <h2 class="text-lg font-bold text-slate-900 dark:text-white">{catLabel(cat)}</h2>
          <span class="font-mono text-sm text-fuchsia-700 dark:text-fuchsia-300">{skills.length}</span>
        </div>
        <div class="grid gap-3 p-4 sm:grid-cols-2 xl:grid-cols-3 sm:p-5">
          {skills.map((s) => (
            <article class="group flex flex-col rounded-2xl border border-slate-200/80 bg-white/90 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-fuchsia-300 dark:border-white/10 dark:bg-slate-950/60 dark:hover:border-fuchsia-500/30">
              <div class="flex items-start justify-between gap-2">
                <code class="rounded-lg bg-fuchsia-100 px-2 py-1 font-mono text-xs font-bold text-fuchsia-800 dark:bg-fuchsia-500/15 dark:text-fuchsia-200">{s.command}</code>
                <button type="button" class="ak-copy-btn shrink-0 rounded-lg border border-slate-200 p-1.5 text-slate-400 hover:border-fuchsia-300 hover:text-fuchsia-600 dark:border-white/10 dark:hover:border-fuchsia-400/30" data-code={s.command} title="Copy" aria-label={`Copy ${s.command}`}>
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                </button>
              </div>
              <p class="mt-1 font-mono text-[10px] text-slate-400">{s.commandCodex}</p>
              {s.argumentHint && (
                <p class="mt-1.5 font-mono text-[10px] leading-4 text-amber-700/90 dark:text-amber-300/90 break-all">
                  <span class="opacity-60">{s.command}</span>{' '}{s.argumentHint}
                </p>
              )}
              <p class="mt-2 flex-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{skillDesc(s)}</p>
              {(s.subcommands?.length || s.args?.length || s.flags?.length) ? (
                <div class="mt-2 space-y-1.5 border-t border-slate-100 pt-2 dark:border-slate-800/60">
                  {s.subcommands && s.subcommands.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.subcommands.map((sub) => (
                        <code class="rounded border border-purple-200 bg-purple-100 px-1 py-0.5 font-mono text-[9px] text-purple-700 dark:border-purple-800 dark:bg-purple-900/30 dark:text-purple-300">{sub}</code>
                      ))}
                    </div>
                  )}
                  {s.args && s.args.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.args.map((arg) => (
                        <code class="rounded border border-slate-300 bg-slate-200 px-1 py-0.5 font-mono text-[9px] text-slate-700 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">{arg}</code>
                      ))}
                    </div>
                  )}
                  {s.flags && s.flags.length > 0 && (
                    <div class="flex flex-wrap gap-1">
                      {s.flags.map((flag) => (
                        <code class="rounded border border-teal-200 bg-teal-100 px-1 py-0.5 font-mono text-[9px] text-teal-700 dark:border-teal-800 dark:bg-teal-900/30 dark:text-teal-300">{flag}</code>
                      ))}
                    </div>
                  )}
                </div>
              ) : null}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>

<script>
  function bindAkSkillsUi() {
    const root = document.querySelector('[data-ak-skills-root]');
    if (!root || root.getAttribute('data-bound')) return;
    root.setAttribute('data-bound', '1');

    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-ak-kit-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-ak-kit-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-ak-kit-tab');
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.className = on
            ? 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-teal-600 text-white shadow-md shadow-teal-500/20'
            : 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300';
          if (t.getAttribute('data-ak-kit-tab') === 'marketing' && on) {
            t.className = 'ak-kit-tab rounded-full px-4 py-2 text-sm font-semibold transition bg-fuchsia-600 text-white shadow-md shadow-fuchsia-500/20';
          }
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-ak-kit-panel') !== id);
        });
      });
    });

    root.querySelectorAll<HTMLButtonElement>('.ak-copy-btn:not([data-bound])').forEach((btn) => {
      btn.dataset.bound = '1';
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          btn.classList.add('ring-2', 'ring-teal-400/50');
          window.setTimeout(() => btn.classList.remove('ring-2', 'ring-teal-400/50'), 800);
        } catch (e) {
          console.error(e);
        }
      });
    });
  }
  document.addEventListener('DOMContentLoaded', bindAkSkillsUi);
  document.addEventListener('astro:page-load', bindAkSkillsUi);
</script>
