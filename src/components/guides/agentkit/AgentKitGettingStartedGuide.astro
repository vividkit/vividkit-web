---
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkStepRail from './AkStepRail.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);

const overview = isVi
  ? [
      { title: 'Cài ak CLI', body: 'Installer đã ký — macOS/Linux hoặc Windows PowerShell.' },
      { title: 'Xác nhận', body: 'ak --version và ak doctor để chắc cài đặt sạch.' },
      { title: 'Đăng nhập & cài Kit', body: 'ak login (email + OTP, API key, hoặc license key), rồi cài Kit cho runtime.' },
      { title: 'Gọi Skill trong runtime', body: 'Cài Kit không chạy workflow — mở coding assistant.' },
    ]
  : [
      { title: 'Install ak CLI', body: 'Signed installer — macOS/Linux or Windows PowerShell.' },
      { title: 'Verify', body: 'ak --version and ak doctor to confirm a clean install.' },
      { title: 'Log in & install a Kit', body: 'ak login (email + OTP, API key, or license key), then install a Kit for your runtime.' },
      { title: 'Invoke a Skill in the runtime', body: 'Installing a Kit does not run a workflow — open the assistant.' },
    ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="teal"
    kicker={isVi ? 'Onboarding' : 'Onboarding'}
    title={isVi ? 'Cài Đặt và Onboarding' : 'Installation and Onboarding'}
    subtitle={isVi
      ? 'Từ zero đến Skill đầu tiên: cài CLI, verify, cài Kit, gọi trong runtime.'
      : 'From zero to a first Skill: install the CLI, verify, install a Kit, invoke in your runtime.'}
    badges={isVi ? ['Khuyến nghị'] : ['Recommended']}
  />

  <AkSection eyebrow={isVi ? 'Tổng quan' : 'Overview'} title={isVi ? 'Bốn bước' : 'Four steps'}>
    <AkStepRail steps={overview} accent="teal" />
  </AkSection>

  <AkSection
    eyebrow="01"
    title={isVi ? 'Cài AgentKit CLI' : 'Install the AgentKit CLI'}
    desc={isVi
      ? 'Chọn platform của bạn, chạy một lệnh, rồi mở terminal mới.'
      : 'Pick your platform, run one command, then open a new terminal.'}
  >
    <div class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-2 lg:items-stretch">
        {/* macOS / Linux */}
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-teal-200/70 bg-gradient-to-br from-teal-50/70 via-white to-white p-4 sm:p-5 dark:border-teal-500/25 dark:from-teal-950/40 dark:via-slate-900/80 dark:to-slate-900/60">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-teal-600 dark:text-teal-400">
                Unix
              </p>
              <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
                macOS / Linux
              </h3>
            </div>
            <span class="shrink-0 rounded-full bg-teal-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-teal-700 dark:bg-teal-500/20 dark:text-teal-300">
              install.sh
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-3">
            <AkCodeBlock title="install.sh" code={`curl -fsSL https://agentkit.best/install.sh | sh`} />
            <details class="group rounded-xl border border-slate-200/80 bg-white/70 open:bg-white dark:border-slate-700/80 dark:bg-slate-950/40 dark:open:bg-slate-950/70">
              <summary class="cursor-pointer list-none px-3.5 py-2.5 text-xs font-medium text-slate-600 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-400">
                <span class="inline-flex items-center gap-2">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 transition group-open:rotate-90 dark:bg-slate-800 dark:text-slate-400">
                    ›
                  </span>
                  {isVi ? 'Fallback nếu host chính lỗi' : 'Fallback if the primary host fails'}
                </span>
              </summary>
              <div class="space-y-2 border-t border-slate-200/70 px-3 pb-3 pt-2 dark:border-slate-700/70">
                <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
                  {isVi
                    ? 'Dùng release host khi agentkit.best không truy cập được.'
                    : 'Use the release host when agentkit.best is unreachable.'}
                </p>
                <AkCodeBlock title="releases host" code={`curl -fsSL https://releases.agentkit.best/install.sh | sh`} />
              </div>
            </details>
          </div>
        </article>

        {/* Windows */}
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-violet-200/70 bg-gradient-to-br from-violet-50/70 via-white to-white p-4 sm:p-5 dark:border-violet-500/25 dark:from-violet-950/35 dark:via-slate-900/80 dark:to-slate-900/60">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-violet-600 dark:text-violet-400">
                Windows
              </p>
              <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
                PowerShell
              </h3>
            </div>
            <span class="shrink-0 rounded-full bg-violet-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-violet-700 dark:bg-violet-500/20 dark:text-violet-300">
              install.ps1
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-3">
            <AkCodeBlock title="install.ps1" code={`irm https://agentkit.best/install.ps1 | iex`} />
            <p class="mt-auto rounded-xl border border-violet-200/50 bg-violet-50/60 px-3.5 py-2.5 text-xs leading-relaxed text-slate-600 dark:border-violet-500/20 dark:bg-violet-950/20 dark:text-slate-400">
              {isVi
                ? 'Chạy trong PowerShell (không phải CMD). Sau khi cài, mở cửa sổ terminal mới.'
                : 'Run in PowerShell (not CMD). After install, open a new terminal window.'}
            </p>
          </div>
        </article>
      </div>

      <AkCallout variant="info" title={isVi ? 'PATH mặc định' : 'Default PATH'}>
        {isVi ? (
          <>
            Binary vào <AkInlineCode text="~/.local/bin" /> (Unix) hoặc <AkInlineCode text="%USERPROFILE%\bin" /> (Windows).
            Mở terminal mới sau khi cài để nhận PATH.
          </>
        ) : (
          <>
            Binary lands in <AkInlineCode text="~/.local/bin" /> (Unix) or <AkInlineCode text="%USERPROFILE%\bin" /> (Windows).
            Open a new terminal after install so PATH picks it up.
          </>
        )}
      </AkCallout>
    </div>
  </AkSection>

  <AkSection eyebrow="02" title={isVi ? 'Xác nhận' : 'Verify'}>
    <AkCodeBlock title="shell" code={`ak --version\nak doctor --json`} />
  </AkSection>

  <AkSection
    eyebrow="03"
    title={isVi ? 'Đăng nhập (ak login) rồi cài Kit' : 'Log in (ak login), then install a Kit'}
    desc={isVi
      ? 'Trước khi cài Kit remote có license, đăng nhập registry bằng một trong các cách sau. Khuyến nghị cho hầu hết người dùng: email + OTP.'
      : 'Before installing licensed remote Kits, authenticate to the registry with one of the methods below. Recommended for most users: email + OTP.'}
  >
    <div class="space-y-5">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'Email + OTP (khuyến nghị)' : 'Email + OTP (recommended)'}
          </h3>
          <span class="rounded-full bg-teal-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-teal-800 dark:bg-teal-500/15 dark:text-teal-300">
            {isVi ? 'Phổ biến' : 'Common'}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'Gửi mã một lần (OTP) tới email của bạn. CLI hỏi Enter OTP code — nhập mã từ hộp thư. Mã OTP không được lưu trên máy; session CLI lưu credential refresh (không phải mã OTP).'
            : 'Sends a one-time password (OTP) to your email. The CLI prompts Enter OTP code — type the code from your inbox. The OTP is not stored on disk; the CLI session keeps a rotating refresh credential (not the OTP itself).'}
        </p>
        <AkCodeBlock title="shell" code={`ak login --email you@example.com\n# Prompt: Enter OTP code:\nak whoami`} />
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="space-y-3 rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'API key (script / CI)' : 'API key (scripts / CI)'}
          </h3>
          <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {isVi
              ? 'Key từ web profile. Phù hợp môi trường không tương tác. Key được lưu trong session private.'
              : 'Key from your web profile. Suited to non-interactive hosts. The private API key is stored in the session.'}
          </p>
          <AkCodeBlock title="shell" code={`ak login --api-key ak_live_... --no-interactive`} />
        </div>
        <div class="space-y-3 rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'License key (App / device)' : 'License key (App / device)'}
          </h3>
          <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {isVi
              ? 'Kích hoạt thiết bị cho App session (khác slot CLI email/API). Chủ yếu dùng cho Desktop — không tự cấp Kit Engineer / Marketing.'
              : 'Activates a device for an App session (separate from the CLI email/API slot). Mainly for Desktop — does not grant Engineer / Marketing Kits by itself.'}
          </p>
          <AkCodeBlock title="shell" code={`ak login --license-key ak_license_... --no-interactive`} />
        </div>
      </div>

      <AkCallout variant="warn" title={isVi ? 'Kit license ≠ Desktop license' : 'Kit license ≠ Desktop license'}>
        {isVi ? (
          <>
            Có hai entitlement riêng: Kit mở Engineer / Marketing; Desktop mở app và quản lý device. Mua một bên không mặc định có bên kia — trừ bundle ghi rõ “Desktop + Kits”. Chi tiết:{' '}
            <a
              class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
              href={translatePath('/guides/agentkit/desktop-app')}
            >
              trang Desktop App
            </a>
            . Kiểm tra Kit đã cấp bằng <AkInlineCode text="ak licenses" />.
          </>
        ) : (
          <>
            Two separate entitlements: Kit unlocks Engineer / Marketing; Desktop unlocks the app and device management. Buying one does not include the other by default — unless a bundle explicitly says “Desktop + Kits”. Details on the{' '}
            <a
              class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
              href={translatePath('/guides/agentkit/desktop-app')}
            >
              Desktop App page
            </a>
            . Check licensed Kits with <AkInlineCode text="ak licenses" />.
          </>
        )}
      </AkCallout>

      <AkCallout variant="info" title={isVi ? 'Kiểm tra & đăng xuất' : 'Check status & sign out'}>
        <span class="inline-flex flex-wrap items-center gap-x-1 gap-y-1">
          <AkInlineCode text="ak whoami" />
          {isVi ? ' xác nhận account và kit được license. ' : ' confirms the account and licensed kits. '}
          <AkInlineCode text="ak licenses" />
          {isVi ? ' liệt kê Kit được cấp. ' : ' lists licensed Kits. '}
          <AkInlineCode text="ak logout" />
          {isVi
            ? ' xóa credential CLI local (giữ App device session nếu có).'
            : ' clears the local CLI credential (preserves any App device session).'}
        </span>
      </AkCallout>

      <div class="rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-white p-5 dark:border-slate-700 dark:from-slate-900 dark:to-slate-950">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
          {isVi ? 'Sau khi đăng nhập: cài Kit' : 'After login: install a Kit'}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'Cài Kit cho runtime bạn dùng. Project scope là mặc định; thêm '
            : 'Install a Kit for the runtime you use. Project scope is the default; add '}
          <AkInlineCode text="--global" />
          {isVi
            ? ' khi cần phạm vi user. Cài Kit không chạy workflow — restart coding assistant hoặc mở session mới, rồi gọi Skill (ví dụ /ak:plan hoặc $ak:plan).'
            : ' for user-wide availability. Installing a Kit does not run a workflow — restart the coding assistant or open a new session, then invoke a Skill (for example /ak:plan or $ak:plan).'}
        </p>
      </div>
    </div>
  </AkSection>

  <AkSection eyebrow="04" title={isVi ? 'Tuỳ chọn: Desktop App' : 'Optional: Desktop App'}>
    <div class="flex flex-col gap-4 rounded-2xl border border-teal-200/70 bg-gradient-to-br from-teal-50/80 to-white p-5 sm:flex-row sm:items-center sm:justify-between dark:border-teal-500/25 dark:from-teal-950/30 dark:to-slate-900">
      <p class="text-sm text-slate-600 dark:text-slate-300">
        {isVi
          ? 'Desktop là gói riêng — tải, verify checksum, kích hoạt App license. Xem trang Desktop để biết platform.'
          : 'Desktop is a separate package — download, verify checksums, activate an App license. See the Desktop page for platforms.'}
      </p>
      <a
        href={translatePath('/guides/agentkit/desktop-app')}
        class="inline-flex shrink-0 items-center justify-center rounded-xl bg-gradient-to-r from-teal-500 to-cyan-600 px-4 py-2.5 text-sm font-semibold text-white shadow-md shadow-teal-500/25 transition hover:from-teal-600 hover:to-cyan-700"
      >
        {isVi ? 'Desktop App →' : 'Desktop App →'}
      </a>
    </div>
  </AkSection>

  <AkCallout variant="info" title={isVi ? 'Đang dùng ClaudeKit?' : 'Already on ClaudeKit?'}>
    {isVi
      ? 'Không bắt buộc migrate. Khi sẵn sàng, dùng hướng dẫn chuyển đổi (sao lưu trước).'
      : 'Migration is optional. When ready, use the migration guide (back up first).'}
    {' '}
    <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/migrate-claudekit-to-agentkit')}>
      {isVi ? 'Migrate →' : 'Migrate →'}
    </a>
  </AkCallout>

  <AkCallout variant="tip" title={isVi ? 'Cần gỡ sạch rồi cài lại stable?' : 'Need a clean reinstall of stable?'}>
    {isVi ? (
      <>
        Đừng xóa <AkInlineCode text="~/.codex" /> / <AkInlineCode text="~/.claude" /> hay bắt đầu bằng xóa{' '}
        <AkInlineCode text="~/.agentkit" />. Dùng quy trình ownership-aware trên trang{' '}
        <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/agentkit/clean-reinstall')}>
          Cài lại clean AgentKit
        </a>
        .
      </>
    ) : (
      <>
        Do not delete <AkInlineCode text="~/.codex" /> / <AkInlineCode text="~/.claude" /> or start by wiping{' '}
        <AkInlineCode text="~/.agentkit" />. Use the ownership-aware flow on{' '}
        <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/agentkit/clean-reinstall')}>
          Clean reinstall of AgentKit
        </a>
        .
      </>
    )}
  </AkCallout>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Tiếp theo' : 'Next'}
    links={[
      { href: '/guides/agentkit/configuration', label: isVi ? 'config.yaml' : 'config.yaml' },
      { href: '/guides/agentkit/runtime-support', label: isVi ? 'Runtime support' : 'Runtime support' },
      { href: '/guides/agentkit/updating', label: isVi ? 'Cập nhật' : 'Updating' },
      { href: '/guides/agentkit/clean-reinstall', label: isVi ? 'Cài lại clean' : 'Clean reinstall' },
      { href: '/guides/agentkit/troubleshooting', label: isVi ? 'Sự cố' : 'Troubleshooting' },
    ]}
  />
</div>
