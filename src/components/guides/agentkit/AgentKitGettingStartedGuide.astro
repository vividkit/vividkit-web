---
// Do not pin exact CLI versions in reader copy (AGENTS.md). Live check: ak --version.
// Maintainer refs (ak-cli local): origin/main v2.17.0 (c3cf1de), origin/dev v2.18.0-beta.3 (4936a2f).
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkStepRail from './AkStepRail.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);

const overview = isVi
    ? [
        { title: 'Cài CLI ak', body: 'Installer đã ký — macOS/Linux hoặc Windows PowerShell.' },
        { title: 'Xác nhận', body: 'ak --version và ak doctor để chắc cài đặt sạch.' },
        { title: 'Cấu hình lần đầu', body: 'ak setup ghi preference (adapter, kit mặc định, telemetry). Không đăng nhập, không cài Kit.' },
        { title: 'Đăng nhập & cài Kit', body: 'ak login (API key khuyến nghị; hoặc email + OTP), rồi cài Kit cho runtime.' },
        { title: 'Gọi Skill trong runtime', body: 'Cài Kit không chạy workflow — mở coding assistant.' },
      ]
    : [
        { title: 'Install the ak CLI', body: 'Signed installer — macOS/Linux or Windows PowerShell.' },
        { title: 'Verify', body: 'ak --version and ak doctor to confirm a clean install.' },
        { title: 'First-run setup', body: 'ak setup writes preferences (adapters, default kit, telemetry). Does not log in or install a Kit.' },
        { title: 'Log in & install a Kit', body: 'ak login (API key recommended; or email + OTP), then install a Kit for your runtime.' },
        { title: 'Invoke a Skill in the runtime', body: 'Installing a Kit does not run a workflow — open the assistant.' },
      ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="teal"
    kicker={isVi ? 'AgentKit · Onboarding' : 'AgentKit · Onboarding'}
    title={isVi ? 'Cài Đặt AgentKit' : 'AgentKit Installation'}
    subtitle={isVi
      ? 'Từ zero đến Skill đầu tiên với AgentKit: cài CLI ak, xác nhận, ak setup, đăng nhập, cài Kit, gọi trong runtime.'
      : 'From zero to a first Skill with AgentKit: install the ak CLI, verify, run ak setup, sign in, install a Kit, invoke in your runtime.'}
    badges={isVi ? ['Khuyến nghị'] : ['Recommended']}
  />

  <AkSection eyebrow={isVi ? 'Tổng quan' : 'Overview'} title={isVi ? 'Năm bước' : 'Five steps'}>
    <AkStepRail steps={overview} accent="teal" />
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
      {isVi ? (
        <>
          Trên CLI ak, <AkInlineCode text="ak onboard" /> chỉ chạy bước còn thiếu (setup, login, cài Kit).{' '}
          <AkInlineCode text="--yes" /> chỉ đồng ý prompt — không ghi đè file hay takeover.
        </>
      ) : (
        <>
          <AkInlineCode text="ak onboard" /> runs only missing steps (setup, login, Kit install).{' '}
          <AkInlineCode text="--yes" /> accepts prompts — it does not force-overwrite or take over ownership.
        </>
      )}
    </p>
  </AkSection>

  <AkSection
    eyebrow="01"
    title={isVi ? 'Cài AgentKit CLI' : 'Install the AgentKit CLI'}
    desc={isVi
      ? 'Chọn platform của bạn, chạy một lệnh, rồi mở terminal mới.'
      : 'Pick your platform, run one command, then open a new terminal.'}
  >
    <div class="space-y-4">
      <div class="grid gap-4 lg:grid-cols-2 lg:items-stretch">
        {/* macOS / Linux */}
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-teal-200/70 bg-gradient-to-br from-teal-50/70 via-white to-white p-4 sm:p-5 dark:border-teal-500/25 dark:from-teal-950/40 dark:via-slate-900/80 dark:to-slate-900/60">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-teal-600 dark:text-teal-400">
                Unix
              </p>
              <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
                macOS / Linux
              </h3>
            </div>
            <span class="shrink-0 rounded-full bg-teal-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-teal-700 dark:bg-teal-500/20 dark:text-teal-300">
              install.sh
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-3">
            <AkCodeBlock title="install.sh" code={`curl -fsSL https://agentkit.best/install.sh | sh`} />
            <details class="group rounded-xl border border-slate-200/80 bg-white/70 open:bg-white dark:border-slate-700/80 dark:bg-slate-950/40 dark:open:bg-slate-950/70">
              <summary class="cursor-pointer list-none px-3.5 py-2.5 text-xs font-medium text-slate-600 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-400">
                <span class="inline-flex items-center gap-2">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 transition group-open:rotate-90 dark:bg-slate-800 dark:text-slate-400">
                    ›
                  </span>
                  {isVi ? 'Kênh beta' : 'Beta channel'}
                </span>
              </summary>
              <div class="space-y-2 border-t border-slate-200/70 px-3 pb-3 pt-2 dark:border-slate-700/70">
                <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
                  {isVi
                    ? 'Cài CLI ak bản beta (opt-in).'
                    : 'Install the beta ak CLI (opt-in).'}
                </p>
                <AkCodeBlock title="beta" code={`curl -fsSL https://agentkit.best/install.sh | AK_CHANNEL=beta sh`} />
              </div>
            </details>
            <details class="group rounded-xl border border-slate-200/80 bg-white/70 open:bg-white dark:border-slate-700/80 dark:bg-slate-950/40 dark:open:bg-slate-950/70">
              <summary class="cursor-pointer list-none px-3.5 py-2.5 text-xs font-medium text-slate-600 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-400">
                <span class="inline-flex items-center gap-2">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 transition group-open:rotate-90 dark:bg-slate-800 dark:text-slate-400">
                    ›
                  </span>
                  {isVi ? 'Fallback nếu host chính lỗi' : 'Fallback if the primary host fails'}
                </span>
              </summary>
              <div class="space-y-2 border-t border-slate-200/70 px-3 pb-3 pt-2 dark:border-slate-700/70">
                <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
                  {isVi
                    ? 'Dùng release host khi agentkit.best không truy cập được.'
                    : 'Use the release host when agentkit.best is unreachable.'}
                </p>
                <AkCodeBlock title="releases host" code={`curl -fsSL https://releases.agentkit.best/install.sh | sh`} />
              </div>
            </details>
          </div>
        </article>

        {/* Windows */}
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-violet-200/70 bg-gradient-to-br from-violet-50/70 via-white to-white p-4 sm:p-5 dark:border-violet-500/25 dark:from-violet-950/35 dark:via-slate-900/80 dark:to-slate-900/60">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-violet-600 dark:text-violet-400">
                Windows
              </p>
              <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
                PowerShell
              </h3>
            </div>
            <span class="shrink-0 rounded-full bg-violet-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-violet-700 dark:bg-violet-500/20 dark:text-violet-300">
              install.ps1
            </span>
          </div>
          <div class="flex flex-1 flex-col gap-3">
            <AkCodeBlock title="install.ps1" code={`irm https://agentkit.best/install.ps1 | iex`} />
            <p class="rounded-xl border border-violet-200/50 bg-violet-50/60 px-3.5 py-2.5 text-xs leading-relaxed text-slate-600 dark:border-violet-500/20 dark:bg-violet-950/20 dark:text-slate-400">
              {isVi
                ? 'Chạy trong PowerShell (không phải CMD). Sau khi cài, mở cửa sổ terminal mới.'
                : 'Run in PowerShell (not CMD). After install, open a new terminal window.'}
            </p>
            <details class="group rounded-xl border border-slate-200/80 bg-white/70 open:bg-white dark:border-slate-700/80 dark:bg-slate-950/40 dark:open:bg-slate-950/70">
              <summary class="cursor-pointer list-none px-3.5 py-2.5 text-xs font-medium text-slate-600 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-400">
                <span class="inline-flex items-center gap-2">
                  <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 transition group-open:rotate-90 dark:bg-slate-800 dark:text-slate-400">
                    ›
                  </span>
                  {isVi ? 'Fallback nếu host chính lỗi' : 'Fallback if the primary host fails'}
                </span>
              </summary>
              <div class="space-y-2 border-t border-slate-200/70 px-3 pb-3 pt-2 dark:border-slate-700/70">
                <AkCodeBlock title="releases host" code={`irm https://releases.agentkit.best/install.ps1 | iex`} />
              </div>
            </details>
          </div>
        </article>
      </div>

      <AkCallout variant="info" title={isVi ? 'PATH mặc định' : 'Default PATH'}>
        {isVi ? (
          <>
            Binary vào <AkInlineCode text="~/.local/bin" /> (Unix) hoặc <AkInlineCode text="%USERPROFILE%\bin" /> (Windows).
            Mở terminal mới sau khi cài để nhận PATH.
          </>
        ) : (
          <>
            Binary lands in <AkInlineCode text="~/.local/bin" /> (Unix) or <AkInlineCode text="%USERPROFILE%\bin" /> (Windows).
            Open a new terminal after install so PATH picks it up.
          </>
        )}
      </AkCallout>
      <details class="group rounded-xl border border-slate-200/80 bg-white/70 open:bg-white dark:border-slate-700/80 dark:bg-slate-950/40 dark:open:bg-slate-950/70">
        <summary class="cursor-pointer list-none px-3.5 py-2.5 text-xs font-medium text-slate-600 marker:content-none [&::-webkit-details-marker]:hidden dark:text-slate-400">
          <span class="inline-flex items-center gap-2">
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 transition group-open:rotate-90 dark:bg-slate-800 dark:text-slate-400">
              ›
            </span>
            {isVi ? 'Ghim phiên bản hoặc thư mục cài' : 'Pin a version or install directory'}
          </span>
        </summary>
        <div class="space-y-2 border-t border-slate-200/70 px-3 pb-3 pt-2 dark:border-slate-700/70">
          <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">
            {isVi
              ? 'Để trống trừ khi cần kiểm soát. Thay x.y.z bằng phiên bản semantic. AK_INSTALL_DIR đổi thư mục đích. Giá trị phải trong dấu nháy — đừng dùng < > (shell hiểu là chuyển hướng).'
              : 'Leave unset unless you need that control. Replace x.y.z with a semantic version. AK_INSTALL_DIR changes the destination directory. Quote the value — do not use < > (the shell treats those as redirection).'}
          </p>
          <AkCodeBlock
            title="shell"
            code={isVi
              ? `curl -fsSL https://agentkit.best/install.sh | AK_VERSION='x.y.z' sh
# Đổi thư mục cài (tùy chọn)
# curl -fsSL https://agentkit.best/install.sh | AK_INSTALL_DIR="$HOME/bin" sh`
              : `curl -fsSL https://agentkit.best/install.sh | AK_VERSION='x.y.z' sh
# Optional install directory
# curl -fsSL https://agentkit.best/install.sh | AK_INSTALL_DIR="$HOME/bin" sh`}
          />
        </div>
      </details>
    </div>
  </AkSection>

  <AkSection eyebrow="02" title={isVi ? 'Xác nhận' : 'Verify'}>
    <AkCodeBlock title="shell" code={`ak --version\nak doctor --json`} />
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {isVi ? (
        <>
          Chạy <AkInlineCode text="ak --version" /> để xem CLI trên máy. Stable và beta là hai kênh riêng — trang này không gắn số phiên bản.
        </>
      ) : (
        <>
          Run <AkInlineCode text="ak --version" /> for the CLI on this machine. Stable and beta are separate channels — this page does not pin a version number.
        </>
      )}
    </p>
    <div class="mt-3 space-y-2">
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        {isVi ? 'Nâng CLI đã cài' : 'Upgrade an existing CLI'}
      </p>
      <AkCodeBlock
        title="shell"
        code={`ak self-update --channel stable --yes\nak self-update --beta --yes`}
      />
    </div>
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {isVi ? 'Đang dùng ClaudeKit? Xem trước chuyển sang AgentKit: ' : 'Already on ClaudeKit? Preview a move to AgentKit: '}
      <AkInlineCode text="ak migrate --from=ck" />
      {'.'}
    </p>
  </AkSection>
  <AkSection
    eyebrow="03"
    title={isVi ? 'Cấu hình lần đầu (ak setup)' : 'First-run setup (ak setup)'}
    desc={isVi
      ? 'Ghi preference AgentKit. Không đăng nhập registry và không cài nội dung Kit.'
      : 'Writes AgentKit preferences. Does not sign in to the registry and does not install Kit content.'}
  >
    <AkCodeBlock title="shell" code={`ak setup`} />
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {isVi ? (
        <>
          Wizard phát hiện runtime đã login, cho chọn adapter, rồi cập nhật <AkInlineCode text="~/.agentkit/config.yaml" /> (kit mặc định, telemetry). Chạy lại được — không copy credential runtime.
        </>
      ) : (
        <>
          The wizard detects available runtime login state, lets you choose adapters, then updates <AkInlineCode text="~/.agentkit/config.yaml" /> (default kit, telemetry). Re-running is safe — it does not copy runtime credentials.
        </>
      )}
    </p>
  </AkSection>

  <AkSection
    eyebrow="04"
    title={isVi ? 'Đăng nhập (ak login) rồi cài Kit' : 'Log in (ak login), then install a Kit'}
    desc={isVi
      ? 'Trước khi cài Kit remote có license, đăng nhập registry. Khuyến nghị: API key (dùng thường ngày và CI). Email + OTP khi bạn đang ở terminal tương tác.'
      : 'Before installing licensed remote Kits, authenticate to the registry. Recommended: API key (regular use and CI). Email + OTP when you are in an interactive terminal.'}
  >
    <div class="space-y-5">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'API key (khuyến nghị)' : 'API key (recommended)'}
          </h3>
          <span class="rounded-full bg-teal-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-teal-800 dark:bg-teal-500/15 dark:text-teal-300">
            {isVi ? 'Khuyến nghị' : 'Recommended'}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi ? (
            <>
              Tạo user API key trên Account Dashboard, rồi chạy local với key thật. Phù hợp dùng thường ngày và môi trường không tương tác. AgentKit lưu key và session CLI trong file hạn quyền dưới{' '}
              <AkInlineCode text="~/.agentkit/auth" />.
            </>
          ) : (
            <>
              Create a user API key in the Account Dashboard, then run this locally with your real key. Suits regular use and non-interactive hosts. AgentKit stores the API key and CLI session in restricted files under{' '}
              <AkInlineCode text="~/.agentkit/auth" />.
            </>
          )}
        </p>
        <AkCodeBlock title="shell" code={`ak login --api-key ak_live_... --no-interactive\nak whoami`} />
      </div>

      <div class="grid gap-4 lg:grid-cols-2">
        <div class="space-y-3 rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'Email + OTP' : 'Email + OTP'}
          </h3>
          <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {isVi
              ? 'Gửi mã một lần tới email. CLI hỏi Enter OTP code. OTP không lưu trên đĩa; session CLI giữ credential refresh.'
              : 'Sends a one-time code to your email. The CLI prompts Enter OTP code. The OTP is not stored on disk; the CLI session keeps a rotating refresh credential.'}
          </p>
          <AkCodeBlock title="shell" code={`ak login --email you@example.com\nak whoami`} />
        </div>
        <div class="space-y-3 rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
            {isVi ? 'License key (App / device)' : 'License key (App / device)'}
          </h3>
          <p class="text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {isVi
              ? 'Kích hoạt thiết bị cho App session (khác slot CLI email/API). Chủ yếu dùng cho Desktop — không tự cấp Kit Engineer / Marketing.'
              : 'Activates a device for an App session (separate from the CLI email/API slot). Mainly for Desktop — does not grant Engineer / Marketing Kits by itself.'}
          </p>
          <AkCodeBlock title="shell" code={`ak login --license-key ak_license_... --no-interactive`} />
        </div>
      </div>

      <AkCallout variant="tip" title={isVi ? 'Đã mua ClaudeKit / Kit trước đây?' : 'Already bought ClaudeKit / Kits?'}>
        {isVi ? (
          <>
            Bạn vẫn dùng <strong>AgentKit Kits</strong> bình thường: cài CLI ak, rồi{' '}
            <AkInlineCode text="ak login" /> bằng <strong>cùng tài khoản</strong> đã mua ClaudeKit (email + OTP hoặc API key).
            Kiểm tra quyền Kit bằng <AkInlineCode text="ak licenses" /> — không cần mua lại Kit chỉ vì rebrand AgentKit.
            <strong> AgentKit Desktop App</strong> là sản phẩm riêng: chỉ cần mua thêm nếu muốn UI Desktop.
          </>
        ) : (
          <>
            You keep using <strong>AgentKit Kits</strong> as usual: install the ak CLI, then{' '}
            <AkInlineCode text="ak login" /> with the <strong>same account</strong> you used to buy ClaudeKit (email + OTP or API key).
            Check grants with <AkInlineCode text="ak licenses" /> — you do not rebuy Kits just because of the AgentKit rebrand.
            The <strong>AgentKit Desktop App</strong> is separate: buy it only if you want the Desktop UI.
          </>
        )}
      </AkCallout>

      <AkCallout variant="warn" title={isVi ? 'Kit license ≠ Desktop license' : 'Kit license ≠ Desktop license'}>
        {isVi ? (
          <>
            Có hai entitlement riêng: Kit mở Engineer / Marketing; Desktop mở app và quản lý device. Mua một bên không mặc định có bên kia — trừ bundle ghi rõ “Desktop + Kits”. Chi tiết:{' '}
            <a
              class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
              href={translatePath('/guides/agentkit/desktop-app')}
            >
              trang Desktop App
            </a>
            . Kiểm tra Kit đã cấp bằng <AkInlineCode text="ak licenses" />.
          </>
        ) : (
          <>
            Two separate entitlements: Kit unlocks Engineer / Marketing; Desktop unlocks the app and device management. Buying one does not include the other by default — unless a bundle explicitly says “Desktop + Kits”. Details on the{' '}
            <a
              class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
              href={translatePath('/guides/agentkit/desktop-app')}
            >
              Desktop App page
            </a>
            . Check licensed Kits with <AkInlineCode text="ak licenses" />.
          </>
        )}
      </AkCallout>

      <AkCallout variant="info" title={isVi ? 'Kiểm tra & đăng xuất' : 'Check status & sign out'}>
        <span class="inline-flex flex-wrap items-center gap-x-1 gap-y-1">
          <AkInlineCode text="ak whoami" />
          {isVi
            ? ' xác nhận account và kit được license. Chưa đăng nhập thì lệnh vẫn chạy xong — đọc output, đừng tin mỗi “thành công”. '
            : ' confirms the account and licensed kits. If you are not signed in, the command still finishes — read the output; do not treat “success” as proof of login. '}
          <AkInlineCode text="ak licenses" />
          {isVi ? ' liệt kê Kit được cấp. ' : ' lists licensed Kits. '}
          <AkInlineCode text="ak logout" />
          {isVi
            ? ' xóa credential CLI local (giữ App device session nếu có).'
            : ' clears the local CLI credential (preserves any App device session).'}
        </span>
      </AkCallout>

      <div class="rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 to-white p-5 dark:border-slate-700 dark:from-slate-900 dark:to-slate-950">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
          {isVi ? 'Sau khi đăng nhập: cài Kit' : 'After login: install a Kit'}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'Cài Kit cho runtime bạn dùng. Project scope là mặc định; thêm '
            : 'Install a Kit for the runtime you use. Project scope is the default; add '}
          <AkInlineCode text="--global" />
          {isVi
            ? ' khi cần phạm vi user. Cài Kit không chạy workflow — restart coding assistant hoặc mở session mới, rồi gọi Skill (ví dụ /ak:plan hoặc $ak:plan).'
            : ' for user-wide availability. Installing a Kit does not run a workflow — restart the coding assistant or open a new session, then invoke a Skill (for example /ak:plan or $ak:plan).'}
        </p>
      </div>
    </div>
  </AkSection>

