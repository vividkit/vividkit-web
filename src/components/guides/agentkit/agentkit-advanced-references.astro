---
import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { AGENTKIT_CLI_FACTS } from '@/data/guides/agentkit/agentkit-cli-facts';
import { AGENTKIT_MIGRATION_MAPPING_BY_LOCALE } from '@/data/guides/agentkit/agentkit-migration-mapping';
import { AGENTKIT_SKILL_FACTS } from '@/data/guides/agentkit/agentkit-skill-facts';
import { AGENTKIT_TARGET_CAPABILITIES } from '@/data/guides/agentkit/agentkit-target-capabilities';
import AgentKitCommandMapping from './agentkit-command-mapping.astro';
import AgentKitCompatibilityAndTroubleshooting from './agentkit-compatibility-and-troubleshooting.astro';
import AgentKitContinuityFaq from './agentkit-continuity-faq.astro';
import AgentKitDesktopAppOverview from './agentkit-desktop-app-overview.astro';
import AgentKitKitTargets from './agentkit-kit-targets.astro';
import AgentKitLegacySkillCleanup from './agentkit-legacy-skill-cleanup.astro';

interface Props {
  lang: Language;
  includeStage7Details: boolean;
}

const { lang, includeStage7Details } = Astro.props;
const t = useTranslations(lang);
const mappingRows = AGENTKIT_MIGRATION_MAPPING_BY_LOCALE[lang];
---

<section id="continuity" class="scroll-mt-40 pt-14 lg:scroll-mt-28" aria-labelledby="advanced-references-heading">
  <details class="group rounded-2xl border border-slate-200 bg-slate-50/70 dark:border-slate-700 dark:bg-slate-900/40" data-agentkit-advanced-references>
    <summary class="flex min-h-14 cursor-pointer list-none items-center gap-4 rounded-2xl px-5 py-4 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2">
      <span class="min-w-0">
        <span id="advanced-references-heading" role="heading" aria-level="2" class="block font-heading text-xl font-bold text-slate-950 dark:text-slate-50">{t('agentkit.references.heading')}</span>
        <span class="mt-1 block text-sm leading-6 text-slate-600 dark:text-slate-300">{t('agentkit.references.intro')}</span>
      </span>
      <span class="ml-auto text-xl text-slate-400 transition-transform duration-200 motion-reduce:transition-none group-open:rotate-45" aria-hidden="true">+</span>
    </summary>

    <div class="border-t border-slate-200 px-5 pb-8 dark:border-slate-700">
      <AgentKitContinuityFaq lang={lang} />
      <AgentKitDesktopAppOverview lang={lang} />
      <AgentKitKitTargets lang={lang} cliFacts={AGENTKIT_CLI_FACTS} skillFacts={AGENTKIT_SKILL_FACTS} targets={AGENTKIT_TARGET_CAPABILITIES} />
      <AgentKitLegacySkillCleanup lang={lang} includeStage7Details={includeStage7Details} />
      <AgentKitCommandMapping lang={lang} rows={mappingRows} />
      <AgentKitCompatibilityAndTroubleshooting lang={lang} />
    </div>
  </details>
</section>
