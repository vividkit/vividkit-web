---
// Internal sources (do not publish on the page):
// Authority: AgentKit stable v2.14.0 (405ea37). PreflightRemoteMigrateKit in
// kitcmd/paid_kit_gate.go does not call ValidateProductLocalKitActivation —
// logged-in remote migrate of paid kits is the supported path on 2.14.0.
// - Soft path: ak migrate --from=ck (dry-run default true)
// - Clean cutover is a separate guide — ck uninstall + ak kit init

import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkStepRail from './AkStepRail.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';
import AkFeatureGrid from './AkFeatureGrid.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);

const whatItDoes = isVi
  ? [
      { icon: 'SCN', title: 'Scan', body: 'Quét install ClaudeKit (ck) và lập kế hoạch chuyển sang AgentKit.', accent: 'teal' as const },
      { icon: 'CLS', title: 'Classify', body: 'CK-owned/standard, custom/unknown, conflict đang active.', accent: 'cyan' as const },
      { icon: 'DRY', title: 'Dry-run default', body: 'Mặc định không ghi file cho đến khi bạn opt-in rõ ràng.', accent: 'emerald' as const },
      { icon: 'BKP', title: 'Backup on apply', body: 'Khi apply: tạo backup, rồi ghi target sau safety gate và --yes.', accent: 'amber' as const },
    ]
  : [
      { icon: 'SCN', title: 'Scan', body: 'Scans a ClaudeKit (ck) install and plans a transition to AgentKit.', accent: 'teal' as const },
      { icon: 'CLS', title: 'Classify', body: 'CK-owned/standard, custom/unknown, and active conflicts.', accent: 'cyan' as const },
      { icon: 'DRY', title: 'Dry-run default', body: 'Nothing is written until you explicitly opt in.', accent: 'emerald' as const },
      { icon: 'BKP', title: 'Backup on apply', body: 'On apply: creates a backup, then writes the target after safety gates and --yes.', accent: 'amber' as const },
    ];

const recovery = isVi
  ? [
      { title: 'ak migrate rollback', body: 'Khôi phục pre-apply state từ journal migrate gần nhất (khi có).' },
      { title: 'ak backups list / restore', body: 'Danh sách và restore backup AgentKit — scope restore có giới hạn.' },
      { title: 'Bản sao thủ công', body: 'Thư mục agentkit-pre-migrate-backup là lớp an toàn ngoài tool.' },
    ]
  : [
      { title: 'ak migrate rollback', body: 'Restores pre-apply state from the latest migration journal when available.' },
      { title: 'ak backups list / restore', body: 'List and restore AgentKit backups — restore scope is limited.' },
      { title: 'Manual copy', body: 'Your agentkit-pre-migrate-backup folder is the outside-the-tool safety net.' },
    ];

const macBackup = `set -Eeuo pipefail
umask 077
STAMP=$(date +%Y%m%d-%H%M%S)
DEST=$(mktemp -d "$HOME/agentkit-pre-migrate-backup-$STAMP.XXXXXX")

copy_tree() {
  src=$1
  name=$2
  [ -d "$src" ] || return 0
  [ ! -e "$DEST/$name" ] || { echo "Refusing existing destination: $DEST/$name" >&2; return 1; }
  cp -a "$src" "$DEST/$name"
  [ -d "$DEST/$name" ] || { echo "Backup verification failed: $DEST/$name" >&2; return 1; }
}

copy_tree "$HOME/.claude" claude
copy_tree "$HOME/.claudekit" claudekit
copy_tree "$HOME/.agentkit" agentkit
echo "Safety copy completed at: $DEST"`;

const winBackup = `Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
$stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
$dest = Join-Path $env:USERPROFILE "agentkit-pre-migrate-backup-$stamp-$([guid]::NewGuid().ToString('N').Substring(0, 8))"
if (Test-Path -LiteralPath $dest) { throw "Refusing existing destination: $dest" }
New-Item -ItemType Directory -Path $dest -ErrorAction Stop | Out-Null
$items = @(
  @{ Src = (Join-Path $env:USERPROFILE '.claude'); Name = 'claude' }
  @{ Src = (Join-Path $env:USERPROFILE '.claudekit'); Name = 'claudekit' }
  @{ Src = (Join-Path $env:USERPROFILE '.agentkit'); Name = 'agentkit' }
)
foreach ($item in $items) {
  if (Test-Path -LiteralPath $item.Src -PathType Container) {
    $target = Join-Path $dest $item.Name
    if (Test-Path -LiteralPath $target) { throw "Refusing existing destination: $target" }
    Copy-Item -LiteralPath $item.Src -Destination $target -Recurse -Force -ErrorAction Stop
    if (-not (Test-Path -LiteralPath $target -PathType Container)) { throw "Backup verification failed: $target" }
  }
}
Write-Host "Safety copy completed at: $dest"`;
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="amber"
    kicker={isVi ? 'Migration · soft · tùy chọn' : 'Migration · soft · optional'}
    title={isVi ? 'Chuyển ClaudeKit sang AgentKit' : 'Migrate ClaudeKit to AgentKit'}
    subtitle={isVi
      ? 'Sao lưu trước. Mặc định chỉ xem trước (chưa ghi). Thường giữ file bạn đã chỉnh — không phải xóa sạch ClaudeKit.'
      : 'Back up first. Preview by default (no writes yet). Usually keeps files you customized — not a full ClaudeKit wipe.'}
    badges={isVi ? ['ak migrate --from=ck'] : ['ak migrate --from=ck']}
  />

  <AkCallout variant="danger" title={isVi ? 'Sao lưu trước khi thay đổi bất kỳ thứ gì' : 'Back up before changing anything'}>
    {isVi
      ? 'Tự copy thư mục cấu hình ra chỗ an toàn trước lệnh ghi đầu tiên. Khi apply, AgentKit cũng tạo backup — nhưng bản copy tay giúp bạn khôi phục ngoài tool.'
      : 'Copy configuration folders somewhere safe yourself before the first write. Apply also creates an AgentKit backup — but your manual copy lets you recover outside the tool.'}
  </AkCallout>

  <AkSection
    eyebrow={isVi ? 'Chọn đường' : 'Choose a path'}
    title={isVi ? 'Hai cách rời ClaudeKit' : 'Two ways to leave ClaudeKit'}
  >
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl border-2 border-amber-300/70 bg-gradient-to-br from-amber-50/90 to-white p-5 dark:border-amber-500/30 dark:from-amber-950/40 dark:to-slate-900/60">
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-amber-700 dark:text-amber-300">
          {isVi ? 'Path A · trang này' : 'Path A · this page'}
        </p>
        <h3 class="mt-1 text-base font-bold text-slate-900 dark:text-white">
          {isVi ? 'Chuyển dần' : 'Move gradually'}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'ak migrate --from=ck: quét cài đặt, đề xuất kế hoạch, mặc định chỉ xem trước. File bạn đã chỉnh thường được giữ (không phải cam kết “luôn luôn”). ClaudeKit vẫn dùng được nếu chưa sẵn sàng rời hẳn.'
            : 'ak migrate --from=ck: scans your install, proposes a plan, previews by default. Files you customized are usually kept (not an “always” promise). ClaudeKit still works if you are not ready to leave fully.'}
        </p>
        <p class="mt-3 text-xs font-medium text-amber-800 dark:text-amber-200">
          {isVi ? 'Phù hợp khi muốn chuyển từ từ và giữ setting cũ.' : 'Best when you want a gradual move and keep your custom setup.'}
        </p>
      </div>

      <a
        href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}
        class="group rounded-2xl border border-rose-200/80 bg-gradient-to-br from-rose-50/70 to-white p-5 transition-all hover:-translate-y-0.5 hover:border-rose-300 hover:shadow-md dark:border-rose-500/25 dark:from-rose-950/30 dark:to-slate-900/60 dark:hover:border-rose-500/40"
      >
        <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-rose-700 dark:text-rose-300">
          {isVi ? 'Path B · page riêng' : 'Path B · separate guide'}
        </p>
        <h3 class="mt-1 text-base font-bold text-slate-900 group-hover:text-rose-800 dark:text-white dark:group-hover:text-rose-200">
          {isVi ? 'Gỡ hẳn ClaudeKit' : 'Clean cutover'}
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'Nhiều bước: sao lưu → gỡ CK từng chỗ → cài AgentKit → gỡ lệnh ck → dọn thủ công. Không có lệnh “một phát xong”; --all không gỡ mọi project.'
            : 'Many steps: back up → remove CK place by place → install AgentKit → remove the ck command → clean leftovers by hand. No one-shot command; --all is not every project.'}
        </p>
        <span class="mt-3 inline-flex text-sm font-semibold text-rose-700 group-hover:underline dark:text-rose-300">
          {isVi ? 'Mở hướng dẫn gỡ hẳn →' : 'Open clean cutover →'}
        </span>
      </a>
    </div>
    <p class="mt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {isVi ? (
        <>
          <AkInlineCode text="ak migrate" /> <strong>không</strong> xóa sạch mọi dấu vết ClaudeKit: nó vô hiệu hóa phần CK còn “nguyên” (có ghi nhận), còn file bạn đã chỉnh thường được giữ.
          Muốn gỡ hẳn → Path B.
        </>
      ) : (
        <>
          <AkInlineCode text="ak migrate" /> does <strong>not</strong> wipe every ClaudeKit leftover: it disables still-pristine CK pieces (with a record), and usually keeps files you customized.
          Want a full remove → Path B.
        </>
      )}
    </p>
    <AkCallout variant="info" title={isVi ? 'Apply kit trả phí' : 'Paid-kit apply'}>
      {isVi ? (
        <>
          Ghi thật cần <AkInlineCode text="--yes" /> (dry-run vẫn mặc định). Kit trả phí (Engineer, …) cài từ registry sau{' '}
          <AkInlineCode text="ak login" />. Trên stable <AkInlineCode text="2.14.0" />, preflight migrate remote không còn chặn kit trả phí bằng luật local/dev.
          Nếu apply dở: <AkInlineCode text="ak migrate rollback" /> hoặc bản sao thủ công, rồi xem{' '}
          <a class="font-semibold underline-offset-2 hover:underline" href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}>
            gỡ hẳn ClaudeKit
          </a>
          .
        </>
      ) : (
        <>
          Writes need <AkInlineCode text="--yes" /> (dry-run stays the default). Paid kits (Engineer, …) install from the registry after{' '}
          <AkInlineCode text="ak login" />. On stable <AkInlineCode text="2.14.0" />, remote migrate preflight no longer rejects paid kits with the local/dev rule.
          If apply stops mid-flight: <AkInlineCode text="ak migrate rollback" /> or your manual copy, then see{' '}
          <a class="font-semibold underline-offset-2 hover:underline" href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}>
            clean cutover
          </a>
          .
        </>
      )}
    </AkCallout>
  </AkSection>

  <AkSection
    eyebrow={isVi ? 'Backup thủ công' : 'Manual backup'}
    title={isVi ? 'Theo nền tảng' : 'By platform'}
    desc={isVi
      ? 'Sao chép các thư mục cấu hình ra ngoài tree agent trước lệnh mutate đầu tiên.'
      : 'Copy configuration directories outside agent trees before the first mutating command.'}
  >
    <div class="mb-5 rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 via-white to-teal-50/40 p-4 dark:border-slate-700 dark:from-slate-900/80 dark:via-slate-900/50 dark:to-teal-950/20">
      <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
        {isVi ? 'Discovery quét (khi có)' : 'Discovery scans when present'}
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {(
          isVi
            ? [
                { label: '~/.claude', tip: 'Claude Code global' },
                { label: '~/.claudekit', tip: 'CK CLI state' },
                { label: '.claude', tip: 'Project Claude' },
                { label: '.claudekit', tip: 'Project CK' },
                { label: '~/.agentkit', tip: 'AgentKit home' },
                { label: '%USERPROFILE%', tip: 'Windows home' },
              ]
            : [
                { label: '~/.claude', tip: 'Claude Code global' },
                { label: '~/.claudekit', tip: 'CK CLI state' },
                { label: '.claude', tip: 'Project Claude' },
                { label: '.claudekit', tip: 'Project CK' },
                { label: '~/.agentkit', tip: 'AgentKit home' },
                { label: '%USERPROFILE%', tip: 'Windows home' },
              ]
        ).map((chip) => (
          <span
            class="inline-flex items-center gap-1.5 rounded-full border border-slate-200/90 bg-white/90 py-1 pl-1 pr-2.5 shadow-sm dark:border-slate-600 dark:bg-slate-800/80"
            title={chip.tip}
          >
            <span class="rounded-full bg-teal-500/15 px-2 py-0.5 font-mono text-[11px] font-medium text-teal-800 dark:bg-teal-500/20 dark:text-teal-200">
              {chip.label}
            </span>
            <span class="hidden text-[10px] font-medium text-slate-500 sm:inline dark:text-slate-400">{chip.tip}</span>
          </span>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-4">
      <article class="relative flex flex-col overflow-hidden rounded-2xl border border-teal-200/70 bg-gradient-to-br from-teal-50/70 via-white to-white p-4 sm:p-5 dark:border-teal-500/25 dark:from-teal-950/40 dark:via-slate-900/80 dark:to-slate-900/60">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-teal-600 dark:text-teal-400">
              Unix
            </p>
            <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
              macOS / Linux
            </h3>
          </div>
          <span class="shrink-0 rounded-full bg-teal-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-teal-700 dark:bg-teal-500/20 dark:text-teal-300">
            bash
          </span>
        </div>
        <div class="flex flex-1 flex-col">
          <AkCodeBlock title="bash" code={macBackup} />
        </div>
      </article>

      <article class="relative flex flex-col overflow-hidden rounded-2xl border border-violet-200/70 bg-gradient-to-br from-violet-50/70 via-white to-white p-4 sm:p-5 dark:border-violet-500/25 dark:from-violet-950/35 dark:via-slate-900/80 dark:to-slate-900/60">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-violet-600 dark:text-violet-400">
              Windows
            </p>
            <h3 class="mt-0.5 text-base font-bold text-slate-900 dark:text-white">
              PowerShell
            </h3>
          </div>
          <span class="shrink-0 rounded-full bg-violet-500/15 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-violet-700 dark:bg-violet-500/20 dark:text-violet-300">
            pwsh
          </span>
        </div>
        <div class="flex flex-1 flex-col gap-3">
          <AkCodeBlock title="powershell" code={winBackup} />
          <p class="mt-auto rounded-xl border border-violet-200/50 bg-violet-50/60 px-3.5 py-2.5 text-xs leading-relaxed text-slate-600 dark:border-violet-500/20 dark:bg-violet-950/20 dark:text-slate-400">
            {isVi
              ? 'Chạy trong PowerShell (không phải CMD). Paths dưới %USERPROFILE%.'
              : 'Run in PowerShell (not CMD). Paths under %USERPROFILE%.'}
          </p>
        </div>
      </article>
    </div>
  </AkSection>

  <AkSection eyebrow={isVi ? 'Hành vi' : 'Behavior'} title={isVi ? 'Migrate làm gì' : 'What migration does'}>
    <AkFeatureGrid features={whatItDoes} columns={2} />
  </AkSection>

  <AkSection eyebrow={isVi ? 'Preview' : 'Preview'} title={isVi ? 'Không mutate' : 'No mutation'}>
    <AkCodeBlock
      title="shell"
      code={`ak migrate\nak migrate --from=ck\nak migrate --from=ck --json --no-interactive`}
    />
    <p class="text-sm text-slate-500 dark:text-slate-400">
      {isVi
        ? 'Mặc định --dry-run=true. Preview liệt kê category, conflict, recommended actions và recovery commands.'
        : 'Default is --dry-run=true. The preview lists categories, conflicts, recommended actions, and recovery commands.'}
    </p>
  </AkSection>

  <AkSection eyebrow={isVi ? 'Apply' : 'Apply'} title={isVi ? 'Ghi file — chỉ sau backup + preview ổn' : 'Writes files — only after backup + a good preview'}>
    <AkCallout variant="warn" title={isVi ? 'Cảnh báo mutate' : 'Mutation warning'}>
      {isVi
        ? 'Lệnh dưới đây ghi file. Không chạy cho đến khi đã sao lưu và hiểu preview.'
        : 'The commands below write files. Do not run them until you have backed up and understand the preview.'}
    </AkCallout>
    <AkCodeBlock
      title="shell"
      code={`ak migrate --from=ck --dry-run=false --yes
# Stale lock from a crashed apply:
# ak migrate --from=ck --force-unlock --dry-run=false --yes
# Claude Code project plugin delivery (only when intended):
# ak migrate --from=ck --switch-to-plugin --dry-run=false --yes
# Legacy ClaudeKit prefs into AgentKit config.yaml:
# ak migrate prefs`}
    />
  </AkSection>

  <AkSection eyebrow={isVi ? 'Verify' : 'Verify'} title={isVi ? 'Sau migrate' : 'After migration'}>
    <AkCodeBlock
      title="shell"
      code={`ak doctor --json --exit-on-fail --offline\nak backups list\n# Confirm Skills in the assistant: /ak:… or $ak:…`}
    />
  </AkSection>

  <AkSection eyebrow={isVi ? 'Recovery' : 'Recovery'} title={isVi ? 'Rollback boundaries' : 'Rollback boundaries'}>
    <AkStepRail steps={recovery} accent="amber" />
  </AkSection>

  <AkCallout variant="tip" title={isVi ? 'Hai loại “migrate” khác nhau' : 'Two different “migrate” paths'}>
    {isVi
      ? 'Trang này: ClaudeKit → AgentKit (soft product transition) qua '
      : 'This page: ClaudeKit → AgentKit (soft product transition) via '}
    <AkInlineCode text="ak migrate --from=ck" />
    {isVi
      ? '. Muốn gỡ hẳn CK: '
      : '. For a cleaner leave: '}
    <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}>
      {isVi ? 'gỡ hẳn ClaudeKit' : 'clean cutover'}
    </a>
    {isVi
      ? '. Nếu vẫn ở ClaudeKit và muốn đẩy workflow sang Codex / tool coding khác, dùng sidebar ClaudeKit → “CK → Tool coding khác”.'
      : '. If you stay on ClaudeKit and want to push workflows to Codex or another coding tool, use the ClaudeKit sidebar item “CK → Other coding tools”.'}
  </AkCallout>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Tiếp theo' : 'Next'}
    links={[
      {
        href: '/guides/agentkit/clean-cutover-from-claudekit',
        label: isVi ? 'Gỡ hẳn ClaudeKit' : 'Clean cutover',
        desc: isVi ? 'Gỡ CK multi-step, backup trước' : 'Leave CK multi-step; backup first',
      },
      { href: '/guides/agentkit', label: isVi ? 'AgentKit là gì?' : 'What is AgentKit?' },
      { href: '/guides/agentkit/getting-started', label: isVi ? 'Cài AgentKit' : 'Get started' },
      { href: '/guides/agentkit/troubleshooting', label: isVi ? 'Sự cố' : 'Troubleshooting' },
    ]}
  />
</div>
