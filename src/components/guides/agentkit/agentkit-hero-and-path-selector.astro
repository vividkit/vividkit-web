---
import { ArrowRight, Bot, GitBranch, ShieldCheck } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const paths = [
  {
    id: 'legacy',
    icon: GitBranch,
    title: t('agentkit.paths.legacy.title'),
    body: t('agentkit.paths.legacy.body'),
    cta: t('agentkit.paths.legacy.cta'),
    href: '#step-03-inventory',
    className: 'border-purple-200 bg-purple-50/70 dark:border-purple-800/70 dark:bg-purple-950/20',
    iconClass: 'bg-purple-100 text-purple-700 dark:bg-purple-900/50 dark:text-purple-300',
  },
  {
    id: 'new',
    icon: Bot,
    title: t('agentkit.paths.new.title'),
    body: t('agentkit.paths.new.body'),
    cta: t('agentkit.paths.new.cta'),
    href: '#step-04-stage-ak',
    className: 'border-sky-200 bg-sky-50/70 dark:border-sky-800/70 dark:bg-sky-950/20',
    iconClass: 'bg-sky-100 text-sky-700 dark:bg-sky-900/50 dark:text-sky-300',
  },
] as const;
---

<header class="grid gap-8 border-b border-slate-200 pb-12 dark:border-slate-800 lg:grid-cols-[minmax(0,1.4fr)_minmax(15rem,0.6fr)] lg:items-end">
  <div class="max-w-3xl">
    <p class="mb-4 text-xs font-bold uppercase tracking-[0.12em] text-purple-700 dark:text-purple-300">
      {t('agentkit.hero.eyebrow')}
    </p>
    <h1
      class="font-heading text-4xl font-bold leading-[1.1] tracking-[-0.03em] text-slate-950 text-balance dark:text-slate-50 md:text-5xl"
      set:html={renderInlineCode(t('agentkit.hero.title'))}
    ></h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('agentkit.hero.description')}
    </p>
  </div>

  <div class="flex gap-3 border-t-2 border-emerald-500 pt-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    <ShieldCheck class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
    <p>{t('agentkit.hero.notice')}</p>
  </div>
</header>

<section id="choose-path" aria-labelledby="choose-path-heading" class="pt-12">
  <h2 id="choose-path-heading" class="font-heading text-2xl font-bold text-slate-950 dark:text-slate-50 md:text-3xl">
    {t('agentkit.paths.heading')}
  </h2>

  <div class="mt-6 grid gap-4 md:grid-cols-2">
    {paths.map((path) => {
      const Icon = path.icon;
      return (
        <article class={`rounded-2xl border p-6 ${path.className}`}>
          <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${path.iconClass}`}>
            <Icon class="h-5 w-5" aria-hidden="true" />
          </div>
          <h3 class="mt-5 text-lg font-bold text-slate-950 dark:text-slate-50">{path.title}</h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-slate-600 text-pretty dark:text-slate-300" set:html={renderInlineCode(path.body)} ></p>
          <a
            href={path.href}
            class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg px-1 font-semibold text-purple-700 transition-colors duration-200 hover:text-purple-900 hover:underline focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 active:text-purple-600 dark:text-purple-300 dark:hover:text-purple-100"
          >
            {path.cta}
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </article>
      );
    })}
  </div>
</section>
