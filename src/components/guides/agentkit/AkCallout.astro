---
import { Info, Lightbulb, TriangleAlert, OctagonAlert, CircleCheck } from 'lucide-astro';

interface Props {
  variant?: 'info' | 'tip' | 'warn' | 'danger' | 'success';
  title?: string;
}

const { variant = 'info', title } = Astro.props;

const styles = {
  info: {
    box: 'border-slate-200/90 bg-slate-50/90 dark:border-slate-700 dark:bg-slate-900/50',
    icon: 'bg-slate-200/90 text-slate-700 dark:bg-slate-700 dark:text-slate-200',
    title: 'text-slate-900 dark:text-white',
    body: 'text-slate-600 dark:text-slate-300',
  },
  tip: {
    box: 'border-teal-200/80 bg-gradient-to-br from-teal-50/90 to-cyan-50/50 dark:border-teal-500/25 dark:from-teal-950/40 dark:to-cyan-950/20',
    icon: 'bg-teal-500 text-white shadow-md shadow-teal-500/25',
    title: 'text-teal-900 dark:text-teal-100',
    body: 'text-slate-700 dark:text-slate-300',
  },
  warn: {
    box: 'border-amber-300/80 bg-gradient-to-br from-amber-50 to-orange-50/60 dark:border-amber-500/30 dark:from-amber-950/40 dark:to-orange-950/20',
    icon: 'bg-amber-500 text-white shadow-md shadow-amber-500/25',
    title: 'text-amber-950 dark:text-amber-100',
    body: 'text-amber-950/90 dark:text-amber-50/90',
  },
  danger: {
    box: 'border-2 border-rose-300/90 bg-gradient-to-br from-rose-50 to-rose-100/50 dark:border-rose-500/40 dark:from-rose-950/50 dark:to-rose-900/20',
    icon: 'bg-rose-500 text-white shadow-md shadow-rose-500/30',
    title: 'text-rose-900 dark:text-rose-100',
    body: 'text-rose-950/90 dark:text-rose-50/90',
  },
  success: {
    box: 'border-emerald-200/80 bg-gradient-to-br from-emerald-50/90 to-teal-50/40 dark:border-emerald-500/25 dark:from-emerald-950/40 dark:to-teal-950/20',
    icon: 'bg-emerald-500 text-white shadow-md shadow-emerald-500/25',
    title: 'text-emerald-900 dark:text-emerald-100',
    body: 'text-slate-700 dark:text-slate-300',
  },
}[variant];

const Icon = {
  info: Info,
  tip: Lightbulb,
  warn: TriangleAlert,
  danger: OctagonAlert,
  success: CircleCheck,
}[variant];
---

<aside class:list={['rounded-2xl border p-4 md:p-5', styles.box]} role={variant === 'danger' || variant === 'warn' ? 'alert' : 'note'}>
  <div class="flex gap-3">
    <div class:list={['flex h-9 w-9 shrink-0 items-center justify-center rounded-xl', styles.icon]}>
      <Icon class="h-[18px] w-[18px]" stroke-width={2.2} aria-hidden="true" />
    </div>
    <div class="min-w-0 flex-1 space-y-1.5">
      {title && <div class:list={['text-sm font-bold md:text-base', styles.title]}>{title}</div>}
      <div class:list={['text-sm leading-relaxed', styles.body]}>
        <slot />
      </div>
    </div>
  </div>
</aside>
