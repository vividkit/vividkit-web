---
import type { Language } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '@/i18n/utils';
import { getAgentKitCliFact } from '@/data/guides/agentkit/agentkit-cli-facts';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cliGuideHref = getRelativeLocaleUrl(lang, 'guides/cli');
const codexGuideHref = getRelativeLocaleUrl(lang, 'guides/ck-with-codex');
const migrateHref = getRelativeLocaleUrl(lang, 'guides/agentkit') + '#migration-journey';

const steps = [
  {
    title: t('agentkit.quickstart.step.install.title'),
    body: t('agentkit.quickstart.step.install.body'),
    unix: getAgentKitCliFact('install-unix'),
    windows: getAgentKitCliFact('install-windows'),
  },
  {
    title: t('agentkit.quickstart.step.verify.title'),
    body: t('agentkit.quickstart.step.verify.body'),
    command: getAgentKitCliFact('verify-version')?.command,
  },
  {
    title: t('agentkit.quickstart.step.auth.title'),
    body: t('agentkit.quickstart.step.auth.body'),
    command: getAgentKitCliFact('login-email')?.command,
  },
  {
    title: t('agentkit.quickstart.step.entitlements.title'),
    body: t('agentkit.quickstart.step.entitlements.body'),
    commands: [
      getAgentKitCliFact('whoami')?.command,
      getAgentKitCliFact('licenses')?.command,
    ].filter(Boolean),
  },
  {
    title: t('agentkit.quickstart.step.kit.title'),
    body: t('agentkit.quickstart.step.kit.body'),
    command: getAgentKitCliFact('kit-init')
      ?.command
      .replace('<kit>', 'engineer')
      .replace('<agent>', 'claude-code'),
  },
] as const;

const codeClass = 'block overflow-x-auto rounded-xl bg-slate-100 p-3 font-mono text-sm text-purple-600 dark:bg-slate-800/90 dark:text-purple-400';
---

<section id="quick-start" class="scroll-mt-28 border-b border-slate-200 pb-12 pt-2 dark:border-slate-800" aria-labelledby="agentkit-quick-start-heading">
  <div class="max-w-3xl">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
      {t('agentkit.quickstart.eyebrow')}
    </p>
    <h2 id="agentkit-quick-start-heading" class="mt-3 font-heading text-3xl font-bold text-slate-950 dark:text-slate-50" set:html={renderInlineCode(t('agentkit.quickstart.heading'))}></h2>
    <p class="mt-3 leading-relaxed text-slate-600 text-pretty dark:text-slate-300" set:html={renderInlineCode(t('agentkit.quickstart.intro'))}></p>
  </div>

  <ol class="mt-8 grid gap-4 lg:grid-cols-2">
    {steps.map((step, index) => (
      <li class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900/70">
        <p class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">
          {t('agentkit.quickstart.stepPrefix')} {index + 1}
        </p>
        <h3 class="mt-2 text-lg font-bold text-slate-950 dark:text-slate-50">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300" set:html={renderInlineCode(step.body)}></p>
        <div class="mt-4 space-y-2">
          {'unix' in step && step.unix && (
            <>
              <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">macOS / Linux</p>
              <code class={codeClass}>{step.unix.command}</code>
            </>
          )}
          {'windows' in step && step.windows && (
            <>
              <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Windows</p>
              <code class={codeClass}>{step.windows.command}</code>
            </>
          )}
          {'command' in step && step.command && (
            <code class={codeClass}>{step.command}</code>
          )}
          {'commands' in step && step.commands?.map((command) => (
            <code class={codeClass}>{command}</code>
          ))}
        </div>
        {index === 4 && (
          <p class="mt-4 space-y-1 text-sm">
            <a
              href={cliGuideHref}
              class="block font-semibold text-purple-700 underline-offset-4 hover:underline dark:text-purple-300"
            >
              {t('agentkit.quickstart.cliGuideLink')}
            </a>
            <a
              href={codexGuideHref}
              class="block font-semibold text-purple-700 underline-offset-4 hover:underline dark:text-purple-300"
            >
              {t('agentkit.quickstart.codexGuideLink')}
            </a>
          </p>
        )}
      </li>
    ))}
  </ol>

  <div class="mt-5 max-w-3xl space-y-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    <p set:html={renderInlineCode(t('agentkit.quickstart.footer'))}></p>
    <p class="space-y-1">
      <a
        href="#troubleshooting"
        class="block font-semibold text-purple-700 underline-offset-4 hover:underline dark:text-purple-300"
      >
        {t('agentkit.quickstart.workaroundsLink')}
      </a>
      <a
        href={migrateHref}
        class="block font-semibold text-purple-700 underline-offset-4 hover:underline dark:text-purple-300"
      >
        {t('agentkit.quickstart.migrateLink')}
      </a>
    </p>
  </div>
</section>
