---
// AgentKit troubleshooting (quick checks). Clean reinstall lives on its own page.
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);

const skillMissing = isVi
  ? [
      'Xác nhận Kit đã cài đúng runtime và đúng scope (project vs global).',
      'Restart coding assistant hoặc mở session mới sau khi cài.',
      'Dùng đúng cú pháp runtime (/ak:… vs $ak:…).',
      'Đọc warning adapter: component có thể bị drop hoặc chỉ là supporting content.',
    ]
  : [
      'Confirm the Kit installed for the correct runtime and scope (project vs global).',
      'Restart the coding assistant or open a new session after install.',
      'Use the correct runtime syntax (/ak:… vs $ak:…).',
      'Read adapter warnings: a component may be dropped or kept as supporting content only.',
    ];

const desktopTips = isVi
  ? [
      'Verify SHA-256 trước khi mở; đừng tắt Gatekeeper toàn hệ thống.',
      'Session App license tách với CLI login.',
      'Desktop không chạy Skill — kiểm tra coding assistant nếu thiếu workflow.',
    ]
  : [
      'Verify SHA-256 before opening; do not disable Gatekeeper system-wide.',
      'App license session is separate from CLI login.',
      'Desktop does not run Skills — check the coding assistant if a workflow is missing.',
    ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="amber"
    kicker={isVi ? 'AgentKit · Support' : 'AgentKit · Support'}
    title={isVi ? 'Xử Lý Sự Cố AgentKit' : 'AgentKit Troubleshooting'}
    subtitle={isVi
      ? 'Checklist nhanh khi CLI ak, Desktop App hoặc runtime adapter của AgentKit không như kỳ vọng — không phải trang ClaudeKit.'
      : 'Quick checks when the ak CLI, Desktop App, or AgentKit runtime adapters misbehave — not the ClaudeKit troubleshooting surface.'}
  />


  <AkCallout variant="tip" title={isVi ? 'Cần gỡ sạch rồi cài lại stable?' : 'Need a clean reinstall of stable?'}>
    {isVi ? (
      <>
        Trang này chỉ checklist sự cố. Quy trình ownership-aware (kit uninstall → tùy chọn dời state → cài stable)
        nằm ở{' '}
        <a
          class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300"
          href={translatePath('/guides/agentkit/clean-reinstall')}
        >
          Cài lại clean AgentKit
        </a>
        .
      </>
    ) : (
      <>
        This page is a quick checklist. The ownership-aware flow (kit uninstall → optional state move → install stable)
        is on{' '}
        <a
          class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300"
          href={translatePath('/guides/agentkit/clean-reinstall')}
        >
          Clean reinstall of AgentKit
        </a>
        .
      </>
    )}
  </AkCallout>

  <div class="grid gap-4 md:grid-cols-2">
    <section class="rounded-2xl border border-slate-200/80 bg-white/80 p-5 dark:border-slate-700 dark:bg-slate-900/50">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        {isVi ? 'CLI không tìm thấy' : 'CLI not found'}
      </h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        {isVi
          ? 'Xác nhận thư mục cài nằm trên PATH, mở terminal mới, rồi chạy '
          : 'Confirm the install directory is on PATH, open a new terminal, then run '}
        <AkInlineCode text="ak --version" />.
      </p>
    </section>
    <section class="rounded-2xl border border-slate-200/80 bg-white/80 p-5 dark:border-slate-700 dark:bg-slate-900/50">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">
        {isVi ? 'Chẩn đoán nhanh' : 'Quick diagnostics'}
      </h2>
      <div class="mt-3">
        <AkCodeBlock title="doctor" code={`ak doctor --json\nak doctor --json --offline`} />
      </div>
    </section>
  </div>

  <AkSection
    eyebrow={isVi ? 'Lệnh gỡ' : 'Uninstall commands'}
    title={isVi ? 'ak uninstall ≠ gỡ kit global' : 'ak uninstall ≠ remove a global kit'}
  >
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
        <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
          <AkInlineCode text="ak uninstall" />
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {isVi
            ? 'Gỡ project do AgentKit quản lý. Cần AK project tại/trên cwd — không phải lệnh gỡ kit global.'
            : 'Removes an AgentKit-managed project. Needs an AK project at/above cwd — not for removing a global kit.'}
        </p>
      </div>
      <div class="rounded-2xl border border-teal-200/70 bg-teal-50/40 p-4 dark:border-teal-500/25 dark:bg-teal-950/20">
        <h3 class="text-sm font-semibold text-teal-900 dark:text-teal-100">
          <AkInlineCode text="ak kit uninstall <kit>" />
        </h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-700 dark:text-slate-300">
          {isVi
            ? 'Gỡ nội dung kit AgentKit-owned theo scope/mode. Chi tiết flags + clean reinstall:'
            : 'Removes AgentKit-owned kit content by scope/mode. Flags + full clean reinstall:'}
          {' '}
          <a
            class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200"
            href={translatePath('/guides/agentkit/clean-reinstall')}
          >
            {isVi ? 'cài lại clean' : 'clean reinstall'}
          </a>
          .
        </p>
      </div>
    </div>
  </AkSection>

  <AkSection
    eyebrow={isVi ? 'Runtime' : 'Runtime'}
    title={isVi ? 'Skill không xuất hiện' : 'Skill not visible'}
  >
    <ul class="space-y-2">
      {skillMissing.map((item, i) => (
        <li class="flex gap-3 rounded-xl border border-slate-200/70 bg-slate-50/80 px-4 py-3 text-sm text-slate-700 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-300">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-500 text-xs font-bold text-white">{i + 1}</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </AkSection>

  <AkSection eyebrow="Desktop" title={isVi ? 'Desktop' : 'Desktop'}>
    <ul class="grid gap-3 sm:grid-cols-3">
      {desktopTips.map((t) => (
        <li class="rounded-2xl border border-amber-200/60 bg-amber-50/50 p-4 text-sm text-amber-950 dark:border-amber-500/25 dark:bg-amber-950/20 dark:text-amber-100">
          {t}
        </li>
      ))}
    </ul>
  </AkSection>

  <AkSection eyebrow={isVi ? 'Migrate' : 'Migrate'} title={isVi ? 'Sau khi chuyển CK → AK' : 'After CK → AK migration'}>
    <AkCallout variant="info">
      {isVi
        ? 'Recovery gợi ý thường gồm '
        : 'Recovery hints often include '}
      <AkInlineCode text="ak migrate rollback" />
      {isVi ? ' và ' : ' and '}
      <AkInlineCode text="ak backups list" />
      {isVi ? '. Xem hướng dẫn migrate cho dry-run và backup. ' : '. See the migration guide for dry-run and backup. '}
      {isVi ? (
        <>
          Gỡ hẳn ClaudeKit:{' '}
          <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}>
            clean cutover
          </a>
          .
        </>
      ) : (
        <>
          Leaving ClaudeKit:{' '}
          <a class="font-semibold text-teal-700 underline-offset-2 hover:underline dark:text-teal-300" href={translatePath('/guides/agentkit/clean-cutover-from-claudekit')}>
            clean cutover
          </a>
          .
        </>
      )}
    </AkCallout>
  </AkSection>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Tài liệu liên quan' : 'Related guides'}
    links={[
      {
        href: '/guides/agentkit/clean-reinstall',
        label: isVi ? 'Cài lại clean AgentKit' : 'Clean reinstall of AgentKit',
        desc: isVi ? 'Gỡ kit + cài stable an toàn' : 'Safe kit uninstall + stable reinstall',
      },
      { href: '/guides/migrate-claudekit-to-agentkit', label: isVi ? 'Migrate CK → AK' : 'Migrate CK → AK' },
      { href: '/guides/agentkit/getting-started', label: isVi ? 'Cài đặt' : 'Getting started' },
      { href: '/guides/agentkit/runtime-support', label: isVi ? 'Runtime' : 'Runtime support' },
    ]}
  />
</div>
