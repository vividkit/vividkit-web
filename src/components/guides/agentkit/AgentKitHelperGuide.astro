---
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkCallout from './AkCallout.astro';
import AkFeatureGrid from './AkFeatureGrid.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkStepRail from './AkStepRail.astro';
import AkCompare from './AkCompare.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);
const repoUrl = 'https://github.com/thieung/agentkit-helper';
const npmPkg = '@thieung/agentkit-helper';

const roles = isVi
  ? [
      {
        icon: '01',
        title: 'Hỏi vài lựa chọn',
        body: 'Scope project hoặc user/global, Engineer hoặc Marketing Kit, runtime, kênh stable hoặc beta.',
        accent: 'teal' as const,
      },
      {
        icon: '02',
        title: 'Hiện lệnh ak',
        body: 'Helper in đúng lệnh CLI ak sẽ chạy — bạn thấy trước khi ghi file.',
        accent: 'cyan' as const,
      },
      {
        icon: '03',
        title: 'Chạy giúp bạn',
        body: 'Gọi CLI ak đã cài. AgentKit vẫn lo xác minh Kit, ownership, snapshot và file theo runtime.',
        accent: 'violet' as const,
      },
    ]
  : [
      {
        icon: '01',
        title: 'Ask a few choices',
        body: 'Project or user/global scope, Engineer or Marketing Kit, runtimes, stable or beta channel.',
        accent: 'teal' as const,
      },
      {
        icon: '02',
        title: 'Show the ak command',
        body: 'The helper prints the official ak CLI command before it writes anything.',
        accent: 'cyan' as const,
      },
      {
        icon: '03',
        title: 'Run it for you',
        body: 'It calls the ak CLI you already have. AgentKit still owns Kit verification, ownership, snapshots, and runtime files.',
        accent: 'violet' as const,
      },
    ];

const tuiKeys = isVi
  ? [
      { k: '↑ / ↓', d: 'Di chuyển' },
      { k: 'Space', d: 'Chọn nhiều runtime' },
      { k: 'Enter', d: 'Xác nhận bước này' },
      { k: 'Esc', d: 'Về bước trước' },
    ]
  : [
      { k: '↑ / ↓', d: 'Move' },
      { k: 'Space', d: 'Select multiple runtimes' },
      { k: 'Enter', d: 'Confirm this step' },
      { k: 'Esc', d: 'Back to the previous step' },
    ];

const safety = isVi
  ? [
      {
        title: 'Cài global: không --force trước',
        body: 'Helper chạy lần đầu không có --force. Nếu target đã có hoặc lệch file, TUI hiện WARNING và hỏi riêng — mặc định No. Chỉ retry --force khi bạn chọn Yes.',
      },
      {
        title: 'Update global: chỉ giữ file bạn sửa',
        body: 'File user đã sửa thì bỏ qua. Helper không thêm --force cho global update.',
      },
      {
        title: 'Xem trước trước khi ghi',
        body: 'akh update --dry-run lập kế hoạch, không ghi. --yes chỉ bỏ bước xác nhận của helper — không phải xóa sạch.',
      },
    ]
  : [
      {
        title: 'Global install: no --force first',
        body: 'The helper first runs without --force. If the target exists or files drifted, the TUI shows a WARNING and asks separately — default No. It retries with --force only after Yes.',
      },
      {
        title: 'Global update: preserve-only',
        body: 'User-modified files are skipped. The helper never adds --force on a global update.',
      },
      {
        title: 'Preview before write',
        body: 'akh update --dry-run plans without writing. --yes only skips the helper confirmation — it is not a wipe.',
      },
    ];

const platforms = isVi
  ? [
      { os: 'macOS', detail: 'Đã verify trên máy local' },
      { os: 'Linux', detail: 'Hỗ trợ qua Node.js portable' },
      { os: 'Windows', detail: 'PowerShell experimental — chưa smoke-test máy thật' },
    ]
  : [
      { os: 'macOS', detail: 'Verified on a local machine' },
      { os: 'Linux', detail: 'Supported via the portable Node.js path' },
      { os: 'Windows', detail: 'PowerShell experimental — no real-machine smoke test yet' },
    ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="teal"
    kicker={isVi ? 'AgentKit · Community TUI' : 'AgentKit · Community TUI'}
    title="AgentKit Helper"
    subtitle={isVi
      ? 'TUI cộng đồng: detect CLI ak, hỏi lựa chọn, hiện lệnh chính thức, rồi chạy giúp bạn.'
      : 'Community TUI: detect the ak CLI, ask a few choices, show the official command, then run it.'}
    badges={isVi ? ['không phải CLI ak', 'MIT'] : ['not the ak CLI', 'MIT']}
  />

  <AkCallout variant="info" title={isVi ? 'Đây không phải sản phẩm AgentKit' : 'This is not an AgentKit product'}>
    {isVi ? (
      <>
        AgentKit Helper là tool cộng đồng (MIT) trên{' '}
        <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={repoUrl} target="_blank" rel="noreferrer">
          GitHub
        </a>
        . Nó gọi CLI ak — không thay Desktop App, không thay ownership/uninstall của AgentKit.
        Cần Node.js 20.12+ và CLI ak đã cài.
      </>
    ) : (
      <>
        AgentKit Helper is a community MIT tool on{' '}
        <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={repoUrl} target="_blank" rel="noreferrer">
          GitHub
        </a>
        . It calls the ak CLI — it does not replace the Desktop App or AgentKit ownership/uninstall.
        Requires Node.js 20.12+ and an installed ak CLI.
      </>
    )}
  </AkCallout>

  <AkSection eyebrow={isVi ? 'Bắt đầu' : 'Start'} title={isVi ? 'Chạy TUI' : 'Run the TUI'}>
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="space-y-2">
        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">npx</p>
        <AkCodeBlock title="npx" code={`npx --yes ${npmPkg}`} />
      </div>
      <div class="space-y-2">
        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
          {isVi ? 'Cài global → lệnh ngắn' : 'Global install → short command'}
        </p>
        <AkCodeBlock title="akh" code={`npm install --global ${npmPkg}\nakh`} />
      </div>
    </div>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {tuiKeys.map((item) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 dark:border-slate-700 dark:bg-slate-900/50">
          <code class="rounded-md border border-slate-200/80 bg-slate-100 px-1.5 py-0.5 font-mono text-[0.85em] text-teal-700 dark:border-slate-700 dark:bg-slate-800/90 dark:text-teal-300">
            {item.k}
          </code>
          <p class="mt-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{item.d}</p>
        </div>
      ))}
    </div>
  </AkSection>

  <AkSection eyebrow={isVi ? 'Việc helper làm' : 'What it does'} title={isVi ? 'Bọc CLI ak, không thay CLI ak' : 'Wraps the ak CLI, does not replace it'}>
    <AkFeatureGrid features={roles} columns={3} />
  </AkSection>

  <AkSection eyebrow={isVi ? 'So sánh' : 'Compare'} title={isVi ? 'Helper vs CLI ak vs Desktop' : 'Helper vs ak CLI vs Desktop'}>
    <AkCompare
      left={{
        title: isVi ? 'CLI ak (chính thức)' : 'ak CLI (official)',
        body: isVi
          ? 'Nguồn sự thật: cài Kit, update, ownership, snapshot. Mọi lệnh helper chạy đều là lệnh ak.'
          : 'Source of truth: Kit install, update, ownership, snapshots. Every helper run is an ak command.',
        tone: 'teal',
        points: isVi
          ? ['ak kit init / ak update / ak self-update', 'Giữ file user trừ khi bạn --force']
          : ['ak kit init / ak update / ak self-update', 'Keeps user files unless you --force'],
      }}
      right={{
        title: isVi ? 'Helper (cộng đồng)' : 'Helper (community)',
        body: isVi
          ? 'TUI hỏi lựa chọn rồi gọi ak. Desktop App là GUI chính thức, mua riêng — không phải tool này.'
          : 'TUI asks choices then calls ak. Desktop App is the official GUI, sold separately — not this tool.',
        tone: 'amber',
        points: isVi
          ? ['npx / akh — MIT, không phải sản phẩm AgentKit', 'Desktop: xem trang Desktop App']
          : ['npx / akh — MIT, not an AgentKit product', 'Desktop: see the Desktop App page'],
      }}
    />
    <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
      {isVi ? (
        <>
          Desktop App:{' '}
          <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={translatePath('/guides/agentkit/desktop-app')}>
            hướng dẫn Desktop
          </a>
          . Cập nhật CLI/kit bằng tay:{' '}
          <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={translatePath('/guides/agentkit/updating')}>
            cập nhật AgentKit
          </a>
          .
        </>
      ) : (
        <>
          Desktop App:{' '}
          <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={translatePath('/guides/agentkit/desktop-app')}>
            Desktop guide
          </a>
          . Manual CLI/kit updates:{' '}
          <a class="font-semibold text-teal-800 underline-offset-2 hover:underline dark:text-teal-200" href={translatePath('/guides/agentkit/updating')}>
            Update AgentKit
          </a>
          .
        </>
      )}
    </p>
  </AkSection>

  <AkSection eyebrow={isVi ? 'An toàn' : 'Safety'} title={isVi ? '--force không mặc định' : '--force is not the default'}>
    <AkStepRail steps={safety} accent="amber" />
  </AkSection>

  <AkSection eyebrow={isVi ? 'Nền tảng' : 'Platforms'} title={isVi ? 'macOS / Linux / Windows' : 'macOS / Linux / Windows'}>
    <div class="grid gap-3 sm:grid-cols-3">
      {platforms.map((p) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white/90 px-4 py-4 text-center shadow-sm dark:border-slate-700 dark:bg-slate-950 dark:shadow-none">
          <div class="text-sm font-bold text-slate-900 dark:text-white">{p.os}</div>
          <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">{p.detail}</div>
        </div>
      ))}
    </div>
  </AkSection>

  <AkSection eyebrow={isVi ? 'CLI' : 'CLI'} title={isVi ? 'Lệnh nâng cao' : 'Advanced commands'}>
    <AkCodeBlock
      title="akh"
      code={isVi
        ? `# Cài vào project
akh install --project /path/to/project --kit engineer \\
  --runtime codex --channel stable

# Cài user/global của runtime
akh install --global --kit engineer \\
  --runtime codex,omp,pi --channel stable

# Cập nhật Kit, mọi install đã biết, hoặc chỉ binary ak
akh update --project /path/to/project
akh update-all --channel stable
akh self-update --channel stable

# Xem trước, không ghi
akh update --project /path/to/project --dry-run`
        : `# Install into a project
akh install --project /path/to/project --kit engineer \\
  --runtime codex --channel stable

# Install into runtime user/global scope
akh install --global --kit engineer \\
  --runtime codex,omp,pi --channel stable

# Update Kit installs, every known install, or only the ak binary
akh update --project /path/to/project
akh update-all --channel stable
akh self-update --channel stable

# Preview without writing
akh update --project /path/to/project --dry-run`}
    />
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {isVi ? (
        <>
          Cài: <AkInlineCode text="claude-code" />, <AkInlineCode text="codex" />, <AkInlineCode text="cursor" />,{' '}
          <AkInlineCode text="dsh" />, <AkInlineCode text="grok" />, <AkInlineCode text="omp" />, <AkInlineCode text="pi" />.
          Cập nhật: cùng list trừ <AkInlineCode text="dsh" /> (không hỗ trợ). Export: <AkInlineCode text="agy" />,{' '}
          <AkInlineCode text="portable" />. Chạy <AkInlineCode text="akh --help" /> cho đủ flag.
        </>
      ) : (
        <>
          Install: <AkInlineCode text="claude-code" />, <AkInlineCode text="codex" />, <AkInlineCode text="cursor" />,{' '}
          <AkInlineCode text="dsh" />, <AkInlineCode text="grok" />, <AkInlineCode text="omp" />, <AkInlineCode text="pi" />.
          Update: same list except <AkInlineCode text="dsh" /> (unsupported). Export: <AkInlineCode text="agy" />,{' '}
          <AkInlineCode text="portable" />. Run <AkInlineCode text="akh --help" /> for every flag.
        </>
      )}
    </p>
  </AkSection>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Liên quan' : 'Related'}
    links={[
      { href: '/guides/agentkit/getting-started', label: isVi ? 'Cài CLI ak' : 'Install the ak CLI' },
      { href: '/guides/agentkit/updating', label: isVi ? 'Cập nhật CLI & Kits' : 'Update CLI & Kits' },
      { href: '/guides/agentkit/runtime-support', label: isVi ? 'Runtime' : 'Runtime support' },
      { href: '/guides/agentkit/desktop-app', label: isVi ? 'Desktop App' : 'Desktop App' },
    ]}
  />
</div>
