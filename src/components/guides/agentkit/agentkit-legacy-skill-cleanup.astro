---
import { AlertTriangle, ExternalLink, Search, ShieldCheck } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import {
  AGENTKIT_CK_EXECUTABLE_DETECTORS,
  AGENTKIT_CK_OWNERSHIP_PROBES,
  AGENTKIT_CK_REMOVAL_POLICIES,
  AGENTKIT_SUPPORT_CONTACTS,
} from '@/data/guides/agentkit/agentkit-lifecycle-policy';
import { sanitizeAgentKitLifecycleReport } from '@/data/guides/agentkit/agentkit-report-sanitizer.mjs';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
  includeStage7Details: boolean;
}

const { lang, includeStage7Details } = Astro.props;
const t = useTranslations(lang);
const sanitizedBundleExample = sanitizeAgentKitLifecycleReport({
  category: 'repository-context',
  stage: 'preflight',
  tool: { name: 'agentkit-truth-audit', version: '1.0.0' },
  channel: 'stable',
  detectorCategory: 'unknown',
  lifecycleStage: 'remove-ck-control-plane',
  expectedCode: 'reviewed-truth-contract',
  actualCode: 'diagnostic-redacted',
  incidentId: 'AK-REMOVAL-001',
});
const codeClass = 'block max-w-full overflow-x-auto rounded-xl bg-slate-100 p-4 font-mono text-sm text-purple-600 dark:bg-slate-800/90 dark:text-purple-400';
---

<section id="legacy-skill-cleanup" aria-labelledby="legacy-skill-cleanup-heading" class="pt-16">
  <div class="max-w-3xl">
    <p class="text-sm font-bold uppercase tracking-[0.12em] text-rose-700 dark:text-rose-300">{t('agentkit.cleanup.eyebrow')}</p>
    <h2 id="legacy-skill-cleanup-heading" class="mt-2 font-heading text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
      {t('agentkit.cleanup.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300" set:html={renderInlineCode(t('agentkit.cleanup.intro'))}></p>
  </div>

  <div role="note" class="mt-6 flex max-w-4xl gap-3 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100">
    <AlertTriangle class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
    <div>
      <p class="font-bold">{t('agentkit.cleanup.boundary.title')}</p>
      <p class="mt-1 text-sm leading-relaxed" set:html={renderInlineCode(t('agentkit.cleanup.boundary.body'))}></p>
    </div>
  </div>

  <section aria-labelledby="agentkit-detector-heading" class="mt-8 max-w-4xl rounded-2xl border border-slate-200 p-5 dark:border-slate-700">
    <div class="flex items-center gap-3">
      <Search class="h-5 w-5 text-purple-600 dark:text-purple-400" aria-hidden="true" />
      <h3 id="agentkit-detector-heading" class="font-bold text-slate-950 dark:text-slate-50">{t('agentkit.cleanup.detect.title')}</h3>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.cleanup.detect.body')}</p>
    <div class="mt-4 grid gap-3">
      {AGENTKIT_CK_EXECUTABLE_DETECTORS.map((detector) => (
        <article class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-500 dark:text-slate-400">{detector.platform} · {detector.shell}</p>
          <code class={`${codeClass} mt-2`}>{detector.command}</code>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{t('agentkit.cleanup.detect.classification')}</p>
        </article>
      ))}
    </div>
  </section>

  <section aria-labelledby="agentkit-ownership-heading" class="mt-6 max-w-4xl rounded-2xl border border-slate-200 p-5 dark:border-slate-700">
    <h3 id="agentkit-ownership-heading" class="font-bold text-slate-950 dark:text-slate-50">{t('agentkit.cleanup.ownership.title')}</h3>
    <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.cleanup.ownership.body')}</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {AGENTKIT_CK_OWNERSHIP_PROBES.map((probe) => (
        <article class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700" data-agentkit-ownership-probe={probe.packageManager}>
          <h4 class="font-bold text-slate-950 dark:text-slate-50">{probe.packageManager}</h4>
          {probe.commands.map(({ command }) => <code class={`${codeClass} mt-3`}>{command}</code>)}
          <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">{t(`agentkit.cleanup.ownership.${probe.packageManager}.evidence`)}</p>
          <p class="mt-2 text-xs font-bold text-rose-700 dark:text-rose-300">{t('agentkit.cleanup.ownership.fallback')}</p>
          <a href={probe.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-purple-700 hover:underline focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 dark:text-purple-300">
            {t('agentkit.links.official')} <ExternalLink class="h-4 w-4" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>

  {!includeStage7Details ? (
    <div class="mt-8 max-w-4xl rounded-2xl border border-rose-300 bg-rose-50 p-6 text-rose-950 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-100" data-agentkit-stage-seven-unavailable role="status">
      <p class="font-bold">{t('agentkit.cleanup.unavailable.title')}</p>
      <p class="mt-2 text-sm leading-relaxed">{t('agentkit.cleanup.unavailable.body')}</p>
    </div>
  ) : (
    <div class="mt-8 grid max-w-4xl gap-6" data-agentkit-stage-seven-details>
      <section aria-labelledby="agentkit-removal-heading" class="rounded-2xl border border-slate-200 p-5 dark:border-slate-700" data-agentkit-removal-details hidden>
        <div class="flex items-center gap-3">
          <ShieldCheck class="h-5 w-5 text-purple-600 dark:text-purple-400" aria-hidden="true" />
          <h3 id="agentkit-removal-heading" class="font-bold text-slate-950 dark:text-slate-50">{t('agentkit.cleanup.verify.title')}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.cleanup.verify.body')}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {AGENTKIT_CK_REMOVAL_POLICIES.map((policy) => (
            <article class="min-w-0 rounded-xl border border-slate-200 p-4 dark:border-slate-700" data-agentkit-removal-policy={policy.packageManager} hidden>
              <h4 class="font-bold text-slate-950 dark:text-slate-50">{policy.packageManager}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300" set:html={renderInlineCode(t(`agentkit.cleanup.manager.${policy.packageManager}.evidence`))}></p>
              {policy.command ? (
                <code class={`${codeClass} mt-3`}>{policy.command}</code>
              ) : policy.packageManager === 'unknown' && policy.action === 'sanitize-and-escalate' ? (
                <p class="mt-3 rounded-lg bg-rose-100 p-3 text-sm font-bold text-rose-900 dark:bg-rose-950/50 dark:text-rose-100">{t('agentkit.cleanup.manager.unknown.action')}</p>
              ) : null}
              {policy.sourceUrl && (
                <a href={policy.sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-purple-700 hover:underline focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 dark:text-purple-300">
                  {t('agentkit.links.official')} <ExternalLink class="h-4 w-4" aria-hidden="true" />
                </a>
              )}
            </article>
          ))}
        </div>
        <div class="mt-5 rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-900 dark:border-rose-900 dark:bg-rose-950/20 dark:text-rose-100">
          <p class="font-bold">{t('agentkit.cleanup.preview.title')}</p>
          <p class="mt-1">{t('agentkit.cleanup.preview.body')}</p>
          <p class="mt-3 font-semibold">{t('agentkit.cleanup.remove.manual')}</p>
        </div>
        <div class="mt-5 rounded-xl border border-slate-200 p-4 text-sm text-slate-700 dark:border-slate-700 dark:text-slate-300">
          <p class="font-bold text-slate-950 dark:text-slate-50">{t('agentkit.cleanup.remove.title')}</p>
          <p class="mt-1" set:html={renderInlineCode(t('agentkit.cleanup.remove.body'))}></p>
        </div>
      </section>
    </div>
  )}

  <section aria-labelledby="agentkit-support-heading" class="mt-8 max-w-4xl rounded-2xl border border-sky-200 bg-sky-50/70 p-6 dark:border-sky-900 dark:bg-sky-950/20">
    <h3 id="agentkit-support-heading" class="font-bold text-sky-950 dark:text-sky-100">{t('agentkit.cleanup.support.heading')}</h3>
    <p class="mt-2 text-sm leading-relaxed text-sky-900 dark:text-sky-200">{t('agentkit.cleanup.support.body')}</p>
    <p class="mt-5 text-sm font-bold text-sky-950 dark:text-sky-100">{t('agentkit.cleanup.support.bundle')}</p>
    <pre class="mt-2 max-w-full overflow-x-auto rounded-xl bg-slate-100 p-4 text-sm text-slate-700 dark:bg-slate-800/90 dark:text-slate-200"><code class="text-purple-600 dark:text-purple-400">{JSON.stringify(sanitizedBundleExample, null, 2)}</code></pre>
    <div class="mt-5 flex flex-wrap gap-4">
      {AGENTKIT_SUPPORT_CONTACTS.map((contact) => (
        <a href={contact.url} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-lg px-1 text-sm font-semibold text-purple-700 hover:underline focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 dark:text-purple-300">
          {t(`agentkit.cleanup.support.${contact.id}`)} <ExternalLink class="h-4 w-4" aria-hidden="true" />
        </a>
      ))}
    </div>
  </section>
</section>
