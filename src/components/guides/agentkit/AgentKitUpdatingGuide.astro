---
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkCodeBlock from './AkCodeBlock.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';
import AkCompare from './AkCompare.astro';
import AkStepRail from './AkStepRail.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const translatePath = useTranslatedPath(currentLang);

const matrix = isVi
  ? [
      {
        cmd: 'ak self-update',
        updates: 'CLI ak (và Desktop nếu bạn bật)',
        not: 'Không làm mới skill/hook trong project',
        when: 'Chỉ muốn CLI ak mới hơn',
      },
      {
        cmd: 'ak update',
        updates: 'Hỏi từng bước: CLI ak → kit trên máy → kit project',
        not: 'Bỏ qua bước nào thì không đụng phần đó',
        when: 'Sau bản release: muốn làm mới theo hướng dẫn từng bước',
      },
      {
        cmd: 'ak update --global',
        updates: 'Chỉ kit cài sẵn trên máy (mọi runtime, hoặc lọc --target)',
        not: 'Không đụng file trong project',
        when: 'Làm mới kit “toàn máy”, không mở repo',
      },
      {
        cmd: 'ak update [project-dir]',
        updates: 'Chỉ file do AgentKit cài trong project đó',
        not: 'Không làm mới kit global trên máy',
        when: 'Cập nhật kit trong một repo',
      },
      {
        cmd: 'ak update --kits <name>',
        updates: 'Chỉ kit tên đó (trong project, hoặc kèm --global)',
        not: 'Không đụng kit khác',
        when: 'Chỉ engineer / marketing / …',
      },
      {
        cmd: 'ak kit refresh <kit>',
        updates: 'Ép làm mới lại một kit đã cài; gỡ file generate cũ thừa',
        not: 'Không hỏi 3 bước như ak update; không nâng CLI ak',
        when: 'Một kit lệch / cần force refresh',
      },
    ]
  : [
      {
        cmd: 'ak self-update',
        updates: 'The ak CLI (and Desktop if you opt in)',
        not: 'Does not refresh skills/hooks in projects',
        when: 'You only want a newer ak CLI',
      },
      {
        cmd: 'ak update',
        updates: 'Walks through: ak CLI → machine kits → project kits',
        not: 'Skips any step you decline',
        when: 'After a release: refresh guided step by step',
      },
      {
        cmd: 'ak update --global',
        updates: 'Only kits installed machine-wide (or filter with --target)',
        not: 'Does not touch project folders',
        when: 'Refresh machine kits without opening a repo',
      },
      {
        cmd: 'ak update [project-dir]',
        updates: 'Only AgentKit-installed files in that project',
        not: 'Does not refresh machine-wide kits',
        when: 'Update kits inside one repo',
      },
      {
        cmd: 'ak update --kits <name>',
        updates: 'Only that kit name (in the project, or with --global)',
        not: 'Does not touch other kits',
        when: 'Only engineer / marketing / …',
      },
      {
        cmd: 'ak kit refresh <kit>',
        updates: 'Force re-apply one installed kit; drop leftover generated files',
        not: 'Not the multi-step ak update walkthrough; not a CLI upgrade',
        when: 'One kit is out of date or needs a hard refresh',
      },
    ];

const wizardSteps = isVi
  ? [
      {
        title: '1. CLI ak',
        body: 'Hỏi có nâng cấp CLI ak không. Mặc định là No; gõ Yes hoặc dùng --yes để đồng ý cả wizard.',
      },
      {
        title: '2. Kit trên máy (global)',
        body: 'Làm mới kit cài sẵn cho user/máy. File bạn đã sửa tay thường được giữ.',
      },
      {
        title: '3. Kit trong project',
        body: 'Làm mới kit trong thư mục project hiện tại. File AgentKit “còn nguyên” được cập nhật; file bạn đã sửa thì bỏ qua trừ khi thêm --force.',
      },
    ]
  : [
      {
        title: '1. The ak CLI',
        body: 'Asks whether to upgrade the ak CLI. Default is No; answer Yes or use --yes to accept the whole wizard.',
      },
      {
        title: '2. Kits on this machine (global)',
        body: 'Refreshes kits installed for your user/machine. Files you edited by hand are usually kept.',
      },
      {
        title: '3. Kits in the project',
        body: 'Refreshes kits in the current project folder. Untouched AgentKit files update; files you changed are skipped unless you add --force.',
      },
    ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="violet"
    kicker={isVi ? 'AgentKit · CLI & Kits' : 'AgentKit · CLI & Kits'}
    title={isVi ? 'Cập Nhật CLI ak & Kits' : 'Update AgentKit CLI & Kits'}
    subtitle={isVi
      ? 'Phân biệt lệnh AgentKit: chỉ nâng CLI ak, làm mới Kit, hoặc nhắm đúng một kit.'
      : 'Know which AgentKit command upgrades the ak CLI, refreshes Kits, or targets a single kit.'}
    badges={isVi ? ['self-update ≠ update'] : ['self-update ≠ update']}
  />

  <AkCallout variant="tip" title={isVi ? 'Tóm tắt nhanh' : 'Quick summary'}>
    <ul class="space-y-2">
      <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
        <AkInlineCode text="ak self-update" />
        <span>{isVi ? '= cập nhật CLI ak.' : '= update the ak CLI.'}</span>
      </li>
      <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
        <AkInlineCode text="ak update" />
        <span>
          {isVi
            ? '= làm mới kit (có thể hỏi nâng CLI ak trước).'
            : '= refresh kits (may ask to upgrade the ak CLI first).'}
        </span>
      </li>
      <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-1">
        <AkInlineCode text="ak kit refresh <kit>" />
        <span>{isVi ? '= ép làm mới đúng một kit.' : '= force-refresh exactly one kit.'}</span>
      </li>
    </ul>
  </AkCallout>

  <AkSection
    eyebrow={isVi ? 'So sánh' : 'Compare'}
    title={isVi ? 'Lệnh nào làm gì?' : 'Which command does what?'}
  >
    <div class="overflow-x-auto rounded-2xl border border-slate-200/80 dark:border-slate-700">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-100 text-slate-700 dark:bg-slate-900 dark:text-slate-200">
          <tr>
            <th class="px-3 py-2.5 font-semibold">{isVi ? 'Lệnh' : 'Command'}</th>
            <th class="px-3 py-2.5 font-semibold">{isVi ? 'Cập nhật gì' : 'Updates'}</th>
            <th class="px-3 py-2.5 font-semibold">{isVi ? 'Không làm gì' : 'Does not'}</th>
            <th class="px-3 py-2.5 font-semibold">{isVi ? 'Khi nào dùng' : 'When'}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-700 dark:bg-slate-900/50">
          {matrix.map((row) => (
            <tr class="align-top">
              <td class="px-3 py-3 font-mono text-xs text-violet-700 dark:text-violet-300 whitespace-nowrap">{row.cmd}</td>
              <td class="px-3 py-3 text-slate-700 dark:text-slate-300">{row.updates}</td>
              <td class="px-3 py-3 text-slate-500 dark:text-slate-400">{row.not}</td>
              <td class="px-3 py-3 text-slate-600 dark:text-slate-400">{row.when}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </AkSection>

  <!-- ========== CLI only ========== -->
  <AkSection
    eyebrow="1 · CLI"
    title={isVi ? 'Chỉ nâng CLI ak: ak self-update' : 'ak CLI only: ak self-update'}
    desc={isVi
      ? 'Dùng khi bạn chỉ muốn CLI ak mới hơn (hoặc stage Desktop). Không làm mới skills/hooks trong project.'
      : 'Use when you only want a newer ak CLI (or staged Desktop). Does not refresh skills/hooks in projects.'}
  >
    <AkCodeBlock
      title="shell"
      code={`# Check only — no install
ak self-update --check

# Apply signed CLI update
ak self-update --yes

# Beta channel shorthand
ak self-update --beta --yes

# Require matching CLI + Desktop artifacts for this platform
ak self-update --include-desktop --yes

# Opt in / out Desktop auto-update (writes config.yaml updates.*)
ak self-update --enable-auto-update
ak self-update --disable-auto-update`}
    />
    <AkCallout variant="info">
      {isVi ? (
        <>
          Desktop auto-update là opt-in qua <AkInlineCode text="updates.enabled" /> trong{' '}
          <AkInlineCode text="~/.agentkit/config.yaml" />. Binary do Homebrew/Scoop quản lý sẽ báo lệnh upgrade của package manager thay vì replace in-place.
        </>
      ) : (
        <>
          Desktop auto-update is opt-in via <AkInlineCode text="updates.enabled" /> in{' '}
          <AkInlineCode text="~/.agentkit/config.yaml" />. Package-manager-owned binaries report the manager’s upgrade command instead of in-place replace.
        </>
      )}
    </AkCallout>
  </AkSection>

  <!-- ========== Kits via ak update ========== -->
  <AkSection
    eyebrow="2 · Kits"
    title={isVi ? 'Làm mới nội dung Kit: ak update' : 'Refresh Kit content: ak update'}
    desc={isVi
      ? 'Chỉ sửa file do AgentKit cài (không đụng file bạn tự tạo). Không thêm --yes thì thường chỉ xem trước; thêm --yes mới ghi thật.'
      : 'Only updates files AgentKit installed (not files you created yourself). Without --yes you usually get a preview; add --yes to apply for real.'}
  >
    <AkCompare
      left={{
        title: isVi ? 'Cập nhật theo từng bước (hỏi lần lượt)' : 'Update step by step (asks each time)',
        body: isVi
          ? 'Gõ ak update trong terminal (có màn hình tương tác). CLI hỏi lần lượt: nâng CLI ak → kit trên máy → kit trong project. Mỗi bước bạn Yes/No. Muốn “đồng ý hết” thì thêm --yes.'
          : 'Run bare ak update in an interactive terminal. It walks you through: upgrade the ak CLI → kits on this machine → kits in the current project. You answer Yes/No each step. Add --yes to accept every step.',
        tone: 'teal',
        points: isVi
          ? ['ak update  → hỏi từng bước', 'ak update --yes  → đồng ý tất cả bước']
          : ['ak update  → ask each step', 'ak update --yes  → accept every step'],
      }}
      right={{
        title: isVi ? 'Chỉ một chỗ / một kit (bỏ qua wizard dài)' : 'Only one place / one kit (skip the long wizard)',
        body: isVi
          ? 'Thêm cờ để nói rõ “chỉ chỗ này”, không đi hết 3 bước wizard. --global = kit cài trên máy; đường dẫn project = một repo; --kits = chỉ kit tên đó.'
          : 'Add flags to say “only this scope” so you skip the full three-step wizard. --global = machine-wide kits; a project path = one repo; --kits = only that kit name.',
        tone: 'slate',
        points: isVi
          ? [
              'ak update --global --yes  → chỉ kit trên máy',
              'ak update ./myproj --yes  → chỉ một project',
              'ak update --kits engineer --yes  → chỉ kit engineer',
            ]
          : [
              'ak update --global --yes  → machine kits only',
              'ak update ./myproj --yes  → one project only',
              'ak update --kits engineer --yes  → engineer kit only',
            ],
      }}
    />

    <div class="mt-6 space-y-4">
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">
        {isVi ? 'Ba bước khi gõ ak update (terminal tương tác)' : 'Three steps when you run bare ak update (interactive terminal)'}
      </h3>
      <AkStepRail steps={wizardSteps} accent="violet" />
    </div>

    <div class="mt-6 space-y-3">
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">
        {isVi ? 'Chỉ kits global (toàn máy)' : 'Global kits only (machine-wide)'}
      </h3>
      <AkCodeBlock
        title="shell"
        code={`# Preview user/global kit refreshes
ak update --global

# Apply
ak update --global --yes

# One kit, global
ak update -g --kits engineer --yes

# One or more runtimes only
ak update --global --target codex --yes
ak update --global --target claude-code,codex --yes`}
      />
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {isVi
          ? 'Trên máy (global): file bạn đã sửa tay thường được giữ — --force cũng không tự ghi đè kiểu project. Install Claude Code chỉ dạng user-plugin được báo ra, không tự refresh âm thầm; nếu cần thì dùng ak kit refresh … --global --switch-to-plugin.'
          : 'On the machine (global): files you edited by hand are usually kept — --force does not overwrite them the way it can in a project. Claude Code user-plugin-only installs are reported, not silently refreshed; use ak kit refresh … --global --switch-to-plugin when you need that path.'}
      </p>
    </div>

    <div class="mt-6 space-y-3">
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">
        {isVi ? 'Chỉ kits trong project' : 'Project kits only'}
      </h3>
      <AkCodeBlock
        title="shell"
        code={`# Preview current directory project
ak update ./myproj
# or from inside the project:
ak update

# Preview one kit
ak update --kits engineer

# Apply (required for scripted / non-TTY)
ak update --kits engineer --yes

# Overwrite user-modified AK-owned files too
ak update --kits engineer --force --yes

# Show unified diffs in preview
ak update --show-diff

# Scripted envelope
ak update --kits engineer --yes --json --no-interactive`}
      />
      <AkCallout variant="warn" title={isVi ? 'File còn nguyên vs file bạn đã sửa' : 'Unchanged files vs files you edited'}>
        {isVi
          ? 'File AgentKit vẫn như lúc cài → được cập nhật. File bạn đã sửa tay → bỏ qua, trừ khi thêm --force. Trước khi ghi, CLI chụp một bản snapshot project (để phòng hờ). Snapshot đó không nằm trong ak backups restore — muốn lấy lại thì copy từ thư mục snapshot.'
          : 'Files still as AgentKit installed them → get updated. Files you edited by hand → skipped unless you add --force. Before writing, the CLI takes a project snapshot as a safety net. That snapshot is not restored via ak backups restore — copy files back from the snapshot folder if needed.'}
      </AkCallout>
    </div>

    <div class="mt-6 space-y-3">
      <h3 class="text-base font-semibold text-slate-900 dark:text-white">
        {isVi ? 'Channel / beta' : 'Channel / beta'}
      </h3>
      <AkCodeBlock
        title="shell"
        code={`# shorthand --channel beta
ak update --beta --yes
ak update --channel stable --yes
# --beta conflicts with --channel stable`}
      />
    </div>
  </AkSection>

  <!-- ========== Single kit force ========== -->
  <AkSection
    eyebrow="3 · One kit"
    title={isVi ? 'Chỉ một kit (force re-emit): ak kit refresh' : 'One kit (force re-emit): ak kit refresh'}
    desc={isVi
      ? 'Khác ak update --kits: refresh re-emit kit với force, gỡ agent/rules/hooks/commands generated đã biến mất khỏi source.'
      : 'Unlike ak update --kits alone: refresh re-emits with force and unloads generated files that left the kit source.'}
  >
    <AkCodeBlock
      title="shell"
      code={`# Project-native Claude Code (remote default)
ak kit refresh engineer --yes

# Project plugin delivery
ak kit refresh engineer --switch-to-plugin --yes

# Global paid install
ak kit refresh engineer --global --yes

# Specific runtime
ak kit refresh engineer --target codex --yes

# Local kit source (dev)
ak kit refresh engineer --local --kits-dir ./kits --yes`}
    />
    <p class="text-sm text-slate-600 dark:text-slate-400">
      {isVi
        ? 'Dùng khi audit báo plugin drift, sau khi kit đổi export, hoặc khi cần “viết lại” output của đúng một kit. Snapshot mặc định (trừ --no-backup).'
        : 'Use when audit reports plugin drift, after kit export changes, or when you need to rewrite one kit’s output. Snapshot by default (unless --no-backup).'}
    </p>
  </AkSection>

  <AkSection
    eyebrow={isVi ? 'Thực hành' : 'Practice'}
    title={isVi ? 'Chọn nhanh' : 'Quick pick'}
  >
    <div class="grid gap-3 sm:grid-cols-2">
      {(
        [
          {
            q: isVi ? 'Chỉ muốn CLI ak mới' : 'Only want a newer ak CLI',
            parts: [
              { kind: 'cmd' as const, text: 'ak self-update --check' },
              { kind: 'sep' as const, text: '→' },
              { kind: 'cmd' as const, text: 'ak self-update --yes' },
            ],
          },
          {
            q: isVi ? 'Sau release, làm mới “hết” (CLI + kits)' : 'After release, refresh “everything” (CLI + kits)',
            parts: [
              { kind: 'cmd' as const, text: 'ak update --yes' },
              {
                kind: 'note' as const,
                text: isVi ? '(đồng ý hết các bước hỏi)' : '(accept every step)',
              },
            ],
          },
          {
            q: isVi ? 'Chỉ kits cài global trên máy' : 'Only global kits on this machine',
            parts: [{ kind: 'cmd' as const, text: 'ak update --global --yes' }],
            hint: isVi
              ? 'Không nâng CLI ak — dùng ak self-update nếu cần.'
              : 'Does not upgrade the ak CLI — use ak self-update if you need that.',
          },
          {
            q: isVi ? 'Chỉ repo hiện tại / một kit' : 'Only this repo / one kit',
            parts: [
              { kind: 'cmd' as const, text: 'ak update --kits engineer --yes' },
              { kind: 'or' as const, text: isVi ? 'hoặc' : 'or' },
              { kind: 'cmd' as const, text: 'ak kit refresh engineer --yes' },
            ],
          },
        ] as const
      ).map((item) => (
        <div class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/50">
          <div class="text-sm font-semibold text-slate-900 dark:text-white">{item.q}</div>
          <p class="mt-2 flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-xs leading-relaxed">
            {item.parts.map((part) =>
              part.kind === 'cmd' ? (
                <code class="rounded-md border border-slate-200/80 bg-slate-100 px-1.5 py-0.5 font-mono text-[0.85em] text-teal-700 dark:border-slate-700 dark:bg-slate-800/90 dark:text-teal-300">
                  {part.text}
                </code>
              ) : part.kind === 'or' ? (
                <span class="font-sans text-[11px] font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">
                  {part.text}
                </span>
              ) : part.kind === 'note' ? (
                <span class="font-sans text-[11px] text-slate-500 dark:text-slate-400">{part.text}</span>
              ) : (
                <span class="font-sans text-slate-400 dark:text-slate-500" aria-hidden="true">
                  {part.text}
                </span>
              ),
            )}
          </p>
          {'hint' in item && item.hint ? (
            <p class="mt-2 text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">{item.hint}</p>
          ) : null}
        </div>
      ))}
    </div>
  </AkSection>

  <AkCallout variant="info" title={isVi ? 'Mã thoát (ak update)' : 'Exit codes (ak update)'}>
    {isVi
      ? '0 = xong ổn · 1 = lỗi khi chạy / một phần fail · 2 = flag sai · 3 = chỉ xem trước (chưa --yes / chưa confirm) — an toàn, chưa ghi file.'
      : '0 = ok · 1 = runtime error / partial failure · 2 = invalid flags · 3 = preview only (no --yes / no confirm) — safe, no files written.'}
  </AkCallout>

  <AkCallout variant="warn" title={isVi ? 'Cập nhật ≠ cài lại clean' : 'Update ≠ clean reinstall'}>
    {isVi ? (
      <>
        <AkInlineCode text="ak update" /> / <AkInlineCode text="ak self-update" /> làm mới kit hoặc CLI — không thay quy trình gỡ kit ownership-aware rồi reset state.
        Muốn gỡ sạch và cài lại stable (kèm known issue snapshot 2.7.0): xem{' '}
        <a
          class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
          href={translatePath('/guides/agentkit/clean-reinstall')}
        >
          Cài lại clean AgentKit
        </a>
        .
      </>
    ) : (
      <>
        <AkInlineCode text="ak update" /> / <AkInlineCode text="ak self-update" /> refresh kits or the CLI — they do not replace an ownership-aware kit uninstall plus state reset.
        For clean reinstall of stable (including the 2.7.0 uninstall snapshot known issue), see{' '}
        <a
          class="font-semibold text-amber-900 underline-offset-2 hover:underline dark:text-amber-100"
          href={translatePath('/guides/agentkit/clean-reinstall')}
        >
          Clean reinstall of AgentKit
        </a>
        .
      </>
    )}
  </AkCallout>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Liên quan' : 'Related'}
    links={[
      { href: '/guides/agentkit/configuration', label: isVi ? 'config.yaml (updates.*)' : 'config.yaml (updates.*)' },
      { href: '/guides/agentkit/clean-reinstall', label: isVi ? 'Cài lại clean' : 'Clean reinstall' },
      { href: '/guides/agentkit/troubleshooting', label: isVi ? 'Xử lý sự cố' : 'Troubleshooting' },
      { href: '/guides/agentkit/getting-started', label: isVi ? 'Cài đặt' : 'Getting started' },
    ]}
  />
</div>
