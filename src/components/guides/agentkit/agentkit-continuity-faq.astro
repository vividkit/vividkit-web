---
import { CircleHelp, KeyRound, Layers2, MonitorSmartphone, RefreshCw } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { inlineCodeClass, renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'vi' ? '/vi' : '';

const items = [
  {
    id: 'desktop-optional',
    icon: MonitorSmartphone,
    title: t('agentkit.continuity.desktop.title'),
    body: t('agentkit.continuity.desktop.body'),
  },
  {
    id: 'successor',
    icon: RefreshCw,
    title: t('agentkit.continuity.successor.title'),
    body: t('agentkit.continuity.successor.body'),
  },
  {
    id: 'two-kits',
    icon: Layers2,
    title: t('agentkit.continuity.kits.title'),
    body: t('agentkit.continuity.kits.body'),
  },
  {
    id: 'entitlements',
    icon: KeyRound,
    title: t('agentkit.continuity.entitlements.title'),
    body: t('agentkit.continuity.entitlements.body'),
    code: 'ak whoami && ak licenses',
  },
  {
    id: 'license-boundary',
    icon: CircleHelp,
    title: t('agentkit.continuity.boundary.title'),
    body: t('agentkit.continuity.boundary.body'),
  },
] as const;
---

<section id="continuity" aria-labelledby="continuity-heading" class="scroll-mt-28 pt-12">
  <div class="overflow-hidden rounded-3xl border border-emerald-200 bg-emerald-50/50 dark:border-emerald-800/60 dark:bg-emerald-950/20">
    <div class="border-b border-emerald-200/80 p-6 dark:border-emerald-800/60 md:p-8">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">
        {t('agentkit.continuity.eyebrow')}
      </p>
      <h2 id="continuity-heading" class="mt-3 font-heading text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
        {t('agentkit.continuity.heading')}
      </h2>
      <p class="mt-3 max-w-3xl text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
        {t('agentkit.continuity.intro')}
      </p>
    </div>

    <div class="divide-y divide-emerald-200/80 dark:divide-emerald-800/60">
      {items.map((item, index) => {
        const Icon = item.icon;
        return (
          <details class="group px-6 md:px-8" open={index === 0}>
            <summary class="flex min-h-14 cursor-pointer list-none items-center gap-3 py-4 font-semibold text-slate-900 transition-colors duration-200 hover:text-emerald-800 focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 active:text-emerald-700 dark:text-slate-100 dark:hover:text-emerald-200">
              <Icon class="h-5 w-5 shrink-0 text-emerald-700 dark:text-emerald-300" aria-hidden="true" />
              <span>{item.title}</span>
              <span class="ml-auto text-xl font-normal text-slate-400 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <div class="pb-5 pl-8 pr-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
              <p set:html={renderInlineCode(item.body)} ></p>
              {'code' in item && item.code && (
                <code class={`${inlineCodeClass} mt-3 inline-flex max-w-full overflow-x-auto`}>{item.code}</code>
              )}
            </div>
          </details>
        );
      })}
    </div>

    <div class="flex flex-col gap-4 border-t border-emerald-200/80 p-6 dark:border-emerald-800/60 md:px-8">
      <p class="max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.continuity.next')}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href="#step-03-inventory"
          class="inline-flex h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-lg bg-emerald-700 px-5 text-sm font-semibold text-white transition-colors hover:bg-emerald-800 focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 dark:bg-emerald-500 dark:text-slate-950 dark:hover:bg-emerald-400"
        >
          {t('agentkit.continuity.migrateCta')}
        </a>
        <a
          href={`${prefix}/guides/cli`}
          class="inline-flex h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-lg border border-slate-300 bg-white px-5 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-100 focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800"
        >
          {t('agentkit.continuity.cliCta')}
        </a>
      </div>
    </div>
  </div>
</section>
