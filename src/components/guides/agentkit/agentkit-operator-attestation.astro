---
import { Clock3, ShieldAlert } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const inputClass = 'mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-base text-slate-900 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 md:text-sm';
---

<section id="operator-declaration" aria-labelledby="operator-declaration-heading" class="scroll-mt-28 pt-12" data-agentkit-attestation-section hidden>
  <div class="max-w-3xl">
    <div class="flex items-center gap-3">
      <Clock3 class="h-6 w-6 text-purple-600 dark:text-purple-400" aria-hidden="true" />
      <h2 id="operator-declaration-heading" class="font-heading text-2xl font-bold text-slate-950 dark:text-slate-50">
        {t('agentkit.attestation.heading')}
      </h2>
    </div>
    <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.attestation.intro')}</p>
  </div>

  <form class="mt-6 grid max-w-4xl gap-5 rounded-2xl border border-slate-200 bg-slate-50/70 p-5 dark:border-slate-700 dark:bg-slate-900/50 md:grid-cols-2" data-agentkit-attestation-form autocomplete="off">
    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200">
      {t('agentkit.attestation.canary')}
      <select class={inputClass} name="canaryResult" required>
        <option value="">{t('agentkit.attestation.canary.placeholder')}</option>
        <option value="pass">{t('agentkit.attestation.canary.pass')}</option>
        <option value="fail">{t('agentkit.attestation.canary.fail')}</option>
      </select>
    </label>

    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200">
      {t('agentkit.attestation.incident')}
      <select class={inputClass} name="incidentStatus" required>
        <option value="">{t('agentkit.attestation.canary.placeholder')}</option>
        <option value="none">{t('agentkit.attestation.incident.none')}</option>
        <option value="acknowledged">{t('agentkit.attestation.incident.acknowledged')}</option>
        <option value="unacknowledged">{t('agentkit.attestation.incident.unacknowledged')}</option>
      </select>
    </label>

    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200">
      {t('agentkit.attestation.started')}
      <input class={inputClass} type="datetime-local" name="startedAt" required />
    </label>

    <label class="text-sm font-semibold text-slate-800 dark:text-slate-200">
      {t('agentkit.attestation.ended')}
      <input class={inputClass} type="datetime-local" name="endedAt" required />
    </label>

    <label class="flex min-h-11 items-start gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4 text-sm font-semibold text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100 md:col-span-2">
      <input type="checkbox" name="acknowledgedAdvisoryOnly" required class="mt-0.5 h-4 w-4 shrink-0" />
      {t('agentkit.attestation.acknowledge')}
    </label>

    <div class="md:col-span-2">
      <button type="submit" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-purple-700 px-5 py-2 text-sm font-bold text-white hover:bg-purple-800 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 active:bg-purple-900 dark:bg-purple-600 dark:hover:bg-purple-500">
        {t('agentkit.attestation.submit')}
      </button>
    </div>
  </form>

  <div
    class="mt-5 flex max-w-4xl gap-3 rounded-xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100"
    role="status"
    aria-live="polite"
    data-agentkit-attestation-result
    data-agentkit-eligibility="blocked"
    data-agentkit-limitation="unverified-operator-declaration"
    data-message-blocked={t('agentkit.attestation.blocked')}
    data-message-ready={t('agentkit.attestation.ready')}
    tabindex="-1"
  >
    <ShieldAlert class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
    <p data-agentkit-attestation-message>{t('agentkit.attestation.blocked')}</p>
  </div>
</section>
