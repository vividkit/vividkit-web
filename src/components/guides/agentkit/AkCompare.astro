---
interface Side {
  title: string;
  body: string;
  points?: string[];
  tone?: 'teal' | 'slate' | 'amber';
}

interface Props {
  left: Side;
  right: Side;
}

const { left, right } = Astro.props;

const toneBox = {
  teal: 'border-teal-200/80 bg-gradient-to-br from-teal-50/80 to-white dark:border-teal-500/25 dark:from-teal-950/40 dark:to-slate-900',
  slate: 'border-slate-200/80 bg-white/80 dark:border-slate-700 dark:bg-slate-900/50',
  amber: 'border-amber-200/80 bg-gradient-to-br from-amber-50/80 to-white dark:border-amber-500/25 dark:from-amber-950/30 dark:to-slate-900',
};

const toneTitle = {
  teal: 'text-teal-800 dark:text-teal-200',
  slate: 'text-slate-900 dark:text-white',
  amber: 'text-amber-900 dark:text-amber-200',
};
---

<div class="grid gap-4 md:grid-cols-2">
  {[left, right].map((side) => {
    const tone = side.tone || 'slate';
    return (
      <div class:list={['rounded-2xl border p-5', toneBox[tone]]}>
        <h3 class:list={['text-base font-bold', toneTitle[tone]]}>{side.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400" set:html={side.body} />
        {side.points && side.points.length > 0 && (
          <ul class="mt-3 space-y-2">
            {side.points.map((p) => (
              <li class="flex gap-2 text-sm text-slate-700 dark:text-slate-300">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-500"></span>
                <span set:html={p} />
              </li>
            ))}
          </ul>
        )}
      </div>
    );
  })}
</div>
