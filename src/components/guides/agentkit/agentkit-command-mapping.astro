---
import { ArrowRight } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import type { MigrationMappingRow } from '@/data/guides/agentkit/agentkit-migration-mapping';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
  rows: readonly MigrationMappingRow[];
}

const { lang, rows } = Astro.props;
const t = useTranslations(lang);
const binaryRows = rows.filter((row) => row.category !== 'slash-skill');
const skillRows = rows.filter((row) => row.category === 'slash-skill');

const inlineCodeClass = 'inline-flex rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-sm text-slate-800 dark:border-slate-700 dark:bg-slate-800/90 dark:text-slate-100';
---

<section id="command-mapping" aria-labelledby="command-mapping-heading" class="scroll-mt-28 pt-16">
  <div class="max-w-3xl">
    <h2 id="command-mapping-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-slate-50">
      {t('agentkit.mapping.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('agentkit.mapping.intro')}
    </p>
  </div>

  <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.45fr)_minmax(18rem,0.55fr)]">
    <div class="min-w-0">
      <h3 class="mb-3 text-lg font-bold text-slate-950 dark:text-slate-50">{t('agentkit.mapping.binary')}</h3>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full min-w-[34rem] border-collapse text-left">
          <caption class="sr-only">{t('agentkit.mapping.binary')}</caption>
          <thead class="bg-slate-100 text-xs uppercase tracking-[0.08em] text-slate-600 dark:bg-slate-800/90 dark:text-slate-300">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold">{t('agentkit.mapping.legacy')}</th>
              <th class="w-12 px-2 py-3" aria-hidden="true"></th>
              <th scope="col" class="px-4 py-3 font-semibold">{t('agentkit.mapping.current')}</th>
              <th scope="col" class="px-4 py-3 font-semibold">{t('agentkit.mapping.status')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950/40">
            {binaryRows.map((row) => (
              <tr>
                <td class="px-4 py-3"><code class={inlineCodeClass}>{row.legacy}</code></td>
                <td class="px-2 py-3 text-slate-400"><ArrowRight class="h-4 w-4" aria-hidden="true" /></td>
                <td class="px-4 py-3"><code class={inlineCodeClass}>{row.agentkit}</code></td>
                <td class="px-4 py-3 text-sm font-semibold text-emerald-700 dark:text-emerald-300">
                  <span set:html={renderInlineCode(t(row.status === 'new-capability' ? 'agentkit.mapping.new' : 'agentkit.mapping.replaced'))} ></span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="min-w-0">
      <h3 class="mb-3 text-lg font-bold text-slate-950 dark:text-slate-50">{t('agentkit.mapping.skills')}</h3>
      <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white dark:divide-slate-800 dark:border-slate-700 dark:bg-slate-950/40">
        {skillRows.map((row) => (
          <div class="grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-3 p-4">
            <code class={`${inlineCodeClass} min-w-0 overflow-x-auto`}>{row.legacy}</code>
            <ArrowRight class="h-4 w-4 shrink-0 text-slate-400" aria-hidden="true" />
            <code class={`${inlineCodeClass} min-w-0 overflow-x-auto text-purple-600 dark:text-purple-400`}>{row.agentkit}</code>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
