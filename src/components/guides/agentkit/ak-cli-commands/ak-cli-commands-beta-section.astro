---
import type { Language } from '@/i18n';
import { akCliBetaCommands } from '@/data/guides/agentkit-cli-beta-commands';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const updatingHref = isVi ? '/vi/guides/agentkit/updating' : '/guides/agentkit/updating';
const commandAnchorId = (name: string) =>
  `ak-cli-beta-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

{akCliBetaCommands.length > 0 && (
  <section id="ak-cli-beta" class="scroll-mt-32 overflow-hidden rounded-[1.65rem] border border-purple-200/80 bg-gradient-to-br from-purple-50 to-fuchsia-50 shadow-sm dark:border-purple-400/20 dark:from-purple-950/35 dark:to-fuchsia-950/20">
    <div class="border-b border-slate-200/70 p-5 dark:border-white/10">
      <div class="flex items-center gap-2">
        <span class="rounded-md bg-purple-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-purple-700 dark:bg-purple-500/15 dark:text-purple-300">Beta</span>
        <h2 class="text-xl font-bold tracking-tight text-slate-950 dark:text-white">
          {isVi ? 'Lệnh chỉ có trên bản beta' : 'Beta-only commands'}
        </h2>
      </div>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
        {isVi
          ? 'Các lệnh này chỉ có khi bạn chạy CLI ak bản beta, chưa có trên stable. '
          : 'These commands exist only when you run the beta ak CLI, not yet on stable. '}
        <a href={updatingHref} class="font-medium text-purple-700 underline underline-offset-2 hover:text-purple-900 dark:text-purple-300 dark:hover:text-purple-200">
          {isVi ? 'Cách chuyển sang beta' : 'How to switch to beta'}
        </a>
      </p>
    </div>
    <div class="grid gap-3 p-4 sm:p-5 md:grid-cols-2">
      {akCliBetaCommands.map((cmd) => {
        const copyValue = cmd.example || cmd.name;
        return (
          <article id={commandAnchorId(cmd.name)} class="scroll-mt-32 rounded-2xl border border-slate-200/80 bg-white/80 p-4 shadow-sm dark:border-white/10 dark:bg-slate-950/55">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 space-y-2">
                <code class="inline-flex rounded-xl bg-purple-100 px-3 py-1.5 font-mono text-sm font-bold text-purple-800 dark:bg-purple-400/10 dark:text-purple-200">
                  {cmd.name}
                </code>
                <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">{isVi ? cmd.descriptionVi : cmd.description}</p>
              </div>
              <button type="button" class="ak-copy-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 transition hover:border-purple-300 hover:bg-purple-50 hover:text-purple-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-400 dark:hover:border-purple-400/30 dark:hover:bg-white/[0.08] dark:hover:text-purple-200" data-code={copyValue} title="Copy" aria-label={`Copy ${copyValue}`}>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
              </button>
            </div>
            {cmd.keyFlags && (
              <div class="mt-4 flex flex-wrap gap-1.5">
                {cmd.keyFlags.map((flag) => (
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-[10px] font-medium text-slate-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-400">{flag}</span>
                ))}
              </div>
            )}
            {cmd.example && (
              <div class="mt-4 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 dark:border-white/10 dark:bg-slate-800/90">
                <div class="flex items-start gap-2 font-mono text-xs leading-5 text-slate-700 dark:text-slate-200">
                  <span class="text-purple-600 dark:text-purple-400">$</span>
                  <span class="break-words">{cmd.example}</span>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
)}
