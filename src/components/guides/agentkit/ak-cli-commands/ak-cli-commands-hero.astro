---
import type { Language } from '@/i18n';
import { akCliCommandsCheatsheet } from '@/data/guides/agentkit-cli-cheatsheet';
import AkInlineCode from '../AkInlineCode.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const total = akCliCommandsCheatsheet.length;
const categories = new Set(akCliCommandsCheatsheet.map((c) => c.category)).size;
const heroCommands = [
  'ak login --email you@example.com',
  'ak kit init engineer --yes',
  'ak update --yes',
  'ak doctor --json',
];

const topicCmds = isVi
  ? ['setup', 'kit', 'account', 'inspect', 'config']
  : ['setup', 'kits', 'account', 'inspect', 'config'];
const universalFlags = ['--json', '--yes', '--no-interactive', '--quiet'];
---

<section class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-stone-50 shadow-sm dark:border-white/10 dark:bg-slate-950">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_20%,rgba(20,184,166,0.16),transparent_28%),radial-gradient(circle_at_88%_8%,rgba(139,92,246,0.14),transparent_24%),linear-gradient(135deg,rgba(15,23,42,0.04),transparent_48%)] dark:bg-[radial-gradient(circle_at_18%_20%,rgba(45,212,191,0.16),transparent_28%),radial-gradient(circle_at_88%_8%,rgba(167,139,250,0.12),transparent_24%),linear-gradient(135deg,rgba(15,23,42,0.65),transparent_48%)]"></div>
  <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[1.05fr_0.95fr] lg:p-10">
    <div class="flex min-h-[320px] flex-col justify-between gap-8">
      <div class="space-y-5">
        <div class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-white/70 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.24em] text-teal-700 shadow-sm dark:border-teal-400/20 dark:bg-white/5 dark:text-teal-300">
          <span class="h-2 w-2 rounded-full bg-teal-500"></span>
          {isVi ? 'Bảng điều khiển AK CLI' : 'AK CLI command deck'}
        </div>
        <div class="max-w-2xl space-y-4">
          <h1 class="font-heading text-4xl font-bold tracking-[-0.045em] text-slate-950 sm:text-5xl dark:text-white">
            {isVi ? 'AgentKit CLI Quick Reference' : 'AgentKit CLI Quick Reference'}
          </h1>
          <p class="text-lg leading-8 text-slate-600 dark:text-slate-300">
            {isVi ? 'Danh sách lệnh' : 'List of'}
            {' '}
            <AkInlineCode text="ak" />
            {' '}
            {isVi ? '—' : 'commands —'}
            {' '}
            {topicCmds.map((cmd, i) => (
              <>
                <AkInlineCode text={cmd} />
                {i < topicCmds.length - 1 ? <span class="text-slate-400 dark:text-slate-500">, </span> : null}
              </>
            ))}
            {'. '}
            {isVi ? 'Copy mẫu lệnh; xem flag chính.' : 'Copy examples; scan key flags.'}
          </p>
          <p class="max-w-xl text-sm leading-7 text-slate-500 dark:text-slate-400">
            {isVi ? 'Nguồn:' : 'Source:'}
            {' '}
            <AkInlineCode text="ak --help" />
            {' '}
            (AgentKit CLI). {isVi ? 'Universal flags:' : 'Universal flags:'}
            {' '}
            {universalFlags.map((flag, i) => (
              <>
                <AkInlineCode text={flag} />
                {i < universalFlags.length - 1 ? <span class="text-slate-400 dark:text-slate-500">, </span> : null}
              </>
            ))}
            .
          </p>
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="rounded-2xl border border-slate-200 bg-white/75 p-4 dark:border-white/10 dark:bg-white/[0.04]">
          <div class="font-mono text-3xl font-bold text-slate-950 dark:text-white">{total}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
            {isVi ? 'Lệnh' : 'Commands'}
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/75 p-4 dark:border-white/10 dark:bg-white/[0.04]">
          <div class="font-mono text-3xl font-bold text-slate-950 dark:text-white">{categories}</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
            {isVi ? 'Nhóm' : 'Groups'}
          </div>
        </div>
        <div class="rounded-2xl border border-violet-200 bg-violet-50/80 p-4 dark:border-violet-400/20 dark:bg-violet-400/10">
          <div class="font-mono text-2xl font-bold text-violet-700 dark:text-violet-300">ak</div>
          <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-violet-700/70 dark:text-violet-200/70">CLI</div>
        </div>
      </div>
    </div>
    <div class="rounded-[1.5rem] border border-slate-800 bg-slate-950 p-4 shadow-xl shadow-slate-900/20">
      <div class="mb-3 flex items-center justify-between">
        <div class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-rose-400/90"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-amber-400/90"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/90"></span>
        </div>
        <span class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">quick copy</span>
      </div>
      <div class="space-y-2">
        {heroCommands.map((cmd) => (
          <button
            type="button"
            class="ak-copy-btn group flex w-full items-start gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2.5 text-left font-mono text-xs text-slate-200 transition hover:border-teal-400/40 hover:bg-white/[0.07]"
            data-code={cmd}
          >
            <span class="text-amber-400">$</span>
            <span class="min-w-0 flex-1 break-words text-purple-300">{cmd}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>
