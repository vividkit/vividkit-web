---
import type { Language } from '@/i18n';
import { akCliCommandsCheatsheet, type AkCliCategory } from '@/data/guides/agentkit-cli-cheatsheet';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';

const categoryConfigs: {
  id: AkCliCategory;
  labelEn: string;
  labelVi: string;
  accent: string;
  panel: string;
  text: string;
  chip: string;
  ring: string;
  iconSvg: string;
}[] = [
  {
    id: 'setup',
    labelEn: 'Lifecycle & setup',
    labelVi: 'Lifecycle & setup',
    accent: 'bg-emerald-400',
    panel: 'from-emerald-50 to-teal-50 dark:from-emerald-950/40 dark:to-teal-950/20',
    text: 'text-emerald-700 dark:text-emerald-300',
    chip: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-400/10 dark:text-emerald-200',
    ring: 'border-emerald-200/80 dark:border-emerald-400/20',
    iconSvg: '<path d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
  },
  {
    id: 'kits',
    labelEn: 'Kits, skills & agents',
    labelVi: 'Kits, skills & agents',
    accent: 'bg-fuchsia-400',
    panel: 'from-fuchsia-50 to-rose-50 dark:from-fuchsia-950/30 dark:to-rose-950/20',
    text: 'text-fuchsia-700 dark:text-fuchsia-300',
    chip: 'bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-400/10 dark:text-fuchsia-200',
    ring: 'border-fuchsia-200/80 dark:border-fuchsia-400/20',
    iconSvg: '<circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" /><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />',
  },
  {
    id: 'account',
    labelEn: 'Account',
    labelVi: 'Account',
    accent: 'bg-violet-400',
    panel: 'from-violet-50 to-indigo-50 dark:from-violet-950/35 dark:to-indigo-950/20',
    text: 'text-violet-700 dark:text-violet-300',
    chip: 'bg-violet-100 text-violet-800 dark:bg-violet-400/10 dark:text-violet-200',
    ring: 'border-violet-200/80 dark:border-violet-400/20',
    iconSvg: '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />',
  },
  {
    id: 'inspect',
    labelEn: 'Inspect & diagnose',
    labelVi: 'Inspect & diagnose',
    accent: 'bg-sky-400',
    panel: 'from-sky-50 to-blue-50 dark:from-sky-950/40 dark:to-blue-950/20',
    text: 'text-sky-700 dark:text-sky-300',
    chip: 'bg-sky-100 text-sky-800 dark:bg-sky-400/10 dark:text-sky-200',
    ring: 'border-sky-200/80 dark:border-sky-400/20',
    iconSvg: '<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z" />',
  },
  {
    id: 'config',
    labelEn: 'Config & runtime',
    labelVi: 'Config & runtime',
    accent: 'bg-amber-400',
    panel: 'from-amber-50 to-orange-50 dark:from-amber-950/35 dark:to-orange-950/20',
    text: 'text-amber-700 dark:text-amber-300',
    chip: 'bg-amber-100 text-amber-800 dark:bg-amber-400/10 dark:text-amber-200',
    ring: 'border-amber-200/80 dark:border-amber-400/20',
    iconSvg: '<circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 01-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z" />',
  },
];

const commandAnchorId = (name: string) =>
  `ak-cli-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<div class="space-y-5">
  {categoryConfigs.map((cat, categoryIndex) => {
    const cmds = akCliCommandsCheatsheet.filter((c) => c.category === cat.id);
    const leading = cmds[0]?.example || cmds[0]?.name;
    return (
      <section id={`ak-cli-cat-${cat.id}`} class:list={['scroll-mt-32 overflow-hidden rounded-[1.65rem] border bg-gradient-to-br shadow-sm', cat.panel, cat.ring]}>
        <div class="grid gap-0 lg:grid-cols-[220px_1fr]">
          <div class="relative border-b border-slate-200/70 p-5 dark:border-white/10 lg:border-b-0 lg:border-r">
            <div class:list={['absolute left-0 top-0 h-full w-1.5', cat.accent]}></div>
            <div class="flex h-full flex-col justify-between gap-8 pl-2">
              <div class="space-y-4">
                <div class:list={['inline-flex h-11 w-11 items-center justify-center rounded-2xl border bg-white/75 shadow-sm dark:bg-white/[0.04]', cat.ring]}>
                  <svg class:list={['h-5 w-5', cat.text]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.iconSvg} />
                </div>
                <div>
                  <div class="font-mono text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">
                    0{categoryIndex + 1}
                  </div>
                  <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-950 dark:text-white">
                    {isVi ? cat.labelVi : cat.labelEn}
                  </h2>
                </div>
              </div>
              <div class="space-y-3">
                <div class="flex items-end gap-2">
                  <span class="font-mono text-4xl font-bold text-slate-950 dark:text-white">{cmds.length}</span>
                  <span class="pb-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                    {isVi ? 'lệnh' : 'cmds'}
                  </span>
                </div>
                {leading && (
                  <button type="button" class="ak-copy-btn w-full rounded-2xl border border-slate-200 bg-white px-3 py-3 text-left font-mono text-xs text-slate-700 shadow-sm transition hover:border-teal-300 hover:bg-teal-50/70 dark:border-white/10 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-teal-400/30 dark:hover:bg-slate-900" data-code={leading}>
                    <span class="text-amber-600 dark:text-amber-300">$</span> {leading}
                  </button>
                )}
              </div>
            </div>
          </div>

          <div class="grid gap-3 p-4 sm:p-5">
            {cmds.map((cmd) => {
              const copyValue = cmd.example || cmd.name;
              const desc = isVi ? cmd.descriptionVi : cmd.description;
              return (
                <article id={commandAnchorId(cmd.name)} class="group relative scroll-mt-32 overflow-hidden rounded-2xl border border-slate-200/80 bg-white/80 p-4 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white dark:border-white/10 dark:bg-slate-950/55 dark:hover:border-white/20 dark:hover:bg-slate-900/70">
                  <div class:list={['absolute right-4 top-4 h-2 w-2 rounded-full', cat.accent]}></div>
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 space-y-2">
                      <code class:list={['inline-flex rounded-xl px-3 py-1.5 font-mono text-sm font-bold', cat.chip]}>
                        {cmd.name}
                      </code>
                      <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">{desc}</p>
                    </div>
                    <button type="button" class="ak-copy-btn flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 transition hover:border-teal-300 hover:bg-teal-50 hover:text-teal-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-400 dark:hover:border-teal-400/30 dark:hover:bg-white/[0.08] dark:hover:text-teal-200 sm:opacity-70" data-code={copyValue} title="Copy" aria-label={`Copy ${copyValue}`}>
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                    </button>
                  </div>
                  {(cmd.subcommands || cmd.keyFlags) && (
                    <div class="mt-4 flex flex-wrap gap-1.5">
                      {cmd.subcommands?.map((sub) => (
                        <span class:list={['inline-flex items-center rounded-full px-2 py-1 font-mono text-[10px] font-medium', cat.chip]}>{sub}</span>
                      ))}
                      {cmd.keyFlags?.map((flag) => (
                        <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-[10px] font-medium text-slate-500 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-400">{flag}</span>
                      ))}
                    </div>
                  )}
                  {cmd.example && (
                    <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2.5 dark:border-white/10 dark:bg-slate-950">
                      <div class="flex items-start gap-2 font-mono text-xs leading-5 text-slate-600 dark:text-slate-300">
                        <span class="text-amber-600 dark:text-amber-300">$</span>
                        <span class="break-words">{cmd.example}</span>
                      </div>
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}
</div>
