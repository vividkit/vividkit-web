---
import { getLangFromUrl, type Language } from '@/i18n';
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';
import AkPageHero from './AkPageHero.astro';
import AkSection from './AkSection.astro';
import AkCallout from './AkCallout.astro';
import AkNextLinks from './AkNextLinks.astro';
import AkInlineCode from './AkInlineCode.astro';
import AkFeatureGrid from './AkFeatureGrid.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

const runtimes = isVi
  ? [
      {
        brandProvider: 'claude' as const,
        title: 'Claude Code',
        body: 'Đưa kit vào Claude Code (native hoặc plugin — plugin phải chọn rõ). Skills, agents, slash commands, rules, hooks và status line có thể bật ở project hoặc user.',
        accent: 'teal' as const,
      },
      {
        brandProvider: 'openai' as const,
        title: 'Codex',
        body: 'Đưa kit vào Codex: tìm skill và gọi agent. Hook chỉ một phần — một số nhóm bị bỏ hoặc thu hẹp. Không có status line. File command có thể chỉ là nội dung hỗ trợ.',
        accent: 'violet' as const,
      },
      {
        brandProvider: 'cursor' as const,
        title: 'Cursor',
        body: 'Đưa kit vào Cursor: skills, agents, rules, hooks. Cài, cập nhật và gọi live có thể chưa đủ trên mọi setup — đừng suy ra ngang Claude Code.',
        accent: 'cyan' as const,
      },
      {
        brandProvider: 'grok' as const,
        title: 'Grok',
        body: 'Đưa kit vào Grok. Skills và agents theo bề mặt Grok hỗ trợ — đừng giả định đủ hook, status line hay slash command như Claude Code.',
        accent: 'amber' as const,
      },
      {
        brandSrc: '/guides/agentkit/pi.svg',
        brandAlt: 'Pi',
        title: 'Pi',
        body: 'Đưa kit vào Pi ở phạm vi project. Không dùng cho cài global từ registry remote.',
        accent: 'blue' as const,
      },
      {
        brandSrc: '/guides/agentkit/omp.svg',
        brandAlt: 'Oh My Pi',
        title: 'Oh My Pi',
        body: 'Đưa kit vào Oh My Pi ở project và trên máy (user/global). Khác Pi — không gộp thành một runtime.',
        accent: 'rose' as const,
      },
      {
        brandProvider: 'deepseek' as const,
        title: 'DeepSeek Harness',
        body: 'Đưa kit vào DeepSeek Harness từ kit đã có trên máy. Không lấy kit từ registry remote.',
        accent: 'emerald' as const,
      },
    ]
  : [
      {
        brandProvider: 'claude' as const,
        title: 'Claude Code',
        body: 'Delivers the Kit into Claude Code (native or plugin — pick the plugin path explicitly). Skills, agents, slash commands, rules, hooks, and status line can be active at project or user scope.',
        accent: 'teal' as const,
      },
      {
        brandProvider: 'openai' as const,
        title: 'Codex',
        body: 'Delivers the Kit into Codex: skill discovery and agent dispatch. Hook support is partial — some groups drop or narrow. No status line. Command files may stay supporting content.',
        accent: 'violet' as const,
      },
      {
        brandProvider: 'cursor' as const,
        title: 'Cursor',
        body: 'Delivers the Kit into Cursor: skills, agents, rules, hooks. Live install, update, and invocation can be incomplete across setups — do not infer Claude Code parity.',
        accent: 'cyan' as const,
      },
      {
        brandProvider: 'grok' as const,
        title: 'Grok',
        body: 'Delivers the Kit into Grok. Skills and agents follow what Grok actually exposes — do not assume Claude Code hook, status line, or slash-command coverage.',
        accent: 'amber' as const,
      },
      {
        brandSrc: '/guides/agentkit/pi.svg',
        brandAlt: 'Pi',
        title: 'Pi',
        body: 'Delivers the Kit into Pi at project scope. Not for global install from the remote registry.',
        accent: 'blue' as const,
      },
      {
        brandSrc: '/guides/agentkit/omp.svg',
        brandAlt: 'Oh My Pi',
        title: 'Oh My Pi',
        body: 'Delivers the Kit into Oh My Pi at project and machine (user/global) scope. Separate from Pi — do not treat them as one runtime.',
        accent: 'rose' as const,
      },
      {
        brandProvider: 'deepseek' as const,
        title: 'DeepSeek Harness',
        body: 'Delivers the Kit into DeepSeek Harness from kits already on the machine. Does not fetch kits from the remote registry.',
        accent: 'emerald' as const,
      },
    ];
---

<div class="space-y-10 mt-6">
  <AkPageHero
    lang={currentLang}
    accent="cyan"
    kicker={isVi ? 'AgentKit · Adapters' : 'AgentKit · Adapters'}
    title={isVi ? 'Hỗ Trợ Runtime AgentKit' : 'AgentKit Runtime Support'}
    subtitle={isVi
      ? 'Adapter đưa Kit vào coding agent — không phải bảng parity đầy đủ.'
      : 'How adapters deliver Kits into coding agents — not a full parity matrix.'}
  />

  <AkSection
    eyebrow={isVi ? 'Mô hình' : 'Model'}
    title={isVi ? 'Adapter là ranh giới tương thích' : 'An adapter is a compatibility boundary'}
  >
    <div class="rounded-2xl border border-slate-200/80 bg-gradient-to-br from-white via-slate-50 to-cyan-50/40 p-6 dark:border-slate-700 dark:from-slate-900 dark:via-slate-950 dark:to-cyan-950/20">
      <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300 md:text-base">
        {isVi
          ? 'Coding assistants không chia sẻ một layout file, bộ tool hay model lifecycle event. Runtime adapter chuyển Kit thành bề mặt assistant có thể khám phá và dùng. Nếu không có tương đương, AgentKit có thể giữ supporting content, bỏ qua kèm cảnh báo, hoặc báo unsupported.'
          : 'Coding assistants do not share one file layout, tool set, or lifecycle model. A runtime adapter converts a Kit into surfaces that assistant can discover and use. Without an equivalent, AgentKit may keep supporting content, drop with a warning, or report unsupported.'}
      </p>
    </div>
  </AkSection>

  <AkSection
    eyebrow={isVi ? 'Gọi Skill' : 'Invocation'}
    title={isVi ? 'Cú pháp đã xác nhận' : 'Confirmed invocation syntax'}
    desc={isVi ? 'Cú pháp và bề mặt hỗ trợ thay đổi theo runtime.' : 'Syntax and supported surfaces vary by runtime.'}
  >
    <div class="overflow-hidden rounded-2xl border border-slate-200/80 shadow-sm dark:border-slate-700">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="bg-slate-100 text-slate-700 dark:bg-slate-900 dark:text-slate-200">
            <th class="px-4 py-3 font-semibold">Runtime</th>
            <th class="px-4 py-3 font-semibold">{isVi ? 'Cú pháp' : 'Syntax'}</th>
            <th class="px-4 py-3 font-semibold">{isVi ? 'Ví dụ' : 'Examples'}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-700 dark:bg-slate-900/60">
          <tr class="transition hover:bg-teal-50/50 dark:hover:bg-teal-950/20">
            <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white">Claude Code</td>
            <td class="px-4 py-3.5"><AkInlineCode text="/ak:<skill>" /></td>
            <td class="px-4 py-3.5 space-x-2"><AkInlineCode text="/ak:cook" /> <AkInlineCode text="/ak:plan" /></td>
          </tr>
          <tr class="transition hover:bg-cyan-50/50 dark:hover:bg-cyan-950/20">
            <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white">Cursor</td>
            <td class="px-4 py-3.5"><AkInlineCode text="/ak:<skill>" /></td>
            <td class="px-4 py-3.5 space-x-2"><AkInlineCode text="/ak:cook" /> <AkInlineCode text="/ak:plan" /></td>
          </tr>
          <tr class="transition hover:bg-violet-50/50 dark:hover:bg-violet-950/20">
            <td class="px-4 py-3.5 font-medium text-slate-900 dark:text-white">Codex</td>
            <td class="px-4 py-3.5"><AkInlineCode text="$ak:<skill>" /></td>
            <td class="px-4 py-3.5 space-x-2"><AkInlineCode text="$ak:cook" /> <AkInlineCode text="$ak:plan" /></td>
          </tr>
        </tbody>
      </table>
    </div>
  </AkSection>

  <AkSection
    eyebrow={isVi ? 'Kỳ vọng' : 'Expectations'}
    title={isVi ? 'Mỗi runtime một thực tế' : 'Each runtime has its own reality'}
  >
    <AkFeatureGrid features={runtimes} columns={2} />

    <article class="mt-4 overflow-hidden rounded-2xl border border-slate-200/80 bg-gradient-to-br from-slate-50 via-white to-amber-50/40 p-5 shadow-sm dark:border-slate-700 dark:from-slate-900/80 dark:via-slate-900/50 dark:to-amber-950/20 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="min-w-0 space-y-1.5">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-amber-700 dark:text-amber-400">
            {isVi ? 'Chỉ load skill' : 'Portable targets'}
          </p>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">
            {isVi
              ? 'Runtime khác vẫn có thể load skill AgentKit'
              : 'Other runtimes may still load AgentKit skills'}
          </h3>
        </div>
        <span class="shrink-0 rounded-full border border-amber-300/70 bg-amber-500/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/15 dark:text-amber-200">
          {isVi ? 'Không phải native harness' : 'Not a native harness'}
        </span>
      </div>

      <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        {isVi
          ? 'Một số coding agent vẫn đọc hoặc discover skill AgentKit qua thư mục skill chuẩn. Load được skill không chứng minh adapter install/update, Hooks, status line hay command parity.'
          : 'Some coding agents can still read or discover AgentKit skills through standard skill folders. Loading a skill does not prove adapter install/update, Hooks, status line, or command parity.'}
      </p>

      <div class="mt-4 flex flex-wrap gap-2">
        {(
          isVi
            ? [
                { name: 'OpenCode', brand: 'opencode' as const, tip: 'Load skill — không phải native harness' },
                { name: 'Cline', brand: 'cline' as const, tip: 'Load skill — không phải native harness' },
              ]
            : [
                { name: 'OpenCode', brand: 'opencode' as const, tip: 'Skills load — not a native harness' },
                { name: 'Cline', brand: 'cline' as const, tip: 'Skills load — not a native harness' },
              ]
        ).map((chip) => (
          <span
            class="inline-flex items-center gap-2 rounded-full border border-slate-200/90 bg-white/90 py-1 pl-1 pr-2.5 shadow-sm dark:border-slate-600 dark:bg-slate-800/80"
            title={chip.tip}
          >
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-amber-200/80 bg-white shadow-sm dark:border-amber-500/30 dark:bg-slate-950">
              <LLMProviderIcon provider={chip.brand} size={16} class="shrink-0" />
            </span>
            <span class="text-[12px] font-semibold text-slate-800 dark:text-slate-100">{chip.name}</span>
            <span class="hidden text-[10px] font-medium text-slate-500 sm:inline dark:text-slate-400">{chip.tip}</span>
          </span>
        ))}
      </div>

      <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
        {isVi
          ? 'Đừng suy ra parity install/update/invocation chỉ vì skill hiện trong agent. Kiểm tra install summary và hành vi thật trên runtime của bạn.'
          : 'Do not infer install/update/invocation parity just because a skill appears in the agent. Check the install summary and real behavior on your runtime.'}
      </p>
    </article>
  </AkSection>

  <AkCallout variant="warn" title={isVi ? 'Đừng suy luận mù' : 'Do not guess from filenames'}>
    {isVi
      ? 'Đừng suy ra hỗ trợ từ tên file hay hành vi runtime khác. Cảnh báo về nội dung bị bỏ/giữ thường là kết quả capability — không nhất thiết cài đặt thất bại. Đọc install summary sau mỗi lần cài.'
      : 'Do not infer support from a file name or another runtime’s behavior. Warnings about omitted/preserved content are usually capability results — not necessarily a failed install. Read the install summary after each install.'}
  </AkCallout>

  <AkNextLinks
    lang={currentLang}
    title={isVi ? 'Tiếp theo' : 'Next'}
    links={[
      { href: '/guides/agentkit/getting-started', label: isVi ? 'Cài đặt' : 'Get started' },
      { href: '/guides/agentkit/building-blocks', label: isVi ? 'Building blocks' : 'Building blocks' },
    ]}
  />
</div>
