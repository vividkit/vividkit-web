---
import { useTranslatedPath, type Language } from '@/i18n';

interface LinkItem {
  href: string;
  label: string;
  desc?: string;
}

interface Props {
  lang: Language;
  title: string;
  links: LinkItem[];
}

const { lang, title, links } = Astro.props;
const translatePath = useTranslatedPath(lang);
---

<section class="relative overflow-hidden rounded-3xl border border-slate-200/80 bg-gradient-to-br from-slate-50 via-white to-teal-50/50 p-6 dark:border-slate-700 dark:from-slate-950 dark:via-slate-900 dark:to-teal-950/30">
  <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-teal-400/10 blur-2xl"></div>
  <h2 class="text-lg font-bold text-slate-900 dark:text-white">{title}</h2>
  <ul class="mt-4 grid gap-3 sm:grid-cols-2">
    {links.map((l) => (
      <li>
        <a
          href={translatePath(l.href)}
          class="group flex items-start justify-between gap-3 rounded-2xl border border-slate-200/80 bg-white/80 px-4 py-3 transition-all hover:-translate-y-0.5 hover:border-teal-300 hover:shadow-md hover:shadow-teal-500/10 dark:border-slate-700 dark:bg-slate-900/60 dark:hover:border-teal-500/40"
        >
          <span>
            <span class="block text-sm font-semibold text-slate-900 group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-300">
              {l.label}
            </span>
            {l.desc && (
              <span class="mt-0.5 block text-xs leading-relaxed text-slate-500 line-clamp-2 dark:text-slate-400">{l.desc}</span>
            )}
          </span>
          <span class="mt-0.5 text-teal-600 transition-transform group-hover:translate-x-0.5 dark:text-teal-400">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>
