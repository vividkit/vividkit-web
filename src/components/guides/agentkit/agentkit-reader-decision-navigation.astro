---
import { ArrowUpRight, Route } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { AGENTKIT_READER_LANES } from './agentkit-reader-lanes';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const primaryLanes = AGENTKIT_READER_LANES.filter(({ group }) => group === 'primary');
const exceptionLanes = AGENTKIT_READER_LANES.filter(({ group }) => group === 'exception');
const laneClass = 'group flex min-h-11 min-w-0 items-start justify-between gap-4 rounded-xl border border-slate-200 bg-white px-4 py-3 text-left transition-colors duration-200 motion-reduce:transition-none hover:border-purple-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-purple-700 dark:hover:bg-slate-800/70';
---

<section id="choose-path" class="scroll-mt-40 pt-10 lg:scroll-mt-28" aria-labelledby="choose-path-heading">
  <div class="max-w-3xl">
    <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-purple-700 dark:text-purple-300">
      <Route class="h-5 w-5" aria-hidden="true" />
      {t('agentkit.lanes.eyebrow')}
    </p>
    <h2 id="choose-path-heading" class="mt-3 font-heading text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
      {t('agentkit.lanes.heading')}
    </h2>
    <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">{t('agentkit.lanes.intro')}</p>
  </div>

  <nav class="mt-7 max-w-4xl" aria-labelledby="choose-path-heading">
    <p class="font-bold text-slate-950 dark:text-slate-50">{t('agentkit.lanes.question.usedCk')}</p>
    <ol class="mt-3 grid gap-3" data-agentkit-route-group="primary">
      {primaryLanes.map((lane) => {
        const showClearSetupPrompt = lane.id === 'clean';
        return (
          <li class="min-w-0">
            {showClearSetupPrompt && (
              <p class="mb-3 ml-5 border-l-2 border-slate-200 pl-4 text-sm text-slate-600 dark:border-slate-700 dark:text-slate-300">
                {t('agentkit.lanes.question.clearSetup')}
              </p>
            )}
            <a href={lane.href[lang]} data-agentkit-reader-lane={lane.id} class={laneClass}>
              <span class="min-w-0">
                <span class="block break-words font-heading text-base font-bold text-slate-950 dark:text-slate-50">{t(lane.titleKey)}</span>
                <span class="mt-1 block break-words text-sm leading-6 text-slate-600 dark:text-slate-300">{t(lane.bodyKey)}</span>
                <span class="mt-2 block text-sm font-bold text-purple-700 dark:text-purple-300">{t(lane.ctaKey)}</span>
              </span>
              <ArrowUpRight class="mt-1 h-4 w-4 shrink-0 text-purple-600 dark:text-purple-400" aria-hidden="true" />
            </a>
          </li>
        );
      })}
    </ol>

    <div class="mt-6 border-t border-slate-200 pt-5 dark:border-slate-800">
      <p class="text-sm font-bold text-slate-950 dark:text-slate-50">{t('agentkit.lanes.exceptions')}</p>
      <ol class="mt-3 grid gap-2 sm:grid-cols-2" data-agentkit-route-group="exception">
        {exceptionLanes.map((lane) => (
          <li class="min-w-0">
            <a href={lane.href[lang]} data-agentkit-reader-lane={lane.id} class={laneClass}>
              <span class="min-w-0">
                <span class="block break-words font-bold text-slate-950 dark:text-slate-50">{t(lane.titleKey)}</span>
                <span class="mt-1 block break-words text-sm leading-6 text-slate-600 dark:text-slate-300">{t(lane.bodyKey)}</span>
                <span class="mt-2 block text-sm font-bold text-purple-700 dark:text-purple-300">{t(lane.ctaKey)}</span>
              </span>
              <ArrowUpRight class="mt-1 h-4 w-4 shrink-0 text-purple-600 dark:text-purple-400" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>
</section>
