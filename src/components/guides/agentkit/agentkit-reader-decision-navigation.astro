---
import { ArrowUpRight, Route } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { AGENTKIT_READER_LANES } from './agentkit-reader-lanes';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="choose-path" class="scroll-mt-40 pt-12 lg:scroll-mt-28" aria-labelledby="choose-path-heading">
  <div class="max-w-3xl">
    <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.12em] text-purple-700 dark:text-purple-300">
      <Route class="h-5 w-5" aria-hidden="true" />
      {t('agentkit.lanes.eyebrow')}
    </p>
    <h2 id="choose-path-heading" class="mt-3 font-heading text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
      {t('agentkit.lanes.heading')}
    </h2>
    <p class="mt-3 leading-relaxed text-slate-600 dark:text-slate-300">
      {t('agentkit.lanes.intro')}
    </p>
  </div>

  <nav class="mt-7" aria-labelledby="choose-path-heading">
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {AGENTKIT_READER_LANES.map((lane) => (
        <li class="min-w-0">
          <a
            href={lane.href[lang]}
            data-agentkit-reader-lane={lane.id}
            class="group flex h-full min-h-44 min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-sm transition-colors duration-200 motion-reduce:transition-none hover:border-purple-300 hover:bg-purple-50/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-600 focus-visible:ring-offset-2 active:bg-purple-100/70 dark:border-slate-700 dark:bg-slate-900 dark:hover:border-purple-700 dark:hover:bg-purple-950/20 dark:active:bg-purple-950/35"
          >
            <span class="break-words font-heading text-lg font-bold text-slate-950 dark:text-slate-50">
              {t(lane.titleKey)}
            </span>
            <span class="mt-2 grow break-words text-sm leading-6 text-slate-600 dark:text-slate-300">
              {t(lane.bodyKey)}
            </span>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-bold text-purple-700 dark:text-purple-300">
              {t(lane.ctaKey)}
              <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</section>
