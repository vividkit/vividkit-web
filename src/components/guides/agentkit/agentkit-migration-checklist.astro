---
import { AlertTriangle, ShieldCheck } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { AGENTKIT_LIFECYCLE_COMMANDS, AGENTKIT_LIFECYCLE_STAGE_FACTS } from '@/data/guides/agentkit/agentkit-lifecycle-policy';
import { toLifecycleCommandView } from './agentkit-command-view';
import AgentKitPlatformCommandSwitcher from './agentkit-platform-command-switcher.astro';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
  includeStage7Details: boolean;
}

const { lang, includeStage7Details } = Astro.props;
const t = useTranslations(lang);
---

<section id="clean-cutover" aria-labelledby="migration-journey-heading" class="scroll-mt-40 pt-14 lg:scroll-mt-28">
  <span id="migration-journey" class="block scroll-mt-40 lg:scroll-mt-28" aria-hidden="true"></span>
  <div class="max-w-3xl">
    <h2 id="migration-journey-heading" class="font-heading text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
      {t('agentkit.journey.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">{t('agentkit.journey.intro')}</p>
  </div>

  <ol class="mt-8 border-y border-slate-200 dark:border-slate-800" data-agentkit-lifecycle-stages>
    {AGENTKIT_LIFECYCLE_STAGE_FACTS.map((stage, index) => {
      const isRemoval = stage.id === 'remove-ck-control-plane';
      const commandIds = new Set(stage.commandIds);
      const commands = isRemoval && !includeStage7Details
        ? []
        : AGENTKIT_LIFECYCLE_COMMANDS.filter((command) => commandIds.has(command.id)).map(toLifecycleCommandView);
      return (
        <li
          id={`stage-${stage.id}`}
          data-agentkit-stage={stage.id}
          class:list={[
            'grid scroll-mt-28 gap-5 py-7 md:grid-cols-[3.5rem_minmax(0,1fr)] md:gap-7',
            index > 0 && 'border-t border-slate-200 dark:border-slate-800',
          ]}
        >
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 font-mono text-sm font-bold text-slate-700 ring-1 ring-inset ring-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </div>

          <details class="group min-w-0" open={index === 0} data-agentkit-stage-details>
            <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-3 rounded-lg focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2">
              <span role="heading" aria-level="3" class="font-heading text-xl font-bold text-slate-950 dark:text-slate-50" set:html={renderInlineCode(t(`agentkit.lifecycle.stage.${stage.id}.title`))}></span>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center overflow-hidden text-xl font-normal text-slate-400" aria-hidden="true">
                <span class="transition-transform duration-200 motion-reduce:transition-none group-open:rotate-45">+</span>
              </span>
            </summary>

            <div class="pt-2">
              <p class="max-w-3xl leading-relaxed text-slate-600 text-pretty dark:text-slate-300" set:html={renderInlineCode(t(`agentkit.lifecycle.stage.${stage.id}.body`))}></p>
              <dl class="mt-5 grid gap-3 text-sm md:grid-cols-3">
                <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-900/60">
                  <dt class="font-bold text-slate-900 dark:text-slate-100">{t('agentkit.lifecycle.prerequisite')}</dt>
                  <dd class="mt-1 leading-relaxed text-slate-600 dark:text-slate-300" set:html={renderInlineCode(t(`agentkit.lifecycle.stage.${stage.id}.prerequisite`))}></dd>
                </div>
                <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-900/60">
                  <dt class="font-bold text-slate-900 dark:text-slate-100">{t('agentkit.lifecycle.signal')}</dt>
                  <dd class="mt-1 leading-relaxed text-slate-600 dark:text-slate-300" set:html={renderInlineCode(t(`agentkit.lifecycle.stage.${stage.id}.signal`))}></dd>
                </div>
                <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-900/60">
                  <dt class="font-bold text-slate-900 dark:text-slate-100">{t('agentkit.lifecycle.failure')}</dt>
                  <dd class="mt-1 leading-relaxed text-slate-600 dark:text-slate-300" set:html={renderInlineCode(t(`agentkit.lifecycle.stage.${stage.id}.failure`))}></dd>
                </div>
              </dl>

              {commands.length > 0 && (
                <div class="mt-5 max-w-3xl" data-agentkit-stage-command-panel>
                  <AgentKitPlatformCommandSwitcher id={`lifecycle-${stage.id}`} lang={lang} commands={commands} />
                </div>
              )}

              {isRemoval && !includeStage7Details && (
                <p class="mt-5 flex max-w-3xl gap-2 rounded-xl border border-rose-300 bg-rose-50 p-4 text-sm font-semibold text-rose-900 dark:border-rose-800 dark:bg-rose-950/30 dark:text-rose-100" role="status" data-agentkit-stage-seven-unavailable>
                  <AlertTriangle class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                  <span>{t('agentkit.journey.removalHold')}</span>
                </p>
              )}
            </div>
          </details>
        </li>
      );
    })}
  </ol>

  <p class="mt-5 flex max-w-3xl gap-2 text-sm text-slate-600 dark:text-slate-300">
    <ShieldCheck class="mt-0.5 h-4 w-4 shrink-0 text-purple-600 dark:text-purple-400" aria-hidden="true" />
    <span>{t('agentkit.journey.limit')}</span>
  </p>
</section>
