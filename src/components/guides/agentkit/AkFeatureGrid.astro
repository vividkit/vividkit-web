---
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';

type BrandProvider = 'claude' | 'openai' | 'cursor' | 'windsurf' | 'gemini' | 'google' | 'grok' | 'deepseek';

interface Feature {
  title: string;
  body: string;
  /** Short letter/label badge (legacy). Prefer brandProvider for product brands. */
  icon?: string;
  /** lobe-icons brand mark via LLMProviderIcon (claude, openai/Codex, cursor, …) */
  brandProvider?: BrandProvider;
  /** Local or absolute brand mark when lobe-icons has no provider. */
  brandSrc?: string;
  brandAlt?: string;
  accent?: 'teal' | 'cyan' | 'violet' | 'amber' | 'blue' | 'rose' | 'emerald';
}

interface Props {
  features: Feature[];
  columns?: 2 | 3;
}

const { features, columns = 2 } = Astro.props;

const accentMap = {
  teal: {
    well: 'bg-gradient-to-br from-teal-500 to-cyan-600 shadow-md shadow-teal-500/25',
    brandWell: 'border-teal-200/80 bg-white shadow-sm shadow-teal-500/15 dark:border-teal-500/30 dark:bg-slate-950',
  },
  cyan: {
    well: 'bg-gradient-to-br from-cyan-500 to-blue-600 shadow-md shadow-cyan-500/25',
    brandWell: 'border-cyan-200/80 bg-white shadow-sm shadow-cyan-500/15 dark:border-cyan-500/30 dark:bg-slate-950',
  },
  violet: {
    well: 'bg-gradient-to-br from-violet-500 to-fuchsia-600 shadow-md shadow-violet-500/25',
    brandWell: 'border-violet-200/80 bg-white shadow-sm shadow-violet-500/15 dark:border-violet-500/30 dark:bg-slate-950',
  },
  amber: {
    well: 'bg-gradient-to-br from-amber-500 to-orange-600 shadow-md shadow-amber-500/25',
    brandWell: 'border-amber-200/80 bg-white shadow-sm shadow-amber-500/15 dark:border-amber-500/30 dark:bg-slate-950',
  },
  blue: {
    well: 'bg-gradient-to-br from-blue-500 to-indigo-600 shadow-md shadow-blue-500/25',
    brandWell: 'border-blue-200/80 bg-white shadow-sm shadow-blue-500/15 dark:border-blue-500/30 dark:bg-slate-950',
  },
  rose: {
    well: 'bg-gradient-to-br from-rose-500 to-red-600 shadow-md shadow-rose-500/25',
    brandWell: 'border-rose-200/80 bg-white shadow-sm shadow-rose-500/15 dark:border-rose-500/30 dark:bg-slate-950',
  },
  emerald: {
    well: 'bg-gradient-to-br from-emerald-500 to-teal-600 shadow-md shadow-emerald-500/25',
    brandWell: 'border-emerald-200/80 bg-white shadow-sm shadow-emerald-500/15 dark:border-emerald-500/30 dark:bg-slate-950',
  },
} as const;
---

<div class:list={['grid gap-4', columns === 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2']}>
  {features.map((f, i) => {
    const accent = f.accent || (['teal', 'cyan', 'violet', 'amber', 'blue', 'emerald'] as const)[i % 6];
    const tones = accentMap[accent];
    const useBrand = Boolean(f.brandProvider || f.brandSrc);
    return (
      <article class="group relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white/80 p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:border-slate-300 hover:shadow-lg dark:border-slate-700/70 dark:bg-slate-900/50 dark:hover:border-slate-600">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-slate-300/80 to-transparent dark:via-slate-600/50"></div>
        <div class="flex items-start gap-4">
          <div
            class:list={[
              'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl',
              useBrand ? ['border', 'overflow-hidden', tones.brandWell] : ['text-white', tones.well],
            ]}
          >
            {f.brandProvider ? (
              <LLMProviderIcon provider={f.brandProvider} size={22} class="shrink-0" />
            ) : f.brandSrc ? (
              <img src={f.brandSrc} alt={f.brandAlt || f.title} width="44" height="44" class="h-11 w-11 object-cover" />
            ) : f.icon ? (
              <span class="text-sm font-bold tracking-wide">{f.icon}</span>
            ) : (
              <span class="text-sm font-bold">{String(i + 1).padStart(2, '0')}</span>
            )}
          </div>
          <div class="min-w-0 space-y-1.5">
            <h3 class="text-base font-semibold text-slate-900 dark:text-white">{f.title}</h3>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">{f.body}</p>
          </div>
        </div>
      </article>
    );
  })}
</div>
