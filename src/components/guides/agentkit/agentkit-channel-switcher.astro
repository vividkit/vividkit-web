---
import type { Language } from '@/i18n';
import { getAgentKitHoldNotice, getAgentKitStaticHoldNotice } from '@/data/guides/agentkit/agentkit-channel-copy.mjs';
import { normalizeAgentKitChannel, withAgentKitChannel } from '@/data/guides/agentkit/agentkit-channel-policy.mjs';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const publicationStatus = import.meta.env.AGENTKIT_PUBLICATION_STATUS ?? 'hold';
const isHold = publicationStatus === 'hold';
const requestedChannel = normalizeAgentKitChannel(Astro.url.search);
const showHoldNotice = isHold && requestedChannel === 'beta';
const currentLocation = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`;
const stableHref = withAgentKitChannel(currentLocation, 'stable');
const betaHref = withAgentKitChannel(currentLocation, 'beta');
const holdNotice = getAgentKitHoldNotice(lang);
const staticHoldNotice = getAgentKitStaticHoldNotice(lang);
const stableSummary = isVi ? 'Bạn đang xem nội dung đã phát hành.' : 'You’re viewing released guidance.';
---

<section
  class="mb-2"
  data-agentkit-channel-controls
  data-agentkit-publication-state={publicationStatus}
  aria-label={isVi ? 'Kênh phát hành AgentKit' : 'AgentKit release channel'}
>
  <div class="flex min-h-11 flex-wrap items-center gap-2 text-sm text-slate-600 dark:text-slate-300" data-agentkit-channel-summary>
    {isHold ? (
      <>
        <strong class="text-slate-950 dark:text-slate-50" data-agentkit-effective-channel="stable">Stable</strong>
        <span aria-hidden="true">·</span>
        <span>{stableSummary}</span>
      </>
    ) : (
      <nav aria-label={isVi ? 'Chọn kênh phát hành AgentKit' : 'Choose AgentKit release channel'} class="flex rounded-xl border border-slate-200 bg-slate-100 p-1 dark:border-slate-700 dark:bg-slate-800">
        <a href={stableHref} data-agentkit-channel-choice="stable" aria-current="true" class="inline-flex min-h-11 items-center rounded-lg px-4 py-2 font-semibold text-slate-700 transition-colors motion-reduce:transition-none data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Stable</a>
        <a href={betaHref} data-agentkit-channel-choice="beta" aria-current="false" class="inline-flex min-h-11 items-center rounded-lg px-4 py-2 font-semibold text-slate-700 transition-colors motion-reduce:transition-none data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Beta</a>
      </nav>
    )}
  </div>

  <aside
    hidden={!showHoldNotice}
    tabindex="-1"
    role="status"
    class="mt-3 max-w-3xl rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100"
    data-agentkit-channel-notice
  >
    <h2 class="font-bold" data-agentkit-channel-notice-title>{showHoldNotice ? holdNotice.title : ''}</h2>
    <p class="mt-1 text-sm leading-6" data-agentkit-channel-notice-body>{showHoldNotice ? holdNotice.body : ''}</p>
  </aside>
  {isHold && (
    <noscript>
      <aside role="status" class="mt-3 max-w-3xl rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100" data-agentkit-static-hold-notice>
        <h2 class="font-bold">{staticHoldNotice.title}</h2>
        <p class="mt-1 text-sm leading-6">{staticHoldNotice.body}</p>
      </aside>
    </noscript>
  )}
  <div hidden class="mt-5" data-agentkit-beta-view></div>
</section>

<script>
  import { initializeAgentKitChannelController } from '@/scripts/agentkit-channel-controller.mjs';

  initializeAgentKitChannelController();
  document.addEventListener('astro:page-load', initializeAgentKitChannelController);
</script>
