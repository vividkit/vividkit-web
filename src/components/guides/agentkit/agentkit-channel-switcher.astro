---
import type { Language } from '@/i18n';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const stableHref = Astro.url.pathname;
const betaHref = `${Astro.url.pathname}?channel=beta`;
---

<section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900" data-agentkit-channel-controls>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">AgentKit release channel</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        {isVi ? 'Stable là mặc định. Beta đã deploy là public; query không phải access control.' : 'Stable is the default. A deployed beta is public; the query is not access control.'}
      </p>
    </div>
    <nav aria-label={isVi ? 'Chọn AgentKit release channel' : 'Choose AgentKit release channel'} class="flex rounded-xl border border-slate-200 bg-slate-100 p-1 dark:border-slate-700 dark:bg-slate-800">
      <a href={stableHref} data-agentkit-channel-choice="stable" aria-current="true" class="min-h-11 rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Stable</a>
      <a href={betaHref} data-agentkit-channel-choice="beta" aria-current="false" class="min-h-11 rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Beta</a>
    </nav>
  </div>
  <aside hidden tabindex="-1" aria-live="polite" class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100" data-agentkit-channel-notice>
    <h2 class="font-bold" data-agentkit-channel-notice-title></h2>
    <p class="mt-1 text-sm leading-6" data-agentkit-channel-notice-body></p>
  </aside>
  <div hidden class="mt-5" data-agentkit-beta-view></div>
</section>

<script>
  import { initializeAgentKitChannelController } from '@/scripts/agentkit-channel-controller.mjs';

  initializeAgentKitChannelController();
  document.addEventListener('astro:page-load', initializeAgentKitChannelController);
</script>
