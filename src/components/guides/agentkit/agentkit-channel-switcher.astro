---
import type { Language } from '@/i18n';
import {
  getAgentKitHoldNotice,
  getAgentKitStaticHoldNotice,
} from '@/data/guides/agentkit/agentkit-channel-copy.mjs';
import {
  normalizeAgentKitChannel,
  withAgentKitChannel,
} from '@/data/guides/agentkit/agentkit-channel-policy.mjs';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const publicationStatus = import.meta.env.AGENTKIT_PUBLICATION_STATUS ?? 'hold';
const isHold = publicationStatus === 'hold';
const requestedChannel = normalizeAgentKitChannel(Astro.url.search);
const showHoldNotice = isHold && requestedChannel === 'beta';
const currentLocation = `${Astro.url.pathname}${Astro.url.search}${Astro.url.hash}`;
const stableHref = withAgentKitChannel(currentLocation, 'stable');
const betaHref = withAgentKitChannel(currentLocation, 'beta');

const holdNotice = getAgentKitHoldNotice(lang);
const staticHoldNotice = getAgentKitStaticHoldNotice(lang);
const channelDescription = isHold
  ? (isVi
    ? 'Stable là nội dung đang có hiệu lực. Beta chưa public trong build này; query không phải quyền truy cập.'
    : 'Stable is the effective content. Beta is not public in this build, and a query is not access permission.')
  : (isVi
    ? 'Stable là mặc định. Beta đã deploy là public; query không phải access control.'
    : 'Stable is the default. A deployed beta is public; the query is not access control.');
---

<section
  class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900"
  data-agentkit-channel-controls
  data-agentkit-publication-state={publicationStatus}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="min-w-0">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">
        {isVi ? 'Kênh phát hành AgentKit' : 'AgentKit release channel'}
      </p>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">
        {channelDescription}
      </p>
    </div>

    {isHold ? (
      <span class="inline-flex min-h-11 items-center rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-800 dark:border-emerald-500/30 dark:bg-emerald-950/30 dark:text-emerald-200" data-agentkit-effective-channel="stable">
        Stable
      </span>
    ) : (
      <nav aria-label={isVi ? 'Chọn AgentKit release channel' : 'Choose AgentKit release channel'} class="flex rounded-xl border border-slate-200 bg-slate-100 p-1 dark:border-slate-700 dark:bg-slate-800">
        <a href={stableHref} data-agentkit-channel-choice="stable" aria-current="true" class="min-h-11 rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition-colors motion-reduce:transition-none data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Stable</a>
        <a href={betaHref} data-agentkit-channel-choice="beta" aria-current="false" class="min-h-11 rounded-lg px-4 py-2 text-sm font-semibold text-slate-700 transition-colors motion-reduce:transition-none data-[agentkit-channel-selected=true]:bg-white data-[agentkit-channel-selected=true]:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-slate-200 dark:data-[agentkit-channel-selected=true]:bg-slate-950 dark:data-[agentkit-channel-selected=true]:text-violet-300">Beta</a>
      </nav>
    )}
  </div>

  <aside
    hidden={!showHoldNotice}
    tabindex="-1"
    role="status"
    class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100"
    data-agentkit-channel-notice
  >
    <h2 class="font-bold" data-agentkit-channel-notice-title>{showHoldNotice ? holdNotice.title : ''}</h2>
    <p class="mt-1 text-sm leading-6" data-agentkit-channel-notice-body>{showHoldNotice ? holdNotice.body : ''}</p>
  </aside>
  {isHold && (
    <noscript>
      <aside role="status" class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-4 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100" data-agentkit-static-hold-notice>
        <h2 class="font-bold">{staticHoldNotice.title}</h2>
        <p class="mt-1 text-sm leading-6">{staticHoldNotice.body}</p>
      </aside>
    </noscript>
  )}
  <div hidden class="mt-5" data-agentkit-beta-view></div>
</section>

<script>
  import { initializeAgentKitChannelController } from '@/scripts/agentkit-channel-controller.mjs';

  initializeAgentKitChannelController();
  document.addEventListener('astro:page-load', initializeAgentKitChannelController);
</script>
