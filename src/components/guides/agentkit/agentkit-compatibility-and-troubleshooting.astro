---
import { ArrowUpRight, KeyRound, RotateCcw, Route, ShieldAlert, Workflow } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { getAgentKitCliFact } from '@/data/guides/agentkit/agentkit-cli-facts';
import { inlineCodeClass, renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'vi' ? '/vi' : '';
const licensesCommand = getAgentKitCliFact('licenses')?.command;

const topics = [
  { id: 'shim', icon: Route, title: t('agentkit.compat.shim.title'), body: t('agentkit.compat.shim.body'), code: undefined },
  { id: 'path', icon: Route, title: t('agentkit.compat.path.title'), body: t('agentkit.compat.path.body'), code: 'PATH' },
  { id: 'auth', icon: KeyRound, title: t('agentkit.compat.auth.title'), body: t('agentkit.compat.auth.body'), code: licensesCommand },
  { id: 'checksum', icon: ShieldAlert, title: t('agentkit.compat.checksum.title'), body: t('agentkit.compat.checksum.body'), code: undefined },
  { id: 'rollback', icon: RotateCcw, title: t('agentkit.compat.rollback.title'), body: t('agentkit.compat.rollback.body'), code: '.claude' },
  { id: 'ci', icon: Workflow, title: t('agentkit.compat.ci.title'), body: t('agentkit.compat.ci.body'), code: undefined },
] as const;

const links = [
  { label: t('agentkit.links.cli'), href: `${prefix}/guides/cli` },
  { label: t('agentkit.links.commands'), href: `${prefix}/guides/commands` },
  { label: t('agentkit.links.session'), href: `${prefix}/guides/session-recovery` },
  { label: t('agentkit.links.migrate'), href: `${prefix}/guides/migrate` },
] as const;
---

<section id="troubleshooting" aria-labelledby="troubleshooting-heading" class="scroll-mt-28 pt-16">
  <h2 id="troubleshooting-heading" class="font-heading max-w-3xl text-3xl font-bold text-slate-950 text-balance dark:text-slate-50">
    {t('agentkit.compat.heading')}
  </h2>

  <div class="mt-8 grid gap-x-8 border-y border-slate-200 dark:border-slate-800 md:grid-cols-2">
    {topics.map((topic, index) => {
      const Icon = topic.icon;
      return (
        <details
          id={topic.id === 'ci' ? 'automation-safety' : undefined}
          class:list={[
            'group scroll-mt-28 border-slate-200 dark:border-slate-800',
            index > 1 && 'border-t',
            index % 2 === 1 && 'md:border-l md:pl-8',
          ]}
          open={index === 0}
        >
          <summary class="flex min-h-16 cursor-pointer list-none items-center gap-3 py-4 font-semibold text-slate-900 transition-colors duration-200 hover:text-purple-700 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 active:text-purple-600 dark:text-slate-100 dark:hover:text-purple-300">
            <Icon class="h-5 w-5 shrink-0 text-purple-600 dark:text-purple-400" aria-hidden="true" />
            <span set:html={renderInlineCode(topic.title)} ></span>
            <span class="ml-auto text-xl font-normal text-slate-400 transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <div class="pb-5 pl-8 pr-4 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <p set:html={renderInlineCode(topic.body)} ></p>
            {topic.code && <code class={`${inlineCodeClass} mt-3 inline-flex max-w-full overflow-x-auto`}>{topic.code}</code>}
          </div>
        </details>
      );
    })}
  </div>

  <nav aria-labelledby="agentkit-next-guides" class="mt-10 rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 via-white to-sky-50 p-6 text-slate-900 shadow-sm shadow-purple-950/5 dark:border-purple-800/60 dark:from-purple-950/30 dark:via-slate-900 dark:to-sky-950/20 dark:text-slate-100 dark:shadow-none md:p-8">
    <h3 id="agentkit-next-guides" class="font-heading text-xl font-bold">{t('agentkit.links.heading')}</h3>
    <div class="mt-5 grid gap-2 sm:grid-cols-2">
      {links.map((link) => (
        <a
          href={link.href}
          class="flex min-h-11 items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-semibold transition-colors duration-200 hover:bg-white/80 hover:text-purple-800 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 focus-visible:ring-offset-purple-50 active:bg-purple-100 dark:hover:bg-white/5 dark:hover:text-purple-200 dark:focus-visible:ring-purple-400 dark:focus-visible:ring-offset-slate-900 dark:active:bg-white/10"
        >
          <span>{link.label}</span>
          <ArrowUpRight class="h-4 w-4" aria-hidden="true" />
        </a>
      ))}
    </div>
  </nav>
</section>
