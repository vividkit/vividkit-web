---
// deals-campaign-ended-banner: Prominent announcement shown when the CK coupon
// campaign has fully ended. Toggle via env `PUBLIC_DEALS_CAMPAIGN_ENDED=true`.
// Sits above DealsHero so the rest of the layout (hero, primer, claim widget,
// raffle, FAQ) stays fully intact and can be re-enabled by flipping the flag.
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import { ArrowDownToLine } from 'lucide-astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const claimed = Number(import.meta.env.PUBLIC_DEALS_CAMPAIGN_CLAIMED || 80);
const total = Number(import.meta.env.PUBLIC_DEALS_CAMPAIGN_TOTAL || 80);
---

<section
  class="relative overflow-hidden rounded-[1.75rem] border border-rose-200/80 bg-gradient-to-br from-rose-50 via-amber-50 to-emerald-50 shadow-xl shadow-rose-900/[0.06] dark:border-rose-900/60 dark:from-rose-950/40 dark:via-amber-950/30 dark:to-emerald-950/30 dark:shadow-rose-950/30"
  aria-labelledby="deals-campaign-ended-title"
>
  <div
    class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-rose-300/30 blur-3xl dark:bg-rose-500/10"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute -bottom-20 -left-10 h-48 w-48 rounded-full bg-emerald-300/30 blur-3xl dark:bg-emerald-500/10"
    aria-hidden="true"
  ></div>

  <div class="relative grid gap-6 px-5 py-7 sm:px-8 sm:py-9 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-center">
    <div class="space-y-4">
      <div class="inline-flex items-center gap-2 rounded-full border border-rose-300/80 bg-white/80 px-3 py-1.5 text-xs font-black uppercase tracking-[0.18em] text-rose-700 dark:border-rose-800/70 dark:bg-rose-950/50 dark:text-rose-300">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-rose-500"></span>
        </span>
        {t('deals.campaign_ended.badge')}
      </div>

      <div class="max-w-2xl">
        <h2
          id="deals-campaign-ended-title"
          class="font-heading text-3xl font-black leading-tight text-slate-950 dark:text-white sm:text-4xl"
        >
          {t('deals.campaign_ended.title')}
        </h2>
        <p class="mt-3 text-base leading-7 text-slate-700 dark:text-slate-200 sm:text-lg sm:leading-8">
          {t('deals.campaign_ended.subtitle')}
        </p>
      </div>

      <div
        class="flex items-start gap-3 rounded-2xl border border-amber-300/80 bg-amber-50/90 px-4 py-3 dark:border-amber-800/70 dark:bg-amber-950/40"
        role="note"
      >
        <span class="mt-0.5 inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-amber-500 text-white shadow-sm shadow-amber-900/20 dark:bg-amber-400 dark:text-amber-950" aria-hidden="true">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.4 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" />
          </svg>
        </span>
        <p class="text-sm font-semibold leading-6 text-amber-900 dark:text-amber-100">
          {t('deals.campaign_ended.expiry_warning')}
        </p>
      </div>

      <a
        href="#claim"
        class="inline-flex min-h-11 w-fit items-center gap-2 rounded-xl border border-emerald-300 bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:border-emerald-700 dark:bg-emerald-400 dark:text-slate-950 dark:hover:bg-emerald-300 dark:focus-visible:ring-emerald-800"
      >
        <ArrowDownToLine class="h-4 w-4" aria-hidden="true" />
        {t('deals.campaign_ended.claim_cta')}
      </a>
    </div>

    <div class="relative rounded-2xl border-2 border-emerald-300/80 bg-white/90 p-5 shadow-lg shadow-emerald-900/[0.08] dark:border-emerald-700/70 dark:bg-slate-900/85 dark:shadow-emerald-950/30">
      <p class="text-center text-xs font-black uppercase tracking-[0.2em] text-emerald-700 dark:text-emerald-300">
        {t('deals.campaign_ended.stats_kicker')}
      </p>

      <div class="mt-3 flex items-baseline justify-center gap-2 tabular-nums">
        <span class="font-heading text-5xl font-black text-emerald-700 dark:text-emerald-300 sm:text-6xl">
          {claimed}
        </span>
        <span class="font-heading text-2xl font-bold text-slate-400 dark:text-slate-500">
          / {total}
        </span>
      </div>

      <p class="mt-2 text-center text-sm font-semibold text-slate-700 dark:text-slate-300">
        {t('deals.campaign_ended.stats_label')}
      </p>

      <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-slate-200 dark:bg-slate-800">
        <div
          class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-amber-400"
          style={`width: ${total > 0 ? Math.min(100, (claimed / total) * 100) : 100}%`}
        ></div>
      </div>

      <p class="mt-3 inline-flex w-full items-center justify-center gap-1.5 text-center text-xs font-bold uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
        {t('deals.campaign_ended.stats_status')}
      </p>
    </div>
  </div>
</section>
