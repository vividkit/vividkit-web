---
// deals-dev-preview: Dev-only error state previews for local testing
// Only rendered when import.meta.env.DEV is true
// Reads next_reset from Alpine store 'dealStatus' populated by claim widget — no extra /status fetch.
---

<div class="space-y-4 rounded-xl border-2 border-dashed border-red-300 p-6 dark:border-red-700">
  <div class="mb-2 flex items-center gap-2">
    <span class="rounded bg-red-500 px-2 py-0.5 text-xs font-bold text-white">DEV ONLY</span>
    <span class="text-sm font-bold text-red-600 dark:text-red-400">Error Messages & States Preview</span>
  </div>

  <div class="rounded-lg border border-rose-200 bg-rose-50 p-4 dark:border-rose-500/30 dark:bg-rose-900/20">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm font-bold text-rose-700 dark:text-rose-300">Reset local claim and raffle session</p>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
          Clears cached coupon claim, raffle session token, OAuth nonce, and Turnstile token in this browser.
        </p>
      </div>
      <button
        id="dev-reset-deals-auth"
        type="button"
        class="inline-flex min-h-10 shrink-0 items-center justify-center rounded-lg bg-rose-600 px-4 py-2 text-sm font-bold text-white transition hover:bg-rose-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-rose-300 dark:bg-rose-400 dark:text-slate-950 dark:hover:bg-rose-300 dark:focus-visible:ring-rose-800"
      >
        Reset auth cache
      </button>
    </div>
    <p id="dev-reset-deals-auth-status" class="mt-2 text-xs font-semibold text-rose-700 dark:text-rose-300" aria-live="polite"></p>
  </div>

  {/* not_yet — codes haven't dropped yet */}
  <div class="rounded-lg border border-violet-200 bg-violet-50 p-4 dark:border-violet-500/30 dark:bg-violet-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
      <span class="text-sm font-bold text-violet-700 dark:text-violet-300">not_yet (425)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">Codes haven't dropped yet for today.</p>
    <div class="rounded border border-violet-200/50 bg-violet-100/50 p-3 dark:border-violet-500/20 dark:bg-violet-900/30">
      <p class="mt-1 text-sm font-medium text-violet-700 dark:text-violet-300">
        Codes drop daily. Come back in:
      </p>
      <div class="mt-2 flex items-center gap-2">
        <span id="dev-not-yet-countdown" class="font-mono text-lg font-bold text-violet-600 dark:text-violet-400">--:--:--</span>
        <span id="dev-not-yet-local" class="text-xs text-slate-500"></span>
      </div>
    </div>
  </div>

  {/* daily_quota_exhausted — all codes claimed today */}
  <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 dark:border-amber-500/30 dark:bg-amber-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" /></svg>
      <span class="text-sm font-bold text-amber-700 dark:text-amber-300">daily_quota_exhausted (410)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">All codes for today have been claimed.</p>
    <div class="rounded border border-amber-200/50 bg-amber-100/50 p-3 dark:border-amber-500/20 dark:bg-amber-900/30">
      <p class="text-sm font-medium text-amber-700 dark:text-amber-300">All codes are claimed for today! New codes in:</p>
      <div class="mt-2 flex items-center gap-2">
        <span id="dev-exhausted-countdown" class="font-mono text-lg font-bold text-amber-600 dark:text-amber-400">--:--:--</span>
        <span id="dev-exhausted-local" class="text-xs text-slate-500"></span>
      </div>
      <p class="mt-2 text-xs text-slate-500">Tip: Bookmark this page and come back right after the reset!</p>
    </div>
  </div>

  {/* already_claimed — user already got a code */}
  <div class="rounded-lg border border-sky-200 bg-sky-50 p-4 dark:border-sky-500/30 dark:bg-sky-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
      <span class="text-sm font-bold text-sky-700 dark:text-sky-300">already_claimed (409)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">User already claimed their code.</p>
    <div class="rounded border border-sky-200/50 bg-sky-100/50 p-3 dark:border-sky-500/20 dark:bg-sky-900/30">
      <p class="text-sm font-medium text-sky-700 dark:text-sky-300">
        You already claimed your code! <span class="rounded bg-sky-200 px-1.5 py-0.5 font-mono dark:bg-sky-800">CK-XXXXX</span>
      </p>
      <p class="mt-1 text-xs text-slate-500">Claimed on 2026-05-10. One code per GitHub account.</p>
    </div>
  </div>

  {/* sold_out — campaign inactive */}
  <div class="rounded-lg border border-slate-300 bg-slate-100 p-4 dark:border-slate-600 dark:bg-slate-800/50">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /></svg>
      <span class="text-sm font-bold text-slate-600 dark:text-slate-300">sold_out (410)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">Campaign is paused or all codes are exhausted.</p>
    <div class="rounded border border-slate-300/50 bg-slate-200/50 p-3 dark:border-slate-600 dark:bg-slate-700/50">
      <p class="text-sm font-medium text-slate-600 dark:text-slate-300">The giveaway campaign is currently paused. Follow us for updates on the next drop!</p>
    </div>
  </div>

  {/* rate_limited */}
  <div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-500/30 dark:bg-red-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z" /></svg>
      <span class="text-sm font-bold text-red-700 dark:text-red-300">rate_limited (429)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">Too many claim attempts.</p>
    <div class="rounded border border-red-200/50 bg-red-100/50 p-3 dark:border-red-500/20 dark:bg-red-900/30">
      <p class="text-sm font-medium text-red-700 dark:text-red-300">Slow down! Too many attempts. Please wait an hour before trying again.</p>
    </div>
  </div>

  {/* unauthorized */}
  <div class="rounded-lg border border-orange-200 bg-orange-50 p-4 dark:border-orange-500/30 dark:bg-orange-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
      <span class="text-sm font-bold text-orange-700 dark:text-orange-300">unauthorized (401)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">Not signed in or session expired.</p>
    <div class="rounded border border-orange-200/50 bg-orange-100/50 p-3 dark:border-orange-500/20 dark:bg-orange-900/30">
      <p class="text-sm font-medium text-orange-700 dark:text-orange-300">Please sign in with GitHub to claim a code.</p>
      <button class="mt-2 inline-flex items-center gap-2 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-white dark:bg-white dark:text-slate-900">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" /></svg>
        Sign in with GitHub
      </button>
    </div>
  </div>

  {/* account_too_new */}
  <div class="rounded-lg border border-rose-200 bg-rose-50 p-4 dark:border-rose-500/30 dark:bg-rose-900/20">
    <div class="mb-2 flex items-center gap-3">
      <svg class="h-5 w-5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
      <span class="text-sm font-bold text-rose-700 dark:text-rose-300">account_too_new (redirect)</span>
    </div>
    <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">GitHub account created less than 30 days ago.</p>
    <div class="rounded border border-rose-200/50 bg-rose-100/50 p-3 dark:border-rose-500/20 dark:bg-rose-900/30">
      <p class="text-sm font-medium text-rose-700 dark:text-rose-300">Your GitHub account is too new. Accounts must be at least 30 days old to prevent abuse.</p>
    </div>
  </div>
</div>

<script>
  const $ = (sel: string) => document.getElementById(sel);

	  const sessionStorageKeysToClear = [
	    'raffle_session_token',
	    'turnstile_token',
	    'turnstile_token:claim',
	    'turnstile_token:raffle_status',
	    'turnstile_token:raffle_confirm_github_entry',
	    'turnstile_token:raffle_check_engagement',
	    'turnstile_token:raffle_register',
	    'turnstile_token:raffle_claim_prize',
	    'oauth_nonce:claim',
	    'oauth_nonce:raffle_status',
	    'oauth_nonce:raffle_confirm_github_entry',
	    'oauth_nonce:raffle_check_engagement',
	    'oauth_nonce:raffle_register',
	    'oauth_nonce:raffle_claim_prize',
	  ];

  function resetDealsAuthState() {
    try {
      localStorage.removeItem('vk-deal-claim');
    } catch {}

    sessionStorageKeysToClear.forEach((key) => {
      try {
        sessionStorage.removeItem(key);
      } catch {}
    });

    window.dispatchEvent(new CustomEvent('vividkit:deals-dev-reset-auth'));
    const status = $('dev-reset-deals-auth-status');
    if (status) status.textContent = 'Cleared local claim cache and raffle session keys. The claim widget was refreshed.';
    document.getElementById('claim')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  $('dev-reset-deals-auth')?.addEventListener('click', resetDealsAuthState);

  function formatCountdown(diff: number) {
    if (diff <= 0) return '00:00:00';
    const h = Math.floor(diff / 3_600_000);
    const m = Math.floor((diff % 3_600_000) / 60_000);
    const s = Math.floor((diff % 60_000) / 1000);
    return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function readNextReset(): string {
    const alpine = (window as any).Alpine;
    if (!alpine) return '';
    const store = alpine.store('dealStatus') as { nextReset?: string } | undefined;
    return store?.nextReset ?? '';
  }

  setInterval(() => {
    const nextResetISO = readNextReset();
    if (!nextResetISO) return;
    const diff = new Date(nextResetISO).getTime() - Date.now();
    const display = formatCountdown(diff);

    ['dev-not-yet-countdown', 'dev-exhausted-countdown'].forEach((id) => {
      const el = $(id);
      if (el) el.textContent = display;
    });

    ['dev-not-yet-local', 'dev-exhausted-local'].forEach((id) => {
      const el = $(id);
      if (el && !el.textContent) {
        const t = new Date(nextResetISO).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        el.textContent = `(${t} ${tz})`;
      }
    });
  }, 1000);
</script>
