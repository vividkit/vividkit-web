---
// deals-how-it-works: 3-step explainer for the claim flow
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import { SITE_CONFIG } from '@/data/constants';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const authorReferralCode = 'OMG49S8R';
const fallbackReferralUrl = 'https://claudekit.cc/?ref=OMG49S8R';
const referralUrl = (() => {
  try {
    const url = new URL(SITE_CONFIG.claudekitReferralUrl);
    url.searchParams.set('ref', authorReferralCode);
    return url.toString();
  } catch {
    return fallbackReferralUrl;
  }
})();

const steps = [
  {
    number: '1',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>`,
    titleKey: 'deals.how_it_works.step1.title' as const,
    descKey: 'deals.how_it_works.step1.desc' as const,
    badge: 'bg-gradient-to-br from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 ring-1 ring-emerald-400/50 dark:ring-emerald-400/30',
    iconTone: 'text-emerald-600 dark:text-emerald-400',
  },
  {
    number: '2',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
    titleKey: 'deals.how_it_works.step2.title' as const,
    descKey: 'deals.how_it_works.step2.desc' as const,
    badge: 'bg-gradient-to-br from-amber-400 to-amber-500 text-white shadow-lg shadow-amber-500/30 ring-1 ring-amber-300/60 dark:ring-amber-300/30',
    iconTone: 'text-amber-600 dark:text-amber-400',
  },
  {
    number: '3',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" /></svg>`,
    titleKey: 'deals.how_it_works.step3.title' as const,
    descKey: null,
    badge: 'bg-gradient-to-br from-sky-500 to-sky-600 text-white shadow-lg shadow-sky-500/30 ring-1 ring-sky-400/50 dark:ring-sky-400/30',
    iconTone: 'text-sky-600 dark:text-sky-400',
  },
];
---

<section class="rounded-[1.5rem] border border-slate-200 bg-white/75 p-5 dark:border-slate-800 dark:bg-slate-900/60">
  <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700 dark:text-emerald-300">{t('deals.how_it_works.kicker')}</p>
      <h2 class="mt-2 font-heading text-2xl font-black text-slate-950 dark:text-white sm:text-3xl">
        {t('deals.how_it_works.title')}
      </h2>
    </div>
    <p class="max-w-md text-sm leading-6 text-slate-600 dark:text-slate-400">
      {t('deals.how_it_works.summary')}
    </p>
  </div>

  <ol class="grid gap-3 lg:grid-cols-3">
    {steps.map((step) => (
      <li class="relative rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950/40">
        <div class="absolute left-[4.35rem] right-4 top-[4.05rem] h-px bg-slate-200 dark:bg-slate-800"></div>

        <div class="relative mb-4 flex items-center justify-between gap-3">
          <div class={`flex h-10 w-10 items-center justify-center rounded-full text-sm font-black ${step.badge}`}>
            {step.number}
          </div>
          <span class="rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-bold text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
            0{step.number}
          </span>
        </div>

        <div class={`mb-3 ${step.iconTone}`}>
          <Fragment set:html={step.icon} />
        </div>

        <h3 class="mb-1.5 font-heading text-lg font-bold text-slate-950 dark:text-white">
          {t(step.titleKey)}
        </h3>
        {step.number === '3' ? (
          <p class="text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('deals.how_it_works.step3.desc_before_link')}{' '}
            <a
              href={referralUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-emerald-700 underline decoration-emerald-300 underline-offset-4 hover:text-emerald-800 dark:text-emerald-300 dark:decoration-emerald-700 dark:hover:text-emerald-200"
            >
              {t('deals.how_it_works.step3.link_label')}
            </a>
            , {t('deals.how_it_works.step3.desc_after_link')}
          </p>
        ) : (
          <p class="text-sm leading-6 text-slate-600 dark:text-slate-400">
            {step.descKey ? t(step.descKey) : ''}
          </p>
        )}
      </li>
    ))}
  </ol>
</section>
