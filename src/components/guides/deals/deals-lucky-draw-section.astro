---
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import DealsLuckyDrawWidget from './deals-lucky-draw-widget.astro';
import { Ban, ShieldCheck } from 'lucide-astro';

interface Props {
  lang?: Language;
  isPageHeading?: boolean;
}

const { lang, isPageHeading = false } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const giveawayApiUrl = import.meta.env.PUBLIC_GIVEAWAY_API_URL;
const HeadingTag = isPageHeading ? 'h1' : 'h2';
const claimHref = `${translatePath('/guides/deals')}#claim`;
---

<section id="draw-console" class="w-full min-w-0 max-w-full scroll-mt-28">
  <div class="min-w-0 space-y-5">
    <div
      data-raffle-schedule-summary
      data-api-url={giveawayApiUrl}
      data-label-unknown={t('deals.raffle.schedule_unknown')}
      data-label-ready={t('deals.raffle.draw_countdown_ready')}
      data-label-reveal={t('deals.raffle.countdown_draw')}
      data-label-ended={t('deals.raffle.countdown_ended')}
      data-label-today-ended={t('deals.raffle.countdown_today_ended')}
      data-label-today-revealed={t('deals.raffle.countdown_today_revealed')}
      data-label-next-draw={t('deals.raffle.countdown_next_draw')}
      data-label-days={t('deals.raffle.countdown_days')}
      data-label-hours={t('deals.raffle.countdown_hours')}
      data-label-minutes={t('deals.raffle.countdown_minutes')}
      data-label-seconds={t('deals.raffle.countdown_seconds')}
      class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-sm shadow-slate-950/5 dark:border-slate-800 dark:bg-slate-900/60 sm:p-6"
    >
      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.62fr)] lg:items-start">
        <div class="min-w-0">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
            {t('deals.raffle.section_kicker')}
          </p>
          <HeadingTag class="mt-3 max-w-2xl font-heading text-3xl font-black leading-tight text-slate-950 dark:text-white sm:text-4xl">
            {t('deals.raffle.section_title')}
          </HeadingTag>
        </div>

        <div class="rounded-2xl border border-cyan-200 bg-white p-4 dark:border-cyan-300/20 dark:bg-slate-950/55">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-cyan-700 dark:text-cyan-300">{t('deals.raffle.draw_countdown_label')}</p>
          <p data-raffle-countdown class="mt-3 font-mono text-3xl font-black leading-none text-slate-950 dark:text-white sm:text-4xl">--:--:--</p>
          <p data-raffle-draw-time class="mt-3 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm font-semibold text-slate-600 dark:text-slate-300">--</p>
        </div>
      </div>

      <div class="mt-5 grid gap-3 md:grid-cols-3">
        <div class="rounded-xl border border-emerald-200 bg-white p-3 dark:border-emerald-500/20 dark:bg-slate-950/55">
          <p class="font-mono text-sm font-black text-emerald-700 dark:text-emerald-300">01</p>
          <p class="mt-1 text-sm font-black text-slate-950 dark:text-white">{t('deals.raffle.flow_github')}</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-white p-3 dark:border-amber-500/20 dark:bg-slate-950/55">
          <p class="font-mono text-sm font-black text-amber-700 dark:text-amber-300">02</p>
          <p class="mt-1 text-sm font-black text-slate-950 dark:text-white">{t('deals.raffle.flow_order')}</p>
        </div>
        <div class="rounded-xl border border-cyan-200 bg-white p-3 dark:border-cyan-500/20 dark:bg-slate-950/55">
          <p class="font-mono text-sm font-black text-cyan-700 dark:text-cyan-300">03</p>
          <p class="mt-1 text-sm font-black text-slate-950 dark:text-white">{t('deals.raffle.flow_register')}</p>
        </div>
      </div>

      <div class="mt-4 grid gap-3 md:grid-cols-2">
        <div class="group relative overflow-hidden rounded-2xl border border-amber-200 bg-amber-50/70 p-4 dark:border-amber-300/25 dark:bg-amber-300/10">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-800 ring-1 ring-amber-200 dark:bg-amber-300/15 dark:text-amber-100 dark:ring-amber-300/25">
              <ShieldCheck class="h-5 w-5" aria-hidden="true" />
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <p class="text-sm font-black text-slate-950 dark:text-white">{t('deals.raffle.rule_order_boost_title')}</p>
                <span class="rounded-full bg-slate-950 px-2 py-0.5 text-[0.68rem] font-black uppercase text-white dark:bg-amber-300 dark:text-slate-950">x2</span>
              </div>
              <p class="mt-1 text-sm font-semibold leading-6 text-slate-700 dark:text-slate-200">{t('deals.raffle.rule_order_boost')}</p>
            </div>
          </div>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/55">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:ring-slate-700">
              <Ban class="h-5 w-5" aria-hidden="true" />
            </div>
            <div class="min-w-0">
              <p class="text-sm font-black text-slate-950 dark:text-white">{t('deals.raffle.rule_decline_limit_title')}</p>
              <p class="mt-1 text-sm font-semibold leading-6 text-slate-700 dark:text-slate-200">{t('deals.raffle.rule_decline_limit')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <DealsLuckyDrawWidget lang={currentLang} claimHref={claimHref} />
  </div>
</section>

<script>
  type ScheduleConfig = {
    phase?: 'before_open' | 'registration_open' | 'registration_closed' | 'draw_ready' | 'reveal_ready' | 'inactive';
    registration_open_at?: string;
    registration_cutoff_at?: string;
    draw_at?: string;
    claim_window_hours?: number;
    reveal_interval_minutes?: number;
    ends_at?: string;
    seat_budget?: {
      total?: number;
    };
  };

  const scheduleSummary = document.querySelector<HTMLElement>('[data-raffle-schedule-summary]');
  const countdown = scheduleSummary?.querySelector<HTMLElement>('[data-raffle-countdown]');
  const drawTime = scheduleSummary?.querySelector<HTMLElement>('[data-raffle-draw-time]');
  let countdownTargetAt = '';
  let currentPhase: ScheduleConfig['phase'] | undefined;
  let isPostRevealComplete = false;
  let countdownTimer: number | undefined;

  const formatScheduleTime = (value: string | undefined) => {
    if (!value) return scheduleSummary?.dataset.labelUnknown || '--';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return scheduleSummary?.dataset.labelUnknown || '--';
    return new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZoneName: 'short',
    }).format(date);
  };

  const appendText = (element: HTMLElement, value: string, className?: string) => {
    const span = document.createElement('span');
    span.textContent = value;
    if (className) span.className = className;
    element.append(span);
  };

  const appendTimeCode = (element: HTMLElement, value: string) => {
    const code = document.createElement('code');
    code.textContent = value;
    code.className = 'max-w-full rounded-md border border-cyan-200 bg-cyan-50 px-1.5 py-0.5 font-mono text-[0.8125rem] font-black leading-6 text-cyan-800 shadow-sm shadow-cyan-900/5 break-words dark:border-cyan-400/25 dark:bg-cyan-400/10 dark:text-cyan-100';
    element.append(code);
  };

  const renderDrawTime = (value: string) => {
    if (!drawTime) return;
    drawTime.replaceChildren();
    if (!isPostRevealComplete) {
      appendText(drawTime, value);
      return;
    }

    appendText(drawTime, `${scheduleSummary?.dataset.labelTodayRevealed || ''} `);
    appendText(drawTime, `${scheduleSummary?.dataset.labelNextDraw || ''}: `);
    appendTimeCode(drawTime, value);
  };

  const renderCountdown = () => {
    if (!scheduleSummary || !countdown) return;
    if (currentPhase === 'inactive') {
      countdown.textContent = scheduleSummary.dataset.labelEnded || '--';
      return;
    }
    if (!countdownTargetAt) {
      countdown.textContent = '--:--:--';
      return;
    }
    if (isPostRevealComplete) {
      countdown.textContent = scheduleSummary.dataset.labelTodayEnded || scheduleSummary.dataset.labelEnded || '--';
      return;
    }
    const target = new Date(countdownTargetAt).getTime();
    const diff = target - Date.now();
    if (!Number.isFinite(target) || diff <= 0) {
      countdown.textContent = currentPhase === 'reveal_ready'
        ? scheduleSummary.dataset.labelReveal || scheduleSummary.dataset.labelReady || '--'
        : scheduleSummary.dataset.labelReady || '--';
      return;
    }
    const totalSeconds = Math.floor(diff / 1000);
    const days = Math.floor(totalSeconds / 86400);
    const hours = Math.floor((totalSeconds % 86400) / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    const two = (value: number) => String(value).padStart(2, '0');
    countdown.textContent = days > 0
      ? `${days}${scheduleSummary.dataset.labelDays || 'd'} ${two(hours)}:${two(minutes)}:${two(seconds)}`
      : `${two(hours)}:${two(minutes)}:${two(seconds)}`;
  };

  const resolveCountdownTarget = (config: ScheduleConfig, resultCount: number, poolCount: number) => {
    isPostRevealComplete = false;
    const drawDate = config.draw_at ? new Date(config.draw_at) : null;
    if (!drawDate || Number.isNaN(drawDate.getTime())) return '';
    if (config.phase === 'draw_ready' || config.phase === 'reveal_ready') {
      const expectedResults = Math.min(
        Math.max(Number(config.seat_budget?.total || 0), resultCount),
        poolCount > 0 ? poolCount : Number(config.seat_budget?.total || resultCount)
      );
      if (resultCount > 0 && resultCount >= expectedResults) {
        const nextDrawDate = new Date(drawDate.getTime() + 24 * 60 * 60 * 1000);
        const endsAt = config.ends_at ? new Date(config.ends_at).getTime() : Number.POSITIVE_INFINITY;
        if (nextDrawDate.getTime() < endsAt) {
          isPostRevealComplete = true;
          return nextDrawDate.toISOString();
        }
      }
    }
    return config.draw_at || '';
  };

  const renderScheduleSummary = (config: ScheduleConfig, resultCount = 0, poolCount = 0) => {
    currentPhase = config.phase;
    countdownTargetAt = resolveCountdownTarget(config, resultCount, poolCount);
    renderDrawTime(formatScheduleTime(countdownTargetAt));
    renderCountdown();
    if (countdownTimer) window.clearInterval(countdownTimer);
    countdownTimer = window.setInterval(renderCountdown, 1000);
  };

  if (scheduleSummary?.dataset.apiUrl) {
    fetch(`${scheduleSummary.dataset.apiUrl}/raffle/config`)
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(`HTTP ${res.status}`))))
      .then(async (config: ScheduleConfig) => {
        const [results, pool] = await Promise.all([
          fetch(`${scheduleSummary.dataset.apiUrl}/raffle/results`).then((res) => (res.ok ? res.json() : null)).catch(() => null),
          fetch(`${scheduleSummary.dataset.apiUrl}/raffle/pool`).then((res) => (res.ok ? res.json() : null)).catch(() => null),
        ]);
        renderScheduleSummary(
          config,
          Array.isArray(results?.results) ? results.results.length : 0,
          Array.isArray(pool?.entries) ? pool.entries.length : 0
        );
      })
      .catch(() => {
        if (countdown) countdown.textContent = '--:--:--';
        if (drawTime) drawTime.textContent = scheduleSummary.dataset.labelUnknown || '--';
      });
  }
</script>
