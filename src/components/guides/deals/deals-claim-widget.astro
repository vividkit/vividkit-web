    window.Alpine = Alpine;
    registerClaimWidget(Alpine);
    startAlpineOnce(Alpine);
  } else {
    registerClaimWidget(window.Alpine);
    const claimWidgetRoot = document.querySelector('[data-deals-claim-widget]');
    if (claimWidgetRoot && !(claimWidgetRoot as any)._x_dataStack) {
