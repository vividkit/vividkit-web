<script>
  import Alpine from 'alpinejs';
  import { registerScheduledDrawState } from '@/scripts/deals-scheduled-draw-state';

  const startAlpineOnce = (activeAlpine: typeof Alpine) => {
    if ((activeAlpine as any).__vividKitAlpineStartScheduled || (activeAlpine as any).__vividKitAlpineStarted) return;
    (activeAlpine as any).__vividKitAlpineStartScheduled = true;
    const start = () => {
      if ((activeAlpine as any).__vividKitAlpineStarted) return;
      (activeAlpine as any).__vividKitAlpineStarted = true;
      activeAlpine.start();
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      setTimeout(start, 0);
    }
  };

  if (!window.Alpine) {
    window.Alpine = Alpine;
    registerScheduledDrawState(Alpine);
    startAlpineOnce(Alpine);
  } else {
    registerScheduledDrawState(window.Alpine);
    const root = document.querySelector('[data-deals-raffle-widget]');
    if (root && !(root as any)._x_dataStack) window.Alpine.initTree(root);
  }
</script>
