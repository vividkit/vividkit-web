---
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import { AlertTriangle, RotateCcw, X } from 'lucide-astro';

interface Props {
  lang?: Language;
  claimHref?: string;
}

const { lang, claimHref = '#claim' } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const giveawayApiUrl = import.meta.env.PUBLIC_GIVEAWAY_API_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const isDev = import.meta.env.DEV;
---

<div
  data-deals-raffle-widget
  data-api-url={giveawayApiUrl}
  data-turnstile-key={turnstileSiteKey}
  data-dev-mode={isDev ? 'true' : 'false'}
  data-msg-error={t('deals.raffle.error')}
  data-msg-rate-limited={t('deals.raffle.rate_limited')}
  data-msg-decline-confirm={t('deals.raffle.decline_confirm')}
  data-msg-decline-unavailable={t('deals.raffle.decline_unavailable')}
  data-label-verify={t('deals.raffle.verify')}
  data-label-verify-for-prefix={t('deals.raffle.verify_for_prefix')}
  data-label-public-results-for={t('deals.raffle.public_results_for')}
  data-label-prize-status-pending={t('deals.raffle.prize_status_pending')}
  data-label-prize-status-claimed={t('deals.raffle.prize_status_claimed')}
  data-label-prize-status-declined={t('deals.raffle.prize_status_declined')}
  data-label-prize-status-rolled-over={t('deals.raffle.prize_status_rolled_over')}
  data-msg-order-boost-verified={t('deals.raffle.order_boost_verified')}
  data-msg-order-boost-normal={t('deals.raffle.order_boost_normal')}
  data-msg-order-boost-need-ref={t('deals.raffle.order_boost_need_ref')}
  data-msg-order-boost-already-bound={t('deals.raffle.order_boost_already_bound')}
  data-msg-order-boost-user-bound={t('deals.raffle.order_boost_user_bound')}
  data-msg-order-boost-error={t('deals.raffle.order_boost_error')}
  x-data="scheduledDrawWidget()"
  class="min-w-0"
>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.72fr)]">
    <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">{t('deals.raffle.flow_title')}</p>
          <p class="mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300" x-text="scheduleDate('registration_open_at')">--</p>
        </div>
        <div class="flex gap-2">
          <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-black text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-200">
            <span x-text="seatBudget.standard || '--'">--</span> {t('deals.raffle.standard')}
          </span>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-800 dark:bg-amber-400/15 dark:text-amber-200">
            <span x-text="seatBudget.premium || '--'">--</span> {t('deals.raffle.premium')}
          </span>
        </div>
      </div>

      <div class="mb-5 grid gap-2 sm:grid-cols-2">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 px-3 py-2 dark:border-emerald-500/20 dark:bg-emerald-500/10">
          <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">{t('deals.raffle.registration_open_short')}</p>
          <p class="mt-1 font-mono text-lg font-black text-slate-950 dark:text-white" x-text="scheduleTime('registration_open_at')">--</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50/70 px-3 py-2 dark:border-amber-500/20 dark:bg-amber-500/10">
          <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-amber-700 dark:text-amber-300">{t('deals.raffle.registration_cutoff_short')}</p>
          <p class="mt-1 font-mono text-lg font-black text-slate-950 dark:text-white" x-text="scheduleTime('registration_cutoff_at')">--</p>
        </div>
      </div>

    <p x-show="state === 'loading'" x-cloak class="text-sm font-semibold text-slate-600 dark:text-slate-300">
      {t('deals.raffle.status_loading')}
    </p>

    <div x-show="currentUsername" x-cloak class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm dark:border-slate-800 dark:bg-slate-900/70">
      <div class="min-w-0">
        <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{t('deals.raffle.current_github')}</p>
        <p class="mt-0.5 truncate font-mono font-black text-slate-950 dark:text-white" x-text="currentUsername || ''"></p>
      </div>
      <button type="button" x-on:click="switchGitHubAccount()" x-bind:disabled="state === 'confirming_github_entry' || state === 'registering' || state === 'claiming_prize'" class="inline-flex min-h-9 shrink-0 items-center rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-100 disabled:cursor-wait disabled:opacity-60 dark:bg-slate-950 dark:text-slate-200 dark:ring-slate-700 dark:hover:bg-slate-800">
        {t('deals.raffle.switch_github')}
      </button>
    </div>

    <div x-show="state === 'ready'" x-cloak class="space-y-4">
      <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">{t('deals.raffle.ready_desc')}</p>
      <button type="button" x-on:click="startGitHubEntryConfirm()" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-emerald-500/60 bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:border-emerald-400/50 dark:bg-emerald-600 dark:text-white dark:shadow-emerald-950/30 dark:hover:bg-emerald-500 dark:focus-visible:ring-emerald-800">
        {t('deals.raffle.sign_in')}
      </button>
    </div>

    <div x-show="state === 'needs_claim'" x-cloak class="space-y-4">
      <p class="text-sm font-semibold text-amber-800 dark:text-amber-200">{t('deals.raffle.needs_claim')}</p>
      <a href={claimHref} class="inline-flex min-h-11 items-center rounded-xl bg-amber-500 px-4 py-2 text-sm font-bold text-slate-950">
        {t('deals.claim.button_short')}
      </a>
    </div>

    <div x-show="state === 'needs_github_confirmation' || state === 'confirming_github_entry'" x-cloak class="space-y-4">
      <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.needs_payment')}</p>
      <button type="button" x-on:click="startGitHubEntryConfirm()" x-bind:disabled="state === 'confirming_github_entry'" class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-500 disabled:cursor-wait disabled:bg-emerald-700 disabled:opacity-85 dark:disabled:bg-emerald-700">
        <span x-show="state === 'confirming_github_entry'" x-cloak class="h-4 w-4 rounded-full border-2 border-white/40 border-t-white motion-safe:animate-pulse"></span>
        <span x-show="state === 'confirming_github_entry'" x-cloak>{t('deals.raffle.verifying')}</span>
        <span x-show="state !== 'confirming_github_entry'" x-text="verifyButtonLabel()">{t('deals.raffle.verify')}</span>
      </button>
    </div>

    <div x-show="state === 'eligible'" x-cloak class="space-y-4">
      <p class="text-lg font-black text-emerald-700 dark:text-emerald-300">{t('deals.raffle.eligible')}</p>
      <div class="grid gap-3 rounded-2xl border border-cyan-200 bg-cyan-50/70 p-4 dark:border-cyan-400/25 dark:bg-cyan-400/10">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <p class="text-xs font-black uppercase tracking-[0.14em] text-cyan-700 dark:text-cyan-200">{t('deals.raffle.order_boost_title')}</p>
            <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-200">{t('deals.raffle.order_boost_desc')}</p>
          </div>
          <span x-show="hasVividKitReferralBoost" x-cloak title={t('deals.raffle.order_boost_tooltip')} aria-label={t('deals.raffle.order_boost_tooltip')} class="inline-flex shrink-0 items-center overflow-hidden rounded-full text-xs font-black uppercase ring-1 ring-amber-300 dark:ring-amber-300/25">
            <span class="bg-amber-100 px-2.5 py-1 text-amber-900 dark:bg-amber-300/15 dark:text-amber-100">{t('deals.raffle.order_boost_badge')}</span>
            <span class="bg-slate-950 px-2.5 py-1 text-white dark:bg-amber-300 dark:text-slate-950">{t('deals.raffle.order_boost_multiplier')}</span>
          </span>
        </div>
        <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto]">
          <input x-model="orderRefInput" type="text" autocomplete="off" inputmode="text" placeholder={t('deals.raffle.order_ref_placeholder')} class="min-h-12 w-full rounded-xl border border-cyan-200 bg-white px-4 text-base font-semibold text-slate-950 outline-none transition focus:border-cyan-500 focus:ring-4 focus:ring-cyan-200/70 dark:border-cyan-400/25 dark:bg-slate-950 dark:text-white dark:focus:border-cyan-300 dark:focus:ring-cyan-400/15" />
          <button type="button" x-on:click="startVerifyOrder()" x-bind:disabled="orderBoostStatus === 'checking'" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-cyan-700 px-4 py-2 text-sm font-bold text-white transition hover:bg-cyan-600 disabled:cursor-wait disabled:opacity-70 dark:bg-cyan-500 dark:text-slate-950 dark:hover:bg-cyan-400">
            <span x-show="orderBoostStatus !== 'checking'">{t('deals.raffle.order_boost_verify')}</span>
            <span x-show="orderBoostStatus === 'checking'" x-cloak>{t('deals.raffle.order_boost_checking')}</span>
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p x-show="orderBoostStatus === 'verified'" x-cloak class="text-sm font-bold text-emerald-700 dark:text-emerald-300" x-text="orderMessage || MSG_ORDER_BOOST_VERIFIED">{t('deals.raffle.order_boost_verified')}</p>
          <p x-show="orderBoostStatus === 'normal'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200" x-text="orderMessage || MSG_ORDER_BOOST_NORMAL">{t('deals.raffle.order_boost_normal')}</p>
          <p x-show="orderBoostStatus === 'error'" x-cloak class="text-sm font-semibold text-amber-800 dark:text-amber-200" x-text="orderMessage || MSG_ORDER_BOOST_ERROR">{t('deals.raffle.order_boost_need_ref')}</p>
          <button type="button" x-on:click="orderGuideOpen = true" class="cursor-pointer text-sm font-bold text-cyan-800 underline decoration-cyan-300 underline-offset-4 hover:text-cyan-600 dark:text-cyan-200 dark:decoration-cyan-500/60 dark:hover:text-cyan-100">
            {t('deals.raffle.order_guide_button')}
          </button>
        </div>
      </div>
      <button type="button" x-on:click="startRegister()" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-900/20 transition hover:bg-emerald-500">
        {t('deals.raffle.register')}
      </button>
    </div>

    <div x-show="state === 'decline_blocked'" x-cloak class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-500/30 dark:bg-amber-500/10">
      <p class="text-sm font-black text-amber-900 dark:text-amber-100">{t('deals.raffle.decline_blocked_title')}</p>
      <p class="mt-2 text-sm leading-6 text-amber-950 dark:text-amber-100">{t('deals.raffle.decline_blocked_desc')}</p>
      <p class="mt-3 font-mono text-sm font-black text-slate-950 dark:text-white"><span x-text="declineCount"></span>/<span x-text="declineLimit"></span></p>
    </div>

    <p x-show="state === 'registering'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.registering')}</p>
    <p x-show="state === 'registered'" x-cloak class="text-sm font-bold text-emerald-700 dark:text-emerald-300">{t('deals.raffle.registered')}</p>
    <div x-show="state === 'draw_pending'" x-cloak class="space-y-3">
      <p x-show="!hasRevealedResults()" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.draw_pending')}</p>
      <p x-show="hasRevealedResults() && !hasFullyRevealedResults()" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.draw_revealing')}</p>
      <p x-show="hasFullyRevealedResults()" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.draw_revealed')}</p>
      <div x-show="publicResults.length && !currentUsername" x-cloak class="space-y-3 rounded-xl border border-emerald-200 bg-emerald-50/70 p-4 dark:border-emerald-500/20 dark:bg-emerald-500/10">
        <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-100">{t('deals.raffle.check_results_desc')}</p>
        <button type="button" x-on:click="startStatusCheck()" class="inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:focus-visible:ring-emerald-800">
          {t('deals.raffle.check_results')}
        </button>
      </div>
    </div>

    <div x-show="state === 'winner_revealed'" x-cloak class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/60 dark:bg-emerald-950/30">
      <p class="text-sm font-black text-emerald-800 dark:text-emerald-200">{t('deals.raffle.winner')}</p>
      <dl class="mt-4 grid gap-3 text-sm md:grid-cols-3">
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.prize')}</dt>
          <dd class="mt-1 break-words font-mono font-bold text-slate-950 dark:text-white" x-text="privateWinner?.prize_tier"></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.github')}</dt>
          <dd class="mt-1 break-words font-mono font-bold text-slate-950 dark:text-white" x-text="privateWinner?.facebook_name || privateWinner?.github_username"></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.deadline')}</dt>
          <dd class="mt-1 break-words font-semibold text-slate-950 dark:text-white" x-text="scheduleText.call({ schedule: { claim_deadline_at: privateWinner?.claim_deadline_at } }, 'claim_deadline_at')"></dd>
        </div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" x-on:click="startClaimPrize()" class="inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white">
          {t('deals.raffle.claim_prize')}
        </button>
        <button type="button" x-on:click="startDeclinePrize()" class="inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-bold text-amber-900 transition hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-amber-300/40 dark:border-amber-400/25 dark:bg-amber-400/10 dark:text-amber-100 dark:hover:bg-amber-400/15">
          {t('deals.raffle.decline_prize')}
        </button>
      </div>
    </div>

    <p x-show="state === 'declining_prize'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.declining_prize')}</p>
    <div x-show="state === 'prize_declined'" x-cloak class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-500/30 dark:bg-amber-500/10">
      <p class="text-sm font-black text-amber-900 dark:text-amber-100">{t('deals.raffle.prize_declined')}</p>
    </div>

    <div x-show="state === 'proof_ready'" x-cloak class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/60 dark:bg-emerald-950/30">
      <p class="text-sm font-black text-emerald-800 dark:text-emerald-200">{t('deals.raffle.proof_ready')}</p>
      <dl class="mt-4 grid gap-3 text-sm md:grid-cols-3">
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.prize')}</dt><dd class="mt-1 font-mono font-bold text-slate-950 dark:text-white" x-text="proof?.prize_tier"></dd></div>
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.github')}</dt><dd class="mt-1 font-mono font-bold text-slate-950 dark:text-white" x-text="proof?.facebook_name || proof?.github_username"></dd></div>
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.deadline')}</dt><dd class="mt-1 font-semibold text-slate-950 dark:text-white" x-text="scheduleText.call({ schedule: { claim_deadline_at: proof?.claim_deadline_at } }, 'claim_deadline_at')"></dd></div>
      </dl>
      <div class="mt-5 border-t border-emerald-200 pt-5 dark:border-emerald-800/80">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <a href="https://t.me/THIEUNV" target="_blank" rel="noopener noreferrer" class="inline-flex h-32 w-32 shrink-0 items-center justify-center rounded-xl bg-white p-2 shadow-sm ring-1 ring-emerald-200 transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:ring-emerald-900/80">
            <img src="/guides/deals/telegram-thieunv-qr.svg" alt={t('deals.raffle.telegram_qr_alt')} class="h-full w-full" loading="lazy" decoding="async" />
          </a>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-black uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">{t('deals.raffle.contact_title')}</p>
            <p class="mt-2 text-sm leading-6 text-emerald-900 dark:text-emerald-100">{t('deals.raffle.telegram')}</p>
            <div class="mt-4 grid gap-2">
              <a href="https://t.me/THIEUNV" target="_blank" rel="noopener noreferrer" class="group flex min-h-14 min-w-0 items-center gap-3 rounded-lg bg-emerald-700 px-3 py-2 text-white transition hover:bg-emerald-600 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:bg-emerald-500 dark:text-emerald-950 dark:hover:bg-emerald-400">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15 text-white dark:bg-emerald-950/15 dark:text-emerald-950" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M9.04 15.49 8.65 20c.56 0 .8-.24 1.09-.53l2.62-2.5 5.43 3.98c.99.55 1.7.26 1.96-.91l3.56-16.67.01-.01c.32-1.47-.53-2.04-1.5-1.68L.9 9.69c-1.42.55-1.4 1.34-.24 1.7l5.35 1.67L18.43 5.3c.58-.39 1.12-.17.68.22L9.04 15.49Z"></path></svg>
                </span>
                <span class="min-w-0">
                  <span class="block text-[0.68rem] font-black uppercase tracking-[0.1em]">{t('deals.raffle.telegram_label')}</span>
                  <span class="block truncate font-mono text-sm font-black">@thieunv</span>
                </span>
              </a>
              <a href="https://www.facebook.com/shinantori" target="_blank" rel="noopener noreferrer" class="group flex min-h-14 min-w-0 items-center gap-3 rounded-lg bg-white px-3 py-2 text-emerald-900 ring-1 ring-emerald-200 transition hover:bg-emerald-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:bg-emerald-950 dark:text-emerald-100 dark:ring-emerald-800 dark:hover:bg-emerald-900">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-600 text-white" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor"><path d="M14.2 8.4V6.7c0-.82.2-1.24 1.34-1.24H17V2.2C16.3 2.1 15.55 2 14.78 2c-3.05 0-5.13 1.86-5.13 5.28V8.4H6.2v3.64h3.45V22h4.12v-9.96h3.05l.48-3.64h-3.1Z"></path></svg>
                </span>
                <span class="min-w-0">
                  <span class="block text-[0.68rem] font-black uppercase tracking-[0.1em]">{t('deals.raffle.facebook_label')}</span>
                  <span class="block truncate font-mono text-sm font-black">shinantori</span>
                </span>
              </a>
              <a href="https://discordapp.com/users/thieunguyen_41895" target="_blank" rel="noopener noreferrer" class="group flex min-h-14 min-w-0 items-center gap-3 rounded-lg bg-white px-3 py-2 text-emerald-900 ring-1 ring-emerald-200 transition hover:bg-emerald-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:bg-emerald-950 dark:text-emerald-100 dark:ring-emerald-800 dark:hover:bg-emerald-900">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-white" aria-hidden="true">
