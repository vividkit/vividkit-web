---
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import { AlertTriangle, RotateCcw, X } from 'lucide-astro';

interface Props {
  lang?: Language;
  claimHref?: string;
}

const { lang, claimHref = '#claim' } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const giveawayApiUrl = import.meta.env.PUBLIC_GIVEAWAY_API_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const isDev = import.meta.env.DEV;
---

<div
  data-deals-raffle-widget
  data-api-url={giveawayApiUrl}
  data-turnstile-key={turnstileSiteKey}
  data-dev-mode={isDev ? 'true' : 'false'}
  data-msg-error={t('deals.raffle.error')}
  data-msg-rate-limited={t('deals.raffle.rate_limited')}
  data-msg-decline-confirm={t('deals.raffle.decline_confirm')}
  data-msg-decline-unavailable={t('deals.raffle.decline_unavailable')}
  data-label-verify={t('deals.raffle.verify')}
  data-label-verify-for-prefix={t('deals.raffle.verify_for_prefix')}
  data-label-public-results-for={t('deals.raffle.public_results_for')}
  data-label-prize-status-pending={t('deals.raffle.prize_status_pending')}
  data-label-prize-status-claimed={t('deals.raffle.prize_status_claimed')}
  data-label-prize-status-declined={t('deals.raffle.prize_status_declined')}
  data-label-prize-status-rolled-over={t('deals.raffle.prize_status_rolled_over')}
  x-data="scheduledDrawWidget()"
  class="min-w-0"
>
  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.72fr)]">
    <div class="rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">{t('deals.raffle.flow_title')}</p>
          <p class="mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300" x-text="scheduleDate('registration_open_at')">--</p>
        </div>
        <div class="flex gap-2">
          <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-black text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-200">
            <span x-text="seatBudget.standard || '--'">--</span> {t('deals.raffle.standard')}
          </span>
          <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-black text-amber-800 dark:bg-amber-400/15 dark:text-amber-200">
            <span x-text="seatBudget.premium || '--'">--</span> {t('deals.raffle.premium')}
          </span>
        </div>
      </div>

      <div class="mb-5 grid gap-2 sm:grid-cols-2">
        <div class="rounded-xl border border-emerald-200 bg-emerald-50/70 px-3 py-2 dark:border-emerald-500/20 dark:bg-emerald-500/10">
          <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-emerald-700 dark:text-emerald-300">{t('deals.raffle.registration_open_short')}</p>
          <p class="mt-1 font-mono text-lg font-black text-slate-950 dark:text-white" x-text="scheduleTime('registration_open_at')">--</p>
        </div>
        <div class="rounded-xl border border-amber-200 bg-amber-50/70 px-3 py-2 dark:border-amber-500/20 dark:bg-amber-500/10">
          <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-amber-700 dark:text-amber-300">{t('deals.raffle.registration_cutoff_short')}</p>
          <p class="mt-1 font-mono text-lg font-black text-slate-950 dark:text-white" x-text="scheduleTime('registration_cutoff_at')">--</p>
        </div>
      </div>

    <p x-show="state === 'loading'" x-cloak class="text-sm font-semibold text-slate-600 dark:text-slate-300">
      {t('deals.raffle.status_loading')}
    </p>

    <div x-show="currentUsername" x-cloak class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-sm dark:border-slate-800 dark:bg-slate-900/70">
      <div class="min-w-0">
        <p class="text-[0.68rem] font-black uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">{t('deals.raffle.current_github')}</p>
        <p class="mt-0.5 truncate font-mono font-black text-slate-950 dark:text-white" x-text="currentUsername || ''"></p>
      </div>
      <button type="button" x-on:click="switchGitHubAccount()" x-bind:disabled="state === 'checking_engagement' || state === 'registering' || state === 'claiming_prize'" class="inline-flex min-h-9 shrink-0 items-center rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-slate-700 ring-1 ring-slate-200 transition hover:bg-slate-100 disabled:cursor-wait disabled:opacity-60 dark:bg-slate-950 dark:text-slate-200 dark:ring-slate-700 dark:hover:bg-slate-800">
        {t('deals.raffle.switch_github')}
      </button>
    </div>

    <div x-show="state === 'ready'" x-cloak class="space-y-4">
      <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">{t('deals.raffle.ready_desc')}</p>
      <button type="button" x-on:click="startEngagementCheck()" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-emerald-500/60 bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:border-emerald-400/50 dark:bg-emerald-600 dark:text-white dark:shadow-emerald-950/30 dark:hover:bg-emerald-500 dark:focus-visible:ring-emerald-800">
        {t('deals.raffle.sign_in')}
      </button>
    </div>

    <div x-show="state === 'needs_claim'" x-cloak class="space-y-4">
      <p class="text-sm font-semibold text-amber-800 dark:text-amber-200">{t('deals.raffle.needs_claim')}</p>
      <a href={claimHref} class="inline-flex min-h-11 items-center rounded-xl bg-amber-500 px-4 py-2 text-sm font-bold text-slate-950">
        {t('deals.claim.button_short')}
      </a>
    </div>

    <div x-show="state === 'needs_engagement' || state === 'checking_engagement'" x-cloak class="space-y-4">
      <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.needs_payment')}</p>
      <button type="button" x-on:click="startEngagementCheck()" x-bind:disabled="state === 'checking_engagement'" class="inline-flex min-h-12 items-center gap-2 rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white transition hover:bg-emerald-500 disabled:cursor-wait disabled:bg-emerald-700 disabled:opacity-85 dark:disabled:bg-emerald-700">
        <span x-show="state === 'checking_engagement'" x-cloak class="h-4 w-4 rounded-full border-2 border-white/40 border-t-white motion-safe:animate-pulse"></span>
        <span x-show="state === 'checking_engagement'" x-cloak>{t('deals.raffle.verifying')}</span>
        <span x-show="state !== 'checking_engagement'" x-text="verifyButtonLabel()">{t('deals.raffle.verify')}</span>
      </button>
    </div>

    <div x-show="state === 'eligible'" x-cloak class="space-y-4">
      <p class="text-lg font-black text-emerald-700 dark:text-emerald-300">{t('deals.raffle.eligible')}</p>
      <button type="button" x-on:click="startRegister()" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-900/20 transition hover:bg-emerald-500">
        {t('deals.raffle.register')}
      </button>
    </div>

    <p x-show="state === 'registering'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.registering')}</p>
    <p x-show="state === 'registered'" x-cloak class="text-sm font-bold text-emerald-700 dark:text-emerald-300">{t('deals.raffle.registered')}</p>
    <p x-show="state === 'draw_pending'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.draw_pending')}</p>

    <div x-show="state === 'winner_revealed'" x-cloak class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/60 dark:bg-emerald-950/30">
      <p class="text-sm font-black text-emerald-800 dark:text-emerald-200">{t('deals.raffle.winner')}</p>
      <dl class="mt-4 grid gap-3 text-sm md:grid-cols-3">
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.prize')}</dt>
          <dd class="mt-1 break-words font-mono font-bold text-slate-950 dark:text-white" x-text="privateWinner?.prize_tier"></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.github')}</dt>
          <dd class="mt-1 break-words font-mono font-bold text-slate-950 dark:text-white" x-text="privateWinner?.facebook_name || privateWinner?.github_username"></dd>
        </div>
        <div class="min-w-0">
          <dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.deadline')}</dt>
          <dd class="mt-1 break-words font-semibold text-slate-950 dark:text-white" x-text="scheduleText.call({ schedule: { claim_deadline_at: privateWinner?.claim_deadline_at } }, 'claim_deadline_at')"></dd>
        </div>
      </dl>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" x-on:click="startClaimPrize()" class="inline-flex min-h-11 cursor-pointer items-center rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white">
          {t('deals.raffle.claim_prize')}
        </button>
        <button type="button" x-on:click="startDeclinePrize()" class="inline-flex min-h-11 cursor-pointer items-center rounded-xl border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-bold text-amber-900 transition hover:bg-amber-100 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-amber-300/40 dark:border-amber-400/25 dark:bg-amber-400/10 dark:text-amber-100 dark:hover:bg-amber-400/15">
          {t('deals.raffle.decline_prize')}
        </button>
      </div>
    </div>

    <p x-show="state === 'declining_prize'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.declining_prize')}</p>
    <div x-show="state === 'prize_declined'" x-cloak class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-500/30 dark:bg-amber-500/10">
      <p class="text-sm font-black text-amber-900 dark:text-amber-100">{t('deals.raffle.prize_declined')}</p>
    </div>

    <div x-show="state === 'proof_ready'" x-cloak class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 dark:border-emerald-900/60 dark:bg-emerald-950/30">
      <p class="text-sm font-black text-emerald-800 dark:text-emerald-200">{t('deals.raffle.proof_ready')}</p>
      <dl class="mt-4 grid gap-3 text-sm md:grid-cols-3">
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.prize')}</dt><dd class="mt-1 font-mono font-bold text-slate-950 dark:text-white" x-text="proof?.prize_tier"></dd></div>
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.github')}</dt><dd class="mt-1 font-mono font-bold text-slate-950 dark:text-white" x-text="proof?.facebook_name || proof?.github_username"></dd></div>
        <div><dt class="text-xs font-bold uppercase text-emerald-700 dark:text-emerald-300">{t('deals.raffle.deadline')}</dt><dd class="mt-1 font-semibold text-slate-950 dark:text-white" x-text="scheduleText.call({ schedule: { claim_deadline_at: proof?.claim_deadline_at } }, 'claim_deadline_at')"></dd></div>
      </dl>
      <p class="mt-4 text-sm leading-6 text-emerald-900 dark:text-emerald-100">{t('deals.raffle.telegram')}</p>
    </div>

    <p x-show="state === 'claiming_prize'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.claiming_prize')}</p>
    <p x-show="state === 'claim_expired'" x-cloak class="text-sm font-semibold text-amber-800 dark:text-amber-200">{t('deals.raffle.claim_expired')}</p>
    <div x-show="state === 'before_open'" x-cloak class="space-y-3">
      <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.before_start')}</p>
      <button type="button" x-show="publicResults.length" x-cloak x-on:click="startEngagementCheck()" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-emerald-500/60 bg-emerald-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 dark:border-emerald-400/50 dark:bg-emerald-600 dark:text-white dark:shadow-emerald-950/30 dark:hover:bg-emerald-500 dark:focus-visible:ring-emerald-800">
        {t('deals.raffle.sign_in')}
      </button>
      <button type="button" x-show="!publicResults.length" x-cloak disabled class="inline-flex min-h-12 cursor-not-allowed items-center justify-center rounded-xl border border-slate-300 bg-slate-100 px-5 py-3 text-sm font-bold text-slate-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
        {t('deals.raffle.registration_not_open')}
      </button>
    </div>
    <p x-show="state === 'closed'" x-cloak class="text-sm font-semibold text-slate-700 dark:text-slate-200">{t('deals.raffle.ended')}</p>

    <div x-show="state === 'error'" x-cloak class="space-y-3">
      <p class="text-sm font-semibold text-rose-700 dark:text-rose-300" x-text="errorMessage || MSG_ERROR"></p>
      <button type="button" x-on:click="loadConfig()" class="inline-flex min-h-10 items-center rounded-xl bg-slate-100 px-4 py-2 text-sm font-bold text-slate-800 dark:bg-slate-800 dark:text-slate-100">
        {t('deals.claim.retry')}
      </button>
    </div>
    </div>

    <aside class="self-start rounded-2xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/60">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">{t('deals.raffle.pool_title')}</p>
        <p class="mt-1 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <span x-text="poolEntries.length">0</span> {t('deals.raffle.pool_count')}
        </p>
      </div>

      <div class="raffle-pool-scroll mt-4 max-h-80 space-y-2 overflow-y-auto pr-1 overscroll-contain lg:max-h-96" x-show="poolEntries.length" x-cloak>
        <template x-for="entry in poolEntries" :key="entry.id || entry.github_username || entry.github_id || entry.username">
          <div class="flex min-w-0 items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm dark:border-slate-800 dark:bg-slate-950/65">
            <span class="min-w-0 truncate font-mono font-black text-slate-950 dark:text-white" x-text="poolEntryName(entry)"></span>
            <span class="shrink-0 rounded-full bg-emerald-100 px-2 py-1 text-[0.68rem] font-black uppercase text-emerald-800 dark:bg-emerald-400/15 dark:text-emerald-200" x-text="poolEntryStatusLabel(entry)"></span>
          </div>
        </template>
      </div>

      <p x-show="!poolEntries.length" x-cloak class="mt-4 rounded-xl border border-dashed border-slate-300 p-4 text-sm leading-6 text-slate-600 dark:border-slate-700 dark:text-slate-300">
        {t('deals.raffle.pool_empty')}
      </p>
    </aside>
  </div>

  <div x-show="publicResults.length" x-cloak class="mt-5 rounded-2xl border border-slate-200 p-5 dark:border-slate-800">
    <p class="text-xs font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400" x-text="publicResultsLabel()">{t('deals.raffle.public_results')}</p>
    <div class="mt-3 grid gap-2">
      <template x-for="result in publicResults" :key="`${result.facebook_name || result.github_username}-${result.prize_tier}`">
        <div class="flex min-w-0 flex-col gap-3 rounded-xl bg-slate-50 px-3 py-2 text-sm dark:bg-slate-900 sm:flex-row sm:items-center sm:justify-between">
          <span class="min-w-0 break-all font-mono font-bold text-slate-950 dark:text-white" x-text="result.facebook_name || result.github_username"></span>
          <span class="flex shrink-0 flex-wrap gap-2">
            <span
              class="rounded-full px-2 py-1 text-xs font-black uppercase ring-1"
              x-bind:class="prizeTierBadgeClass(result.prize_tier)"
              x-text="result.prize_tier"
            ></span>
            <span
              class="rounded-full px-2 py-1 text-xs font-black uppercase ring-1"
              x-bind:class="prizeStatusBadgeClass(result.claim_status || result.fulfillment_status)"
              x-text="prizeStatusLabel(result.claim_status || result.fulfillment_status)"
            ></span>
          </span>
        </div>
      </template>
    </div>
  </div>

  {isDev && (
    <div class="mt-5 rounded-2xl border-2 border-dashed border-rose-300 bg-rose-50/80 p-4 dark:border-rose-500/40 dark:bg-rose-950/20">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="rounded bg-rose-600 px-2 py-0.5 text-xs font-black uppercase tracking-[0.12em] text-white">DEV ONLY</span>
          <p class="mt-2 text-sm font-bold text-rose-900 dark:text-rose-100">Lucky draw screen lab</p>
          <p class="mt-1 text-xs leading-5 text-rose-800/80 dark:text-rose-100/75">Local-only controls. Click a case to force the live widget into that screen with mock data.</p>
        </div>
        <button type="button" x-on:click="loadConfig()" class="inline-flex min-h-9 items-center rounded-lg bg-white px-3 py-1.5 text-xs font-bold text-rose-700 shadow-sm ring-1 ring-rose-200 transition hover:bg-rose-100 dark:bg-rose-950 dark:text-rose-100 dark:ring-rose-500/40 dark:hover:bg-rose-900">
          Reset API state
        </button>
      </div>

      <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        <button type="button" x-on:click="applyDevScenario('loading')" class="min-h-9 rounded-lg bg-slate-900 px-3 py-2 text-left text-xs font-bold text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">Loading</button>
        <button type="button" x-on:click="applyDevScenario('before_open')" class="min-h-9 rounded-lg bg-violet-100 px-3 py-2 text-left text-xs font-bold text-violet-800 transition hover:bg-violet-200 dark:bg-violet-500/20 dark:text-violet-100">Before open</button>
        <button type="button" x-on:click="applyDevScenario('ready')" class="min-h-9 rounded-lg bg-emerald-100 px-3 py-2 text-left text-xs font-bold text-emerald-800 transition hover:bg-emerald-200 dark:bg-emerald-500/20 dark:text-emerald-100">Ready / sign in</button>
        <button type="button" x-on:click="applyDevScenario('needs_claim')" class="min-h-9 rounded-lg bg-amber-100 px-3 py-2 text-left text-xs font-bold text-amber-800 transition hover:bg-amber-200 dark:bg-amber-500/20 dark:text-amber-100">Needs coupon</button>
        <button type="button" x-on:click="applyDevScenario('needs_engagement')" class="min-h-9 rounded-lg bg-sky-100 px-3 py-2 text-left text-xs font-bold text-sky-800 transition hover:bg-sky-200 dark:bg-sky-500/20 dark:text-sky-100">Needs engagement</button>
        <button type="button" x-on:click="applyDevScenario('invalid_order')" class="min-h-9 rounded-lg bg-rose-100 px-3 py-2 text-left text-xs font-bold text-rose-800 transition hover:bg-rose-200 dark:bg-rose-500/20 dark:text-rose-100">Invalid account</button>
        <button type="button" x-on:click="applyDevScenario('chiennb_wrong_account')" class="min-h-9 rounded-lg bg-fuchsia-100 px-3 py-2 text-left text-xs font-bold text-fuchsia-800 transition hover:bg-fuchsia-200 dark:bg-fuchsia-500/20 dark:text-fuchsia-100">ChienNB wrong account</button>
        <button type="button" x-on:click="applyDevScenario('chiennb_order_bound')" class="min-h-9 rounded-lg bg-rose-100 px-3 py-2 text-left text-xs font-bold text-rose-800 transition hover:bg-rose-200 dark:bg-rose-500/20 dark:text-rose-100">ChienNB needs check</button>
        <button type="button" x-on:click="applyDevScenario('chiennb_ready')" class="min-h-9 rounded-lg bg-emerald-100 px-3 py-2 text-left text-xs font-bold text-emerald-800 transition hover:bg-emerald-200 dark:bg-emerald-500/20 dark:text-emerald-100">ChienNB ready</button>
        <button type="button" x-on:click="applyDevScenario('checking_engagement')" class="min-h-9 rounded-lg bg-cyan-100 px-3 py-2 text-left text-xs font-bold text-cyan-800 transition hover:bg-cyan-200 dark:bg-cyan-500/20 dark:text-cyan-100">Checking</button>
        <button type="button" x-on:click="applyDevScenario('eligible')" class="min-h-9 rounded-lg bg-emerald-100 px-3 py-2 text-left text-xs font-bold text-emerald-800 transition hover:bg-emerald-200 dark:bg-emerald-500/20 dark:text-emerald-100">Eligible</button>
        <button type="button" x-on:click="applyDevScenario('registering')" class="min-h-9 rounded-lg bg-slate-100 px-3 py-2 text-left text-xs font-bold text-slate-800 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100">Registering</button>
        <button type="button" x-on:click="applyDevScenario('registered')" class="min-h-9 rounded-lg bg-emerald-100 px-3 py-2 text-left text-xs font-bold text-emerald-800 transition hover:bg-emerald-200 dark:bg-emerald-500/20 dark:text-emerald-100">Registered</button>
        <button type="button" x-on:click="applyDevScenario('draw_pending')" class="min-h-9 rounded-lg bg-slate-100 px-3 py-2 text-left text-xs font-bold text-slate-800 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100">Draw pending</button>
        <button type="button" x-on:click="applyDevScenario('winner_revealed')" class="min-h-9 rounded-lg bg-teal-100 px-3 py-2 text-left text-xs font-bold text-teal-800 transition hover:bg-teal-200 dark:bg-teal-500/20 dark:text-teal-100">Winner revealed</button>
