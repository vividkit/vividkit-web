---
import { ArrowRight, Bot, BookOpen, Command, ExternalLink, Map, SquareTerminal } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import {
  WHAT_IS_CLAUDEKIT_FACTS,
  WHAT_IS_CLAUDEKIT_SOURCES,
} from '@/data/guides/agentkit/what-is-claudekit-facts';
import {
  getAgentKitSkillInvocation,
  getAgentKitTargetViews,
} from '@/data/guides/agentkit/agentkit-target-capabilities';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'vi' ? '/vi' : '';

const targetViews = getAgentKitTargetViews();
if (
  targetViews.length !== WHAT_IS_CLAUDEKIT_FACTS.currentTargets.length
  || targetViews.some(({ target }) => !WHAT_IS_CLAUDEKIT_FACTS.currentTargets.includes(target))
) {
  throw new Error('What-is-ClaudeKit target facts drifted from canonical AgentKit targets.');
}

const targets = targetViews.map((target) => ({
  ...target,
  icon: target.target === 'claude-code' ? Bot : SquareTerminal,
  body: target.target === 'claude-code'
    ? t('what_is_ck.targets.claude.body')
    : t('what_is_ck.targets.codex.body'),
  invocation: getAgentKitSkillInvocation(target.target, 'cook'),
}));

const nextGuides = [
  {
    icon: Map,
    href: `${prefix}/guides/agentkit`,
    title: t('what_is_ck.next.migrate.title'),
    body: t('what_is_ck.next.migrate.body'),
    cta: t('what_is_ck.next.migrate.cta'),
  },
  {
    icon: Command,
    href: `${prefix}/guides/cli`,
    title: t('what_is_ck.next.cli.title'),
    body: t('what_is_ck.next.cli.body'),
    cta: t('what_is_ck.next.cli.cta'),
  },
  {
    icon: BookOpen,
    href: `${prefix}/guides/how-ck-works`,
    title: t('what_is_ck.next.how.title'),
    body: t('what_is_ck.next.how.body'),
    cta: t('what_is_ck.next.how.cta'),
  },
  {
    icon: Bot,
    href: `${prefix}/guides/commands`,
    title: t('what_is_ck.next.commands.title'),
    body: t('what_is_ck.next.commands.body'),
    cta: t('what_is_ck.next.commands.cta'),
  },
];

const sourceLabels = {
  'agentkit-docs': t('what_is_ck.sources.agentkit'),
  'claudekit-docs': t('what_is_ck.sources.claudekit'),
  'claudekit-cli': t('what_is_ck.sources.cli'),
};

const inlineCodeClass = 'inline-flex max-w-full overflow-x-auto rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-sm text-violet-700 dark:border-slate-700 dark:bg-slate-800/90 dark:text-violet-300';
---

<section id="target-syntax" aria-labelledby="target-syntax-heading" class="pt-16">
  <div class="max-w-3xl">
    <h2 id="target-syntax-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-white">
      {t('what_is_ck.targets.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('what_is_ck.targets.intro')}
    </p>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {targets.map(({ icon: Icon, displayName, body, invocation }) => (
      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-950/40">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-violet-700 dark:bg-slate-800 dark:text-violet-300">
            <Icon class="h-5 w-5" aria-hidden="true" />
          </div>
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">{displayName}</h3>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{body}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
          <span class="font-semibold">{t('what_is_ck.targets.invocation')}:</span>
          <code class={inlineCodeClass}>{invocation}</code>
        </div>
      </article>
    ))}
  </div>
</section>

<section id="next-guides" aria-labelledby="next-guides-heading" class="pt-16">
  <div class="max-w-3xl">
    <h2 id="next-guides-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-white">
      {t('what_is_ck.next.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('what_is_ck.next.intro')}
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {nextGuides.map(({ icon: Icon, href, title, body, cta }) => (
      <article class="group flex min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-violet-300 dark:border-slate-700 dark:bg-slate-950/40 dark:hover:border-violet-600">
        <Icon class="h-5 w-5 text-violet-600 dark:text-violet-400" aria-hidden="true" />
        <h3 class="mt-3 text-lg font-bold text-slate-950 dark:text-white">{title}</h3>
        <p class="mt-2 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{body}</p>
        <a href={href} class="mt-4 inline-flex min-h-11 items-center gap-2 self-start rounded-lg px-1 text-sm font-semibold text-violet-700 hover:underline focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-violet-300">
          {cta}
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </a>
      </article>
    ))}
  </div>

  <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
    <h3 class="text-sm font-bold uppercase tracking-[0.1em] text-slate-700 dark:text-slate-200">{t('what_is_ck.sources.heading')}</h3>
    <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      {WHAT_IS_CLAUDEKIT_SOURCES.map((source) => (
        <a href={source.sourceUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-violet-700 hover:underline focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 dark:text-violet-300">
          {sourceLabels[source.id]}
          <ExternalLink class="h-4 w-4" aria-hidden="true" />
        </a>
      ))}
    </div>
  </div>
</section>
