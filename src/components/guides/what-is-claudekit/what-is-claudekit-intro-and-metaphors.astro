---
import { ArrowRight, Bot, Braces, GitBranch, History, Library, Sparkles, Workflow } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import { WHAT_IS_CLAUDEKIT_FACTS } from '@/data/guides/agentkit/what-is-claudekit-facts';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = lang === 'vi' ? '/vi' : '';

if (
  WHAT_IS_CLAUDEKIT_FACTS.productStatus !== 'legacy-predecessor'
  || WHAT_IS_CLAUDEKIT_FACTS.currentSuccessor !== 'agentkit'
) {
  throw new Error('Unsupported ClaudeKit successor state.');
}

const concepts = [
  { id: 'agents', icon: Bot, title: t('what_is_ck.concept.agents.title'), body: t('what_is_ck.concept.agents.body') },
  { id: 'commands', icon: Braces, title: t('what_is_ck.concept.commands.title'), body: t('what_is_ck.concept.commands.body') },
  { id: 'skills', icon: Library, title: t('what_is_ck.concept.skills.title'), body: t('what_is_ck.concept.skills.body') },
  { id: 'workflows', icon: Workflow, title: t('what_is_ck.concept.workflows.title'), body: t('what_is_ck.concept.workflows.body') },
  { id: 'hooks', icon: GitBranch, title: t('what_is_ck.concept.hooks.title'), body: t('what_is_ck.concept.hooks.body') },
  { id: 'config-rules', icon: Sparkles, title: t('what_is_ck.concept.config.title'), body: t('what_is_ck.concept.config.body') },
];

const factConcepts = new Set(WHAT_IS_CLAUDEKIT_FACTS.historicalConcepts);
if (concepts.some(({ id }) => !factConcepts.has(id as typeof WHAT_IS_CLAUDEKIT_FACTS.historicalConcepts[number]))) {
  throw new Error('Rendered ClaudeKit concept is missing from canonical facts.');
}
---

<header class="rounded-3xl border border-violet-200 bg-gradient-to-br from-violet-50 via-white to-cyan-50 p-6 dark:border-violet-500/20 dark:from-violet-950/30 dark:via-slate-950 dark:to-cyan-950/20 sm:p-8 lg:p-10">
  <p class="text-xs font-bold uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">
    {t('what_is_ck.hero.eyebrow')}
  </p>
  <h1 class="mt-3 max-w-4xl font-heading text-4xl font-bold tracking-tight text-slate-950 text-balance dark:text-white sm:text-5xl">
    {t('what_is_ck.hero.title')}
  </h1>
  <p class="mt-5 max-w-4xl text-lg leading-8 text-slate-600 text-pretty dark:text-slate-300">
    {t('what_is_ck.hero.lead')}
  </p>

  <div role="note" class="mt-6 flex max-w-4xl gap-3 rounded-2xl border border-amber-300 bg-amber-50 p-5 text-amber-950 dark:border-amber-800 dark:bg-amber-950/30 dark:text-amber-100">
    <History class="mt-0.5 h-5 w-5 shrink-0" aria-hidden="true" />
    <div>
      <p class="font-bold">{t('what_is_ck.hero.statusTitle')}</p>
      <p class="mt-1 text-sm leading-relaxed">{t('what_is_ck.hero.statusBody')}</p>
    </div>
  </div>

  <p class="mt-4 max-w-4xl rounded-2xl border border-emerald-200 bg-emerald-50/70 px-5 py-4 text-sm leading-relaxed text-emerald-950 dark:border-emerald-800/60 dark:bg-emerald-950/20 dark:text-emerald-100">
    {t('what_is_ck.continuity.strip')}
    {' '}
    <a href={`${prefix}/guides/agentkit#continuity`} class="font-semibold underline decoration-emerald-400 underline-offset-4 hover:text-emerald-800 focus-visible:ring-2 focus-visible:ring-emerald-600 dark:hover:text-emerald-50">
      {t('what_is_ck.hero.migrateCta')}
    </a>
  </p>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`${prefix}/guides/agentkit`} class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-violet-600 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 active:bg-violet-800">
      {t('what_is_ck.hero.migrateCta')}
      <ArrowRight class="h-4 w-4" aria-hidden="true" />
    </a>
    <a href={`${prefix}/guides/cli`} class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition-colors hover:border-violet-400 hover:text-violet-700 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 active:bg-slate-100 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-violet-400 dark:hover:text-violet-300">
      {t('what_is_ck.hero.installCta')}
      <ArrowRight class="h-4 w-4" aria-hidden="true" />
    </a>
  </div>
</header>

<section id="claudekit-idea" aria-labelledby="claudekit-idea-heading" class="pt-16">
  <div class="max-w-3xl">
    <h2 id="claudekit-idea-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-white">
      {t('what_is_ck.intro.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('what_is_ck.intro.body')}
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {concepts.map(({ icon: Icon, title, body }) => (
      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-950/40">
        <Icon class="h-5 w-5 text-violet-600 dark:text-violet-400" aria-hidden="true" />
        <h3 class="mt-3 font-bold text-slate-950 dark:text-white">{title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{body}</p>
      </article>
    ))}
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-2">
    <div class="rounded-2xl bg-slate-100 p-5 dark:bg-slate-800/70">
      <h3 class="font-bold text-slate-950 dark:text-white">{t('what_is_ck.intro.metaphorTitle')}</h3>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{t('what_is_ck.intro.metaphorBody')}</p>
    </div>
    <div class="rounded-2xl border border-sky-200 bg-sky-50 p-5 dark:border-sky-800 dark:bg-sky-950/30">
      <h3 class="font-bold text-sky-950 dark:text-sky-100">{t('what_is_ck.boundary.title')}</h3>
      <p class="mt-2 text-sm leading-6 text-sky-900 dark:text-sky-200">{t('what_is_ck.boundary.body')}</p>
    </div>
  </div>
</section>
