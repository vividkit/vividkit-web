---
import { ArrowRight, Folder, Globe2 } from 'lucide-astro';

import type { Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import {
  WHAT_IS_CLAUDEKIT_FACTS,
  WHAT_IS_CLAUDEKIT_SCOPE_FACTS,
} from '@/data/guides/agentkit/what-is-claudekit-facts';
import { renderInlineCode } from '../agentkit/inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  {
    label: t('what_is_ck.change.cli.label'),
    before: t('what_is_ck.change.cli.before'),
    after: t('what_is_ck.change.cli.after'),
  },
  {
    label: t('what_is_ck.change.namespace.label'),
    before: t('what_is_ck.change.namespace.before'),
    after: t('what_is_ck.change.namespace.after'),
  },
  {
    label: t('what_is_ck.change.targets.label'),
    before: t('what_is_ck.change.targets.before'),
    after: t('what_is_ck.change.targets.after'),
  },
  {
    label: t('what_is_ck.change.lifecycle.label'),
    before: t('what_is_ck.change.lifecycle.before'),
    after: t('what_is_ck.change.lifecycle.after'),
  },
];

const scopeCards = WHAT_IS_CLAUDEKIT_SCOPE_FACTS.map((fact) => ({
  ...fact,
  icon: fact.scope === 'project' ? Folder : Globe2,
  title: fact.scope === 'project'
    ? t('what_is_ck.scope.project.title')
    : t('what_is_ck.scope.global.title'),
  body: fact.scope === 'project'
    ? t('what_is_ck.scope.project.body')
    : t('what_is_ck.scope.global.body'),
}));

const inlineCodeClass = 'inline-flex max-w-full overflow-x-auto rounded-md border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-sm text-slate-800 dark:border-slate-700 dark:bg-slate-800/90 dark:text-slate-100';
---

<section id="ck-to-agentkit" aria-labelledby="ck-to-agentkit-heading" class="pt-16">
  <div class="max-w-3xl">
    <h2 id="ck-to-agentkit-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-white">
      {t('what_is_ck.change.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300" set:html={renderInlineCode(t('what_is_ck.change.intro'))}></p>
  </div>

  <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
    <div class="hidden grid-cols-[minmax(8rem,0.45fr)_minmax(0,1fr)_auto_minmax(0,1fr)] gap-4 bg-slate-100 px-5 py-3 text-xs font-bold uppercase tracking-[0.08em] text-slate-600 dark:bg-slate-800/90 dark:text-slate-300 md:grid">
      <span></span>
      <span>ClaudeKit / CK</span>
      <span></span>
      <span>AgentKit / AK</span>
    </div>
    <div class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950/40">
      {rows.map((row) => (
        <article class="grid min-w-0 gap-3 p-5 md:grid-cols-[minmax(8rem,0.45fr)_minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center md:gap-4">
          <h3 class="text-sm font-bold text-slate-950 dark:text-white">{row.label}</h3>
          <p class="text-sm leading-6 text-slate-600 dark:text-slate-300" set:html={renderInlineCode(row.before)}></p>
          <ArrowRight class="h-4 w-4 text-violet-500" aria-hidden="true" />
          <p class="text-sm font-medium leading-6 text-slate-800 dark:text-slate-100" set:html={renderInlineCode(row.after)}></p>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-2 text-sm text-slate-600 dark:text-slate-300">
    <code class={inlineCodeClass}>{WHAT_IS_CLAUDEKIT_FACTS.legacyBinary}</code>
    <ArrowRight class="h-5 w-5 text-slate-400" aria-hidden="true" />
    <code class={`${inlineCodeClass} text-violet-700 dark:text-violet-300`}>{WHAT_IS_CLAUDEKIT_FACTS.currentBinary}</code>
  </div>
</section>

<section id="installation-scope" aria-labelledby="installation-scope-heading" class="pt-16">
  <div class="max-w-3xl">
    <h2 id="installation-scope-heading" class="font-heading text-3xl font-bold text-slate-950 dark:text-white">
      {t('what_is_ck.scope.heading')}
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-600 text-pretty dark:text-slate-300">
      {t('what_is_ck.scope.intro')}
    </p>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {scopeCards.map(({ icon: Icon, title, body, path }) => (
      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-950/40">
        <Icon class="h-5 w-5 text-violet-600 dark:text-violet-400" aria-hidden="true" />
        <h3 class="mt-3 text-lg font-bold text-slate-950 dark:text-white">{title}</h3>
        <code class={`${inlineCodeClass} mt-3`}>{path}</code>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300" set:html={renderInlineCode(body)}></p>
      </article>
    ))}
  </div>
</section>
