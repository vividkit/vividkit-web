---
import { Github, Heart, Repeat, ShieldCheck, Sparkles } from 'lucide-astro';
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const sponsorUrl = 'https://github.com/sponsors/vividkit';
---

<section class="space-y-10">
  <div class="relative overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl shadow-slate-200/70 dark:border-white/10 dark:bg-slate-950 dark:shadow-black/25">
    <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(135deg,rgba(244,63,94,0.12),transparent_32%,rgba(14,165,233,0.10)_58%,rgba(16,185,129,0.12))] dark:bg-[linear-gradient(135deg,rgba(244,63,94,0.16),transparent_34%,rgba(14,165,233,0.14)_62%,rgba(16,185,129,0.14))]"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-rose-400 via-sky-400 to-emerald-400"></div>

    <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-center lg:p-10">
      <div class="order-1 lg:col-start-1">
        <p class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-white/80 px-3 py-1 text-xs font-black uppercase tracking-[0.16em] text-rose-700 shadow-sm dark:border-rose-400/20 dark:bg-white/10 dark:text-rose-200">
          <Heart class="h-3.5 w-3.5" aria-hidden="true" />
          {t('guides.donate.sponsor_kicker')}
        </p>
        <h1 class="mt-5 max-w-2xl text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
          {t('guides.donate.sponsor_title')}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-300">
          {t('guides.donate.sponsor_description')}
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={sponsorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-300 bg-white/80 px-5 text-sm font-bold text-slate-700 shadow-sm transition-colors hover:border-slate-400 hover:bg-white dark:border-white/15 dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/15"
          >
            <Github class="h-4 w-4" aria-hidden="true" />
            github.com/sponsors/vividkit
          </a>
        </div>
      </div>

      <div class="order-2 mx-auto w-full max-w-sm lg:col-start-2">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 text-center shadow-2xl shadow-slate-300/60 dark:border-white/10 dark:bg-white/[0.06] dark:shadow-black/30">
          <span class="cta-button inline-flex h-14 w-14 items-center justify-center rounded-2xl text-white">
            <Heart class="h-7 w-7" aria-hidden="true" />
          </span>
          <h2 class="mt-5 text-lg font-black text-slate-950 dark:text-white">
            {t('guides.donate.sponsor_panel_title')}
          </h2>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('guides.donate.sponsor_panel_desc')}
          </p>
          <a
            href={sponsorUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button mt-5 inline-flex w-full min-h-11 items-center justify-center gap-2 rounded-xl px-4 text-sm font-black text-white"
          >
            <Github class="h-4 w-4" aria-hidden="true" />
            {t('guides.donate.sponsor_cta')}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <Repeat class="h-6 w-6 text-blue-600 dark:text-blue-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.sponsor_step_flexible_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.sponsor_step_flexible_desc')}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <ShieldCheck class="h-6 w-6 text-emerald-600 dark:text-emerald-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.sponsor_step_secure_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.sponsor_step_secure_desc')}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <Sparkles class="h-6 w-6 text-rose-600 dark:text-rose-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.sponsor_step_keep_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.sponsor_step_keep_desc')}</p>
    </div>
  </div>
</section>
