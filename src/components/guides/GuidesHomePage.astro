---
// Guides landing: AgentKit / ClaudeKit / Migrate entry cards + tools
import { Rocket, BookOpen, ArrowRightLeft, Workflow, Zap, ShieldCheck, BadgePercent, Layers, BookOpenText } from 'lucide-astro';
import GuidedPathwayCard from './guides-home/guided-pathway-card.astro';
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import { insideClaudeKitTopics } from '@/data/guides/inside-claudekit';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

const entryCards = [
  {
    id: 'start-agentkit',
    icon: Rocket,
    titleKey: 'guides.home.entry_ak.title',
    descKey: 'guides.home.entry_ak.desc',
    accentColor: 'green' as const,
    badgeKey: 'guides.home.entry_ak.badge',
    links: [
      { href: '/guides/agentkit', labelKey: 'guides.home.entry_ak.link_what' },
      { href: '/guides/agentkit/getting-started', labelKey: 'guides.home.entry_ak.link_start' },
    ],
  },
  {
    id: 'continue-claudekit',
    icon: BookOpen,
    titleKey: 'guides.home.entry_ck.title',
    descKey: 'guides.home.entry_ck.desc',
    accentColor: 'blue' as const,
    badgeKey: 'guides.home.entry_ck.badge',
    links: [
      { href: '/guides/what-is-claudekit', labelKey: 'guides.home.entry_ck.link_what' },
      { href: '/guides/cli', labelKey: 'guides.home.entry_ck.link_cli' },
    ],
  },
  {
    id: 'migrate-ck-ak',
    icon: ArrowRightLeft,
    titleKey: 'guides.home.entry_migrate.title',
    descKey: 'guides.home.entry_migrate.desc',
    accentColor: 'amber' as const,
    links: [
      { href: '/guides/migrate-claudekit-to-agentkit', labelKey: 'guides.home.entry_migrate.link' },
    ],
  },
];

const morePathways = [
  {
    id: 'already-using',
    icon: Workflow,
    titleKey: 'guides.home.pathway_using.title',
    descKey: 'guides.home.pathway_using.desc',
    accentColor: 'cyan' as const,
    links: [
      { href: '/guides/flowchart', labelKey: 'guides.home.pathway_using.link_flowchart' },
      { href: '/guides/commands', labelKey: 'guides.home.pathway_using.link_commands' },
      { href: '/guides/workflows', labelKey: 'guides.home.pathway_using.link_workflows' },
    ],
  },
  {
    id: 'alt-providers',
    icon: Zap,
    titleKey: 'guides.home.pathway_providers.title',
    descKey: 'guides.home.pathway_providers.desc',
    accentColor: 'purple' as const,
    links: [
      { href: '/guides/ccs', labelKey: 'guides.home.pathway_providers.link_ccs' },
      { href: '/guides/ide-config', labelKey: 'guides.home.pathway_environments.link_ide' },
      { href: '/guides/remote-control', labelKey: 'guides.home.pathway_environments.link_remote_control' },
      { href: '/guides/codex-app', labelKey: 'guides.home.pathway_providers.link_codex_app' },
    ],
  },
  {
    id: 'visualization-skills',
    icon: Layers,
    titleKey: 'guides.sections.visualization',
    descKey: 'guides.home.pathway_visualization.desc',
    accentColor: 'cyan' as const,
    links: [
      { href: '/guides/archify', labelKey: 'guides.archify.title' },
    ],
  },
  {
    id: 'reliability',
    icon: ShieldCheck,
    titleKey: 'guides.home.pathway_reliability.title',
    descKey: 'guides.home.pathway_reliability.desc',
    accentColor: 'rose' as const,
    links: [
      { href: '/guides/session-recovery', labelKey: 'guides.home.pathway_reliability.link_session' },
      { href: '/guides/fix-logs', labelKey: 'guides.home.pathway_reliability.link_fix_logs' },
      { href: '/guides/uiux', labelKey: 'guides.home.pathway_reliability.link_uiux' },
    ],
  },
];
---

<div class="space-y-10 mt-6" id="choose">
  <div class="text-center space-y-4">
    <h1 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('guides.home.title')}
    </h1>
    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      {t('guides.home.subtitle')}
    </p>
  </div>

  <!-- Three primary entry cards — equal height via stretch + card h-full flex -->
  <div class="grid grid-cols-1 items-stretch gap-6 md:grid-cols-3">
    {entryCards.map((card) => (
      <GuidedPathwayCard
        id={card.id}
        icon={card.icon}
        titleKey={card.titleKey}
        descKey={card.descKey}
        links={card.links}
        accentColor={card.accentColor}
        lang={currentLang}
        badgeKey={'badgeKey' in card ? card.badgeKey : undefined}
      />
    ))}
  </div>

  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
        {t('guides.home.more_title')}
      </h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {t('guides.home.more_desc')}
      </p>
    </div>
    <div class="pathways-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {morePathways.map((pathway) => (
        <GuidedPathwayCard
          id={pathway.id}
          icon={pathway.icon}
          titleKey={pathway.titleKey}
          descKey={pathway.descKey}
          links={pathway.links}
          accentColor={pathway.accentColor}
          lang={currentLang}
        />
      ))}
    </div>
  </section>

  <section class="relative overflow-hidden rounded-2xl border border-amber-200/70 bg-gradient-to-br from-amber-50 via-white to-orange-50/60 p-5 shadow-sm dark:border-amber-500/20 dark:from-amber-950/30 dark:via-slate-900/70 dark:to-orange-950/20">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(245,158,11,0.12),transparent_40%)] dark:bg-[radial-gradient(circle_at_top_right,rgba(251,191,36,0.10),transparent_40%)]"></div>
    <div class="relative flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-start gap-4">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-600 text-white shadow-md shadow-amber-500/25">
          <BadgePercent class="h-5 w-5" />
        </div>
        <div class="space-y-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-base font-semibold text-slate-900 dark:text-white">
              {t('guides.home.promotions.title')}
            </h2>
            <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-700 dark:bg-amber-500/15 dark:text-amber-300">
              {t('guides.home.promotions.badge')}
            </span>
          </div>
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-amber-600/90 dark:text-amber-400/90">
            {t('guides.home.promotions.kicker')}
          </p>
          <p class="max-w-2xl pt-0.5 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {t('guides.home.promotions.desc')}
          </p>
        </div>
      </div>
      <a
        href={translatePath('/guides/promotions')}
        class="inline-flex min-h-10 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-amber-500 to-orange-600 px-4 text-sm font-semibold text-white shadow-sm shadow-amber-500/25 transition hover:from-amber-600 hover:to-orange-700 hover:shadow-md hover:shadow-amber-500/30"
      >
        {t('guides.home.promotions.cta')}
      </a>
    </div>
  </section>

  <section class="relative overflow-hidden rounded-3xl border border-slate-200/70 bg-gradient-to-br from-slate-50 via-white to-teal-50/50 p-6 md:p-8 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-teal-950/30">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(20,184,166,0.10),transparent_35%)] dark:bg-[radial-gradient(circle_at_top_right,rgba(45,212,191,0.08),transparent_35%)]"></div>
    <div class="relative space-y-6">
      <div class="flex items-center gap-3">
        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 text-white shadow-md shadow-teal-500/25">
          <Layers class="h-5 w-5" />
        </div>
        <div>
          <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            {t('guides.sections.deep_dives')}
          </h2>
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
            {t('guides.home.deep_dives.kicker')}
          </p>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <a
          href={translatePath('/guides/agentkit/how-it-works')}
          class="group flex flex-col gap-3 rounded-2xl border border-slate-200/70 bg-white/70 p-5 backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:border-teal-300/80 hover:bg-white/90 hover:shadow-lg hover:shadow-teal-500/10 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500/40 dark:hover:bg-slate-900/80"
        >
          <h3 class="text-base font-semibold text-slate-900 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-300">
            {t('guides.agentkit.how_it_works.title')}
          </h3>
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {t('guides.agentkit.how_it_works.description')}
          </p>
        </a>
        <a
          href={translatePath('/guides/how-ck-works')}
          class="group flex flex-col gap-3 rounded-2xl border border-slate-200/70 bg-white/70 p-5 backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:border-teal-300/80 hover:bg-white/90 hover:shadow-lg hover:shadow-teal-500/10 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-teal-500/40 dark:hover:bg-slate-900/80"
        >
          <h3 class="text-base font-semibold text-slate-900 transition-colors group-hover:text-teal-700 dark:text-white dark:group-hover:text-teal-300">
            {t('guides.how_ck_works.title')}
          </h3>
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {t('guides.home.deep_dive.how_ck_works_desc')}
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden rounded-3xl border border-slate-200/70 bg-gradient-to-br from-slate-50 via-white to-emerald-50/50 p-6 md:p-8 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-emerald-950/30">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(16,185,129,0.10),transparent_35%)] dark:bg-[radial-gradient(circle_at_top_right,rgba(52,211,153,0.08),transparent_35%)]"></div>
    <div class="relative space-y-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-md shadow-emerald-500/25">
            <BookOpenText class="h-5 w-5" />
          </div>
          <div>
            <h2 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
              {t('guides.inside_claudekit.title')}
            </h2>
            <p class="text-xs font-medium uppercase tracking-[0.12em] text-slate-500 dark:text-slate-400">
              {t('guides.home.inside_claudekit.kicker')}
            </p>
          </div>
        </div>
        <a
          href={translatePath('/guides/inside-claudekit')}
          class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 dark:text-emerald-300 dark:hover:text-emerald-200"
        >
          {t('guides.home.inside_claudekit.discover_more')} →
        </a>
      </div>
      <p class="max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        {t('guides.home.inside_claudekit.desc')}
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        {insideClaudeKitTopics.filter((topic) => !topic.disabled).map((topic) => (
          <a
            href={translatePath(`/guides/inside-claudekit/${topic.slug}`)}
            class="group flex flex-col gap-3 rounded-2xl border border-slate-200/70 bg-white/70 p-5 backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:border-emerald-300/80 hover:bg-white/90 hover:shadow-lg hover:shadow-emerald-500/10 dark:border-slate-800 dark:bg-slate-900/60 dark:hover:border-emerald-500/40 dark:hover:bg-slate-900/80"
          >
            <h3 class="text-base font-semibold leading-snug text-slate-900 transition-colors group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-300">
              {t(topic.titleKey)}
            </h3>
            <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {t(topic.descKey)}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</div>
