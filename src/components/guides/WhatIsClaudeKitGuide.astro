---
// WhatIsClaudeKitGuide: composition of what-is-claudekit sub-components
import { getLangFromUrl, type Language } from "@/i18n";
import WhatIsClaudeKitIntroAndMetaphors from "@/components/guides/what-is-claudekit/what-is-claudekit-intro-and-metaphors.astro";
import WhatIsClaudeKitPillarsAndProcessFlow from "@/components/guides/what-is-claudekit/what-is-claudekit-pillars-and-process-flow.astro";
import WhatIsClaudeKitBeforeAfterComparison from "@/components/guides/what-is-claudekit/what-is-claudekit-before-after-comparison.astro";
import WhatIsClaudeKitCommandsAndSummary from "@/components/guides/what-is-claudekit/what-is-claudekit-commands-and-summary.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
---

<div class="space-y-8 mt-6">
  <!-- Header, intro banner, house metaphor, team metaphor with image -->
  <WhatIsClaudeKitIntroAndMetaphors lang={currentLang} />

  <!-- 5 Pillars grid + process flow steps with images -->
  <WhatIsClaudeKitPillarsAndProcessFlow lang={currentLang} />

  <!-- Before/After comparison table with image -->
  <WhatIsClaudeKitBeforeAfterComparison lang={currentLang} />

  <!-- Quick start commands (stable/beta toggle) + summary + CTA -->
  <WhatIsClaudeKitCommandsAndSummary lang={currentLang} />
</div>

<script>
  // Quick Start version toggle: stable vs beta commands
  document.addEventListener("DOMContentLoaded", () => {
    const btnStable = document.getElementById("qs-btn-stable");
    const btnBeta = document.getElementById("qs-btn-beta");
    const commandsStable = document.getElementById("qs-commands-stable");
    const commandsBeta = document.getElementById("qs-commands-beta");

    if (!btnStable || !btnBeta || !commandsStable || !commandsBeta) return;

    const activeClasses = "bg-teal-500 text-white shadow-sm";
    const activeBetaClasses = "bg-purple-500 text-white shadow-sm";
    const inactiveClasses = "text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700";

    function setVersion(version: "stable" | "beta") {
      if (version === "stable") {
        commandsStable.classList.remove("hidden");
        commandsBeta.classList.add("hidden");
        btnStable.className = `qs-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeClasses}`;
        btnBeta.className = `qs-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      } else {
        commandsStable.classList.add("hidden");
        commandsBeta.classList.remove("hidden");
        btnBeta.className = `qs-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeBetaClasses}`;
        btnStable.className = `qs-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      }
      localStorage.setItem("what-is-claudekit-qs-version", version);
    }

    // Restore saved preference (migrate old keys)
    const savedVersion = localStorage.getItem("what-is-claudekit-qs-version") as "stable" | "beta" | "v25" | "v24" | null;
    if (savedVersion === "v25" || savedVersion === "stable") setVersion("stable");
    else if (savedVersion === "v24" || savedVersion === "beta") setVersion("beta");

    btnStable.addEventListener("click", () => setVersion("stable"));
    btnBeta.addEventListener("click", () => setVersion("beta"));
  });
</script>
