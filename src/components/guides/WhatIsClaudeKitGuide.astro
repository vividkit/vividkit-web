---
import { getLangFromUrl, type Language } from '@/i18n';
import WhatIsClaudeKitBeforeAfter from './what-is-claudekit/what-is-claudekit-before-after-comparison.astro';
import WhatIsClaudeKitCommandsAndSummary from './what-is-claudekit/what-is-claudekit-commands-and-summary.astro';
import WhatIsClaudeKitIntro from './what-is-claudekit/what-is-claudekit-intro-and-metaphors.astro';
import WhatIsClaudeKitPillarsAndFlow from './what-is-claudekit/what-is-claudekit-pillars-and-process-flow.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
---

<article class="mt-6 pb-8">
  <WhatIsClaudeKitIntro lang={currentLang} />
  <WhatIsClaudeKitPillarsAndFlow lang={currentLang} />
  <WhatIsClaudeKitBeforeAfter lang={currentLang} />
  <WhatIsClaudeKitCommandsAndSummary lang={currentLang} />
</article>
