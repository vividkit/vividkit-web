---
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';
import { agentkitCliCheatsheet } from '@/data/guides/agentkit-cli-cheatsheet';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categoryConfigs = [
  { id: 'lifecycle', labelKey: 'ak.cli.cheatsheet.cat.lifecycle', accent: 'bg-indigo-400', panel: 'from-indigo-50 to-violet-50 dark:from-indigo-950/40 dark:to-violet-950/20', ring: 'border-indigo-200/80 dark:border-indigo-400/20', chip: 'bg-indigo-100 text-indigo-800 dark:bg-indigo-400/10 dark:text-indigo-200' },
  { id: 'kits', labelKey: 'ak.cli.cheatsheet.cat.kits', accent: 'bg-teal-400', panel: 'from-teal-50 to-cyan-50 dark:from-teal-950/40 dark:to-cyan-950/20', ring: 'border-teal-200/80 dark:border-teal-400/20', chip: 'bg-teal-100 text-teal-800 dark:bg-teal-400/10 dark:text-teal-200' },
  { id: 'runtime', labelKey: 'ak.cli.cheatsheet.cat.runtime', accent: 'bg-fuchsia-400', panel: 'from-fuchsia-50 to-rose-50 dark:from-fuchsia-950/30 dark:to-rose-950/20', ring: 'border-fuchsia-200/80 dark:border-fuchsia-400/20', chip: 'bg-fuchsia-100 text-fuchsia-800 dark:bg-fuchsia-400/10 dark:text-fuchsia-200' },
  { id: 'diagnose', labelKey: 'ak.cli.cheatsheet.cat.diagnose', accent: 'bg-amber-400', panel: 'from-amber-50 to-orange-50 dark:from-amber-950/35 dark:to-orange-950/20', ring: 'border-amber-200/80 dark:border-amber-400/20', chip: 'bg-amber-100 text-amber-800 dark:bg-amber-400/10 dark:text-amber-200' },
] as const;

const descKey = (name: string) => {
  const slug = name.replace(/^ak /, '').replace(/-/g, '_');
  return `ak.cli.cmd.${slug}.desc`;
};
---

<div class="space-y-5">
  {categoryConfigs.map((cat) => {
    const cmds = agentkitCliCheatsheet.filter((c) => c.category === cat.id);
    return (
      <section id={`ak-cli-cat-${cat.id}`} class:list={['scroll-mt-32 overflow-hidden rounded-2xl border bg-gradient-to-br shadow-sm', cat.panel, cat.ring]}>
        <div class="border-b border-slate-200/70 px-5 py-4 dark:border-white/10">
          <h2 class="text-xl font-bold text-slate-950 dark:text-white">{t(cat.labelKey as any)}</h2>
        </div>
        <div class="grid gap-3 p-4 sm:p-5">
          {cmds.map((cmd) => {
            const copyValue = cmd.example || cmd.name;
            return (
              <article class="rounded-2xl border border-slate-200/80 bg-white/80 p-4 dark:border-white/10 dark:bg-slate-950/55">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 space-y-2">
                    <code class:list={['inline-flex rounded-xl px-3 py-1.5 font-mono text-sm font-bold', cat.chip]}>{cmd.name}</code>
                    <p class="text-sm leading-6 text-slate-600 dark:text-slate-300">{t(descKey(cmd.name) as any)}</p>
                  </div>
                  <button class="copy-btn flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-500 dark:border-white/10" data-code={copyValue} aria-label={`Copy ${copyValue}`}>
                    <svg class="copy-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" /></svg>
                    <svg class="check-icon hidden h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12" /></svg>
                  </button>
                </div>
                {(cmd.keyFlags || cmd.example) && (
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {cmd.keyFlags?.map((flag) => (
                      <span class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-2 py-1 font-mono text-[10px] dark:border-white/10 dark:bg-white/[0.04]">{flag}</span>
                    ))}
                  </div>
                )}
                {cmd.example && (
                  <div class="mt-3 rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 font-mono text-xs text-slate-700 dark:border-white/10 dark:bg-slate-800/90 dark:text-slate-200">
                    <span class="text-purple-600 dark:text-purple-400">$</span> {cmd.example}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}
</div>
