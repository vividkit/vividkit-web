---
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';
import { AGENTKIT_CLI_SOURCED_FROM } from '@/data/guides/agentkit-cli-cheatsheet';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="text-center space-y-4">
  <h1 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">{t('ak.cli.cheatsheet.title')}</h1>
  <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">{t('ak.cli.cheatsheet.subtitle')}</p>
  <p class="text-xs font-mono text-slate-500 dark:text-slate-500">sourcedFrom: {AGENTKIT_CLI_SOURCED_FROM}</p>
</header>
