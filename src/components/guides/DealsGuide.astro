---
// DealsGuide: top-level composition of all deals guide sub-components
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import DealsHero from './deals/deals-hero.astro';
import DealsCampaignEndedBanner from './deals/deals-campaign-ended-banner.astro';
import DealsWhatIsClaudekit from './deals/deals-what-is-claudekit.astro';
import DealsHowItWorks from './deals/deals-how-it-works.astro';
import DealsClaimWidget from './deals/deals-claim-widget.astro';
import DealsCheckoutProof from './deals/deals-checkout-proof.astro';
import DealsFaq from './deals/deals-faq.astro';
import DealsRules from './deals/deals-rules.astro';
import DealsFairPlay from './deals/deals-fair-play.astro';
import DealsDevPreview from './deals/deals-dev-preview.astro';

const isDev = import.meta.env.DEV;
// Toggle the campaign-ended announcement via env (.env): set
// PUBLIC_DEALS_CAMPAIGN_ENDED=true to surface the banner. Unset/false keeps the
// active campaign layout intact for a quick re-enable later.
const campaignEnded = import.meta.env.PUBLIC_DEALS_CAMPAIGN_ENDED === 'true';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<div class="mt-5 space-y-8">
  {campaignEnded && <DealsCampaignEndedBanner lang={currentLang} />}

  <DealsHero lang={currentLang} />

  <DealsWhatIsClaudekit lang={currentLang} />

  <section
    id="claim"
    class="relative scroll-mt-28 sm:scroll-mt-32"
  >
    <div
      class="pointer-events-none absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-emerald-300/40 via-amber-200/30 to-rose-300/30 blur-2xl dark:from-emerald-500/20 dark:via-amber-500/10 dark:to-rose-500/15"
      aria-hidden="true"
    ></div>
    <div class="grid gap-4 lg:grid-cols-2 lg:items-stretch">
      <DealsClaimWidget lang={currentLang} />
      <DealsFairPlay lang={currentLang} />
    </div>
  </section>

  <section id="lucky-draw" class="scroll-mt-28 rounded-[1.5rem] border border-teal-200 bg-teal-50/70 p-5 dark:border-teal-900/60 dark:bg-teal-950/20 sm:p-6">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">
          {t('deals.raffle.kicker')}
        </p>
        <h2 class="mt-2 font-heading text-2xl font-black text-slate-950 dark:text-white sm:text-3xl">
          {t('deals.lucky_draw_teaser.title')}
        </h2>
        <p class="mt-3 text-sm leading-7 text-slate-700 dark:text-slate-300">
          {t('deals.lucky_draw_teaser.desc')}
        </p>
      </div>

      <a
        href={translatePath('/guides/lucky-draw')}
        class="inline-flex min-h-11 w-fit shrink-0 items-center justify-center rounded-xl bg-teal-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-teal-900/15 transition hover:-translate-y-0.5 hover:bg-teal-500 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-teal-300 dark:bg-teal-400 dark:text-slate-950 dark:hover:bg-teal-300 dark:focus-visible:ring-teal-800"
      >
        {t('deals.lucky_draw_teaser.cta')}
      </a>
    </div>
  </section>

  <DealsRules lang={currentLang} />

  <DealsHowItWorks lang={currentLang} />

  <DealsCheckoutProof lang={currentLang} />

  <DealsFaq lang={currentLang} />

  {isDev && <DealsDevPreview />}
</div>
