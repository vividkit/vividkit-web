---
import { getLangFromUrl, type Language } from '@/i18n';
import AgentKitCliHero from './cli-guide/AgentKitCliHero.astro';
import AgentKitCliSetup from './cli-guide/AgentKitCliSetup.astro';
import AgentKitCliLifecycle from './cli-guide/AgentKitCliLifecycle.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';
import AgentKitQuickStart from './agentkit/agentkit-quick-start.astro';
import AgentKitCompatibilityAndTroubleshooting from './agentkit/agentkit-compatibility-and-troubleshooting.astro';

interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
---

<div class="mt-6" data-agentkit-channel-root data-agentkit-surface="cli" data-agentkit-locale={currentLang} data-agentkit-active-channel="stable">
  <AgentKitChannelSwitcher lang={currentLang} />
  <div class="space-y-10" data-agentkit-stable-facts>
    <AgentKitCliHero lang={currentLang} />
    <AgentKitQuickStart lang={currentLang} />
    <AgentKitCliSetup lang={currentLang} />
    <AgentKitCompatibilityAndTroubleshooting lang={currentLang} />
    <AgentKitCliLifecycle lang={currentLang} />
    <a href={isVi ? '/vi/guides/cli-commands' : '/guides/cli-commands'} class="block rounded-2xl border border-violet-200 bg-violet-50 p-5 transition-colors duration-200 hover:border-violet-400 hover:bg-violet-100 focus-visible:ring-2 focus-visible:ring-violet-500 focus-visible:ring-offset-2 active:bg-violet-200 dark:border-violet-500/20 dark:bg-violet-950/20 dark:hover:bg-violet-900/30 dark:active:bg-violet-900/40">
      <h2 class="text-lg font-bold text-violet-900 dark:text-violet-100">AgentKit CLI reference</h2>
      <p class="mt-2 text-sm text-violet-700 dark:text-violet-200">{isVi ? 'Xem command groups, flags, channel và ví dụ đã xác minh.' : 'Browse verified command groups, flags, channels, and examples.'}</p>
    </a>
  </div>
</div>
