---
import { getLangFromUrl, type Language } from '@/i18n';

import HeroBanner from './cli-guide/HeroBanner.astro';
import TerminalPreview from './cli-guide/TerminalPreview.astro';
import InstallationSteps from './cli-guide/InstallationSteps.astro';
import DailyRoutine from './cli-guide/DailyRoutine.astro';
import CCSLink from './cli-guide/CCSLink.astro';
import AdvancedSettings from './cli-guide/AdvancedSettings.astro';
import ProTips from './cli-guide/ProTips.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
---

<div class="space-y-8 mt-6">
  <HeroBanner lang={currentLang} />
  <TerminalPreview lang={currentLang} />
  <InstallationSteps lang={currentLang} />
  <DailyRoutine lang={currentLang} />
  <CCSLink lang={currentLang} />
  <AdvancedSettings lang={currentLang} />
  <ProTips lang={currentLang} />
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);

          // Show check icon
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');

          // Reset after 2 seconds
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  });
</script>