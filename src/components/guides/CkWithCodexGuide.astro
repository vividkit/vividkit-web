---
import { getLangFromUrl, type Language } from '@/i18n';
import {
  getAgentKitSkillInvocation,
  getAgentKitTargetView,
} from '@/data/guides/agentkit/agentkit-target-capabilities';
import TerminalSnippet from './TerminalSnippet.astro';

interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const prefix = isVi ? '/vi' : '';
const claudeTarget = getAgentKitTargetView('claude-code');
const codexTarget = getAgentKitTargetView('codex');
const codexExamples = ['plan', 'cook', 'code-review'].map((skill) => (
  getAgentKitSkillInvocation('codex', skill)
));
const workflows = [
  {
    title: isVi ? 'Plan → Cook → Test' : 'Plan → Cook → Test',
    body: isVi
      ? 'Lập plan, implement, rồi verify bằng skill test trong Codex.'
      : 'Plan the change, implement it, then verify with the test skill in Codex.',
    skills: ['plan', 'cook', 'test'],
  },
  {
    title: isVi ? 'Cook → Code review' : 'Cook → Code review',
    body: isVi
      ? 'Ship một thay đổi nhỏ rồi chạy code-review trước khi mở PR.'
      : 'Ship a focused change, then run code-review before opening a PR.',
    skills: ['cook', 'code-review'],
  },
  {
    title: isVi ? 'Debug → Fix' : 'Debug → Fix',
    body: isVi
      ? 'Điều tra lỗi bằng debug, rồi dùng cook/fix để vá.'
      : 'Investigate with debug, then patch with cook or fix.',
    skills: ['debug', 'cook'],
  },
].map((workflow) => ({
  ...workflow,
  invocations: workflow.skills.map((skill) => getAgentKitSkillInvocation('codex', skill)),
}));
---

<div class="mt-6 space-y-10">
  <section class="rounded-3xl border border-sky-200 bg-gradient-to-br from-sky-50 via-white to-violet-50 p-6 dark:border-sky-500/20 dark:from-sky-950/30 dark:via-slate-950 dark:to-violet-950/20 sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-700 dark:text-sky-300">AgentKit × Codex</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">{isVi ? 'Cài AgentKit skills cho Codex' : 'Install AgentKit skills for Codex'}</h1>
    <p class="mt-4 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">{isVi ? 'AgentKit cài nội dung kit vào Codex adapter. Đây là target installation, không phải provider conversion và không cần legacy ck migrate.' : 'AgentKit installs kit content through the Codex adapter. This is target installation, not provider conversion, and does not require legacy ck migrate.'}</p>
  </section>

  <section class="space-y-5">
    <div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-600 dark:text-violet-400">01 · install</p><h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Đăng nhập và cài kit' : 'Authenticate and install the kit'}</h2></div>
    <div class="grid gap-4 lg:grid-cols-2">
      <div><h3 class="mb-2 font-semibold text-slate-900 dark:text-white">{isVi ? 'Kiểm tra account' : 'Verify account'}</h3><TerminalSnippet code={'ak whoami\nak licenses'} label="shell" /></div>
      <div><h3 class="mb-2 font-semibold text-slate-900 dark:text-white">{codexTarget.displayName} target</h3><TerminalSnippet code={codexTarget.installCommand} label="shell · review global scope" copyable={codexTarget.installCopyable} /></div>
    </div>
  </section>

  <section class="space-y-5">
    <div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400">02 · invoke</p><h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Dùng syntax native của Codex' : 'Use Codex-native invocation'}</h2></div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
      <p class="leading-7 text-slate-600 dark:text-slate-300">
        {isVi ? `Trong Codex, mention hoặc attach skill đã cài bằng tên ${codexTarget.invocationWildcard}. Slash command ${claudeTarget.invocationWildcard} thuộc Claude Code và không nên copy sang Codex.` : `In Codex, mention or attach the installed skill by its ${codexTarget.invocationWildcard} name. The ${claudeTarget.invocationWildcard} slash form belongs to Claude Code and should not be copied into Codex.`}
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {codexExamples.map((skill) => <code class="rounded-xl border border-slate-200 bg-slate-100 px-3 py-2 text-center font-mono text-violet-700 dark:border-slate-700 dark:bg-slate-800/90 dark:text-violet-300">{skill}</code>)}
      </div>
    </div>
  </section>

  <section class="space-y-5">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-700 dark:text-amber-300">03 · optional CCS</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Chạy Codex qua CCS khi cần' : 'Launch Codex through CCS when needed'}</h2>
    </div>
    <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-5 dark:border-amber-500/25 dark:bg-amber-950/20">
      <p class="leading-7 text-amber-950 dark:text-amber-100">
        {isVi
          ? 'CCS chọn runtime/profile (quota, proxy, dashboard). AgentKit chỉ cung cấp kit content. Dùng CCS khi bạn cần launch Codex qua profile đã cấu hình.'
          : 'CCS selects the runtime profile (quota, proxy, dashboard). AgentKit only supplies kit content. Use CCS when you want to launch Codex through a configured profile.'}
      </p>
      <div class="mt-4 max-w-xl"><TerminalSnippet code="ccsx codex" label="shell · CCS launch" /></div>
      <a
        href={`${prefix}/guides/ccs`}
        class="mt-4 inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-semibold text-amber-900 transition-colors duration-200 hover:text-amber-950 hover:underline focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 dark:text-amber-200 dark:hover:text-amber-50"
      >
        {isVi ? 'Mở hướng dẫn CCS' : 'Open the CCS guide'} →
      </a>
    </div>
  </section>

  <section class="space-y-5">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-fuchsia-700 dark:text-fuchsia-300">04 · workflows</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Chuỗi skill gợi ý trong Codex' : 'Suggested skill chains in Codex'}</h2>
    </div>
    <div class="grid gap-4 lg:grid-cols-3">
      {workflows.map((workflow) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
          <h3 class="font-bold text-slate-950 dark:text-white">{workflow.title}</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{workflow.body}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {workflow.invocations.map((skill) => (
              <code class="rounded-lg border border-slate-200 bg-slate-100 px-2 py-1 font-mono text-xs text-violet-700 dark:border-slate-700 dark:bg-slate-800/90 dark:text-violet-300">{skill}</code>
            ))}
          </div>
        </article>
      ))}
    </div>
    <a
      href={`${prefix}/guides/workflows`}
      class="inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-semibold text-fuchsia-800 transition-colors duration-200 hover:text-fuchsia-950 hover:underline focus-visible:ring-2 focus-visible:ring-fuchsia-500 focus-visible:ring-offset-2 dark:text-fuchsia-300 dark:hover:text-fuchsia-100"
    >
      {isVi ? 'Xem workflows đầy đủ' : 'Browse full workflows'} →
    </a>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <aside class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-400/20 dark:bg-amber-950/20">
      <h2 class="font-bold text-amber-950 dark:text-amber-100">CCS ≠ AgentKit</h2>
      <p class="mt-2 text-sm leading-6 text-amber-900 dark:text-amber-200">
        {isVi
          ? 'CCS chọn runtime/profile. AgentKit cung cấp skills, agents và workflow content. Có thể dùng cùng nhau nhưng ownership khác nhau.'
          : 'CCS selects runtime profiles. AgentKit provides skills, agents, and workflow content. They can coexist, but ownership differs.'}
      </p>
      <a
        href={`${prefix}/guides/ccs`}
        class="mt-3 inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-semibold text-amber-900 transition-colors duration-200 hover:text-amber-950 hover:underline focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 dark:text-amber-200 dark:hover:text-amber-50"
      >
        {isVi ? 'Đọc guide CCS' : 'Read the CCS guide'} →
      </a>
    </aside>
    <aside class="rounded-2xl border border-cyan-200 bg-cyan-50 p-5 dark:border-cyan-400/20 dark:bg-cyan-950/20">
      <h2 class="font-bold text-cyan-950 dark:text-cyan-100">{isVi ? 'Cần migrate từ CK?' : 'Migrating from CK?'}</h2>
      <p class="mt-2 text-sm leading-6 text-cyan-900 dark:text-cyan-200">
        {isVi
          ? 'Hoàn thành CK → AK checklist trước, sau đó cài kit cho Codex.'
          : 'Complete the CK → AK checklist first, then install the kit for Codex.'}
      </p>
      <a
        href={`${prefix}/guides/agentkit`}
        class="mt-3 inline-flex min-h-11 items-center rounded-lg px-1 text-sm font-semibold text-cyan-800 transition-colors duration-200 hover:text-cyan-950 hover:underline focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 active:text-cyan-700 dark:text-cyan-200 dark:hover:text-cyan-50"
      >
        {isVi ? 'Mở migration hub' : 'Open migration hub'} →
      </a>
    </aside>
  </section>
</div>
