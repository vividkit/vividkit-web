---
import { getLangFromUrl, type Language } from '@/i18n';
import Hero from './ck-with-codex/ck-with-codex-hero.astro';
import Architecture from './ck-with-codex/ck-with-codex-architecture.astro';
import Setup from './ck-with-codex/ck-with-codex-setup.astro';
import InteractiveMode from './ck-with-codex/ck-with-codex-interactive-mode.astro';
import Workflows from './ck-with-codex/ck-with-codex-workflows.astro';
import WhyCCS from './ck-with-codex/ck-with-codex-why-ccs.astro';

interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
---

<div class="space-y-12 mt-6">
  <Hero lang={currentLang} />
  <Architecture lang={currentLang} />
  <WhyCCS lang={currentLang} />
  <Setup lang={currentLang} />
  <InteractiveMode lang={currentLang} />
  <Workflows lang={currentLang} />
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  });
</script>
