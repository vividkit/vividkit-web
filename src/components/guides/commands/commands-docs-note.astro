---
// Official docs link note shown at the bottom of the commands guide
import { useTranslations } from "@/i18n/utils";
import { getLangFromUrl, type Language } from "@/i18n";
import { AGENTKIT_SOURCE_SNAPSHOT } from "@/data/guides/agentkit/agentkit-source-contract.ts";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div class="text-center pt-4">
  <p class="text-sm text-slate-500 dark:text-slate-400">
    {t("commands.docs.text")}
    <a
      id="commands-docs-link"
      href={AGENTKIT_SOURCE_SNAPSHOT.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-blue-600 dark:text-blue-400 hover:underline font-medium"
      >{t("commands.docs.link")}</a
    >
  </p>
</div>
