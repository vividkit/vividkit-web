---
// Version toggle + Engineer Kit / Marketing Kit category cards grid
import { useTranslations } from "@/i18n/utils";
import { getLangFromUrl, type Language } from "@/i18n";
import { getEngineerKitCategories } from "@/data/guides/commands-engineer-kit";
import { getMarketingKitCategories } from "@/data/guides/commands-marketing-kit";
import { styles } from "@/data/guides/commands-styles";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const stableCategories = getEngineerKitCategories(t);
const marketingCategories = getMarketingKitCategories(t);
---

<div class="space-y-6">
  <!-- Section header + version toggle buttons -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-2xl font-bold flex items-center gap-3 text-slate-900 dark:text-white">
      <svg
        class="w-7 h-7 text-cyan-600 dark:text-cyan-400"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      {t("commands.categories.title")}
    </h2>

    <div
      class="flex items-center gap-2 p-1 rounded-lg bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700"
    >
      <button
        id="btn-engineer"
        class="version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 bg-teal-500 text-white shadow-sm"
        data-version="engineer"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          {t("commands.v25.tab_v25")}
        </span>
      </button>
      <button
        id="btn-marketing"
        class="version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700"
        data-version="marketing"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
          </svg>
          {t("commands.v25.tab_v24")}
        </span>
      </button>
    </div>
  </div>

  <!-- Engineer Kit (v2.13.0) categories panel -->
  <div id="categories-engineer" class="space-y-6">
    <!-- Stable version badge -->
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span class="px-2 py-0.5 rounded-full bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-400 font-semibold"
        >v2.13.0 Stable · v2.14.0 Beta</span
      >
      <span>{t("commands.engineer_stable_note")}</span>
    </div>

    <!-- Beta preview card -->
    <div
      class="rounded-xl border-2 border-purple-400/60 dark:border-purple-500/40 overflow-hidden bg-gradient-to-br from-purple-500/10 via-violet-500/5 to-pink-500/10"
    >
      <div
        class="p-4 border-b border-purple-300/30 dark:border-purple-600/30 bg-gradient-to-r from-purple-600/10 to-violet-500/10"
      >
        <h3 class="text-lg font-bold flex items-center gap-2 text-purple-600 dark:text-purple-400">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
            <path d="M20 3v4"></path>
            <path d="M22 5h-4"></path>
          </svg>
          {t("commands.beta_preview.title")}
        </h3>
        <p class="text-xs text-slate-500 mt-1">{t("commands.beta_preview.subtitle")}</p>
      </div>
      <!-- System changes notice -->
      <div class="mx-4 mt-4 p-3 rounded-lg bg-amber-50/80 dark:bg-amber-900/20 border border-amber-300/50 dark:border-amber-600/30 space-y-1.5">
        <div class="flex items-center gap-1.5">
          <span class="text-sm font-bold text-slate-700 dark:text-slate-300">{t("commands.beta_system_changes.label")}</span>
          <span class="text-[9px] px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-500 dark:text-slate-400 font-medium uppercase">config</span>
        </div>
        <p class="text-xs font-medium text-slate-700 dark:text-slate-300">{t("commands.beta_system_changes.desc")}</p>
        <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400">{t("commands.beta_system_changes.detail")}</p>
      </div>
      <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <!-- Beta skill cards -->
        {[
          { cmd: "/ck:ship", labelKey: "commands.beta_ship.desc", detailKey: "commands.beta_ship.detail", type: "skill", badge: "new" },
          { cmd: "/ck:deploy", labelKey: "commands.beta_deploy.desc", detailKey: "commands.beta_deploy.detail", type: "skill", badge: "new" },
          { cmd: "/ck:llms", labelKey: "commands.beta_llms.desc", detailKey: "commands.beta_llms.detail", type: "skill", badge: "new" },
          { cmd: "/ck:project-organization", labelKey: "commands.beta_project_organization.desc", detailKey: "commands.beta_project_organization.detail", type: "skill", badge: "new" },
          { cmd: "/ck:security-scan", labelKey: "commands.beta_security_scan.desc", detailKey: "commands.beta_security_scan.detail", type: "skill", badge: "new" },
          { cmd: "/ckm:design", labelKey: "commands.beta_design.desc", detailKey: "commands.beta_design.detail", type: "skill", badge: "new" },
          { cmd: "/ck:code-review", labelKey: "commands.beta_code_review.desc", detailKey: "commands.beta_code_review.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:plan", labelKey: "commands.beta_plan.desc", detailKey: "commands.beta_plan.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:ui-ux-pro-max", labelKey: "commands.beta_ui_ux_pro_max.desc", detailKey: "commands.beta_ui_ux_pro_max.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:ai-multimodal", labelKey: "commands.beta_ai_multimodal.desc", detailKey: "commands.beta_ai_multimodal.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:frontend-design", labelKey: "commands.beta_frontend_design.desc", detailKey: "commands.beta_frontend_design.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:skill-creator", labelKey: "commands.beta_skill_creator.desc", detailKey: "commands.beta_skill_creator.detail", type: "skill", badge: "enhanced" },
        ].map((item) => (
          <div class="p-3 rounded-lg bg-white/60 dark:bg-slate-900/50 border border-purple-500/30 transition-all duration-200 hover:shadow-sm h-full flex flex-col">
            <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <code class="text-sm font-bold font-mono text-purple-600 dark:text-purple-400">{item.cmd}</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium uppercase">skill</span>
                {item.badge === "new" && <span class="text-[9px] px-1.5 py-0.5 rounded bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 font-medium uppercase">new</span>}
                {item.badge === "enhanced" && <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-medium uppercase">enhanced</span>}
              </div>
            </div>
            <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{t(item.labelKey)}</p>
            <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/50">{t(item.detailKey)}</p>
          </div>
        ))}
        <!-- Hook cards -->
        {[
          { cmd: "session-state.cjs", labelKey: "commands.beta_session_state.desc", detailKey: "commands.beta_session_state.detail" },
          { cmd: "plan-format-kanban.cjs", labelKey: "commands.beta_plan_format_kanban.desc", detailKey: "commands.beta_plan_format_kanban.detail" },
        ].map((item) => (
          <div class="p-3 rounded-lg bg-white/60 dark:bg-slate-900/50 border border-violet-500/30 transition-all duration-200 hover:shadow-sm h-full flex flex-col">
            <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <code class="text-sm font-bold font-mono text-violet-600 dark:text-violet-400">{item.cmd}</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400 font-medium uppercase">hook</span>
              </div>
            </div>
            <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{t(item.labelKey)}</p>
            <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/50">{t(item.detailKey)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Stable category cards -->
    {stableCategories.map((category) => (
      <div class="bg-white dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden group">
        <div class={`p-4 border-b border-slate-100 dark:border-slate-800 ${styles[category.color].bg}`}>
          <h3 class={`text-lg font-bold flex items-center gap-2 ${styles[category.color].text}`}>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <Fragment set:html={category.icon} />
            </svg>
            {category.name}
          </h3>
          <p class="text-xs text-slate-500 mt-1">{category.description}</p>
        </div>
        <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {category.commands.map((cmd) => (
            <div
              class={`p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border ${styles[category.color].border} transition-all duration-200 hover:shadow-sm h-full flex flex-col`}
            >
              <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  {/* Step indicator */}
                  {cmd.step && (
                    <span class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${styles[category.color].bg} ${styles[category.color].text}`}>
                      {cmd.step}
                    </span>
                  )}
                  <code class={`text-sm font-bold font-mono ${styles[category.color].text}`}>{cmd.command}</code>
                  {cmd.isBeta && (
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium uppercase">beta</span>
                  )}
                </div>
                <span class="text-[10px] opacity-70">{cmd.complexity}</span>
              </div>
              <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{cmd.desc}</p>
              {cmd.detail && (
                <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/50">
                  {cmd.detail}
                </p>
              )}
              {/* Subcommands (space-separated) */}
              {cmd.subcommands && cmd.subcommands.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.subcommands.map((sub: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-mono">
                      {sub}
                    </code>
                  ))}
                </div>
              )}
              {/* Arguments (space-separated) */}
              {cmd.args && cmd.args.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.args.map((arg: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 font-mono">
                      {arg}
                    </code>
                  ))}
                </div>
              )}
              {/* Flags (dash-prefixed) */}
              {cmd.flags && cmd.flags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.flags.map((flag: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-mono">
                      {flag}
                    </code>
                  ))}
                </div>
              )}
              {cmd.replacedCommand && (
                <p class="text-[10px] text-slate-500 mt-1 flex items-center gap-1">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 5l-7 7 7 7" />
                  </svg>
                  Replaces: <code class="text-red-500 line-through">{cmd.replacedCommand}</code>
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Marketing Kit categories panel -->
  <div id="categories-marketing" class="space-y-6 hidden">
    <!-- Stable version badge -->
    <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
      <span class="px-2 py-0.5 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 font-semibold"
        >v1.2.1 Stable · v1.3.0 Beta</span
      >
      <span>{t("commands.marketing_stable_note")}</span>
    </div>

    <!-- Beta preview card -->
    <div
      class="rounded-xl border-2 border-purple-400/60 dark:border-purple-500/40 overflow-hidden bg-gradient-to-br from-purple-500/10 via-violet-500/5 to-pink-500/10"
    >
      <div
        class="p-4 border-b border-purple-300/30 dark:border-purple-600/30 bg-gradient-to-r from-purple-600/10 to-violet-500/10"
      >
        <h3 class="text-lg font-bold flex items-center gap-2 text-purple-600 dark:text-purple-400">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path>
            <path d="M20 3v4"></path>
            <path d="M22 5h-4"></path>
          </svg>
          {t("commands.mkt_beta_preview.title")}
        </h3>
        <p class="text-xs text-slate-500 mt-1">{t("commands.mkt_beta_preview.subtitle")}</p>
      </div>
      <!-- Major changes box - styled like migration section -->
      <div class="mx-4 mt-4 p-4 rounded-lg bg-white/60 dark:bg-slate-900/50 border border-amber-200 dark:border-amber-500/20 space-y-3">
        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 dark:bg-amber-500/20 flex items-center justify-center">
            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path>
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-xs font-bold text-amber-700 dark:text-amber-400 mb-1">{t("commands.mkt_beta.changes.breaking_title")}</p>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-3">{t("commands.mkt_beta.changes.skills_migration_desc")}</p>
          </div>
        </div>
        <!-- Prefix reference -->
        <div class="p-3 rounded-lg bg-purple-50/50 dark:bg-purple-900/10 border border-purple-200 dark:border-purple-800/50">
          <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-2">{t("commands.mkt_beta.changes.prefix_title")}</p>
          <div class="flex flex-wrap gap-2 text-[10px]">
            <span class="px-2 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-400 font-mono font-semibold">/ck:*</span>
            <span class="text-slate-400">=</span>
            <span class="text-slate-500 dark:text-slate-400">{t("commands.mkt_beta.changes.prefix_shared")}</span>
            <span class="text-slate-300 dark:text-slate-600 mx-1">|</span>
            <span class="px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 font-mono font-semibold">/ckm:*</span>
            <span class="text-slate-400">=</span>
            <span class="text-slate-500 dark:text-slate-400">{t("commands.mkt_beta.changes.prefix_marketing")}</span>
          </div>
        </div>
        <!-- Skill merges compact table -->
        <div>
          <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-1.5">{t("commands.mkt_beta.changes.merges_title")}</p>
          <p class="text-[11px] text-slate-500 dark:text-slate-400 mb-2">{t("commands.mkt_beta.changes.merges_desc")}</p>
          <div class="overflow-x-auto">
            <table class="w-full text-[11px] border-collapse">
              <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700">
                  <th class="text-left py-1 pr-3 text-xs font-semibold text-slate-500 dark:text-slate-500">{t("commands.mkt_beta.changes.col_old")}</th>
                  <th class="text-left py-1 pr-3 text-xs font-semibold text-purple-700 dark:text-purple-300">{t("commands.mkt_beta.changes.col_new")}</th>
                  <th class="text-left py-1 text-xs font-semibold text-slate-500 dark:text-slate-500">{t("commands.mkt_beta.changes.col_args")}</th>
                </tr>
              </thead>
              <tbody class="text-slate-600 dark:text-slate-400">
                <tr class="border-b border-slate-100 dark:border-slate-800">
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/brand-guidelines</code></td>
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">/ckm:brand</code></td>
                  <td class="py-1.5"><code class="text-[10px] text-slate-500">update</code></td>
                </tr>
                <tr class="border-b border-slate-100 dark:border-slate-800">
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/campaign-management</code></td>
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">/ckm:campaign</code></td>
                  <td class="py-1.5"><code class="text-[10px] text-slate-500">create</code> <code class="text-[10px] text-slate-500">analyze</code> <code class="text-[10px] text-slate-500">email</code> <code class="text-[10px] text-slate-500">status</code></td>
                </tr>
                <tr class="border-b border-slate-100 dark:border-slate-800">
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/email-marketing</code></td>
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">/ckm:email</code></td>
                  <td class="py-1.5"><code class="text-[10px] text-slate-500">flow</code> <code class="text-[10px] text-slate-500">sequence</code></td>
                </tr>
                <tr>
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/competitor-alternatives</code></td>
                  <td class="py-1.5 pr-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">/ckm:competitor</code></td>
                  <td class="py-1.5"><code class="text-[10px] text-slate-500">analyze</code> <code class="text-[10px] text-slate-500">content</code> <code class="text-[10px] text-slate-500">seo</code> <code class="text-[10px] text-slate-500">alternatives</code> <code class="text-[10px] text-slate-500">list</code></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {/* Beta skill cards */}
        {[
          { cmd: "/ckm:elevenlabs", labelKey: "commands.mkt_beta.elevenlabs.desc", detailKey: "commands.mkt_beta.elevenlabs.detail", type: "skill", badge: "new" },
          { cmd: "/ckm:storage", labelKey: "commands.mkt_beta.ckm_storage.desc", detailKey: "commands.mkt_beta.ckm_storage.detail", type: "skill", badge: "new" },
          { cmd: "/ckm:marketing-dashboard", labelKey: "commands.mkt_beta.marketing_dashboard.desc", detailKey: "commands.mkt_beta.marketing_dashboard.detail", type: "skill", badge: "new" },
          { cmd: "/ckm:design", labelKey: "commands.mkt_beta.design_consolidated.desc", detailKey: "commands.mkt_beta.design_consolidated.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ckm:ads", labelKey: "commands.mkt_beta.ads_management.desc", detailKey: "commands.mkt_beta.ads_management.detail", type: "skill", badge: "enhanced" },
          { cmd: "/ck:payment", labelKey: "commands.mkt_beta.payment.desc", detailKey: "commands.mkt_beta.payment.detail", type: "skill", badge: "enhanced" },
        ].map((item) => (
          <div class="p-3 rounded-lg bg-white/60 dark:bg-slate-900/50 border border-purple-500/30 transition-all duration-200 hover:shadow-sm h-full flex flex-col">
            <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <code class="text-sm font-bold font-mono text-purple-600 dark:text-purple-400">{item.cmd}</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium uppercase">skill</span>
                {item.badge === "new" && <span class="text-[9px] px-1.5 py-0.5 rounded bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 font-medium uppercase">new</span>}
                {item.badge === "enhanced" && <span class="text-[9px] px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-medium uppercase">enhanced</span>}
              </div>
            </div>
            <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{t(item.labelKey)}</p>
            <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/50">{t(item.detailKey)}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Marketing category cards -->
    {marketingCategories.map((category) => (
      <div class="bg-white dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden group">
        <div class={`p-4 border-b border-slate-100 dark:border-slate-800 ${styles[category.color].bg}`}>
          <h3 class={`text-lg font-bold flex items-center gap-2 ${styles[category.color].text}`}>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <Fragment set:html={category.icon} />
            </svg>
            {category.name}
          </h3>
          <p class="text-xs text-slate-500 mt-1">{category.description}</p>
        </div>
        <div class="p-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {category.commands.map((cmd) => (
            <div
              class={`p-3 rounded-lg bg-slate-50 dark:bg-slate-900/50 border ${styles[category.color].border} transition-all duration-200 hover:shadow-sm h-full flex flex-col ${cmd.isSkill ? "border-dashed" : ""}`}
            >
              <div class="flex items-center justify-between mb-1.5 flex-wrap gap-1">
                <div class="flex items-center gap-1.5 flex-wrap">
                  {/* Step indicator */}
                  {cmd.step && (
                    <span class={`w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold ${styles[category.color].bg} ${styles[category.color].text}`}>
                      {cmd.step}
                    </span>
                  )}
                  {cmd.isSkill ? (
                    <span class={`text-sm font-medium ${styles[category.color].text}`}>{cmd.command}</span>
                  ) : (
                    <code class={`text-sm font-bold font-mono ${styles[category.color].text}`}>{cmd.command}</code>
                  )}
                  {cmd.isSkill && (
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium uppercase">
                      skill
                    </span>
                  )}
                  {cmd.isBeta && (
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium uppercase">beta</span>
                  )}
                </div>
                <span class="text-[10px] opacity-70">{cmd.complexity}</span>
              </div>
              <p class="text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">{cmd.desc}</p>
              {cmd.detail && (
                <p class="text-[11px] leading-relaxed text-slate-500 dark:text-slate-400 mt-auto pt-1.5 border-t border-slate-100 dark:border-slate-800/50">
                  {cmd.detail}
                </p>
              )}
              {/* Subcommands (space-separated) */}
              {cmd.subcommands && cmd.subcommands.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.subcommands.map((sub: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-mono">
                      {sub}
                    </code>
                  ))}
                </div>
              )}
              {/* Arguments (space-separated) */}
              {cmd.args && cmd.args.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.args.map((arg: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-400 font-mono">
                      {arg}
                    </code>
                  ))}
                </div>
              )}
              {/* Flags (dash-prefixed) */}
              {cmd.flags && cmd.flags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-1.5">
                  {cmd.flags.map((flag: string) => (
                    <code class="text-[9px] px-1 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-mono">
                      {flag}
                    </code>
                  ))}
                </div>
              )}
              {/* Beta syntax footer note */}
              {cmd.betaSyntax && (
                <div class="mt-1.5 pt-1.5 border-t border-purple-200/50 dark:border-purple-800/30 text-[10px] flex items-center gap-1">
                  <span class="font-semibold text-purple-600 dark:text-purple-400">Beta:</span>
                  <code class="px-1 py-0.5 rounded bg-purple-50 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-mono">
                    {cmd.betaSyntax}
                  </code>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
