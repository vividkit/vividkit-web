---
// Hero banner with purple background explaining the /ck: prefix convention
import { useTranslations } from "@/i18n/utils";
import { getLangFromUrl, type Language } from "@/i18n";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div
  class="flex items-start gap-4 p-6 rounded-xl bg-purple-500/5 dark:bg-purple-500/10 border border-purple-200 dark:border-purple-500/20"
>
  <div
    class="flex-shrink-0 w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center"
  >
    <svg
      class="w-5 h-5 text-purple-600 dark:text-purple-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M15 14c.2-1 .7-1.7 1.5-2.5 1-1 1.5-2.4 1.5-3.8 0-3.3-2.7-6-6-6-3.3 0-6 2.7-6 6 0 1.4.5 2.8 1.5 3.8.8.8 1.3 1.5 1.5 2.5"
      ></path>
      <path d="M9 18h6"></path>
      <path d="M10 22h4"></path>
    </svg>
  </div>
  <div class="flex-1">
    <div class="font-bold text-purple-700 dark:text-purple-400 mb-1 text-lg">
      {t("commands.hero.title")}
    </div>
    <div class="text-slate-600 dark:text-slate-400 leading-relaxed">
      <Fragment set:html={t("commands.hero.description")} />
    </div>
    <div
      class="mt-4 p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-purple-100 dark:border-purple-500/10"
    >
      <p
        class="text-xs font-bold text-purple-700 dark:text-purple-400 mb-2 uppercase tracking-wide"
      >
        {t("commands.hero.example_label")}
      </p>
      <div class="flex items-center gap-3 flex-wrap">
        <code
          class="px-2 py-1 rounded bg-slate-100 dark:bg-slate-950 text-slate-700 dark:text-slate-300 font-mono text-sm border border-slate-200 dark:border-slate-800"
          >/cook "add a login button"</code
        >
        <span class="text-slate-400 text-sm">→</span>
        <span class="text-sm text-slate-600 dark:text-slate-400"
          >{t("commands.hero.example_outcome")}</span
        >
      </div>
    </div>
  </div>
</div>
