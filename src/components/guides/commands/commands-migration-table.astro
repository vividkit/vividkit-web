            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/integrate:stripe</code></td>
              <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">/ck:payment-integration stripe checkout</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/integrate:sepay</code></td>
              <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">/ck:payment-integration sepay webhook</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/bootstrap:auto</code></td>
              <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">/ck:bootstrap --auto</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/bootstrap:auto:fast</code></td>
              <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">/ck:bootstrap --fast</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">/bootstrap:auto:parallel</code></td>
              <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">/ck:bootstrap --parallel</code></td>
            </tr>
