---
// Migration Guide section: tabbed view for Engineer Kit & Marketing Kit migration references
import { useTranslations } from "@/i18n/utils";
import { getLangFromUrl, type Language } from "@/i18n";
import {
  engineerMigrationAlways,
  engineerMigrationExtra,
  marketingMigrationAlways,
  marketingMigrationExtra,
  marketingRenamedMkt,
  marketingRenamedShared,
} from "@/data/guides/commands-migration";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const isVi = currentLang === "vi";
---

<div id="whats-new-section" class="space-y-4 scroll-mt-32">
  <div
    class="bg-white dark:bg-slate-900/50 rounded-xl border border-amber-200 dark:border-amber-500/20 overflow-hidden"
  >
    <!-- Section header with tabs -->
    <div
      class="p-5 bg-amber-500/5 dark:bg-amber-500/10 border-b border-amber-100 dark:border-amber-500/10"
    >
      <div class="flex items-start gap-4">
        <div
          class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-500/20 flex items-center justify-center"
        >
          <svg
            class="w-5 h-5 text-amber-600 dark:text-amber-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M8 3 4 7l4 4"></path><path d="M4 7h16"></path><path d="m16 21 4-4-4-4"></path><path d="M20 17H4"></path>
          </svg>
        </div>
        <div class="flex-1">
          <div class="font-bold text-amber-700 dark:text-amber-400 mb-1 text-lg">
            <Fragment set:html={t("commands.v25.breaking_title")} />
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400">
            {t("commands.v25.breaking_subtitle")}
          </p>
          <!-- Tab buttons -->
          <div class="flex items-center gap-2 mt-3">
            <button
              id="migration-tab-engineer"
              class="migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 bg-teal-500 text-white shadow-sm"
              data-tab="engineer"
            >
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
                Engineer Kit
              </span>
            </button>
            <button
              id="migration-tab-marketing"
              class="migration-tab px-3 py-1.5 rounded-md text-xs font-medium transition-all duration-200 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700"
              data-tab="marketing"
            >
              <span class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                </svg>
                Marketing Kit
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Engineer Kit migration panel -->
    <div id="migration-panel-engineer" class="p-5">
      <div class="text-sm text-slate-600 dark:text-slate-400 mb-4">
        <p><Fragment set:html={t("commands.v25.breaking_commands_skills")} /></p>
      </div>

      <h4
        class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2"
      >
        <svg class="w-4 h-4 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
        {t("commands.v25.migration_title")}
      </h4>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] text-xs border-collapse">
          <thead>
            <tr class="bg-teal-50 dark:bg-teal-900/20">
              <th class="py-2 px-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-500 border-b border-slate-200 dark:border-slate-700 w-[25%]">{t("commands.v25.migration_old_cmd")}</th>
              <th class="py-2 px-3 text-left text-xs font-semibold text-teal-700 dark:text-teal-300 border-b border-teal-200 dark:border-teal-800 w-[35%]">{t("commands.v25.migration_new_cmd")}</th>
              <th class="py-2 px-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-500 border-b border-slate-200 dark:border-slate-700 w-[40%]">{isVi ? 'Khả năng tương thích' : 'Compatibility'}</th>
            </tr>
          </thead>
          <!-- Always-visible rows -->
          <tbody class="text-slate-600 dark:text-slate-400">
            {engineerMigrationAlways.map((row) => (
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
          </tbody>
          <!-- Expandable extra rows (hidden by default) -->
          <tbody id="migration-extra-rows" class="text-slate-600 dark:text-slate-400" style="display: none;">
            {engineerMigrationExtra.map((row, i) => (
              <tr class={i < engineerMigrationExtra.length - 1 ? "border-b border-slate-100 dark:border-slate-800" : ""}>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class={`text-[10px] ${row.prefixType === 'purple' ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400' : 'bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400'} px-1 py-0.5 rounded`}>{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <!-- Expand/collapse toggle button -->
        <button
          id="migration-toggle-btn"
          data-extra-count={engineerMigrationExtra.length}
          class="mt-3 w-full py-2 text-xs font-medium text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 bg-teal-50 dark:bg-teal-900/20 hover:bg-teal-100 dark:hover:bg-teal-900/30 rounded-lg border border-teal-200 dark:border-teal-800 transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg id="migration-toggle-icon" class="w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
          <span id="migration-toggle-text">Show all migrations ({engineerMigrationExtra.length} more)</span>
        </button>
      </div>

      <div class="mt-4">
        <p class="text-[10px] text-slate-500">
          <strong>Claude Code v2.1.1+:</strong>
          <Fragment set:html={t("commands.v25.skills_note")} />
        </p>
      </div>
    </div>

    <!-- Marketing Kit migration panel -->
    <div id="migration-panel-marketing" class="p-5 hidden">

      <!-- Beta notice -->
      <div class="flex items-center gap-2 mb-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-700">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
          </svg>
          {t("commands.mkt.beta_notice")}
        </span>
        <span class="text-[10px] text-slate-400 dark:text-slate-500">{isVi ? 'Namespace cũ' : 'Legacy namespaces'}: <code class="font-mono">/ck:*</code> {isVi ? 'và' : 'and'} <code class="font-mono">/ckm:*</code> → <code class="font-mono text-purple-500">/ak:*</code></span>
      </div>

      <!-- Prefix reference box (top) -->
      <div class="p-3 rounded-lg bg-purple-50/50 dark:bg-purple-900/10 border border-purple-200 dark:border-purple-800/50 mb-4">
        <p class="text-[11px] font-semibold text-slate-700 dark:text-slate-300 mb-2">{t("commands.mkt_beta.changes.prefix_title")}</p>
        <div class="flex flex-wrap gap-2 text-[10px]">
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono font-semibold">/ck:* · /ckm:*</span>
          <span class="text-slate-400">=</span>
          <span class="px-2 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400 font-mono font-semibold">/ak:*</span>
        </div>
      </div>

      <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
        {t("commands.mkt.migration_title")}
      </h4>

      <!-- Migration table: 2 columns (old cmd → new cmd), flat layout like Engineer Kit -->
      <div class="overflow-x-auto">
        <table class="w-full min-w-[34rem] text-xs border-collapse">
          <thead>
            <tr class="bg-purple-50 dark:bg-purple-900/20">
              <th class="py-2 px-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-500 border-b border-slate-200 dark:border-slate-700 w-[25%]">{t("commands.mkt.migration_old_cmd")}</th>
              <th class="py-2 px-3 text-left text-xs font-semibold text-purple-700 dark:text-purple-300 border-b border-purple-200 dark:border-purple-800 w-[35%]">{t("commands.mkt.migration_new_cmd")}</th>
              <th class="py-2 px-3 text-left text-xs font-semibold text-slate-500 dark:text-slate-500 border-b border-slate-200 dark:border-slate-700 w-[40%]">{isVi ? 'Khả năng tương thích' : 'Compatibility'}</th>
            </tr>
          </thead>
          <!-- Always-visible rows -->
          <tbody class="text-slate-600 dark:text-slate-400">
            {marketingMigrationAlways.map((row) => (
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
          </tbody>
          <!-- Expandable extra rows (hidden by default) -->
          <tbody id="migration-mkt-extra-rows" class="text-slate-600 dark:text-slate-400" style="display: none;">
            {marketingMigrationExtra.map((row) => (
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class={`text-[10px] ${row.prefixType === 'purple' ? 'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400' : 'bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400'} px-1 py-0.5 rounded`}>{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
            <!-- Renamed skills (ckm: marketing-exclusive) -->
            <tr class="border-b border-purple-100 dark:border-purple-900/30 bg-purple-50/30 dark:bg-purple-900/5">
              <td class="py-1.5 px-3 text-[10px] font-semibold text-purple-600 dark:text-purple-400" colspan="3">{isVi ? 'Kỹ năng đổi tên — alias Marketing Kit cũ' : 'Renamed skills — Marketing Kit legacy aliases'}</td>
            </tr>
            {marketingRenamedMkt.map((row) => (
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 px-1 py-0.5 rounded">{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
            <!-- Renamed skills (ck: shared) -->
            <tr class="border-b border-teal-100 dark:border-teal-900/30 bg-teal-50/30 dark:bg-teal-900/5">
              <td class="py-1.5 px-3 text-[10px] font-semibold text-teal-600 dark:text-teal-400" colspan="3">{isVi ? 'Kỹ năng đổi tên — alias dùng chung cũ' : 'Renamed skills — shared legacy aliases'}</td>
            </tr>
            {marketingRenamedShared.map((row, i) => (
              <tr class={i < marketingRenamedShared.length - 1 ? "border-b border-slate-100 dark:border-slate-800" : ""}>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded">{row.old}</code></td>
                <td class="py-1.5 px-3"><code class="text-[10px] bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 px-1 py-0.5 rounded">{row.new}</code></td>
                <td class="py-1.5 px-3 text-[10px]">{isVi ? row.compatibilityNoteVi : row.compatibilityNote}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <!-- Expand/collapse toggle for marketing table -->
        <button
          id="migration-mkt-toggle-btn"
          data-extra-count={marketingMigrationExtra.length + marketingRenamedMkt.length + marketingRenamedShared.length}
          class="mt-3 w-full py-2 text-xs font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 bg-purple-50 dark:bg-purple-900/20 hover:bg-purple-100 dark:hover:bg-purple-900/30 rounded-lg border border-purple-200 dark:border-purple-800 transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg id="migration-mkt-toggle-icon" class="w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
          <span id="migration-mkt-toggle-text">Show all migrations ({marketingMigrationExtra.length + marketingRenamedMkt.length + marketingRenamedShared.length} more)</span>
        </button>
      </div>
    </div>
  </div>
</div>
