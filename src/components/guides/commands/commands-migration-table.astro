---
// "What's New in v2.13.0" section: migration notice + table + skills note
import { useTranslations } from "@/i18n/utils";
import { getLangFromUrl, type Language } from "@/i18n";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div id="whats-new-section" class="space-y-4">
  <!-- Migration Notice header -->
  <div
    class="bg-white dark:bg-slate-900/50 rounded-xl border border-amber-200 dark:border-amber-500/20 overflow-hidden"
  >
    <div
      class="p-5 bg-amber-500/5 dark:bg-amber-500/10 border-b border-amber-100 dark:border-amber-500/10"
    >
      <div class="flex items-start gap-4">
        <div
          class="flex-shrink-0 w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-500/20 flex items-center justify-center"
        >
          <svg
            class="w-5 h-5 text-amber-600 dark:text-amber-400"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
            ></path>
          </svg>
        </div>
        <div class="flex-1">
          <div class="font-bold text-amber-700 dark:text-amber-400 mb-1 text-lg">
            <Fragment set:html={t("commands.v25.breaking_title")} />
          </div>
          <div class="text-sm text-slate-600 dark:text-slate-400 space-y-1">
            <p><Fragment set:html={t("commands.v25.breaking_commands_skills")} /></p>
            <p><Fragment set:html={t("commands.v25.breaking_mandatory")} /></p>
          </div>
        </div>
      </div>
    </div>

    <!-- Migration Guide Table -->
    <div class="p-5">
      <h4
        class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2"
      >
        <svg
          class="w-4 h-4 text-teal-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
        {t("commands.v25.migration_title")}
      </h4>
      <div class="overflow-x-auto">
        <table class="w-full text-xs border-collapse">
          <thead>
            <tr class="bg-teal-50 dark:bg-teal-900/20">
              <th class="py-2 px-3 text-left font-bold text-teal-700 dark:text-teal-300 border-b border-teal-200 dark:border-teal-800 w-1/3"
                >{t("commands.v25.migration_new")}</th
              >
              <th class="py-2 px-3 text-left font-semibold text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700"
                >{t("commands.v25.migration_how")}</th
              >
              <th class="py-2 px-3 text-left font-normal text-slate-500 dark:text-slate-500 border-b border-slate-200 dark:border-slate-700 text-[10px]"
                >{t("commands.v25.migration_old")}</th
              >
            </tr>
          </thead>
          <!-- Always-visible rows -->
          <tbody class="text-slate-600 dark:text-slate-400">
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/git</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/git cm</code> or <code>cp</code>, <code>pr</code>, <code>merge</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/git:cm, /git:cp, /git:merge, /git:pr</code></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/cook</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/cook [task]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/cook:*, /code:*</code></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/remotion</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/remotion [description]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/design:video</code>
                <span class="text-[8px] text-amber-500">renamed</span></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/threejs</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/threejs [scene]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/design:3d</code>
                <span class="text-[8px] text-amber-500">renamed</span></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/frontend-design</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/frontend-design [component]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/design:describe, :fast, :good, :screenshot</code></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/copywriting</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/copywriting [page]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/content:*</code></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/skill-creator</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"><code>/skill-creator [topic]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/skill:*</code></td
              >
            </tr>
          </tbody>
          <!-- Expandable extra rows (hidden by default) -->
          <tbody id="migration-extra-rows" class="text-slate-600 dark:text-slate-400" style="display: none;">
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"
                ><code class="text-teal-600 dark:text-teal-400 font-medium">/payment-integration</code>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td
              >
              <td class="py-2 px-3"
                ><code>/payment-integration stripe</code>
                <span class="text-[8px] text-slate-400 ml-1">or polar, sepay</span></td
              >
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"
                ><code>/integrate:*</code></td
              >
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/plan</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/plan [task]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/plan:fast, /plan:hard, /plan:parallel, /plan:ci, /plan:cro, /plan:two</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/plan archive</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/plan archive</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/plan:archive</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/fix</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/fix [issue]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/fix:ci, /fix:test, /fix:types, /fix:ui, /fix:logs, /fix:fast, /fix:hard, /fix:parallel</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/code-review</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/code-review [context]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/review:codebase, /review:codebase:parallel</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/bootstrap</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/bootstrap</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/bootstrap, /bootstrap:auto, /bootstrap:auto:fast, /bootstrap:auto:parallel</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/skill-creator</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/skill-creator [topic]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/skill:add, /skill:create, /skill:fix-logs, /skill:optimize, /skill:update</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/debug</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/debug [issue]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/debug</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/test</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/test [context]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/test, /test:ui</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/docs</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/docs init|update|summarize</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/docs:init, /docs:summarize, /docs:update</code></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/ask</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/ask [question]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/ask</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/journal</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/journal</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/journal</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/kanban</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/kanban</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/kanban</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/watzup</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/watzup</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/watzup</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/worktree</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/worktree [feature]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/worktree</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/preview</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/preview [file|dir]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/preview</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr class="border-b border-slate-100 dark:border-slate-800">
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/use-mcp</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/use-mcp [tool]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/use-mcp</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
            <tr>
              <td class="py-2 px-3"><code class="text-teal-600 dark:text-teal-400 font-medium">/coding-level</code> <span class="text-[9px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-medium uppercase ml-1">skill</span></td>
              <td class="py-2 px-3"><code>/coding-level [0-5]</code></td>
              <td class="py-2 px-3 text-slate-400 dark:text-slate-600 text-[10px]"><code>/coding-level</code> <span class="text-[8px] text-amber-500">cmd→skill</span></td>
            </tr>
          </tbody>
        </table>

        <!-- Expand/collapse toggle button -->
        <button
          id="migration-toggle-btn"
          class="mt-3 w-full py-2 text-xs font-medium text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 bg-teal-50 dark:bg-teal-900/20 hover:bg-teal-100 dark:hover:bg-teal-900/30 rounded-lg border border-teal-200 dark:border-teal-800 transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <svg id="migration-toggle-icon" class="w-3.5 h-3.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><polyline points="6 9 12 15 18 9"></polyline></svg
          >
          <span id="migration-toggle-text">Show all migrations (15 more)</span>
        </button>
      </div>

      <div class="mt-4">
        <p class="text-[10px] text-slate-500">
          <strong>Claude Code v2.1.1+:</strong>
          <Fragment set:html={t("commands.v25.skills_note")} />
        </p>
      </div>
    </div>
  </div>
</div>
