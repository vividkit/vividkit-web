---
import { getLangFromUrl, type Language } from '@/i18n';
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';
import AkCodeBlock from './agentkit/AkCodeBlock.astro';
import { akInlineCodeClass } from './agentkit/ak-inline-code-class';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const codeClass = akInlineCodeClass;
const inlineCodeHtml = (text: string) =>
  text.replace(/`([^`]+)`/g, `<code class="${codeClass}">$1</code>`);

const installTargets = [
  {
    name: 'Cursor',
    agent: 'cursor',
    brandProvider: 'cursor' as const,
    desc: isVi ? 'Bạn dùng Cursor Agent trong editor.' : 'You use Cursor Agent inside the editor.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent cursor --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent cursor --copy --yes',
    hint: isVi ? 'Nếu Cursor chưa thấy skill, mở một session Agent mới.' : 'If Cursor does not see the Skill yet, start a new Agent session.',
  },
  {
    name: 'Codex CLI',
    agent: 'codex',
    brandProvider: 'openai' as const,
    desc: isVi ? 'Bạn dùng Codex CLI trong terminal.' : 'You use Codex CLI in the terminal.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent codex --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent codex --copy --yes',
    hint: isVi ? 'Muốn thử không cài lâu dài: npx skills use tt-a1i/archify@archify --agent codex' : 'To try without a durable install: npx skills use tt-a1i/archify@archify --agent codex',
  },
  {
    name: 'Claude Code',
    agent: 'claude-code',
    brandProvider: 'claude' as const,
    desc: isVi ? 'Bạn dùng Claude Code trên máy cá nhân hoặc repo.' : 'You use Claude Code locally or inside a repo.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent claude-code --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent claude-code --copy --yes',
    hint: isVi ? 'Global thường vào ~/.claude/skills; project thường vào .claude/skills hoặc skill dir tương thích.' : 'Global usually maps to ~/.claude/skills; project maps to .claude/skills or a compatible Skill directory.',
  },
  {
    name: 'OpenCode',
    agent: 'opencode',
    brandProvider: 'opencode' as const,
    desc: isVi ? 'Bạn dùng OpenCode và muốn skill được runtime tự phát hiện.' : 'You use OpenCode and want the runtime to discover the Skill.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent opencode --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent opencode --copy --yes',
    hint: isVi ? 'OpenCode có thể đọc ~/.config/opencode/skills, .opencode/skills hoặc .agents/skills.' : 'OpenCode can read ~/.config/opencode/skills, .opencode/skills, or .agents/skills.',
  },
];

const secondaryInstallTargets = [
  {
    name: 'Raven',
    brandFallback: 'Rv',
    label: isVi ? 'ZIP thủ công' : 'Manual ZIP',
    desc: isVi ? 'Raven không nằm trong agent switcher. Cài bằng cách giải nén ZIP vào workspace skills.' : 'Raven is not an agent-switcher target. Install by extracting the ZIP into the workspace skills directory.',
    code: 'mkdir -p ~/.raven/workspace/skills\ncurl -L https://github.com/tt-a1i/archify/raw/main/archify.zip -o /tmp/archify.zip\nunzip -o /tmp/archify.zip -d ~/.raven/workspace/skills',
  },
  {
    name: 'DeepSeek Harness',
    brandProvider: 'deepseek' as const,
    label: isVi ? 'Developer preview' : 'Developer preview',
    desc: isVi ? 'Tích hợp cộng đồng, không phải sản phẩm chính thức của DeepSeek.' : 'Community integration, not an official DeepSeek product.',
    code: 'dsh plugin --profile web add @tt-a1i/archify-dsh@0.1.0',
  },
  {
    name: 'Claude.ai',
    brandProvider: 'claude' as const,
    label: isVi ? 'Upload trong UI' : 'Upload in UI',
    desc: isVi ? 'Vào Settings → Capabilities → Skills rồi upload archify.zip. Khả năng chạy phụ thuộc sandbox có Node.js hay không.' : 'Go to Settings → Capabilities → Skills and upload archify.zip. Runtime support depends on Node.js access in the sandbox.',
    code: isVi ? 'Không có lệnh terminal chung. Tải archify.zip từ repo Archify rồi upload trong Claude.ai.' : 'No universal terminal command. Download archify.zip from the Archify repo, then upload it in Claude.ai.',
  },
];

const allInstallTargets = [...installTargets, ...secondaryInstallTargets];
const selectedInstallTarget = installTargets[0];

const manualCliCode = isVi
  ? `# Chỉ dùng CLI thủ công khi bạn biết tạo hoặc kiểm tra JSON IR\ngit clone https://github.com/tt-a1i/archify\ncd archify/archify\nnode bin/archify.mjs doctor\nnode bin/archify.mjs deliver architecture examples/web-app.architecture.json web-app.html --quality showcase --json`
  : `# Use the manual CLI only when you can author or inspect JSON IR\ngit clone https://github.com/tt-a1i/archify\ncd archify/archify\nnode bin/archify.mjs doctor\nnode bin/archify.mjs deliver architecture examples/web-app.architecture.json web-app.html --quality showcase --json`;

const diagrams = [
  {
    id: 'architecture',
    title: isVi ? 'Kiến trúc' : 'Architecture',
    image: '/guides/archify/architecture.png',
    desc: isVi ? 'Component, phụ thuộc, dịch vụ ngoài, ranh giới tin cậy.' : 'Components, dependencies, external services, trust boundaries.',
    prompt: isVi ? 'Dùng Archify vẽ bản đồ kiến trúc cho repo này với 8-12 component chính và một luồng request chính.' : 'Draw an architecture map for this repo with 8-12 core components and one main request path.',
  },
  {
    id: 'workflow',
    title: isVi ? 'Quy trình' : 'Workflow',
    image: '/guides/archify/workflow.png',
    desc: isVi ? 'CI/CD, cổng phê duyệt, triển khai, rollback, bàn giao.' : 'CI/CD, approval gates, deploy, rollback, handoffs.',
    prompt: isVi ? 'Dùng Archify vẽ quy trình release: plan -> build -> test -> approve -> deploy -> rollback.' : 'Draw the release workflow: plan -> build -> test -> approve -> deploy -> rollback.',
  },
  {
    id: 'sequence',
    title: isVi ? 'Luồng gọi' : 'Sequence',
    image: '/guides/archify/sequence.png',
    desc: isVi ? 'Request, xác thực, cache miss, thử lại, webhook.' : 'Requests, auth, cache misses, retries, webhooks.',
    prompt: isVi ? 'Dùng Archify vẽ luồng gọi cho một API request có Redis cache miss rồi fallback về PostgreSQL.' : 'Draw a sequence for an API request with Redis cache miss and PostgreSQL fallback.',
  },
  {
    id: 'dataflow',
    title: isVi ? 'Luồng dữ liệu' : 'Dataflow',
    image: '/guides/archify/dataflow.png',
    desc: isVi ? 'ETL, phân tích, ranh giới PII, nơi data đi qua.' : 'ETL, analytics, PII boundaries, where data travels.',
    prompt: isVi ? 'Dùng Archify vẽ luồng dữ liệu cho event tracking, đánh dấu ranh giới PII và nơi data rời hệ thống.' : 'Draw a dataflow for event tracking, marking PII boundaries and where data leaves the system.',
  },
  {
    id: 'lifecycle',
    title: isVi ? 'Vòng đời' : 'Lifecycle',
    image: '/guides/archify/lifecycle.png',
    desc: isVi ? 'State của đơn hàng, job, session, thử lại/hủy/lỗi.' : 'Order, job, session states, retry/cancel/fail paths.',
    prompt: isVi ? 'Dùng Archify vẽ vòng đời cho background job: queued, running, retrying, failed, cancelled, completed.' : 'Draw a lifecycle for a background job: queued, running, retrying, failed, cancelled, completed.',
  },
];

const workflowChains = isVi
  ? [
      {
        title: 'Feature / refactor lớn',
        bestFor: 'Khi team cần hiểu architecture hiện tại trước khi đổi code.',
        trigger: 'Trigger `archify` ngay sau `/ak:scout`, rồi trigger lại sau `/ak:plan` nếu plan đổi luồng hệ thống.',
        apply: 'Dùng sơ đồ đầu để cả team thống nhất “hệ thống hiện đang chạy thế nào”. Dùng sơ đồ sau plan để review phần thay đổi trước khi bắt đầu sửa code.',
        steps: ['/ak:scout', 'archify', '/ak:brainstorm', '/ak:plan', 'archify', '/ak:cook'],
        artifact: 'Tạo sơ đồ: kiến trúc hiện tại trước plan; quy trình mới sau plan.',
        prompt: 'Dùng Archify tạo sơ đồ architecture cho phạm vi vừa scout. Giới hạn 8-12 component chính, external services, trust boundaries và một luồng request chính. Xuất HTML/SVG có validation receipt để team review trước khi plan/cook.',
      },
      {
        title: 'Auth, payment, data, security-sensitive change',
        bestFor: 'Khi thay đổi chạm data flow, trust boundary, webhook, token hoặc quyền truy cập.',
        trigger: 'Trigger `archify` sau `/ak:brainstorm` để vẽ dataflow/sequence trước khi chốt plan.',
        apply: 'Đưa sơ đồ vào plan/review để kiểm tra token, webhook, dữ liệu nhạy cảm và service ngoài. Nếu sơ đồ không rõ ranh giới, chưa nên cook.',
        steps: ['/ak:scout', '/ak:brainstorm', 'archify', '/ak:plan', '/ak:code-review'],
        artifact: 'Tạo sơ đồ: luồng dữ liệu, luồng gọi, ranh giới tin cậy và điểm dữ liệu rời hệ thống.',
        prompt: 'Dùng Archify vẽ dataflow và luồng gọi cho thay đổi auth/payment/data này. Đánh dấu token, webhook, PII boundary, external provider và nơi data rời hệ thống. Nếu có giả định chưa chắc, ghi rõ trong artifact.',
      },
      {
        title: 'Bug khó / incident / background job',
        bestFor: 'Khi nguyên nhân nằm trong retry, queue, async state hoặc nhiều service nối nhau.',
        trigger: 'Trigger `archify` sau `/ak:debug` hoặc `/ak:fix` diagnosis, trước khi chọn hướng sửa.',
        apply: 'Dùng sơ đồ để tách luồng happy path, retry path và failing path. Nó giúp tránh sửa nhầm symptom khi lỗi thật nằm ở queue/state/webhook.',
        steps: ['/ak:debug', 'archify', '/ak:fix', '/ak:test', '/ak:code-review'],
        artifact: 'Tạo sơ đồ: vòng đời object/job và luồng gọi của luồng đang lỗi.',
        prompt: 'Dùng Archify vẽ lifecycle/sequence cho failing path vừa debug. Tách happy path, retry path, timeout/cancel/fail state và service nào sở hữu từng bước. Mục tiêu là giúp chọn hướng fix đúng trước khi sửa code.',
      },
      {
        title: 'PR / release cần giải thích blast radius',
        bestFor: 'Khi reviewer hoặc stakeholder cần nhìn thay đổi hệ thống thay vì đọc diff dài.',
        trigger: 'Trigger `archify` sau `/ak:code-review`, trước `/ak:ship`, để gắn artifact vào PR/release note.',
        apply: 'Dùng artifact như phần giải thích cho reviewer/stakeholder: thay đổi chạm đâu, rollback đi đường nào, và phần nào cần monitor sau deploy.',
        steps: ['/ak:test', '/ak:code-review', 'archify', '/ak:ship'],
        artifact: 'Tạo sơ đồ: delta kiến trúc trong PR và quy trình release/rollback.',
        prompt: 'Dùng Archify tạo sơ đồ giải thích PR/release này cho reviewer. Thể hiện phần thay đổi, service bị ảnh hưởng, rollback path, monitor point sau deploy và câu hỏi còn mở. Xuất artifact để attach vào PR hoặc release note.',
      },
    ]
  : [
      {
        title: 'Feature / large refactor',
        bestFor: 'When the team needs to understand current architecture before changing code.',
        trigger: 'Trigger `archify` right after `/ak:scout`, then trigger it again after `/ak:plan` if the plan changes system flow.',
        apply: 'Use the first map to align the team on how the system works today. Use the post-plan map to review changed flow before editing code.',
        steps: ['/ak:scout', 'archify', '/ak:brainstorm', '/ak:plan', 'archify', '/ak:cook'],
        artifact: 'Create: current architecture before planning; new workflow after planning.',
        prompt: 'Use Archify to create an architecture map for the scouted scope. Limit it to 8-12 core components, external services, trust boundaries, and one main request path. Export validated HTML/SVG for team review before planning/cooking.',
      },
      {
        title: 'Auth, payment, data, security-sensitive change',
        bestFor: 'When the change touches data flow, trust boundaries, webhooks, tokens, or access control.',
        trigger: 'Trigger `archify` after `/ak:brainstorm` to draw dataflow/sequence before locking the plan.',
        apply: 'Attach the map to the plan/review to inspect tokens, webhooks, sensitive data, and external services. If boundaries are unclear, do not cook yet.',
        steps: ['/ak:scout', '/ak:brainstorm', 'archify', '/ak:plan', '/ak:code-review'],
        artifact: 'Create: dataflow, sequence, trust boundaries, and where data leaves the system.',
        prompt: 'Use Archify to draw dataflow and request flow for this auth/payment/data change. Mark tokens, webhooks, PII boundaries, external providers, and where data leaves the system. Call out uncertain assumptions in the artifact.',
      },
      {
        title: 'Hard bug / incident / background job',
        bestFor: 'When the root cause lives in retry, queue, async state, or several connected services.',
        trigger: 'Trigger `archify` after `/ak:debug` or `/ak:fix` diagnosis, before choosing the fix.',
        apply: 'Use the map to separate happy path, retry path, and failing path. This helps avoid fixing symptoms when the real issue sits in queue/state/webhook behavior.',
        steps: ['/ak:debug', 'archify', '/ak:fix', '/ak:test', '/ak:code-review'],
        artifact: 'Create: object/job lifecycle and the sequence for the failing path.',
        prompt: 'Use Archify to draw the lifecycle/sequence for the failing path from the debug findings. Separate happy path, retry path, timeout/cancel/fail states, and which service owns each step. The goal is to choose the fix before editing code.',
      },
      {
        title: 'PR / release blast-radius explanation',
        bestFor: 'When reviewers or stakeholders need to see system impact instead of reading a long diff.',
        trigger: 'Trigger `archify` after `/ak:code-review`, before `/ak:ship`, to attach the artifact to the PR/release note.',
        apply: 'Use the artifact as reviewer/stakeholder explanation: what changed, where rollback goes, and what should be monitored after deploy.',
        steps: ['/ak:test', '/ak:code-review', 'archify', '/ak:ship'],
        artifact: 'Create: PR architecture delta and release/rollback workflow.',
        prompt: 'Use Archify to create a PR/release explanation diagram for reviewers. Show what changed, affected services, rollback path, monitoring points after deploy, and open questions. Export an artifact that can be attached to the PR or release note.',
      },
    ];

const recipeTypeFilters = isVi
  ? ['Kiến trúc', 'Quy trình', 'Luồng gọi', 'Luồng dữ liệu', 'Vòng đời']
  : ['Architecture', 'Workflow', 'Sequence', 'Dataflow', 'Lifecycle'];

const officialRecipes = isVi
  ? [
      ['Kiến trúc', 'Tổng quan hệ thống', 'Hệ thống có gì, ai sở hữu, nối với nhau ra sao?', 'Bản đồ component chính, phụ thuộc, luồng chính, ranh giới tin cậy.', 'Dùng Archify tạo bản đồ tổng quan hệ thống cho web app bán sản phẩm số. Thể hiện storefront, checkout, payment provider, license delivery, user account, admin, database, email service, analytics và ranh giới tin cậy.'],
      ['Kiến trúc', 'Quyền sở hữu triển khai', 'Workload chạy ở đâu, ranh giới nào bị đi qua?', 'Bản đồ vùng, mạng, cluster, workload, kho dữ liệu, cơ chế đi qua ranh giới.', 'Dùng Archify vẽ bản đồ quyền sở hữu triển khai cho web app bán sản phẩm số. Thể hiện CDN, frontend hosting, API runtime, worker queue, object storage cho file tải xuống, database, payment webhook, ranh giới secrets và team sở hữu từng workload.'],
      ['Quy trình', 'Vòng lặp gọi tool của agent', 'Agent lập kế hoạch, xin quyền, gọi tool, phục hồi và báo cáo như thế nào?', 'Vòng lặp theo lane, có cổng chính sách, chạy tool, phục hồi lỗi, bằng chứng.', 'Dùng Archify vẽ vòng lặp gọi tool của agent khi bảo trì web app bán sản phẩm số. Bao gồm scout, xin quyền trước khi sửa file checkout/payment, chạy tool, validate, phục hồi khi test fail và report bằng chứng cuối cùng.'],
      ['Quy trình', 'Quy trình delivery', 'Thay đổi đi từ commit tới production an toàn ra sao?', 'Build, kiểm tra, môi trường, phê duyệt, smoke test, rollback, lane sở hữu.', 'Dùng Archify vẽ quy trình delivery để release checkout flow mới cho sản phẩm số. Thể hiện commit, preview build, payment sandbox test, license email smoke test, approval, production deploy, monitoring và rollback.'],
      ['Quy trình', 'Runbook sự cố', 'Responder phát hiện, phân loại, giảm thiểu, xác minh, escalate thế nào?', 'Tách tín hiệu, người phản hồi, bước giảm thiểu, kênh liên lạc, bằng chứng phục hồi.', 'Dùng Archify tạo runbook sự cố cho web app bán sản phẩm số khi khách đã trả tiền nhưng không nhận link tải xuống. Thể hiện detection, triage, payment verification, resend job, customer communication, escalation và recovery proof.'],
      ['Luồng gọi', 'Luồng request API', 'Ai gọi ai, theo thứ tự nào, trả về gì?', 'Xác thực, cache fallback, lưu dữ liệu, response quay về, trace async.', 'Dùng Archify vẽ luồng request API khi mua sản phẩm số. Thể hiện browser, checkout API, auth/session check, coupon validation, payment provider, order database, license generation, email queue và response trả về buyer.'],
      ['Luồng gọi', 'Vòng async roundtrip', 'Sau khi request đầu trả về thì chuyện gì xảy ra?', 'Đưa vào queue, xác nhận, việc nền, callback, thử lại, timeout, nhất quán dữ liệu.', 'Dùng Archify vẽ vòng async roundtrip sau khi payment success trong web app bán sản phẩm số. Thể hiện provider webhook, signature verification, order update, chuẩn bị license file, email delivery, retry, timeout và final consistency check.'],
      ['Luồng dữ liệu', 'Nguồn gốc dữ liệu', 'Data đến từ đâu, biến đổi ra sao, ai tiêu thụ?', 'Nguồn dữ liệu, consent, bước biến đổi, nơi lưu nhạy cảm, warehouse, consumer.', 'Dùng Archify vẽ nguồn gốc dữ liệu cho web app bán sản phẩm số. Thể hiện visitor analytics, checkout form, payment metadata, order records, license entitlement, support dashboard, email marketing opt-in và ranh giới PII.'],
      ['Luồng dữ liệu', 'Topology event stream', 'Event đi qua topic/processor/group/luồng lỗi nào?', 'Producer, topic, processor theo thứ tự, consumer group, state, replay, dead-letter queue.', 'Dùng Archify vẽ topology event stream cho web app bán sản phẩm số. Thể hiện order.created, payment.succeeded, license.generated, email.sent, processors, consumer groups, replay path, dead-letter queue và monitoring.'],
      ['Vòng đời', 'Vòng đời object', 'Object có state nào, event nào chuyển state, kết thúc ra sao?', 'Việc đang chạy, trạng thái chờ, thử lại, hủy, lỗi, outcome kết thúc rõ ràng.', 'Dùng Archify vẽ vòng đời order cho giao dịch mua sản phẩm số. Bao gồm draft, pending_payment, paid, license_generating, fulfilled, refunded, expired, failed, cancelled và terminal states.'],
      ['Vòng đời', 'Vòng đời triển khai', 'Release đang ở state nào và có thể đi đâu tiếp?', 'Xếp hàng, build, xác minh, phê duyệt, promote, rollback, outcome kết thúc.', 'Dùng Archify vẽ vòng đời deployment cho release của web app bán sản phẩm số. Bao gồm queued, building, preview_ready, sandbox_verified, awaiting_approval, promoted, monitored, rolled_back, failed và completed.'],
    ]
  : [
      ['Architecture', 'System overview', 'What exists, who owns it, and how is it connected?', 'Core components, dependencies, primary paths, trust boundaries.', 'Use the archify skill to create a system overview for a digital product store. Show storefront, checkout, payment provider, license delivery, user account, admin, database, email service, analytics, and trust boundaries.'],
      ['Architecture', 'Deployment ownership', 'Where does each workload run, and what crosses a boundary?', 'Regions, networks, clusters, workloads, stores, cross-boundary mechanisms.', 'Use the archify skill to map deployment ownership for a digital product store. Show CDN, frontend hosting, API runtime, worker queue, object storage for downloads, database, payment webhooks, secrets boundary, and which team owns each workload.'],
      ['Workflow', 'Agent tool-call loop', 'How does an agent plan, get permission, act, recover, and report?', 'Policy gates, tool execution, exception recovery, evidence, final response.', 'Use the archify skill to draw an agent tool-call loop for maintaining a digital product store. Include scout, permission ask before editing checkout/payment files, tool execution, validation, recovery when tests fail, and final evidence report.'],
      ['Workflow', 'Delivery workflow', 'How does a change move safely from commit to production?', 'Build, checks, environments, approvals, smoke tests, rollback, ownership lanes.', 'Use the archify skill to draw the delivery workflow for releasing a new digital product checkout flow. Show commit, preview build, payment sandbox test, license email smoke test, approval, production deploy, monitoring, and rollback.'],
      ['Workflow', 'Incident runbook', 'How do responders detect, triage, mitigate, verify, and escalate?', 'Signals, responders, mitigation, communications, recovery proof.', 'Use the archify skill to create an incident runbook for a digital product store where paid customers do not receive download links. Show detection, triage, payment verification, resend job, customer communication, escalation, and recovery proof.'],
      ['Sequence', 'API request chain', 'Who calls whom, in what order, and what returns?', 'Authentication, cache fallback, persistence, return traffic, async trace.', 'Use the archify skill to draw the API request chain for buying a digital product. Show browser, checkout API, auth/session check, coupon validation, payment provider, order database, license generation, email queue, and response to the buyer.'],
      ['Sequence', 'Async roundtrip', 'What happens after the initial request returns?', 'Enqueue, acknowledgement, background work, callbacks, retries, timeout, consistency.', 'Use the archify skill to draw the async roundtrip after payment success in a digital product store. Show provider webhook, signature verification, order update, license file preparation, email delivery, retries, timeout, and final consistency check.'],
      ['Dataflow', 'Data lineage', 'Where does data come from, how does it change, and who consumes it?', 'Sources, consent, transforms, sensitive stores, warehouse, consumers.', 'Use the archify skill to draw data lineage for a digital product store. Show visitor analytics, checkout form, payment metadata, order records, license entitlement, support dashboard, email marketing opt-in, and PII boundaries.'],
      ['Dataflow', 'Event-stream topology', 'Which events move through which topics, processors, groups, and failure paths?', 'Producers, topics, ordered processors, consumer groups, state, replay, DLQ.', 'Use the archify skill to map event-stream topology for a digital product store. Show order.created, payment.succeeded, license.generated, email.sent, processors, consumer groups, replay path, dead-letter queue, and monitoring.'],
      ['Lifecycle', 'Object lifecycle', 'Which states exist, what events move between them, and how does it end?', 'Active work, waits, retries, cancellation, failure, terminal outcomes.', 'Use the archify skill to draw the order lifecycle for a digital product purchase. Include draft, pending_payment, paid, license_generating, fulfilled, refunded, expired, failed, cancelled, and terminal states.'],
      ['Lifecycle', 'Deployment lifecycle', 'What state is a release in, and what can happen next?', 'Queued, building, verifying, approval, promotion, rollback, terminal outcomes.', 'Use the archify skill to draw the deployment lifecycle for a digital product store release. Include queued, building, preview_ready, sandbox_verified, awaiting_approval, promoted, monitored, rolled_back, failed, and completed.'],
    ];

const recipeGroupIconKinds = ['architecture', 'workflow', 'sequence', 'dataflow', 'lifecycle'];
const recipeGroupDescriptions = isVi
  ? [
      'Hiểu hệ thống đang có gì, ai sở hữu và ranh giới nào quan trọng.',
      'Biến delivery, incident và agent loop thành checklist trực quan.',
      'Thấy rõ ai gọi ai, thứ tự gọi và điểm fallback/retry.',
      'Theo dấu dữ liệu, event, PII và đường lỗi qua nhiều service.',
      'Chốt state, transition, retry/cancel/fail và outcome cuối.',
    ]
  : [
      'Understand what exists, who owns it, and which boundaries matter.',
      'Turn delivery, incidents, and agent loops into visual checklists.',
      'See who calls whom, in what order, and where fallback/retry happens.',
      'Trace data, events, PII, and failure paths across services.',
      'Lock states, transitions, retry/cancel/fail paths, and final outcomes.',
    ];

const recipeGroups = recipeTypeFilters.map((type, index) => ({
  type,
  index: String(index + 1).padStart(2, '0'),
  icon: recipeGroupIconKinds[index],
  description: recipeGroupDescriptions[index],
  recipes: officialRecipes.filter(([recipeType]) => recipeType === type),
}));
