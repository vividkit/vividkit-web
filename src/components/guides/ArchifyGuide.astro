---
import { getLangFromUrl, type Language } from '@/i18n';
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';
import AkCodeBlock from './agentkit/AkCodeBlock.astro';
import { akInlineCodeClass } from './agentkit/ak-inline-code-class';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const codeClass = akInlineCodeClass;
const inlineCodeHtml = (text: string) =>
  text.replace(/`([^`]+)`/g, `<code class="${codeClass}">$1</code>`);

const installTargets = [
  {
    name: 'Cursor',
    agent: 'cursor',
    brandProvider: 'cursor' as const,
    desc: isVi ? 'Bạn dùng Cursor Agent trong editor.' : 'You use Cursor Agent inside the editor.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent cursor --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent cursor --copy --yes',
    hint: isVi ? 'Nếu Cursor chưa thấy skill, mở một session Agent mới.' : 'If Cursor does not see the Skill yet, start a new Agent session.',
  },
  {
    name: 'Codex CLI',
    agent: 'codex',
    brandProvider: 'openai' as const,
    desc: isVi ? 'Bạn dùng Codex CLI trong terminal.' : 'You use Codex CLI in the terminal.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent codex --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent codex --copy --yes',
    hint: isVi ? 'Muốn thử không cài lâu dài: npx skills use tt-a1i/archify@archify --agent codex' : 'To try without a durable install: npx skills use tt-a1i/archify@archify --agent codex',
  },
  {
    name: 'Claude Code',
    agent: 'claude-code',
    brandProvider: 'claude' as const,
    desc: isVi ? 'Bạn dùng Claude Code trên máy cá nhân hoặc repo.' : 'You use Claude Code locally or inside a repo.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent claude-code --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent claude-code --copy --yes',
    hint: isVi ? 'Global thường vào ~/.claude/skills; project thường vào .claude/skills hoặc skill dir tương thích.' : 'Global usually maps to ~/.claude/skills; project maps to .claude/skills or a compatible Skill directory.',
  },
  {
    name: 'OpenCode',
    agent: 'opencode',
    brandProvider: 'opencode' as const,
    desc: isVi ? 'Bạn dùng OpenCode và muốn skill được runtime tự phát hiện.' : 'You use OpenCode and want the runtime to discover the Skill.',
    global: 'npx -y skills add tt-a1i/archify --skill archify --agent opencode --global --copy --yes',
    project: 'npx -y skills add tt-a1i/archify --skill archify --agent opencode --copy --yes',
    hint: isVi ? 'OpenCode có thể đọc ~/.config/opencode/skills, .opencode/skills hoặc .agents/skills.' : 'OpenCode can read ~/.config/opencode/skills, .opencode/skills, or .agents/skills.',
  },
];

const secondaryInstallTargets = [
  {
    name: 'Raven',
    brandFallback: 'Rv',
    label: isVi ? 'ZIP thủ công' : 'Manual ZIP',
    desc: isVi ? 'Raven không nằm trong agent switcher. Cài bằng cách giải nén ZIP vào workspace skills.' : 'Raven is not an agent-switcher target. Install by extracting the ZIP into the workspace skills directory.',
    code: 'mkdir -p ~/.raven/workspace/skills\ncurl -L https://github.com/tt-a1i/archify/raw/main/archify.zip -o /tmp/archify.zip\nunzip -o /tmp/archify.zip -d ~/.raven/workspace/skills',
  },
  {
    name: 'DeepSeek Harness',
    brandProvider: 'deepseek' as const,
    label: isVi ? 'Developer preview' : 'Developer preview',
    desc: isVi ? 'Tích hợp cộng đồng, không phải sản phẩm chính thức của DeepSeek.' : 'Community integration, not an official DeepSeek product.',
    code: 'dsh plugin --profile web add @tt-a1i/archify-dsh@0.1.0',
  },
  {
    name: 'Claude.ai',
    brandProvider: 'claude' as const,
    label: isVi ? 'Upload trong UI' : 'Upload in UI',
    desc: isVi ? 'Vào Settings → Capabilities → Skills rồi upload archify.zip. Khả năng chạy phụ thuộc sandbox có Node.js hay không.' : 'Go to Settings → Capabilities → Skills and upload archify.zip. Runtime support depends on Node.js access in the sandbox.',
    code: isVi ? 'Không có lệnh terminal chung. Tải archify.zip từ repo Archify rồi upload trong Claude.ai.' : 'No universal terminal command. Download archify.zip from the Archify repo, then upload it in Claude.ai.',
  },
];

const allInstallTargets = [...installTargets, ...secondaryInstallTargets];
const selectedInstallTarget = installTargets[0];

const manualCliCode = isVi
  ? `# Chỉ dùng CLI thủ công khi bạn tự author hoặc kiểm JSON\ngit clone https://github.com/tt-a1i/archify\ncd archify/archify\nnode bin/archify.mjs doctor\nnode bin/archify.mjs validate architecture examples/web-app.architecture.json --quality showcase --json\nnode bin/archify.mjs deliver architecture examples/web-app.architecture.json web-app.html --quality showcase --json\nnode bin/archify.mjs visual-check web-app.html --json`
  : `# Use the manual CLI only when you can author or inspect JSON\ngit clone https://github.com/tt-a1i/archify\ncd archify/archify\nnode bin/archify.mjs doctor\nnode bin/archify.mjs validate architecture examples/web-app.architecture.json --quality showcase --json\nnode bin/archify.mjs deliver architecture examples/web-app.architecture.json web-app.html --quality showcase --json\nnode bin/archify.mjs visual-check web-app.html --json`;

const promptFooterEn = `Inspect the current commit. Cite a file and line range only after you open it. Author typed JSON first: 8–12 primary nodes, one main path, short side branches. Do not copy gallery topology. Validate after every edit. Deliver only after validate passes. Then visual-check; screenshots are evidence, not a passed visual review. Disclose unknowns.`;
const promptFooterVi = `Đọc commit hiện tại. Chỉ ghi file và line range sau khi đã mở. Author JSON trước: 8–12 node chính, một main path, nhánh phụ ngắn. Không copy topology từ gallery. Validate sau mỗi lần sửa. Deliver chỉ khi validate pass. Rồi visual-check; ảnh là evidence, không phải human review đã pass. Ghi rõ phần chưa chắc.`;

const compilerSteps = isVi
  ? ['Hỏi', 'Đọc code', 'Viết JSON', 'Mở HTML']
  : ['Ask', 'Read code', 'Write JSON', 'Open HTML'];


const problemCards = isVi
  ? [
      { n: '01', title: 'Trông ổn, nối sai', body: 'AI thêm service, mũi tên, fallback không có trong code.', fix: 'Archify chỉ vẽ node và mối nối đã viết trong JSON.' },
      { n: '02', title: 'Không review được', body: 'Chỉ còn PNG/SVG — không có nguồn để đọc hay diff.', fix: 'JSON là bản gốc. HTML chỉ là bản xem.' },
      { n: '03', title: 'Lần sau ra hình khác', body: 'Cùng một prompt, layout và chữ đổi mỗi lần.', fix: 'Cùng JSON thì luôn ra cùng sơ đồ.' },
    ]
  : [
      { n: '01', title: 'Looks fine, wired wrong', body: 'AI adds services, edges, or fallbacks that are not in the code.', fix: 'Archify draws only nodes and links written in the JSON.' },
      { n: '02', title: 'Cannot be reviewed', body: 'You get a PNG or SVG — nothing to read or diff.', fix: 'JSON is the source. HTML is just the viewer.' },
      { n: '03', title: 'Different every run', body: 'The same prompt yields a new layout and wording.', fix: 'The same JSON always yields the same diagram.' },
    ];

const otherToolsLead = isVi
  ? 'Mermaid, Excalidraw, tech-graph — và hầu hết prompt "vẽ sơ đồ" — ra một tấm hình. Archify bắt agent viết JSON có kiểu, rồi compile thành HTML. Khác chỗ: có nguồn để review, có kiểm, không tự bịa thêm box.'
  : 'Mermaid, Excalidraw, tech-graph — and most "draw a diagram" prompts — produce a picture. Archify makes the agent write typed JSON, then compiles HTML. The difference: a source you can review, checks, and no invented boxes.';



const pipelineSteps = isVi
  ? [
      { title: 'Câu hỏi cần trả lời', hint: 'Người xem sơ đồ — maintainer, reviewer — cần hiểu gì?' },
      { title: 'Evidence trong repo', hint: 'Chỉ fact đã mở, đã khoanh phạm vi.' },
      { title: 'JSON nguồn', hint: 'Bản gốc có kiểu — đây là source of truth.' },
      { title: 'Validate', hint: 'Kiểm JSON và hình học. Sai thì sửa đúng chỗ đó.' },
      { title: 'Deliver atomic', hint: 'Ghi HTML một lần. Fail thì file cũ vẫn còn.' },
      { title: 'Ảnh + người review', hint: 'Screenshot là evidence, chưa phải pass.' },
      { title: 'HTML cho docs, PR, presentation', hint: 'File mở trên trình duyệt để share.' },
    ]
  : [
      { title: 'Question to answer', hint: 'What should someone looking at the diagram understand?' },
      { title: 'Repo evidence', hint: 'Only facts you opened, with a bounded scope.' },
      { title: 'JSON source', hint: 'Typed source of truth.' },
      { title: 'Validate', hint: 'Check the JSON and the geometry. Fix only the failing piece.' },
      { title: 'Atomic deliver', hint: 'Write the HTML once. On failure the previous file stays.' },
      { title: 'Screenshots + human review', hint: 'Captures are evidence, not a pass.' },
      { title: 'HTML for docs, PRs, presentation', hint: 'The file you open in a browser to share.' },
    ];

const handoffLayers = isVi
  ? [
      { layer: 'JSON', role: 'Bản gốc của sơ đồ — để đọc, sửa, diff trong git.', commit: 'Luôn lưu git' },
      { layer: 'HTML', role: 'File mở trên trình duyệt — gửi docs, PR, slide.', commit: 'Lưu khi cần share' },
      { layer: 'Receipt', role: 'Biên nhận đã kiểm — validate, hash, ảnh chụp.', commit: 'Giữ khi cần chứng minh' },
    ]
  : [
      { layer: 'JSON', role: 'The diagram source — read, edit, and diff in git.', commit: 'Always keep in git' },
      { layer: 'HTML', role: 'The file you open in a browser — docs, PRs, slides.', commit: 'Commit when sharing' },
      { layer: 'Receipt', role: 'Proof the checks ran — status, hashes, screenshots.', commit: 'Keep when you need proof' },
    ];

const authoringSteps = isVi
  ? [
      { n: '01', title: 'Hỏi một câu', body: 'Người xem sơ đồ cần hiểu gì? Một phạm vi, một câu chuyện.' },
      { n: '02', title: 'Viết JSON trước', body: '8–12 box, một đường chính. Chỉ lấy file đã mở. Chưa chắc mode thì bảo agent chạy `archify guide`.' },
      { n: '03', title: 'Kiểm rồi mới ghi HTML', body: 'Sửa đúng chỗ đang lỗi. Fail thì file cũ vẫn còn — đừng tưởng bản mới đã pass.' },
      { n: '04', title: 'Bạn vẫn phải nhìn', body: 'Ảnh chụp không phải đã duyệt. Main path có thấy ngay không?' },
    ]
  : [
      { n: '01', title: 'Ask one question', body: 'What should someone looking at the diagram understand? One scope, one story.' },
      { n: '02', title: 'Write JSON first', body: '8–12 boxes, one main path. Only files you opened. If the mode is unclear, ask the agent to run `archify guide`.' },
      { n: '03', title: 'Check, then write HTML', body: 'Fix the failing piece. On failure the old file may still be there — do not treat it as a pass.' },
      { n: '04', title: 'You still have to look', body: 'Screenshots are not a review. Can you see the main path in a few seconds?' },
    ];

const modeCards = isVi
  ? [
      { type: 'Architecture', answers: 'Hệ thống có gì, nối thế nào, ranh giới nào?', not: 'Thứ tự gọi chính xác.' },
      { type: 'Workflow', answers: 'Công việc đi qua actor nào, có quyết định, duyệt, retry không?', not: 'State bền vững của một object.' },
      { type: 'Sequence', answers: 'Trong một interaction, ai gọi ai trước, trả gì?', not: 'Ownership của topic/queue.' },
      { type: 'Dataflow', answers: 'Data/event đến từ đâu, biến đổi thế nào, ai dùng?', not: 'Timeline hay người chịu trách nhiệm từng task.' },
      { type: 'Lifecycle', answers: 'Object có state nào, chuyển tiếp và kết thúc ra sao?', not: 'Các bước thực thi `download → scan → package` nếu chưa có state được lưu.' },
    ]
  : [
      { type: 'Architecture', answers: 'What exists, how it connects, which boundaries matter?', not: 'Exact call order.' },
      { type: 'Workflow', answers: 'Which actors/lanes, decisions, approvals, retries?', not: 'Durable states of one object.' },
      { type: 'Sequence', answers: 'In one interaction, who calls whom first, and what returns?', not: 'Topic or queue ownership.' },
      { type: 'Dataflow', answers: 'Where data/events come from, how they change, who consumes them?', not: 'A timeline or who owns each task.' },
      { type: 'Lifecycle', answers: 'Which states exist, how they transition, how they end?', not: 'Execution steps like download → scan → package unless state is stored.' },
    ];

const officialGalleryRecipes = [
  {
    id: 'web-app',
    type: 'architecture',
    viType: 'Kiến trúc',
    enType: 'Architecture',
    title: isVi ? 'Tổng quan hệ thống' : 'System overview',
    question: isVi ? 'Hệ thống có những thành phần nào, và chúng nối với nhau ra sao?' : 'What exists in the system, and how does it connect?',
    when: isVi ? 'Nhận repo mới, onboarding, design review.' : 'New-repo intake, onboarding, design review.',
    notWhen: isVi ? 'Cần đúng thứ tự gọi.' : 'You need exact call order.',
    prompt: isVi
      ? `Dùng Archify trong repo này để trả lời: một maintainer mới cần thấy input đi qua những runtime component nào, dependency nào nằm ngoài process, và đâu là primary path?\n\n${promptFooterVi}`
      : `Use Archify in this repo to answer: a new maintainer needs to see which runtime components an input passes through, which dependencies sit outside the process, and what the primary path is.\n\n${promptFooterEn}`,
  },
  {
    id: 'deployment-ownership',
    type: 'architecture',
    viType: 'Kiến trúc',
    enType: 'Architecture',
    title: isVi ? 'Ownership khi deploy' : 'Deployment ownership',
    question: isVi ? 'Workload chạy ở đâu, ai sở hữu, cơ chế vượt ranh giới là gì?' : 'Where do workloads run, who owns them, and what crosses the boundary?',
    when: isVi ? 'Sẵn sàng production, bàn giao infra — khi đã có owner, region, phạm vi private và crossing mechanism.' : 'Production readiness or infra handoff — only when owner, region, private scope, and crossing mechanism are known.',
    notWhen: isVi ? 'Local CLI, hoặc thiếu fact deploy. Profile này fail nếu thiếu fact — không bịa region/security-group.' : 'Local CLI, or deployment facts are missing. This profile fails closed — do not invent regions or security groups.',
    prompt: isVi
      ? `Dùng Archify Architecture với deployment ownership chỉ khi code/infra đã có owner, region, phạm vi private và crossing mechanism.\n\nCâu hỏi: workload chạy ở đâu, ai sở hữu, vượt ranh giới bằng gì?\n\nNếu thiếu fact, dừng và báo — đừng bịa. ${promptFooterVi}`
      : `Use Archify Architecture with deployment ownership only when owner, region, private scope, and crossing mechanism are known facts.\n\nQuestion: where do workloads run, who owns them, and what is the crossing mechanism?\n\nIf facts are missing, stop and report — do not invent them. ${promptFooterEn}`,
  },
  {
    id: 'agent-tool-call',
    type: 'workflow',
    viType: 'Quy trình',
    enType: 'Workflow',
    title: isVi ? 'Vòng gọi tool của agent' : 'Agent tool-call loop',
    question: isVi ? 'Agent lập plan, xin quyền, gọi tool và recover thế nào?' : 'How does the agent plan, ask for permission, call tools, and recover?',
    when: isVi ? 'Agent runtime, MCP, chính sách duyệt.' : 'Agent runtime, MCP, approval policy.',
    notWhen: isVi ? 'Chỉ cần map component tĩnh.' : 'You only need a static component map.',
    prompt: isVi
      ? `Dùng Archify Workflow để trả lời: agent lập plan, xin quyền, gọi tool và recover thế nào?\n\nLanes theo trách nhiệm. Một main path. Retry và lỗi đi ngoài corridor chính.\n\n${promptFooterVi}`
      : `Use Archify Workflow to answer: how does the agent plan, ask for permission, call tools, and recover?\n\nLanes by responsibility. One main path. Retries and errors leave the main corridor.\n\n${promptFooterEn}`,
  },
  {
    id: 'delivery-workflow',
    type: 'workflow',
    viType: 'Quy trình',
    enType: 'Workflow',
    title: isVi ? 'Quy trình giao hàng' : 'Delivery workflow',
    question: isVi ? 'Một change đi từ commit tới production thế nào?' : 'How does a change go from commit to production?',
    when: isVi ? 'Thiết kế CI/CD, review release.' : 'CI/CD design, release review.',
    notWhen: isVi ? 'Câu hỏi là state của release object — dùng Lifecycle.' : 'The question is the state of a release object — use Lifecycle.',
    prompt: isVi
      ? `Dùng Archify Workflow để trả lời: một change đi từ commit tới production qua build, cổng chặn, duyệt, verify, communicate và rollback thế nào?\n\n${promptFooterVi}`
      : `Use Archify Workflow to answer: how does a change move from commit to production through build, blocking gates, approval, verify, communicate, and rollback?\n\n${promptFooterEn}`,
  },
  {
    id: 'incident-runbook',
    type: 'workflow',
    viType: 'Quy trình',
    enType: 'Workflow',
    title: isVi ? 'Runbook sự cố' : 'Incident runbook',
    question: isVi ? 'Detect, triage, mitigate, communicate và verify thế nào?' : 'How do we detect, triage, mitigate, communicate, and verify?',
    when: isVi ? 'Bàn giao on-call, tabletop.' : 'On-call handoff, tabletop exercise.',
    notWhen: isVi ? 'Cần dashboard monitoring live.' : 'You need a live monitoring dashboard.',
    prompt: isVi
      ? `Dùng Archify Workflow để trả lời: detect, triage, mitigate, communicate và verify một sự cố thế nào?\n\n${promptFooterVi}`
      : `Use Archify Workflow to answer: how do we detect, triage, mitigate, communicate, and verify an incident?\n\n${promptFooterEn}`,
  },
  {
    id: 'cache-miss',
    type: 'sequence',
    viType: 'Luồng gọi',
    enType: 'Sequence',
    title: isVi ? 'Chuỗi gọi API' : 'API request chain',
    question: isVi ? 'Ai gọi ai, thứ tự nào, trả về gì?' : 'Who calls whom, in what order, and what returns?',
    when: isVi ? 'API docs, debug auth/cache.' : 'API docs, auth or cache debugging.',
    notWhen: isVi ? 'Thứ tự không quan trọng.' : 'Order does not matter.',
    prompt: isVi
      ? `Dùng Archify Sequence để trả lời: trong một request, participant nào gọi participant nào trước, và trả gì?\n\nMột interaction. Không biến thành map component.\n\n${promptFooterVi}`
      : `Use Archify Sequence to answer: in one request, which participant calls which participant first, and what returns?\n\nOne interaction. Do not turn this into a component map.\n\n${promptFooterEn}`,
  },
  {
    id: 'async-roundtrip',
    type: 'sequence',
    viType: 'Luồng gọi',
    enType: 'Sequence',
    title: isVi ? 'Vòng async sau ACK' : 'Async roundtrip',
    question: isVi ? 'Sau ACK ban đầu còn những bước nào?' : 'After the initial ACK, which steps still run?',
    when: isVi ? 'Job, webhook, callback, eventual consistency.' : 'Jobs, webhooks, callbacks, eventual consistency.',
    notWhen: isVi ? 'Cần map topic/consumer — dùng Dataflow.' : 'You need a topic/consumer map — use Dataflow.',
    prompt: isVi
      ? `Dùng Archify Sequence để trả lời: sau ACK ban đầu, queue, worker, retry, webhook và polling còn chạy thế nào?\n\n${promptFooterVi}`
      : `Use Archify Sequence to answer: after the initial ACK, how do queueing, workers, retry, webhooks, and polling still run?\n\n${promptFooterEn}`,
  },
  {
    id: 'product-analytics',
    type: 'dataflow',
    viType: 'Luồng dữ liệu',
    enType: 'Dataflow',
    title: isVi ? 'Nguồn gốc dữ liệu' : 'Data lineage',
    question: isVi ? 'Data đến từ đâu, biến đổi thế nào, ai dùng?' : 'Where does data come from, how is it transformed, and who consumes it?',
    when: isVi ? 'ETL, analytics, PII, feature model.' : 'ETL, analytics, PII, model features.',
    notWhen: isVi ? 'Cần ownership task hoặc timeline.' : 'You need task ownership or a timeline.',
    prompt: isVi
      ? `Dùng Archify Dataflow để trả lời: data đến từ đâu, biến đổi thế nào, lưu ở đâu, ai consume, PII đi qua boundary nào?\n\n${promptFooterVi}`
      : `Use Archify Dataflow to answer: where does data come from, how is it transformed, where is it stored, who consumes it, and which PII boundaries does it cross?\n\n${promptFooterEn}`,
  },
  {
    id: 'event-stream',
    type: 'dataflow',
    viType: 'Luồng dữ liệu',
    enType: 'Dataflow',
    title: isVi ? 'Topology event stream' : 'Event-stream topology',
    question: isVi ? 'Event đi qua topic, consumer group, replay và DLQ nào?' : 'Which topics, consumer groups, replay paths, and DLQs do events pass through?',
    when: isVi ? 'Review nền tảng Kafka/event, semantics đã xác minh.' : 'Kafka/event platform review, with verified delivery semantics.',
    notWhen: isVi ? 'Chưa xác minh at-least-once / exactly-once / replay.' : 'Delivery semantics are unverified.',
    prompt: isVi
      ? `Dùng Archify Dataflow để trả lời: event đi qua producer, topic, consumer group, replay và DLQ nào? Chỉ ghi semantics đã xác minh.\n\n${promptFooterVi}`
      : `Use Archify Dataflow to answer: which producers, topics, consumer groups, replay paths, and DLQs do events pass through? Record only verified semantics.\n\n${promptFooterEn}`,
  },
  {
    id: 'agent-run',
    type: 'lifecycle',
    viType: 'Vòng đời',
    enType: 'Lifecycle',
    title: isVi ? 'Vòng đời object' : 'Object lifecycle',
    question: isVi ? 'Object có những state nào, và kết thúc ra sao?' : 'What states does the object have, and how does it end?',
    when: isVi ? 'Order, ticket, job, agent run — khi state được lưu.' : 'Order, ticket, job, agent run — when state is stored.',
    notWhen: isVi ? 'Chỉ có bước thực thi, chưa có state machine được persist.' : 'You only have execution stages, not a persisted state machine.',
    prompt: isVi
      ? `Dùng Archify Lifecycle chỉ khi object có state được lưu, event chuyển state, retry và terminal outcome.\n\nCâu hỏi: object có state nào, chuyển thế nào, kết thúc ra sao?\n\nNếu đây là đề xuất chứ không phải hiện trạng, ghi rõ Proposed Design. ${promptFooterVi}`
      : `Use Archify Lifecycle only when the object has stored state, transition events, retries, and terminal outcomes.\n\nQuestion: which states exist, how do they transition, how do they end?\n\nIf this is a proposal, not current state, label it Proposed Design. ${promptFooterEn}`,
  },
  {
    id: 'deployment-lifecycle',
    type: 'lifecycle',
    viType: 'Vòng đời',
    enType: 'Lifecycle',
    title: isVi ? 'Vòng đời bản release' : 'Deployment lifecycle',
    question: isVi ? 'Release đang ở state nào, và chuyển tiếp thế nào?' : 'What state is the release in, and how does it transition?',
    when: isVi ? 'GitOps, controller, status API.' : 'GitOps, controller, status API.',
    notWhen: isVi ? 'Cần thứ tự hành động của người và CI — dùng Workflow.' : 'You need the action order of people and CI — use Workflow.',
    prompt: isVi
      ? `Dùng Archify Lifecycle để trả lời: deployment object đi qua build, verify, approve, promote, pause, rollback và terminal state nào?\n\n${promptFooterVi}`
      : `Use Archify Lifecycle to answer: which states does the deployment object move through for build, verify, approve, promote, pause, rollback, and terminal outcomes?\n\n${promptFooterEn}`,
  },
];

const recipeTypeFilters = isVi
  ? ['Kiến trúc', 'Quy trình', 'Luồng gọi', 'Luồng dữ liệu', 'Vòng đời']
  : ['Architecture', 'Workflow', 'Sequence', 'Dataflow', 'Lifecycle'];

const officialRecipes = officialGalleryRecipes.map((recipe) => ({
  ...recipe,
  typeLabel: isVi ? recipe.viType : recipe.enType,
  previewDark: `/guides/archify/gallery/${recipe.id}-dark.webp`,
  previewLight: `/guides/archify/gallery/${recipe.id}-light.webp`,
}));

const recipeGroupDescriptions = isVi
  ? [
      'Hiểu hệ thống đang có gì, ai sở hữu, ranh giới nào quan trọng.',
      'Công việc đi qua actor nào, quyết định / duyệt / retry ra sao.',
      'Ai gọi ai, thứ tự nào, điểm fallback.',
      'Data và event đi đâu, PII và đường lỗi.',
      'State được lưu, transition, retry/cancel/fail, outcome cuối.',
    ]
  : [
      'What exists, who owns it, which boundaries matter.',
      'Which actors, decisions, approvals, and retries.',
      'Who calls whom, in what order, where fallback happens.',
      'Where data and events travel, PII, failure paths.',
      'Stored states, transitions, retry/cancel/fail, terminal outcomes.',
    ];

const recipeGroups = recipeTypeFilters.map((type, index) => ({
  type,
  index: String(index + 1).padStart(2, '0'),
  description: recipeGroupDescriptions[index],
  recipes: officialRecipes.filter((recipe) => recipe.typeLabel === type),
}));

const sdlcStages = isVi
  ? [
      { stage: 'Nhận dự án mới', artifact: 'Architecture tổng quan', goal: 'Tạo mental model ban đầu.', prompt: 'Dùng Archify Architecture để trả lời: hệ thống này có những phần nào, nối thế nào, phần nào nằm ngoài process? 8–12 box, một đường chính. Chỉ lấy file đã mở.' },
      { stage: 'Trước khi code', artifact: 'Sequence, Dataflow, hoặc Lifecycle', goal: 'Chốt một contract — một câu hỏi, một sơ đồ.', prompt: 'Dùng Archify để trả lời đúng một câu hỏi trước khi code: ai gọi ai theo thứ tự nào, data đi đâu, hoặc object có những state nào? Chọn Sequence, Dataflow, hoặc Lifecycle — không gộp.' },
      { stage: 'Đang implement', artifact: 'Cập nhật JSON có chọn lọc', goal: 'Sửa sơ đồ đang có, đừng vẽ lại từ đầu.', prompt: 'Cập nhật JSON Archify hiện có cho thay đổi này. Giữ ID ổn định. Chỉ thêm/bỏ/đổi khi code evidence hỗ trợ. Không vẽ sơ đồ mới nếu topology không đổi.' },
      { stage: 'Review PR', artifact: 'Architecture Delta', goal: 'Reviewer thấy chỗ JSON đổi — không suy impact.', prompt: 'Dùng Archify Architecture Delta trên PR này. Baseline: JSON đã có trong repo. Trả đúng added, removed, changed, moved, rerouted. Không suy impact, risk, hay merge safety.' },
      { stage: 'Release', artifact: 'Delivery Workflow hoặc Deployment Lifecycle', goal: 'Một câu hỏi: việc làm, hoặc state của bản phát hành.', prompt: 'Dùng Archify để trả lời đúng một câu hỏi lúc release: change đi từ commit tới production thế nào, hoặc bản phát hành đang ở state nào? Chọn Workflow hoặc Lifecycle — không gộp.' },
      { stage: 'Vận hành', artifact: 'Incident runbook', goal: 'Chuẩn hóa detect, triage, mitigate, verify.', prompt: 'Dùng Archify Workflow để trả lời: khi sự cố xảy ra, detect, triage, mitigate, communicate và verify thế nào? Một main path, nhánh lỗi đi ngoài.' },
      { stage: 'Onboarding', artifact: 'Architecture tổng quan', goal: 'Giảm thời gian đọc repo.', prompt: 'Dùng Archify Architecture để một người mới thấy: request đi qua những phần nào, dependency nào ở ngoài, đâu là đường chính? 8–12 box.' },
      { stage: 'Compliance / data', artifact: 'Data lineage', goal: 'Data đến từ đâu, biến đổi, lưu, ai dùng.', prompt: 'Dùng Archify Dataflow để trả lời: data đến từ đâu, biến đổi thế nào, lưu ở đâu, ai dùng, PII đi qua chỗ nào? Chỉ ghi fact đã mở.' },
    ]
  : [
      { stage: 'New project', artifact: 'System overview Architecture', goal: 'Build an initial mental model.', prompt: 'Use Archify Architecture to answer: what parts exist, how they connect, and what sits outside the process? 8–12 boxes, one main path. Only files you opened.' },
      { stage: 'Before implementation', artifact: 'Sequence, Dataflow, or Lifecycle', goal: 'Lock one contract — one question, one diagram.', prompt: 'Use Archify to answer exactly one question before coding: who calls whom in what order, where data goes, or which states an object has? Pick Sequence, Dataflow, or Lifecycle — not more than one.' },
      { stage: 'During implementation', artifact: 'Selective JSON updates', goal: 'Edit the existing diagram, do not redraw from scratch.', prompt: 'Update the existing Archify JSON for this change. Keep stable IDs. Add, remove, or change only with code evidence. Do not draw a new diagram if topology did not change.' },
      { stage: 'PR review', artifact: 'Architecture Delta', goal: 'Show what the JSON changed — do not infer impact.', prompt: 'Use Archify Architecture Delta on this PR. Baseline: the JSON already in the repo. Return exactly added, removed, changed, moved, rerouted. Do not infer impact, risk, or merge safety.' },
      { stage: 'Release', artifact: 'Delivery Workflow or Deployment Lifecycle', goal: 'One question: the work, or the release object state.', prompt: 'Use Archify to answer exactly one release question: how a change goes from commit to production, or which state the release is in? Pick Workflow or Lifecycle — not both.' },
      { stage: 'Operation', artifact: 'Incident runbook', goal: 'Standardize detect, triage, mitigate, verify.', prompt: 'Use Archify Workflow to answer: when an incident happens, how do we detect, triage, mitigate, communicate, and verify? One main path; error branches leave it.' },
      { stage: 'Onboarding', artifact: 'System overview Architecture', goal: 'Cut time-to-read the repo.', prompt: 'Use Archify Architecture so a new person can see: which parts a request passes through, what sits outside, and the main path. 8–12 boxes.' },
      { stage: 'Compliance / data', artifact: 'Data lineage', goal: 'Where data comes from, how it changes, who uses it.', prompt: 'Use Archify Dataflow to answer: where data comes from, how it is transformed, where it is stored, who uses it, and where PII crosses a boundary. Only facts you opened.' },
    ];

const triggerYes = isVi
  ? ['Runtime boundary', 'External dependency', 'Primary request / processing path', 'Cache hoặc storage ownership', 'Sync đổi async hoặc ngược lại', 'Trust / deployment crossing', 'Durable lifecycle state', 'Data contract hoặc classification quan trọng']
  : ['Runtime boundary', 'External dependency', 'Primary request or processing path', 'Cache or storage ownership', 'Sync became async or the reverse', 'Trust or deployment crossing', 'Durable lifecycle state', 'Important data contract or classification'];

const triggerNo = isVi
  ? ['Rename thuần', 'Refactor nội bộ, topology không đổi', 'Chỉ test', 'Formatting', 'Bug fix không đổi architectural contract']
  : ['Pure rename', 'Internal refactor with the same topology', 'Test-only change', 'Formatting', 'Bug fix that does not change the architectural contract'];

const akPrinciples = isVi
  ? [
      { title: 'Cần evidence, không luôn cần scout', body: 'AgentKit đi hiểu → quyết định → làm → kiểm tra → ship. Chưa hiểu repo thì `/ak:scout` trước. Đã có plan, debug notes, hoặc PR diff thì Archify dùng evidence đó.' },
      { title: 'Sơ đồ để review, không phải verdict', body: 'Không thay `/ak:test`, `/ak:security`, `/ak:code-review`, hay quyền quyết của người review.' },
      { title: 'Dùng ở cổng rủi ro cao', body: 'Auth, payment, PII, token, webhook, migration, background job, incident — sơ đồ trước khi chốt plan/cook.' },
      { title: 'Không nhét vào quick path', body: 'Task nhỏ giữ workflow ngắn nhất hữu ích (`/ak:cook --fast`). Chỉ thêm Archify khi sơ đồ giảm rủi ro hoặc làm handoff rõ hơn.' },
    ]
  : [
      { title: 'Needs evidence, not always scout', body: 'AgentKit runs understand → decide → execute → verify → ship. If the repo is unclear, run `/ak:scout` first. If a plan, debug notes, or PR diff already exists, Archify can use that evidence.' },
      { title: 'A review artifact, not a verdict', body: 'It does not replace `/ak:test`, `/ak:security`, `/ak:code-review`, or human review authority.' },
      { title: 'Use it at high-risk gates', body: 'Auth, payments, PII, tokens, webhooks, migrations, background jobs, incidents — diagram before locking plan/cook.' },
      { title: 'Do not force it into the quick path', body: 'Small tasks keep the shortest useful workflow (`/ak:cook --fast`). Add Archify only when the diagram reduces risk or clarifies a handoff.' },
    ];

const akChains = isVi
  ? [
      {
        title: 'Xây feature mới',
        ak: 'A1 · Build a new feature',
        bestFor: 'Feature hình dạng chưa rõ hoặc đụng nhiều file. Bỏ qua với Quick implement.',
        placements: [
          { label: 'Hiện trạng', context: 'evidence / `/ak:scout`', archify: 'archify', next: '`/ak:brainstorm`', note: 'Một Architecture: hệ thống đang có gì trước khi chọn hướng.' },
          { label: 'Hướng đã chọn', context: '`/ak:brainstorm`', archify: 'archify', next: '`/ak:plan`', note: 'Một Workflow hoặc một Dataflow — không gộp cả hai. Rồi `/ak:cook`.' },
        ],
        prompts: [
          { label: 'Trước brainstorm', prompt: `Dùng Archify Architecture để trả lời: hiện trạng feature/refactor này có những component, dependency, external service và một request path chính nào?\n\nMục tiêu: input rõ cho /ak:brainstorm. ${promptFooterVi}` },
          { label: 'Sau brainstorm', prompt: `Dùng Archify để trả lời đúng một câu hỏi sau brainstorm: luồng công việc mới đi qua actor nào, hoặc data mới đi đâu?\n\nChọn Workflow hoặc Dataflow, không cả hai. Ghi component đổi, boundary chạm, câu hỏi còn mở. Mục tiêu: /ak:plan bám architecture. ${promptFooterVi}` },
        ],
      },
      {
        title: 'Auth / payment / data nhạy cảm',
        ak: 'G2 · Auth feature · Payments',
        bestFor: 'Đụng tiền, PII, token, webhook, quyền, hoặc data rời hệ thống.',
        placements: [
          { label: 'Trước plan cứng', context: '`/ak:better-auth` hoặc domain skill', archify: 'archify', next: '`/ak:plan`', note: 'Một Dataflow (data đi đâu) hoặc một Sequence (ai gọi ai). Rồi cook → security → test.' },
        ],
        prompts: [
          { label: 'Một câu hỏi rủi ro', prompt: `Dùng Archify để trả lời đúng một câu hỏi cho thay đổi auth/payment/data này: data nhạy cảm đi đâu và rời hệ thống ở đâu, hoặc ai gọi ai theo thứ tự nào?\n\nChọn Dataflow hoặc Sequence. Đánh dấu actor, quyền, token, webhook, PII, provider ngoài, failure path. Giả định chưa chắc phải ghi. ${promptFooterVi}` },
        ],
      },
      {
        title: 'Sửa bug / incident',
        ak: 'C1 · Fix a bug',
        bestFor: 'Lỗi nằm ở retry, queue, async state, hoặc nhiều service. Ưu tiên `/ak:fix`; đường sâu khi RCA chưa rõ.',
        placements: [
          { label: 'Sau chẩn đoán', context: '`/ak:debug`', archify: 'archify', next: '`/ak:fix`', note: 'Một Sequence cho failing interaction. Lifecycle chỉ khi object có state được lưu.' },
        ],
        prompts: [
          { label: 'Failing path', prompt: `Dùng Archify Sequence để trả lời: failing path vừa debug gọi participant nào, theo thứ tự nào, retry/timeout trả về đâu?\n\nTách happy path khỏi failing path. Không biến bước thực thi thành Lifecycle trừ khi state được persist. Mục tiêu: chọn hướng /ak:fix trước khi sửa code. ${promptFooterVi}` },
        ],
      },
      {
        title: 'Review PR / ship',
        ak: 'D1 · Review a PR · D3 · Ship',
        bestFor: 'Chỉ khi architectural contract đổi. Không dùng cho mọi PR.',
        placements: [
          { label: 'Delta cấu trúc', context: 'JSON baseline đã validate', archify: 'archify', next: '`/ak:code-review` / `/ak:ship`', note: 'Architecture Delta: added, removed, changed, moved, rerouted. Không suy risk, impact, merge safety.' },
        ],
        prompts: [
          { label: 'Architecture Delta', prompt: `Dùng Archify Architecture Delta trên PR hiện tại.\n\nBaseline: JSON architecture đã validate trong repo. Giữ stable ID cho component không đổi. Chỉ thêm/bỏ/đổi/reroute khi code evidence hỗ trợ.\n\nTrả đúng: added, removed, changed, moved, rerouted. Không suy blast radius, production impact, risk, hay merge safety. Reviewer đọc JSON, receipt, và delta đã render. ${promptFooterVi}` },
        ],
      },
    ]
  : [
      {
        title: 'Build a new feature',
        ak: 'A1 · Build a new feature',
        bestFor: 'Unclear shape or multi-file impact. Skip on Quick implement.',
        placements: [
          { label: 'Current state', context: 'evidence / `/ak:scout`', archify: 'archify', next: '`/ak:brainstorm`', note: 'One Architecture: what exists before choosing a direction.' },
          { label: 'Chosen direction', context: '`/ak:brainstorm`', archify: 'archify', next: '`/ak:plan`', note: 'One Workflow or one Dataflow — not both. Then `/ak:cook`.' },
        ],
        prompts: [
          { label: 'Before brainstorm', prompt: `Use Archify Architecture to answer: for this feature/refactor, which components, dependencies, external services, and one primary request path exist today?\n\nGoal: clear input for /ak:brainstorm. ${promptFooterEn}` },
          { label: 'After brainstorm', prompt: `Use Archify to answer exactly one question after brainstorm: which actors does the new work pass through, or where does the new data go?\n\nPick Workflow or Dataflow, not both. Record changed components, touched boundaries, and open questions. Goal: keep /ak:plan aligned with architecture. ${promptFooterEn}` },
        ],
      },
      {
        title: 'Auth / payment / sensitive data',
        ak: 'G2 · Auth feature · Payments',
        bestFor: 'Money, PII, tokens, webhooks, access control, or data leaving the system.',
        placements: [
          { label: 'Before hard plan', context: '`/ak:better-auth` or domain skill', archify: 'archify', next: '`/ak:plan`', note: 'One Dataflow (where data goes) or one Sequence (who calls whom). Then cook → security → test.' },
        ],
        prompts: [
          { label: 'One risk question', prompt: `Use Archify to answer exactly one question for this auth/payment/data change: where sensitive data goes and where it leaves the system, or who calls whom in what order?\n\nPick Dataflow or Sequence. Mark actors, permissions, tokens, webhooks, PII, external providers, and failure paths. Call out uncertain assumptions. ${promptFooterEn}` },
        ],
      },
      {
        title: 'Fix a bug / incident',
        ak: 'C1 · Fix a bug',
        bestFor: 'The bug lives in retry, queue, async state, or several services. Prefer `/ak:fix`; deep path when RCA is unclear.',
        placements: [
          { label: 'After diagnosis', context: '`/ak:debug`', archify: 'archify', next: '`/ak:fix`', note: 'One Sequence for the failing interaction. Lifecycle only if the object has stored state.' },
        ],
        prompts: [
          { label: 'Failing path', prompt: `Use Archify Sequence to answer: which participants does the failing path call, in what order, and where do retry/timeout return?\n\nSeparate happy path from failing path. Do not turn execution stages into Lifecycle unless state is persisted. Goal: choose the /ak:fix direction before editing code. ${promptFooterEn}` },
        ],
      },
      {
        title: 'Review a PR / ship',
        ak: 'D1 · Review a PR · D3 · Ship',
        bestFor: 'Only when the architectural contract changed. Not every PR.',
        placements: [
          { label: 'Structural delta', context: 'validated baseline JSON', archify: 'archify', next: '`/ak:code-review` / `/ak:ship`', note: 'Architecture Delta: added, removed, changed, moved, rerouted. Do not infer risk, impact, or merge safety.' },
        ],
        prompts: [
          { label: 'Architecture Delta', prompt: `Use Archify Architecture Delta on the current PR.\n\nBaseline: the validated architecture JSON in the repo. Keep stable IDs for unchanged components. Add, remove, change, or reroute only with code evidence.\n\nReturn exactly: added, removed, changed, moved, rerouted. Do not infer blast radius, production impact, risk, or merge safety. Reviewers read the JSON, the receipt, and the rendered delta. ${promptFooterEn}` },
        ],
      },
    ];

const antiPatterns = isVi
  ? [
      { dont: 'Một prompt tạo đủ năm sơ đồ', do: 'Bắt đầu Architecture + Workflow. Thêm mode khi có câu hỏi mới.' },
      { dont: 'Mega-diagram hàng chục service', do: 'Tối đa khoảng 12 node chính. Tách landscape và subsystem.' },
      { dont: 'Chỉ commit HTML', do: 'JSON là nguồn. HTML là viewer. Receipt để audit.' },
      { dont: 'Ép Deployment Ownership khi thiếu fact', do: 'Profile này fail nếu thiếu owner/region/crossing. Local CLI thì đừng dùng.' },
      { dont: 'Biến bước thực thi thành Lifecycle', do: '`download → OCR → package` là Workflow. Lifecycle cần state được lưu.' },
      { dont: 'Xóa nhãn relationship để pass layout', do: 'Nhãn mang protocol/action/contract. Sửa bằng move, reroute, tăng spacing.' },
      { dont: 'Gọi visual-check là human review', do: 'Ảnh là evidence. Người vẫn phải nhìn main path, boundary, label.' },
      { dont: 'Set `meta.locale: "vi"`', do: 'Viết nội dung tiếng Việt, giữ identifier tiếng Anh, omit `meta.locale`. Viewer UI fallback English.' },
    ]
  : [
      { dont: 'One prompt for all five diagrams', do: 'Start with Architecture + Workflow. Add a mode only with a new question.' },
      { dont: 'A mega-diagram of dozens of services', do: 'Cap around 12 primary nodes. Split landscape vs subsystem.' },
      { dont: 'Commit HTML only', do: 'JSON is the source. HTML is the viewer. Receipts are for audit.' },
      { dont: 'Force Deployment Ownership without facts', do: 'That profile fails closed without owner/region/crossing. Skip it for a local CLI.' },
      { dont: 'Turn execution stages into Lifecycle', do: '`download → OCR → package` is Workflow. Lifecycle needs stored state.' },
      { dont: 'Delete relationship labels to pass layout', do: 'Labels carry protocol, action, or contract. Move, reroute, or add spacing.' },
      { dont: 'Treat visual-check as human review', do: 'Screenshots are evidence. A person still checks main path, boundaries, labels.' },
      { dont: 'Set `meta.locale: "vi"`', do: 'Write authored copy in Vietnamese, keep identifiers in English, omit `meta.locale`. Viewer UI falls back to English.' },
    ];

const heroCtaClass =
  'inline-flex min-h-9 shrink-0 items-center whitespace-nowrap rounded-xl border border-slate-200 bg-white px-3 text-sm font-bold text-slate-800 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 dark:border-white/15 dark:bg-white/[0.08] dark:text-white dark:hover:border-white/30 dark:hover:bg-white/[0.14]';
---
<div class="mt-6 space-y-10">
  <section class="relative overflow-hidden rounded-[2rem] border border-cyan-200/80 bg-white p-5 shadow-2xl shadow-cyan-500/10 md:p-6 dark:border-cyan-400/20 dark:bg-slate-950 dark:shadow-cyan-950/30">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_12%_88%,rgba(6,182,212,0.14),transparent_30%),radial-gradient(circle_at_84%_18%,rgba(139,92,246,0.12),transparent_32%),linear-gradient(135deg,#ffffff,#f8fafc_48%,#ecfeff)] dark:bg-[radial-gradient(circle_at_12%_88%,rgba(6,182,212,0.22),transparent_30%),radial-gradient(circle_at_84%_18%,rgba(139,92,246,0.20),transparent_32%),linear-gradient(135deg,#020617,#0f172a_48%,#10233a)]"></div>
    <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
      <div class="space-y-5 lg:max-w-[590px] lg:py-7">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.16em] text-cyan-800 dark:border-cyan-300/20 dark:bg-cyan-300/10 dark:text-cyan-200">
            <span class="h-2 w-2 rounded-full bg-cyan-300 shadow-[0_0_14px_rgba(103,232,249,0.85)]"></span>
            {isVi ? 'Sơ đồ có nguồn, có kiểm' : 'Diagrams with a source and checks'}
          </span>
          <a href="https://github.com/tt-a1i/archify" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white/80 px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm transition hover:border-cyan-300 hover:text-cyan-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-400 dark:hover:border-cyan-300/30 dark:hover:text-cyan-200">
