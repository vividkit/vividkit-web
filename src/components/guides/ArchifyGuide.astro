      {antiPatterns.map((item) => (
        <article class="grid gap-2 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900/70 sm:grid-cols-2">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.14em] text-rose-600 dark:text-rose-300">{isVi ? 'Hay làm' : 'Common habit'}</p>
            <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white" set:html={inlineCodeHtml(item.dont)} />
          </div>
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">{isVi ? 'Nên làm' : 'Better'}</p>
            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300" set:html={inlineCodeHtml(item.do)} />
          </div>
        </article>
      ))}
    </div>
  </section>
</div>

<script>
  const togglePillState = (button: HTMLButtonElement, isActive: boolean) => {
    const activeClasses = ['border-cyan-400', 'bg-cyan-600', 'text-white', 'shadow-sm', 'dark:border-cyan-500'];
    const inactiveClasses = ['border-slate-200', 'bg-white', 'text-slate-600', 'hover:border-cyan-300', 'hover:text-cyan-800', 'dark:border-slate-700', 'dark:bg-slate-900', 'dark:text-slate-300', 'dark:hover:border-cyan-500/40'];
    activeClasses.forEach((className) => button.classList.toggle(className, isActive));
    inactiveClasses.forEach((className) => button.classList.toggle(className, !isActive));
  };

  const initArchifyInstallFilters = (root: HTMLElement) => {
    const select = root.querySelector<HTMLSelectElement>('[data-archify-install-select]');
    const cards = root.querySelectorAll<HTMLElement>('[data-archify-install-card]');
    const setActive = (selected: string) => {
      cards.forEach((card) => {
        card.classList.toggle('hidden', card.dataset.installTarget !== selected);
      });
    };
    select?.addEventListener('change', () => setActive(select.value));
  };

  const initArchifyCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-archify-copy]').forEach((button) => {
      if (button.dataset.archifyCopyBound === 'true') return;
      button.dataset.archifyCopyBound = 'true';
      button.addEventListener('click', async () => {
        const text = button.dataset.archifyCopy || '';
        const label = button.querySelector('span');
        const original = label?.textContent || 'Copy';
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = original.toLowerCase().includes('copy') ? 'Copied' : 'Đã chép';
          setTimeout(() => {
            if (label) label.textContent = original;
          }, 1400);
        } catch (error) {
          console.error('Failed to copy Archify content:', error);
        }
      });
    });
  };

  const initArchifyRecipeFilters = (root: HTMLElement) => {
    const filters = root.querySelectorAll<HTMLButtonElement>('[data-archify-recipe-filter]');
    const groups = root.querySelectorAll<HTMLElement>('[data-archify-recipe-group]');
    const cards = root.querySelectorAll<HTMLElement>('[data-archify-recipe-card]');
    const setActive = (selected: string) => {
      filters.forEach((filter) => togglePillState(filter, filter.dataset.archifyRecipeFilter === selected));
      groups.forEach((group) => {
        const show = selected === 'all' || group.dataset.recipeType === selected;
        group.classList.toggle('hidden', !show);
      });
      cards.forEach((card) => {
        const show = selected === 'all' || card.dataset.recipeType === selected;
        card.classList.toggle('hidden', !show);
      });
    };
    filters.forEach((filter) => {
      filter.addEventListener('click', () => setActive(filter.dataset.archifyRecipeFilter || 'all'));
    });
  };

  document.querySelectorAll<HTMLElement>('[data-archify-install-root]').forEach(initArchifyInstallFilters);
  document.querySelectorAll<HTMLElement>('[data-archify-recipes-root]').forEach(initArchifyRecipeFilters);
  initArchifyCopyButtons();
</script>
