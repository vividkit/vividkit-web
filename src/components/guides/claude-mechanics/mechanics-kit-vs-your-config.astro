---
// Kit-managed plugin content vs your Claude Code project files (AgentKit era)
import { useTranslations } from '@/i18n/utils';
import { type Language } from '@/i18n';
import { AGENTKIT_KIT_STRUCTURE_BY_TARGET } from '@/data/guides/claude-mechanics/agentkit-structure-facts';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icon = `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>`;

const claude = AGENTKIT_KIT_STRUCTURE_BY_TARGET['claude-code'];
const kitFiles = claude.topLevelEntries.filter((entry) =>
  ['agents/', 'hooks/', 'rules/', 'skills/', '.claude-plugin/'].includes(entry),
);
const kitHint = claude.installPathHint;

const yourFiles = [
  'CLAUDE.md',
  'CLAUDE.local.md',
  '.claude/rules/* (project)',
  '.env (gitignored)',
];
---

<section class="space-y-6">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center text-purple-600 dark:text-purple-400">
      <Fragment set:html={icon} />
    </div>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
      {t('guides.claude_mechanics.section_kit_vs_you')}
    </h2>
  </div>

  <p class="text-sm text-slate-600 dark:text-slate-400 max-w-3xl">
    {t('guides.claude_mechanics.kit_vs_you.intro')}
  </p>

  <div class="glass-card rounded-2xl overflow-hidden">
    <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-slate-200 dark:divide-slate-700">
      <div class="p-6 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-500/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white">
              {t('guides.claude_mechanics.kit_vs_you.kit_title')}
            </h3>
            <p class="text-xs text-red-600 dark:text-red-400">
              {t('guides.claude_mechanics.kit_vs_you.warning')}
            </p>
          </div>
        </div>

        <p class="text-sm text-slate-500 dark:text-slate-400">
          {t('guides.claude_mechanics.kit_vs_you.kit_subtitle')}
          <code class="ml-1 text-xs rounded bg-slate-100 dark:bg-slate-800/90 px-1 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700">
            {kitHint}
          </code>
        </p>

        <ul class="space-y-2">
          {kitFiles.map((file) => (
            <li class="flex items-center gap-2 text-sm">
              <span class="w-5 h-5 rounded bg-red-100 dark:bg-red-500/20 flex items-center justify-center">
                <svg class="w-3 h-3 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>
              <code class="text-slate-600 dark:text-slate-400 font-mono text-xs">
                {file}
              </code>
            </li>
          ))}
        </ul>
      </div>

      <div class="p-6 space-y-4 bg-green-50/50 dark:bg-green-500/5">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-500/20 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h3 class="font-bold text-slate-900 dark:text-white">
              {t('guides.claude_mechanics.kit_vs_you.you_title')}
            </h3>
            <p class="text-xs text-green-600 dark:text-green-400">
              {t('guides.claude_mechanics.kit_vs_you.you_subtitle')}
            </p>
          </div>
        </div>

        <p class="text-sm text-slate-500 dark:text-slate-400">
          {t('guides.claude_mechanics.kit_vs_you.you_customizations')}
        </p>

        <ul class="space-y-2">
          {yourFiles.map((file) => (
            <li class="flex items-center gap-2 text-sm">
              <span class="w-5 h-5 rounded bg-green-100 dark:bg-green-500/20 flex items-center justify-center">
                <svg class="w-3 h-3 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <code class="text-slate-600 dark:text-slate-400 font-mono text-xs">
                {file}
              </code>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
