---
// Main wrapper for the "How ClaudeKit Works" interactive workflow visualizer
// Manages Alpine.js shared state for scenario selection, step navigation, and detail panel
import { getLangFromUrl, type Language } from '@/i18n';
import { workflowScenarios, stepTypeColors } from '@/data/guides/how-ck-works';
import WorkflowScenarioSelector from './workflow-scenario-selector.astro';
import WorkflowPipelineView from './workflow-pipeline-view.astro';
import WorkflowStepDetailPanel from './workflow-step-detail-panel.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

// Serialize data at build time — will be injected via <script> to avoid HTML escaping in x-data
const scenariosJson = JSON.stringify(workflowScenarios);
const typeColorsJson = JSON.stringify(stepTypeColors);
---

{/* Inject data BEFORE Alpine processes x-data — avoids HTML entity escaping issue */}
<script is:inline define:vars={{ scenariosJson, typeColorsJson }}>
  window.__wfScenarios = JSON.parse(scenariosJson);
  window.__wfTypeColors = JSON.parse(typeColorsJson);
  // Format explain text: paragraphs on \n\n, bullet lines (•/-/*) as indented <ul><li>
  window.__formatExplain = function(text) {
    if (!text) return '';
    var esc = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    var paragraphs = esc.split(/\n\n+/);
    return paragraphs.map(function(p) {
      var lines = p.split(/\n/);
      var hasBullets = lines.some(function(l) { return /^\s*[•\-\*]\s/.test(l); });
      if (hasBullets) {
        var html = '', inList = false;
        for (var i = 0; i < lines.length; i++) {
          var line = lines[i];
          if (/^\s*[•\-\*]\s/.test(line)) {
            if (!inList) { html += '<ul>'; inList = true; }
            var content = line.replace(/^\s*[•\-\*]\s*/, '').replace(/^(\S[^—–]+)[—–]\s*/, '<strong>$1</strong>— ');
            html += '<li>' + content + '</li>';
          } else {
            if (inList) { html += '</ul>'; inList = false; }
            if (line.trim()) html += '<p>' + line + '</p>';
          }
        }
        if (inList) html += '</ul>';
        return html;
      }
      return '<p>' + p.replace(/\n/g, '<br>') + '</p>';
    }).join('');
  };
</script>

<div
  x-data="{
    activeKit: 'engineer',
    selectedScenario: 'fix',
    currentStep: -1,
    isPlaying: false,
    expandedStep: null,
    playInterval: null,
    scenarios: [],
    typeColors: {},
    colorMap: {
      purple: { iconBg: 'bg-purple-500/10', iconText: 'text-purple-400', ring: 'ring-purple-500/50' },
      blue:   { iconBg: 'bg-blue-500/10',   iconText: 'text-blue-400',   ring: 'ring-blue-500/50' },
      green:  { iconBg: 'bg-green-500/10',  iconText: 'text-green-400',  ring: 'ring-green-500/50' },
      amber:  { iconBg: 'bg-amber-500/10',  iconText: 'text-amber-400',  ring: 'ring-amber-500/50' },
    },

    init() {
      this.scenarios = window.__wfScenarios || [];
      this.typeColors = window.__wfTypeColors || {};
    },

    // Helper methods used by child components (pipeline-view, detail-panel)
    stepState(index) {
      if (this.currentStep < 0) return 'waiting';
      if (index < this.currentStep) return 'completed';
      if (index === this.currentStep) return 'active';
      return 'waiting';
    },
    getColorClass(color, prop) {
      return this.colorMap[color]?.[prop] || '';
    },
    formatExplain(text) { return window.__formatExplain?.(text) || text || ''; },
    get steps() {
      return this.currentScenario?.steps || [];
    },

    get currentScenario() {
      return this.scenarios.find(s => s.id === this.selectedScenario);
    },
    get totalSteps() {
      return this.currentScenario?.steps?.length || 0;
    },

    switchKit(kit) {
      this.activeKit = kit;
      // Auto-select first scenario of the new kit
      const firstOfKit = this.scenarios.find(s => s.kit === kit);
      if (firstOfKit) {
        this.selectedScenario = firstOfKit.id;
        this.resetPipeline();
      }
    },

    get filteredScenarios() {
      return this.scenarios.filter(s => s.kit === this.activeKit);
    },

    selectScenario(id) {
      this.selectedScenario = id;
      this.resetPipeline();
    },

    nextStep() {
      if (this.currentStep < this.totalSteps - 1) {
        this.currentStep++;
        this.expandedStep = this.currentStep;
      } else {
        this.stopPlay();
      }
    },

    prevStep() {
      if (this.currentStep > 0) {
        this.currentStep--;
        this.expandedStep = this.currentStep;
      }
    },

    selectStep(index) {
      if (this.currentStep < 0) this.currentStep = 0;
      if (this.expandedStep === index) {
        this.expandedStep = null;
      } else {
        this.currentStep = Math.max(this.currentStep, index);
        this.expandedStep = index;
      }
    },

    getActiveStep() {
      if (this.expandedStep === null || !this.currentScenario) return null;
      return this.currentScenario.steps[this.expandedStep] || null;
    },

    togglePlay() {
      if (this.isPlaying) {
        this.stopPlay();
      } else {
        this.startPlay();
      }
    },

    startPlay() {
      this.isPlaying = true;
      if (this.currentStep >= this.totalSteps - 1 || this.currentStep < 0) {
        this.currentStep = -1;
        this.expandedStep = null;
      }
      this.playInterval = setInterval(() => {
        this.nextStep();
        if (this.currentStep >= this.totalSteps - 1) {
          this.stopPlay();
        }
      }, 1500);
      this.nextStep();
    },

    stopPlay() {
      this.isPlaying = false;
      if (this.playInterval) {
        clearInterval(this.playInterval);
        this.playInterval = null;
      }
    },

    resetPipeline() {
      this.stopPlay();
      this.currentStep = -1;
      this.expandedStep = null;
    },

    handleKeydown(e) {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        this.nextStep();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        this.prevStep();
      } else if (e.key === ' ') {
        e.preventDefault();
        this.togglePlay();
      }
    },
  }"
  x-on:keydown="handleKeydown($event)"
  tabindex="0"
  class="space-y-8"
>
  {/* Page header */}
  <div class="mb-10 flex flex-col items-center text-center">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white/90 mb-4">
      {isVi ? 'Cách ClaudeKit Hoạt Động' : 'How ClaudeKit Works'}
    </h1>
    
    <div class="w-full space-y-6 text-sm text-gray-700 dark:text-white/70 leading-relaxed">
      <p class="text-base text-gray-800 dark:text-white/80 max-w-3xl mx-auto">
        {isVi
          ? 'ClaudeKit không phải là một phần mềm độc lập hay IDE mới. Nó là một bộ khung (Framework) nâng cao được tích hợp thẳng vào cấu hình native (.claude) của Claude Code trên máy bạn, biến terminal chat thành một hệ thống tự động hóa tác vụ chuyên nghiệp.'
          : 'ClaudeKit is not a standalone app or a new IDE. It is an advanced Framework integrated directly into your native Claude Code configuration (.claude) on your machine, transforming your terminal chat into a professional task automation system.'}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4 text-left">
        <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 shadow-sm dark:shadow-none rounded-xl p-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-blue-500/10 text-blue-500 dark:text-blue-400 mb-3">
             <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white/90 mb-1">{isVi ? '1. Hooks (Hệ thống ngầm)' : '1. Hooks (Background System)'}</h3>
          <p class="text-[13px] text-gray-600 dark:text-white/50">{isVi ? 'Các script chạy lót nền tự động. Khởi tạo config, rules dự án mà bạn không cần copy-paste thủ công mỗi lần.' : 'Background scripts that run automatically. They initialize configs and project rules so you don\'t have to copy-paste them manually.'}</p>
        </div>
        
        <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 shadow-sm dark:shadow-none rounded-xl p-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-green-500/10 text-green-600 dark:text-green-400 mb-3">
             <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white/90 mb-1">{isVi ? '2. Agents (Các chuyên gia)' : '2. Agents (Specialists)'}</h3>
          <p class="text-[13px] text-gray-600 dark:text-white/50">{isVi ? 'Các mô hình được thiết lập riêng (Planner, Tester, Reviewer) với prompt và tool nội bộ, tập trung vào 1 chuyên môn.' : 'Specialized models (Planner, Tester, Reviewer) with internal prompts and tools, focusing on a single task domain.'}</p>
        </div>

        <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 shadow-sm dark:shadow-none rounded-xl p-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center bg-purple-500/10 text-purple-600 dark:text-purple-400 mb-3">
             <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
          </div>
          <h3 class="font-semibold text-gray-900 dark:text-white/90 mb-1">{isVi ? '3. Workflows (Quy trình)' : '3. Workflows (Pipelines)'}</h3>
          <p class="text-[13px] text-gray-600 dark:text-white/50">{isVi ? 'Tổ hợp các Hooks, Skills và Agents chạy nối tiếp nhau từ lệnh nhập của bạn để xử lý luồng việc phức tạp trọn gói.' : 'Pipelines of Hooks, Skills and Agents running sequentially from your command input to handle complex workflows end-to-end.'}</p>
        </div>
      </div>
      
      <div class="mt-4 p-4 border border-blue-200 dark:border-blue-500/20 bg-blue-50 dark:bg-blue-500/5 rounded-lg flex items-start gap-3 text-left">
        <svg class="w-5 h-5 text-blue-500 dark:text-blue-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="text-sm text-blue-900 dark:text-white/70">
          {isVi
            ? 'Cùng xem chi tiết cách Hooks, Skills và Agents điều phối một lệnh thực tế. Chọn quy trình bên dưới và nhấn Play để khám phá cơ chế bên trong.'
            : 'Let\'s see how Hooks, Skills and Agents coordinate a real command. Pick a workflow below and press Play to explore the internal mechanism.'}
        </p>
      </div>
    </div>
  </div>

  {/* Scenario selector with kit tabs */}
  <section>
    <WorkflowScenarioSelector lang={currentLang} />
  </section>

  {/* Pipeline visualization */}
  <section>
    <h2 class="text-xs font-semibold text-gray-500 dark:text-white/30 uppercase tracking-wider mb-3">
      {isVi ? 'Pipeline' : 'Pipeline'}
    </h2>
    <WorkflowPipelineView lang={currentLang} />
  </section>

  {/* Step detail panel */}
  <WorkflowStepDetailPanel lang={currentLang} />

  {/* Keyboard hint */}
  <p class="text-[10px] text-gray-400 dark:text-white/20 text-center pb-4 border-b border-gray-200 dark:border-white/5">
    {isVi
      ? 'Phím tắt: Space = Play/Pause · ← → = Bước trước/sau'
      : 'Keyboard: Space = Play/Pause · ← → = Prev/Next step'}
  </p>

  {/* Next steps CTA */}
  <div class="pt-6 pb-2">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white/90 mb-4 text-center">
      {isVi ? 'Bạn đã sẵn sàng để trải nghiệm?' : 'Ready to experience it yourself?'}
    </h2>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={isVi ? '/vi/guides/cli' : '/guides/cli'}
        class="flex items-center gap-2 px-6 py-2.5 bg-blue-600 dark:bg-white text-white dark:text-black font-semibold rounded-lg hover:bg-blue-700 dark:hover:bg-white/90 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
        {isVi ? 'Cài đặt ClaudeKit ngay' : 'Install ClaudeKit Now'}
      </a>
      <a
        href={isVi ? '/vi/guides/commands' : '/guides/commands'}
        class="flex items-center gap-2 px-6 py-2.5 bg-white dark:bg-white/5 text-gray-700 dark:text-white/90 font-medium rounded-lg border border-gray-200 dark:border-white/10 hover:bg-gray-50 dark:hover:bg-white/10 hover:border-gray-300 dark:hover:border-white/20 shadow-sm dark:shadow-none transition-colors"
      >
        <svg class="w-4 h-4 text-gray-400 dark:text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        {isVi ? 'Khám phá tất cả Lệnh' : 'Explore All Commands'}
      </a>
    </div>
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
</style>

<script>
  import Alpine from 'alpinejs';

  if (!window.Alpine) {
    window.Alpine = Alpine;
    Alpine.start();
  }
</script>
