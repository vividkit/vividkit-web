---
// Purpose-built Quick Ref layout for /ck:plan.
// Presents the dense planning workflow as a readable command reference.
import type { SkillInfographic, ProcessFlowStep } from '@/data/guides/how-ck-works';
import type { Language } from '@/i18n';

interface Props {
  data: SkillInfographic;
  lang: Language;
}

type Tone = {
  rail: string;
  label: string;
  chip: string;
  surface: string;
};

interface ProcessGroup {
  label: string;
  kicker: string;
  steps: ProcessFlowStep[];
  tone: Tone;
}

const { data, lang } = Astro.props;
const isVi = lang === 'vi';
const ckPlanCliHref = isVi ? '/vi/guides/cli-commands#cli-cmd-ck-plan' : '/guides/cli-commands#cli-cmd-ck-plan';

const text = {
  eyebrow: isVi ? 'Tóm tắt nhanh / Lệnh lập plan' : 'Quick Ref / Planning command',
  summary: isVi
    ? 'Dùng khi brief đã đủ rõ và cần tách thành phases, bước kiểm chứng, và lệnh bàn giao cho /ck:cook.'
    : 'Use it when the brief is clear enough to split into phases, validation gates, and a clean /ck:cook handoff.',
  afterBrainstorm: isVi ? 'Sau brainstorm / khi scope đã rõ' : 'After brainstorm / when scope is clear',
  hardGate: isVi ? 'Gate bắt buộc' : 'Required Gate',
  hardGateItems: isVi
    ? [
        { label: 'Plan only', detail: 'Chỉ tạo plan và phase files. Không triển khai code trong bước này.' },
        { label: 'CLI-owned scaffolding', detail: 'Scaffolding dùng `ck plan create/check/uncheck`.' },
        { label: 'Status integrity', detail: 'Không sửa tay bảng phases khi CLI có sẵn.' },
      ]
    : [
        { label: 'Plan only', detail: 'Create only the plan and phase files. Do not implement code in this step.' },
        { label: 'CLI-owned scaffolding', detail: 'Scaffolding uses `ck plan create/check/uncheck`.' },
        { label: 'Status integrity', detail: 'Do not hand-edit the phases table when the CLI is available.' },
      ],
  cliCommand: isVi ? 'Tham chiếu CLI' : 'CLI reference',
  noCode: isVi ? 'Không triển khai' : 'No implementation',
  noCodeDesc: isVi ? 'Chỉ tạo plan và phase files.' : 'Only creates plan and phase files.',
  cliOwned: isVi ? 'CLI quản lý' : 'CLI managed',
  cliOwnedDesc: isVi ? 'Tạo và đổi trạng thái bằng `ck plan`.' : 'Create and update status through `ck plan`.',
  handoff: isVi ? 'Bàn giao rõ' : 'Clear handoff',
  handoffDesc: isVi ? 'Kết thúc bằng validate, red-team, cook, hoặc dừng.' : 'Ends with validate, red-team, cook, or stop.',
  process: isVi ? 'Bản đồ thực thi' : 'Execution Map',
  processDesc: isVi ? 'Bốn lane chính: định vị scope, nghiên cứu, kiểm chứng, rồi bàn giao.' : 'Four lanes: orient scope, research, stress test, then hand off.',
  modes: isVi ? 'Mode nên dùng' : 'Mode Selection',
  modesDesc: isVi ? 'Bắt đầu với auto. Chỉ nâng mode khi scope hoặc rủi ro thật sự cần.' : 'Start with auto. Escalate only when scope or risk demands it.',
  samplePrompt: isVi ? 'Prompt mẫu' : 'Sample prompt',
  useWhen: isVi ? 'Dùng khi' : 'Use when',
  expected: isVi ? 'Kết quả' : 'Expected',
  output: isVi ? 'Artifact tạo ra' : 'Artifacts Produced',
  stack: isVi ? 'Stack được gọi khi cần' : 'Stack Used When Needed',
  extraFlags: isVi ? 'Flags thêm' : 'Extra Flags',
  extraFlagsDesc: isVi ? 'Kết hợp với mode để đổi cách plan tạo test hoặc task.' : 'Combine with a mode to change how the plan handles tests or tasks.',
  outputFlags: isVi ? 'Flags xuất & publish' : 'Output & Publish Flags',
  outputFlagsDesc: isVi
    ? 'Flags tùy chọn đổi deliverable hoặc publish plan. Kết hợp với mọi mode; chạy sau khi red-team & validate xong.'
    : 'Optional flags that change the deliverable or publish the plan. Compose with any mode; run after red-team & validate.',
  sample: isVi ? 'Ví dụ' : 'Example',
  research: isVi ? 'Nghiên cứu' : 'Research',
  redTeam: isVi ? 'Red-team' : 'Red-team',
  validation: isVi ? 'Kiểm chứng' : 'Validate',
  cook: isVi ? 'Cook' : 'Cook',
  deepDive: isVi ? data.deepDiveLink?.labelVi : data.deepDiveLink?.labelEn,
  deepDiveDesc: isVi
    ? 'Mở bài giải thích khi nào nên tăng độ sâu plan hoặc buộc tests-first.'
    : 'Open the guide for when to increase planning depth or force tests-first planning.',
};

const heroFlow = isVi
  ? ['Brief rõ', 'Plan phases', 'Validate / red-team', '/ck:cook']
  : ['Clear brief', 'Plan phases', 'Validate / red-team', '/ck:cook'];

const ruleCards = [
  {
    title: text.noCode,
    desc: text.noCodeDesc,
    marker: 'bg-slate-400',
  },
  {
    title: text.cliOwned,
    desc: text.cliOwnedDesc,
    marker: 'bg-sky-400',
    href: ckPlanCliHref,
    command: 'ck plan',
  },
  {
    title: text.handoff,
    desc: text.handoffDesc,
    marker: 'bg-emerald-400',
  },
];

const tones: Record<string, Tone> = {
  orient: {
    rail: 'bg-sky-400',
    label: 'text-sky-600 dark:text-sky-300',
    chip: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-950/35 dark:text-sky-200 dark:ring-sky-800/60',
    surface: 'bg-sky-50/55 ring-sky-100 dark:bg-sky-950/12 dark:ring-sky-900/35',
  },
  research: {
    rail: 'bg-amber-400',
    label: 'text-amber-700 dark:text-amber-300',
    chip: 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-950/35 dark:text-amber-200 dark:ring-amber-800/60',
    surface: 'bg-amber-50/55 ring-amber-100 dark:bg-amber-950/12 dark:ring-amber-900/35',
  },
  stress: {
    rail: 'bg-rose-400',
    label: 'text-rose-700 dark:text-rose-300',
    chip: 'bg-rose-50 text-rose-700 ring-rose-200 dark:bg-rose-950/35 dark:text-rose-200 dark:ring-rose-800/60',
    surface: 'bg-rose-50/55 ring-rose-100 dark:bg-rose-950/12 dark:ring-rose-900/35',
  },
  handoff: {
    rail: 'bg-emerald-400',
    label: 'text-emerald-700 dark:text-emerald-300',
    chip: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-200 dark:ring-emerald-800/60',
    surface: 'bg-emerald-50/55 ring-emerald-100 dark:bg-emerald-950/12 dark:ring-emerald-900/35',
  },
};

const processGroups: ProcessGroup[] = [
  {
    label: isVi ? 'Định vị' : 'Orient',
    kicker: isVi ? 'Chốt context trước khi plan' : 'Set context before planning',
    steps: data.processFlow.slice(0, 4),
    tone: tones.orient,
  },
  {
    label: isVi ? 'Nghiên cứu' : 'Research',
    kicker: isVi ? 'Lấy đủ bằng chứng' : 'Collect enough evidence',
    steps: data.processFlow.slice(4, 7),
    tone: tones.research,
  },
  {
    label: isVi ? 'Kiểm chứng' : 'Stress Test',
    kicker: isVi ? 'Tìm điểm gãy sớm' : 'Find weak points early',
    steps: data.processFlow.slice(7, 9),
    tone: tones.stress,
  },
  {
    label: isVi ? 'Bàn giao' : 'Handoff',
    kicker: isVi ? 'Đưa plan vào cook' : 'Make the plan executable',
    steps: data.processFlow.slice(9),
    tone: tones.handoff,
  },
];

const modeOrder = ['--auto', '--fast', '--hard', '--deep', '--parallel', '--two'];
const modeAccent: Record<string, string> = {
  '--auto': 'border-slate-200 bg-slate-50 text-slate-800 dark:border-white/10 dark:bg-white/[0.04] dark:text-slate-100',
  '--fast': 'border-emerald-200 bg-emerald-50 text-emerald-800 dark:border-emerald-800/55 dark:bg-emerald-950/25 dark:text-emerald-200',
  '--hard': 'border-orange-200 bg-orange-50 text-orange-800 dark:border-orange-800/55 dark:bg-orange-950/25 dark:text-orange-200',
  '--deep': 'border-violet-200 bg-violet-50 text-violet-800 dark:border-violet-800/55 dark:bg-violet-950/25 dark:text-violet-200',
  '--parallel': 'border-blue-200 bg-blue-50 text-blue-800 dark:border-blue-800/55 dark:bg-blue-950/25 dark:text-blue-200',
  '--two': 'border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-800/55 dark:bg-amber-950/25 dark:text-amber-200',
};

const modes = modeOrder
  .map(flag => data.workflowModes?.find(mode => mode.flag === flag))
  .filter(Boolean);
const modeExamples: Record<string, { prompt: string; when: string; expected: string }> = Object.fromEntries(
  (data.promptExamples || [])
    .filter(p => p.labelEn.startsWith('--') && !p.labelEn.includes(' '))
    .map(p => [p.labelEn, {
      prompt: p.command,
      when: isVi ? p.whenVi : p.whenEn,
      expected: isVi ? p.expectedVi : p.expectedEn,
    }])
);
// Build lookup map for extra flag card and tddCombo data from promptExamples.
const planPromptMap = Object.fromEntries(
  (data.promptExamples || []).map(p => [p.labelEn, p])
);

// Flag cards: visual/structural metadata stays here; prompt examples come from data.
const flagCardDefs = [
  {
    command: '--tdd',
    titleEn: 'Tests-first per phase',
    titleVi: 'Tests-first mỗi phase',
    descEn: 'Composable flag: adds tests-first structure to each phase.',
    descVi: 'Composable flag: thêm cấu trúc tests-first vào từng phase.',
    dataKey: 'flag-tdd',
  },
  {
    command: '--no-tasks',
    titleEn: 'Skip task hydration',
    titleVi: 'Bỏ task hydration',
    descEn: 'Do not create Claude Tasks after the plan is generated.',
    descVi: 'Không tạo Claude Tasks sau khi plan xong.',
    dataKey: 'flag-no-tasks',
  },
];

const flagCards = flagCardDefs.map(def => {
  const pd = planPromptMap[def.dataKey];
  return {
    command: def.command,
    title: isVi ? def.titleVi : def.titleEn,
    desc: isVi ? def.descVi : def.descEn,
    example: pd ? pd.command : '',
    note: pd ? (isVi ? pd.whenVi : pd.whenEn) : '',
  };
});

// tddCombo entries: pulled from data using 'combo-{flag}' keys.
const tddComboDefs = [
  { dataKey: 'combo-hard-tdd' },
  { dataKey: 'combo-deep-tdd' },
  { dataKey: 'combo-parallel-tdd' },
];

const tddCombos = tddComboDefs.map(def => {
  const pd = planPromptMap[def.dataKey];
  return {
    command: pd ? pd.command : '',
    title: pd ? (isVi ? pd.expectedVi : pd.expectedEn) : '',
    note: pd ? (isVi ? pd.whenVi : pd.whenEn) : '',
    recommended: pd?.recommended ?? false,
  };
});
// Output / publish flags (--html, --github, --wiki) — accent per flag.
const outputFlagAccent: Record<string, string> = {
  '--html': 'border-violet-200 bg-violet-50/70 dark:border-violet-800/45 dark:bg-violet-950/18',
  '--github': 'border-slate-200 bg-slate-50/80 dark:border-white/10 dark:bg-white/[0.04]',
  '--wiki': 'border-emerald-200 bg-emerald-50/70 dark:border-emerald-800/45 dark:bg-emerald-950/18',
};
const outputFlags = (data.outputFlags || []).map(f => ({
  flag: f.flag,
  title: isVi ? f.titleVi : f.titleEn,
  desc: isVi ? f.descVi : f.descEn,
  example: f.exampleCommand || '',
  accent: outputFlagAccent[f.flag] || outputFlagAccent['--github'],
}));
const outputItems = (isVi ? data.reportOutput?.descVi : data.reportOutput?.descEn)
  ?.split('•')
  .map(item => item.trim())
  .filter(Boolean) || [];
const outputPattern = isVi ? data.reportOutput?.patternVi : data.reportOutput?.patternEn;
const outputLocation = isVi ? data.reportOutput?.locationVi : data.reportOutput?.locationEn;
const stackPreview = data.skillStack?.slice(0, 9) || [];

const renderInlineCode = (value = '') => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code class="inline-flex max-w-full whitespace-nowrap rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[0.82em] text-slate-800 ring-1 ring-slate-300/70 dark:bg-slate-800/90 dark:text-slate-100 dark:ring-white/10">$1</code>');
---

<div class="space-y-8">
  <header class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm ring-1 ring-white/60 dark:border-white/10 dark:bg-slate-950/55 dark:ring-white/5">
    <div class="pointer-events-none absolute inset-0 opacity-70 dark:opacity-100">
      <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-sky-400 via-amber-300 to-emerald-400"></div>
      <div class="absolute inset-0 bg-[linear-gradient(115deg,rgba(14,165,233,0.10),transparent_28%,rgba(245,158,11,0.08)_56%,rgba(16,185,129,0.10))] dark:bg-[linear-gradient(115deg,rgba(14,165,233,0.16),transparent_30%,rgba(245,158,11,0.10)_62%,rgba(16,185,129,0.13))]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.10)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_72%)]"></div>
    </div>

    <div class="relative grid gap-0 xl:grid-cols-[minmax(0,1fr)_330px]">
      <div class="min-w-0 p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <p class="rounded-full bg-sky-500/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-sky-700 ring-1 ring-sky-500/20 dark:text-sky-300">{text.eyebrow}</p>
          <p class="rounded-full bg-white/70 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200 dark:bg-white/[0.06] dark:text-slate-300 dark:ring-white/10">{text.afterBrainstorm}</p>
        </div>

        <div class="mt-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <h2 class="font-mono text-3xl font-semibold leading-none text-slate-950 dark:text-white sm:text-4xl">{data.command}</h2>
            <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-650 dark:text-slate-300">{text.summary}</p>
          </div>

          <div class="shrink-0 rounded-xl border border-emerald-200 bg-emerald-50/90 px-4 py-3 text-left shadow-sm ring-1 ring-emerald-100 dark:border-white/10 dark:bg-slate-950 dark:ring-white/5">
            <p class="font-mono text-[11px] uppercase tracking-wider text-emerald-700/70 dark:text-slate-500">handoff</p>
            <p class="mt-1 font-mono text-sm font-semibold text-emerald-800 dark:text-emerald-300">/ck:cook {'{absolute-path}'}</p>
          </div>
        </div>

        <div class="mt-6 grid gap-2 sm:grid-cols-4">
          {heroFlow.map((item, index) => (
            <div class="relative rounded-xl border border-slate-200 bg-white/75 px-3 py-3 dark:border-white/10 dark:bg-white/[0.055]">
              {index < heroFlow.length - 1 && <span class="absolute right-[-9px] top-1/2 z-10 hidden h-px w-4 bg-slate-300 dark:bg-white/20 sm:block"></span>}
              <span class="font-mono text-[11px] text-slate-400">0{index + 1}</span>
              <p class="mt-1 text-sm font-semibold text-slate-900 dark:text-white">{item}</p>
            </div>
          ))}
        </div>
      </div>

      {data.hardGate && (
        <aside class="relative border-t border-amber-200 bg-amber-50/80 p-5 dark:border-amber-800/50 dark:bg-amber-950/25 xl:border-l xl:border-t-0">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span>
            </span>
            <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-200">{text.hardGate}</p>
          </div>
          <ol class="mt-3 space-y-2">
            {(text.hardGateItems as { label: string; detail: string }[]).map((item, index) => (
              <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2.5 rounded-lg border border-amber-200/70 bg-white/65 p-2.5 ring-1 ring-amber-100/60 dark:border-amber-800/40 dark:bg-amber-950/30 dark:ring-amber-900/30">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 font-mono text-[11px] font-bold text-white shadow-sm shadow-amber-500/30 dark:bg-amber-400 dark:text-amber-950">{index + 1}</span>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-900 dark:text-amber-200">{item.label}</p>
                  <p class="mt-0.5 text-xs leading-5 text-amber-950/85 dark:text-amber-100/85" set:html={renderInlineCode(item.detail)} />
                </div>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    <div class="relative grid border-t border-slate-200 bg-slate-50/80 dark:border-white/10 dark:bg-slate-950/35 sm:grid-cols-3">
      {ruleCards.map(rule => (
        <div class="border-b border-slate-200 p-4 last:border-b-0 dark:border-white/10 sm:border-b-0 sm:border-r sm:last:border-r-0">
          <div class="flex items-start gap-3">
            <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${rule.marker}`}></span>
            <div>
              <p class="text-sm font-semibold text-slate-900 dark:text-white">{rule.title}</p>
              <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400" set:html={renderInlineCode(rule.desc)} />
              {'href' in rule && rule.href && (
                <a
                  href={rule.href}
                  class="mt-3 inline-flex items-center gap-2 rounded-md bg-sky-50 px-2.5 py-1.5 text-xs font-semibold text-sky-700 ring-1 ring-sky-200 transition hover:bg-sky-100 hover:text-sky-900 dark:bg-sky-400/10 dark:text-sky-200 dark:ring-sky-400/20 dark:hover:bg-sky-400/15 dark:hover:text-white"
                >
                  <code class="font-mono">{rule.command}</code>
                  <span>{text.cliCommand}</span>
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <div class="border-b border-slate-200 p-5 dark:border-white/10">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.process}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.processDesc}</p>
        </div>
        <div class="hidden font-mono text-xs text-slate-400 sm:block">01 -> 11</div>
      </div>
    </div>

    <div class="divide-y divide-slate-200 dark:divide-white/10">
      {processGroups.map((group, groupIndex) => (
        <div class="relative grid gap-4 p-5 lg:grid-cols-[10rem_minmax(0,1fr)]">
          <div class="flex items-start gap-3 lg:block">
            <span class={`mt-1 block h-10 w-1.5 shrink-0 rounded-full ${group.tone.rail} lg:h-12 lg:w-2`}></span>
            <div class="min-w-0 lg:mt-3">
              <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${group.tone.chip}`}>0{groupIndex + 1}</span>
              <p class={`mt-2 text-base font-semibold ${group.tone.label}`}>{group.label}</p>
              <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">{group.kicker}</p>
            </div>
          </div>

          <ol class="grid gap-3 sm:grid-cols-2">
            {group.steps.map(step => (
              <li class={`grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 rounded-xl p-3.5 ring-1 transition duration-200 hover:-translate-y-0.5 hover:shadow-sm ${group.tone.surface}`}>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white font-mono text-xs font-semibold text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/75 dark:text-slate-200 dark:ring-white/10">{step.number}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-5 text-slate-950 dark:text-white">{isVi ? step.titleVi : step.titleEn}</span>
                  {step.descEn && <span class="mt-1 block text-xs leading-5 text-slate-600 dark:text-slate-400">{isVi ? step.descVi : step.descEn}</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.modes}</h3>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.modesDesc}</p>

      <div class="mt-4 space-y-3">
        {modes.map(mode => mode && (
          <article class={`rounded-xl border p-3.5 sm:p-4 ${modeAccent[mode.flag] || modeAccent['--auto']}`}>
            <div class="grid gap-3 lg:grid-cols-[10rem_minmax(0,1fr)] lg:items-stretch">
              <div class="flex min-w-0 flex-wrap items-center gap-2 lg:block">
                <code class="inline-flex whitespace-nowrap rounded-lg bg-white/75 px-2.5 py-1 font-mono text-sm font-semibold ring-1 ring-black/5 dark:bg-white/10 dark:ring-white/10">{mode.flag}</code>
                <span class="text-xs font-semibold text-slate-600 dark:text-slate-300 lg:mt-2 lg:block">{isVi ? mode.modeVi : mode.modeEn}</span>
              </div>

              <dl class="grid min-w-0 gap-2 sm:grid-cols-2">
                <div class="min-w-0 rounded-lg bg-white/60 px-3 py-2.5 ring-1 ring-black/5 dark:bg-slate-950/28 dark:ring-white/10">
                  <dt class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.research}</dt>
                  <dd class="mt-1 text-sm font-semibold leading-5 text-slate-800 dark:text-slate-100">{mode.research}</dd>
                </div>
                <div class="min-w-0 rounded-lg bg-white/60 px-3 py-2.5 ring-1 ring-black/5 dark:bg-slate-950/28 dark:ring-white/10">
                  <dt class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.redTeam}</dt>
                  <dd class="mt-1 text-sm font-semibold leading-5 text-slate-800 dark:text-slate-100">{mode.redTeam}</dd>
                </div>
                <div class="min-w-0 rounded-lg bg-white/60 px-3 py-2.5 ring-1 ring-black/5 dark:bg-slate-950/28 dark:ring-white/10">
                  <dt class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.validation}</dt>
                  <dd class="mt-1 text-sm font-semibold leading-5 text-slate-800 dark:text-slate-100">{mode.validation}</dd>
                </div>
                <div class="min-w-0 rounded-lg bg-white/60 px-3 py-2.5 ring-1 ring-black/5 dark:bg-slate-950/28 dark:ring-white/10">
                  <dt class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.cook}</dt>
                  <dd class="mt-1 font-mono text-sm font-semibold leading-5 text-slate-800 dark:text-slate-100">{mode.cookFlag}</dd>
                </div>
              </dl>
            </div>

            {modeExamples[mode.flag] && (
              <div class="mt-3 grid gap-3 rounded-lg bg-white/72 p-3 ring-1 ring-black/5 dark:bg-slate-950/30 dark:ring-white/10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.95fr)]">
                <div class="min-w-0">
                  <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.samplePrompt}</p>
                  <code class="mt-1.5 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{modeExamples[mode.flag].prompt}</code>
                </div>
                <div class="grid min-w-0 gap-2 sm:grid-cols-2 lg:grid-cols-1">
                  <div class="min-w-0">
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.useWhen}</p>
                    <p class="mt-1 text-xs leading-5 text-slate-650 dark:text-slate-300">{modeExamples[mode.flag].when}</p>
                  </div>
                  <div class="min-w-0">
                    <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.expected}</p>
                    <p class="mt-1 text-xs leading-5 text-slate-650 dark:text-slate-300">{modeExamples[mode.flag].expected}</p>
                  </div>
                </div>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>

    {data.composableFlagsEn && (
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.extraFlags}</h3>
            <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.extraFlagsDesc}</p>
          </div>
        </div>
        <div class="mt-4 space-y-3">
          {flagCards.map(flag => (
            <div class="grid gap-3 rounded-xl border border-slate-200 bg-slate-50/80 p-4 ring-1 ring-white/70 dark:border-white/10 dark:bg-white/[0.04] dark:ring-white/5 lg:grid-cols-[11rem_minmax(0,1fr)_minmax(0,0.9fr)]">
              <div class="min-w-0">
                <code class="inline-flex max-w-full break-words rounded-lg bg-slate-100 px-2.5 py-1 font-mono text-sm font-semibold text-purple-600 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-purple-400 dark:ring-white/10">{flag.command}</code>
                <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white">{flag.title}</p>
                <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{flag.desc}</p>
              </div>
              <div class="min-w-0">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.samplePrompt}</p>
                <code class="mt-1.5 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{flag.example}</code>
              </div>
              <div class="min-w-0 rounded-lg bg-white/70 px-3 py-2.5 ring-1 ring-slate-200/80 dark:bg-slate-950/35 dark:ring-white/10">
                <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.useWhen}</p>
                <p class="mt-1 text-xs leading-5 text-slate-650 dark:text-slate-300">{flag.note}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-4 rounded-xl border border-violet-200 bg-violet-50/65 p-4 dark:border-violet-800/45 dark:bg-violet-950/15">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-wide text-violet-700 dark:text-violet-300">{isVi ? 'Compose với mode' : 'Compose With Modes'}</p>
              <p class="mt-1 text-xs leading-5 text-slate-650 dark:text-slate-300">
                {isVi
                  ? '--tdd kết hợp được với mọi mode, nhưng chọn mode theo scope trước.'
                  : '--tdd can combine with any mode, but pick the mode from scope first.'}
              </p>
            </div>
          </div>
          <div class="mt-3 grid gap-2 lg:grid-cols-3">
            {tddCombos.map(combo => (
              <div class={`rounded-lg border p-3 ${combo.recommended ? 'border-violet-300 bg-white ring-1 ring-violet-200 dark:border-violet-700/60 dark:bg-violet-950/25 dark:ring-violet-800/40' : 'border-violet-200/70 bg-white/70 dark:border-violet-800/40 dark:bg-slate-950/30'}`}>
                <div class="flex flex-wrap items-center gap-2">
                  <code class="rounded-lg bg-slate-100 px-2 py-1 font-mono text-xs font-semibold text-violet-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-violet-200 dark:ring-white/10">{combo.command}</code>
                  {combo.recommended && (
                    <span class="rounded-full bg-violet-600 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white dark:bg-violet-400 dark:text-violet-950">
                      {isVi ? 'Khuyến nghị' : 'Recommended'}
                    </span>
                  )}
                </div>
                <p class="mt-2 text-sm font-semibold leading-5 text-slate-900 dark:text-white">{combo.title}</p>
                <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{combo.note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}

    {outputFlags.length > 0 && (
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.outputFlags}</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.outputFlagsDesc}</p>
        <div class="mt-4 space-y-3">
          {outputFlags.map(flag => (
            <div class={`grid gap-3 rounded-xl border p-4 lg:grid-cols-[11rem_minmax(0,1fr)] ${flag.accent}`}>
              <div class="min-w-0">
                <code class="inline-flex max-w-full break-words rounded-lg bg-white/80 px-2.5 py-1 font-mono text-sm font-semibold text-purple-600 ring-1 ring-black/5 dark:bg-slate-800/90 dark:text-purple-400 dark:ring-white/10">{flag.flag}</code>
                <p class="mt-2 text-sm font-semibold text-slate-900 dark:text-white">{flag.title}</p>
              </div>
              <div class="min-w-0">
                <p class="text-xs leading-5 text-slate-650 dark:text-slate-300">{flag.desc}</p>
                {flag.example && (
                  <>
                    <p class="mt-3 text-[10px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{text.sample}</p>
                    <code class="mt-1.5 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{flag.example}</code>
                  </>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <aside class="space-y-5">
      <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <div class="border-b border-slate-200 p-5 dark:border-white/10">
          <div class="flex flex-col gap-3 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.output}</h3>
              <p class="mt-3 text-base font-semibold leading-6 text-slate-900 dark:text-white">{isVi ? data.reportOutput?.titleVi : data.reportOutput?.titleEn}</p>
            </div>
            {outputLocation && <span class="inline-flex w-fit max-w-full break-words rounded-full bg-emerald-50 px-3 py-1 text-left text-[11px] font-semibold leading-5 text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-950/30 dark:text-emerald-200 dark:ring-emerald-800/50">{outputLocation}</span>}
          </div>
          {outputPattern && <code class="mt-4 block whitespace-normal break-words rounded-xl bg-slate-100 px-4 py-3 font-mono text-sm leading-6 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{outputPattern}</code>}
        </div>
        <div class="grid gap-3 p-5 md:grid-cols-2">
          {outputItems.map((item, index) => (
            <div class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 rounded-xl border border-slate-200 bg-slate-50/75 p-3 dark:border-white/10 dark:bg-white/[0.035]">
              <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white font-mono text-[11px] font-semibold text-slate-600 ring-1 ring-slate-200 dark:bg-slate-950/65 dark:text-slate-300 dark:ring-white/10">{index + 1}</span>
              <p class="text-sm leading-6 text-slate-650 dark:text-slate-300">{item}</p>
            </div>
          ))}
        </div>
      </article>

      <div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.stack}</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {stackPreview.map(item => (
            <span class="rounded-full bg-white px-2.5 py-1 text-xs text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:ring-white/10">{item.name}</span>
          ))}
        </div>
      </div>
    </aside>
  </section>

  <section class="space-y-5">
    {data.deepDiveLink && (
      <a href={isVi ? data.deepDiveLink.hrefVi : data.deepDiveLink.hrefEn} class="group block rounded-2xl border border-sky-200 bg-sky-50/80 p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-sky-300 hover:bg-sky-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-400/70 dark:border-sky-700/50 dark:bg-slate-950/55 dark:hover:border-sky-400/60 dark:hover:bg-sky-950/45 dark:focus-visible:ring-sky-300/40">
        <span class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <span class="flex min-w-0 items-start gap-3">
            <span class="shrink-0 rounded-lg bg-white px-2.5 py-1.5 font-mono text-[10px] font-bold uppercase tracking-wider text-sky-700 ring-1 ring-sky-200 transition group-hover:bg-sky-600 group-hover:text-white dark:bg-sky-400/10 dark:text-sky-200 dark:ring-sky-400/25 dark:group-hover:bg-sky-400/20 dark:group-hover:text-white">
              {isVi ? 'Guide' : 'Guide'}
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold leading-5 text-sky-900 dark:text-sky-100">{text.deepDive}</span>
              <span class="mt-1 block text-xs leading-5 text-slate-600 dark:text-slate-400">{text.deepDiveDesc}</span>
            </span>
          </span>
          <span class="flex shrink-0 items-center gap-2">
            <code class="rounded-lg bg-white px-2.5 py-1 font-mono text-[11px] font-semibold text-sky-800 ring-1 ring-sky-200 dark:bg-sky-400/10 dark:text-sky-100 dark:ring-sky-400/25">--deep</code>
            <code class="rounded-lg bg-white px-2.5 py-1 font-mono text-[11px] font-semibold text-sky-800 ring-1 ring-sky-200 dark:bg-sky-400/10 dark:text-sky-100 dark:ring-sky-400/25">--tdd</code>
            <span class="ml-1 flex h-8 w-8 items-center justify-center rounded-full bg-sky-600 text-white transition group-hover:translate-x-0.5 dark:bg-sky-400/20 dark:text-sky-100">&rarr;</span>
          </span>
        </span>
      </a>
    )}
  </section>
</div>
