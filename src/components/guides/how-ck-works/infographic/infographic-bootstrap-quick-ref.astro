---
// Purpose-built Quick Ref layout for /ck:bootstrap.
// Keeps the generic command grammar but makes the project-bootstrap pipeline explicit.
import type { ProcessFlowStep, SkillInfographic } from '@/data/guides/how-ck-works';
import type { Language } from '@/i18n';

interface Props {
  data: SkillInfographic;
  lang: Language;
}

type Tone = {
  rail: string;
  chip: string;
  surface: string;
  label: string;
};

const { data, lang } = Astro.props;
const isVi = lang === 'vi';
const prompts = data.promptExamples || [];
const modes = data.workflowModes || [];
const stack = data.skillStack || [];
const output = data.reportOutput;

const text = {
  eyebrow: isVi ? 'Tóm tắt nhanh / Bootstrap dự án' : 'Quick Ref / Project bootstrap',
  context: isVi ? 'Từ ý tưởng trống đến project chạy được' : 'From blank idea to running project',
  hardGate: isVi ? 'Gate bắt buộc' : 'Required Gate',
  pipeline: isVi ? 'Bootstrap pipeline' : 'Bootstrap Pipeline',
  pipelineDesc: isVi
    ? 'Pipeline chính: khởi tạo repo, research/design, lập plan, cook implementation, rồi đóng docs/handoff.'
    : 'Main pipeline: initialize repo, research/design, plan, cook the implementation, then close with docs and handoff.',
  modes: isVi ? 'Mode / flag nên dùng' : 'Modes / Flags',
  prompts: isVi ? 'Prompt mẫu' : 'Sample Prompt',
  promptsDesc: isVi
    ? 'Mỗi row là một cách gọi command cho mode đang support.'
    : 'Each row is a concrete invocation for a supported mode.',
  useWhen: isVi ? 'Dùng khi' : 'Use when',
  expected: isVi ? 'Kết quả' : 'Expected',
  recommended: isVi ? 'Khuyến nghị' : 'Recommended',
  artifacts: isVi ? 'Artifact tạo ra' : 'Artifacts Produced',
  stack: isVi ? 'Stack được gọi khi cần' : 'Stack Used When Needed',
  operatingRules: isVi ? 'Luật vận hành' : 'Operating Rules',
};

const tones: Tone[] = [
  {
    rail: 'bg-emerald-400',
    chip: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-200 dark:ring-emerald-800/60',
    surface: 'bg-emerald-50/60 ring-emerald-100 dark:bg-emerald-950/15 dark:ring-emerald-900/35',
    label: 'text-emerald-700 dark:text-emerald-300',
  },
  {
    rail: 'bg-sky-400',
    chip: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-950/35 dark:text-sky-200 dark:ring-sky-800/60',
    surface: 'bg-sky-50/60 ring-sky-100 dark:bg-sky-950/15 dark:ring-sky-900/35',
    label: 'text-sky-700 dark:text-sky-300',
  },
  {
    rail: 'bg-amber-400',
    chip: 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-950/35 dark:text-amber-200 dark:ring-amber-800/60',
    surface: 'bg-amber-50/60 ring-amber-100 dark:bg-amber-950/15 dark:ring-amber-900/35',
    label: 'text-amber-700 dark:text-amber-300',
  },
  {
    rail: 'bg-violet-400',
    chip: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/35 dark:text-violet-200 dark:ring-violet-800/60',
    surface: 'bg-violet-50/60 ring-violet-100 dark:bg-violet-950/15 dark:ring-violet-900/35',
    label: 'text-violet-700 dark:text-violet-300',
  },
];

const title = isVi ? data.header.titleVi : data.header.titleEn;
const tagline = isVi ? data.header.taglineVi : data.header.taglineEn;
const principles = (isVi ? data.corePrinciplesVi : data.corePrinciplesEn) || [];
const expertise = (isVi ? data.expertiseAreasVi : data.expertiseAreasEn) || [];

const gateContent = data.hardGate ? (isVi ? data.hardGate.contentVi : data.hardGate.contentEn) : '';
const gateItems = gateContent
  .split(/(?<=[.!?])\s+|;\s+/)
  .map(item => item.trim())
  .filter(Boolean)
  .slice(0, 4);

const heroFlow = isVi
  ? ['Repo + scope', 'Research + design', 'Plan -> Cook', 'Docs + bàn giao']
  : ['Repo + scope', 'Research + design', 'Plan -> Cook', 'Docs + handoff'];

const pipelineGroups: Array<{ label: string; kicker: string; steps: ProcessFlowStep[]; tone: Tone }> = [
  {
    label: isVi ? 'Khởi động' : 'Start',
    kicker: isVi ? 'Repo, requirements, mode' : 'Repo, requirements, mode',
    steps: data.processFlow.slice(0, 2),
    tone: tones[0],
  },
  {
    label: isVi ? 'Discovery' : 'Discovery',
    kicker: isVi ? 'Research, stack, design gate' : 'Research, stack, design gate',
    steps: data.processFlow.slice(2, 5),
    tone: tones[1],
  },
  {
    label: isVi ? 'Build' : 'Build',
    kicker: isVi ? 'ck:plan -> ck:cook' : 'ck:plan -> ck:cook',
    steps: data.processFlow.slice(5, 7),
    tone: tones[2],
  },
  {
    label: isVi ? 'Đóng' : 'Close',
    kicker: isVi ? 'Docs, onboard, report' : 'Docs, onboard, report',
    steps: data.processFlow.slice(7),
    tone: tones[3],
  },
].filter(group => group.steps.length > 0);

const getPromptLabel = (index: number) => isVi ? prompts[index]?.labelVi : prompts[index]?.labelEn;
const getPromptWhen = (index: number) => isVi ? prompts[index]?.whenVi : prompts[index]?.whenEn;
const getPromptExpected = (index: number) => isVi ? prompts[index]?.expectedVi : prompts[index]?.expectedEn;
---

<div class="space-y-8">
  <header class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/55">
    <div class="grid gap-0 xl:grid-cols-[minmax(0,1fr)_340px]">
      <div class="relative min-w-0 p-5 sm:p-6">
        <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(115deg,rgba(16,185,129,0.10),transparent_30%,rgba(245,158,11,0.08)_62%,rgba(139,92,246,0.10))] dark:bg-[linear-gradient(115deg,rgba(16,185,129,0.16),transparent_30%,rgba(245,158,11,0.10)_62%,rgba(139,92,246,0.13))]"></div>
        <div class="relative">
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-emerald-700 ring-1 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-200 dark:ring-emerald-800/60">{text.eyebrow}</span>
            <span class="rounded-full bg-white/75 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200 dark:bg-white/[0.06] dark:text-slate-300 dark:ring-white/10">{text.context}</span>
          </div>

          <h2 class="mt-5 break-words font-mono text-3xl font-semibold leading-none text-slate-950 dark:text-white sm:text-4xl">{title}</h2>
          <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-650 dark:text-slate-300">{tagline}</p>

          <div class="mt-6 grid gap-2 sm:grid-cols-4">
            {heroFlow.map((step, index) => (
              <div class="rounded-xl border border-slate-200 bg-white/75 px-3 py-3 dark:border-white/10 dark:bg-white/[0.055]">
                <p class="font-mono text-[11px] text-slate-400">{String(index + 1).padStart(2, '0')}</p>
                <p class="mt-1 text-sm font-semibold leading-5 text-slate-900 dark:text-white">{step}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      {data.hardGate && (
        <aside class="border-t border-amber-200 bg-amber-50/80 p-5 dark:border-amber-800/50 dark:bg-amber-950/25 xl:border-l xl:border-t-0">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-amber-500 shadow-sm shadow-amber-500/40"></span>
            <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-200">{text.hardGate}</p>
          </div>
          <ol class="mt-3 space-y-2">
            {gateItems.map((item, index) => (
              <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2.5 rounded-lg border border-amber-200/70 bg-white/65 p-2.5 ring-1 ring-amber-100/60 dark:border-amber-800/40 dark:bg-amber-950/30 dark:ring-amber-900/30">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 font-mono text-[11px] font-bold text-white dark:bg-amber-400 dark:text-amber-950">{index + 1}</span>
                <p class="text-xs leading-5 text-amber-950/85 dark:text-amber-100/85">{item}</p>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    <div class="grid border-t border-slate-200 bg-slate-50/80 dark:border-white/10 dark:bg-slate-950/35 sm:grid-cols-3">
      {principles.slice(0, 3).map((rule, index) => (
        <div class="border-b border-slate-200 p-4 last:border-b-0 dark:border-white/10 sm:border-b-0 sm:border-r sm:last:border-r-0">
          <div class="flex items-start gap-3">
            <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${tones[index].rail}`}></span>
            <div class="min-w-0">
              <p class="break-words text-sm font-semibold text-slate-900 dark:text-white">{rule}</p>
              <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">{expertise[index] || text.operatingRules}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </header>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <div class="border-b border-slate-200 p-5 dark:border-white/10">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.pipeline}</h3>
      <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.pipelineDesc}</p>
    </div>

    <div class="divide-y divide-slate-200 dark:divide-white/10">
      {pipelineGroups.map((group, groupIndex) => (
        <div class="grid gap-4 p-5 lg:grid-cols-[10rem_minmax(0,1fr)]">
          <div class="flex items-start gap-3 lg:block">
            <span class={`mt-1 block h-10 w-1.5 shrink-0 rounded-full ${group.tone.rail} lg:h-12 lg:w-2`}></span>
            <div class="min-w-0 lg:mt-3">
              <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${group.tone.chip}`}>{String(groupIndex + 1).padStart(2, '0')}</span>
              <p class={`mt-2 text-base font-semibold ${group.tone.label}`}>{group.label}</p>
              <p class="mt-1 text-xs leading-5 text-slate-500 dark:text-slate-400">{group.kicker}</p>
            </div>
          </div>

          <ol class="grid gap-3 sm:grid-cols-2">
            {group.steps.map(step => (
              <li class={`grid grid-cols-[2.25rem_minmax(0,1fr)] gap-3 rounded-xl p-3.5 ring-1 ${group.tone.surface}`}>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white font-mono text-xs font-semibold text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/75 dark:text-slate-200 dark:ring-white/10">{step.number}</span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-5 text-slate-950 dark:text-white">{isVi ? step.titleVi : step.titleEn}</span>
                  <span class="mt-1 block text-xs leading-5 text-slate-600 dark:text-slate-400">{isVi ? step.descVi : step.descEn}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.modes}</h3>
    <div class="mt-4 grid gap-3 md:grid-cols-2">
      {modes.map((mode, index) => {
        const tone = tones[index % tones.length];
        return (
          <article class={`rounded-xl border border-transparent p-4 ring-1 ${tone.surface}`}>
            <div class="flex flex-wrap items-center gap-2">
              <code class={`rounded-md px-2 py-1 font-mono text-xs font-semibold ring-1 ${tone.chip}`}>{mode.flag}</code>
              {index === 0 && <span class="rounded-full bg-emerald-500 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white dark:bg-emerald-400 dark:text-emerald-950">{text.recommended}</span>}
            </div>
            <p class="mt-3 text-sm font-semibold leading-5 text-slate-950 dark:text-white">{isVi ? mode.modeVi : mode.modeEn}</p>
            <dl class="mt-3 grid gap-1.5 text-xs leading-5 text-slate-600 dark:text-slate-400">
              <div><dt class="inline font-semibold text-slate-700 dark:text-slate-300">Research: </dt><dd class="inline">{mode.research}</dd></div>
              <div><dt class="inline font-semibold text-slate-700 dark:text-slate-300">Cook: </dt><dd class="inline">{mode.validation}</dd></div>
            </dl>
          </article>
        );
      })}
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.prompts}</h3>
    <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{text.promptsDesc}</p>
    <div class="mt-4 space-y-3">
      {prompts.map((prompt, index) => (
        <article class={`grid gap-3 rounded-xl border p-4 ring-1 lg:grid-cols-[10rem_minmax(0,1fr)] ${prompt.recommended ? 'border-emerald-200 bg-emerald-50/65 ring-emerald-100 dark:border-emerald-700/45 dark:bg-emerald-950/15 dark:ring-emerald-900/30' : 'border-slate-200 bg-slate-50/80 ring-white/70 dark:border-white/10 dark:bg-white/[0.04] dark:ring-white/5'}`}>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class={`rounded-full px-2.5 py-1 text-[11px] font-semibold ring-1 ${prompt.recommended ? 'bg-white text-emerald-700 ring-emerald-200 dark:bg-emerald-950/45 dark:text-emerald-200 dark:ring-emerald-800/60' : tones[index % tones.length].chip}`}>{getPromptLabel(index)}</span>
              {prompt.recommended && <span class="rounded-full bg-emerald-500 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-white dark:bg-emerald-400 dark:text-emerald-950">{text.recommended}</span>}
            </div>
          </div>
          <div class="min-w-0">
            <code class="block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{prompt.command}</code>
            <dl class="mt-3 grid gap-3 text-xs leading-5 text-slate-650 dark:text-slate-300 sm:grid-cols-2">
              <div><dt class="inline font-semibold text-slate-900 dark:text-white">{text.useWhen}: </dt><dd class="inline">{getPromptWhen(index)}</dd></div>
              <div><dt class="inline font-semibold text-slate-900 dark:text-white">{text.expected}: </dt><dd class="inline">{getPromptExpected(index)}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
    {output && (
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.artifacts}</h3>
        <p class="mt-2 text-base font-semibold text-slate-950 dark:text-white">{isVi ? output.titleVi : output.titleEn}</p>
        <code class="mt-3 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-6 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10">{isVi ? output.patternVi : output.patternEn}</code>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{isVi ? output.descVi : output.descEn}</p>
      </article>
    )}

    <aside class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.stack}</h3>
      <div class="mt-3 flex flex-wrap gap-2">
        {stack.map(badge => (
          <span class="rounded-full bg-white px-2.5 py-1 text-xs text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:ring-white/10">{badge.name}</span>
        ))}
      </div>
    </aside>
  </section>
</div>
