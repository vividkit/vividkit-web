              </div>

              <div class="min-w-0">
                <pre class="block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-5 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10" set:html={wrapCommandTokens(getPromptCommand(prompt))} />

                <dl class="mt-3 grid gap-3 text-xs leading-5 text-slate-650 dark:text-slate-300 sm:grid-cols-2">
                  <div class="min-w-0">
                    <dt class="inline font-semibold text-slate-900 dark:text-white">{text.useWhen}: </dt>
                    <dd class="inline">{getPromptWhen(prompt)}</dd>
                  </div>
                  <div class="min-w-0">
                    <dt class="inline font-semibold text-slate-900 dark:text-white">{text.expected}: </dt>
                    <dd class="inline">{getPromptExpected(prompt)}</dd>
                  </div>
                </dl>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  {(scopeItems.length > 0 || stack.length > 0) && (
  <section class:list={['grid gap-5', stack.length > 0 && scopeItems.length > 0 && 'lg:grid-cols-[minmax(0,1fr)_330px]']}>
    {scopeItems.length > 0 && (
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.scope}</h3>
      <ul class="mt-3 grid gap-2.5 sm:grid-cols-2">
        {scopeItems.map((item, index) => (
          <li class="grid grid-cols-[0.875rem_minmax(0,1fr)] gap-2.5 text-sm leading-6 text-slate-600 dark:text-slate-300">
            <span class={`mt-2 h-1.5 w-1.5 shrink-0 rounded-full ${tones[index % tones.length].dot}`}></span>
            <span class="min-w-0">{item}</span>
          </li>
        ))}
      </ul>
    </article>
    )}

    {stack.length > 0 && (
      <aside class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 shadow-sm dark:border-white/10 dark:bg-white/[0.03]">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.stack}</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          {stack.map(badge => (
            badge.href ? (
              <a
                href={badge.href}
                class="rounded-full bg-white px-2.5 py-1 text-xs text-teal-800 ring-1 ring-teal-200/80 transition-colors hover:bg-teal-50 hover:ring-teal-300 dark:bg-slate-950/60 dark:text-teal-200 dark:ring-teal-400/25 dark:hover:bg-teal-950/40"
              >
                {badge.name}
              </a>
            ) : (
              <span class="rounded-full bg-white px-2.5 py-1 text-xs text-slate-700 ring-1 ring-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:ring-white/10">
                {badge.name}
              </span>
            )
          ))}
        </div>
      </aside>
    )}
  </section>
  )}
  {output && (
    <section>
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-white/10 dark:bg-slate-950/45">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">{text.output}</h3>
        <p class="mt-2 text-base font-semibold text-slate-950 dark:text-white">{isVi ? output.titleVi : output.titleEn}</p>
        <div class="mt-3">
          <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">{text.artifactPath}</p>
          <code
            class="mt-1 block whitespace-pre-wrap break-words rounded-lg bg-slate-100 px-3 py-2 font-mono text-xs leading-6 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10"
            set:text={getOutputPattern()}
          />
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{isVi ? output.descVi : output.descEn}</p>
      </article>
    </section>
  )}
</div>
