---
// Generic Quick Ref layout for audited How ClaudeKit Works commands.
// Matches the visual grammar used by ck-brainstorm, ck-plan, and ck-cook.
import type { ProcessFlowStep, PromptExample, SkillInfographic, GuardrailItem, ModeCardData, SpecialOpCard, ProcessGroupLabel } from '@/data/guides/how-ck-works';
import { useTranslatedPath, type Language } from '@/i18n';
import { resolveAkSkillDetail, type AkSkillDetailKit } from '@/data/guides/agentkit-skill-details';
interface Props {
  data: SkillInfographic;
  lang: Language;
  /** CK pages keep mono command titles. AgentKit skill details use a plain human headline. */
  plainHeadline?: boolean;
};

type Tone = {
  rail: string;
  chip: string;
  label: string;
  surface: string;
  dot: string;
};

type ProcessGroup = {
  label: string;
  kicker: string;
  steps: ProcessFlowStep[];
  tone: Tone;
};

const { data, lang, plainHeadline = false } = Astro.props;
const isVi = lang === 'vi';
const translatePath = useTranslatedPath(lang);
const preferredKit: AkSkillDetailKit = data.kit === 'marketer' ? 'marketing' : 'engineer';


const rawTitle = isVi ? data.header.titleVi : data.header.titleEn;
const tagline = isVi ? data.header.taglineVi : data.header.taglineEn;
const humanizeHeadline = (headline: string, blurb: string) => {
  const stripped = headline
    .replace(/^[/\$]ak:[^\s—–]+(?:\s*[—–-]\s*)?/i, '')
    .trim();
  if (stripped && !/^[/\$]ak:/i.test(stripped)) return stripped;
  const first = (blurb.split(/(?<=[.!?])\s+/)[0] || blurb).replace(/[.]$/, '').trim();
  const clause = first.split(/[—–:]/)[0].trim();
  return clause.length >= 12 ? clause : first;
};
const title = plainHeadline ? humanizeHeadline(rawTitle, tagline) : rawTitle;
const principles = (isVi ? data.corePrinciplesVi : data.corePrinciplesEn) || [];
const expertise = (isVi ? data.expertiseAreasVi : data.expertiseAreasEn)?.filter(Boolean) || [];
const modes = data.workflowModes || [];
const promptExamples = data.promptExamples || [];
const stack = (data.skillStack || []).map((badge) => {
  const target =
    plainHeadline && badge.type === 'skill'
      ? resolveAkSkillDetail(badge.name, preferredKit)
      : undefined;
  const isSelf = target && target.skill === data.id && preferredKit === target.kit;
  return {
    ...badge,
    href: target && !isSelf
      ? translatePath(`/guides/agentkit/skills/${target.kit}/${target.skill}`)
      : undefined,
  };
});
const output = data.reportOutput;
const guardrails = data.guardrails || [];
const modeCards = data.modeCards || [];
const specialOps = data.specialOperations || [];
const customGroupLabels = data.processGroupLabels || [];
const processFlow = data.processFlow || [];
const situations = data.situations || [];
const invocation = data.invocation;
const optionTokens = new Set((invocation?.options || []).map((item) => item.token.split(/\s+/)[0]));
const outputFlags = (data.outputFlags || []).filter((flag) => {
  const tok = flag.flag.split(/\s+/)[0];
  return !optionTokens.has(tok) && !optionTokens.has(flag.flag);
});
const scopeItems = expertise.length > 0
  ? expertise
  : processFlow.map((step) => (isVi ? step.titleVi : step.titleEn)).filter(Boolean).slice(0, 6);

const text = {
  eyebrow: isVi ? 'Tóm tắt nhanh / Lệnh' : 'Quick Ref / Command',
  kit: data.kit === 'marketer' ? (isVi ? 'Bộ Marketing' : 'Marketing Kit') : (isVi ? 'Bộ Engineer' : 'Engineer Kit'),
  hardGate: isVi ? 'Gate bắt buộc' : 'Required Gate',
  situations: isVi ? 'Tình huống' : 'Situations',
  situationsDesc: isVi
    ? 'Cùng một lệnh. Chỉ một nhánh xảy ra — không phải hai bước liên tiếp.'
    : 'Same command. Exactly one branch applies — these are not sequential steps.',
  situationOr: isVi ? 'hoặc' : 'or',
  process: isVi ? 'Bản đồ thực thi' : 'Execution Map',
  processDesc: isVi
    ? 'Các nhánh chính từ đầu vào đến kết quả, bám theo cách command chạy khi dùng thật.'
    : "Core lanes from input to output, aligned with the command's real execution path.",
  rules: isVi ? 'Nguyên tắc vận hành' : 'Operating Rules',
  modes: isVi ? 'Mode / route nên dùng' : 'Modes / Routes',
  modePrompt: isVi ? 'Route' : 'Route',
  samplePrompts: isVi ? 'Prompt mẫu' : 'Sample Prompt',
  samplePromptsDesc: isVi
    ? 'Ví dụ gọi command theo từng flag, subcommand, mode hoặc route dùng được trong workflow thực tế.'
    : 'Concrete invocations for each flag, subcommand, mode, or route available in the live workflow.',
  useWhen: isVi ? 'Dùng khi' : 'Use when',
  expected: isVi ? 'Kết quả' : 'Expected',
  recommended: isVi ? 'Khuyến nghị' : 'Recommended',
  scope: isVi ? 'Phạm vi xử lý' : 'Handled Scope',
  stack: isVi ? 'Stack được gọi khi cần' : 'Stack Used When Needed',
  output: isVi ? 'Artifact tạo ra' : 'Artifacts Produced',
  artifactPath: isVi ? 'Mẫu đường dẫn' : 'Pattern',
  guardrails: isVi ? 'Đừng bỏ qua bước bắt buộc' : "Don't skip the required step",
  guardrailsDesc: isVi
    ? 'Mỗi mục đối chiếu một lối tắt dễ mắc với cách làm đúng mà skill yêu cầu.'
    : 'Each item contrasts a tempting shortcut with the required approach.',
  thought: isVi ? 'Lối tắt dễ mắc' : 'Tempting shortcut',
  reality: isVi ? 'Cách làm đúng' : 'Do this instead',
  modeSelection: isVi ? 'Mode nên dùng' : 'Mode Selection',
  modePromptLabel: isVi ? 'Lệnh mẫu' : 'Prompt',
  specialOps: isVi ? 'Tính năng đặc biệt' : 'Special Operations',
  invocation: isVi ? 'Cú pháp, đối số, subcommand' : 'Syntax, arguments, subcommands',
  invocationDesc: isVi
    ? 'Cách gọi skill: cú pháp, đối số vị trí, option dùng chung, rồi từng subcommand với cú pháp và kết quả riêng.'
    : 'How to invoke the skill: syntax, positional arguments, shared options, then each subcommand with its own syntax and outcome.',
  syntax: isVi ? 'Cú pháp' : 'Syntax',
  args: isVi ? 'Đối số' : 'Arguments',
  options: isVi ? 'Option dùng chung' : 'Shared options',
  subcommands: isVi ? 'Subcommand' : 'Subcommands',
  outcome: isVi ? 'Kết quả' : 'Outcome',
  outputFlags: isVi ? 'Flag xuất bản / artifact' : 'Output / publish flags',
  outputFlagsDesc: isVi
    ? 'Chỉ các flag đổi artifact hoặc publish. Không phải toàn bộ option của skill.'
    : 'Only flags that change the artifact or publish it. Not the full option set.',
  composable: isVi ? 'Flag kết hợp' : 'Composable flags',
  composableDesc: isVi
    ? 'Cách các option đi cùng nhau trên cùng một lần gọi. Không thay thế bảng option ở trên.'
    : 'How options work together on one invocation. This does not replace the option cards above.',
  sample: isVi ? 'Ví dụ' : 'Example',
};

const tones: Tone[] = [
  {
    rail: 'bg-emerald-400',
    chip: 'bg-emerald-50 text-emerald-700 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-200 dark:ring-emerald-800/60',
    label: 'text-emerald-700 dark:text-emerald-300',
    surface: 'bg-emerald-50/55 ring-emerald-100 dark:bg-emerald-950/12 dark:ring-emerald-900/35',
    dot: 'bg-emerald-400',
  },
  {
    rail: 'bg-sky-400',
    chip: 'bg-sky-50 text-sky-700 ring-sky-200 dark:bg-sky-950/35 dark:text-sky-200 dark:ring-sky-800/60',
    label: 'text-sky-700 dark:text-sky-300',
    surface: 'bg-sky-50/55 ring-sky-100 dark:bg-sky-950/12 dark:ring-sky-900/35',
    dot: 'bg-sky-400',
  },
  {
    rail: 'bg-amber-400',
    chip: 'bg-amber-50 text-amber-800 ring-amber-200 dark:bg-amber-950/35 dark:text-amber-200 dark:ring-amber-800/60',
    label: 'text-amber-700 dark:text-amber-300',
    surface: 'bg-amber-50/55 ring-amber-100 dark:bg-amber-950/12 dark:ring-amber-900/35',
    dot: 'bg-amber-400',
  },
  {
    rail: 'bg-violet-400',
    chip: 'bg-violet-50 text-violet-700 ring-violet-200 dark:bg-violet-950/35 dark:text-violet-200 dark:ring-violet-800/60',
    label: 'text-violet-700 dark:text-violet-300',
    surface: 'bg-violet-50/55 ring-violet-100 dark:bg-violet-950/12 dark:ring-violet-900/35',
    dot: 'bg-violet-400',
  },
];

const guardrailLooks: Record<string, { rail: string; thoughtChip: string; realityChip: string; surface: string }> = {
  red: {
    rail: 'bg-rose-500',
    thoughtChip: 'bg-rose-50 text-rose-800 ring-rose-200 dark:bg-rose-950/40 dark:text-rose-100 dark:ring-rose-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-rose-200/80 bg-rose-50/40 dark:border-rose-800/40 dark:bg-rose-950/15',
  },
  rose: {
    rail: 'bg-rose-500',
    thoughtChip: 'bg-rose-50 text-rose-800 ring-rose-200 dark:bg-rose-950/40 dark:text-rose-100 dark:ring-rose-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-rose-200/80 bg-rose-50/40 dark:border-rose-800/40 dark:bg-rose-950/15',
  },
  amber: {
    rail: 'bg-amber-500',
    thoughtChip: 'bg-amber-50 text-amber-900 ring-amber-200 dark:bg-amber-950/40 dark:text-amber-100 dark:ring-amber-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-amber-200/80 bg-amber-50/40 dark:border-amber-800/40 dark:bg-amber-950/15',
  },
  blue: {
    rail: 'bg-sky-500',
    thoughtChip: 'bg-sky-50 text-sky-900 ring-sky-200 dark:bg-sky-950/40 dark:text-sky-100 dark:ring-sky-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-sky-200/80 bg-sky-50/40 dark:border-sky-800/40 dark:bg-sky-950/15',
  },
  sky: {
    rail: 'bg-sky-500',
    thoughtChip: 'bg-sky-50 text-sky-900 ring-sky-200 dark:bg-sky-950/40 dark:text-sky-100 dark:ring-sky-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-sky-200/80 bg-sky-50/40 dark:border-sky-800/40 dark:bg-sky-950/15',
  },
  violet: {
    rail: 'bg-violet-500',
    thoughtChip: 'bg-violet-50 text-violet-900 ring-violet-200 dark:bg-violet-950/40 dark:text-violet-100 dark:ring-violet-800/50',
    realityChip: 'bg-emerald-50 text-emerald-800 ring-emerald-200 dark:bg-emerald-950/35 dark:text-emerald-100 dark:ring-emerald-800/50',
    surface: 'border-violet-200/80 bg-violet-50/40 dark:border-violet-800/40 dark:bg-violet-950/15',
  },
};
const defaultGuardrailLook = guardrailLooks.amber;

const heroAccent = data.kit === 'marketer'
  ? 'from-fuchsia-400 via-amber-300 to-sky-400'
  : 'from-emerald-400 via-amber-300 to-violet-400';
const heroWash = data.kit === 'marketer'
  ? 'bg-[linear-gradient(115deg,rgba(217,70,239,0.10),transparent_30%,rgba(245,158,11,0.08)_60%,rgba(14,165,233,0.10))] dark:bg-[linear-gradient(115deg,rgba(217,70,239,0.15),transparent_30%,rgba(245,158,11,0.10)_62%,rgba(14,165,233,0.14))]'
  : 'bg-[linear-gradient(115deg,rgba(16,185,129,0.10),transparent_30%,rgba(245,158,11,0.08)_60%,rgba(139,92,246,0.10))] dark:bg-[linear-gradient(115deg,rgba(16,185,129,0.16),transparent_30%,rgba(245,158,11,0.10)_62%,rgba(139,92,246,0.13))]';

const heroFlow = processFlow.slice(0, 4).map(step => isVi ? step.titleVi : step.titleEn);
const fallbackHeroFlow = isVi ? ['Đầu vào', 'Định tuyến', 'Thực thi', 'Báo cáo'] : ['Input', 'Route', 'Execute', 'Report'];
const heroSteps = heroFlow.length > 0 ? heroFlow : fallbackHeroFlow;

const groupLabels = isVi
  ? [
      { label: 'Khởi động', kicker: 'Đầu vào, phạm vi, route' },
      { label: 'Xử lý', kicker: 'Agent / skill thực thi' },
      { label: 'Kiểm chứng', kicker: 'Gate, review, xác thực' },
      { label: 'Đóng', kicker: 'Báo cáo, bàn giao, artifact' },
    ]
  : [
      { label: 'Start', kicker: 'Input, scope, route' },
      { label: 'Work', kicker: 'Agent / skill execution' },
      { label: 'Verify', kicker: 'Gate, review, validation' },
      { label: 'Close', kicker: 'Report, handoff, artifact' },
    ];

const processGroups: ProcessGroup[] = customGroupLabels.length > 0
  ? customGroupLabels.map((g, i) => ({
      label: isVi ? g.labelVi : g.labelEn,
      kicker: isVi ? g.kickerVi : g.kickerEn,
      steps: processFlow.slice(g.stepSlice?.[0] ?? 0, g.stepSlice?.[1] ?? processFlow.length),
      tone: tones[i % tones.length],
    })).filter(g => g.steps.length > 0)
  : (() => {
      const groupSize = Math.max(1, Math.ceil(processFlow.length / 4));
      return groupLabels
        .map((group, index) => ({
          ...group,
          steps: processFlow.slice(index * groupSize, (index + 1) * groupSize),
          tone: tones[index],
        }))
        .filter(group => group.steps.length > 0);
    })();

const ruleCards = principles.map((item, index) => ({
  title: isVi
    ? `Nguyên tắc ${String(index + 1).padStart(2, '0')}`
    : `Rule ${String(index + 1).padStart(2, '0')}`,
  desc: item,
  marker: tones[index % tones.length].rail,
}));

const hardGateContent = data.hardGate ? (isVi ? data.hardGate.contentVi : data.hardGate.contentEn) : '';
const hardGateTitle = data.hardGate ? (isVi ? data.hardGate.titleVi : data.hardGate.titleEn) : '';
const inferGateLabel = (detail: string, index: number) => {
  if (index === 0) return hardGateTitle;
  if (/^(Stop|Dừng)\b/i.test(detail)) return isVi ? 'Điều kiện dừng' : 'Stop conditions';
  if (/^(Ask|Hỏi)\b/i.test(detail)) return isVi ? 'Hỏi user' : 'Ask user';
  if (/^(Never|Không)\b/i.test(detail)) return isVi ? 'Không được làm' : 'Never';
  if (/^(Verify|Validate|Check|Kiểm)\b/i.test(detail)) return isVi ? 'Kiểm chứng' : 'Verify';
  if (/^(Route|Parse|Detect|Load|Đọc|Parse|Detect)\b/i.test(detail)) return isVi ? 'Định tuyến' : 'Routing';
  return isVi ? `Gate ${index + 1}` : `Gate ${index + 1}`;
};
const hardGateItems = hardGateContent
  .split(/(?<=[.!?])\s+|;\s+/)
  .map(item => item.trim())
  .filter(Boolean)
  .slice(0, 5)
  .map((detail, index) => ({
    label: inferGateLabel(detail, index),
    detail,
  }));

const renderInlineCode = (value = '') => value
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/>/g, '&gt;')
  .replace(/`([^`]+)`/g, '<code class="rounded bg-white/80 px-1.5 py-0.5 font-mono text-[0.82em] text-amber-950 ring-1 ring-amber-200 dark:bg-amber-950/45 dark:text-amber-100 dark:ring-amber-700/60">$1</code>');

const getPromptLabel = (prompt: PromptExample) => isVi ? prompt.labelVi : prompt.labelEn;
const getPromptWhen = (prompt: PromptExample) => isVi ? prompt.whenVi : prompt.whenEn;
const getPromptExpected = (prompt: PromptExample) => isVi ? prompt.expectedVi : prompt.expectedEn;
const getPromptCommand = (prompt: PromptExample) => (isVi ? prompt.commandVi : prompt.command);
const getOutputPattern = () => (isVi ? output?.patternVi : output?.patternEn)?.trim() || '';
const LONG_TOKEN_RE = /(?:\/ak:[a-z0-9-]+|\$ak:[a-z0-9-]+|--[a-z0-9][a-z0-9-]*)/g;
const SHORT_FLAG_RE = /(^|[\s"'`])(-[a-z]{1,3})(?=[\s"'`|,)]|$)/g;
const wrapCommandTokens = (value = '') =>
  renderInlineCode(value)
    .replace(new RegExp(LONG_TOKEN_RE.source, 'g'), (flag) => `<code class="rounded-md bg-white px-1.5 py-0.5 font-mono text-[0.82em] font-semibold text-purple-600 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-purple-400 dark:ring-white/10">${flag}</code>`)
    .replace(new RegExp(SHORT_FLAG_RE.source, 'g'), (all, pre, flag) => `${pre}<code class="rounded-md bg-white px-1.5 py-0.5 font-mono text-[0.82em] font-semibold text-purple-600 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-purple-400 dark:ring-white/10">${flag}</code>`);
const syntaxAlts = String(invocation?.syntax || '')
  .split(/\s+OR\s+/)
  .map((part) => part.trim())
  .filter(Boolean);
const syntaxBoxClass = 'block whitespace-pre-wrap break-words rounded-xl bg-slate-100 px-3 py-2.5 font-mono text-xs leading-6 text-slate-700 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-200 dark:ring-white/10';
const composableRaw = (isVi ? data.composableFlagsVi : data.composableFlagsEn) || '';
const composableCards = composableRaw
  .split(/(?<=[.。;；])\s+| · /)
  .map((sentence) => sentence.trim())
  .filter(Boolean)
  .map((sentence) => ({
    html: wrapCommandTokens(sentence),
  }));
---

<div class="space-y-8">
  <header class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm ring-1 ring-white/60 dark:border-white/10 dark:bg-slate-950/55 dark:ring-white/5">
    <div class="pointer-events-none absolute inset-0 opacity-80 dark:opacity-100">
      <div class={`absolute inset-x-0 top-0 h-px bg-gradient-to-r ${heroAccent}`}></div>
      <div class={`absolute inset-0 ${heroWash}`}></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(148,163,184,0.10)_1px,transparent_1px),linear-gradient(90deg,rgba(148,163,184,0.10)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:linear-gradient(to_bottom,black,transparent_72%)]"></div>
    </div>

    <div class="relative grid gap-0 xl:grid-cols-[minmax(0,1fr)_330px]">
      <div class="min-w-0 p-5 sm:p-6">
        <div class="flex flex-wrap items-center gap-2">
          <p class={`${tones[0].chip} rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wider ring-1`}>
            {text.eyebrow}
          </p>
          <p class="rounded-full bg-white/70 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-200 dark:bg-white/[0.06] dark:text-slate-300 dark:ring-white/10">
            {text.kit}
          </p>
        </div>

        <div class="mt-5">
          {plainHeadline && data.command && (
            <p class="font-mono text-sm font-semibold tracking-tight text-teal-700 dark:text-teal-300">
              {data.command}
            </p>
          )}
          <h2
            class:list={[
              'break-words text-3xl font-semibold text-slate-950 dark:text-white sm:text-4xl',
              plainHeadline ? 'mt-2 leading-[1.12] tracking-tight' : 'font-mono leading-none',
            ]}
          >
            {title}
          </h2>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-300">
            {tagline}
          </p>
        </div>

        <div class="mt-6 grid gap-2 sm:grid-cols-4">
          {heroSteps.map((step, index) => (
            <div class="relative min-w-0 rounded-xl border border-slate-200 bg-white/75 px-3 py-3 dark:border-white/10 dark:bg-white/[0.055]">
              <span class="font-mono text-[11px] text-slate-400">{String(index + 1).padStart(2, '0')}</span>
              <p class="mt-1 break-words text-sm font-semibold leading-5 text-slate-900 dark:text-white">{step}</p>
            </div>
          ))}
        </div>
      </div>

      {data.hardGate && (
        <aside class="relative border-t border-amber-200 bg-amber-50/80 p-5 dark:border-amber-800/50 dark:bg-amber-950/25 xl:border-l xl:border-t-0">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-amber-500"></span>
            </span>
            <p class="text-xs font-semibold uppercase tracking-wider text-amber-900 dark:text-amber-200">{text.hardGate}</p>
          </div>
          <ol class="mt-3 space-y-2">
            {hardGateItems.map((item, index) => (
              <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2.5 rounded-lg border border-amber-200/70 bg-white/65 p-2.5 ring-1 ring-amber-100/60 dark:border-amber-800/40 dark:bg-amber-950/30 dark:ring-amber-900/30">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 font-mono text-[11px] font-bold text-white shadow-sm shadow-amber-500/30 dark:bg-amber-400 dark:text-amber-950">{index + 1}</span>
                <div class="min-w-0">
                  <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-900 dark:text-amber-200">{item.label}</p>
                  <p class="mt-0.5 text-xs leading-5 text-amber-950/85 dark:text-amber-100/85" set:html={renderInlineCode(item.detail)} />
                </div>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>

    {ruleCards.length > 0 && (
      <div class="relative grid grid-cols-1 overflow-hidden border-t border-slate-200 bg-slate-50/80 dark:border-white/10 dark:bg-slate-950/35 sm:grid-cols-2 xl:grid-cols-3">
        {ruleCards.map((rule) => (
          <div class="border-b border-slate-200 p-4 dark:border-white/10 sm:border-r">
            <div class="flex items-start gap-3">
              <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${rule.marker}`}></span>
              <div class="min-w-0">
                <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{rule.title}</p>
