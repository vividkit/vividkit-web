---
// Two-column layout for Core Principles and Expertise Areas
import type { Language } from '@/i18n';

interface Props {
  principles?: string[];
  expertise?: string[];
  lang: Language;
}

const { principles, expertise, lang } = Astro.props;
const isVi = lang === 'vi';

// Skip rendering if no data
const hasPrinciples = principles && principles.length > 0;
const hasExpertise = expertise && expertise.length > 0;
if (!hasPrinciples && !hasExpertise) return null;
---

<div class="grid md:grid-cols-2 gap-4 mb-8">
  <!-- Core Principles -->
  {hasPrinciples && (
    <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-5">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-8 h-8 rounded-lg bg-amber-500/10 flex items-center justify-center">
          <svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 dark:text-white">
          {isVi ? 'Nguyên Tắc Cốt Lõi' : 'Core Principles'}
        </h3>
      </div>
      <ul class="space-y-2">
        {principles.map(p => (
          <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-white/70">
            <span class="text-amber-500 mt-0.5 font-bold">›</span>
            <span set:html={p.replace(/^([A-Z]+)\s*—/, '<strong class="text-amber-500">$1</strong> —')} />
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Expertise Areas -->
  {hasExpertise && (
    <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-5">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-8 h-8 rounded-lg bg-yellow-500/10 flex items-center justify-center">
          <svg class="w-4 h-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 dark:text-white">
          {isVi ? 'Lĩnh Vực Chuyên Môn' : 'Expertise Areas'}
        </h3>
      </div>
      <ul class="space-y-2">
        {expertise.map(e => (
          <li class="flex items-start gap-2 text-sm text-gray-700 dark:text-white/70">
            <span class="text-yellow-500 mt-0.5 font-bold">›</span>
            <span>{e}</span>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
