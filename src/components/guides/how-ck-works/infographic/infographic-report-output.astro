---
// Report output section showing file pattern and description
import type { Language } from '@/i18n';

interface Props {
  data: {
    titleEn: string;
    titleVi: string;
    patternEn: string;
    patternVi: string;
    descEn: string;
    descVi: string;
  };
  lang: Language;
}

const { data, lang } = Astro.props;
const isVi = lang === 'vi';

// Skip if no data
if (!data) return null;
---

<div class="mb-8">
  <h2 class="text-xs font-semibold text-gray-500 dark:text-white/40 uppercase tracking-wider mb-3">
    {isVi ? 'ĐẦU RA' : 'OUTPUT'}
  </h2>

  <div class="bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 rounded-xl p-5">
    <div class="flex items-start gap-3">
      <!-- Icon -->
      <div class="w-10 h-10 rounded-lg bg-green-500/10 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>

      <div class="flex-1 min-w-0">
        <!-- Title -->
        <h3 class="font-semibold text-gray-900 dark:text-white mb-1">
          {isVi ? data.titleVi : data.titleEn}
        </h3>

        <!-- File pattern -->
        <code class="inline-block text-sm bg-gray-100 dark:bg-white/10 px-2 py-1 rounded font-mono text-gray-700 dark:text-white/80 mb-2">
          {isVi ? data.patternVi : data.patternEn}
        </code>

        <!-- Description -->
        <p class="text-sm text-gray-600 dark:text-white/60">
          {isVi ? data.descVi : data.descEn}
        </p>
      </div>
    </div>
  </div>
</div>
