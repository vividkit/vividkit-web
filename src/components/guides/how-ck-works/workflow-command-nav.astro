---
import type { Language } from '@/i18n';

interface NavCommand {
  id: string;
  command: string;
  titleEn: string;
  titleVi: string;
  descEn: string;
  descVi: string;
}

interface Props {
  previous: NavCommand;
  next: NavCommand;
  lang: Language;
}

const { previous, next, lang } = Astro.props;
const isVi = lang === 'vi';

const label = {
  previous: isVi ? 'Lệnh trước' : 'Previous command',
  next: isVi ? 'Lệnh tiếp theo' : 'Next command',
};

const getTitle = (item: NavCommand) => isVi ? item.titleVi : item.titleEn;
const getDesc = (item: NavCommand) => isVi ? item.descVi : item.descEn;
---

<nav class="mt-8 grid gap-3 md:grid-cols-2" aria-label={isVi ? 'Điều hướng lệnh' : 'Command navigation'}>
  <a
    href={`#ck-${previous.id}`}
    x-on:click.prevent={`navigateToScenario('${previous.id}')`}
    class="group flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400/60 dark:border-white/10 dark:bg-slate-950/45 dark:hover:border-white/20 dark:hover:bg-white/[0.045] dark:focus-visible:ring-white/30"
  >
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 ring-1 ring-slate-200 transition group-hover:-translate-x-0.5 dark:bg-white/[0.055] dark:text-slate-300 dark:ring-white/10" aria-hidden="true">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </span>
    <span class="min-w-0">
      <code class="block truncate rounded bg-slate-100 px-2 py-0.5 font-mono text-xs font-semibold text-slate-800 ring-1 ring-slate-200 dark:bg-slate-800/90 dark:text-slate-100 dark:ring-white/10">{previous.command}</code>
      <span class="mt-1 block truncate text-sm font-medium text-slate-700 dark:text-slate-300">{getTitle(previous)}</span>
    </span>
  </a>

  <a
    href={`#ck-${next.id}`}
    x-on:click.prevent={`navigateToScenario('${next.id}')`}
    class="group flex items-center justify-end gap-3 rounded-2xl border border-emerald-200 bg-emerald-50/70 px-4 py-3 text-right shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:bg-emerald-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400/60 dark:border-emerald-800/45 dark:bg-emerald-950/18 dark:hover:border-emerald-700/70 dark:hover:bg-emerald-950/25 dark:focus-visible:ring-emerald-400/30"
  >
    <span class="min-w-0">
      <code class="block truncate rounded bg-white px-2 py-0.5 font-mono text-xs font-semibold text-emerald-800 ring-1 ring-emerald-200 dark:bg-emerald-950/45 dark:text-emerald-100 dark:ring-emerald-800/60">{next.command}</code>
      <span class="mt-1 block truncate text-sm font-medium text-slate-700 dark:text-slate-300">{getTitle(next)}</span>
    </span>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-emerald-700 ring-1 ring-emerald-200 transition group-hover:translate-x-0.5 dark:bg-emerald-950/45 dark:text-emerald-200 dark:ring-emerald-800/60" aria-hidden="true">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </a>
</nav>
