      id: 'backend-platform',
      labelEn: 'Backend & Platform',
      labelVi: 'Backend & nền tảng',
      descEn: 'APIs, auth, databases, DevOps, mobile, payments, and MCP.',
      descVi: 'API, auth, database, DevOps, mobile, payment, và MCP.',
      ids: ['backend-development', 'better-auth', 'databases', 'devops', 'mobile-development', 'payment-integration', 'shopify', 'tanstack', 'google-adk-python', 'mcp-builder', 'agentize'],
    },
    {
      id: 'ops-security-docs',
      labelEn: 'Ops, Security & Docs',
      labelVi: 'Ops, security & docs',
      descEn: 'Git, debugging, security, documentation, context packs, and project control.',
      descVi: 'Git, debug, security, tài liệu, context pack, và điều phối project.',
      ids: ['git', 'debug', 'security', 'security-scan', 'cti-expert', 'retro', 'docs', 'journal', 'llms', 'repomix', 'graphify', 'gkg', 'context-engineering', 'project-management', 'project-organization', 'plans-kanban', 'watzup', 'worktree', 'xia'],
    },
    {
      id: 'media-specialists',
      labelEn: 'Media & Specialists',
      labelVi: 'Media & tiện ích',
      descEn: 'Images, browsers, diagrams, media processing, and niche utilities.',
      descVi: 'Ảnh, browser, diagram, xử lý media, và các tiện ích.',
      ids: ['ai-artist', 'ai-multimodal', 'agent-browser', 'chrome-devtools', 'coding-level', 'copywriting', 'find-skills', 'markdown-novel-viewer', 'media-processing', 'mermaidjs-v11', 'mintlify', 'skill-creator', 'tech-graph', 'template-skill', 'excalidraw'],
    },
  ],
  marketer: [
    {
      id: 'gtm-core',
      labelEn: 'GTM Core',
