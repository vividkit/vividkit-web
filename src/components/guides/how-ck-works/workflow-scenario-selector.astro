    },
    {
      id: 'strategy-research',
      labelEn: 'Strategy & Research',
      labelVi: 'Chiến lược & nghiên cứu',
      descEn: 'Market research, competitors, analytics, pricing, funnels, and launches.',
      descVi: 'Research thị trường, competitor, analytics, pricing, funnel, và launch.',
      ids: ['marketing-research', 'competitor', 'analytics', 'analyze', 'marketing-ideas', 'marketing-planning', 'marketing-psychology', 'pricing-strategy', 'launch-strategy', 'funnel', 'free-tool-strategy', 'ab-test-setup'],
    },
    {
      id: 'content-brand',
      labelEn: 'Content & Brand Assets',
      labelVi: 'Nội dung & brand asset',
      descEn: 'Content hubs, YouTube, slides, banners, logos, and brand systems.',
      descVi: 'Content hub, YouTube, slides, banner, logo, và brand system.',
      ids: ['content-hub', 'content-marketing', 'creativity', 'youtube', 'youtube-thumbnail-design', 'slides', 'banner-design', 'logo-design', 'brand', 'cip-design', 'design-system', 'assets-organizing'],
    },
    {
      id: 'growth-ops',
      labelEn: 'Growth Ops',
      labelVi: 'Growth ops',
      descEn: 'Ads, referrals, CRO, gamification, dashboards, storage, and launch ops.',
      descVi: 'Ads, referral, CRO, gamification, dashboard, storage, và launch ops.',
      ids: ['paid-ads', 'ads-management', 'affiliate-marketing', 'referral-program-building', 'onboarding-cro', 'form-cro', 'gamification-marketing', 'dashboard', 'marketing-dashboard', 'hub', 'kit-builder', 'init', 'storage', 'elevenlabs', 'claude-code', 'debugging', 'play'],
    },
    {
      id: 'shared-utilities',
      labelEn: 'Shared Utilities',
      labelVi: 'Tiện ích dùng chung',
      descEn: 'Marketing-facing wrappers for shared ClaudeKit command families.',
      descVi: 'Các wrapper marketing cho nhóm lệnh ClaudeKit dùng chung.',
      ids: ['ckm-ask', 'ckm-docs', 'ckm-journal', 'ckm-plan', 'ckm-preview', 'ckm-test', 'ckm-watzup', 'ckm-worktree', 'kanban', 'skill', 'use-mcp'],
    },
  ],
};
---

<style>
  [x-cloak] { display: none !important; }
</style>

{/* Embed picker metadata for Alpine.js access */}
<script define:vars={{ phaseCounts, skillPickerSections }} is:inline>
  window.__ckPhaseCounts = phaseCounts;
  window.__ckSkillPickerSections = skillPickerSections;
</script>

<div class="space-y-4" x-cloak>
  <div class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm dark:border-white/10 dark:bg-slate-950/45 dark:shadow-none md:p-4">
    <div class="flex flex-col gap-3 xl:flex-row xl:items-center xl:justify-between">
      <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:items-center">
        <div class="inline-flex w-full rounded-xl border border-slate-200 bg-slate-100 p-1 dark:border-white/10 dark:bg-white/5 sm:w-fit">
          <button
            x-on:click="switchKit('engineer')"
            x-bind:class="activeKit === 'engineer' ? 'bg-teal-600 text-white shadow-sm dark:bg-teal-500' : 'text-slate-600 hover:bg-white dark:text-slate-400 dark:hover:bg-white/10'"
            class="min-h-11 flex-1 rounded-lg px-3 text-sm font-semibold transition-all duration-200 sm:flex-none"
            type="button"
          >
            <span class="flex items-center justify-center gap-2">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              {isVi ? 'Bộ Engineer' : 'Engineer Kit'}
              <span
                x-bind:class="activeKit === 'engineer' ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-600 dark:bg-white/10 dark:text-slate-300'"
                class="rounded-full px-2 py-0.5 text-xs font-semibold transition-colors"
              >{engineerCount}</span>
            </span>
          </button>
          <button
            x-on:click="switchKit('marketer')"
            x-bind:class="activeKit === 'marketer' ? 'bg-fuchsia-600 text-white shadow-sm dark:bg-fuchsia-500' : 'text-slate-600 hover:bg-white dark:text-slate-400 dark:hover:bg-white/10'"
            class="min-h-11 flex-1 rounded-lg px-3 text-sm font-semibold transition-all duration-200 sm:flex-none"
            type="button"
          >
            <span class="flex items-center justify-center gap-2">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
              </svg>
              {isVi ? 'Bộ Marketing' : 'Marketing Kit'}
              <span
                x-bind:class="activeKit === 'marketer' ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-600 dark:bg-white/10 dark:text-slate-300'"
                class="rounded-full px-2 py-0.5 text-xs font-semibold transition-colors"
              >{marketerCount}</span>
            </span>
          </button>
        </div>
      </div>

      <label class="relative block w-full xl:max-w-md">
        <span class="sr-only">{isVi ? 'Tìm skill hoặc command' : 'Search skills or commands'}</span>
        <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400 dark:text-white/35" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15Z" />
        </svg>
        <input
          x-model.debounce.120ms="skillSearch"
          type="search"
          class="min-h-11 w-full rounded-xl border border-slate-200 bg-white py-2 pl-10 pr-10 text-base text-slate-900 outline-none transition focus:border-sky-400 focus:ring-4 focus:ring-sky-500/10 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:placeholder:text-white/35 dark:focus:border-sky-400"
          placeholder={isVi ? 'Tìm theo /ckm:seo, dashboard, research...' : 'Search /ckm:seo, dashboard, research...'}
        />
        <button
          x-show="skillSearch"
          x-on:click="skillSearch = ''"
          type="button"
          class="absolute right-2 top-1/2 inline-flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-white/10 dark:hover:text-white"
          aria-label={isVi ? 'Xóa tìm kiếm' : 'Clear search'}
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </label>
    </div>

  </div>

  {/* Collapsible skill catalog — bounded internal scroll keeps the page short */}
  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-white/10 dark:bg-slate-950/45 dark:shadow-none">
    <button
      x-on:click="showCatalog = !showCatalog"
      x-bind:aria-expanded="showCatalog"
      aria-controls="skill-catalog-panel"
      type="button"
      class="flex min-h-12 w-full items-center justify-between gap-3 px-4 py-3 text-left transition hover:bg-slate-50 dark:hover:bg-white/5"
    >
      <span class="flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-900 dark:text-white">
        <svg class="h-4 w-4 shrink-0 text-slate-400 dark:text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span>{isVi ? 'Duyệt tất cả skill theo nhóm' : 'Browse all skills by group'}</span>
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600 dark:bg-white/10 dark:text-slate-300">
          <span x-text="visibleSkillCount()"></span>
          <span>{isVi ? ' skill' : ' skills'}</span>
        </span>
      </span>
      <span class="flex shrink-0 items-center gap-2">
        <span class="hidden text-xs text-slate-400 dark:text-white/35 md:inline" x-text="showCatalog ? (isVi ? 'Thu gọn' : 'Collapse') : (isVi ? 'Mở rộng' : 'Expand')"></span>
        <svg class="h-4 w-4 text-slate-400 transition-transform duration-200 dark:text-white/40" x-bind:class="showCatalog ? 'rotate-180' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
        </svg>
      </span>
    </button>

    <div
      id="skill-catalog-panel"
      x-show="showCatalog"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      class="border-t border-slate-200 dark:border-white/10"
    >
      <div class="grid gap-3 p-3 md:p-4 lg:grid-cols-[220px_minmax(0,1fr)]">
        <aside class="min-w-0 lg:self-start">
          <div class="mb-2 px-1 text-xs font-semibold uppercase text-slate-400 dark:text-white/35">
            {isVi ? 'Nhóm skill' : 'Skill Groups'}
          </div>
          <div class="flex gap-1.5 overflow-x-auto pb-1 lg:block lg:space-y-1.5 lg:overflow-visible lg:pb-0">
            <template x-for="section in activeSkillSections" :key="section.id">
              <button
                x-show="filteredSectionScenarios(section).length"
                x-on:click="scrollToSkillGroup(section.id)"
                type="button"
                class="flex min-h-10 shrink-0 items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50/70 px-3 py-2 text-left text-[13px] font-medium text-slate-700 transition hover:border-slate-300 hover:bg-white hover:text-slate-950 dark:border-white/10 dark:bg-white/[0.035] dark:text-white/70 dark:hover:border-white/20 dark:hover:bg-white/[0.07] dark:hover:text-white lg:w-full"
              >
                <span class="truncate" x-text="isVi ? section.labelVi : section.labelEn"></span>
                <span
                  class="shrink-0 rounded-full bg-slate-200/70 px-1.5 py-0.5 text-[11px] font-semibold tabular-nums text-slate-500 dark:bg-white/10 dark:text-white/45"
                  x-text="filteredSectionScenarios(section).length"
                ></span>
              </button>
            </template>
          </div>
        </aside>

        <div id="skill-catalog-scroll" class="relative min-w-0 max-h-[60vh] space-y-5 overflow-y-auto overscroll-contain pr-1 lg:max-h-[32rem]">
          <template x-for="section in activeSkillSections" :key="section.id">
            <section
              x-show="filteredSectionScenarios(section).length"
              x-bind:id="'skill-group-' + section.id"
            >
              <div class="mb-2 flex items-end justify-between gap-2 border-b border-slate-200 pb-2 dark:border-white/10">
                <div>
                  <h3 class="text-sm font-semibold text-slate-900 dark:text-white" x-text="isVi ? section.labelVi : section.labelEn"></h3>
                  <p class="text-xs leading-5 text-slate-500 dark:text-white/45" x-text="isVi ? section.descVi : section.descEn"></p>
                </div>
                <span class="shrink-0 text-xs text-slate-400 dark:text-white/35">
                  <span x-text="filteredSectionScenarios(section).length"></span>
                  <span>{isVi ? ' skill' : ' skills'}</span>
                </span>
              </div>

              <div class="grid gap-2 sm:grid-cols-2">
                <template x-for="sc in filteredSectionScenarios(section)" :key="sc.id">
                  <button
                    x-on:click="navigateToScenario(sc.id)"
                    x-bind:class="selectedScenario === sc.id ? 'border-sky-400 bg-sky-50 ring-2 ring-sky-500/15 dark:border-sky-400/70 dark:bg-sky-500/10 dark:ring-sky-400/15' : 'border-slate-200 bg-slate-50/70 hover:border-slate-300 hover:bg-white dark:border-white/10 dark:bg-white/[0.035] dark:hover:border-white/20 dark:hover:bg-white/[0.06]'"
                    x-bind:title="isVi ? sc.descVi : sc.descEn"
                    x-bind:aria-pressed="selectedScenario === sc.id"
                    class="flex items-center gap-2.5 rounded-xl border p-2.5 text-left transition duration-150 focus:outline-none focus-visible:ring-4 focus-visible:ring-sky-500/20"
                    type="button"
                  >
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white ring-1 ring-slate-200 dark:bg-white/5 dark:ring-white/10">
                      <svg class="h-4 w-4" x-bind:class="getColorClass(sc.accentColor, 'iconText')" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" x-html="sc.icon"></svg>
                    </span>
                    <span class="min-w-0 flex-1">
                      <code class="block truncate font-mono text-[13px] font-semibold text-slate-950 dark:text-white" x-text="sc.command"></code>
                      <span class="mt-0.5 block truncate text-xs leading-5 text-slate-500 dark:text-white/50" x-text="isVi ? sc.titleVi : sc.titleEn"></span>
                    </span>
                    <svg
                      x-show="selectedScenario === sc.id"
                      class="h-4 w-4 shrink-0 text-sky-500 dark:text-sky-300"
                      fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                    </svg>
                  </button>
                </template>
              </div>
            </section>
          </template>

          <div
            x-show="visibleSkillCount() === 0"
            class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 dark:border-white/15 dark:text-white/45"
          >
            {isVi ? 'Không tìm thấy skill phù hợp. Thử command, tên skill, hoặc keyword khác.' : 'No matching skills. Try another command, skill name, or keyword.'}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="workflow-selected-scenario"
    tabindex="-1"
    x-show="selectedScenario"
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    class="scroll-mt-24 rounded-2xl border border-slate-200 bg-slate-50 p-4 focus:outline-none dark:border-white/10 dark:bg-white/[0.035]"
  >
    <template x-if="currentScenario">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="min-w-0">
          <div class="mb-2 flex flex-wrap items-center gap-2">
            <span
              x-bind:class="currentScenario.kit === 'engineer' ? 'bg-teal-500/10 text-teal-700 dark:text-teal-300' : 'bg-fuchsia-500/10 text-fuchsia-700 dark:text-fuchsia-300'"
              class="rounded-full px-2.5 py-1 text-xs font-semibold"
              x-text="currentScenario.kit === 'engineer' ? (isVi ? 'Bộ Engineer' : 'Engineer Kit') : (isVi ? 'Bộ Marketing' : 'Marketing Kit')"
            ></span>
            <code class="font-mono text-sm font-semibold text-slate-950 dark:text-white" x-text="currentScenario.command"></code>
            <span class="text-xs text-slate-400 dark:text-white/35" x-text="scenarioCountLabel(currentScenario)"></span>
          </div>
          <h3 class="text-base font-semibold text-slate-950 dark:text-white" x-text="isVi ? currentScenario.titleVi : currentScenario.titleEn"></h3>
          <p class="mt-1 max-w-4xl text-sm leading-6 text-slate-600 dark:text-white/55" x-text="isVi ? currentScenario.descVi : currentScenario.descEn"></p>
        </div>

        <button
          x-show="hasInfographic(selectedScenario)"
          @click="toggleQuickRef()"
          x-bind:class="showQuickRef ? 'border border-slate-200 text-slate-500 hover:bg-slate-100 hover:text-slate-700 dark:border-white/10 dark:text-white/50 dark:hover:bg-white/10 dark:hover:text-white/80' : 'bg-sky-500/10 text-sky-700 hover:bg-sky-500/15 dark:text-sky-300 dark:hover:bg-sky-500/15'"
          class="inline-flex min-h-11 shrink-0 items-center justify-center gap-2 rounded-xl px-4 text-sm font-semibold transition"
          type="button"
          x-bind:title="showQuickRef ? (isVi ? 'Ẩn tóm tắt nhanh' : 'Hide Quick Ref') : (isVi ? 'Xem tóm tắt nhanh' : 'View Quick Ref')"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          <span x-text="showQuickRef ? (isVi ? 'Ẩn tóm tắt' : 'Hide Quick Ref') : (isVi ? 'Mở tóm tắt' : 'Open Quick Ref')"></span>
        </button>
      </div>
    </template>
  </div>
</div>
