const engineerCount = visibleEngineerSkills.length;
const marketerCount = visibleMarketerSkills.length;

const skillPickerSections = {
  engineer: [
    {
      id: 'core-delivery',
      labelEn: 'Core Delivery',
      labelVi: 'Bàn giao chính',
      descEn: 'Plan, build, review, test, ship.',
      descVi: 'Plan, build, review, test, ship.',
      ids: ['brainstorm', 'predict', 'plan', 'cook', 'code-review', 'test', 'fix', 'team', 'preview', 'ship', 'deploy', 'bootstrap'],
    },
    {
      id: 'research-reasoning',
      labelEn: 'Research & Reasoning',
      labelVi: 'Nghiên cứu & suy luận',
      descEn: 'Clarify, compare, scout, and turn ambiguity into direction.',
      descVi: 'Làm rõ, so sánh, scout, và biến mơ hồ thành hướng đi.',
      ids: ['ask', 'research', 'autoresearch', 'loop', 'scenario', 'scout', 'docs-seeker', 'sequential-thinking', 'problem-solving'],
    },
    {
      id: 'frontend-product',
      labelEn: 'Frontend & Product UI',
      labelVi: 'Frontend & UI sản phẩm',
      descEn: 'Design, frontend implementation, web testing, and visual systems.',
      descVi: 'Design, triển khai frontend, web testing, và hệ thống visual.',
      ids: ['frontend-design', 'frontend-development', 'react-best-practices', 'ui-styling', 'ui-ux-pro-max', 'web-design-guidelines', 'web-frameworks', 'web-testing', 'threejs', 'shader', 'remotion', 'show-off', 'stitch'],
    },
