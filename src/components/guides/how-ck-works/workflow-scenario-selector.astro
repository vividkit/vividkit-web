---
// Scenario picker with Engineer Kit / Marketing Kit tab toggle.
// The grouped catalog is collapsed by default and scrolls inside a bounded panel,
// so the main workflow content (Quick Ref + Pipeline) stays close to the fold.
// Uses Alpine.js x-data from parent HowCkWorksGuide component
import { getLangFromUrl, type Language } from '@/i18n';
import { workflowScenarios, hasInfographic, getPhaseCount } from '@/data/guides/how-ck-works';

// Pre-compute phase counts for scenarios with infographics (for badge display)
const phaseCounts: Record<string, number> = {};
workflowScenarios.forEach(sc => {
  const count = getPhaseCount(sc.id);
  if (count) phaseCounts[sc.id] = count;
});

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

// Curated command surface for How ClaudeKit Works.
// ck-init remains hidden: it is a CLI lifecycle command, not a /ck:* skill scenario.
