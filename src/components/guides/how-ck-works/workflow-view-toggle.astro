---
// Toggle between Individual Skills, Workflow Combos, and Infographic views
// Used by HowCkWorksGuide.astro - controlled via Alpine.js viewType state
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';

// TODO: Re-enable after verify + redesign
const SHOW_COMBOS_TAB = false;
---

<div class="flex justify-center mb-6">
  <div class="inline-flex rounded-xl bg-gray-100 dark:bg-white/5 p-1 border border-gray-200 dark:border-white/10">
    <!-- Individual Skills -->
    <button
      @click="viewType = 'individual'; selectedCombo = null"
      :class="viewType === 'individual'
        ? 'bg-white dark:bg-white/10 text-gray-900 dark:text-white shadow-sm border border-gray-200 dark:border-white/20'
        : 'text-gray-600 dark:text-white/60 hover:text-gray-900 dark:hover:text-white border border-transparent'"
      class="px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
      </svg>
      <span class="hidden sm:inline">{isVi ? 'Lệnh Riêng Lẻ' : 'Individual Skills'}</span>
      <span class="sm:hidden">{isVi ? 'Riêng Lẻ' : 'Skills'}</span>
    </button>

    {/* Workflow Combos - temporarily hidden for redesign */}
    {SHOW_COMBOS_TAB && (
      <button
        @click="viewType = 'combos'"
        :class="viewType === 'combos'
          ? 'bg-white dark:bg-white/10 text-gray-900 dark:text-white shadow-sm border border-gray-200 dark:border-white/20'
          : 'text-gray-600 dark:text-white/60 hover:text-gray-900 dark:hover:text-white border border-transparent'"
        class="px-4 py-2 text-sm font-medium rounded-lg transition-all flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="hidden sm:inline">{isVi ? 'Quy Trình Kết Hợp' : 'Workflow Combos'}</span>
        <span class="sm:hidden">{isVi ? 'Combos' : 'Combos'}</span>
      </button>
    )}

  </div>
</div>

{/* Help text - temporarily hidden */}
{SHOW_COMBOS_TAB && (
  <div class="text-center mb-4" x-show="viewType === 'combos'" x-transition>
    <p class="text-xs text-gray-500 dark:text-white/50">
      {isVi
        ? 'Các quy trình phổ biến kết hợp nhiều skills. Chọn một combo để xem chi tiết.'
        : 'Common workflows combining multiple skills. Select a combo to see details.'}
    </p>
  </div>
)}

