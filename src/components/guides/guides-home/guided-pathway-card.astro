---
// Reusable card component for guides home page pathways
import ArrowRight from 'lucide-astro/ArrowRight';
import { useTranslations } from "@/i18n/utils";
import { useTranslatedPath, type Language } from "@/i18n";

interface PathwayLink {
  href: string;
  labelKey: string;
}

interface Props {
  id: string;
  icon: any;
  titleKey: string;
  descKey: string;
  links: PathwayLink[];
  accentColor: 'green' | 'blue' | 'amber' | 'purple' | 'cyan' | 'rose';
  lang: Language;
}

const { id, icon: Icon, titleKey, descKey, links, accentColor, lang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Color mappings for accent colors
const colorClasses = {
  green: {
    bg: 'from-emerald-500/5 to-green-500/5 dark:from-emerald-500/10 dark:to-green-500/10',
    border: 'border-emerald-200 dark:border-emerald-500/30',
    iconBg: 'bg-emerald-100 dark:bg-emerald-500/20',
    iconText: 'text-emerald-600 dark:text-emerald-400',
    titleText: 'text-emerald-700 dark:text-emerald-400',
    linkHover: 'hover:text-emerald-600 dark:hover:text-emerald-400',
  },
  blue: {
    bg: 'from-blue-500/5 to-cyan-500/5 dark:from-blue-500/10 dark:to-cyan-500/10',
    border: 'border-blue-200 dark:border-blue-500/30',
    iconBg: 'bg-blue-100 dark:bg-blue-500/20',
    iconText: 'text-blue-600 dark:text-blue-400',
    titleText: 'text-blue-700 dark:text-blue-400',
    linkHover: 'hover:text-blue-600 dark:hover:text-blue-400',
  },
  amber: {
    bg: 'from-amber-500/5 to-orange-500/5 dark:from-amber-500/10 dark:to-orange-500/10',
    border: 'border-amber-200 dark:border-amber-500/30',
    iconBg: 'bg-amber-100 dark:bg-amber-500/20',
    iconText: 'text-amber-600 dark:text-amber-400',
    titleText: 'text-amber-700 dark:text-amber-400',
    linkHover: 'hover:text-amber-600 dark:hover:text-amber-400',
  },
  purple: {
    bg: 'from-purple-500/5 to-fuchsia-500/5 dark:from-purple-500/10 dark:to-fuchsia-500/10',
    border: 'border-purple-200 dark:border-purple-500/30',
    iconBg: 'bg-purple-100 dark:bg-purple-500/20',
    iconText: 'text-purple-600 dark:text-purple-400',
    titleText: 'text-purple-700 dark:text-purple-400',
    linkHover: 'hover:text-purple-600 dark:hover:text-purple-400',
  },
  cyan: {
    bg: 'from-cyan-500/5 to-teal-500/5 dark:from-cyan-500/10 dark:to-teal-500/10',
    border: 'border-cyan-200 dark:border-cyan-500/30',
    iconBg: 'bg-cyan-100 dark:bg-cyan-500/20',
    iconText: 'text-cyan-600 dark:text-cyan-400',
    titleText: 'text-cyan-700 dark:text-cyan-400',
    linkHover: 'hover:text-cyan-600 dark:hover:text-cyan-400',
  },
  rose: {
    bg: 'from-rose-500/5 to-red-500/5 dark:from-rose-500/10 dark:to-red-500/10',
    border: 'border-rose-200 dark:border-rose-500/30',
    iconBg: 'bg-rose-100 dark:bg-rose-500/20',
    iconText: 'text-rose-600 dark:text-rose-400',
    titleText: 'text-rose-700 dark:text-rose-400',
    linkHover: 'hover:text-rose-600 dark:hover:text-rose-400',
  },
};

const colors = colorClasses[accentColor];
---

<div
  class={`group rounded-2xl p-6 bg-gradient-to-br ${colors.bg} border ${colors.border} hover:shadow-lg hover:scale-[1.02] transition-all duration-300`}
  data-pathway={id}
>
  <!-- Icon + Title -->
  <div class="flex items-start gap-4 mb-4">
    <div class={`flex-shrink-0 w-12 h-12 rounded-xl ${colors.iconBg} flex items-center justify-center ${colors.iconText}`}>
      <Icon class="w-6 h-6" />
    </div>
    <div class="flex-1 min-w-0">
      <h3 class={`text-lg font-bold ${colors.titleText} mb-1`}>
        {t(titleKey)}
      </h3>
      <p class="text-sm text-slate-600 dark:text-slate-400">
        {t(descKey)}
      </p>
    </div>
  </div>

  <!-- Links -->
  <ul class="space-y-2 pl-16">
    {links.map((link) => (
      <li>
        <a
          href={translatePath(link.href)}
          class={`flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 ${colors.linkHover} transition-colors`}
        >
          <ArrowRight class="w-4 h-4 flex-shrink-0" />
          <span>{t(link.labelKey)}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
