---
// UIUX Guide - ClaudeKit Integration section (magic syntax, steps, real examples, quality checklist)
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- ClaudeKit Integration -->
<div class="relative overflow-hidden glass-card rounded-xl border border-indigo-200 dark:border-indigo-500/40 shadow-lg shadow-indigo-500/10 dark:shadow-indigo-500/20">
    <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 p-8">
      <div class="flex items-start gap-4 mb-6">
        <div class="flex items-center justify-center w-14 h-14 rounded-2xl bg-indigo-100 dark:bg-indigo-500/20 flex-shrink-0 float-animation">
          <svg class="w-8 h-8 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h2 class="text-3xl font-bold font-heading text-indigo-700 dark:text-indigo-400 mb-2">{t('uiux.guide.integration.title')}</h2>
          <p class="text-slate-600 dark:text-slate-300 text-lg">{t('uiux.guide.integration.subtitle')}</p>
        </div>
      </div>

      <!-- The Magic Syntax -->
      <div class="bg-gradient-to-r from-indigo-50/80 to-purple-50/80 dark:from-indigo-500/20 dark:to-purple-500/20 rounded-xl border border-indigo-200 dark:border-indigo-500/30 p-6 mb-6">
        <div class="flex items-center gap-3 mb-4">
          <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <h3 class="text-xl font-bold font-heading text-indigo-700 dark:text-indigo-300">{t('uiux.guide.integration.magic_phrase_label')}</h3>
        </div>
        <div class="bg-white dark:bg-slate-950 rounded-lg p-5 border border-indigo-200 dark:border-indigo-500/20">
          <code class="text-lg text-indigo-700 dark:text-indigo-300 font-mono block mb-2">{t('uiux.guide.integration.magic_phrase_syntax')}</code>
          <p class="text-xs text-slate-500">{t('uiux.guide.integration.syntax_note')}</p>
        </div>
      </div>

      <!-- Step by Step -->
      <div class="space-y-4 mb-6">
        <h3 class="text-lg font-bold font-heading text-purple-700 dark:text-purple-400 flex items-center gap-2">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 11 12 14 22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          {t('uiux.guide.integration.step_title')}
        </h3>

        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-indigo-100 dark:bg-indigo-500/20 flex items-center justify-center text-sm text-indigo-600 dark:text-indigo-400 font-bold border-2 border-indigo-200 dark:border-indigo-500/40">1</div>
          <div class="flex-1">
            <div class="bg-surface-100 dark:bg-slate-950 rounded-lg p-4 border border-slate-200 dark:border-slate-800">
              <p class="text-sm text-slate-700 dark:text-slate-300 mb-2"><strong>{t('uiux.guide.step.1.title')}</strong></p>
              <code class="px-3 py-2 rounded bg-indigo-100 dark:bg-indigo-500/10 text-indigo-700 dark:text-indigo-300 font-mono text-sm inline-block">{t('uiux.guide.step.1.code')}</code>
            </div>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center text-sm text-purple-600 dark:text-purple-400 font-bold border-2 border-purple-200 dark:border-purple-500/40">2</div>
          <div class="flex-1">
            <div class="bg-surface-100 dark:bg-slate-950 rounded-lg p-4 border border-slate-200 dark:border-slate-800">
              <p class="text-sm text-slate-700 dark:text-slate-300 mb-2"><strong>{t('uiux.guide.step.2.title')}</strong></p>
              <p class="text-xs text-slate-500 dark:text-slate-400">{t('uiux.guide.step.2.desc')}</p>
            </div>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-pink-100 dark:bg-pink-500/20 flex items-center justify-center text-sm text-pink-600 dark:text-pink-400 font-bold border-2 border-pink-200 dark:border-pink-500/40">3</div>
          <div class="flex-1">
            <div class="bg-surface-100 dark:bg-slate-950 rounded-lg p-4 border border-slate-200 dark:border-slate-800">
              <p class="text-sm text-slate-700 dark:text-slate-300 mb-2"><strong>{t('uiux.guide.step.3.title')}</strong></p>
              <p class="text-xs text-slate-500 dark:text-slate-400">{t('uiux.guide.step.3.desc')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Real Examples -->
      <div class="bg-surface-100/50 dark:bg-slate-950/50 rounded-xl border border-indigo-200 dark:border-indigo-500/20 p-6">
          <h3 class="text-lg font-bold font-heading text-indigo-700 dark:text-indigo-300 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
              </svg>
              {t('uiux.guide.real_prompts.title')}
          </h3>

          <div class="space-y-3">
              <div class="p-4 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-indigo-500/30 transition-colors cursor-pointer">
                  <div class="flex items-start gap-2 mb-2">
                  <span class="px-2 py-0.5 text-xs rounded-full bg-emerald-100 dark:bg-emerald-500/20 text-emerald-700 dark:text-emerald-400 font-medium">{t('uiux.guide.label.beginner')}</span>
                  <span class="text-xs text-slate-500">{t('uiux.guide.label.landing')}</span>
                  </div>
                  <div class="bg-indigo-50 dark:bg-indigo-500/5 rounded p-3 border border-indigo-100 dark:border-indigo-500/10">
                  <code class="text-sm text-indigo-700 dark:text-indigo-300 font-mono block leading-relaxed">
                      {t('uiux.guide.prompt.beginner')}
                  </code>
                  </div>
                  <div class="mt-2 flex items-start gap-2 text-xs text-slate-500">
                  <svg class="w-4 h-4 text-indigo-500 dark:text-indigo-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 11 12 14 22 4"/>
                  </svg>
                  <span>{t('uiux.guide.outcome.beginner')}</span>
                  </div>
              </div>

              <div class="p-4 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-purple-500/30 transition-colors cursor-pointer">
                  <div class="flex items-start gap-2 mb-2">
                  <span class="px-2 py-0.5 text-xs rounded-full bg-amber-100 dark:bg-amber-500/20 text-amber-700 dark:text-amber-400 font-medium">{t('uiux.guide.label.intermediate')}</span>
                  <span class="text-xs text-slate-500">{t('uiux.guide.label.dashboard')}</span>
                  </div>
                  <div class="bg-purple-50 dark:bg-purple-500/5 rounded p-3 border border-purple-100 dark:border-purple-500/10">
                      <code class="text-sm text-purple-700 dark:text-purple-300 font-mono block leading-relaxed">
                          {t('uiux.guide.prompt.intermediate')}
                      </code>
                  </div>
                  <div class="mt-2 flex items-start gap-2 text-xs text-slate-500">
                  <svg class="w-4 h-4 text-purple-600 dark:text-purple-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 11 12 14 22 4"/>
                  </svg>
                  <span>{t('uiux.guide.outcome.intermediate')}</span>
                  </div>
              </div>

              <div class="p-4 rounded-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-pink-500/30 transition-colors cursor-pointer">
                  <div class="flex items-start gap-2 mb-2">
                  <span class="px-2 py-0.5 text-xs rounded-full bg-rose-100 dark:bg-red-500/20 text-rose-700 dark:text-red-400 font-medium">{t('uiux.guide.label.advanced')}</span>
                  <span class="text-xs text-slate-500">{t('uiux.guide.label.ecommerce')}</span>
                  </div>
                  <div class="bg-pink-50 dark:bg-pink-500/5 rounded p-3 border border-pink-200 dark:border-pink-500/10">
                  <code class="text-sm text-pink-700 dark:text-pink-300 font-mono block leading-relaxed">
                      {t('uiux.guide.prompt.advanced')}
                  </code>
                  </div>
                  <div class="mt-2 flex items-start gap-2 text-xs text-slate-500">
                  <svg class="w-4 h-4 text-pink-600 dark:text-pink-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 11 12 14 22 4"/>
                  </svg>
                  <span>{t('uiux.guide.outcome.advanced')}</span>
                  </div>
              </div>
          </div>

          <!-- Pro Tips -->
          <div class="mt-6 p-5 rounded-lg bg-gradient-to-r from-cyan-50/50 to-blue-50/50 dark:from-cyan-500/10 dark:to-blue-500/10 border border-cyan-200 dark:border-cyan-500/20">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-cyan-600 dark:text-cyan-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
              <div class="flex-1">
                <h4 class="text-sm font-bold text-cyan-700 dark:text-cyan-400 mb-2">{t('uiux.guide.pro_tips.title')}</h4>
                <ul class="space-y-1 text-xs text-slate-600 dark:text-slate-400">
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-500 dark:text-cyan-400 mt-0.5">•</span>
                    <span>{t('uiux.guide.pro_tips.1')}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-500 dark:text-cyan-400 mt-0.5">•</span>
                    <span>{t('uiux.guide.pro_tips.2')}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-500 dark:text-cyan-400 mt-0.5">•</span>
                    <span>{t('uiux.guide.pro_tips.3')}</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
      </div>

      <!-- Example Prompts -->
      <div class="bg-surface-100/50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden mb-6 mt-6">
        <div class="p-6 bg-gradient-to-r from-violet-50/50 to-purple-50/50 dark:from-violet-500/10 dark:to-purple-500/10 border-b border-slate-200 dark:border-slate-800">
          <h2 class="text-2xl font-bold font-heading text-violet-700 dark:text-violet-400 flex items-center gap-3">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2-2z"/>
              <path d="M13 8H7"/>
              <path d="M17 12H7"/>
            </svg>
            {t('uiux.guide.examples.title')}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-500 mt-2">{t('uiux.guide.examples.subtitle')}</p>
        </div>
        <div class="p-6 space-y-3">
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-violet-500/30 transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-violet-100 dark:bg-violet-500/20 flex items-center justify-center text-xs text-violet-700 dark:text-violet-400 font-bold">1</div>
              <div class="flex-1">
                <code class="text-sm text-violet-600 dark:text-violet-400 font-mono">{t('uiux.guide.example.1.code')}</code>
                <p class="text-xs text-slate-500 mt-2">{t('uiux.guide.example.1.desc')}</p>
              </div>
            </div>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-purple-500/30 transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-purple-100 dark:bg-purple-500/20 flex items-center justify-center text-xs text-purple-700 dark:text-purple-400 font-bold">2</div>
              <div class="flex-1">
                <code class="text-sm text-purple-600 dark:text-purple-400 font-mono">{t('uiux.guide.example.2.code')}</code>
                <p class="text-xs text-slate-500 mt-2">{t('uiux.guide.example.2.desc')}</p>
              </div>
            </div>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-fuchsia-500/30 transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-fuchsia-100 dark:bg-fuchsia-500/20 flex items-center justify-center text-xs text-fuchsia-700 dark:text-fuchsia-400 font-bold">3</div>
              <div class="flex-1">
                <code class="text-sm text-fuchsia-600 dark:text-fuchsia-400 font-mono">{t('uiux.guide.example.3.code')}</code>
                <p class="text-xs text-slate-500 mt-2">{t('uiux.guide.example.3.desc')}</p>
              </div>
            </div>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 hover:border-pink-500/30 transition-colors cursor-pointer">
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 rounded-full bg-pink-100 dark:bg-pink-500/20 flex items-center justify-center text-xs text-pink-700 dark:text-pink-400 font-bold">4</div>
              <div class="flex-1">
                <code class="text-sm text-pink-600 dark:text-pink-400 font-mono">{t('uiux.guide.example.4.code')}</code>
                <p class="text-xs text-slate-500 mt-2">{t('uiux.guide.example.4.desc')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quality Checklist -->
      <div class="bg-surface-100/50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="p-6 bg-gradient-to-r from-green-50/50 to-emerald-50/50 dark:from-green-500/10 dark:to-emerald-500/10 border-b border-slate-200 dark:border-slate-800">
          <h2 class="text-2xl font-bold font-heading text-green-700 dark:text-green-400 flex items-center gap-3">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            {t('uiux.guide.quality.title')}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-500 mt-2">{t('uiux.guide.quality.subtitle')}</p>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.visual.title')}</h3>
            </div>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
              <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.1')}</span></li>
              <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.2')}</span></li>
              <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.3')}</span></li>
              <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.4')}</span></li>
            </ul>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.interaction.title')}</h3>
            </div>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
              <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.1')}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.2')}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.3')}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.4')}</span></li>
            </ul>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.accessibility.title')}</h3>
            </div>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
              <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.1')}</span></li>
              <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.2')}</span></li>
              <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.3')}</span></li>
              <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.4')}</span></li>
            </ul>
          </div>
          <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <div class="flex items-center gap-2 mb-3">
              <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
              <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.responsive.title')}</h3>
            </div>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
              <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.1')}</span></li>
              <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.2')}</span></li>
              <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.3')}</span></li>
              <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.4')}</span></li>
            </ul>
          </div>
        </div>
      </div>

    </div>
</div>
