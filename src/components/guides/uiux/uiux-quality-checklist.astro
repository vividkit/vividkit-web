---
// UIUX Quality Checklist - What AI validates before delivery
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- Quality Checklist -->
<div class="bg-surface-100/50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
  <div class="p-6 bg-gradient-to-r from-green-50/50 to-emerald-50/50 dark:from-green-500/10 dark:to-emerald-500/10 border-b border-slate-200 dark:border-slate-800">
    <h2 class="text-2xl font-bold font-heading text-green-700 dark:text-green-400 flex items-center gap-3">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      {t('uiux.guide.quality.title')}
    </h2>
    <p class="text-sm text-slate-600 dark:text-slate-500 mt-2">{t('uiux.guide.quality.subtitle')}</p>
  </div>
  <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.visual.title')}</h3>
      </div>
      <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
        <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.1')}</span></li>
        <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.2')}</span></li>
        <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.3')}</span></li>
        <li class="flex items-start gap-2"><span class="text-green-500 dark:text-green-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.visual.4')}</span></li>
      </ul>
    </div>
    <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.interaction.title')}</h3>
      </div>
      <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
        <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.1')}</span></li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.2')}</span></li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.3')}</span></li>
        <li class="flex items-start gap-2"><span class="text-emerald-500 dark:text-emerald-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.interaction.4')}</span></li>
      </ul>
    </div>
    <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.accessibility.title')}</h3>
      </div>
      <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
        <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.1')}</span></li>
        <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.2')}</span></li>
        <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.3')}</span></li>
        <li class="flex items-start gap-2"><span class="text-teal-500 dark:text-teal-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.accessibility.4')}</span></li>
      </ul>
    </div>
    <div class="p-4 rounded-lg bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-cyan-600 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <h3 class="text-sm font-bold font-heading text-slate-700 dark:text-slate-300">{t('uiux.guide.quality.responsive.title')}</h3>
      </div>
      <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-500">
        <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.1')}</span></li>
        <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.2')}</span></li>
        <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.3')}</span></li>
        <li class="flex items-start gap-2"><span class="text-cyan-500 dark:text-cyan-400 mt-0.5">✓</span><span>{t('uiux.guide.quality.responsive.4')}</span></li>
      </ul>
    </div>
  </div>
</div>
