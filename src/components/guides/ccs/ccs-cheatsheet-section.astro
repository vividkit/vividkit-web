---
// CCSGuide cheatsheet — compact table-row layout per category
// Lighter than cli-commands article cards: each command is a single hairline-divided row.
import { getLangFromUrl, type Language } from "@/i18n";
import { useTranslations } from "@/i18n/utils";
import {
  CCS_CHEATSHEET_CATEGORIES,
  COLOR_STYLES,
  CCS_SYNCED_VERSION,
  CCS_SYNCED_DATE,
} from "@/data/guides/ccs-cheatsheet-data";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
// Cast: cheatsheet keys are dynamic from data file; runtime resolves them safely.
const t = useTranslations(currentLang) as (k: string) => string;
const isVi = currentLang === "vi";
const commandsLabel = isVi ? "lệnh" : "commands";
---

<!-- Cheatsheet Section -->
<div id="cheatsheet" class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden scroll-mt-24">
  <div class="p-6 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border-b border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-3 mb-2">
      <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center font-bold text-blue-600 dark:text-blue-400 border-2 border-blue-500/50">
        1
      </div>
      <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">
        {t("ccs.cheatsheet.title")}
      </h3>
      <span
        class="ml-auto inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-[11px] font-mono font-medium text-emerald-700 dark:text-emerald-400"
        title={`${t("ccs.cheatsheet.version_label")} ${CCS_SYNCED_DATE}`}
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 7.5l-9 5.25L3 7.5"/><path d="M21 7.5v9l-9 5.25-9-5.25v-9"/><path d="M12 12.75v9"/>
        </svg>
        @kaitranntt/ccs@{CCS_SYNCED_VERSION}
      </span>
    </div>
    <p class="text-sm text-slate-600 dark:text-slate-400 ml-[52px]">
      {t("ccs.cheatsheet.subtitle")}
    </p>
    <p class="text-[11px] text-slate-500 dark:text-slate-500 ml-[52px] mt-1">
      {t("ccs.cheatsheet.version_label")} <span class="font-mono">{CCS_SYNCED_DATE}</span>
    </p>
  </div>

  <!-- Category quick-nav chips -->
  <div class="px-4 sm:px-6 pt-4 flex flex-wrap gap-1.5">
    {CCS_CHEATSHEET_CATEGORIES.map((cat, idx) => {
      const styles = COLOR_STYLES[cat.color];
      return (
        <a
          href={`#ccs-cat-${cat.id}`}
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-[11px] font-medium transition hover:scale-[1.02]",
            styles.chip,
            styles.ring,
          ]}
        >
          <span class="font-mono opacity-60">{String(idx + 1).padStart(2, "0")}</span>
          <span>{t(cat.titleKey)}</span>
          <span class="font-mono opacity-60">·{cat.commands.length}</span>
        </a>
      );
    })}
  </div>

  <div class="p-4 sm:p-6 space-y-4">
    {CCS_CHEATSHEET_CATEGORIES.map((cat, categoryIndex) => {
      const styles = COLOR_STYLES[cat.color];
      return (
        <section id={`ccs-cat-${cat.id}`} class:list={["scroll-mt-32 overflow-hidden rounded-2xl border bg-gradient-to-br shadow-sm", styles.panel, styles.ring]}>
          <!-- Category header strip -->
          <header class="relative flex items-center gap-3 border-b border-slate-200/60 px-4 py-3 dark:border-white/10">
            <div class:list={["absolute left-0 top-0 h-full w-1", styles.accent]}></div>
            <div class:list={["inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border bg-white/75 shadow-sm dark:bg-white/[0.04]", styles.ring]}>
              <svg class:list={["h-4 w-4", styles.text]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={cat.icon} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-500">
                  {String(categoryIndex + 1).padStart(2, "0")}
                </span>
                <h4 class="text-sm font-bold tracking-tight text-slate-950 dark:text-white">
                  {t(cat.titleKey)}
                </h4>
                <span class="ml-auto text-[11px] font-mono text-slate-500 dark:text-slate-400">
                  {cat.commands.length} {commandsLabel}
                </span>
              </div>
              <p class="mt-0.5 text-xs leading-5 text-slate-600 dark:text-slate-400 line-clamp-1">
                {t(cat.descKey)}
              </p>
            </div>
          </header>

          <!-- Compact command rows -->
          <ul class="divide-y divide-slate-200/50 dark:divide-white/[0.06]">
            {cat.commands.map((cmd) => (
              <li class="group flex items-center gap-3 px-4 py-2 transition hover:bg-white/70 dark:hover:bg-slate-900/40">
                <code class:list={["shrink-0 rounded-md px-2 py-0.5 font-mono text-[11.5px] font-semibold whitespace-nowrap", styles.chip]}>
                  {cmd.cmd}
                </code>
                <span class="min-w-0 flex-1 truncate text-xs text-slate-600 dark:text-slate-400" title={t(cmd.descKey)}>
                  {t(cmd.descKey)}
                </span>
                <button
                  class="copy-btn flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-transparent text-slate-400 opacity-0 transition hover:border-teal-300 hover:bg-teal-50 hover:text-teal-700 group-hover:opacity-100 dark:hover:border-teal-400/30 dark:hover:bg-white/[0.06] dark:hover:text-teal-200"
                  data-code={cmd.cmd}
                  title="Copy"
                  aria-label={`Copy ${cmd.cmd}`}
                >
                  <svg class="copy-icon h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                  <svg class="check-icon hidden h-3.5 w-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
  </div>

  <div class="px-6 pb-6">
    <div class="p-4 rounded-lg bg-slate-100/70 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700">
      <p class="text-xs text-slate-600 dark:text-slate-400 flex items-start gap-2">
        <svg class="w-4 h-4 shrink-0 mt-0.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path d="M12 16v-4M12 8h.01" />
        </svg>
        <span set:html={t("ccs.cheatsheet.hint")} />
      </p>
    </div>
  </div>
</div>
