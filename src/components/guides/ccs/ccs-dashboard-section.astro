---
// CCSGuide web dashboard, troubleshooting, config reference, and resources
import { getLangFromUrl, useTranslatedPath, type Language } from "@/i18n";
import { useTranslations } from "@/i18n/utils";
import PlatformPathSwitcher from "../PlatformPathSwitcher.astro";
interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

  <!-- Web Dashboard Section -->
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center font-bold text-blue-600 dark:text-blue-400 border-2 border-blue-500/50">
          6
        </div>
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">
          {t('ccs.guide.dashboard_title')}
        </h3>
        <span class="px-2 py-0.5 text-xs rounded-full bg-blue-500/20 text-blue-600 dark:text-blue-400 font-medium">{t('ccs.guide.new_badge')}</span>
      </div>
    </div>
    <div class="p-6 space-y-6">
      <p class="text-slate-700 dark:text-slate-300">
        {t('ccs.guide.dashboard_desc')}
      </p>

      <!-- Dashboard Features Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <path d="M3 9h18M9 21V9"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature1')}</span>
        </div>
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M23 4v6h-6M1 20v-6h6"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature2')}</span>
        </div>
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature3')}</span>
        </div>
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature4')}</span>
        </div>
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature5')}</span>
        </div>
        <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20 text-center">
          <svg class="w-5 h-5 mx-auto mb-2 text-slate-600 dark:text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
            <line x1="12" y1="18" x2="12.01" y2="18"/>
          </svg>
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">{t('ccs.guide.dashboard_feature6')}</span>
        </div>
      </div>

      <!-- Launch Command -->
      <div>
        <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"/>
            <line x1="12" y1="19" x2="20" y2="19"/>
          </svg>
          {t('ccs.guide.dashboard_launch_title')}
        </h4>
        <div class="bg-white dark:bg-[#0D0D0D] rounded-lg p-4 border border-slate-200 dark:border-slate-700 font-mono text-sm space-y-3">
          <div class="flex items-center gap-4">
            <code class="text-slate-700 dark:text-slate-300">ccs config</code>
            <span class="text-slate-500 text-xs"># {t('ccs.guide.dashboard_launch_default')}</span>
          </div>
          <div class="flex items-center gap-4">
            <code class="text-slate-700 dark:text-slate-300">ccs config --port 3000</code>
            <span class="text-slate-500 text-xs"># {t('ccs.guide.dashboard_launch_custom')}</span>
          </div>
        </div>
      </div>

      <!-- Access Info -->
      <div class="p-4 rounded-lg bg-blue-500/10 border border-blue-500/20">
        <p class="text-sm text-slate-700 dark:text-slate-300 flex items-start gap-2">
          <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4M12 8h.01"/>
          </svg>
          <span>{t('ccs.guide.dashboard_access_note')}</span>
        </p>
      </div>

      <!-- Dashboard Screenshot (Theme-aware) -->
      <div>
        <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-3 flex items-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
          {t('ccs.guide.dashboard_preview_title')}
        </h4>
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
          <!-- Light Mode Screenshot (visible in light mode) -->
          <div class="block dark:hidden">
            <div class="p-2 bg-slate-100 border-b border-slate-200 flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3" stroke="currentColor" stroke-width="2"/>
                <line x1="12" y1="21" x2="12" y2="23" stroke="currentColor" stroke-width="2"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" stroke="currentColor" stroke-width="2"/>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" stroke="currentColor" stroke-width="2"/>
                <line x1="1" y1="12" x2="3" y2="12" stroke="currentColor" stroke-width="2"/>
                <line x1="21" y1="12" x2="23" y2="12" stroke="currentColor" stroke-width="2"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" stroke="currentColor" stroke-width="2"/>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" stroke="currentColor" stroke-width="2"/>
              </svg>
              <span class="text-xs font-medium text-slate-600">{t('ccs.guide.dashboard_light_mode')}</span>
            </div>
            <img
              src="/guides/ccs_dashboard_light.png"
              alt="CCS Dashboard - Light Mode"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
          <!-- Dark Mode Screenshot (visible in dark mode) -->
          <div class="hidden dark:block">
            <div class="p-2 bg-slate-800 border-b border-slate-700 flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
              <span class="text-xs font-medium text-slate-300">{t('ccs.guide.dashboard_dark_mode')}</span>
            </div>
            <img
              src="/guides/ccs_dashboard_dark.png"
              alt="CCS Dashboard - Dark Mode"
              class="w-full h-auto"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Account Management Note -->
      <div class="p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/50 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-colors">
        <h5 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">{t('ccs.guide.dashboard_manage_title')}</h5>
        <p class="text-xs text-slate-600 dark:text-slate-400 mb-2">
          {t('ccs.guide.dashboard_manage_desc')}
        </p>
        <PlatformPathSwitcher
          lang={currentLang}
          pathAfterHome=".ccs/cliproxy/accounts.json"
          label="File:"
          id="ccs-accounts-path"
          color="slate"
        />
      </div>
    </div>
  </div>

  <!-- Troubleshooting Section -->
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border-b border-slate-200 dark:border-slate-800">
      <h3 class="text-xl font-bold text-slate-700 dark:text-slate-300 flex items-center gap-3">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
        </svg>
        {t('ccs.guide.troubleshooting_title')}
      </h3>
    </div>
    <div class="p-6 space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Issue 1 -->
        <div class="p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/50 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-colors">
          <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">{t('ccs.guide.issue1_title')}</h4>
          <div class="bg-white dark:bg-[#0D0D0D] rounded p-2 border border-slate-200 dark:border-slate-700 font-mono text-xs">
            <code>ccs gemini --auth --headless</code>
          </div>
        </div>
        <!-- Issue 2 -->
        <div class="p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/50 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-colors">
          <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">{t('ccs.guide.issue2_title')}</h4>
          <div class="bg-white dark:bg-[#0D0D0D] rounded p-2 border border-slate-200 dark:border-slate-700 font-mono text-xs space-y-1">
            <div><code>ccs doctor</code></div>
            <div class="text-slate-500"># {t('ccs.guide.issue2_kill')}</div>
            <div><code>lsof -ti:8317 | xargs kill</code></div>
          </div>
        </div>
        <!-- Issue 3 -->
        <div class="p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/50 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-colors">
          <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">{t('ccs.guide.issue3_title')}</h4>
          <div class="bg-white dark:bg-[#0D0D0D] rounded p-2 border border-slate-200 dark:border-slate-700 font-mono text-xs">
            <code>ccs glm:continue "next task"</code>
          </div>
        </div>
        <!-- Health Check -->
        <div class="p-4 rounded-lg bg-white/50 dark:bg-slate-900/50 border border-slate-200/80 dark:border-slate-700/50 hover:border-blue-500/30 dark:hover:border-blue-500/30 transition-colors">
          <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">{t('ccs.guide.health_check_title')}</h4>
          <div class="bg-white dark:bg-[#0D0D0D] rounded p-2 border border-slate-200 dark:border-slate-700 font-mono text-xs">
            <code>ccs doctor</code>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- .ck.json Configuration Section Cross-link -->
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden">
    <div class="p-6 text-center">
      <div class="w-12 h-12 rounded-full bg-violet-500/20 flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200 mb-2">
        {t('ccs.guide.ck_json_title')}
      </h3>
      <p class="text-slate-600 dark:text-slate-400 mb-5 max-w-lg mx-auto" set:html={t('ccs.guide.ck_json_desc')}></p>
      
      <a href={translatePath('/guides/ide-config')} class="inline-flex items-center gap-2 px-5 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-lg font-medium transition-colors shadow-sm">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
        {t('ccs.guide.view_ck_json_guide')}
      </a>
    </div>
  </div>

  <!-- Resources Section -->
  <div class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden relative">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 via-transparent to-cyan-500/5 opacity-50 dark:opacity-20 pointer-events-none"></div>

    <div class="p-6 md:p-8 relative">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-lg bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center border border-blue-200 dark:border-blue-800 shadow-sm">
          <svg class="w-5 h-5 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">
          {t('ccs.guide.resources_title')}
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Documentation -->
        <a href="https://ccs.kaitran.ca/" target="_blank" rel="noopener noreferrer"
           class="flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 hover:border-blue-400 dark:hover:border-blue-500 hover:shadow-md transition-all group">
          <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/40 transition-colors shadow-sm">
            <svg class="w-6 h-6 text-slate-500 dark:text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{t('ccs.guide.documentation')}</h4>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed text-balance">{t('ccs.guide.resources_docs_desc')}</p>
          </div>
        </a>

        <!-- GitHub -->
        <a href="https://github.com/kaitranntt/ccs" target="_blank" rel="noopener noreferrer"
           class="flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 hover:border-slate-400 dark:hover:border-slate-500 hover:shadow-md transition-all group">
          <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 group-hover:bg-slate-200 dark:group-hover:bg-slate-700 transition-colors shadow-sm">
            <svg class="w-6 h-6 text-slate-500 dark:text-slate-400 group-hover:text-slate-900 dark:group-hover:text-white" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-1 group-hover:text-slate-900 dark:group-hover:text-white transition-colors">GitHub Repository</h4>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed text-balance">{t('ccs.guide.resources_github_desc')}</p>
          </div>
        </a>

        <!-- Report Issues -->
        <a href="https://github.com/kaitranntt/ccs/issues" target="_blank" rel="noopener noreferrer"
           class="flex items-start gap-4 p-5 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 hover:border-rose-400 dark:hover:border-rose-500 hover:shadow-md transition-all group">
          <div class="p-2.5 rounded-lg bg-slate-50 dark:bg-slate-900 group-hover:bg-rose-50 dark:group-hover:bg-rose-900/40 transition-colors shadow-sm">
            <svg class="w-6 h-6 text-slate-500 dark:text-slate-400 group-hover:text-rose-500 dark:group-hover:text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-1 group-hover:text-rose-500 dark:group-hover:text-rose-400 transition-colors">{t('ccs.guide.report_issues')}</h4>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed text-balance">{t('ccs.guide.resources_issues_desc')}</p>
          </div>
        </a>

      </div>
    </div>
  </div>


</div>
