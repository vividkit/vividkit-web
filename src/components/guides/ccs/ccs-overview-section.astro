---
// CCSGuide — unified Introduction: multi-subscription reality + CCS as solution
import { getLangFromUrl, type Language } from "@/i18n";
import { useTranslations } from "@/i18n/utils";
import LLMProviderIcon from "@/components/ui/LLMProviderIcon.astro";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

type ProviderKey = "claude" | "openai" | "zai" | "kimi" | "minimax" | "qwen";
const subscriptionExamples: { provider: ProviderKey; label: string }[] = [
  { provider: "claude", label: "Claude Pro" },
  { provider: "openai", label: "ChatGPT Plus / Codex" },
  { provider: "zai", label: "Z.AI / GLM" },
  { provider: "kimi", label: "Kimi" },
  { provider: "minimax", label: "MiniMax" },
  { provider: "qwen", label: "Alibaba Coding Plan" },
];

// Without CCS — pain chips (parallel to with_chips below)
const painChips = [
  {
    titleKey: "ccs.guide.intro_pain_ratelimit_title",
    descKey: "ccs.guide.intro_pain_ratelimit_desc",
    // AlertTriangle
    icon: '<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  },
  {
    titleKey: "ccs.guide.intro_pain_switching_title",
    descKey: "ccs.guide.intro_pain_switching_desc",
    // FileEdit (rewrite)
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M10.42 12.61a2.1 2.1 0 1 1 2.97 2.97L7.95 21 4 22l.99-3.95 5.43-5.44z"/>',
  },
  {
    titleKey: "ccs.guide.intro_pain_cliproxy_title",
    descKey: "ccs.guide.intro_pain_cliproxy_desc",
    // Layers (separate setups)
    icon: '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  },
] as const;

// With CCS — solution chips (parallel mapping to painChips)
const withChips = [
  {
    titleKey: "ccs.guide.intro_with_profile_title",
    descKey: "ccs.guide.intro_with_profile_desc",
    // Zap (one-command switching)
    icon: '<polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  },
  {
    titleKey: "ccs.guide.intro_with_resume_title",
    descKey: "ccs.guide.intro_with_resume_desc",
    // RefreshCw (resume across providers)
    icon: '<path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
  },
  {
    titleKey: "ccs.guide.intro_with_managed_title",
    descKey: "ccs.guide.intro_with_managed_desc",
    // ShieldCheck (auth managed)
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
  },
] as const;
---

<!-- Hero Section -->
<div class="text-center space-y-4">
  <h2 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
    {t("ccs.guide.title")}
  </h2>
  <p class="text-xl font-medium text-amber-600 dark:text-amber-400">
    {t("ccs.guide.tagline")}
  </p>
  <p
    class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed"
  >
    {t("ccs.guide.description")}
  </p>
</div>

<!-- Unified Introduction Section -->
<div
  class="glass-card rounded-xl border-slate-200 dark:border-slate-700 overflow-hidden"
>
  <!-- Header -->
  <div
    class="p-6 bg-gradient-to-r from-violet-500/10 via-blue-500/10 to-emerald-500/10 border-b border-slate-200 dark:border-slate-800"
  >
    <div class="flex items-center gap-3">
      <div
        class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center"
      >
        <svg
          class="w-6 h-6 text-violet-600 dark:text-violet-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4M12 8h.01"></path>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-slate-800 dark:text-slate-200">
        {t("ccs.guide.intro_title")}
      </h3>
    </div>
  </div>

  <div class="p-6 space-y-6">
    <!-- The Scenario -->
    <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
      {t("ccs.guide.intro_scenario")}
    </p>

    <!-- Subscription badges -->
    <div class="flex flex-wrap gap-2">
      {
        subscriptionExamples.map((s) => (
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/60 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 text-sm font-medium text-slate-700 dark:text-slate-300">
            <LLMProviderIcon provider={s.provider} size={18} class="shrink-0" />
            {s.label}
          </span>
        ))
      }
    </div>

    <!-- Without/With CCS: parallel comparison grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Without CCS column -->
      <div class="rounded-lg border border-amber-500/30 bg-amber-500/5 dark:bg-amber-500/10 overflow-hidden">
        <div class="px-4 py-2.5 bg-amber-500/10 dark:bg-amber-500/15 border-b border-amber-500/20 flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-700 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          <span class="text-sm font-bold text-amber-700 dark:text-amber-400">{t("ccs.guide.intro_without_ccs")}</span>
        </div>
        <div class="p-4 space-y-3">
          {painChips.map((c) => (
            <div class="flex gap-3 items-start">
              <div class="shrink-0 w-8 h-8 rounded-lg bg-amber-500/15 flex items-center justify-center">
                <svg class="w-4 h-4 text-amber-700 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold text-slate-800 dark:text-slate-200 leading-snug">
                  {t(c.titleKey)}
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-0.5">
                  {t(c.descKey)}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- With CCS column -->
      <div class="rounded-lg border border-emerald-500/30 bg-emerald-500/5 dark:bg-emerald-500/10 overflow-hidden">
        <div class="px-4 py-2.5 bg-emerald-500/10 dark:bg-emerald-500/15 border-b border-emerald-500/20 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span class="text-sm font-bold text-emerald-700 dark:text-emerald-400">{t("ccs.guide.intro_with_ccs")}</span>
        </div>
        <div class="p-4 space-y-3">
          {withChips.map((c) => (
            <div class="flex gap-3 items-start">
              <div class="shrink-0 w-8 h-8 rounded-lg bg-emerald-500/15 flex items-center justify-center">
                <svg class="w-4 h-4 text-emerald-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold text-slate-800 dark:text-slate-200 leading-snug">
                  {t(c.titleKey)}
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-0.5" set:html={t(c.descKey)} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Quick install tease (loops Why CCS into action) -->
    <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white/60 dark:bg-slate-800/40 p-4 space-y-2.5">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <span class="text-sm font-bold text-slate-800 dark:text-slate-200">{t("ccs.guide.intro_install_label")}</span>
      </div>
      <div class="relative group">
        <pre class="bg-slate-100 dark:bg-slate-800/90 rounded-md px-3 py-2 pr-10 text-xs font-mono text-slate-700 dark:text-slate-200 overflow-x-auto"><code>npm install -g @kaitranntt/ccs <span class="text-slate-500 dark:text-slate-400">&amp;&amp;</span> ccs config</code></pre>
        <button
          type="button"
          class="copy-btn absolute top-1.5 right-1.5 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
          data-code="npm install -g @kaitranntt/ccs && ccs config"
          title="Copy"
        >
          <svg class="w-3 h-3 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
          <svg class="w-3 h-3 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
      </div>
      <p class="text-xs text-slate-500 dark:text-slate-400" set:html={t("ccs.guide.intro_install_hint")}></p>
      <div class="flex flex-wrap gap-2 pt-1">
        <a href="#cheatsheet" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-blue-500/10 hover:bg-blue-500/20 border border-blue-500/30 text-xs font-medium text-blue-700 dark:text-blue-400 transition-colors">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
          </svg>
          {t("ccs.guide.intro_nav_cheatsheet")}
        </a>
        <a href="#decision-tree" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-xs font-medium text-emerald-700 dark:text-emerald-400 transition-colors">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="5" r="2"/><circle cx="6" cy="19" r="2"/><circle cx="18" cy="19" r="2"/><path d="M12 7v4M6 17v-2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/>
          </svg>
          {t("ccs.guide.intro_nav_decision_tree")}
        </a>
        <a href="#workflows" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-xs font-medium text-purple-700 dark:text-purple-400 transition-colors">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
          {t("ccs.guide.intro_nav_workflows")}
        </a>
      </div>
    </div>

    <!-- Session Recovery cross-link -->
    <div class="p-3 rounded-lg bg-blue-500/10 border border-blue-500/20">
      <p class="text-sm text-slate-700 dark:text-slate-300 flex items-start gap-2">
        <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4M12 8h.01"></path>
        </svg>
        <span set:html={t("ccs.guide.intro_session_recovery_link")} />
      </p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          if (copyIcon && checkIcon) {
            copyIcon.classList.add('hidden');
            checkIcon.classList.remove('hidden');
          }
          setTimeout(() => {
            if (copyIcon && checkIcon) {
              copyIcon.classList.remove('hidden');
              checkIcon.classList.add('hidden');
            }
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  });
</script>
