---
// MobileCodingGuide — Hub page for mobile coding options
import { getLangFromUrl, useTranslatedPath, type Language } from "@/i18n";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const isVi = currentLang === "vi";
const t = (en: string, vi: string) => (isVi ? vi : en);
---

<div class="space-y-8 mt-6">
  <!-- Hero -->
  <div class="text-center space-y-4">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 text-sm font-medium mb-2"
    >
      <svg
        class="w-4 h-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
        <line x1="12" y1="18" x2="12.01" y2="18"></line>
      </svg>
      {t("Mobile Coding", "Code từ Di động")}
    </div>
    <h2
      class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight"
    >
      {t("Code from Any Device", "Code từ Bất kỳ Thiết bị nào")}
    </h2>
    <p class="text-xl font-medium text-purple-600 dark:text-purple-400">
      {
        t(
          "Keep working from your phone, tablet, or any browser.",
          "Tiếp tục làm việc từ điện thoại, tablet, hoặc bất kỳ trình duyệt nào.",
        )
      }
    </p>
    <p
      class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed"
    >
      {
        t(
          "Two powerful approaches for mobile-first coding with Claude Code. Pick the one that fits your setup.",
          "Hai phương pháp mạnh mẽ để code từ di động với Claude Code. Chọn cái phù hợp với setup của bạn.",
        )
      }
    </p>
  </div>

  <!-- Options cards -->
  <div class="grid md:grid-cols-2 gap-6">
    <!-- Happy-CCS -->
    <a
      href={translatePath("/guides/happy-ccs")}
      class="group glass-card rounded-2xl overflow-hidden border-2 border-transparent hover:border-purple-300 dark:hover:border-purple-500/50 transition-all duration-200 hover:shadow-lg hover:shadow-purple-500/10"
    >
      <div
        class="p-6 bg-gradient-to-br from-purple-500/10 to-pink-500/10 border-b border-slate-100 dark:border-slate-800"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="w-10 h-10 rounded-xl bg-purple-100 dark:bg-purple-900/40 flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <div>
            <div class="font-bold text-purple-700 dark:text-purple-400 text-lg">
              Happy-CCS
            </div>
            <div class="text-xs text-purple-500/70 dark:text-purple-400/60">
              happy-ccs + Happy CLI
            </div>
          </div>
          <svg
            class="w-5 h-5 text-slate-400 group-hover:text-purple-500 transition-colors ml-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline
              points="9 18 15 12 9 6"
              stroke-linecap="round"
              stroke-linejoin="round"></polyline>
          </svg>
        </div>
        <div class="space-y-1.5">
          {
            [
              t(
                "Switch AI providers (Qwen, Minimax, GLM, Kimi, etc.) on the fly",
                "Chuyển AI provider (Qwen, Minimax, GLM, Kimi...) nhanh chóng",
              ),
              t(
                "Manage multiple CCS profiles for different projects",
                "Quản lý nhiều CCS profile cho từng project",
              ),
              t(
                "Works via daemon mode — always running in background",
                "Hoạt động qua daemon mode — luôn chạy nền",
              ),
            ].map((feat) => (
              <div class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-400">
                <svg
                  class="w-4 h-4 text-purple-500 mt-0.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline
                    points="20 6 9 17 4 12"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {feat}
              </div>
            ))
          }
        </div>
      </div>
      <div class="px-6 py-4 flex items-center justify-between">
        <div class="space-y-1">
          <div
            class="text-xs font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-wide"
          >
            {t("Best for", "Phù hợp với")}
          </div>
          <div class="text-sm text-slate-700 dark:text-slate-300">
            {
              t(
                "Multi-provider power users & mobile workflows",
                "Người dùng nhiều provider & workflow di động",
              )
            }
          </div>
        </div>
        <span
          class="text-xs px-2.5 py-1 rounded-full bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-medium shrink-0 ml-3"
        >
          {t("Free tools", "Công cụ miễn phí")}
        </span>
      </div>
    </a>

    <!-- Remote Control -->
    <a
      href={translatePath("/guides/remote-control")}
      class="group glass-card rounded-2xl overflow-hidden border-2 border-transparent hover:border-indigo-300 dark:hover:border-indigo-500/50 transition-all duration-200 hover:shadow-lg hover:shadow-indigo-500/10"
    >
      <div
        class="p-6 bg-gradient-to-br from-indigo-500/10 to-sky-500/10 border-b border-slate-100 dark:border-slate-800"
      >
        <div class="flex items-center gap-3 mb-3">
          <div
            class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-900/40 flex items-center justify-center"
          >
            <svg
              class="w-5 h-5 text-indigo-600 dark:text-indigo-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
              ></path>
            </svg>
          </div>
          <div>
            <div class="font-bold text-indigo-700 dark:text-indigo-400 text-lg">
              Remote Control
            </div>
            <div class="text-xs text-indigo-500/70 dark:text-indigo-400/60">
              claude /remote-control
            </div>
          </div>
          <svg
            class="w-5 h-5 text-slate-400 group-hover:text-indigo-500 transition-colors ml-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polyline
              points="9 18 15 12 9 6"
              stroke-linecap="round"
              stroke-linejoin="round"></polyline>
          </svg>
        </div>
        <div class="space-y-1.5">
          {
            [
              t(
                "Continue an existing session from your phone or tablet",
                "Tiếp tục session đang chạy từ điện thoại/tablet",
              ),
              t(
                "Built-in QR code for instant connection via URL",
                "QR code tích hợp để kết nối nhanh qua URL",
              ),
              t(
                "Works via claude.ai/code or Claude mobile app",
                "Hoạt động qua claude.ai/code hoặc Claude mobile app",
              ),
            ].map((feat) => (
              <div class="flex items-start gap-2 text-sm text-slate-600 dark:text-slate-400">
                <svg
                  class="w-4 h-4 text-indigo-500 mt-0.5 shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polyline
                    points="20 6 9 17 4 12"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                {feat}
              </div>
            ))
          }
        </div>
      </div>
      <div class="px-6 py-4 flex items-center justify-between">
        <div class="space-y-1">
          <div
            class="text-xs font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-wide"
          >
            {t("Best for", "Phù hợp với")}
          </div>
          <div class="text-sm text-slate-700 dark:text-slate-300">
            {
              t(
                "Continuing desktop sessions remotely",
                "Tiếp tục session desktop từ xa",
              )
            }
          </div>
        </div>
        <span
          class="text-xs px-2.5 py-1 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-medium shrink-0 ml-3"
        >
          {t("Pro+ required", "Cần Pro+")}
        </span>
      </div>
    </a>
  </div>

  <!-- Comparison table -->
  <div class="glass-card rounded-xl overflow-hidden">
    <div class="p-5 border-b border-slate-200 dark:border-slate-800">
      <h3
        class="font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2"
      >
        <svg
          class="w-5 h-5 text-slate-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"
          ></path>
        </svg>
        {t("Quick Comparison", "So sánh nhanh")}
      </h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr
            class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700"
          >
            <th
              class="text-left px-4 py-3 font-semibold text-slate-600 dark:text-slate-400 text-xs uppercase tracking-wide"
            ></th>
            <th
              class="text-center px-4 py-3 font-bold text-purple-700 dark:text-purple-400"
              >Happy-CCS</th
            >
            <th
              class="text-center px-4 py-3 font-bold text-indigo-700 dark:text-indigo-400"
              >Remote Control</th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          {
            [
              [
                t("Subscription required", "Cần subscription"),
                t("No — free tools", "Không — công cụ miễn phí"),
                t("Yes — Pro+", "Có — Pro+"),
              ],
              [
                t("Switch AI provider", "Chuyển AI provider"),
                t("Yes", "Có"),
                t("No", "Không"),
              ],
              [
                t("Phone/tablet access", "Truy cập điện thoại"),
                t("Yes (via Happy CLI)", "Có (qua Happy CLI)"),
                t("Yes (via claude.ai)", "Có (qua claude.ai)"),
              ],
              [
                t("Continue desktop session", "Tiếp tục session desktop"),
                t("No", "Không"),
                t("Yes", "Có"),
              ],
              [
                t("Setup complexity", "Độ phức tạp cài đặt"),
                t("Moderate (npm install)", "Trung bình (npm install)"),
                t("Low (built-in)", "Thấp (có sẵn)"),
              ],
            ].map(([label, a, b]) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="px-4 py-3 font-medium text-slate-700 dark:text-slate-300">
                  {label}
                </td>
                <td class="px-4 py-3 text-center text-slate-600 dark:text-slate-400">
                  {a}
                </td>
                <td class="px-4 py-3 text-center text-slate-600 dark:text-slate-400">
                  {b}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
