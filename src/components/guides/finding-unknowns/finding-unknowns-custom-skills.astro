---
import type { Language } from '@/i18n';
import { Search, NotebookPen, ClipboardCheck, Lock, Users, ArrowRight } from 'lucide-astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const FB_GROUP_URL = 'https://www.facebook.com/groups/1312173340952529';

// Funnel copy: one punchy hook + trigger tags per skill, not the full SKILL.md spec.
const skills = [
  {
    icon: Search,
    name: 'blindspot',
    hook: t(
      "Turns ‘I don't know what I don't know’ into a sharp, ready-to-paste prompt.",
      "Biến ‘tôi không biết mình không biết gì’ thành một prompt sắc bén, dán là dùng được."
    ),
    tags: [t('new area', 'vùng lạ'), t('unfamiliar domain', 'domain mới'), t('before coding', 'trước khi code')],
  },
  {
    icon: NotebookPen,
    name: 'impl-notes',
    hook: t(
      'Catches every plan deviation the moment it happens — before it becomes a mystery.',
      'Bắt từng lần lệch plan ngay lúc xảy ra — trước khi nó thành một bí ẩn.'
    ),
    tags: [t('during coding', 'trong lúc code'), t('edge cases', 'edge case'), t('handoff notes', 'ghi chú bàn giao')],
  },
  {
    icon: ClipboardCheck,
    name: 'quiz-gate',
    hook: t(
      'No perfect quiz score, no merge. Simple as that.',
      'Không pass quiz tuyệt đối thì không merge. Đơn giản vậy thôi.'
    ),
    tags: [t('before merge', 'trước khi merge'), t('comprehension', 'hiểu biết'), t('PR review', 'review PR')],
  },
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-950 sm:p-8">
  <div class="flex flex-wrap items-center gap-3">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
      {t('3 custom skills', '3 custom skills')}
    </h2>
    <span class="rounded-full border border-amber-300 bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-800 shadow-sm dark:border-amber-400/30 dark:bg-amber-500/15 dark:text-amber-200">
      {t('Custom', 'Custom')}
    </span>
  </div>
  <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-600 dark:text-slate-400">
    {t(
      'Not part of AgentKit core — 3 small skills built to close the exact gaps this method needs.',
      'Không thuộc AgentKit core — 3 skill nhỏ dựng ra để bù đúng khoảng trống mà phương pháp này cần.'
    )}
  </p>

  <div class="mt-6 grid gap-4 md:grid-cols-3">
    {skills.map((skill) => {
      const Icon = skill.icon;
      return (
        <div class="flex flex-col rounded-xl border border-violet-200 bg-violet-50/40 p-5 shadow-sm dark:border-violet-400/25 dark:bg-violet-500/5">
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-violet-100 bg-white text-violet-700 dark:border-violet-400/20 dark:bg-slate-950 dark:text-violet-300">
                <Icon class="h-5 w-5" stroke-width={2.2} />
              </span>
              <code class="text-sm font-bold text-slate-950 dark:text-white">{skill.name}</code>
            </div>
            <span class="rounded-full border border-amber-300 bg-amber-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-amber-800 dark:border-amber-400/30 dark:bg-amber-500/15 dark:text-amber-200">
              {t('Custom', 'Custom')}
            </span>
          </div>
          <p class="mt-3 text-sm leading-6 text-slate-700 dark:text-slate-300">{skill.hook}</p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {skill.tags.map((tag) => (
              <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400">
                {tag}
              </span>
            ))}
          </div>
          <div class="mt-auto flex items-center gap-1.5 pt-4 text-xs font-semibold text-amber-700 dark:text-amber-400">
            <Lock class="h-3.5 w-3.5" stroke-width={2.2} />
            {t('Early access', 'Early access')}
          </div>
        </div>
      );
    })}
  </div>

  <a
    href={FB_GROUP_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="group mt-5 flex flex-col gap-3 rounded-xl border border-amber-200 bg-amber-50/80 p-4 shadow-sm dark:border-amber-400/25 dark:bg-amber-500/10 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-start gap-3">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white text-amber-700 shadow-sm dark:bg-slate-950/60 dark:text-amber-300">
        <Users class="h-5 w-5" stroke-width={2.2} />
      </span>
      <div>
        <p class="text-sm font-bold text-slate-950 dark:text-white">
          {t('Shared early with Subscribers first', 'Đang ưu tiên chia sẻ cho Subscribers trước')}
        </p>
        <p class="mt-1 text-xs leading-5 text-slate-600 dark:text-slate-400">
          {t(
            'These 3 skills are being refined inside a private Facebook group before going public. Once stable, they ship to a public repo and this section links straight to it.',
            'Cả 3 skill đang được tinh chỉnh trong nhóm Facebook riêng trước khi công khai. Khi ổn định sẽ publish lên repo công khai và mục này sẽ trỏ thẳng tới đó.'
          )}
        </p>
      </div>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-lg bg-amber-600 px-3.5 py-2 text-xs font-bold text-white shadow-sm transition group-hover:bg-amber-700 sm:self-auto">
      {t('Join the Facebook group', 'Vào nhóm Facebook')}
      <ArrowRight class="h-3.5 w-3.5 transition group-hover:translate-x-0.5" stroke-width={2.2} />
    </span>
  </a>
</section>
