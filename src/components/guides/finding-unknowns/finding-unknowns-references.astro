---
import type { Language } from '@/i18n';
import { ArrowRight, BookOpenText } from 'lucide-astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const sources = [
  [
    t(
      'Original post — "A Field Guide to Fable: Finding Your Unknowns" (Thariq, @trq212)',
      'Bài viết gốc — "A Field Guide to Fable: Finding Your Unknowns" (Thariq, @trq212)'
    ),
    'https://x.com/trq212/status/2073100352921215386',
  ],
  [
    t('HTML artifact examples', 'Ví dụ HTML artifacts'),
    'https://thariqs.github.io/html-effectiveness/unknowns/',
  ],
  [
    t('Fable launch video — edited end-to-end by Claude Code', 'Video ra mắt Fable — Claude Code edit từ đầu đến cuối'),
    'https://x.com/ClaudeDevs/status/2064399512664526853',
  ],
  [
    t('Color-grading discovery explainer', 'Video giải thích khám phá color-grading'),
    'https://x.com/trq212/status/2064826394589442448/video/1',
  ],
] as const;
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
  <div class="flex items-start gap-3">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-violet-50 text-violet-700 dark:bg-violet-500/10 dark:text-violet-300">
      <BookOpenText class="h-5 w-5" stroke-width={2.2} />
    </span>
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-violet-700 dark:text-violet-300">
        {t('References', 'Nguồn tham khảo')}
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
        {t('Method credit & further reading', 'Nguồn phương pháp & đọc thêm')}
      </h2>
    </div>
  </div>
  <div class="mt-5 grid gap-2 sm:grid-cols-2">
    {sources.map(([label, href]) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex min-h-11 items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-violet-300 hover:bg-violet-50 hover:text-violet-800 dark:border-slate-800 dark:bg-slate-900/55 dark:text-slate-200 dark:hover:border-violet-500/40 dark:hover:bg-violet-500/10 dark:hover:text-violet-200"
      >
        <span>{label}</span>
        <ArrowRight class="h-4 w-4 shrink-0 transition group-hover:translate-x-0.5" stroke-width={2.2} />
      </a>
    ))}
  </div>
</section>
