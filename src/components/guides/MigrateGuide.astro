          </div>
          <div>
            <div class="font-semibold text-slate-700 dark:text-slate-200 text-sm mb-0.5">{t('Skip', 'Bỏ qua')}</div>
            <div class="text-xs text-slate-600 dark:text-slate-400">{t('Keep existing file untouched', 'Giữ nguyên file hiện tại')}</div>
          </div>
        </div>
        <!-- View diff -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-violet-50 dark:bg-violet-900/20 border border-violet-200 dark:border-violet-700/50">
          <div class="w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-800/50 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
            </svg>
          </div>
          <div>
            <div class="font-semibold text-violet-700 dark:text-violet-400 text-sm mb-0.5">{t('View diff', 'Xem diff')}</div>
            <div class="text-xs text-violet-600/80 dark:text-violet-300/70">{t('See differences before deciding', 'Xem sự khác nhau trước khi quyết định')}</div>
          </div>
        </div>
      </div>
      <div class="p-4 rounded-lg bg-slate-50 dark:bg-slate-800/30 border border-slate-200 dark:border-slate-700">
        <p class="text-sm text-slate-600 dark:text-slate-400">
          <strong>{t('Auto-resolve:', 'Tự động xử lý:')}</strong> {t('Add --yes to skip all conflict prompts and use safe defaults. Add --force to force-reinstall all items even if they were deleted or edited.', 'Thêm --yes để bỏ qua mọi câu hỏi conflict và dùng mặc định an toàn. Thêm --force để cài lại mọi thứ kể cả đã bị xóa hay chỉnh sửa.')}
        </p>
      </div>
    </div>
