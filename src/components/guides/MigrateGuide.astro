        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
        </svg>
        {t('Conflict Resolution', 'Xử lý Xung đột')}
      </h3>
    </div>
    <div class="p-6 space-y-4">
      <p class="text-slate-600 dark:text-slate-400 text-sm">
        {t('When a target file has been modified externally, ck migrate will offer you a choice:', 'Khi file đích đã bị chỉnh sửa bên ngoài, ck migrate sẽ đưa ra lựa chọn:')}
      </p>
      <div class="grid sm:grid-cols-2 gap-3">
        <!-- Overwrite -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700/50">
          <div class="w-8 h-8 rounded-lg bg-red-100 dark:bg-red-800/50 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-red-600 dark:text-red-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
            </svg>
          </div>
          <div>
            <div class="font-semibold text-red-700 dark:text-red-400 text-sm mb-0.5">{t('Overwrite', 'Ghi đè')}</div>
            <div class="text-xs text-red-600/80 dark:text-red-300/70">{t('Replace target with source content entirely', 'Thay thế hoàn toàn bằng nội dung nguồn')}</div>
          </div>
        </div>
        <!-- Smart merge -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-700/50">
          <div class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-800/50 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/>
            </svg>
          </div>
          <div>
            <div class="font-semibold text-blue-700 dark:text-blue-400 text-sm mb-0.5">{t('Smart merge', 'Merge thông minh')}</div>
            <div class="text-xs text-blue-600/80 dark:text-blue-300/70">{t('Attempt to merge your changes with source', 'Cố gắng merge thay đổi của bạn với nguồn')}</div>
          </div>
        </div>
        <!-- Skip -->
        <div class="flex items-start gap-3 p-4 rounded-xl bg-slate-100 dark:bg-slate-700/40 border border-slate-300 dark:border-slate-600/50">
          <div class="w-8 h-8 rounded-lg bg-slate-200 dark:bg-slate-600/50 flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-slate-600 dark:text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
