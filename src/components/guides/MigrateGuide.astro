---
// MigrateGuide - Guide CK migrate to other AI coding tools
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const isVi = currentLang === 'vi';

const t = (en: string, vi: string) => isVi ? vi : en;

// Supported providers table data
const providers = [
  { name: 'OpenCode',        agents: true,  commands: true,  skills: true,  config: true,  rules: true,  hooks: false, flag: 'opencode' },
  { name: 'Cursor',          agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'cursor' },
  { name: 'Windsurf',        agents: true,  commands: true,  skills: true,  config: true,  rules: true,  hooks: false, flag: 'windsurf' },
  { name: 'GitHub Copilot',  agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'github-copilot' },
  { name: 'Antigravity',     agents: false, commands: true,  skills: true,  config: true,  rules: true,  hooks: false, flag: 'antigravity' },
  { name: 'Cline',           agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'cline' },
  { name: 'Roo',             agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'roo' },
  { name: 'Codex',           agents: true,  commands: true,  skills: true,  config: true,  rules: true,  hooks: true,  flag: 'codex' },
  { name: 'Kilo',            agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'kilo' },
  { name: 'Kiro',            agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'kiro' },
  { name: 'Droid',           agents: true,  commands: true,  skills: true,  config: true,  rules: true,  hooks: true,  flag: 'droid' },
  { name: 'Goose',           agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'goose' },
  { name: 'OpenHands',       agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'openhands' },
  { name: 'Gemini CLI',      agents: true,  commands: true,  skills: true,  config: true,  rules: true,  hooks: true,  flag: 'gemini-cli' },
  { name: 'Amp',             agents: true,  commands: false, skills: true,  config: true,  rules: true,  hooks: false, flag: 'amp' },
];

const quickExamples = [
  { label: t('Interactive install picker', 'Chọn item để cài'), cmd: 'ck migrate --install' },
  { label: t('Preview reconcile plan', 'Xem trước kế hoạch reconcile'), cmd: 'ck migrate --agent codex --dry-run' },
  { label: t('Preserve deletions', 'Giữ nguyên các mục đã xóa'), cmd: 'ck migrate --respect-deletions' },
  { label: t('To Cursor', 'Sang Cursor'),        cmd: 'ck migrate --agent cursor' },
  { label: t('To all providers', 'Sang tất cả'), cmd: 'ck migrate --all' },
  { label: t('Config + rules only', 'Chỉ config + rules'), cmd: 'ck migrate --all --config --rules' },
];

const migrationPhases = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"/></svg>`,
    title: t('Discovery', 'Khám phá'), desc: t('Scans .claude/ for all portable content (agents, commands, skills, rules, hooks, config)', 'Quét thư mục .claude/ tìm tất cả nội dung có thể migrate') },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>`,
    title: t('Provider Selection', 'Chọn Provider'), desc: t('Auto-detects installed providers, or use --agent / --all flags', 'Tự phát hiện các tool đã cài, hoặc dùng --agent / --all') },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0 0 12 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 0 1-2.031.352 5.988 5.988 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.97Zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0 2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 0 1-2.031.352 5.989 5.989 0 0 1-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 5.49Z"/></svg>`,
    title: t('Reconciliation', 'So sánh & lên kế hoạch'), desc: t('Compares source vs target using checksums — plans install/update/skip/delete actions', 'So sánh source và target bằng checksum — lên danh sách hành động') },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0 0 15 0m-15 0a7.5 7.5 0 1 1 15 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077 1.41-.513m14.095-5.13 1.41-.513M5.106 17.785l1.15-.964m11.49-9.642 1.149-.964M7.501 19.795l.75-1.3m7.5-12.99.75-1.3m-6.063 16.658.26-1.477m2.605-14.772.26-1.477m0 17.726-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205 6.75 2.9"/></svg>`,
    title: t('Execution', 'Thực thi'), desc: t('Installs converted content to each provider format, merges hook settings', 'Cài đặt nội dung đã chuyển đổi, merge hook settings') },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"/></svg>`,
    title: t('Summary', 'Tổng kết'), desc: t('Shows success/skip/fail counts. Offers rollback on partial failure', 'Hiển thị kết quả. Hỗ trợ rollback nếu có lỗi') },
];
---

<div class="space-y-8 mt-6">
  <!-- Hero -->
  <div class="text-center space-y-4">
    <h2 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('Migrate ClaudeKit to Any Tool', 'Chuyển ClaudeKit sang Công cụ Khác')}
    </h2>
    <p class="text-xl font-medium text-violet-600 dark:text-violet-400">
      {t('One command. All your agents, skills, rules — everywhere.', 'Một lệnh. Toàn bộ agents, skills, rules — ở mọi nơi.')}
    </p>
    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      <code class="font-mono text-sm bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 px-1.5 py-0.5 rounded">ck migrate</code>
      {t(' lets you take your ClaudeKit setup (agents, commands, skills, config, rules, hooks) and install it into any other AI coding tool with smart reconciliation.', ' giúp bạn mang toàn bộ cấu hình ClaudeKit (agents, commands, skills, config, rules, hooks) sang bất kỳ AI coding tool nào khác, với tính năng so sánh thông minh.')}
    </p>
  </div>

  <!-- Quick start card -->
  <div class="glass-card rounded-2xl overflow-hidden relative">
    <div class="absolute top-0 right-0 w-64 h-64 bg-violet-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="p-8 relative z-10">
      <div class="flex flex-col lg:flex-row gap-8">
        <div class="flex-1">
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            {t('Quick Start', 'Bắt đầu nhanh')}
          </h3>
          <div class="space-y-3">
            {quickExamples.map(ex => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-2">
                <span class="text-xs text-slate-500 dark:text-slate-400 w-48 flex-shrink-0">{ex.label}</span>
                <div class="relative group flex-1">
                  <code class="block bg-slate-900 text-green-400 font-mono text-sm px-3 py-2 rounded-lg pr-10 overflow-x-auto whitespace-nowrap">{ex.cmd}</code>
                  <button
                    type="button"
                    class="copy-btn absolute top-1.5 right-1.5 p-1.5 rounded-md bg-slate-700/80 hover:bg-slate-600 text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200"
                    data-code={ex.cmd}
                    title="Copy"
                  >
                    <svg class="w-3 h-3 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path></svg>
                    <svg class="w-3 h-3 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:w-64 flex-shrink-0">
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {t('What Gets Migrated', 'Nội dung được migrate')}
          </h3>
          <div class="flex flex-col items-start gap-2">
          {[
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>`, label: t('Agents', 'Agents') },
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>`, label: t('Commands', 'Commands') },
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.703-.127 1.5.168 2.37.91 2.942 1.953-.617 1.05-1.46 1.907-2.478 2.486-.894.514-1.897.666-2.656.353-.263-.109-.526-.263-.787-.456-.514-.383-1.014-.863-1.487-1.436-.46-.56-.842-1.12-1.166-1.666-.23-.393-.414-.77-.55-1.117-.184-.467-.185-.947-.07-1.4l.267-.267a2.59 2.59 0 0 0 1.375-1.2l1.636-3.72a2.493 2.493 0 0 1 3.237-1.272l.462.197c1.192.51 1.69 1.933 1.096 3.09l-1.927 3.757a2.553 2.553 0 0 0-.236 1.482Z"/></svg>`, label: t('Skills', 'Skills') },
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>`, label: t('Config (CLAUDE.md)', 'Config (CLAUDE.md)') },
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>`, label: t('Rules (.claude/rules/)', 'Rules (.claude/rules/)') },
            { icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-4 h-4 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/></svg>`, label: t('Hooks (.claude/hooks/)', 'Hooks (.claude/hooks/)') },
          ].map(item => (
            <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
              <span class="text-slate-400 dark:text-slate-500" set:html={item.icon} />
              <span>{item.label}</span>
            </div>
          ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Step-by-step for non-tech users -->
  <div class="glass-card rounded-xl border-violet-200 dark:border-violet-500/30 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-violet-500/10 to-purple-500/10 border-b border-violet-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0118 18a8.966 8.966 0 00-6 2.292m0-14.25v14.25"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-violet-600 dark:text-violet-400">
          {t('Step-by-Step Guide', 'Hướng dẫn từng bước')}
        </h3>
      </div>
    </div>
    <div class="p-6 space-y-6">
      <!-- Non-tech note -->
      <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800/30">
        <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
        </svg>
        <div class="text-sm text-blue-800 dark:text-blue-300">
          <p class="font-medium mb-1">{t('For everyone', 'Dành cho mọi người')}</p>
          <p>{t('This guide is written for non-technical users. Just copy-paste the commands — no programming knowledge needed.', 'Hướng dẫn này dành cho người không chuyên về kỹ thuật. Chỉ cần copy-paste lệnh — không cần biết lập trình.')}</p>
        </div>
      </div>

      <!-- Step 1 -->
      <div class="relative pl-10">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-violet-500 text-white flex items-center justify-center font-bold text-sm flex-shrink-0">1</div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2">{t('Make sure ClaudeKit (ck) is installed', 'Đảm bảo đã cài ClaudeKit (ck)')}</h4>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
          {t('Open your terminal and check if ck is available:', 'Mở terminal và kiểm tra ck có sẵn không:')}
        </p>
        <div class="bg-slate-900 rounded-lg p-3 font-mono text-sm text-green-400">ck --version</div>
        <p class="text-xs text-slate-500 dark:text-slate-500 mt-2">
          {t('If you see a version number, you\'re good. If not, visit vividkit.cc/guides to install ClaudeKit first.', 'Nếu thấy số phiên bản, bạn sẵn sàng rồi. Nếu không, hãy vào vividkit.cc/guides để cài ClaudeKit trước.')}
        </p>
      </div>

      <!-- Step 2 -->
      <div class="relative pl-10">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-violet-500 text-white flex items-center justify-center font-bold text-sm flex-shrink-0">2</div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2">{t('Run the migrate command', 'Chạy lệnh migrate')}</h4>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">
          {t('Replace <tool> with your target tool name:', 'Thay <tool> bằng tên công cụ đích:')}
        </p>
        <div class="space-y-2">
          <div class="bg-slate-900 rounded-lg p-3 font-mono text-sm">
            <span class="text-slate-400"># {t('Interactive mode — auto-detects installed tools', 'Tự động phát hiện tool đã cài')}</span>
            <br/>
            <span class="text-green-400">ck migrate</span>
          </div>
          <div class="bg-slate-900 rounded-lg p-3 font-mono text-sm">
            <span class="text-slate-400"># {t('Specific tool', 'Tool cụ thể')}</span>
            <br/>
            <span class="text-green-400">ck migrate --agent cursor</span>
            <br/>
            <span class="text-green-400">ck migrate --agent antigravity</span>
            <br/>
            <span class="text-green-400">ck migrate --agent windsurf</span>
          </div>
        </div>
        <div class="mt-3 p-3 rounded-lg bg-emerald-50 dark:bg-emerald-900/10 border border-emerald-200 dark:border-emerald-800/30">
          <p class="text-xs text-emerald-700 dark:text-emerald-400">
            <strong>{t('Tip:', 'Mẹo:')}</strong> {t('Use --dry-run first to preview what will happen before writing any files.', 'Dùng --dry-run trước để xem trước kết quả mà không ghi file.')}
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative pl-10">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-violet-500 text-white flex items-center justify-center font-bold text-sm flex-shrink-0">3</div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2">{t('Answer the prompts', 'Trả lời các câu hỏi')}</h4>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          {t('The tool will ask you a few questions (which providers, project or global install, how to handle conflicts). Use arrow keys to select and Enter to confirm. To skip all prompts and use defaults:', 'Công cụ sẽ hỏi một vài câu (chọn provider, cài project hay global, xử lý conflict thế nào). Dùng mũi tên để chọn và Enter để xác nhận. Để bỏ qua tất cả và dùng mặc định:')}
        </p>
        <div class="mt-3 bg-slate-900 rounded-lg p-3 font-mono text-sm text-green-400">ck migrate --all --yes</div>
      </div>

      <!-- Step 4 -->
      <div class="relative pl-10">
        <div class="absolute left-0 top-0 w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm flex-shrink-0">✓</div>
        <h4 class="font-bold text-slate-900 dark:text-slate-100 mb-2">{t('Done! Open your target tool', 'Xong! Mở công cụ đích của bạn')}</h4>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          {t('Your agents, rules, and config have been installed in the new tool\'s format. Open Cursor, Windsurf, or your chosen tool — the content will be ready.', 'Agents, rules và config đã được cài vào định dạng của công cụ mới. Mở Cursor, Windsurf hoặc công cụ bạn chọn — nội dung đã sẵn sàng.')}
        </p>
