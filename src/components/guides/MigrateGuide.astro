            <th class="text-center px-3 py-3 font-semibold text-slate-700 dark:text-slate-300 text-xs">Commands</th>
            <th class="text-center px-3 py-3 font-semibold text-slate-700 dark:text-slate-300 text-xs">Skills</th>
            <th class="text-center px-3 py-3 font-semibold text-slate-700 dark:text-slate-300 text-xs">Config</th>
