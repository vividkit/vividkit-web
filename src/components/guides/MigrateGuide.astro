---
import { getLangFromUrl, type Language } from '@/i18n';
import MigrationLanes from './migrate/migration-lanes.astro';
import AgentKitTargetMatrix from './migrate/agentkit-target-matrix.astro';
import LegacyProviderContext from './migrate/legacy-provider-context.astro';
interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
---
<div class="mt-6 space-y-10"><MigrationLanes lang={currentLang} /><AgentKitTargetMatrix lang={currentLang} /><LegacyProviderContext lang={currentLang} /></div>
