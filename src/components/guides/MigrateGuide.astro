              ))}
              <td class="px-3 py-3">
                <code class="text-xs bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 px-2 py-0.5 rounded font-mono">--agent {p.flag}</code>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
