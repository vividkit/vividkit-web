<script>
  // Version toggle functionality for flowchart guide
  document.addEventListener("DOMContentLoaded", () => {
    const btnStable = document.getElementById("fc-btn-stable");
    const btnBeta = document.getElementById("fc-btn-beta");
    const stableContents = document.querySelectorAll(".fc-stable-content");
    const betaContents = document.querySelectorAll(".fc-beta-content");

    if (!btnStable || !btnBeta || stableContents.length === 0) return;

    const activeClasses = "bg-teal-500 text-white shadow-sm";
    const inactiveClasses =
      "text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700";
    const activeBetaClasses = "bg-purple-500 text-white shadow-sm";

    function setVersion(version: "stable" | "beta") {
      if (version === "stable") {
        stableContents.forEach((el) => el.classList.remove("hidden"));
        betaContents.forEach((el) => el.classList.add("hidden"));
        btnStable.className = `fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeClasses}`;
        btnBeta.className = `fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      } else {
        stableContents.forEach((el) => el.classList.add("hidden"));
        betaContents.forEach((el) => el.classList.remove("hidden"));
        btnBeta.className = `fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeBetaClasses}`;
        btnStable.className = `fc-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      }

      // Save preference
      localStorage.setItem("flowchart-version", version);

      // Dispatch custom event for FlowchartInteractive to listen
      document.dispatchEvent(
        new CustomEvent("flowchart-version-change", { detail: version }),
      );
    }

    // Load saved preference (migrate old keys)
    const savedVersion = localStorage.getItem("flowchart-version") as
      | "stable"
      | "beta"
      | "v25"
      | "v24"
      | null;
    if (savedVersion === "v25" || savedVersion === "stable") {
      setVersion("stable");
    } else if (savedVersion === "v24" || savedVersion === "beta") {
      setVersion("beta");
    }

    btnStable.addEventListener("click", () => setVersion("stable"));
    btnBeta.addEventListener("click", () => setVersion("beta"));
  });
</script>
