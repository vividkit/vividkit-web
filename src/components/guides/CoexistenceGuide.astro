---
import { getLangFromUrl, type Language } from '@/i18n';
import { getAgentKitCliFact } from '@/data/guides/agentkit/agentkit-cli-facts';
import { getAgentKitTargetView } from '@/data/guides/agentkit/agentkit-target-capabilities';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';
import TerminalSnippet from './TerminalSnippet.astro';

interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const prefix = isVi ? '/vi' : '';
const projectTarget = getAgentKitTargetView('claude-code', 'engineer', 'project-local');
const doctorCommand = getAgentKitCliFact('doctor')?.command ?? '';

const eligibility = [
  isVi ? 'CK chỉ ở global scope; project pilot không có CK-owned content còn sót.' : 'CK exists only at global scope; the pilot project has no remaining CK-owned content.',
  isVi ? 'AK chỉ cài project-local trong một project sạch, không dùng --global.' : 'AK is project-local in one clean project; no --global installation.',
  isVi ? 'Project không critical, có backup/restore đã thử và owner đồng ý closed-beta.' : 'The project is noncritical, backup/restore is tested, and the owner approved closed-beta enrollment.',
  isVi ? 'Detector, canary và observation record được giữ ngoài VividKit.' : 'Detector, canary, and observation records are kept outside VividKit.',
];

const exitCriteria = [
  isVi ? 'Canary fail, unexpected diff hoặc ownership trở thành mixed/unknown.' : 'Canary failure, unexpected diff, or ownership becomes mixed/unknown.',
  isVi ? 'Không thể chứng minh project-local boundary hoặc restore path.' : 'The project-local boundary or restore path cannot be demonstrated.',
  isVi ? 'Observation có incident chưa xử lý hoặc chưa đủ 72 giờ.' : 'Observation has an unresolved incident or has not reached 72 hours.',
];
---

<div class="mt-6" data-agentkit-channel-root data-agentkit-surface="coexistence" data-agentkit-locale={currentLang} data-agentkit-active-channel="stable">
  <AgentKitChannelSwitcher lang={currentLang} />
  <div class="space-y-10" data-agentkit-stable-facts>
    <section class="rounded-3xl border border-violet-200 bg-gradient-to-br from-violet-50 via-white to-amber-50 p-6 dark:border-violet-500/20 dark:from-violet-950/30 dark:via-slate-950 dark:to-amber-950/20 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-700 dark:text-violet-300">AgentKit closed-beta coexistence</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">
        {isVi ? 'Một pilot hẹp, không phải hướng dẫn chạy chung mọi scope' : 'A narrow pilot, not a broad same-scope setup'}
      </h1>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">
        {isVi
          ? 'Topology duy nhất được hỗ trợ trong follow-up này là CK global + AK project-local trong một project sạch, low-risk. Query beta chỉ chọn nội dung công khai; nó không ghi danh hoặc cấp quyền pilot.'
          : 'The only topology supported by this follow-up is CK global plus AK project-local in one clean, low-risk project. The beta query selects public content; it neither enrolls nor authorizes a pilot.'}
      </p>
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <article class="min-w-0 rounded-2xl border border-emerald-200 bg-emerald-50/60 p-5 dark:border-emerald-500/25 dark:bg-emerald-950/20">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-emerald-700 dark:text-emerald-300">CK · global</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950 dark:text-white">{isVi ? 'Rollback control plane' : 'Rollback control plane'}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">{isVi ? 'Giữ executable/control plane CK global trong suốt canary và observation. Không cài CK content vào project pilot.' : 'Keep the global CK executable/control plane through canary and observation. Do not install CK content into the pilot project.'}</p>
      </article>
      <article class="min-w-0 rounded-2xl border border-violet-200 bg-violet-50/60 p-5 dark:border-violet-500/25 dark:bg-violet-950/20">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-violet-700 dark:text-violet-300">AK · project-local</p>
        <h2 class="mt-2 text-xl font-bold text-slate-950 dark:text-white">{isVi ? 'Một project sạch' : 'One clean project'}</h2>
        <p class="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-300">{isVi ? 'Chỉ tạo AgentKit-owned content trong project pilot. Không mở rộng sang global hoặc project khác.' : 'Create AgentKit-owned content only in the pilot project. Do not expand to global scope or another project.'}</p>
        <div class="mt-4"><TerminalSnippet code={projectTarget.installCommand} label="shell · project-local review" copyable={projectTarget.installCopyable} /></div>
      </article>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Eligibility bắt buộc' : 'Required eligibility'}</h2>
      <ul class="grid gap-3 md:grid-cols-2">
        {eligibility.map((item) => <li class="rounded-2xl border border-slate-200 bg-white p-4 text-sm leading-6 text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">{item}</li>)}
      </ul>
      <aside class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm leading-6 text-amber-950 dark:border-amber-400/30 dark:bg-amber-950/30 dark:text-amber-100">
        {isVi ? 'Mixed/custom/corrupt/missing metadata, critical data hoặc unknown package ownership không đủ điều kiện. Chuyển sang support-assisted; không dùng query để override.' : 'Mixed/custom/corrupt/missing metadata, critical data, or unknown package ownership is ineligible. Use support-assisted handling; a query cannot override this boundary.'}
      </aside>
    </section>

    <section class="grid gap-4 lg:grid-cols-2">
      <article class="rounded-2xl border border-rose-200 bg-rose-50 p-5 dark:border-rose-400/20 dark:bg-rose-950/20">
        <h2 class="text-xl font-bold text-rose-950 dark:text-rose-100">{isVi ? 'Exit criteria' : 'Exit criteria'}</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-rose-900 dark:text-rose-200">
          {exitCriteria.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article class="rounded-2xl border border-cyan-200 bg-cyan-50 p-5 dark:border-cyan-400/20 dark:bg-cyan-950/20">
        <h2 class="text-xl font-bold text-cyan-950 dark:text-cyan-100">{isVi ? 'Kill switch và recovery' : 'Kill switch and recovery'}</h2>
        <p class="mt-3 text-sm leading-6 text-cyan-900 dark:text-cyan-200">{isVi ? 'Dừng AK mutation, giữ CK executable, restore project từ known-good backup và gửi sanitized detector/canary report cho support. Không gỡ CK trong recovery.' : 'Stop AK mutations, keep the CK executable, restore the project from a known-good backup, and send a sanitized detector/canary report to support. Do not remove CK during recovery.'}</p>
        {doctorCommand && <div class="mt-4"><TerminalSnippet code={doctorCommand} label="shell · read-only detector" /></div>}
      </article>
    </section>

    <nav class="flex flex-wrap gap-3" aria-label={isVi ? 'Liên kết lifecycle' : 'Lifecycle links'}>
      <a href={`${prefix}/guides/agentkit`} class="inline-flex min-h-11 items-center rounded-xl bg-violet-600 px-4 py-2 text-sm font-semibold text-white hover:bg-violet-700">{isVi ? 'Mở decision router' : 'Open decision router'}</a>
      <a href="https://github.com/bestagentkits/agentkit-support" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-violet-400 dark:border-slate-700 dark:text-slate-200">AgentKit Support</a>
    </nav>
  </div>
</div>
