---
import { getLangFromUrl, type Language } from '@/i18n';
import { getAgentKitTargetViews } from '@/data/guides/agentkit/agentkit-target-capabilities';
import TerminalSnippet from './TerminalSnippet.astro';
interface Props { lang?: Language }
const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const isVi = currentLang === 'vi';
const targets = getAgentKitTargetViews();
---

<div class="mt-6 space-y-10">
  <section class="rounded-3xl border border-violet-200 bg-gradient-to-br from-violet-50 via-white to-amber-50 p-6 dark:border-violet-500/20 dark:from-violet-950/30 dark:via-slate-950 dark:to-amber-950/20 sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-700 dark:text-violet-300">AgentKit coexistence</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">{isVi ? 'Một kit, nhiều target — ownership rõ ràng' : 'One kit, multiple targets — clear ownership'}</h1>
    <p class="mt-4 max-w-3xl leading-7 text-slate-600 dark:text-slate-300">{isVi ? 'AgentKit quản lý generated kit content; Claude Code và Codex vẫn sở hữu settings/runtime riêng. CCS chỉ quản lý runtime profiles.' : 'AgentKit manages generated kit content; Claude Code and Codex retain their own settings and runtime. CCS owns runtime profiles only.'}</p>
  </section>
  <section class="grid gap-4 lg:grid-cols-2">
    {targets.map((target) => (
      <article class="rounded-2xl border border-slate-200 p-5 dark:border-slate-700">
        <h2 class="font-bold text-slate-950 dark:text-white">{target.displayName}</h2>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-300">{target.status} · {target.channel}</p>
        <div class="mt-3"><TerminalSnippet code={target.installCommand} label="shell · review global scope" copyable={target.installCopyable} /></div>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          {target.target === 'claude-code'
            ? (isVi ? `Giữ .claude settings và custom files của Claude Code; dùng ${target.invocationWildcard} và review preview trước force.` : `Keep Claude Code .claude settings and custom files; use ${target.invocationWildcard} and review previews before force.`)
            : (isVi ? `Dùng ${target.invocationWildcard} ${target.invocationDescription} trong Codex, không dùng slash syntax Claude Code.` : `Use ${target.invocationWildcard} ${target.invocationDescription}s in Codex, not Claude Code slash syntax.`)}
        </p>
      </article>
    ))}
  </section>
  <section class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-400/20 dark:bg-amber-950/20"><h2 class="text-xl font-bold text-amber-950 dark:text-amber-100">{isVi ? 'Quy tắc an toàn khi refresh' : 'Safe refresh rules'}</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-amber-900 dark:text-amber-200"><li>{isVi ? 'Preview và đọc diff trước khi apply.' : 'Preview and inspect the diff before applying.'}</li><li>{isVi ? 'AgentKit snapshot managed files; custom files không được ghi đè âm thầm.' : 'AgentKit snapshots managed files; custom files are not silently overwritten.'}</li><li>{isVi ? 'Không dùng --force nếu chưa xác nhận rollback path.' : 'Do not use --force without a confirmed rollback path.'}</li></ul></section>
</div>
