---
import { getLangFromUrl, type Language } from '@/i18n';
import CLICommandsHero from './cli-commands/cli-commands-hero.astro';
import CLICommandsCheatsheet from './cli-commands/cli-commands-cheatsheet.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
---

<div class="mt-6" data-agentkit-channel-root data-agentkit-surface="cli-commands" data-agentkit-locale={currentLang} data-agentkit-active-channel="stable">
  <AgentKitChannelSwitcher lang={currentLang} />
  <div class="space-y-8" data-agentkit-stable-facts>
    <CLICommandsHero lang={currentLang} />
    <CLICommandsCheatsheet lang={currentLang} />
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code || /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/.test(code)) return;
        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy:', err);
        }
      });
    });
  });
</script>
