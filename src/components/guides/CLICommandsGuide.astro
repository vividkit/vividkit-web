---
import { getLangFromUrl, type Language } from '@/i18n';
import { getAgentKitSsrChannelState } from '@/data/guides/agentkit/agentkit-channel-policy.mjs';
import CLICommandsHero from './cli-commands/cli-commands-hero.astro';
import CLICommandsCheatsheet from './cli-commands/cli-commands-cheatsheet.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const publicationStatus = import.meta.env.AGENTKIT_PUBLICATION_STATUS ?? 'hold';
const channelState = getAgentKitSsrChannelState(Astro.url.search, publicationStatus);
const copyStatusMessages = currentLang === 'vi'
  ? {
      success: 'Đã sao chép lệnh an toàn: {command}',
      failure: 'Không thể sao chép. Hãy chọn và sao chép thủ công: {command}',
    }
  : {
      success: 'Copied safe command: {command}',
      failure: 'Copy failed. Select and copy manually: {command}',
    };
---

<div
  class="mt-6"
  data-agentkit-channel-root
  data-agentkit-cli-copy-root
  data-agentkit-surface="cli-commands"
  data-agentkit-locale={currentLang}
  data-agentkit-requested-channel={channelState.requestedChannel}
  data-agentkit-active-channel={channelState.activeChannel}
  data-agentkit-channel-status={channelState.status}
  data-agentkit-copy-success={copyStatusMessages.success}
  data-agentkit-copy-failure={copyStatusMessages.failure}
>
  <CLICommandsHero lang={currentLang} />
  <AgentKitChannelSwitcher lang={currentLang} />
  <div class="space-y-8" data-agentkit-stable-facts>
    <CLICommandsCheatsheet lang={currentLang} />
    <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-agentkit-copy-status></p>
  </div>
</div>

<script>
  import { initializeAgentKitCliCopyController } from '@/scripts/agentkit-cli-copy-controller';

  initializeAgentKitCliCopyController();
  document.addEventListener('astro:page-load', initializeAgentKitCliCopyController);
</script>
