---
// IDE Config Guide - Model selection and pro tips
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import { opus45Config, sonnet46Config } from '@/data/guides/ide-config/ide-config-provider-code-snippets';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<!-- Model Selection -->
<div class="glass-card rounded-xl border-rose-200 dark:border-rose-500/30 overflow-hidden">
  <div class="p-6 bg-gradient-to-r from-rose-500/10 to-pink-500/10 border-b border-rose-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-rose-500/20 flex items-center justify-center">
        <img
          src="https://unpkg.com/@lobehub/icons-static-svg@latest/icons/claude-color.svg"
          alt="Claude"
          width="24"
          height="24"
          class="w-6 h-6"
          loading="lazy"
          decoding="async"
        />
      </div>
      <h3 class="text-xl font-bold text-rose-600 dark:text-rose-400">
        {t('ide_config.guide.model_selection_title')}
      </h3>
    </div>
  </div>
  <div class="p-6 space-y-6">
    <p class="text-slate-700 dark:text-slate-300">
      {t('ide_config.guide.model_selection_desc')}
    </p>

    <!-- Who This Is For Note -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800/30">
      <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
      </svg>
      <div class="text-sm text-blue-800 dark:text-blue-300">
        <p class="font-medium mb-1">{t('ide_config.guide.model_who_title')}</p>
        <p>{t('ide_config.guide.model_who_note')}</p>
      </div>
    </div>

    <!-- Model Version Note -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30">
      <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
      </svg>
      <div class="text-sm text-amber-800 dark:text-amber-300">
        <p class="font-medium mb-1">{t('ide_config.guide.model_token_usage_title')}</p>
        <p>{t('ide_config.guide.model_token_usage_note')}</p>
      </div>
    </div>

    <!-- Opus 4.6 (Default) -->
    <div class="border border-rose-200 dark:border-rose-800/50 rounded-lg overflow-hidden">
      <div class="px-4 py-3 bg-rose-50 dark:bg-rose-900/20 border-b border-rose-200 dark:border-rose-800/50">
        <div class="flex items-center gap-2">
          <img
            src="https://unpkg.com/@lobehub/icons-static-svg@latest/icons/claude-color.svg"
            alt="Claude"
            width="20"
            height="20"
            class="w-5 h-5"
            loading="lazy"
            decoding="async"
          />
          <h4 class="font-bold text-rose-700 dark:text-rose-400">Claude Opus 4.6</h4>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 font-mono">Latest</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 font-mono">{t('ide_config.guide.opus_46_default')}</span>
        </div>
        <p class="text-xs text-rose-600/70 dark:text-rose-400/70 mt-1">{t('ide_config.guide.opus_46_note')}</p>
      </div>
      <div class="relative group">
        <div class="bg-slate-900 p-4 overflow-x-auto">
          <pre class="text-sm text-slate-500 whitespace-pre">// {t('ide_config.guide.opus_46_no_config')}
// "claudeCode.selectedModel": "claude-opus-4-6"</pre>
        </div>
      </div>
    </div>

    <!-- Sonnet 4.6 (New) -->
    <div class="border border-blue-200 dark:border-blue-800/50 rounded-lg overflow-hidden">
      <div class="px-4 py-3 bg-blue-50 dark:bg-blue-900/20 border-b border-blue-200 dark:border-blue-800/50">
        <div class="flex items-center gap-2">
          <img
            src="https://unpkg.com/@lobehub/icons-static-svg@latest/icons/claude-color.svg"
            alt="Claude"
            width="20"
            height="20"
            class="w-5 h-5"
            loading="lazy"
            decoding="async"
          />
          <h4 class="font-bold text-blue-700 dark:text-blue-400">Claude Sonnet 4.6</h4>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-mono">{t('ide_config.guide.sonnet_46_new')}</span>
        </div>
        <p class="text-xs text-blue-600/70 dark:text-blue-400/70 mt-1">{t('ide_config.guide.sonnet_46_note')}</p>
      </div>
      <div class="relative group">
        <div class="bg-slate-900 p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 whitespace-pre">{sonnet46Config}</pre>
        </div>
        <button
          type="button"
          class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
          data-code={sonnet46Config}
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Opus 4.5 -->
    <div class="border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden">
      <div class="px-4 py-3 bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
        <div class="flex items-center gap-2">
          <img
            src="https://unpkg.com/@lobehub/icons-static-svg@latest/icons/claude-color.svg"
            alt="Claude"
            width="20"
            height="20"
            class="w-5 h-5 grayscale opacity-70"
            loading="lazy"
            decoding="async"
          />
          <h4 class="font-bold text-slate-700 dark:text-slate-400">Claude Opus 4.5</h4>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 font-mono">Token Efficient</span>
        </div>
        <p class="text-xs text-slate-600/70 dark:text-slate-400/70 mt-1">{t('ide_config.guide.opus_45_note')}</p>
      </div>
      <div class="relative group">
        <div class="bg-slate-900 p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 whitespace-pre">{opus45Config}</pre>
        </div>
        <button
          type="button"
          class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
          data-code={opus45Config}
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Pro Tips -->
<div class="glass-card rounded-2xl p-8 border border-slate-200 dark:border-slate-800">
  <div class="flex items-center gap-4 mb-6">
    <div class="flex-shrink-0 p-3 bg-blue-100 dark:bg-blue-900/30 rounded-xl text-blue-600 dark:text-blue-400">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
    </div>
    <h3 class="text-lg font-semibold">{t('ide_config.guide.tips_title')}</h3>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="flex items-start gap-3 p-4 rounded-lg bg-surface-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
      <svg class="w-6 h-6 text-blue-500 dark:text-blue-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <div>
        <div class="text-sm font-medium text-slate-900 dark:text-slate-200 mb-1">{t('ide_config.guide.tip_one_provider_title')}</div>
        <div class="text-xs text-slate-600 dark:text-slate-400">{t('ide_config.guide.tip_one_provider')}</div>
      </div>
    </div>
    <div class="flex items-start gap-3 p-4 rounded-lg bg-surface-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
      <svg class="w-6 h-6 text-purple-500 dark:text-purple-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <div>
        <div class="text-sm font-medium text-slate-900 dark:text-slate-200 mb-1">{t('ide_config.guide.tip_ccs_auto_title')}</div>
        <div class="text-xs text-slate-600 dark:text-slate-400">{t('ide_config.guide.tip_ccs_auto')}</div>
      </div>
    </div>
    <div class="flex items-start gap-3 p-4 rounded-lg bg-surface-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
      <svg class="w-6 h-6 text-green-500 dark:text-green-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <div>
        <div class="text-sm font-medium text-slate-900 dark:text-slate-200 mb-1">{t('ide_config.guide.tip_thinking_title')}</div>
        <div class="text-xs text-slate-600 dark:text-slate-400"><Fragment set:html={t('ide_config.guide.tip_thinking').replace('MAX_THINKING_TOKENS', '<code class="px-1.5 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-mono">MAX_THINKING_TOKENS</code>')} /></div>
      </div>
    </div>
    <div class="flex items-start gap-3 p-4 rounded-lg bg-surface-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700">
      <svg class="w-6 h-6 text-cyan-500 dark:text-cyan-400 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      <div>
        <div class="text-sm font-medium text-slate-900 dark:text-slate-200 mb-1">{t('ide_config.guide.tip_model_mapping_title')}</div>
        <div class="text-xs text-slate-600 dark:text-slate-400">{t('ide_config.guide.tip_model_mapping')}</div>
      </div>
    </div>
  </div>
</div>
