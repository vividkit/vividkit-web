---
// IDE Config Guide - Advanced config (bypass permissions) and CCS cross-reference footer
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import { permissionsConfig, schemaConfig } from '@/data/guides/ide-config/ide-config-provider-code-snippets';
import PlatformPathSwitcher from '../PlatformPathSwitcher.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
---

<!-- Advanced Config -->
<div class="glass-card rounded-xl border-indigo-200 dark:border-indigo-500/30 overflow-hidden">
  <div class="p-6 bg-gradient-to-r from-indigo-500/10 to-violet-500/10 border-b border-indigo-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-indigo-500/20 flex items-center justify-center">
        <svg class="w-6 h-6 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-indigo-600 dark:text-indigo-400">
        {t('ide_config.guide.advanced_title')}
      </h3>
    </div>
  </div>
  <div class="p-6 space-y-6">
    <p class="text-slate-700 dark:text-slate-300">
      {t('ide_config.guide.advanced_desc')}
    </p>

    <!-- Warning Note -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30">
      <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
      </svg>
      <div class="text-sm text-red-800 dark:text-red-300">
        <p class="font-medium mb-1">{t('ide_config.guide.permissions_warning_title')}</p>
        <p>{t('ide_config.guide.permissions_warning_note')}</p>
      </div>
    </div>

    <!-- Bypass Permissions Config -->
    <div class="border border-indigo-200 dark:border-indigo-800/50 rounded-lg overflow-hidden">
      <div class="px-4 py-3 bg-indigo-50 dark:bg-indigo-900/20 border-b border-indigo-200 dark:border-indigo-800/50">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
          </svg>
          <h4 class="font-bold text-indigo-700 dark:text-indigo-400">{t('ide_config.guide.permissions_config_title')}</h4>
        </div>
        <p class="text-xs text-indigo-600/70 dark:text-indigo-400/70 mt-1">{t('ide_config.guide.permissions_config_note')}</p>
      </div>
      <div class="relative group">
        <div class="bg-slate-900 p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 whitespace-pre">{permissionsConfig}</pre>
        </div>
        <button
          type="button"
          class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
          data-code={permissionsConfig}
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Schema Config -->
    <div class="border border-indigo-200 dark:border-indigo-800/50 rounded-lg overflow-hidden mt-6">
      <div class="px-4 py-3 bg-indigo-50 dark:bg-indigo-900/20 border-b border-indigo-200 dark:border-indigo-800/50">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m3.75 9v6m3-3H9m1.5-12H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <h4 class="font-bold text-indigo-700 dark:text-indigo-400">{t('ide_config.guide.schema_config_title')}</h4>
        </div>
        <p class="text-xs text-indigo-600/70 dark:text-indigo-400/70 mt-1">{t('ide_config.guide.schema_config_note')}</p>
      </div>
      <div class="relative group">
        <div class="bg-slate-900 p-4 overflow-x-auto">
          <pre class="text-sm text-green-400 whitespace-pre">{schemaConfig}</pre>
        </div>
        <button
          type="button"
          class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
          data-code={schemaConfig}
          title="Copy to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- .ck.json Configuration Reference -->
<div class="glass-card rounded-xl border-violet-200 dark:border-violet-500/30 overflow-hidden">
  <div class="p-6 bg-gradient-to-r from-violet-500/10 to-purple-500/10 border-b border-violet-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center">
        <svg class="w-6 h-6 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
      </div>
      <div>
        <h3 class="text-xl font-bold text-violet-700 dark:text-violet-400">{t('ccs.guide.ck_json_title')}</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1" set:html={t('ccs.guide.ck_json_desc')}></p>
      </div>
    </div>
  </div>
  <div class="p-6 space-y-4">

    <!-- File Location -->
    <div class="p-4 rounded-lg bg-violet-50 dark:bg-violet-900/10 border border-violet-200 dark:border-violet-800/30">
      <p class="text-xs font-semibold text-violet-700 dark:text-violet-400 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        {t('ide_config.guide.ck_json_location_title')}
      </p>
      <div class="space-y-2">
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">{t('ide_config.guide.ck_json_project_location')}</p>
          <div class="bg-violet-50 dark:bg-violet-900/10 rounded-md px-3 py-2 border border-violet-200 dark:border-violet-700/50 font-mono text-xs text-violet-700 dark:text-violet-300">
            .ck.json <span class="text-slate-400 dark:text-slate-500 font-sans">(project root)</span>
          </div>
        </div>
        <div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">{t('ide_config.guide.ck_json_global_location')}</p>
          <PlatformPathSwitcher
            lang={currentLang}
            pathAfterHome=".ck.json"
            label=""
            id="ck-json-global-path"
            color="indigo"
          />
        </div>
      </div>
    </div>

    <!-- Settings Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-sm font-mono">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-700">
            <th class="text-left py-2 pr-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t('ccs.guide.ck_json_setting')}</th>
            <th class="text-left py-2 pr-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">{t('ccs.guide.ck_json_default')}</th>
            <th class="text-left py-2 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider font-sans">{t('ccs.guide.ck_json_description')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          {[
            { key: 'codingLevel', default: '-1 (auto)', desc: 'Experience level for tailored output (-1=auto, 0-5)' },
            { key: 'statusline', default: '"full" (Beta) / "minimal" (Stable)', desc: 'Status bar display mode ("minimal" or "full")' },
            { key: 'privacyBlock', default: 'true', desc: 'Block access to .env and sensitive files' },
            { key: 'docs.maxLoc', default: '800', desc: 'Max lines of code for doc generation' },
            { key: 'plan.namingFormat', default: '"{date}-{slug}"', desc: 'Plan directory naming pattern' },
            { key: 'plan.dateFormat', default: '"YYMMDD"', desc: 'Date format in plan names' },
            { key: 'plan.validation.mode', default: '"prompt"', desc: 'Plan validation mode' },
            { key: 'plan.validation.questions', default: '"3-8"', desc: 'Number of validation questions' },
            { key: 'locale.responseLanguage', default: 'null', desc: 'Response language (null = English)' },
            { key: 'project.type', default: '"auto"', desc: 'Project type detection' },
            { key: 'project.packageManager', default: '"auto"', desc: 'Package manager detection' },
            { key: 'gemini.model', default: '"gemini-3-flash-preview"', desc: 'Default Gemini model for research' },
            { key: 'skills.research.useGemini', default: 'true', desc: 'Use Gemini for research tasks' },
          ].map(row => (
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="py-2.5 pr-4 text-violet-600 dark:text-violet-400 text-xs whitespace-nowrap">{row.key}</td>
              <td class="py-2.5 pr-4 text-amber-600 dark:text-amber-400 text-xs whitespace-nowrap">{row.default}</td>
              <td class="py-2.5 text-slate-600 dark:text-slate-400 text-xs font-sans">{row.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- CCS Cross-reference -->
<div class="glass-card rounded-xl border-slate-200 dark:border-slate-700/50 overflow-hidden">
  <div class="p-6 text-center">
    <p class="text-slate-600 dark:text-slate-400 mb-3">
      {t('ide_config.guide.ccs_cta')}
    </p>
    <a href={translatePath('/guides/ccs')} class="inline-flex items-center gap-2 px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
      </svg>
      {t('ide_config.guide.ccs_link_text')}
    </a>
  </div>
</div>
