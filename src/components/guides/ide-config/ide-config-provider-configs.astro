---
// IDE Config Guide - Provider configuration snippets (AGY, GLM, Kimi, MiniMax, Alibaba)
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';
import { agyConfig, glmConfig, kimiConfig, minimaxConfig, alibabaConfig } from '@/data/guides/ide-config/ide-config-provider-code-snippets';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

// Tailwind JIT safe class map
const colorMap: Record<string, {
  border: string;
  toggle: string;
  title: string;
  badge: string;
  noteDesk: string;
  chevron: string;
  noteMob: string;
}> = {
  purple: {
    border: "border-purple-200 dark:border-purple-800/50",
    toggle: "bg-purple-50 dark:bg-purple-900/20 hover:bg-purple-100/50 dark:hover:bg-purple-900/30",
    title: "text-purple-700 dark:text-purple-400",
    badge: "bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400",
    noteDesk: "text-purple-500/70 dark:text-purple-400/60",
    chevron: "text-purple-400",
    noteMob: "bg-purple-50/50 dark:bg-purple-900/10 text-purple-600/70 dark:text-purple-400/60",
  },
  blue: {
    border: "border-blue-200 dark:border-blue-800/50",
    toggle: "bg-blue-50 dark:bg-blue-900/20 hover:bg-blue-100/50 dark:hover:bg-blue-900/30",
    title: "text-blue-700 dark:text-blue-400",
    badge: "bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400",
    noteDesk: "text-blue-500/70 dark:text-blue-400/60",
    chevron: "text-blue-400",
    noteMob: "bg-blue-50/50 dark:bg-blue-900/10 text-blue-600/70 dark:text-blue-400/60",
  },
  violet: {
    border: "border-violet-200 dark:border-violet-800/50",
    toggle: "bg-violet-50 dark:bg-violet-900/20 hover:bg-violet-100/50 dark:hover:bg-violet-900/30",
    title: "text-violet-700 dark:text-violet-400",
    badge: "bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400",
    noteDesk: "text-violet-500/70 dark:text-violet-400/60",
    chevron: "text-violet-400",
    noteMob: "bg-violet-50/50 dark:bg-violet-900/10 text-violet-600/70 dark:text-violet-400/60",
  },
  orange: {
    border: "border-orange-200 dark:border-orange-800/50",
    toggle: "bg-orange-50 dark:bg-orange-900/20 hover:bg-orange-100/50 dark:hover:bg-orange-900/30",
    title: "text-orange-700 dark:text-orange-400",
    badge: "bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400",
    noteDesk: "text-orange-500/70 dark:text-orange-400/60",
    chevron: "text-orange-400",
    noteMob: "bg-orange-50/50 dark:bg-orange-900/10 text-orange-600/70 dark:text-orange-400/60",
  },
};

// Provider data — collapsed by default, AGY expanded so users see a working example
const providers = [
  {
    id: 'agy',
    name: 'Antigravity (AGY) via CCS',
    type: 'CLIProxy',
    typeColor: 'purple',
    note: t('ide_config.guide.agy_note'),
    badge: { label: '⚠️ High Risk', color: 'amber' },
    config: agyConfig,
    expanded: true, // show first one open as example
    icon: 'gemini' as const,
    iconVariant: undefined,
    iconClass: 'shrink-0',
  },
  {
    id: 'glm',
    name: 'GLM (z.ai)',
    type: 'APIProxy',
    typeColor: 'blue',
    note: t('ide_config.guide.glm_note'),
    badge: null,
    config: glmConfig,
    expanded: false,
    icon: 'zai' as const,
    iconVariant: undefined,
    iconClass: 'shrink-0 dark:invert',
  },
  {
    id: 'kimi',
    name: 'Kimi (Moonshot AI)',
    type: 'APIProxy',
    typeColor: 'violet',
    note: t('ide_config.guide.kimi_note'),
    badge: null,
    config: kimiConfig,
    expanded: false,
    icon: 'kimi' as const,
    iconVariant: 'mono' as const,
    iconClass: 'shrink-0 dark:invert',
  },
  {
    id: 'minimax',
    name: 'MiniMax',
    type: 'APIProxy',
    typeColor: 'orange',
    note: t('ide_config.guide.minimax_note'),
    badge: null,
    config: minimaxConfig,
    expanded: false,
    icon: 'minimax' as const,
    iconVariant: undefined,
    iconClass: 'shrink-0',
  },
];
---

<div class="glass-card rounded-xl border-amber-200 dark:border-amber-500/30 overflow-hidden" id="provider-configs-section">
  <!-- Section Header (always visible, non-collapsible) -->
  <div class="p-6 bg-gradient-to-r from-amber-500/10 to-yellow-500/10 border-b border-amber-200 dark:border-slate-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center flex-shrink-0">
        <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
        </svg>
      </div>
      <h3 class="text-xl font-bold text-amber-600 dark:text-amber-400">
        {t('ide_config.guide.providers_title')}
      </h3>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 font-mono">5 providers</span>
    </div>
  </div>

  <div class="p-6 space-y-5">
    <p class="text-slate-700 dark:text-slate-300">
      {t('ide_config.guide.providers_desc')}
    </p>

    <!-- Provider type note -->
    <div class="p-4 rounded-lg bg-amber-50/50 dark:bg-amber-900/10 border border-amber-200/50 dark:border-amber-800/30">
      <p class="text-sm text-slate-700 dark:text-slate-300">
        {t('ide_config.guide.providers_note')}
      </p>
    </div>

    <!-- Claude Sub Notification -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800/30">
      <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
      </svg>
      <div class="text-sm text-blue-800 dark:text-blue-300">
        <p class="font-medium mb-1">{t('ide_config.guide.claude_sub_title')}</p>
        <p>{t('ide_config.guide.claude_sub_note')}</p>
      </div>
    </div>

    <!-- Google Ban Warning -->
    <div class="flex items-start gap-3 p-4 rounded-xl bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30">
      <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
      </svg>
      <div class="text-sm text-red-800 dark:text-red-300">
        <p class="font-medium mb-1">{t('ide_config.guide.google_warning_title')}</p>
        <p>{t('ide_config.guide.google_warning_desc')}</p>
      </div>
    </div>

    <!-- Provider cards (each individually collapsible) -->
    <div class="space-y-2">
      {providers.map((p) => {
        const c = colorMap[p.typeColor];
        return (
        <div
          class={`provider-card border rounded-lg overflow-hidden ${c.border}`}
          data-provider={p.id}
        >
          <!-- Clickable header to toggle code snippet -->
          <button
            type="button"
            class={`provider-toggle w-full px-4 py-3 ${c.toggle} text-left transition-colors cursor-pointer flex items-center justify-between gap-3`}
            aria-expanded={p.expanded ? 'true' : 'false'}
          >
            <div class="flex items-center gap-2 min-w-0">
              {p.id === 'glm' && <LLMProviderIcon provider="zai" size={20} class="shrink-0 dark:invert" />}
              {p.id === 'kimi' && <LLMProviderIcon provider="kimi" size={20} variant="mono" class="shrink-0 dark:invert" />}
              {p.id === 'minimax' && <LLMProviderIcon provider="minimax" size={20} class="shrink-0" />}
              {p.id === 'agy' && <LLMProviderIcon provider="gemini" size={20} class="shrink-0" />}
              <h4 class={`font-bold ${c.title} truncate`}>{p.name}</h4>
              <span class={`text-[10px] px-1.5 py-0.5 rounded ${c.badge} font-mono shrink-0`}>{p.type}</span>
              {p.badge && (
                <span class="px-2 py-0.5 text-xs rounded-full bg-amber-500/20 text-amber-600 dark:text-amber-400 font-medium shrink-0">{p.badge.label}</span>
              )}
              <span class={`text-xs ${c.noteDesk} truncate hidden sm:block`}>{p.note}</span>
            </div>
            <!-- Chevron -->
            <svg
              class={`provider-chevron w-4 h-4 ${c.chevron} transition-transform duration-200 flex-shrink-0 ${p.expanded ? 'rotate-180' : ''}`}
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            >
              <polyline points="6 9 12 15 18 9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Note (visible on mobile below header when collapsed) -->
          <div class={`provider-note px-4 py-1.5 text-xs ${c.noteMob} sm:hidden`}>
            {p.note}
          </div>

          <!-- Code block (toggleable) -->
          <div class={`provider-body ${p.expanded ? '' : 'hidden'}`}>
            <div class="relative group">
              <div class="bg-slate-900 p-4 overflow-x-auto">
                <pre class="text-sm text-green-400 whitespace-pre">{p.config}</pre>
              </div>
              <button
                type="button"
                class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
                data-code={p.config}
                title="Copy to clipboard"
              >
                <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
                </svg>
                <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>
      ); })}

      <!-- Alibaba (separate — uses img icon not LLMProviderIcon) -->
      <div class="provider-card border border-teal-200 dark:border-teal-800/50 rounded-lg overflow-hidden" data-provider="alibaba">
        <button
          type="button"
          class="provider-toggle w-full px-4 py-3 bg-teal-50 dark:bg-teal-900/20 text-left hover:bg-teal-100/50 dark:hover:bg-teal-900/30 transition-colors cursor-pointer flex items-center justify-between gap-3"
          aria-expanded="false"
        >
          <div class="flex items-center gap-2 min-w-0">
            <img
              src="https://unpkg.com/@lobehub/icons-static-svg@latest/icons/qwen-color.svg"
              alt="qwen icon"
              width="20"
              height="20"
              class="inline-block shrink-0"
              loading="lazy"
              decoding="async"
            />
            <h4 class="font-bold text-teal-700 dark:text-teal-400 truncate">Alibaba Cloud Coding Plan</h4>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-teal-100 dark:bg-teal-900/30 text-teal-600 dark:text-teal-400 font-mono shrink-0">APIProxy</span>
            <span class="text-xs text-teal-500/70 dark:text-teal-400/60 truncate hidden sm:block">{t('ide_config.guide.alibaba_note')}</span>
          </div>
          <svg
            class="provider-chevron w-4 h-4 text-teal-400 transition-transform duration-200 flex-shrink-0"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="provider-note px-4 py-1.5 text-xs text-teal-600/70 dark:text-teal-400/60 bg-teal-50/50 dark:bg-teal-900/10 sm:hidden">
          {t('ide_config.guide.alibaba_note')}
        </div>
        <div class="provider-body hidden">
          <div class="relative group">
            <div class="bg-slate-900 p-4 overflow-x-auto">
              <pre class="text-sm text-green-400 whitespace-pre">{alibabaConfig}</pre>
            </div>
            <button
              type="button"
              class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
              data-code={alibabaConfig}
              title="Copy to clipboard"
            >
              <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
              </svg>
              <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Toggle individual provider code blocks
  document.querySelectorAll('.provider-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.provider-card');
      if (!card) return;
      const body = card.querySelector('.provider-body');
      const chevron = btn.querySelector('.provider-chevron');
      if (!body || !chevron) return;

      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      body.classList.toggle('hidden', isExpanded);
      (chevron as HTMLElement).style.transform = isExpanded ? '' : 'rotate(180deg)';
    });
  });
</script>
