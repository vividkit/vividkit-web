---
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, useTranslatedPath, type Language } from '@/i18n';
import LLMProviderIcon from '@/components/ui/LLMProviderIcon.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

// Provider config snippets - using placeholders for security
const agyConfig = `// Antigravity (AGY) via CCS (CLIProxy)
{
  "name": "ANTHROPIC_BASE_URL",
  "value": "http://127.0.0.1:8317/api/provider/agy"
},
{
  "name": "ANTHROPIC_AUTH_TOKEN",
  "value": "ccs-internal-managed"
},
{
  "name": "ANTHROPIC_MODEL",
  "value": "gemini-claude-opus-4-6-thinking"
},
{
  "name": "ANTHROPIC_DEFAULT_OPUS_MODEL",
  "value": "gemini-claude-opus-4-6-thinking"
},
{
  "name": "ANTHROPIC_DEFAULT_SONNET_MODEL",
  "value": "gemini-claude-opus-4-6-thinking"
},
{
  "name": "ANTHROPIC_DEFAULT_HAIKU_MODEL",
  "value": "gemini-claude-sonnet-4-5"
}`;

const glmConfig = `// GLM (z.ai) API Proxy
{
  "name": "ANTHROPIC_BASE_URL",
  "value": "https://api.z.ai/api/anthropic"
},
{
  "name": "ANTHROPIC_AUTH_TOKEN",
  "value": "<your_glm_api_key>"
},
{
  "name": "ANTHROPIC_MODEL",
  "value": "glm-5"
}`;

const kimiConfig = `// Kimi (Moonshot AI) API Proxy
{
  "name": "ANTHROPIC_BASE_URL",
  "value": "https://api.kimi.com/coding/"
},
{
  "name": "ANTHROPIC_AUTH_TOKEN",
  "value": "<your_kimi_api_key>"
},
{
  "name": "ANTHROPIC_MODEL",
  "value": "kimi-k2.5"
}`;

const minimaxConfig = `// MiniMax API Proxy
{
  "name": "ANTHROPIC_BASE_URL",
  "value": "https://api.minimax.io/anthropic"
},
{
  "name": "ANTHROPIC_AUTH_TOKEN",
  "value": "<your_minimax_api_key>"
},
{
  "name": "ANTHROPIC_MODEL",
  "value": "MiniMax-M2.5"
}`;

const fullExample = `"claudeCode.environmentVariables": [
  {"name": "MAX_THINKING_TOKENS", "value": "32000"},

  // ${t('ide_config.guide.step2_comment_example')}
  // ${t('ide_config.guide.step2_comment_see_providers')}
  {"name": "ANTHROPIC_BASE_URL", "value": "http://127.0.0.1:8317/api/provider/agy"},
  {"name": "ANTHROPIC_AUTH_TOKEN", "value": "ccs-internal-managed"},
  {"name": "ANTHROPIC_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_OPUS_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_SONNET_MODEL", "value": "gemini-claude-opus-4-6-thinking"},
  {"name": "ANTHROPIC_DEFAULT_HAIKU_MODEL", "value": "gemini-claude-sonnet-4-5"}
]`;
---

<div class="space-y-8 mt-6">
  <!-- Hero Section -->
  <div class="text-center space-y-4">
    <h2 class="text-4xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('ide_config.guide.title')}
    </h2>
    <p class="text-xl font-medium text-blue-600 dark:text-blue-400">
      {t('ide_config.guide.tagline')}
    </p>
    <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
      {t('ide_config.guide.description')}
    </p>
  </div>

  <!-- Important Note -->
  <div class="flex items-start gap-3 p-4 rounded-xl bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800/30 max-w-2xl mx-auto">
    <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
    </svg>
    <p class="text-sm text-amber-800 dark:text-amber-300 font-medium">
      {t('ide_config.guide.important_note')}
    </p>
  </div>


  <!-- Supported IDEs -->
  <div class="glass-card rounded-xl border-blue-200 dark:border-blue-500/30 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-blue-500/10 to-cyan-500/10 border-b border-blue-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-blue-600 dark:text-blue-400">
          {t('ide_config.guide.supported_ides_title')}
        </h3>
      </div>
    </div>
    <div class="p-6">
      <p class="text-slate-700 dark:text-slate-300 mb-4">
        {t('ide_config.guide.supported_ides_desc')}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-800/50">
          <svg class="w-7 h-7 shrink-0" viewBox="0 0 32 32">
            <path fill="#0065a9" d="m29.01 5.03l-5.766-2.776a1.74 1.74 0 0 0-1.989.338L2.38 19.8a1.166 1.166 0 0 0-.08 1.647q.037.04.077.077l1.541 1.4a1.165 1.165 0 0 0 1.489.066L28.142 5.75A1.158 1.158 0 0 1 30 6.672v-.067a1.75 1.75 0 0 0-.99-1.575"/>
            <path fill="#007acc" d="m29.01 26.97l-5.766 2.777a1.745 1.745 0 0 1-1.989-.338L2.38 12.2a1.166 1.166 0 0 1-.08-1.647q.037-.04.077-.077l1.541-1.4A1.165 1.165 0 0 1 5.41 9.01l22.732 17.24A1.158 1.158 0 0 0 30 25.328v.072a1.75 1.75 0 0 1-.99 1.57"/>
            <path fill="#1f9cf0" d="M23.244 29.747a1.745 1.745 0 0 1-1.989-.338A1.025 1.025 0 0 0 23 28.684V3.316a1.024 1.024 0 0 0-1.749-.724a1.74 1.74 0 0 1 1.989-.339l5.765 2.772A1.75 1.75 0 0 1 30 6.6v18.8a1.75 1.75 0 0 1-.991 1.576Z"/>
          </svg>
          <div>
            <div class="font-semibold text-slate-900 dark:text-white">VS Code</div>
            <div class="text-xs text-slate-500">{t('ide_config.guide.official')}</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-800/50">
          <LLMProviderIcon provider="cursor" size={28} variant="mono" class="shrink-0 dark:invert" />
          <div>
            <div class="font-semibold text-slate-900 dark:text-white">Cursor</div>
            <div class="text-xs text-slate-500">VS Code fork</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-800/50">
          <LLMProviderIcon provider="windsurf" size={28} variant="mono" class="shrink-0 dark:invert" />
          <div>
            <div class="font-semibold text-slate-900 dark:text-white">Windsurf</div>
            <div class="text-xs text-slate-500">VS Code fork</div>
          </div>
        </div>
        <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 dark:bg-slate-800/50">
          <LLMProviderIcon provider="google" size={28} class="shrink-0" />
          <div>
            <div class="font-semibold text-slate-900 dark:text-white">Google Antigravity</div>
            <div class="text-xs text-slate-500">VS Code fork</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <div class="glass-card rounded-xl border-emerald-200 dark:border-emerald-500/30 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-emerald-500/10 to-teal-500/10 border-b border-emerald-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 6V2m0 20v-4m6-6h4M2 12h4m12.485-4.485l2.828-2.828M4.687 19.313l2.828-2.828m0-9.97L4.687 4.687m14.626 14.626l-2.828-2.828"/>
            <circle cx="12" cy="12" r="4"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-emerald-600 dark:text-emerald-400">
          {t('ide_config.guide.how_it_works_title')}
        </h3>
      </div>
    </div>
    <div class="p-6 space-y-4">
      <p class="text-slate-700 dark:text-slate-300">
        {t('ide_config.guide.how_it_works_desc')}
      </p>
      <div class="space-y-3">
        <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50/50 dark:bg-emerald-900/10 border border-emerald-200/50 dark:border-emerald-800/30">
          <span class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">1</span>
          <div>
            <span class="font-mono text-sm text-slate-800 dark:text-slate-200">ANTHROPIC_BASE_URL</span>
            <span class="text-slate-600 dark:text-slate-400 text-sm"> — {t('ide_config.guide.env_base_url')}</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50/50 dark:bg-emerald-900/10 border border-emerald-200/50 dark:border-emerald-800/30">
          <span class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">2</span>
          <div>
            <span class="font-mono text-sm text-slate-800 dark:text-slate-200">ANTHROPIC_AUTH_TOKEN</span>
            <span class="text-slate-600 dark:text-slate-400 text-sm"> — {t('ide_config.guide.env_auth_token')}</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50/50 dark:bg-emerald-900/10 border border-emerald-200/50 dark:border-emerald-800/30">
          <span class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">3</span>
          <div>
            <span class="font-mono text-sm text-slate-800 dark:text-slate-200">ANTHROPIC_MODEL</span>
            <span class="text-slate-600 dark:text-slate-400 text-sm"> — {t('ide_config.guide.env_model')}</span>
          </div>
        </div>
        <div class="flex items-start gap-3 p-3 rounded-lg bg-emerald-50/50 dark:bg-emerald-900/10 border border-emerald-200/50 dark:border-emerald-800/30">
          <span class="font-bold text-emerald-600 dark:text-emerald-400 mt-0.5">4</span>
          <div>
            <span class="font-mono text-sm text-slate-800 dark:text-slate-200">ANTHROPIC_DEFAULT_*_MODEL</span>
            <span class="text-slate-600 dark:text-slate-400 text-sm"> — {t('ide_config.guide.env_default_models')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Setup Steps -->
  <div class="glass-card rounded-xl border-violet-200 dark:border-violet-500/30 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-violet-500/10 to-purple-500/10 border-b border-violet-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-violet-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-violet-600 dark:text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12M8.25 17.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-violet-600 dark:text-violet-400">
          {t('ide_config.guide.setup_title')}
        </h3>
      </div>
    </div>
    <div class="p-6 space-y-4">
      <!-- Step 1 -->
      <div class="relative pl-8">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-violet-200 dark:bg-violet-800/50"></div>
        <div class="absolute left-[-4px] top-2 w-2 h-2 rounded-full bg-violet-400 border border-white dark:border-slate-900"></div>
        <div class="mb-1">
          <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">{t('ide_config.guide.step1_title')}</span>
          <span class="text-slate-500 text-xs ml-2">— {t('ide_config.guide.step1_desc')}</span>
        </div>
        <div class="bg-slate-900 rounded-lg p-3 overflow-x-auto">
          <code class="text-sm text-green-400 whitespace-pre">Cmd/Ctrl + Shift + P → "Preferences: Open User Settings (JSON)"</code>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative pl-8">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-violet-200 dark:bg-violet-800/50"></div>
        <div class="absolute left-[-4px] top-2 w-2 h-2 rounded-full bg-violet-400 border border-white dark:border-slate-900"></div>
        <div class="mb-1">
          <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">{t('ide_config.guide.step2_title')}</span>
          <span class="text-slate-500 text-xs ml-2">— {t('ide_config.guide.step2_desc')}</span>
        </div>
        <div class="bg-slate-900 rounded-lg p-3 overflow-x-auto">
          <pre class="text-sm text-green-400 whitespace-pre">{fullExample}</pre>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative pl-8">
        <div class="absolute left-0 top-0 bottom-0 w-px bg-violet-200 dark:bg-violet-800/50"></div>
        <div class="absolute left-[-4px] top-2 w-2 h-2 rounded-full bg-violet-400 border border-white dark:border-slate-900"></div>
        <div class="mb-1">
          <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">{t('ide_config.guide.step3_title')}</span>
          <span class="text-slate-500 text-xs ml-2">— {t('ide_config.guide.step3_desc')}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Provider Configs -->
  <div class="glass-card rounded-xl border-amber-200 dark:border-amber-500/30 overflow-hidden">
    <div class="p-6 bg-gradient-to-r from-amber-500/10 to-yellow-500/10 border-b border-amber-200 dark:border-slate-800">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-amber-500/20 flex items-center justify-center">
          <svg class="w-6 h-6 text-amber-600 dark:text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-amber-600 dark:text-amber-400">
          {t('ide_config.guide.providers_title')}
        </h3>
      </div>
    </div>
    <div class="p-6 space-y-6">
      <p class="text-slate-700 dark:text-slate-300">
        {t('ide_config.guide.providers_desc')}
      </p>

      <!-- Provider type note -->
      <div class="p-4 rounded-lg bg-amber-50/50 dark:bg-amber-900/10 border border-amber-200/50 dark:border-amber-800/30">
        <p class="text-sm text-slate-700 dark:text-slate-300">
          {t('ide_config.guide.providers_note')}
        </p>
      </div>

      <!-- Claude Sub Notification -->
      <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800/30">
        <svg class="w-5 h-5 text-blue-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
        </svg>
        <div class="text-sm text-blue-800 dark:text-blue-300">
          <p class="font-medium mb-1">{t('ide_config.guide.claude_sub_title')}</p>
          <p>{t('ide_config.guide.claude_sub_note')}</p>
        </div>
      </div>

      <!-- Google Ban Warning -->
      <div class="flex items-start gap-3 p-4 rounded-xl bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30">
        <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
        </svg>
        <div class="text-sm text-red-800 dark:text-red-300">
          <p class="font-medium mb-1">{t('ide_config.guide.google_warning_title')}</p>
          <p>{t('ide_config.guide.google_warning_desc')}</p>
        </div>
      </div>

      <!-- AGY via CCS -->
      <div class="border border-purple-200 dark:border-purple-800/50 rounded-lg overflow-hidden">
        <div class="px-4 py-3 bg-purple-50 dark:bg-purple-900/20 border-b border-purple-200 dark:border-purple-800/50">
          <div class="flex items-center gap-2">
            <LLMProviderIcon provider="gemini" size={20} class="shrink-0" />
            <h4 class="font-bold text-purple-700 dark:text-purple-400">Antigravity (AGY) via CCS</h4>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400 font-mono">CLIProxy</span>
          </div>
          <p class="text-xs text-purple-600/70 dark:text-purple-400/70 mt-1">{t('ide_config.guide.agy_note')}</p>
        </div>
        <div class="relative group">
          <div class="bg-slate-900 p-4 overflow-x-auto">
            <pre class="text-sm text-green-400 whitespace-pre" id="agy-config">{agyConfig}</pre>
          </div>
          <button
            type="button"
            class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
            data-code={agyConfig}
            title="Copy to clipboard"
          >
            <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
            </svg>
            <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- GLM -->
      <div class="border border-blue-200 dark:border-blue-800/50 rounded-lg overflow-hidden">
        <div class="px-4 py-3 bg-blue-50 dark:bg-blue-900/20 border-b border-blue-200 dark:border-blue-800/50">
          <div class="flex items-center gap-2">
            <LLMProviderIcon provider="zai" size={20} class="shrink-0 dark:invert" />
            <h4 class="font-bold text-blue-700 dark:text-blue-400">GLM (z.ai)</h4>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-mono">APIProxy</span>
          </div>
          <p class="text-xs text-blue-600/70 dark:text-blue-400/70 mt-1">{t('ide_config.guide.glm_note')}</p>
        </div>
        <div class="relative group">
          <div class="bg-slate-900 p-4 overflow-x-auto">
            <pre class="text-sm text-green-400 whitespace-pre" id="glm-config">{glmConfig}</pre>
          </div>
          <button
            type="button"
            class="copy-btn absolute top-2 right-2 p-1.5 rounded-md bg-slate-200/80 dark:bg-slate-700/80 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity duration-200 z-10"
            data-code={glmConfig}
            title="Copy to clipboard"
          >
            <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
            </svg>
            <svg class="w-3.5 h-3.5 check-icon hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Kimi -->
      <div class="border border-violet-200 dark:border-violet-800/50 rounded-lg overflow-hidden">
