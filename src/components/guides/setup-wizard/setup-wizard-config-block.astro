---
// Setup Wizard — Config Block
// Renders ONE resolved snippet: title, code block, env vars, copy button, CTA.
// Pure Astro: no store coupling. Accepts snippet via props.

import type { ResolvedSnippet } from '@/scripts/setup-wizard/resolve-config-snippets';

interface Props {
  snippet: ResolvedSnippet;
}

const { snippet } = Astro.props;
const commandsText = snippet.commands.join('\n');
const hasEnv = snippet.env && Object.keys(snippet.env).length > 0;
const envText = hasEnv
  ? Object.entries(snippet.env!)
      .map(([k, v]) => `export ${k}="${v}"`)
      .join('\n')
  : '';
---

<div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden mb-4">
  {/* Header */}
  <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">
      {snippet.title}
    </span>
    {snippet.missing && (
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 font-medium">
        Coming soon
      </span>
    )}
  </div>

  {snippet.missing ? (
    {/* Missing / Coming soon variant */}
    <div class="px-4 py-5 bg-slate-50 dark:bg-slate-900/50">
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Setup guide for <strong class="text-slate-700 dark:text-slate-200">{snippet.title}</strong> is coming soon.
        In the meantime, check the{' '}
        <a
          href={snippet.guide_link}
          class="underline text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors"
        >
          general guide
        </a>
        .
      </p>
    </div>
  ) : (
    <div class="bg-slate-100 dark:bg-slate-800/90 p-4 space-y-3">
      {/* Commands block */}
      {snippet.commands.length > 0 && (
        <div
          x-data={`{ copied: false, copyText: ${JSON.stringify(commandsText)} }`}
          class="relative group"
        >
          <pre class="text-sm leading-relaxed overflow-x-auto pr-10"><code>{snippet.commands.map((cmd, i) => (
            <span key={i} class="block">
              <span class="select-none text-slate-400 dark:text-slate-500 mr-2">$</span>
              <span class="text-purple-600 dark:text-purple-400">{cmd}</span>
            </span>
          ))}</code></pre>

          {/* Copy button */}
          <button
            x-on:click={`navigator.clipboard.writeText(copyText).then(() => { copied = true; setTimeout(() => copied = false, 2000) })`}
            class="absolute top-0 right-0 p-1.5 rounded text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            aria-label="Copy commands"
            title="Copy to clipboard"
          >
            <span x-show="!copied" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </span>
            <span x-show="copied" class="text-green-500 dark:text-green-400 text-xs font-medium">✓</span>
          </button>
        </div>
      )}

      {/* Env vars block */}
      {hasEnv && (
        <div
          x-data={`{ copied: false, copyText: ${JSON.stringify(envText)} }`}
          class="relative group"
        >
          <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1">
            Environment variables
          </p>
          <pre class="text-sm leading-relaxed overflow-x-auto pr-10"><code>{Object.entries(snippet.env!).map(([k, v]) => (
            <span class="block">
              <span class="text-slate-600 dark:text-slate-300">{k}</span>
              <span class="text-slate-400 dark:text-slate-500">=</span>
              <span class="text-purple-600 dark:text-purple-400">"{v}"</span>
            </span>
          ))}</code></pre>

          <button
            x-on:click={`navigator.clipboard.writeText(copyText).then(() => { copied = true; setTimeout(() => copied = false, 2000) })`}
            class="absolute top-0 right-0 p-1.5 rounded text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
            aria-label="Copy env vars"
            title="Copy to clipboard"
          >
            <span x-show="!copied" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
            </span>
            <span x-show="copied" class="text-green-500 dark:text-green-400 text-xs font-medium">✓</span>
          </button>
        </div>
      )}
    </div>
  )}

  {/* Notes */}
  {!snippet.missing && snippet.notes && (
    <div class="px-4 py-2.5 bg-amber-50 dark:bg-amber-900/20 border-t border-amber-100 dark:border-amber-800/40">
      <p class="text-xs text-amber-700 dark:text-amber-300">{snippet.notes}</p>
    </div>
  )}
</div>
