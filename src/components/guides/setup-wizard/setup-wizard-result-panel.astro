---
// Setup Wizard — Result Panel
// Renders when step === 'result' in wizard root.
// Registers Alpine component `resultPanel()` that reads parent wizard state
// via Alpine.closestDataStack() and resolves config snippets client-side.
// Renders: summary card + N config blocks + CTA links.
---

<script>
  import { resolveSnippets } from '@/scripts/setup-wizard/resolve-config-snippets';
  import { PROVIDERS } from '@/data/guides/setup-wizard/providers';
  import { TOOLS } from '@/data/guides/setup-wizard/tools';

  // Guide CTA config per routing/tool-type combo
  const GUIDE_LINKS: Record<string, { href: string; label: string }[]> = {
    ccs: [{ href: '/guides/ccs', label: 'Xem hướng dẫn CCS đầy đủ →' }],
    ide: [{ href: '/guides/ide-config', label: 'Xem hướng dẫn IDE Config →' }],
    cli: [{ href: '/guides/cli', label: 'Xem hướng dẫn CLI →' }],
    both: [
      { href: '/guides/cli', label: 'Xem hướng dẫn CLI →' },
      { href: '/guides/ide-config', label: 'Xem hướng dẫn IDE Config →' },
    ],
  };

  document.addEventListener('alpine:init', () => {
    // @ts-ignore — Alpine global registered at runtime
    window.Alpine.data('resultPanel', () => ({
      snippets: [] as ReturnType<typeof resolveSnippets>,
      summary: { providerNames: '', routing: '', toolNames: '' },
      ctaLinks: [] as { href: string; label: string }[],
      copiedIndex: -1,

      init() {
        // Read parent wizard state by walking up Alpine data stack
        // Alpine v3: closestDataStack returns merged data objects from ancestors
        const stack = (window as any).Alpine.closestDataStack(this.$el);
        // stack[0] = self, stack[1] = parent setupWizard scope
        const parentData = stack.find(
          (d: any) => d.subs !== undefined && d.routing !== undefined
        );
        if (!parentData) return;

        const state = {
          step: parentData.step,
          subs: parentData.subs ?? [],
          routing: parentData.routing,
          toolType: parentData.toolType,
          tools: parentData.tools ?? [],
        };

        this.snippets = resolveSnippets(state);

        // Build summary strings
        this.summary.providerNames =
          state.subs
            .map((id: string) => PROVIDERS.find((p) => p.id === id)?.name ?? id)
            .join(', ') || '—';

        this.summary.routing =
          state.routing === 'ccs' ? 'CCS (Claude Code Switch)' : 'Manual';

        this.summary.toolNames =
          state.tools
            .map((id: string) => TOOLS.find((t) => t.id === id)?.name ?? id)
            .join(', ') || '—';

        // Determine CTA links
        if (state.routing === 'ccs') {
          this.ctaLinks = GUIDE_LINKS.ccs;
        } else if (state.toolType === 'ide') {
          this.ctaLinks = GUIDE_LINKS.ide;
        } else if (state.toolType === 'cli') {
          this.ctaLinks = GUIDE_LINKS.cli;
        } else {
          this.ctaLinks = GUIDE_LINKS.both;
        }
      },

      copySnippet(idx: number) {
        const snippet = this.snippets[idx];
        if (!snippet) return;
        const text = snippet.commands.join('\n');
        navigator.clipboard.writeText(text).then(() => {
          this.copiedIndex = idx;
          setTimeout(() => (this.copiedIndex = -1), 2000);
        });
      },
    }));
  });
</script>

<div x-data="resultPanel()" x-init="init()">
  {/* ── Summary card ─────────────────────────────────────────────────────── */}
  <div class="rounded-xl border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-900/20 px-4 py-3 mb-5 space-y-1">
    <p class="text-sm font-semibold text-teal-800 dark:text-teal-200">Bạn đã chọn:</p>
    <ul class="text-sm text-slate-700 dark:text-slate-300 space-y-0.5 list-disc list-inside">
      <li>Nhà cung cấp: <span class="font-medium" x-text="summary.providerNames"></span></li>
      <li>Routing: <span class="font-medium" x-text="summary.routing"></span></li>
      <li x-show="summary.toolNames !== '—'">
        Công cụ: <span class="font-medium" x-text="summary.toolNames"></span>
      </li>
    </ul>
  </div>

  {/* ── Config blocks (dynamic, replicate config-block UI) ───────────────── */}
  <template x-if="snippets.length > 0">
    <div class="space-y-4">
      <template x-for="(snippet, idx) in snippets" :key="snippet.key">
        <div class="rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
          {/* Block header */}
          <div class="flex items-center justify-between px-4 py-2.5 bg-slate-50 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200" x-text="snippet.title"></span>
            <span
              x-show="snippet.missing"
              class="text-xs px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-300 font-medium"
            >Coming soon</span>
          </div>

          {/* Missing snippet: "Coming soon" UI */}
          <div x-show="snippet.missing" class="px-4 py-5 bg-slate-50 dark:bg-slate-900/50">
            <p class="text-sm text-slate-500 dark:text-slate-400">
              Setup guide for <strong class="text-slate-700 dark:text-slate-200" x-text="snippet.title"></strong>
              is coming soon. In the meantime, check the&nbsp;
              <a
                :href="snippet.guide_link"
                class="underline text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors"
              >general guide</a>.
            </p>
          </div>

          {/* Commands code block */}
          <div x-show="!snippet.missing" class="bg-slate-100 dark:bg-slate-800/90 p-4 space-y-3">
            <div x-show="snippet.commands && snippet.commands.length > 0" class="relative group">
              <pre class="text-sm leading-relaxed overflow-x-auto pr-10"><code>
                <template x-for="cmd in snippet.commands" :key="cmd">
                  <span class="block">
                    <span class="select-none text-slate-400 dark:text-slate-500 mr-2">$</span>
                    <span class="text-purple-600 dark:text-purple-400" x-text="cmd"></span>
                  </span>
                </template>
              </code></pre>
              {/* Copy button */}
              <button
                x-on:click="copySnippet(idx)"
                class="absolute top-0 right-0 p-1.5 rounded text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
                aria-label="Copy commands"
                title="Copy to clipboard"
              >
                <span x-show="copiedIndex !== idx" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                </span>
                <span x-show="copiedIndex === idx" class="text-green-500 dark:text-green-400 text-xs font-medium">✓</span>
              </button>
            </div>

            {/* Env vars */}
            <div x-show="snippet.env && Object.keys(snippet.env).length > 0" class="pt-1">
              <p class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide mb-1">Environment variables</p>
              <pre class="text-sm leading-relaxed overflow-x-auto"><code>
                <template x-for="[k, v] in Object.entries(snippet.env ?? {})" :key="k">
                  <span class="block">
                    <span class="text-slate-600 dark:text-slate-300" x-text="k"></span>
                    <span class="text-slate-400 dark:text-slate-500">=</span>
                    <span class="text-purple-600 dark:text-purple-400">"<span x-text="v"></span>"</span>
                  </span>
                </template>
              </code></pre>
            </div>
          </div>

          {/* Notes */}
          <div
            x-show="!snippet.missing && snippet.notes"
            class="px-4 py-2.5 bg-amber-50 dark:bg-amber-900/20 border-t border-amber-100 dark:border-amber-800/40"
          >
            <p class="text-xs text-amber-700 dark:text-amber-300" x-text="snippet.notes"></p>
          </div>
        </div>
      </template>
    </div>
  </template>

  {/* ── Empty state ───────────────────────────────────────────────────────── */}
  <template x-if="snippets.length === 0">
    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 px-5 py-6 text-center space-y-3">
      <p class="text-sm text-slate-500 dark:text-slate-400">Không có config nào khớp với lựa chọn của bạn.</p>
      <a
        href="/guides"
        class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium bg-purple-600 text-white hover:bg-purple-700 dark:bg-purple-500 dark:hover:bg-purple-400 transition-colors"
      >
        Xem tất cả hướng dẫn →
      </a>
    </div>
  </template>

  {/* ── CTA links ─────────────────────────────────────────────────────────── */}
  <div x-show="ctaLinks.length > 0" class="flex flex-wrap gap-2 mt-5">
    <template x-for="cta in ctaLinks" :key="cta.href">
      <a
        :href="cta.href"
        class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium border border-purple-300 dark:border-purple-700 text-purple-700 dark:text-purple-300 hover:bg-purple-50 dark:hover:bg-purple-900/30 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-500"
        x-text="cta.label"
      ></a>
    </template>
  </div>
</div>
