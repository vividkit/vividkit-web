---
import { Check, CheckCircle2, Copy, ExternalLink } from 'lucide-astro';
import { getLangFromUrl, type Language } from '@/i18n';
import { cursorArticles, tCursor, type CursorArticleBlock, type CursorTopicSlug } from '@/data/guides/cursor';
import CursorArticleShell from './cursor-article-shell.astro';

interface Props {
  slug: CursorTopicSlug;
  lang?: Language;
}

const { slug, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const article = cursorArticles[slug];

const toneClasses = {
  info: 'border-sky-200 bg-sky-50 text-sky-900 dark:border-sky-900/60 dark:bg-sky-950/30 dark:text-sky-100',
  warning: 'border-amber-200 bg-amber-50 text-amber-950 dark:border-amber-900/60 dark:bg-amber-950/30 dark:text-amber-100',
  success: 'border-emerald-200 bg-emerald-50 text-emerald-950 dark:border-emerald-900/60 dark:bg-emerald-950/30 dark:text-emerald-100',
};
---

<CursorArticleShell
  title={article.title}
  summary={article.summary}
  kicker={article.kicker}
  slug={article.slug}
  lang={currentLang}
>
  {article.blocks.map((block: CursorArticleBlock) => {
    if (block.type === 'playbook') {
      return (
        <section class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
          <div class="mb-4 flex items-center gap-2">
            <CheckCircle2 class="h-5 w-5 text-emerald-600 dark:text-emerald-400" />
            <h2 class="text-xl font-semibold text-slate-900 dark:text-white">{tCursor(block.title, currentLang)}</h2>
          </div>
          <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
            {block.items.map((item, index) => (
              <div class:list={[
                'grid gap-3 p-4 md:grid-cols-[minmax(0,10rem)_minmax(0,1.1fr)_minmax(0,0.9fr)]',
                index > 0 && 'border-t border-slate-200 dark:border-slate-800',
              ]}>
                <div>
                  <span class="inline-flex rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
                    {tCursor(item.step, currentLang)}
                  </span>
                  <code class="mt-2 block whitespace-normal break-words rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-700 dark:bg-slate-800/90 dark:text-slate-200">
                    {item.file}
                  </code>
                </div>
                <p class="text-sm leading-6 text-slate-700 dark:text-slate-300">{tCursor(item.action, currentLang)}</p>
                <p class="text-sm leading-6 text-emerald-700 dark:text-emerald-300">{tCursor(item.verify, currentLang)}</p>
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (block.type === 'paragraph') {
      return (
        <p class="text-base leading-8 text-slate-700 dark:text-slate-300">
          {tCursor(block.text, currentLang)}
        </p>
      );
    }

    if (block.type === 'bullets') {
      return (
        <ul class="grid gap-3">
          {block.items.map((item) => (
            <li class="rounded-xl border border-slate-200/70 bg-white p-4 text-sm leading-6 text-slate-700 dark:border-slate-800 dark:bg-slate-900/70 dark:text-slate-300">
              {tCursor(item, currentLang)}
            </li>
          ))}
        </ul>
      );
    }

    if (block.type === 'schema') {
      return (
        <section class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
          <h2 class="mb-4 text-xl font-semibold text-slate-900 dark:text-white">{tCursor(block.title, currentLang)}</h2>
          <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800">
            {block.rows.map((row, index) => (
              <div class:list={[
                'grid gap-3 p-4 md:grid-cols-[minmax(0,14rem)_1fr]',
                index > 0 && 'border-t border-slate-200 dark:border-slate-800',
              ]}>
                <code class="whitespace-normal break-words rounded-lg bg-slate-100 px-2 py-1 text-xs text-slate-700 dark:bg-slate-800/90 dark:text-slate-200">
                  {row.key}
                </code>
                <p class="text-sm leading-6 text-slate-700 dark:text-slate-300">{tCursor(row.value, currentLang)}</p>
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (block.type === 'code') {
      return (
        <section class="rounded-xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
          <div class="mb-4 flex items-center justify-between gap-3">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-white">{tCursor(block.title, currentLang)}</h2>
            <button
              type="button"
              data-copy-code={block.code}
              class="cursor-copy-button inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-500 transition-colors hover:border-slate-300 hover:text-slate-900 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-white"
              aria-label={currentLang === 'vi' ? 'Copy snippet' : 'Copy snippet'}
            >
              <Copy class="copy-icon h-4 w-4" />
              <Check class="check-icon hidden h-4 w-4 text-emerald-600 dark:text-emerald-400" />
            </button>
          </div>
          <pre class="overflow-x-auto rounded-lg border border-slate-200 bg-slate-100 p-4 text-xs leading-6 text-slate-700 dark:border-slate-800 dark:bg-slate-800/90 dark:text-slate-200"><code>{block.code}</code></pre>
        </section>
      );
    }

    if (block.type === 'callout') {
      return (
        <aside class:list={[
          'rounded-2xl border p-5',
          toneClasses[block.tone],
        ]}>
          <h2 class="mb-2 text-lg font-semibold">{tCursor(block.title, currentLang)}</h2>
          <p class="text-sm leading-7">{tCursor(block.text, currentLang)}</p>
        </aside>
      );
    }
  })}

  <section class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
    <h2 class="mb-4 text-xl font-semibold text-slate-900 dark:text-white">
      {currentLang === 'vi' ? 'Nguồn chính thức' : 'Official sources'}
    </h2>
    <div class="grid gap-3">
      {article.sources.map((source) => (
        <a href={source.url} class="group flex items-start justify-between gap-4 rounded-xl border border-slate-200/70 p-4 transition-colors hover:border-sky-300 dark:border-slate-800 dark:hover:border-sky-700">
          <div>
            <div class="text-sm font-semibold text-slate-900 dark:text-white">{source.label}</div>
            <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">{tCursor(source.note, currentLang)}</p>
          </div>
          <ExternalLink class="mt-0.5 h-4 w-4 shrink-0 text-slate-400 transition-colors group-hover:text-sky-500" />
        </a>
      ))}
    </div>
  </section>
</CursorArticleShell>

<script>
  function initCursorCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
      if (button.dataset.copyReady === 'true') return;
      button.dataset.copyReady = 'true';
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-copy-code');
        if (!code) return;
        await navigator.clipboard.writeText(code);
        button.querySelector('.copy-icon')?.classList.add('hidden');
        button.querySelector('.check-icon')?.classList.remove('hidden');
        window.setTimeout(() => {
          button.querySelector('.copy-icon')?.classList.remove('hidden');
          button.querySelector('.check-icon')?.classList.add('hidden');
        }, 1600);
      });
    });
  }

  document.addEventListener('astro:page-load', initCursorCopyButtons);
  document.addEventListener('DOMContentLoaded', initCursorCopyButtons);
</script>
