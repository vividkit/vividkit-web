---
import type { Language } from '@/i18n';
import { getAgentKitTargetViews } from '@/data/guides/agentkit/agentkit-target-capabilities';
import TerminalSnippet from '../TerminalSnippet.astro';
interface Props { lang: Language }
const { lang } = Astro.props;
const isVi = lang === 'vi';
const targets = getAgentKitTargetViews();
---

<section id="supported-targets" class="scroll-mt-28 space-y-5">
  <div><p class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-400">Verified {targets[0].channel} targets · {targets[0].verifiedAt}</p><h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Target được tài liệu chính thức xác nhận' : 'Targets confirmed by official documentation'}</h2></div>
  <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700">
    <table class="min-w-full divide-y divide-slate-200 text-left text-sm dark:divide-slate-700">
      <thead class="bg-slate-100 text-slate-700 dark:bg-slate-800/90 dark:text-slate-200"><tr><th class="px-4 py-3">Target</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Invocation</th></tr></thead>
      <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-800 dark:bg-slate-950">
        {targets.map((target) => (
          <tr>
            <td class="px-4 py-3 font-semibold">{target.displayName}</td>
            <td class="px-4 py-3 capitalize text-emerald-700 dark:text-emerald-300">{target.status} · {target.channel}</td>
            <td class="px-4 py-3"><code class="rounded-md border border-slate-200 bg-slate-100 px-1.5 py-0.5 text-slate-800 dark:border-slate-700 dark:bg-slate-800/90 dark:text-slate-100">{target.invocationWildcard}</code> {target.invocationDescription}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="grid gap-4 lg:grid-cols-2">
    {targets.map((target) => (
      <TerminalSnippet code={target.installCommand} label={`${target.displayName} · review project scope`} copyable={target.installCopyable} />
    ))}
  </div>
  <p class="rounded-2xl border border-slate-200 bg-slate-50 p-4 text-sm leading-6 text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">{isVi ? 'Các provider khác chỉ được hiển thị khi có source, channel và status rõ. VividKit không cung cấp copy button cho target chưa xác minh.' : 'Other providers appear only with explicit source, channel, and status. VividKit does not expose copy buttons for unverified targets.'}</p>
</section>
