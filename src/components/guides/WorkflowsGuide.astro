---
// WorkflowsGuide - composition parent, delegates to sub-components
import { stableWorkflows as stableWorkflowsEn, betaWorkflows as betaWorkflowsEn } from '@/data/guides/workflows';
import { stableWorkflows as stableWorkflowsVi, betaWorkflows as betaWorkflowsVi } from '@/data/vi/guides/workflows';
import { getLangFromUrl, type Language } from '@/i18n';
import WorkflowsHeaderAndVersionToggle from './workflows/workflows-header-and-version-toggle.astro';
import WorkflowsStableSection from './workflows/workflows-stable-section.astro';
import WorkflowsBetaSection from './workflows/workflows-beta-section.astro';
import WorkflowsProTipsAndNavigation from './workflows/workflows-pro-tips-and-navigation.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

const stableWorkflows = currentLang === 'vi' ? stableWorkflowsVi : stableWorkflowsEn;
const betaWorkflows = currentLang === 'vi' ? betaWorkflowsVi : betaWorkflowsEn;
---

<style>
  @keyframes flow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  .flow-arrow {
    animation: flow 2s ease-in-out infinite;
  }
</style>

<div class="space-y-8 mt-6">
  <WorkflowsHeaderAndVersionToggle lang={currentLang} />

  <!-- Engineer Kit Content -->
  <div id="wf-engineer-content">
    <WorkflowsStableSection workflows={stableWorkflows} lang={currentLang} />
    <WorkflowsBetaSection workflows={betaWorkflows} lang={currentLang} />
    <WorkflowsProTipsAndNavigation lang={currentLang} />
  </div>

  <!-- Marketing Kit Content (Coming Soon Placeholder) -->
  <div id="wf-marketing-content" class="hidden">
    <div class="rounded-2xl border-2 border-dashed border-purple-300 dark:border-purple-700 bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 p-12 text-center">
      <div class="max-w-md mx-auto space-y-4">
        <div class="w-16 h-16 mx-auto rounded-full bg-purple-100 dark:bg-purple-900/50 flex items-center justify-center">
          <svg class="w-8 h-8 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 3a2.83 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-purple-700 dark:text-purple-300">
          {currentLang === 'vi' ? 'Marketing Kit - Sắp Ra Mắt' : 'Marketing Kit - Coming Soon'}
        </h3>
        <p class="text-slate-600 dark:text-slate-400">
          {currentLang === 'vi'
            ? 'Các quy trình mẫu cho Marketing Kit đang được xây dựng. Trong khi chờ đợi, hãy xem Commands Guide để khám phá tất cả marketing commands.'
            : 'Sample workflows for Marketing Kit are under construction. In the meantime, check out the Commands Guide to explore all marketing commands.'}
        </p>
        <a
          href={currentLang === 'vi' ? '/vi/guides/commands' : '/guides/commands'}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-purple-500 hover:bg-purple-600 text-white font-medium transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
          {currentLang === 'vi' ? 'Xem Commands Guide' : 'View Commands Guide'}
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Kit toggle functionality for workflows (Engineer / Marketing)
  document.addEventListener('DOMContentLoaded', () => {
    const btnEngineer = document.getElementById('wf-btn-engineer');
    const btnMarketing = document.getElementById('wf-btn-marketing');
    const engineerContent = document.getElementById('wf-engineer-content');
    const marketingContent = document.getElementById('wf-marketing-content');

    if (!btnEngineer || !btnMarketing || !engineerContent || !marketingContent) return;

    const activeClasses = 'bg-teal-500 text-white shadow-sm';
    const inactiveClasses = 'text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
    const activeMarketingClasses = 'bg-purple-500 text-white shadow-sm';

    function setKit(kit: 'engineer' | 'marketing') {
      if (kit === 'engineer') {
        engineerContent.classList.remove('hidden');
        marketingContent.classList.add('hidden');
        btnEngineer.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeClasses}`;
        btnMarketing.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      } else {
        engineerContent.classList.add('hidden');
        marketingContent.classList.remove('hidden');
        btnMarketing.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeMarketingClasses}`;
        btnEngineer.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      }
      localStorage.setItem('workflows-kit', kit);
    }

    // Load saved preference (migrate old keys)
    const savedKit = localStorage.getItem('workflows-kit') || localStorage.getItem('workflows-version');
    if (savedKit === 'engineer' || savedKit === 'stable' || savedKit === 'v25') {
      setKit('engineer');
    } else if (savedKit === 'marketing' || savedKit === 'beta' || savedKit === 'v24') {
      setKit('marketing');
    }

    btnEngineer.addEventListener('click', () => setKit('engineer'));
    btnMarketing.addEventListener('click', () => setKit('marketing'));
  });
</script>
