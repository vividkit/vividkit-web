---
// WorkflowsGuide - composition parent, delegates to sub-components
import { stableWorkflows as stableWorkflowsEn, betaWorkflows as betaWorkflowsEn } from '@/data/guides/workflows';
import { stableWorkflows as stableWorkflowsVi, betaWorkflows as betaWorkflowsVi } from '@/data/vi/guides/workflows';
import { getLangFromUrl, type Language } from '@/i18n';
import WorkflowsHeaderAndVersionToggle from './workflows/workflows-header-and-version-toggle.astro';
import WorkflowsStableSection from './workflows/workflows-stable-section.astro';
import WorkflowsBetaSection from './workflows/workflows-beta-section.astro';
import WorkflowsProTipsAndNavigation from './workflows/workflows-pro-tips-and-navigation.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);

const stableWorkflows = currentLang === 'vi' ? stableWorkflowsVi : stableWorkflowsEn;
const betaWorkflows = currentLang === 'vi' ? betaWorkflowsVi : betaWorkflowsEn;
---

<style>
  @keyframes flow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  .flow-arrow {
    animation: flow 2s ease-in-out infinite;
  }
</style>

<div class="space-y-8 mt-6">
  <WorkflowsHeaderAndVersionToggle lang={currentLang} />
  <WorkflowsStableSection workflows={stableWorkflows} lang={currentLang} />
  <WorkflowsBetaSection workflows={betaWorkflows} lang={currentLang} />
  <WorkflowsProTipsAndNavigation lang={currentLang} />
</div>

<script>
  // Version toggle functionality for workflows
  document.addEventListener('DOMContentLoaded', () => {
    const btnStable = document.getElementById('wf-btn-stable');
    const btnBeta = document.getElementById('wf-btn-beta');
    const categoriesStable = document.getElementById('wf-categories-stable');
    const categoriesBeta = document.getElementById('wf-categories-beta');

    if (!btnStable || !btnBeta || !categoriesStable || !categoriesBeta) return;

    const activeClasses = 'bg-teal-500 text-white shadow-sm';
    const inactiveClasses = 'text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700';
    const activeBetaClasses = 'bg-purple-500 text-white shadow-sm';

    function setVersion(version: 'stable' | 'beta') {
      if (version === 'stable') {
        categoriesStable.classList.remove('hidden');
        categoriesBeta.classList.add('hidden');
        btnStable.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeClasses}`;
        btnBeta.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      } else {
        categoriesStable.classList.add('hidden');
        categoriesBeta.classList.remove('hidden');
        btnBeta.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${activeBetaClasses}`;
        btnStable.className = `wf-version-btn px-3 py-1.5 rounded-md text-sm font-medium transition-all duration-200 ${inactiveClasses}`;
      }
      localStorage.setItem('workflows-version', version);
    }

    // Load saved preference (migrate old keys)
    const savedVersion = localStorage.getItem('workflows-version') as 'stable' | 'beta' | 'v25' | 'v24' | null;
    if (savedVersion === 'v25' || savedVersion === 'stable') {
      setVersion('stable');
    } else if (savedVersion === 'v24' || savedVersion === 'beta') {
      setVersion('beta');
    }

    btnStable.addEventListener('click', () => setVersion('stable'));
    btnBeta.addEventListener('click', () => setVersion('beta'));
  });
</script>
