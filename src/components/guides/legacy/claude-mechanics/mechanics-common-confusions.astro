---
// Section 5: Common Confusions - FAQ accordion
import { useTranslations } from "@legacy-ck/i18n/utils";
import { type Language } from "@/i18n";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icon = `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>`;

const faqs = [
  { q: 'q1', a: 'a1' },
  { q: 'q2', a: 'a2' },
  { q: 'q3', a: 'a3' },
  { q: 'q4', a: 'a4' },
  { q: 'q5', a: 'a5' },
];
---

<section class="space-y-6">
  <!-- Section Header -->
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-cyan-100 dark:bg-cyan-500/20 flex items-center justify-center text-cyan-600 dark:text-cyan-400">
      <Fragment set:html={icon} />
    </div>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
      {t('guides.claude_mechanics.section_faq')}
    </h2>
  </div>

  <!-- FAQ Accordion -->
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group glass-card rounded-xl overflow-hidden hover:border-cyan-300 dark:hover:border-cyan-700/60 transition-colors">
        <summary class="p-4 flex items-start gap-3 cursor-pointer list-none select-none hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
          <span class="flex-shrink-0 w-6 h-6 rounded-full bg-cyan-100 dark:bg-cyan-500/20 flex items-center justify-center text-cyan-600 dark:text-cyan-400 text-sm font-bold">
            Q
          </span>
          <span class="flex-1 font-medium text-slate-900 dark:text-white">
            {t(`guides.claude_mechanics.faq.${faq.q}`)}
          </span>
          <svg
            class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-200 group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class="px-4 pb-4">
          <div class="pl-9 pt-2 border-t border-slate-200 dark:border-slate-700">
            <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
              {t(`guides.claude_mechanics.faq.${faq.a}`)}
            </p>
          </div>
        </div>
      </details>
    ))}
  </div>

  <!-- Help tip -->
  <div class="flex items-start gap-3 p-4 rounded-xl bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/20">
    <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <p class="text-sm text-blue-700 dark:text-blue-400" set:html={lang === 'vi'
        ? `Vẫn còn thắc mắc? Xem hướng dẫn "<a href="/vi/guides/how-ck-works" class="underline hover:text-blue-600 dark:hover:text-blue-300">How ClaudeKit Works</a>" để hiểu rõ hơn về cách các skills và hooks hoạt động.`
        : `Still confused? Check out the "<a href="/guides/how-ck-works" class="underline hover:text-blue-600 dark:hover:text-blue-300">How ClaudeKit Works</a>" guide for a deeper dive into how skills and hooks work together.`} />
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
