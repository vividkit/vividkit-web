---
/**
 * Isolated ClaudeKit archive bodies for Batch C.
 * Imports @legacy-ck trees restored from commit 56524c9 — not live AgentKit guides.
 */
import type { Language } from '@/i18n';
import PermissionsGuide from '@legacy-ck/components/guides/PermissionsGuide.astro';
import CustomHooksGuide from '@legacy-ck/components/guides/CustomHooksGuide.astro';
import UIReviewGateGuide from '@legacy-ck/components/guides/UIReviewGateGuide.astro';
import CCSGuide from '@legacy-ck/components/guides/CCSGuide.astro';
import HappyCCSGuide from '@legacy-ck/components/guides/HappyCCSGuide.astro';
import CodexAppGuide from '@legacy-ck/components/guides/CodexAppGuide.astro';
import MigrateGuide from '@legacy-ck/components/guides/MigrateGuide.astro';
import IDEConfigGuide from '@legacy-ck/components/guides/IDEConfigGuide.astro';
import RemoteControlGuide from '@legacy-ck/components/guides/RemoteControlGuide.astro';
import UIUXGuide from '@legacy-ck/components/guides/UIUXGuide.astro';
import SessionRecoveryGuide from '@legacy-ck/components/guides/SessionRecoveryGuide.astro';
import FixLogsGuide from '@legacy-ck/components/guides/FixLogsGuide.astro';

interface Props {
  suffix: string;
  lang: Language;
}

const { suffix, lang } = Astro.props;
---

{suffix === 'permissions' ? (
  <PermissionsGuide lang={lang} />
) : suffix === 'hooks' ? (
  <CustomHooksGuide lang={lang} />
) : suffix === 'ui-review-gate' ? (
  <UIReviewGateGuide lang={lang} />
) : suffix === 'ccs' ? (
  <CCSGuide lang={lang} />
) : suffix === 'happy-ccs' ? (
  <HappyCCSGuide lang={lang} />
) : suffix === 'codex-app' ? (
  <CodexAppGuide lang={lang} />
) : suffix === 'migrate' ? (
  <MigrateGuide lang={lang} />
) : suffix === 'ide-config' ? (
  <IDEConfigGuide lang={lang} />
) : suffix === 'remote-control' ? (
  <RemoteControlGuide lang={lang} />
) : suffix === 'uiux' ? (
  <UIUXGuide lang={lang} />
) : suffix === 'session-recovery' ? (
  <SessionRecoveryGuide lang={lang} />
) : suffix === 'fix-logs' ? (
  <FixLogsGuide lang={lang} />
) : null}
