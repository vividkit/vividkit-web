---
import { useTranslations } from '@/i18n/utils';
import type { Language } from '@/i18n';
import { migrateProviders } from '@/data/guides/coexistence-recipes';
import { renderInlineMarkdown } from './inline-code';
import { Bot, Box, Sparkles, Target, Waves, Wrench } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);

const providerIcons = {
  cursor: Target,
  codex: Bot,
  'gemini-cli': Sparkles,
  windsurf: Waves,
  opencode: Box,
};
---

<section id="migrate" class="space-y-6">
  <div class="space-y-2">
    <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('coexistence.migrate.heading')}
    </h3>
    <p class="text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed" set:html={renderInlineMarkdown(t('coexistence.migrate.intro'), 'sky')} />
  </div>

  <div class="rounded-2xl border border-sky-200 dark:border-sky-800/60 bg-sky-50/40 dark:bg-sky-950/20 px-5 py-4 text-sm text-slate-700 dark:text-slate-200 leading-relaxed" set:html={
    t('coexistence.migrate.notMigrate')
      .replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded-md bg-white/80 dark:bg-slate-900/60 text-sky-700 dark:text-sky-300 font-mono text-[0.9em] border border-sky-200 dark:border-sky-800/60">$1</code>')
      .replace(/\*\*(.+?)\*\*/g, '<strong class="text-slate-900 dark:text-white">$1</strong>')
  } />

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {migrateProviders.map((p) => (
      <article class="rounded-2xl border border-slate-200 dark:border-slate-700/60 bg-white/60 dark:bg-slate-900/40 p-5 space-y-3 hover:border-emerald-300 dark:hover:border-emerald-700 transition-colors">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl border border-emerald-300/80 dark:border-emerald-400/40 bg-emerald-100 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-200 shadow-lg shadow-emerald-500/20 flex items-center justify-center">
            {(() => {
              const Icon = providerIcons[p.id as keyof typeof providerIcons] ?? Wrench;
              return <Icon class="w-6 h-6" stroke-width={2.1} />;
            })()}
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">{p.name}</h4>
        </div>
        <div class="space-y-1.5 text-xs">
          <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
            <span class="font-semibold uppercase tracking-wider text-[10px] shrink-0">{t('coexistence.migrate.col.target')}</span>
          </div>
          <code class="block px-2.5 py-1.5 rounded-md bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-300 font-mono border border-emerald-200 dark:border-emerald-800/60 break-all">
            {p.to}
          </code>
        </div>
      </article>
    ))}
  </div>
</section>
