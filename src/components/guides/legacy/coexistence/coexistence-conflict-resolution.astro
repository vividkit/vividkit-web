---
import { useTranslations, type TranslationKey } from '@/i18n/legacy-archive-utils';
import type { Language } from '@/i18n';
import { conflictOptions } from '@/data/guides/legacy-archive-coexistence-recipes';
import { renderInlineMarkdown } from './inline-code';
import { Database, GitMerge, ShieldCheck, TriangleAlert } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tk = (k: string) => t(k as TranslationKey);

const optionIcons = {
  protectedConfig: ShieldCheck,
  settingsMerge: GitMerge,
  conflictConfirm: TriangleAlert,
};

const optionIconStyles = {
  protectedConfig: 'border-emerald-300/80 dark:border-emerald-400/40 bg-emerald-100 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-200 shadow-emerald-500/20',
  settingsMerge: 'border-sky-300/80 dark:border-sky-400/40 bg-sky-100 dark:bg-sky-500/15 text-sky-700 dark:text-sky-200 shadow-sky-500/20',
  conflictConfirm: 'border-amber-300/80 dark:border-amber-400/40 bg-amber-100 dark:bg-amber-500/15 text-amber-700 dark:text-amber-200 shadow-amber-500/20',
};
---

<section id="conflict-resolution" class="space-y-6">
  <div class="space-y-2">
    <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('coexistence.conflict.heading')}
    </h3>
    <p class="text-base text-slate-600 dark:text-slate-300 max-w-2xl" set:html={renderInlineMarkdown(t('coexistence.conflict.intro'), 'sky')} />
  </div>

  <div class="grid md:grid-cols-3 gap-4">
    {conflictOptions.map((opt) => (
      <article class={`relative rounded-2xl border-2 p-5 flex flex-col ${
        opt.isDefault
          ? 'border-emerald-400 dark:border-emerald-600 bg-emerald-50/50 dark:bg-emerald-950/20 shadow-md shadow-emerald-500/10'
          : 'border-slate-200 dark:border-slate-700/60 bg-white/50 dark:bg-slate-900/30'
      }`}>
        {opt.isDefault && (
          <span class="absolute -top-2.5 left-4 inline-flex items-center gap-1 rounded-full bg-emerald-500 text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-1">
            ★ Default
          </span>
        )}
        <div class={`w-12 h-12 rounded-xl border flex items-center justify-center shadow-lg ${optionIconStyles[opt.id]}`}>
          {(() => {
            const Icon = optionIcons[opt.id];
            return <Icon class="w-6 h-6" stroke-width={2.1} />;
          })()}
        </div>
        <h4 class="mt-3 text-base font-bold text-slate-900 dark:text-white">
          {tk(opt.labelKey)}
        </h4>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed flex-1" set:html={renderInlineMarkdown(tk(opt.behaviorKey))} />
        <p class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700/60 text-xs text-slate-500 dark:text-slate-400 italic" set:html={renderInlineMarkdown(tk(opt.whenKey))} />
      </article>
    ))}
  </div>

  <div class="rounded-2xl border border-violet-200 dark:border-violet-800/60 bg-violet-50/40 dark:bg-violet-950/20 p-6 space-y-4">
    <div class="flex items-start gap-3">
      <div class="w-12 h-12 rounded-xl border border-violet-300/80 dark:border-violet-400/40 bg-violet-100 dark:bg-violet-500/15 text-violet-700 dark:text-violet-200 shadow-lg shadow-violet-500/20 flex items-center justify-center shrink-0">
        <Database class="w-6 h-6" stroke-width={2.1} />
      </div>
      <div class="space-y-2">
        <h4 class="text-lg font-bold text-slate-900 dark:text-white">
          {t('coexistence.conflict.tracking.heading')}
        </h4>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed" set:html={renderInlineMarkdown(t('coexistence.conflict.tracking.body'), 'violet')} />
      </div>
    </div>

    <div class="rounded-xl bg-white/80 dark:bg-slate-900/60 border border-violet-200 dark:border-violet-900/60 overflow-hidden">
      <div class="px-4 py-2 bg-violet-100/60 dark:bg-violet-900/30 border-b border-violet-200 dark:border-violet-900/60 text-xs font-semibold text-violet-700 dark:text-violet-300 font-mono">
        metadata.json + settings.json
      </div>
      <div class="p-4 space-y-3 font-mono text-xs">
        <div class="rounded-lg border-l-4 border-violet-500 bg-violet-50 dark:bg-violet-950/30 px-3 py-2">
          <div class="text-[10px] uppercase tracking-wider text-violet-700 dark:text-violet-400 font-bold">
            {t('coexistence.conflict.example.ck')}
          </div>
          <div class="mt-1 text-slate-700 dark:text-slate-200">"hooks/session-init.cjs"</div>
          <div class="text-slate-500 dark:text-slate-400">ownership: "ck"</div>
        </div>
        <div class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/30 px-3 py-2">
          <div class="text-[10px] uppercase tracking-wider text-emerald-700 dark:text-emerald-400 font-bold">
            {t('coexistence.conflict.example.yours')}
          </div>
          <div class="mt-1 text-slate-700 dark:text-slate-200">"your-custom-hook.sh"</div>
          <div class="text-slate-500 dark:text-slate-400">preserved during settings merge</div>
        </div>
      </div>
    </div>
  </div>
</section>
