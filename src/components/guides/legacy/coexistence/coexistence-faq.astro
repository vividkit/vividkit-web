---
import { useTranslations, type TranslationKey } from '@/i18n/utils';
import type { Language } from '@/i18n';
import { faqEntries } from '@/data/guides/coexistence-recipes';
import { renderInlineMarkdown } from './inline-code';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);
const tk = (k: string) => t(k as TranslationKey);
---

<section id="faq" class="space-y-4">
  <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
    {t('coexistence.faq.heading')}
  </h3>

  <div class="space-y-3">
    {faqEntries.map((f) => (
      <details class="group rounded-2xl border border-slate-200 dark:border-slate-700/60 bg-white/60 dark:bg-slate-900/40 overflow-hidden hover:border-emerald-300 dark:hover:border-emerald-700/60 transition-colors">
        <summary class="flex items-center justify-between gap-3 p-5 cursor-pointer list-none select-none hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
          <span class="font-semibold text-slate-800 dark:text-slate-100 leading-snug" set:html={renderInlineMarkdown(tk(f.questionKey))} />
          <svg
            class="w-5 h-5 text-slate-400 shrink-0 transition-transform duration-200 group-open:rotate-180"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          >
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div
          class="px-5 pb-5 pt-1 text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/60"
          set:html={renderInlineMarkdown(tk(f.answerKey))}
        />
      </details>
    ))}
  </div>
</section>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
