---
import { useTranslations } from '@/i18n/legacy-archive-utils';
import type { Language } from '@/i18n';
import { renderInlineMarkdown } from '../coexistence/inline-code';
import { Cpu, Boxes, GitBranch, Package } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const t = useTranslations(lang);

const items = [
  { icon: Cpu, titleKey: 'ckWithCodex.prereq.node.title', descKey: 'ckWithCodex.prereq.node.desc', tag: 'runtime', accent: 'slate' },
  { icon: Package, titleKey: 'ckWithCodex.prereq.codex.title', descKey: 'ckWithCodex.prereq.codex.desc', tag: 'binary', accent: 'amber' },
  { icon: GitBranch, titleKey: 'ckWithCodex.prereq.ccs.title', descKey: 'ckWithCodex.prereq.ccs.desc', tag: 'router', accent: 'violet' },
  { icon: Boxes, titleKey: 'ckWithCodex.prereq.ck.title', descKey: 'ckWithCodex.prereq.ck.desc', tag: 'content', accent: 'emerald' },
] as const;

const accentMap: Record<string, { card: string; chip: string; icon: string }> = {
  slate: {
    card: 'border-slate-200 dark:border-slate-800',
    chip: 'bg-slate-200 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300',
    icon: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border-slate-300/80 dark:border-slate-600/40',
  },
  amber: {
    card: 'border-amber-200 dark:border-amber-800/60',
    chip: 'bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300',
    icon: 'bg-amber-100 dark:bg-amber-500/15 text-amber-700 dark:text-amber-200 border-amber-300/80 dark:border-amber-400/40',
  },
  violet: {
    card: 'border-violet-200 dark:border-violet-800/60',
    chip: 'bg-violet-100 dark:bg-violet-900/50 text-violet-800 dark:text-violet-300',
    icon: 'bg-violet-100 dark:bg-violet-500/15 text-violet-700 dark:text-violet-200 border-violet-300/80 dark:border-violet-400/40',
  },
  emerald: {
    card: 'border-emerald-200 dark:border-emerald-800/60',
    chip: 'bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300',
    icon: 'bg-emerald-100 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-200 border-emerald-300/80 dark:border-emerald-400/40',
  },
};
---

<section class="space-y-6">
  <div class="space-y-2">
    <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
      {t('ckWithCodex.prereq.heading')}
    </h3>
    <p class="text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
      {t('ckWithCodex.prereq.intro')}
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {items.map((item) => {
      const a = accentMap[item.accent];
      const Icon = item.icon;
      return (
        <article class={`relative rounded-2xl border-2 ${a.card} bg-white/60 dark:bg-slate-900/40 p-5 flex flex-col gap-3`}>
          <div class="flex items-start justify-between">
            <div class={`w-11 h-11 rounded-xl border flex items-center justify-center shadow-md ${a.icon}`}>
              <Icon class="w-5 h-5" stroke-width={2.1} />
            </div>
            <span class={`text-[10px] uppercase tracking-wider font-bold px-2 py-0.5 rounded-full ${a.chip}`}>{item.tag}</span>
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white leading-snug">{t(item.titleKey)}</h4>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed" set:html={renderInlineMarkdown(t(item.descKey))} />
        </article>
      );
    })}
  </div>
</section>
