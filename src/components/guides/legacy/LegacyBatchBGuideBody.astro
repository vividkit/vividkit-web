---
/**
 * Isolated ClaudeKit archive bodies for Batch B.
 * Imports @legacy-ck trees restored from commit 56524c9 — not live AgentKit guides.
 */
import type { Language } from '@/i18n';
import CLIGuide from '@legacy-ck/components/guides/CLIGuide.astro';
import CLICommandsGuide from '@legacy-ck/components/guides/CLICommandsGuide.astro';
import CommandsGuide from '@legacy-ck/components/guides/CommandsGuide.astro';
import WorkflowsGuide from '@legacy-ck/components/guides/WorkflowsGuide.astro';
import FlowchartGuide from '@legacy-ck/components/guides/FlowchartGuide.astro';
import FindingUnknownsGuide from '@legacy-ck/components/guides/FindingUnknownsGuide.astro';
import WhatIsClaudeKitGuide from '@legacy-ck/components/guides/WhatIsClaudeKitGuide.astro';
import HowCkWorksGuide from '@legacy-ck/components/guides/how-ck-works/HowCkWorksGuide.astro';
import InsideClaudeKitGuide from '@legacy-ck/components/guides/InsideClaudeKitGuide.astro';
import InsideClaudeKitFrontendDesignArticle from '@legacy-ck/components/guides/inside-claudekit/InsideClaudeKitFrontendDesignArticle.astro';
import InsideClaudeKitGettingStartedArticle from '@legacy-ck/components/guides/inside-claudekit/InsideClaudeKitGettingStartedArticle.astro';
import InsideClaudeKitGuardRailsArticle from '@legacy-ck/components/guides/inside-claudekit/InsideClaudeKitGuardRailsArticle.astro';
import InsideClaudeKitPlanModesArticle from '@legacy-ck/components/guides/inside-claudekit/InsideClaudeKitPlanModesArticle.astro';

interface Props {
  suffix: string;
  lang: Language;
}

const { suffix, lang } = Astro.props;
---

{suffix === 'cli' ? (
  <CLIGuide lang={lang} />
) : suffix === 'cli-commands' ? (
  <CLICommandsGuide lang={lang} />
) : suffix === 'commands' ? (
  <CommandsGuide lang={lang} />
) : suffix === 'workflows' ? (
  <WorkflowsGuide lang={lang} />
) : suffix === 'flowchart' ? (
  <FlowchartGuide lang={lang} />
) : suffix === 'finding-unknowns' ? (
  <FindingUnknownsGuide lang={lang} />
) : suffix === 'what-is-claudekit' ? (
  <WhatIsClaudeKitGuide lang={lang} />
) : suffix === 'how-ck-works' ? (
  <div class="pb-8"><HowCkWorksGuide lang={lang} /></div>
) : suffix === 'inside-claudekit' ? (
  <InsideClaudeKitGuide lang={lang} />
) : suffix === 'inside-claudekit/frontend-design' ? (
  <InsideClaudeKitFrontendDesignArticle lang={lang} />
) : suffix === 'inside-claudekit/getting-started' ? (
  <InsideClaudeKitGettingStartedArticle lang={lang} />
) : suffix === 'inside-claudekit/guard-rails' ? (
  <InsideClaudeKitGuardRailsArticle lang={lang} />
) : suffix === 'inside-claudekit/plan-modes' ? (
  <InsideClaudeKitPlanModesArticle lang={lang} />
) : null}
