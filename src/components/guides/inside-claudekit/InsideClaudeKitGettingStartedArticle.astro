---
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';
import InsideClaudeKitArticleShell from './InsideClaudeKitArticleShell.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const blogPostUrl = 'https://claudekit.thieunv.space/posts/claudekit-beginners-guide';

const copy = currentLang === 'vi'
  ? {
      kicker: 'Getting Started',
      summary: 'Claude Code là môi trường lập trình agentic từ Anthropic. ClaudeKit Engineer Kit biến Claude từ assistant thành development partner với hệ thống skills, hooks, và workflows.',
      sections: {
        claudeCode: 'Claude Code là gì?',
        claudeKit: 'ClaudeKit Engineer Kit là gì?',
        coreCommands: '7 lệnh core cho người mới',
        bestPractices: 'Nên làm',
        badPractices: 'Không nên làm',
        readMore: 'Đọc thêm chi tiết',
      },
      claudeCode: [
        'Môi trường lập trình agentic: đọc files, chạy commands, tự động giải quyết problems.',
        'Constraint quan trọng: context window sẽ đầy dần → hiệu suất giảm. Dùng /clear giữa các tasks không liên quan.',
        'Claude Code hoạt động tốt nhất khi bạn hiểu cách nó quản lý context.',
      ],
      claudeKit: [
        'Một thư mục .claude/ chứa workflow templates: Skills, Hooks, Agents, Rules.',
        'Philosophy: YAGNI + KISS + DRY — đơn giản hóa công việc, không thêm complexity.',
        'Engineer Kit biến Claude từ assistant thành development partner thực sự.',
      ],
      coreCommands: [
        { cmd: '/ck:brainstorm', desc: 'Khám phá ý tưởng và giải pháp trước khi code' },
        { cmd: '/ck:plan', desc: 'Tạo implementation plan chi tiết với phases' },
        { cmd: '/ck:cook', desc: 'Execute plan — build features theo từng bước' },
        { cmd: '/ck:fix', desc: 'Debug và fix bugs một cách có hệ thống' },
        { cmd: '/ck:ask', desc: 'Hỏi đáp nhanh về code hoặc architecture' },
        { cmd: '/ck:test', desc: 'Chạy tests và phân tích coverage' },
        { cmd: '/ck:watzup', desc: 'Xem tóm tắt những gì đã làm trong session' },
      ],
      bestPractices: [
        'Cho Claude tiêu chí verify rõ ràng để nó tự kiểm tra kết quả.',
        'Theo flow: Brainstorm → Plan → Cook — không nhảy thẳng vào code.',
        'Cung cấp context cụ thể: file paths, error messages, expected behavior.',
        'Clear context thường xuyên giữa các tasks không liên quan.',
      ],
      badPractices: [
        'Kitchen-sink sessions: dồn quá nhiều tasks vào một session.',
        'Sửa đi sửa lại mà không clear context → Claude lặp lại sai lầm.',
        'Bỏ qua planning, nhảy thẳng vào implementation.',
        'Trust without verify — luôn kiểm tra output của Claude.',
        'Prompts mơ hồ: "fix this" thay vì mô tả cụ thể vấn đề.',
      ],
      readMoreText: 'Đọc bài viết đầy đủ để hiểu sâu hơn về workflow patterns, skills roadmap theo tuần, và cheat sheet →',
    }
  : {
      kicker: 'Getting Started',
      summary: 'Claude Code is an agentic coding environment from Anthropic. ClaudeKit Engineer Kit transforms Claude from assistant into a true development partner with skills, hooks, and workflows.',
      sections: {
        claudeCode: 'What is Claude Code?',
        claudeKit: 'What is ClaudeKit Engineer Kit?',
        coreCommands: '7 core commands for beginners',
        bestPractices: 'Do This',
        badPractices: 'Avoid This',
        readMore: 'Read more details',
      },
      claudeCode: [
        'Agentic coding environment: reads files, runs commands, auto-solves problems.',
        'Key constraint: context window fills up → performance degrades. Use /clear between unrelated tasks.',
        'Claude Code works best when you understand how it manages context.',
      ],
      claudeKit: [
        'A .claude/ folder containing workflow templates: Skills, Hooks, Agents, Rules.',
        'Philosophy: YAGNI + KISS + DRY — simplify work, avoid unnecessary complexity.',
        'Engineer Kit transforms Claude from assistant into a true development partner.',
      ],
      coreCommands: [
        { cmd: '/ck:brainstorm', desc: 'Explore ideas and solutions before coding' },
        { cmd: '/ck:plan', desc: 'Create detailed implementation plans with phases' },
        { cmd: '/ck:cook', desc: 'Execute plan — build features step by step' },
        { cmd: '/ck:fix', desc: 'Debug and fix bugs systematically' },
        { cmd: '/ck:ask', desc: 'Quick Q&A about code or architecture' },
        { cmd: '/ck:test', desc: 'Run tests and analyze coverage' },
        { cmd: '/ck:watzup', desc: 'See summary of what was done in session' },
      ],
      bestPractices: [
        'Give Claude clear verification criteria so it can self-check results.',
        'Follow the flow: Brainstorm → Plan → Cook — don\'t jump straight to code.',
        'Provide specific context: file paths, error messages, expected behavior.',
        'Clear context frequently between unrelated tasks.',
      ],
      badPractices: [
        'Kitchen-sink sessions: cramming too many tasks into one session.',
        'Repeated corrections without clearing context → Claude repeats mistakes.',
        'Skipping planning, jumping straight into implementation.',
        'Trust without verify — always check Claude\'s output.',
        'Vague prompts: "fix this" instead of describing the specific problem.',
      ],
      readMoreText: 'Read the full article for workflow patterns, weekly skills roadmap, and cheat sheet →',
    };
---

<InsideClaudeKitArticleShell
  lang={currentLang}
  kicker={copy.kicker}
  title={t('guides.home.inside_claudekit.topic_3.title')}
  summary={copy.summary}
  slug="getting-started"
>
  <!-- Two-column intro: Claude Code + ClaudeKit -->
  <div class="grid gap-4 md:grid-cols-2">
    <!-- What is Claude Code -->
    <section id="claude-code" class="rounded-2xl border-l-4 border-l-violet-500 bg-gradient-to-br from-violet-50 to-purple-50/50 p-5 dark:from-violet-950/30 dark:to-purple-950/20">
      <div class="mb-3 flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-violet-100 dark:bg-violet-900/50">
          <svg class="h-4 w-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{copy.sections.claudeCode}</h2>
      </div>
      <ul class="space-y-2">
        {copy.claudeCode.map((item) => (
          <li class="flex gap-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-violet-400"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- What is ClaudeKit -->
    <section id="claudekit" class="rounded-2xl border-l-4 border-l-blue-500 bg-gradient-to-br from-blue-50 to-cyan-50/50 p-5 dark:from-blue-950/30 dark:to-cyan-950/20">
      <div class="mb-3 flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-100 dark:bg-blue-900/50">
          <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{copy.sections.claudeKit}</h2>
      </div>
      <ul class="space-y-2">
        {copy.claudeKit.map((item) => (
          <li class="flex gap-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-400"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <!-- Memory Loading Order - Visual -->
  <section id="memory-loading" class="rounded-2xl border border-amber-200/70 bg-gradient-to-br from-amber-50 to-orange-50/50 p-5 dark:border-amber-800/50 dark:from-amber-950/30 dark:to-orange-950/20">
    <div class="mb-3 flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-100 dark:bg-amber-900/50">
        <svg class="h-4 w-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{currentLang === 'vi' ? 'Cơ chế Load Memory' : 'Memory Loading Order'}</h2>
    </div>
    <p class="mb-3 text-sm text-slate-600 dark:text-slate-300">
      {currentLang === 'vi'
        ? 'Claude đọc và nối (concatenate) các file theo thứ tự, từ global → project → path-specific:'
        : 'Claude reads and concatenates files in order, from global → project → path-specific:'}
    </p>
    <!-- Loading order diagram -->
    <div class="space-y-2">
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-200 text-xs font-bold text-amber-800 dark:bg-amber-800 dark:text-amber-200">1</span>
        <div class="flex-1 rounded-lg border border-amber-200/70 bg-white/50 px-3 py-2 dark:border-amber-800/50 dark:bg-amber-950/30">
          <code class="text-xs font-medium text-amber-700 dark:text-amber-300">~/.claude/CLAUDE.md</code>
          <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">{currentLang === 'vi' ? 'Global — mọi project' : 'Global — all projects'}</span>
        </div>
      </div>
      <div class="ml-3 border-l-2 border-dashed border-amber-300 pl-6 dark:border-amber-700">
        <svg class="h-3 w-3 -ml-[7px] text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </div>
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-200 text-xs font-bold text-amber-800 dark:bg-amber-800 dark:text-amber-200">2</span>
        <div class="flex-1 rounded-lg border border-amber-200/70 bg-white/50 px-3 py-2 dark:border-amber-800/50 dark:bg-amber-950/30">
          <code class="text-xs font-medium text-amber-700 dark:text-amber-300">./CLAUDE.md</code>
          <span class="mx-1 text-xs text-slate-400">+</span>
          <code class="text-xs font-medium text-amber-700 dark:text-amber-300">CLAUDE.local.md</code>
          <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">{currentLang === 'vi' ? 'Project root' : 'Project root'}</span>
        </div>
      </div>
      <div class="ml-3 border-l-2 border-dashed border-amber-300 pl-6 dark:border-amber-700">
        <svg class="h-3 w-3 -ml-[7px] text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </div>
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-200 text-xs font-bold text-amber-800 dark:bg-amber-800 dark:text-amber-200">3</span>
        <div class="flex-1 rounded-lg border border-amber-200/70 bg-white/50 px-3 py-2 dark:border-amber-800/50 dark:bg-amber-950/30">
          <code class="text-xs font-medium text-amber-700 dark:text-amber-300">.claude/rules/*.md</code>
          <span class="ml-2 text-xs text-slate-500 dark:text-slate-400">{currentLang === 'vi' ? 'Rules theo topic (lazy-load nếu có paths)' : 'Topic rules (lazy-load if path-scoped)'}</span>
        </div>
      </div>
      <div class="ml-3 border-l-2 border-dashed border-amber-300 pl-6 dark:border-amber-700">
        <svg class="h-3 w-3 -ml-[7px] text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/></svg>
      </div>
      <div class="flex items-center gap-3">
        <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-200 text-xs font-bold text-emerald-800 dark:bg-emerald-800 dark:text-emerald-200">✓</span>
        <div class="flex-1 rounded-lg border border-emerald-300 bg-emerald-50 px-3 py-2 dark:border-emerald-700 dark:bg-emerald-950/40">
          <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300">{currentLang === 'vi' ? '→ Session Context (đã nối)' : '→ Session Context (concatenated)'}</span>
        </div>
      </div>
    </div>
    <div class="mt-3 rounded-lg bg-amber-100/50 px-3 py-2 dark:bg-amber-900/30">
      <p class="text-xs text-amber-800 dark:text-amber-200">
        <strong>Tip:</strong> {currentLang === 'vi'
          ? 'Giữ CLAUDE.md < 200 dòng. Tách domain rules (api, testing, security) sang .claude/rules/ để tránh context bloat.'
          : 'Keep CLAUDE.md < 200 lines. Split domain rules (api, testing, security) into .claude/rules/ to avoid context bloat.'}
      </p>
    </div>
  </section>

  <!-- 7 Core Commands - Grid layout -->
  <section id="core-commands" class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
    <div class="mb-4 flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/50">
        <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{copy.sections.coreCommands}</h2>
    </div>
    <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {copy.coreCommands.map((item, i) => (
        <div class="flex items-start gap-3 rounded-xl bg-slate-50 p-3 dark:bg-slate-800/50">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">{i + 1}</span>
          <div class="min-w-0">
            <code class="block truncate font-mono text-sm font-medium text-emerald-700 dark:text-emerald-300">{item.cmd}</code>
            <span class="text-xs text-slate-500 dark:text-slate-400">{item.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Best vs Bad Practices - Side by side -->
  <div class="grid gap-4 md:grid-cols-2">
    <!-- Best Practices -->
    <section id="best-practices" class="rounded-2xl border border-emerald-200/70 bg-gradient-to-br from-emerald-50 to-green-50/50 p-5 dark:border-emerald-800/50 dark:from-emerald-950/30 dark:to-green-950/20">
      <div class="mb-3 flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-100 dark:bg-emerald-900/50">
          <svg class="h-4 w-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-emerald-800 dark:text-emerald-200">{copy.sections.bestPractices}</h2>
      </div>
      <ul class="space-y-2">
        {copy.bestPractices.map((item) => (
          <li class="flex gap-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
            <svg class="mt-1 h-4 w-4 shrink-0 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Bad Practices -->
    <section id="bad-practices" class="rounded-2xl border border-rose-200/70 bg-gradient-to-br from-rose-50 to-red-50/50 p-5 dark:border-rose-800/50 dark:from-rose-950/30 dark:to-red-950/20">
      <div class="mb-3 flex items-center gap-2">
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-100 dark:bg-rose-900/50">
          <svg class="h-4 w-4 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-rose-800 dark:text-rose-200">{copy.sections.badPractices}</h2>
      </div>
      <ul class="space-y-2">
        {copy.badPractices.map((item) => (
          <li class="flex gap-2 text-sm leading-6 text-slate-600 dark:text-slate-300">
            <svg class="mt-1 h-4 w-4 shrink-0 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
            </svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <!-- Real-World Use Cases -->
  <section id="use-cases" class="rounded-2xl border border-slate-200/70 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/70">
    <div class="mb-4 flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-100 dark:bg-purple-900/50">
        <svg class="h-4 w-4 text-purple-600 dark:text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
      </div>
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">{currentLang === 'vi' ? 'Use Cases Thực Tế' : 'Real-World Use Cases'}</h2>
    </div>
    <div class="space-y-3">
      <!-- UC1: Build feature -->
      <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-800/30">
        <div class="mb-2 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-purple-100 text-xs font-bold text-purple-700 dark:bg-purple-900/50 dark:text-purple-300">1</span>
          <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">{currentLang === 'vi' ? 'Build feature mới' : 'Build new feature'}</span>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">Beginner</span>
        </div>
        <p class="mb-2 text-xs italic text-slate-500 dark:text-slate-400">
          {currentLang === 'vi' ? 'Scenario: Thêm user settings page với dark mode toggle' : 'Scenario: Add user settings page with dark mode toggle'}
        </p>
        <div class="rounded-lg bg-slate-900 p-3 font-mono text-xs text-slate-200">
          <div><span class="text-purple-400">/ck:brainstorm</span> <span class="text-slate-400"># Explore options</span></div>
          <div><span class="text-purple-400">/ck:plan</span> <span class="text-slate-400"># Detail implementation</span></div>
          <div><span class="text-purple-400">/ck:cook</span> <span class="text-slate-400"># Build + test + review</span></div>
          <div><span class="text-purple-400">/ck:git</span> cm <span class="text-slate-400"># Commit</span></div>
        </div>
      </div>
      <!-- UC2: Fix bug -->
      <div class="rounded-xl border border-slate-100 bg-slate-50/50 p-4 dark:border-slate-800 dark:bg-slate-800/30">
        <div class="mb-2 flex items-center gap-2">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-purple-100 text-xs font-bold text-purple-700 dark:bg-purple-900/50 dark:text-purple-300">2</span>
          <span class="text-sm font-semibold text-slate-800 dark:text-slate-200">{currentLang === 'vi' ? 'Fix bug nhanh' : 'Quick bug fix'}</span>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-medium text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300">Beginner</span>
        </div>
        <p class="mb-2 text-xs italic text-slate-500 dark:text-slate-400">
          {currentLang === 'vi' ? 'Scenario: Form validation không show error message' : 'Scenario: Form validation not showing error message'}
        </p>
        <div class="rounded-lg bg-slate-900 p-3 font-mono text-xs text-slate-200">
          <div><span class="text-purple-400">/ck:fix</span> Email validation in signup form...</div>
          <div class="text-slate-400"># Auto: scout → diagnose → fix → verify</div>
        </div>
      </div>
      <!-- UC3: Onboard codebase -->
