---
import { useTranslatedPath, type Language } from '@/i18n';
import TerminalSnippet from '../TerminalSnippet.astro';
import { ArrowRight, CheckCircle2, Download, KeyRound, Link2, LoaderCircle, PlugZap, QrCode, Route, Server, ShieldCheck, Smartphone, TriangleAlert, Unplug, Wrench } from 'lucide-astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const installStandalone = `curl -fsSL https://chatgpt.com/codex/install.sh | sh`;

const codexLogin = `~/.codex/packages/standalone/current/codex login`;

const defaultStart = `~/.codex/packages/standalone/current/codex remote-control start --json`;

const cliProxyStart = `~/.codex/packages/standalone/current/codex remote-control start \\
  -c 'model_provider="cliproxy"' \\
  -c 'model="gpt-5.5"' \\
  --json`;

const remoteControlReset = `~/.codex/packages/standalone/current/codex remote-control stop
~/.codex/packages/standalone/current/codex remote-control start --json`;

const appServerSocketReset = `~/.codex/packages/standalone/current/codex app-server daemon version
~/.codex/packages/standalone/current/codex app-server daemon stop
# Then rerun the same remote-control start command you picked above.`;

const oauthReset = `~/.codex/packages/standalone/current/codex logout
~/.codex/packages/standalone/current/codex login`;

const inlineCode = 'rounded border border-slate-200 bg-slate-100 px-1.5 py-0.5 font-mono text-[0.86em] text-slate-800 dark:border-slate-700 dark:bg-slate-800/90 dark:text-slate-100';
---

<div id="remote-control-panel-codex" data-tab-panel="codex" role="tabpanel" aria-labelledby="remote-control-tab-codex" hidden>
  <div class="min-w-0 space-y-5">
    <section class="min-w-0 rounded-2xl border border-cyan-200 bg-cyan-50/45 p-5 shadow-sm dark:border-cyan-500/30 dark:bg-cyan-950/20 sm:p-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="flex min-w-0 items-start gap-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-white text-cyan-700 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">
            <PlugZap class="h-5 w-5" stroke-width={2.2} />
          </span>
          <div class="min-w-0">
            <h3 class="text-lg font-bold text-slate-950 dark:text-white">{t('What is the Codex app-server?', 'Codex app-server là gì?')}</h3>
            <p class="mt-1 max-w-4xl text-sm leading-6 text-slate-600 dark:text-slate-400">
              {t('Codex app-server is the local interface rich clients attach to for auth, conversation state, approvals, and streamed agent events. Remote Control starts that host process, then the remote device controls it through ChatGPT identity.', 'Codex app-server là tiến trình chạy ở máy local để các client kết nối vào, đảm nhiệm xác thực, trạng thái hội thoại, phê duyệt và luồng sự kiện từ agent. Remote Control khởi chạy tiến trình host này, rồi thiết bị từ xa điều khiển nó qua ChatGPT identity.')}
            </p>
          </div>
        </div>
        <span class="inline-flex w-fit shrink-0 items-center gap-2 whitespace-nowrap rounded-full border border-cyan-200 bg-white px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.12em] text-cyan-700 shadow-sm dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">
          <span>{t('identity', 'identity')}</span>
          <span class="rounded-full border border-cyan-200 bg-cyan-50 px-1.5 py-0.5 font-mono text-[10px] leading-none tracking-normal text-cyan-800 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-100">
            !=
          </span>
          <span>{t('routing', 'routing')}</span>
        </span>
      </div>

      <div class="mt-5 grid gap-3 lg:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
            <Server class="h-4 w-4 text-cyan-700 dark:text-cyan-300" stroke-width={2.2} />
            {t('Local app-server', 'Local app-server')}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('The standalone binary launches the daemon. Local files, shell, tools, plugins, and credentials come from this host.', 'Standalone binary khởi chạy daemon. Toàn bộ file local, shell, tools, plugins và credentials đều lấy từ host này.')}
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
            <KeyRound class="h-4 w-4 text-amber-700 dark:text-amber-300" stroke-width={2.2} />
            {t('Remote identity', 'Remote identity')}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('ChatGPT/OpenAI OAuth authorizes the remote device and workspace. It is separate from provider routing.', 'OAuth của ChatGPT/OpenAI cấp quyền cho thiết bị từ xa và workspace, tách biệt với provider routing.')}
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
            <Route class="h-4 w-4 text-emerald-700 dark:text-emerald-300" stroke-width={2.2} />
            {t('Model routing', 'Model routing')}
          </div>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
            <code class={inlineCode}>-c model_provider</code>
            {t(' changes where model calls go after the app-server is running. CLIProxyAPI/CCS lives here.', ' chỉ đổi model call đi đâu sau khi app-server đã chạy. CLIProxyAPI/CCS nằm ở tầng này.')}
          </p>
        </div>
      </div>
    </section>

    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-200">
          <PlugZap class="h-5 w-5" stroke-width={2.2} />
        </span>
        <div class="min-w-0">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">{t('Start Codex Remote Control', 'Khởi chạy Codex Remote Control')}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('Install the standalone Codex binary once, then pick a start path: default OAuth, or route through CLIProxyAPI/CCS when you need shared routing and account-pool controls.', 'Cài standalone Codex một lần, rồi chọn flow khởi chạy: OAuth mặc định, hoặc đi qua CLIProxyAPI/CCS khi cần shared routing và quản lý account pool.')}
          </p>
        </div>
      </div>

      <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/35 sm:p-5">
        <div class="flex min-w-0 flex-col gap-4 lg:flex-row lg:items-start">
          <div class="flex min-w-0 items-start gap-4 lg:w-[40%]">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-200">1</span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{t('Install standalone Codex', 'Cài standalone Codex')}</h4>
                <span class="inline-flex items-center gap-1 rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-400">
                  <Download class="h-3 w-3" stroke-width={2.4} />
                  {t('one-time', 'một lần')}
                </span>
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                {t('Run the ChatGPT installer once. Both cases below reuse the binary at ~/.codex/packages/standalone/current/codex.', 'Chạy installer của ChatGPT một lần. Cả hai case bên dưới đều dùng chung binary tại ~/.codex/packages/standalone/current/codex.')}
              </p>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <TerminalSnippet code={installStandalone} label="shell · install" compact />
          </div>
        </div>
      </div>

      <div class="mt-5 rounded-xl border border-cyan-200 bg-cyan-50/45 p-4 dark:border-cyan-500/30 dark:bg-cyan-950/20 sm:p-5">
        <div class="flex min-w-0 flex-col gap-4 lg:flex-row lg:items-start">
          <div class="flex min-w-0 items-start gap-4 lg:w-[40%]">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-white text-sm font-bold text-cyan-800 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">2</span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{t('Sign in with ChatGPT identity', 'Login bằng ChatGPT identity')}</h4>
                <span class="inline-flex items-center gap-1 rounded-full border border-cyan-200 bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-cyan-700 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">
                  <KeyRound class="h-3 w-3" stroke-width={2.4} />
                  OAuth
                </span>
              </div>
              <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                {t('Remote Control needs a ChatGPT/OpenAI OAuth session first. CLIProxyAPI only changes model routing; it does not replace the ChatGPT identity used to authorize the phone and host.', 'Remote Control cần session ChatGPT/OpenAI OAuth trước. CLIProxyAPI chỉ đổi route model; nó không thay thế ChatGPT identity dùng để authorize điện thoại và host.')}
              </p>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <TerminalSnippet code={codexLogin} label="shell · ChatGPT OAuth" compact />
          </div>
        </div>

        <div class="mt-4 grid gap-3 lg:grid-cols-3">
          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
              <Smartphone class="h-4 w-4 text-cyan-700 dark:text-cyan-300" stroke-width={2.2} />
              {t('Open ChatGPT on phone', 'Mở ChatGPT trên điện thoại')}
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              {t('Use the same ChatGPT account and workspace, then open the Codex tab. If the Codex tab is missing, update the ChatGPT app first.', 'Dùng cùng ChatGPT account và workspace, rồi mở tab Codex. Nếu chưa thấy tab Codex, update app ChatGPT trước.')}
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
              <QrCode class="h-4 w-4 text-emerald-700 dark:text-emerald-300" stroke-width={2.2} />
              {t('Approve host access', 'Ủy quyền truy cập host')}
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              {t('When ChatGPT asks whether this phone can access Codex on your computer, tap the authorize button. That is the device handoff shown in the mobile prompt.', 'Khi ChatGPT hỏi có cho điện thoại này truy cập Codex trên máy tính không, bấm nút ủy quyền. Đây là bước handoff thiết bị như prompt trên mobile.')}
            </p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-950/65">
            <div class="flex items-center gap-2 text-sm font-bold text-slate-950 dark:text-white">
              <LoaderCircle class="h-4 w-4 text-amber-700 dark:text-amber-300" stroke-width={2.2} />
              {t('Wait for secure setup', 'Chờ hoàn tất thiết lập an toàn')}
            </div>
            <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              {t('After approval, ChatGPT may show a secure setup spinner. Wait until the Codex host/session appears before sending prompts remotely.', 'Sau khi ủy quyền, ChatGPT có thể hiện spinner thiết lập an toàn. Chờ tới khi host/session Codex xuất hiện rồi mới gửi prompt từ xa.')}
            </p>
          </div>
        </div>

        <div class="mt-4 rounded-xl border border-cyan-200 bg-white p-4 dark:border-cyan-500/30 dark:bg-slate-950/60">
          <div class="flex items-start gap-3">
            <ShieldCheck class="mt-0.5 h-5 w-5 shrink-0 text-cyan-700 dark:text-cyan-300" stroke-width={2.2} />
            <p class="text-sm leading-6 text-slate-700 dark:text-slate-300">
              {t('Keep the host awake and online. Files, tools, credentials, sandboxing, and approvals still come from the connected host; the phone only sends prompts and receives session updates.', 'Giữ host awake và online. File, tools, credentials, sandboxing và approvals vẫn lấy từ host đã connect; điện thoại chỉ gửi prompt và nhận session update.')}
            </p>
          </div>
        </div>
      </div>

      <div class="mt-5 flex items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-white text-sm font-bold text-slate-700 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-200">3</span>
        <div class="min-w-0">
          <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{t('Start the daemon — pick a route', 'Khởi chạy daemon — chọn một route')}</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">{t('Run only one of the cases below.', 'Chỉ chạy một trong hai case bên dưới.')}</p>
        </div>
      </div>

      <div class="mt-3 space-y-4">
        <article class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/35 sm:p-5">
          <div class="flex min-w-0 flex-col gap-4 lg:flex-row lg:items-start">
            <div class="flex min-w-0 items-start gap-4 lg:w-[42%]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-cyan-50 text-sm font-bold text-cyan-800 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-200">A</span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{t('Normal OAuth remote control', 'Remote Control OAuth bình thường')}</h4>
                  <span class="rounded-full border border-slate-200 bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-950/60 dark:text-slate-400">
                    default
                  </span>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                  {t('Pick this when you already signed in via ChatGPT/OpenAI OAuth and do not need CCS model routing.', 'Chọn case này khi đã login ChatGPT/OpenAI OAuth và không cần CCS model routing.')}
                </p>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <TerminalSnippet code={defaultStart} label="shell · standalone" />
            </div>
          </div>
        </article>

        <article class="min-w-0 rounded-xl border border-cyan-200 bg-cyan-50/45 p-4 dark:border-cyan-500/30 dark:bg-cyan-950/20 sm:p-5">
          <div class="flex min-w-0 flex-col gap-4 lg:flex-row lg:items-start">
            <div class="flex min-w-0 items-start gap-4 lg:w-[42%]">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-white text-sm font-bold text-cyan-800 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">B</span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{t('Remote Control + CLIProxyAPI/CCS', 'Remote Control + CLIProxyAPI/CCS')}</h4>
                  <span class="rounded-full border border-cyan-200 bg-white px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-cyan-700 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200">
                    route model
                  </span>
                </div>
                <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
                  {t('Pick this when CCS/CLIProxyAPI is healthy and you want account rotation, quota visibility, or failover behind the remote session.', 'Chọn case này khi CCS/CLIProxyAPI đang healthy, muốn có account rotation, quota visibility hoặc failover phía sau remote session.')}
                </p>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <TerminalSnippet code={cliProxyStart} label="shell · cliproxyapi" />
            </div>
          </div>
        </article>
      </div>

      <a href={translatePath('/guides/codex-app')} class="group mt-4 flex min-h-12 items-center justify-between gap-4 rounded-xl border border-cyan-200 bg-white px-4 py-3 text-sm font-bold text-cyan-800 transition hover:border-cyan-300 hover:bg-cyan-50/70 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-cyan-300 dark:border-cyan-500/30 dark:bg-slate-950/60 dark:text-cyan-200 dark:hover:border-cyan-400/50 dark:hover:bg-cyan-500/10">
        <span class="inline-flex min-w-0 items-center gap-2">
          <Link2 class="h-4 w-4 shrink-0" stroke-width={2.2} />
          <span class="min-w-0">{t('Need Codex App + CLIProxyAPI setup first?', 'Cần setup Codex App + CLIProxyAPI trước?')}</span>
        </span>
        <ArrowRight class="h-4 w-4 shrink-0 transition group-hover:translate-x-0.5" stroke-width={2.2} />
      </a>
    </section>

    <section class="min-w-0 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-300 bg-slate-50 text-slate-700 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-200">
          <Wrench class="h-5 w-5" stroke-width={2.2} />
        </span>
        <div class="min-w-0">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">{t('Troubleshooting', 'Troubleshooting')}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('Common errors when running ', 'Các lỗi hay gặp khi chạy ')}
            <code class={inlineCode}>remote-control start</code>
            {t(', plus a quick check that your binary exposes the right surface.', ', kèm bước kiểm tra binary có expose đúng command không.')}
          </p>
        </div>
      </div>

      <div class="mt-5 space-y-4">
        <div class="min-w-0 rounded-xl border border-emerald-200 bg-emerald-50/40 p-4 dark:border-emerald-500/30 dark:bg-emerald-950/15 sm:p-5">
          <div class="flex items-start gap-3">
            <CheckCircle2 class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700 dark:text-emerald-300" stroke-width={2.2} />
            <div class="min-w-0">
              <h4 class="text-sm font-bold text-emerald-800 dark:text-emerald-200">{t('Preflight: check the Codex CLI surface', 'Preflight: check command surface của Codex CLI')}</h4>
              <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-300">
                {t('Before using either case, confirm your installed standalone binary exposes ', 'Trước khi dùng bất kỳ case nào, confirm standalone binary expose ')}
                <code class={inlineCode}>remote-control start</code>
                {t(' / ', ' / ')}
                <code class={inlineCode}>remote-control stop</code>
                {t(', --json output, and -c config overrides.', ', output --json, và -c config override.')}
              </p>
            </div>
          </div>
          <div class="mt-4 grid gap-3 md:grid-cols-3">
            <div class="flex min-w-0 gap-3 rounded-xl border border-slate-200 bg-white p-3 text-sm leading-6 text-slate-600 dark:border-slate-800 dark:bg-slate-900/35 dark:text-slate-400">
              <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-300" stroke-width={2.2} />
              <span class="min-w-0 break-words">{t('The standalone path should resolve to the Codex binary.', 'Standalone path cần resolve được tới Codex binary.')}</span>
            </div>
            <div class="flex min-w-0 gap-3 rounded-xl border border-slate-200 bg-white p-3 text-sm leading-6 text-slate-600 dark:border-slate-800 dark:bg-slate-900/35 dark:text-slate-400">
              <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-300" stroke-width={2.2} />
              <span class="min-w-0 break-words">
                <code class={inlineCode}>remote-control start</code>
                {t(' manages the app-server daemon.', ' quản lý app-server daemon.')}
              </span>
            </div>
            <div class="flex min-w-0 gap-3 rounded-xl border border-slate-200 bg-white p-3 text-sm leading-6 text-slate-600 dark:border-slate-800 dark:bg-slate-900/35 dark:text-slate-400">
              <CheckCircle2 class="mt-0.5 h-4 w-4 shrink-0 text-emerald-600 dark:text-emerald-300" stroke-width={2.2} />
              <span class="min-w-0 break-words">
                <code class={inlineCode}>-c</code>
                {t(' overrides are parsed as TOML, so ', ' override được parse như TOML, nên có thể truyền ')}
                <code class={inlineCode}>model_provider</code>
                {t(' and ', ' và ')}
                <code class={inlineCode}>model</code>
                {t(' can be passed per start.', ' theo từng lần start.')}
              </span>
            </div>
          </div>
        </div>

        <div class="min-w-0 rounded-xl border border-amber-200 bg-amber-50/55 p-4 dark:border-amber-500/30 dark:bg-amber-950/15 sm:p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="min-w-0 lg:w-[36%]">
              <div class="flex items-start gap-3">
                <Unplug class="mt-0.5 h-5 w-5 shrink-0 text-amber-700 dark:text-amber-300" stroke-width={2.2} />
                <div class="min-w-0">
                  <h4 class="text-sm font-bold text-amber-800 dark:text-amber-200">{t('"Connection is errored" on start', 'Báo "connection is errored" khi start')}</h4>
                  <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-300">
                    {t('If ', 'Nếu ')}
                    <code class={inlineCode}>remote-control start</code>
                    {t(' returns ', ' báo ')}
                    <code class={inlineCode}>{t('Remote control is enabled on <device> but the connection is errored', 'Remote control is enabled on <device> but the connection is errored')}</code>
                    {t(', the cloud still tracks this device as enrolled but the previous app-server WebSocket ended in an error state (network blip, killed daemon, stale socket). Stop the local daemon first to clear state, then start again. If it persists, toggle the device off in ChatGPT → Remote Control settings before retrying.', ', nghĩa là phía cloud vẫn nhớ enrollment cho máy này nhưng WebSocket lần trước của app-server đã chết (mạng chập, daemon bị kill, socket cũ kẹt). Stop daemon local để clear state trước, rồi start lại. Nếu vẫn lỗi, vào ChatGPT → Remote Control settings tắt thiết bị rồi thử lại.')}
                  </p>
                </div>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <TerminalSnippet code={remoteControlReset} label="shell · reset connection" compact />
            </div>
          </div>
        </div>

        <div class="min-w-0 rounded-xl border border-rose-200 bg-rose-50/45 p-4 dark:border-rose-500/30 dark:bg-rose-950/15 sm:p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="min-w-0 lg:w-[36%]">
              <div class="flex items-start gap-3">
                <TriangleAlert class="mt-0.5 h-5 w-5 shrink-0 text-rose-700 dark:text-rose-300" stroke-width={2.2} />
                <div class="min-w-0">
                  <h4 class="text-sm font-bold text-rose-800 dark:text-rose-200">{t('App-server socket is missing', 'Thiếu socket app-server')}</h4>
                  <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-300">
                    {t('If start fails with ', 'Nếu start fail với ')}
                    <code class={inlineCode}>app server did not become ready</code>
                    {t(' on ', ' ở ')}
                    <code class={inlineCode}>app-server-control.sock</code>
                    {t(', the managed daemon did not create its control socket in time, or the old daemon state is stale. Check the daemon version/status, stop it, then rerun the same start command you chose above.', ', nghĩa là managed daemon chưa tạo control socket kịp, hoặc state daemon cũ bị kẹt. Check version/status của daemon, stop nó, rồi chạy lại đúng start command đã chọn ở trên.')}
                  </p>
                </div>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <TerminalSnippet code={appServerSocketReset} label="shell · socket reset" compact />
            </div>
          </div>
        </div>

        <div class="min-w-0 rounded-xl border border-rose-200 bg-rose-50/45 p-4 dark:border-rose-500/30 dark:bg-rose-950/15 sm:p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start">
            <div class="min-w-0 lg:w-[36%]">
              <div class="flex items-start gap-3">
                <TriangleAlert class="mt-0.5 h-5 w-5 shrink-0 text-rose-700 dark:text-rose-300" stroke-width={2.2} />
                <div class="min-w-0">
                  <h4 class="text-sm font-bold text-rose-800 dark:text-rose-200">{t('OAuth reset path', 'Path reset OAuth')}</h4>
                  <p class="mt-1 text-sm leading-6 text-slate-700 dark:text-slate-300">
                    {t('Last resort — use only when standalone Codex reports ', 'Last resort — chỉ dùng khi standalone Codex báo ')}
                    <code class={inlineCode}>token_revoked</code>
                    {t(' or ', ' hoặc ')}
                    <code class={inlineCode}>refresh_token_reused</code>
                    {t('. Reset OAuth, then rerun ', '. Reset OAuth rồi chạy lại ')}
                    <code class={inlineCode}>remote-control start</code>
                    {t('.', '.')}
                  </p>
                </div>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <TerminalSnippet code={oauthReset} label="shell · reset oauth" compact />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
