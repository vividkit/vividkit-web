---
import { type Language } from '@/i18n';
import TerminalSnippet from '../TerminalSnippet.astro';
import { KeyRound, QrCode } from 'lucide-astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const methods = [
  {
    label: 'A',
    title: t('Server mode', 'Server mode'),
    cmd: 'claude remote-control',
    desc: t('Best when you want a reusable server with URL and QR code.', 'Phù hợp khi muốn server dùng lại với URL và QR code.'),
  },
  {
    label: 'B',
    title: t('Start a named session', 'Start session có tên'),
    cmd: 'claude --remote-control "My Project"',
    desc: t('Open a new Claude Code session with remote enabled immediately.', 'Mở Claude Code session mới kèm remote ngay.'),
  },
  {
    label: 'C',
    title: t('Inside active Claude Code', 'Trong Claude Code đang chạy'),
    cmd: '/remote-control\n# or:\n/rc',
    desc: t('Type this inside the running Claude Code screen.', 'Gõ trong màn hình Claude Code đang mở.'),
    snippetLabel: 'claude · interactive',
    prompt: '>',
    copyText: '/remote-control',
  },
  {
    label: 'D',
    title: t('Enable by default', 'Bật mặc định'),
    cmd: '/config\n# Set: remoteControl: true',
    desc: t('Open Claude Code config, then enable remote control for future sessions.', 'Mở /config trong Claude Code, rồi bật remote control cho session sau.'),
    snippetLabel: 'claude · interactive',
    prompt: '>',
  },
];

const requirements = [
  {
    title: t('Paid plan', 'Paid plan'),
    body: 'Pro / Max / Team / Enterprise',
  },
  {
    title: t('claude.ai login', 'Đăng nhập claude.ai'),
    body: t('Sign in with your claude.ai account. API keys or Console tokens cannot create a remote session.', 'Đăng nhập bằng claude.ai. API key hoặc Console token không tạo được remote session.'),
  },
  {
    title: t('Team / Enterprise admin', 'Admin Team / Enterprise'),
    body: t('For Team or Enterprise, an admin must enable Remote Control in Claude Code settings first.', 'Với Team/Enterprise, admin cần bật Remote Control trong Claude Code settings trước.'),
    href: 'https://claude.ai/admin-settings/claude-code',
    linkLabel: t('Open Claude Code settings', 'Mở Claude Code settings'),
  },
  {
    title: t('Trusted workspace', 'Trusted workspace'),
    body: t('Trust each project once before controlling that session remotely.', 'Trust mỗi project một lần trước khi điều khiển session từ xa.'),
  },
];
---

<div id="remote-control-panel-claude" data-tab-panel="claude" role="tabpanel" aria-labelledby="remote-control-tab-claude">
  <div class="grid gap-5">
    <section class="rounded-2xl border border-amber-200 bg-white p-5 shadow-sm dark:border-amber-500/30 dark:bg-slate-950/75 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-amber-200 bg-amber-50 text-amber-700 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">
          <KeyRound class="h-5 w-5" stroke-width={2.2} />
        </span>
        <div>
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">{t('Claude Code requirements', 'Yêu cầu Claude Code')}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('Check these before debugging QR codes or missing sessions.', 'Check phần này trước khi debug QR code hoặc session không hiện.')}
          </p>
        </div>
      </div>

      <div class="mt-5 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {requirements.map(req => (
          <div class="rounded-xl border border-amber-200/70 bg-amber-50/60 p-4 dark:border-amber-800/30 dark:bg-amber-900/10">
            <div class="text-sm font-bold text-amber-900 dark:text-amber-200">{req.title}</div>
            <div class="mt-1 text-sm leading-6 text-amber-800/80 dark:text-amber-300/75">{req.body}</div>
            {req.href && (
              <a href={req.href} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-xs font-bold text-amber-900 underline decoration-amber-300 underline-offset-4 hover:text-amber-700 dark:text-amber-200 dark:decoration-amber-500/50 dark:hover:text-amber-100">
                {req.linkLabel ?? t('Official requirement', 'Requirement chính thức')}
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
      <div class="flex items-start gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-cyan-200 bg-cyan-50 text-cyan-700 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-200">
          <QrCode class="h-5 w-5" stroke-width={2.2} />
        </span>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-lg font-bold text-slate-950 dark:text-white">{t('Enable remote access', 'Bật remote access')}</h3>
            <span class="rounded-full border border-cyan-200 bg-cyan-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-cyan-700 dark:border-cyan-500/30 dark:bg-cyan-500/10 dark:text-cyan-200">
              {t('choose 1', 'chọn 1')}
            </span>
          </div>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('Pick one entry point. They are alternatives, not steps to run together.', 'Chọn một cách. Đây là các lựa chọn thay thế, không phải các bước chạy cùng nhau.')}
          </p>
        </div>
      </div>

      <div class="mt-5 grid gap-4">
        {methods.map((item) => (
          <article class="min-w-0 rounded-xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-800 dark:bg-slate-900/35 sm:p-5">
            <div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(340px,1.2fr)] lg:items-center">
              <div class="flex min-w-0 items-start gap-4">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-amber-200 bg-amber-100 text-sm font-bold text-amber-900 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-200">{item.label}</span>
                <div class="min-w-0">
                  <h4 class="text-base font-bold leading-snug text-slate-950 dark:text-white">{item.title}</h4>
                  <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">{item.desc}</p>
                </div>
              </div>
              <TerminalSnippet code={item.cmd} label={item.snippetLabel ?? 'shell · claude'} prompt={item.prompt ?? '$'} copyText={item.copyText} />
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</div>
