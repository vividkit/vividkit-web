---
import type { Language } from '@/i18n';
import { windsurfCopy, accentClasses, type Accent } from '@/data/guides/windsurf';
import { Bot, Command, MessageSquareText, Sparkles, Workflow } from 'lucide-astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const copy = windsurfCopy[lang];
const icons = [Sparkles, Command, MessageSquareText, Bot] as const;
---

<section class="relative overflow-hidden rounded-3xl border border-slate-200/70 bg-gradient-to-br from-slate-50 via-white to-teal-50/60 p-6 dark:border-slate-800 dark:from-slate-950 dark:via-slate-950 dark:to-teal-950/20 md:p-10">
  <div class="relative grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <div class="max-w-3xl space-y-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-teal-700 dark:border-teal-800/60 dark:bg-teal-950/35 dark:text-teal-300">
          <span class="h-1.5 w-1.5 rounded-full bg-teal-500"></span>
          {copy.hero.kicker}
        </span>
        <span class="rounded-full border border-slate-200 bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:border-slate-700 dark:bg-slate-900/70 dark:text-slate-400">
          {copy.hero.badge}
        </span>
      </div>

      <div class="space-y-4">
        <h1 class="max-w-4xl text-3xl font-bold tracking-tight text-slate-950 dark:text-white md:text-5xl md:leading-[1.05]">
          {copy.hero.title}
        </h1>
        <p class="max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300 md:text-lg">
          {copy.hero.body}
        </p>
      </div>
    </div>

    <div class="relative min-h-[300px] overflow-hidden rounded-2xl border border-slate-200 bg-slate-950 p-4 shadow-2xl shadow-slate-900/20 dark:border-slate-800">
      <div class="flex items-center gap-2 border-b border-white/10 pb-3">
        <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-teal-400"></span>
        <span class="ml-2 rounded-md bg-white/5 px-2 py-1 text-[11px] font-medium text-slate-400">windsurf workspace</span>
      </div>

      <div class="grid h-[252px] grid-cols-[0.9fr_1.1fr] gap-4 pt-4">
        <div class="space-y-2 rounded-xl border border-white/10 bg-white/[0.03] p-3">
          <div class="h-2 w-20 rounded bg-teal-300/70"></div>
          <div class="h-2 w-28 rounded bg-slate-600"></div>
          <div class="h-2 w-16 rounded bg-slate-700"></div>
          <div class="mt-5 space-y-2">
            <div class="h-8 rounded-lg border border-teal-400/30 bg-teal-400/10"></div>
            <div class="h-8 rounded-lg border border-sky-400/25 bg-sky-400/10"></div>
            <div class="h-8 rounded-lg border border-amber-400/25 bg-amber-400/10"></div>
          </div>
        </div>

        <div class="flex flex-col rounded-xl border border-white/10 bg-white/[0.04]">
          <div class="border-b border-white/10 p-3">
            <div class="flex items-center gap-2">
              <Workflow class="h-4 w-4 text-teal-300" />
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-slate-300">Cascade</span>
            </div>
          </div>
          <div class="flex-1 space-y-3 p-3">
            <div class="rounded-lg bg-white/[0.08] p-3 text-xs leading-relaxed text-slate-300">
              Read context, inspect files, plan edits, run checks.
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div class="rounded-lg border border-teal-300/25 bg-teal-300/10 p-2 text-[11px] text-teal-100">Rules</div>
              <div class="rounded-lg border border-sky-300/25 bg-sky-300/10 p-2 text-[11px] text-sky-100">MCP</div>
              <div class="rounded-lg border border-amber-300/25 bg-amber-300/10 p-2 text-[11px] text-amber-100">Terminal</div>
              <div class="rounded-lg border border-rose-300/25 bg-rose-300/10 p-2 text-[11px] text-rose-100">Hooks</div>
            </div>
            <div class="h-10 rounded-lg border border-dashed border-white/15 bg-white/[0.03]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="space-y-4">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white md:text-3xl">
    {copy.decisionsTitle}
  </h2>
  <div class="grid gap-4 md:grid-cols-2">
    {copy.decisions.map(([title, body, accent], index) => {
      const Icon = icons[index];
      const a = accentClasses[accent as Accent];
      return (
        <article class={`rounded-2xl border p-5 ${a.border} ${a.soft}`}>
          <div class="flex items-start gap-3">
            <div class={`flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border bg-white/80 shadow-sm dark:bg-slate-950/35 ${a.border} ${a.text}`}>
              <Icon class="h-5 w-5" stroke-width={2.1} />
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-slate-900 dark:text-white">{title}</h3>
              <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">{body}</p>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
