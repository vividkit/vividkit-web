---
import { BadgeCheck, Heart, Landmark, QrCode, ShieldCheck } from 'lucide-astro';
import { getLangFromUrl, type Language } from '@/i18n';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const bankDetails = [
  { label: t('guides.donate.account_name_label'), value: 'NGUYEN VAN THIEU' },
  { label: t('guides.donate.account_number_label'), value: '0983459610' },
  { label: t('guides.donate.bank_label'), value: 'MB Bank' },
];
---

<section class="space-y-10">
  <div class="relative overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-xl shadow-slate-200/70 dark:border-white/10 dark:bg-slate-950 dark:shadow-black/25">
    <div aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(135deg,rgba(244,63,94,0.12),transparent_32%,rgba(14,165,233,0.10)_58%,rgba(16,185,129,0.12))] dark:bg-[linear-gradient(135deg,rgba(244,63,94,0.16),transparent_34%,rgba(14,165,233,0.14)_62%,rgba(16,185,129,0.14))]"></div>
    <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-rose-400 via-sky-400 to-emerald-400"></div>

    <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:grid-rows-[auto_auto] lg:items-start lg:p-10">
      <div class="order-1 lg:col-start-1 lg:row-start-1">
        <p class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-white/80 px-3 py-1 text-xs font-black uppercase tracking-[0.16em] text-rose-700 shadow-sm dark:border-rose-400/20 dark:bg-white/10 dark:text-rose-200">
          <Heart class="h-3.5 w-3.5" aria-hidden="true" />
          {t('guides.donate.kicker')}
        </p>
        <h1 class="mt-5 max-w-2xl text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
          {t('guides.donate.title')}
        </h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700 dark:text-slate-300">
          {t('guides.donate.description')}
        </p>

        <div class="mt-7 flex flex-wrap gap-2">
          <span class="inline-flex min-h-11 items-center gap-2 rounded-full border border-sky-200 bg-white/80 px-4 text-sm font-black text-sky-700 shadow-sm dark:border-sky-400/20 dark:bg-white/10 dark:text-sky-200">
            <QrCode class="h-4 w-4" aria-hidden="true" />
            VietQR
          </span>
          <span class="inline-flex min-h-11 items-center gap-2 rounded-full border border-emerald-200 bg-white/80 px-4 text-sm font-black text-emerald-700 shadow-sm dark:border-emerald-400/20 dark:bg-white/10 dark:text-emerald-200">
            <BadgeCheck class="h-4 w-4" aria-hidden="true" />
            MB Bank
          </span>
        </div>

      </div>

      <div class="order-2 mx-auto w-full max-w-sm lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:self-center">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-3 shadow-2xl shadow-slate-300/60 dark:border-white/10 dark:bg-white/[0.06] dark:shadow-black/30">
          <img
            src="/guides/donate/mb-vietqr-nguyen-van-thieu.png"
            alt={t('guides.donate.qr_alt')}
            class="aspect-[1170/2532] w-full rounded-[1.5rem] object-cover"
            width="1170"
            height="2532"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <dl class="order-3 grid gap-3 border-t border-slate-200/80 pt-6 dark:border-white/10 sm:grid-cols-2 lg:col-start-1 lg:row-start-2">
        {bankDetails.map((item) => (
          <div class:list={[
            'min-w-0 rounded-2xl border border-white/70 bg-white/70 px-4 py-3 shadow-sm dark:border-white/10 dark:bg-white/[0.06]',
            item.value === 'NGUYEN VAN THIEU' && 'sm:col-span-2',
          ]}>
            <dt class="text-[0.68rem] font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">{item.label}</dt>
            <dd class="mt-2 max-w-full overflow-x-auto whitespace-nowrap text-base font-black leading-6 text-slate-950 dark:text-white sm:text-lg">
              {item.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <QrCode class="h-6 w-6 text-blue-600 dark:text-blue-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.step_scan_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.step_scan_desc')}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <Landmark class="h-6 w-6 text-emerald-600 dark:text-emerald-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.step_bank_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.step_bank_desc')}</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-white/10 dark:bg-slate-950/70">
      <ShieldCheck class="h-6 w-6 text-rose-600 dark:text-rose-300" aria-hidden="true" />
      <h2 class="mt-4 text-base font-black text-slate-950 dark:text-white">{t('guides.donate.step_note_title')}</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{t('guides.donate.step_note_desc')}</p>
    </div>
  </div>
</section>
