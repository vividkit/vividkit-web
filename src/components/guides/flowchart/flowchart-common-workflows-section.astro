---
// FlowchartGuide common workflows section
import { getLangFromUrl, type Language } from "@/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
const t = useTranslations(currentLang);
---

  <!-- Common Workflows -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3
      class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2"
    >
      <svg
        class="w-5 h-5 text-teal-500"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <polyline
          points="22 12 18 12 15 21 9 3 6 12 2 12"
          stroke-linecap="round"
          stroke-linejoin="round"></polyline>
      </svg>
      {isVi ? "Common Workflows" : "Common Workflows"}
    </h3>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Workflow 1: Safe Approach (v2.5.0+) -->
      <div
        class="p-5 rounded-xl bg-purple-500/5 border border-purple-200 dark:border-purple-500/20 fc-stable-content"
      >
        <h4 class="font-bold text-purple-700 dark:text-purple-400 mb-3">
          {
            isVi
              ? "Workflow 1: Build Feature (Safe)"
              : "Workflow 1: Building a New Feature (Safe)"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-purple-600 dark:text-purple-400"
              >/brainstorm</code
            > → {isVi ? "Khám phá options" : "Explore options"}
          </p>
          <p>
            2. <code class="text-purple-600 dark:text-purple-400">/plan</code> → {
              isVi ? "Review plan" : "Review plan"
            }
          </p>
          <p>
            3. <code class="text-slate-500">/clear</code>
            {isVi ? "hoặc" : "or"}
            <code class="text-slate-500">/compact</code>
          </p>
          <p>
            4. <code class="text-purple-600 dark:text-purple-400"
              >/cook @plan.md</code
            > → {isVi ? "Implement" : "Implementation"}
          </p>
          <p>
            5. <code class="text-indigo-600 dark:text-indigo-400">/git cp</code> →
            Push
          </p>
          <p>
            6. <code class="text-indigo-600 dark:text-indigo-400">/git pr</code> →
            PR
          </p>
        </div>
      </div>

      <!-- Workflow 1: Safe Approach (v2.4.x) -->
      <div
        class="p-5 rounded-xl bg-purple-500/5 border border-purple-200 dark:border-purple-500/20 fc-beta-content hidden"
      >
        <h4 class="font-bold text-purple-700 dark:text-purple-400 mb-3">
          {
            isVi
              ? "Workflow 1: Build Feature (Safe)"
              : "Workflow 1: Building a New Feature (Safe)"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-purple-600 dark:text-purple-400"
              >/brainstorm</code
            > → {isVi ? "Khám phá options" : "Explore options"}
          </p>
          <p>
            2. <code class="text-purple-600 dark:text-purple-400">/plan</code> → {
              isVi ? "Review plan" : "Review plan"
            }
          </p>
          <p>
            3. <code class="text-slate-500">/clear</code>
            {isVi ? "hoặc" : "or"}
            <code class="text-slate-500">/compact</code>
          </p>
          <p>
            4. <code class="text-purple-600 dark:text-purple-400"
              >/code @plan.md</code
            > → {isVi ? "Implement" : "Implementation"}
          </p>
          <p>
            5. <code class="text-indigo-600 dark:text-indigo-400">/git:cp</code> →
            Push
          </p>
          <p>
            6. <code class="text-indigo-600 dark:text-indigo-400">/git:pr</code> →
            PR
          </p>
        </div>
      </div>

      <!-- Workflow 2: Fast Approach -->
      <div
        class="p-5 rounded-xl bg-emerald-500/5 border border-emerald-200 dark:border-emerald-500/20 fc-stable-content"
      >
        <h4 class="font-bold text-emerald-700 dark:text-emerald-400 mb-3">
          {
            isVi
              ? "Workflow 2: Build Feature (Fast)"
              : "Workflow 2: Building a Feature (Fast)"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-emerald-600 dark:text-emerald-400">/cook</code> →
            {
              isVi
                ? "Research → Plan → Implement → Test → Review"
                : "Research → Plan → Implement → Test → Review"
            }
          </p>
          <p>
            2. <code class="text-indigo-600 dark:text-indigo-400">/git cp</code> →
            {
              isVi
                ? "Commit và push khi approved"
                : "Commit and push when approved"
            }
          </p>
        </div>
      </div>
      <div
        class="p-5 rounded-xl bg-emerald-500/5 border border-emerald-200 dark:border-emerald-500/20 fc-beta-content hidden"
      >
        <h4 class="font-bold text-emerald-700 dark:text-emerald-400 mb-3">
          {
            isVi
              ? "Workflow 2: Build Feature (Fast)"
              : "Workflow 2: Building a Feature (Fast)"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-emerald-600 dark:text-emerald-400">/cook</code> →
            {
              isVi
                ? "Research → Plan → Implement → Test → Review"
                : "Research → Plan → Implement → Test → Review"
            }
          </p>
          <p>
            2. <code class="text-indigo-600 dark:text-indigo-400">/git:cp</code> →
            {
              isVi
                ? "Commit và push khi approved"
                : "Commit and push when approved"
            }
          </p>
        </div>
      </div>

      <!-- Workflow 3: Debugging -->
      <div
        class="p-5 rounded-xl bg-orange-500/5 border border-orange-200 dark:border-orange-500/20 fc-stable-content"
      >
        <h4 class="font-bold text-orange-700 dark:text-orange-400 mb-3">
          {
            isVi
              ? "Workflow 3: Debugging & Fixing"
              : "Workflow 3: Debugging & Fixing"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-orange-600 dark:text-orange-400">/debug</code> →
            {isVi ? "Tìm root cause" : "Find root cause"}
          </p>
          <p>
            2. <code class="text-red-600 dark:text-red-400">/fix</code> → {
              isVi ? "Smart routing" : "Smart routing"
            }
          </p>
          <p>
            3. <code class="text-indigo-600 dark:text-indigo-400">/git cm</code> →
            {isVi ? "Commit fix locally" : "Commit fix locally"}
          </p>
        </div>
      </div>
      <div
        class="p-5 rounded-xl bg-orange-500/5 border border-orange-200 dark:border-orange-500/20 fc-beta-content hidden"
      >
        <h4 class="font-bold text-orange-700 dark:text-orange-400 mb-3">
          {
            isVi
              ? "Workflow 3: Debugging & Fixing"
              : "Workflow 3: Debugging & Fixing"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-orange-600 dark:text-orange-400">/debug</code> →
            {isVi ? "Tìm root cause" : "Find root cause"}
          </p>
          <p>
            2. <code class="text-red-600 dark:text-red-400">/fix</code> → {
              isVi ? "Smart routing" : "Smart routing"
            }
          </p>
          <p>
            3. <code class="text-indigo-600 dark:text-indigo-400">/git:cm</code> →
            {isVi ? "Commit fix locally" : "Commit fix locally"}
          </p>
        </div>
      </div>

      <!-- Workflow 4: New Project -->
      <div
        class="p-5 rounded-xl bg-amber-500/5 border border-amber-200 dark:border-amber-500/20"
      >
        <h4 class="font-bold text-amber-700 dark:text-amber-400 mb-3">
          {
            isVi
              ? "Workflow 4: New Project Setup"
              : "Workflow 4: New Project Setup"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-amber-600 dark:text-amber-400">/bootstrap</code
            > → {isVi ? "Full setup" : "Full setup"}
          </p>
          <p>
            2. {isVi ? "Follow onboarding" : "Follow onboarding instructions"}
          </p>
        </div>
      </div>

      <!-- Workflow 5: Join Existing -->
      <div
        class="p-5 rounded-xl bg-cyan-500/5 border border-cyan-200 dark:border-cyan-500/20"
      >
        <h4 class="font-bold text-cyan-700 dark:text-cyan-400 mb-3">
          {
            isVi
              ? "Workflow 5: Tham gia dự án"
              : "Workflow 5: Joining Existing Project"
          }
        </h4>
        <div
          class="text-sm text-slate-600 dark:text-slate-400 space-y-1 font-mono"
        >
          <p>
            1. <code class="text-cyan-600 dark:text-cyan-400">/docs:init</code> →
            {isVi ? "Analyze codebase" : "Analyze codebase, create docs"}
          </p>
          <p>
            2. <code class="text-cyan-600 dark:text-cyan-400">/scout</code> → {
              isVi ? "Explore structure" : "Explore codebase structure"
            }
          </p>
        </div>
      </div>
    </div>
  </div>

