---
// FlowchartGuide Marketing Kit summary section
import { getLangFromUrl, type Language } from "@/i18n";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
---

<!-- Marketing Summary & Help -->
<div class="glass-card rounded-2xl p-6 sm:p-8">
  <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
    <svg class="w-5 h-5 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    {isVi ? "Tổng Kết & Trợ Giúp" : "Summary & Help"}
  </h3>

  <div class="grid md:grid-cols-3 gap-6">
    <!-- Quick Start -->
    <div class="p-4 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
      <h4 class="font-semibold text-green-700 dark:text-green-400 mb-3">
        {isVi ? "Bắt Đầu Nhanh" : "Quick Start"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
        <p><code class="text-green-600 dark:text-green-400">/ckm:init</code> → {isVi ? "Setup workspace" : "Setup workspace"}</p>
        <p><code class="text-violet-600 dark:text-violet-400">/ck:brainstorm</code> → {isVi ? "Bắt đầu ideation" : "Start ideation"}</p>
      </div>
    </div>

    <!-- Get Help -->
    <div class="p-4 rounded-lg bg-indigo-50 dark:bg-indigo-900/20 border border-indigo-200 dark:border-indigo-800">
      <h4 class="font-semibold text-indigo-700 dark:text-indigo-400 mb-3">
        {isVi ? "Cần Trợ Giúp?" : "Need Help?"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
        <p><code class="text-indigo-600 dark:text-indigo-400">/ckm:watzup</code> → {isVi ? "Session summary" : "Session summary"}</p>
        <p><code class="text-indigo-600 dark:text-indigo-400">/ck:ask</code> → {isVi ? "Hỏi expert" : "Ask expert"}</p>
        <p><code class="text-indigo-600 dark:text-indigo-400">/ck:coding-level</code> → {isVi ? "Adjust depth" : "Adjust depth"}</p>
      </div>
    </div>

    <!-- Resources -->
    <div class="p-4 rounded-lg bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800">
      <h4 class="font-semibold text-purple-700 dark:text-purple-400 mb-3">
        {isVi ? "Tài Nguyên" : "Resources"}
      </h4>
      <div class="text-sm text-slate-600 dark:text-slate-400 space-y-2">
        <a href={isVi ? "/vi/guides/commands" : "/guides/commands"} class="block hover:text-purple-600 dark:hover:text-purple-400">
          → {isVi ? "Tất cả Commands" : "All Commands"}
        </a>
        <a href={isVi ? "/vi/guides/workflows" : "/guides/workflows"} class="block hover:text-purple-600 dark:hover:text-purple-400">
          → {isVi ? "Workflows Guide" : "Workflows Guide"}
        </a>
        <a href={isVi ? "/vi/guides/what-is-claudekit" : "/guides/what-is-claudekit"} class="block hover:text-purple-600 dark:hover:text-purple-400">
          → {isVi ? "ClaudeKit là gì?" : "What is ClaudeKit?"}
        </a>
      </div>
    </div>
  </div>

  <!-- Version Info -->
  <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
    <div class="flex flex-wrap items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-500"></span>
        {isVi ? "Stable v1.4.0" : "Stable v1.4.0"}: /ckm:*
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-purple-500"></span>
        {isVi ? "Cross-kit Skills" : "Cross-kit Skills"}: /ck:*
      </span>
    </div>
  </div>
</div>
