---
// FlowchartGuide command categories sub-component
import { getLangFromUrl, type Language } from "@/i18n";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
const t = useTranslations(currentLang);
---

<!-- Command Categories 1-4: New Project Setup, Feature Building, Fixing Issues, Git Operations -->
<!-- 1. New Project Setup -->
    <div class="glass-card rounded-2xl p-6 sm:p-8">
      <h3
        class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
      >
        <svg
          class="w-5 h-5 text-amber-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {isVi ? "Khởi Tạo Dự Án Mới" : "New Project Setup"}
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[180px] whitespace-nowrap"
                >Command</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Mô tả" : "Description"}</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Khi nào dùng" : "When to Use"}</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-amber-500/20 text-amber-600 dark:text-amber-400 font-mono font-bold"
                  >/ck:bootstrap</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Khởi tạo dự án đầy đủ với research, tech stack, planning, design, implementation"
                    : "Full project initialization with research, tech stack, planning, design, implementation"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Bắt đầu dự án hoàn toàn mới"
                    : "Starting a brand new project from scratch"
                }</td
              >
            </tr>
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-mono font-bold"
                  >/ck:docs init</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Phân tích codebase và tạo documentation"
                    : "Analyze existing codebase and create documentation"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Tham gia dự án có sẵn hoặc setup docs"
                    : "Joining an existing project or setting up docs"
                }</td
              >
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="mt-4 p-4 rounded-lg bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20"
      >
        <p class="text-sm text-emerald-700 dark:text-emerald-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-emerald-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path></svg
            >
            {isVi ? "Mẹo:" : "Tip:"}</strong
          >
          {
            isVi
              ? "New Project Flow: /bootstrap → tự động xử lý mọi thứ bao gồm Git init, tech stack research, wireframes và initial implementation."
              : "New Project Flow: /bootstrap → automatically handles everything including Git initialization, tech stack research, wireframes, and initial implementation."
          }
        </p>
      </div>
    </div>

    <!-- 2. Feature Building -->
    <div class="glass-card rounded-2xl p-6 sm:p-8">
      <h3
        class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
      >
        <svg
          class="w-5 h-5 text-emerald-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {isVi ? "Xây Dựng Feature" : "Feature Building"}
      </h3>

      <!-- Don't Know What You Want Yet -->
      <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-3">
        {isVi ? "Chưa biết muốn gì" : "Don't Know What You Want Yet"}
      </h4>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[180px] whitespace-nowrap"
                >Command</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Mô tả" : "Description"}</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Khi nào dùng" : "When to Use"}</th
              >
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-violet-500/20 text-violet-600 dark:text-violet-400 font-mono font-bold"
                  >/ck:brainstorm</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Ideation với lời khuyên chuyên gia"
                    : "Collaborative ideation with expert advice"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Khám phá ý tưởng, validate approaches, xem pros/cons"
                    : "Exploring ideas, validating approaches, getting pros/cons"
                }</td
              >
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="mb-6 p-4 rounded-lg bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 fc-stable-content"
      >
        <p class="text-sm text-amber-700 dark:text-amber-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-amber-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path></svg
            >
            {isVi ? "Quan trọng:" : "Important:"}</strong
          >
          {
            isVi
              ? "/brainstorm KHÔNG implement - chỉ tư vấn. Sau khi brainstorm, dùng /ck:plan hoặc /ck:cook để implement."
              : "/brainstorm DOES NOT implement - it only advises. After brainstorming, use /ck:plan or /ck:cook to implement."
          }
        </p>
      </div>
      <div
        class="mb-6 p-4 rounded-lg bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 fc-beta-content hidden"
      >
        <p class="text-sm text-amber-700 dark:text-amber-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-amber-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path></svg
            >
            {isVi ? "Quan trọng:" : "Important:"}</strong
          >
          {
            isVi
              ? "/brainstorm KHÔNG implement - chỉ tư vấn. Sau khi brainstorm, dùng /ck:plan hoặc /ck:cook để implement."
              : "/brainstorm DOES NOT implement - it only advises. After brainstorming, use /ck:plan or /ck:cook to implement."
          }
        </p>
      </div>

      <!-- Know What You Want -->
      <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-3">
        {isVi ? "Biết muốn gì" : "Know What You Want"}
      </h4>
      <div class="overflow-x-auto mb-4">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[180px] whitespace-nowrap"
                >Command</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Mô tả" : "Description"}</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Khi nào dùng" : "When to Use"}</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <tr class="fc-stable-content">
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold"
                  >/ck:cook</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >⚡⚡⚡ All-in-one: research → plan → implement → test → review</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                ><strong>FAST mode</strong> - {
                  isVi
                    ? "Quick iterations, features đơn giản"
                    : "Quick iterations, simpler features"
                }</td
              >
            </tr>
            <tr class="fc-beta-content hidden">
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold"
                  >/ck:cook</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >⚡⚡⚡ All-in-one: research → plan → implement → test → review</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                ><strong>FAST mode</strong> - {
                  isVi
                    ? "Quick iterations, features đơn giản"
                    : "Quick iterations, simpler features"
                }</td
              >
            </tr>
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 font-mono font-bold"
                  >/ck:plan</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Tạo plan chi tiết không code"
                    : "Create detailed implementation plan without coding"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                ><strong>SAFE mode</strong> - {
                  isVi
                    ? "Features phức tạp, cần approval trước"
                    : "Complex features, need approval first"
                }</td
              >
            </tr>
            <tr class="fc-stable-content">
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-blue-500/20 text-blue-600 dark:text-blue-400 font-mono font-bold"
                  >/ck:cook @plan.md</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Implement plan có sẵn từng bước"
                    : "Implement an existing plan step by step"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Sau khi /ck:plan được approved"
                    : "After /ck:plan is approved"
                }</td
              >
            </tr>
            <tr class="fc-beta-content hidden">
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-blue-500/20 text-blue-600 dark:text-blue-400 font-mono font-bold"
                  >/code @plan.md</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Execute plan có sẵn từng bước"
                    : "Execute an existing plan step by step"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Sau khi /ck:plan được approved"
                    : "After /ck:plan is approved"
                }</td
              >
            </tr>
          </tbody>
        </table>
      </div>
      <div
        class="p-4 rounded-lg bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 fc-stable-content"
      >
        <p class="text-sm text-blue-700 dark:text-blue-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-blue-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
              ></path></svg
            >
            {isVi ? "Sự khác biệt chính:" : "Key Difference:"}</strong
          ><br />
          • <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/ck:cook</code> =
          {
            isVi
              ? "Tốc độ, plan nội bộ, straight to implementation"
              : "Speed-focused, plans internally, goes straight to implementation"
          }<br />
          • <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/ck:plan</code> →
          <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/ck:cook</code> = {
            isVi
              ? "An toàn, tạo plan có thể review trước"
              : "Safety-focused, creates reviewable plan first"
          }
        </p>
      </div>
      <div
        class="p-4 rounded-lg bg-blue-500/10 border border-blue-200 dark:border-blue-500/20 fc-beta-content hidden"
      >
        <p class="text-sm text-blue-700 dark:text-blue-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-blue-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
              ></path></svg
            >
            {isVi ? "Sự khác biệt chính:" : "Key Difference:"}</strong
          ><br />
          • <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/ck:cook</code> =
          {
            isVi
              ? "Tốc độ, plan nội bộ, straight to implementation"
              : "Speed-focused, plans internally, goes straight to implementation"
          }<br />
          • <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/ck:plan</code> →
          <code class="bg-blue-200 dark:bg-blue-800 px-1 rounded">/code</code> = {
            isVi
              ? "An toàn, tạo plan có thể review trước"
              : "Safety-focused, creates reviewable plan first"
          }
        </p>
      </div>
    </div>

    <!-- 3. Fixing Issues -->
    <div class="glass-card rounded-2xl p-6 sm:p-8">
      <h3
        class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
      >
        <svg
          class="w-5 h-5 text-orange-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {isVi ? "Sửa Lỗi" : "Fixing Issues"}
      </h3>

      <!-- Diagnostic First -->
      <h4 class="font-semibold text-slate-800 dark:text-slate-200 mb-3">
        {isVi ? "Chẩn đoán trước" : "Diagnostic First"}
      </h4>
      <div class="overflow-x-auto mb-6">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[180px] whitespace-nowrap"
                >Command</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Mô tả" : "Description"}</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Khi nào dùng" : "When to Use"}</th
              >
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-orange-500/20 text-orange-600 dark:text-orange-400 font-mono font-bold"
                  >/ck:debug</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Phân tích và tìm root cause"
                    : "Analyze and find root cause"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{isVi ? "Không biết lỗi gì" : "Don't know what's wrong"}</td
              >
            </tr>
            <tr>
              <td class="py-3 px-4"
                ><code
                  class="px-2 py-1 rounded bg-red-500/20 text-red-600 dark:text-red-400 font-mono font-bold"
                  >/ck:fix</code
                ></td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Smart fix routing - tự động route theo loại issue"
                    : "Smart fix routing - auto routes by issue type"
                }</td
              >
              <td class="py-3 px-4 text-slate-600 dark:text-slate-400"
                >{
                  isVi
                    ? "Biết issue, muốn fix nhanh"
                    : "Know the issue, want quick fix"
                }</td
              >
            </tr>
          </tbody>
        </table>
      </div>

      <div
        class="mt-4 p-4 rounded-lg bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20"
      >
        <p class="text-sm text-emerald-700 dark:text-emerald-400">
          <strong class="flex items-center gap-1"
            ><svg
              class="w-4 h-4 text-emerald-500 inline"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
              ></path></svg
            >
            {isVi ? "Smart Routing:" : "Smart Routing:"}</strong
          >
          {
            isVi
              ? "Chỉ cần dùng /fix <mô tả issue> và nó sẽ tự động route tới command chuyên biệt phù hợp!"
              : "Just use /fix <describe issue> and it will automatically route to the right specialized command!"
          }
        </p>
      </div>
    </div>

    <!-- 4. Git Operations -->
    <!-- v2.5.0+ Git Operations (git skill) -->
    <div class="glass-card rounded-2xl p-6 sm:p-8 fc-stable-content">
      <h3
        class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2"
      >
        <svg
          class="w-5 h-5 text-indigo-500"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="18" cy="18" r="3"></circle>
          <circle cx="6" cy="6" r="3"></circle>
          <path
            d="M6 21V9a9 9 0 0 0 9 9"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        {isVi ? "Git Operations" : "Git Operations"}
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="border-b border-slate-200 dark:border-slate-700">
            <tr>
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[180px] whitespace-nowrap"
                >Command</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Mô tả" : "Description"}</th
              >
              <th
                class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white"
                >{isVi ? "Options" : "Options"}</th
              >
            </tr>
          </thead>
