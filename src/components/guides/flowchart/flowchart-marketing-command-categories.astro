---
// FlowchartGuide Marketing Kit command categories
import { getLangFromUrl, type Language } from "@/i18n";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const isVi = currentLang === "vi";
---

<!-- Marketing Command Categories -->
<div class="space-y-8">
  <!-- 1. Essentials & Learning -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Bắt Đầu & Học ClaudeKit" : "Getting Started & Learning"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-green-500/20 text-green-600 dark:text-green-400 font-mono font-bold">/ckm:init</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Setup workspace marketing với brand, personas, templates" : "Setup marketing workspace with brand, personas, templates"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Chuẩn bị môi trường làm việc" : "Preparing your marketing workspace"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 2. Campaign Management -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Quản Lý Campaigns" : "Campaign Management"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 font-mono font-bold">/ckm:campaign</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Tạo & quản lý campaigns multi-channel" : "Create & manage multi-channel campaigns"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Launch campaigns phức hợp" : "Launching complex campaigns"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 font-mono font-bold">/ckm:email</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Thiết kế email flows & sequences" : "Design email flows & nurture sequences"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Email marketing, drip campaigns" : "Email marketing, drip campaigns"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-purple-500/20 text-purple-600 dark:text-purple-400 font-mono font-bold">/ckm:social</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Schedule & quản lý social content" : "Schedule & manage social content"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Social media marketing" : "Social media campaigns"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 3. Content Creation -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-pink-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Tạo Content" : "Content Creation"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-pink-500/20 text-pink-600 dark:text-pink-400 font-mono font-bold">/ckm:write:*</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Tạo content — 8 subcommand: write:good, write:fast, write:cro, write:blog..." : "Create content — 8 subcommands: write:good, write:fast, write:cro, write:blog..."}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Viết blogs, copy, marketing content" : "Writing blogs, copy, marketing content"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-pink-500/20 text-pink-600 dark:text-pink-400 font-mono font-bold">/ckm:video</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Tạo video scripts & storyboards" : "Create video scripts & storyboards"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Video marketing, YouTube" : "Video marketing, YouTube content"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-pink-500/20 text-pink-600 dark:text-pink-400 font-mono font-bold">/ckm:slides</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Tạo pitch decks & presentations" : "Create pitch decks & presentations"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Sales pitches, training materials" : "Sales pitches, training materials"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 4. Strategy & Playbook -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Chiến Lược & Playbook" : "Strategy & Playbook"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold">/ckm:play</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Marketing playbook orchestrator — chiến lược + thực thi AI + theo dõi mục tiêu" : "Marketing playbook orchestrator — strategy + AI execution + goal tracking"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Điều phối chiến lược marketing" : "Orchestrate marketing strategy"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold">/ckm:persona</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Tạo & quản lý customer personas" : "Create & manage customer personas"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Xác định & quản lý target audience" : "Defining & managing target audience"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold">/ckm:journal</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Viết journal cho các phiên marketing" : "Write journal entries for marketing sessions"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Ghi lại tiến độ & insight từng phiên" : "Logging session progress & insights"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 5. Analysis & Strategy -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Phân Tích & Chiến Lược" : "Analysis & Strategy"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-blue-500/20 text-blue-600 dark:text-blue-400 font-mono font-bold">/ckm:competitor</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Phân tích đối thủ cạnh tranh" : "Competitive analysis & research"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Market research, positioning" : "Market research, positioning"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-blue-500/20 text-blue-600 dark:text-blue-400 font-mono font-bold">/ckm:seo</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "SEO audit & keyword research" : "SEO audit & keyword research"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "SEO optimization, pSEO" : "SEO optimization, pSEO pages"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-blue-500/20 text-blue-600 dark:text-blue-400 font-mono font-bold">/ckm:funnel</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Thiết kế & tối ưu funnels" : "Design & optimize conversion funnels"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Funnel optimization" : "Funnel optimization"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 6. Analytics & Management -->
  <div class="glass-card rounded-2xl p-6 sm:p-8">
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-teal-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {isVi ? "Phân Tích & Quản Lý" : "Analytics & Management"}
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200 dark:border-slate-700">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white min-w-[160px]">Command</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Mô tả" : "Description"}</th>
            <th class="text-left py-3 px-4 font-semibold text-slate-900 dark:text-white">{isVi ? "Khi nào dùng" : "When to Use"}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-teal-500/20 text-teal-600 dark:text-teal-400 font-mono font-bold">/ckm:analyze</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Báo cáo analytics & hiệu suất" : "Analytics & performance reports"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Phân tích hiệu suất chiến dịch" : "Analyzing campaign performance"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-teal-500/20 text-teal-600 dark:text-teal-400 font-mono font-bold">/ckm:dashboard</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Dashboard analytics marketing (web)" : "Marketing analytics dashboard (web)"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Xem tổng quan metrics trực quan" : "Viewing metrics at a glance"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-mono font-bold">/ckm:kanban</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Quản lý tasks dạng kanban board" : "Manage tasks with kanban board"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Task management" : "Marketing task management"}</td>
          </tr>
          <tr>
            <td class="py-3 px-4"><code class="px-2 py-1 rounded bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-mono font-bold">/ckm:brand</code></td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Quản lý brand guidelines" : "Manage brand guidelines"}</td>
            <td class="py-3 px-4 text-slate-600 dark:text-slate-400">{isVi ? "Brand consistency" : "Brand consistency"}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
