          ><br />
          • <code class="bg-emerald-200 dark:bg-emerald-800 px-1 rounded"
            >0</code
          > = ELI5 ({isVi ? "không biết code" : "zero coding experience"})<br />
          • <code class="bg-emerald-200 dark:bg-emerald-800 px-1 rounded"
            >1</code
          > = Junior (0-2 {isVi ? "năm" : "years"})<br />
          • <code class="bg-emerald-200 dark:bg-emerald-800 px-1 rounded"
            >2</code
          > = Mid-Level (3-5 {isVi ? "năm" : "years"})<br />
          • <code class="bg-emerald-200 dark:bg-emerald-800 px-1 rounded"
            >3</code
          > = Senior (5-8 {isVi ? "năm" : "years"})<br />
          • <code class="bg-emerald-200 dark:bg-emerald-800 px-1 rounded"
            >4</code
          > = Tech Lead (8-10 {isVi ? "năm" : "years"})<br />
