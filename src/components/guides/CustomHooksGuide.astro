---
import { getLangFromUrl, type Language } from "@/i18n";
import {
  hookCategories,
} from "@/data/guides/custom-hooks/custom-hooks-data";
import { customHooksTranslations } from "@/data/guides/custom-hooks/custom-hooks-translations";
import CustomHooksIntroduction from "./custom-hooks/custom-hooks-introduction.astro";
import CustomHooksCategorySection from "./custom-hooks/custom-hooks-category-section.astro";
import {
  buildHookViewModels,
  flattenHooks,
} from "./custom-hooks/custom-hooks-ui";

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = customHooksTranslations[currentLang] || customHooksTranslations.en;
const isVi = currentLang === "vi";

const categoryModels = buildHookViewModels(hookCategories);
const allHooks = flattenHooks(categoryModels);
const totalHooks = allHooks.length;
const totalCategories = categoryModels.length;

const stats = [
  { value: totalHooks, label: t.statHooks },
  { value: totalCategories, label: t.statCategories },
];

// Default-state legend, in the same order as the badge states (active → dormant
// → opt-in) so each chip matches the colored badge on the hook rows. Defined
// locally rather than in the shared `t` object to avoid Astro duplicating the
// inline object type across child-component prop boundaries.
const defaultStateLegend = [
  {
    dot: "bg-emerald-500",
    label: isVi ? "Bật sẵn" : "Active by default",
    desc: isVi
      ? "Đã wire và flag bật, nên chạy ngay trên bản cài mới."
      : "Wired and flag-on, so it runs on a fresh install.",
  },
  {
    dot: "bg-amber-500",
    label: isVi ? "Bật · gate tắt" : "Active · gate off",
    desc: isVi
      ? "Vẫn chạy, nhưng gate bên trong chưa bật nên không chặn gì."
      : "Runs, but its inner gate blocks nothing until you enable it.",
  },
  {
    dot: "bg-slate-400 dark:bg-slate-500",
    label: isVi ? "Cần bật" : "Opt-in",
    desc: isVi
      ? "Chưa wire hoặc flag tắt, nên nằm im cho tới khi bạn bật."
      : "Not wired or flag-off, so it stays inactive until you turn it on.",
  },
];

// Secondary hints sit in a 2-column grid below the featured default-state block,
// so the taller default block no longer leaves the other two cards stranded with
// empty space beside it.
const secondaryHints = [
  {
    num: 2,
    title: t.catalogHintDisableTitle,
    desc: t.catalogHintDisableDesc,
    accent: "border-blue-200 bg-blue-50/70 text-blue-800 dark:border-blue-500/25 dark:bg-blue-500/10 dark:text-blue-200",
  },
  {
    num: 3,
    title: t.catalogHintFailureTitle,
    desc: t.catalogHintFailureDesc,
    accent: "border-amber-200 bg-amber-50/75 text-amber-900 dark:border-amber-500/25 dark:bg-amber-500/10 dark:text-amber-100",
  },
];
---

<div
  id="custom-hooks-catalog"
  class="mt-4 space-y-7"
>
  <CustomHooksIntroduction t={t} stats={stats} />

  <section id="hook-list" class="scroll-mt-28 space-y-6">
    <div class="border-y border-slate-200 py-6 dark:border-slate-800">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase text-blue-600 dark:text-blue-400">
          {t.catalogLabel}
        </p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
          {t.catalogTitle}
        </h2>
        <p class="mt-2 text-base leading-7 text-slate-600 dark:text-slate-300">
          {t.catalogDesc}
        </p>
      </div>

      <div class="hook-hint-prose mt-5 space-y-3">
        <div class="rounded-lg border border-emerald-200 bg-emerald-50/70 p-4 text-emerald-800 dark:border-emerald-500/25 dark:bg-emerald-500/10 dark:text-emerald-200">
          <div class="flex items-center gap-2">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-white/70 text-xs font-bold dark:bg-slate-950/35">
              1
            </span>
            <h3 class="text-sm font-bold">{t.catalogHintDefaultTitle}</h3>
          </div>
          <p class="mt-2 text-sm leading-6 opacity-90" set:html={t.catalogHintDefaultDesc} />
          <ul class="mt-3 grid gap-2 sm:grid-cols-3">
            {defaultStateLegend.map((entry) => (
              <li class="flex gap-2.5 rounded-md bg-white/55 px-2.5 py-2 dark:bg-slate-950/25">
                <span class:list={[
                  "mt-1.5 h-2 w-2 shrink-0 rounded-full",
                  entry.dot,
                ]}></span>
                <span class="min-w-0">
                  <span class="block text-xs font-bold leading-5">{entry.label}</span>
                  <span class="block text-xs leading-5 opacity-80">{entry.desc}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {secondaryHints.map((item) => (
            <div class:list={[
              "min-w-0 rounded-lg border p-4",
              item.accent,
            ]}>
              <div class="flex items-center gap-2">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-white/70 text-xs font-bold dark:bg-slate-950/35">
                  {item.num}
                </span>
                <h3 class="text-sm font-bold">{item.title}</h3>
              </div>
              <p class="mt-2 text-sm leading-6 opacity-90" set:html={item.desc} />
            </div>
          ))}
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 dark:border-slate-800 dark:bg-slate-900/55">
        <h3 class="text-sm font-bold text-slate-950 dark:text-white">{t.failureExplainerTitle}</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">
          {t.failureExplainerDesc}
        </p>
      </div>
    </div>

    <div class="space-y-8">
      {categoryModels.map((category) => (
        <CustomHooksCategorySection category={category} t={t} isVi={isVi} />
      ))}
    </div>
  </section>

  <div class="border-t border-slate-200 pt-6 text-center dark:border-slate-800">
    <p class="text-sm text-slate-600 dark:text-slate-400">
      {t.officialDocsText}
      <a
        href="https://docs.claudekit.cc/docs/engineer/configuration/hooks"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 font-medium text-blue-600 hover:underline focus-visible:ring-2 focus-visible:ring-blue-500 dark:text-blue-400"
      >
        {t.officialDocsLink}
        <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </p>
  </div>
</div>

<style>
  /* Inline code chips inside the hint descriptions. The text is injected via
     set:html, so Astro's scoped hashing does not reach it — target it globally
     within the scoped wrapper. */
  .hook-hint-prose :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.05em 0.35em;
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 0.7);
    border: 1px solid rgb(15 23 42 / 0.08);
    white-space: nowrap;
  }
  :global(.dark) .hook-hint-prose :global(code) {
    background: rgb(2 6 23 / 0.45);
    border-color: rgb(255 255 255 / 0.1);
  }
</style>
