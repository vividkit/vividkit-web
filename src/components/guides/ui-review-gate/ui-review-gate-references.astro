---
import type { Language } from '@/i18n';
import { ArrowRight, BookOpenText, CircleSlash2 } from 'lucide-astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const avoidCases = [
  t('Do not use a browser gate for tiny, reversible edits where the diff is easier to read inline.', 'Không cần browser gate cho sửa rất nhỏ, dễ revert, diff đọc inline nhanh hơn.'),
  t('Do not share sensitive plans unless sharing is disabled or your team accepts the URL/short-link privacy model.', 'Không share plan nhạy cảm nếu chưa tắt sharing hoặc team chưa chấp nhận privacy model của URL/short-link.'),
  t('Do not treat approval as a test result. Still run tests, builds, and source checks after the agent changes code.', 'Đừng xem approval là kết quả test. Vẫn phải chạy test, build, và đối chiếu source sau khi agent sửa code.'),
];

const sources = [
  ['Installation guide', 'https://plannotator.ai/docs/getting-started/installation/'],
  ['Plan review lifecycle', 'https://plannotator.ai/docs/commands/plan-review/'],
  ['Hook integration recipes', 'https://plannotator.ai/docs/guides/hook-integration/'],
  ['Remote and devcontainers', 'https://plannotator.ai/docs/guides/remote-and-devcontainers/'],
  ['GitHub repository', 'https://github.com/backnotprop/plannotator'],
];
---

<section class="grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(360px,1fr)]">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
    <div class="flex items-start gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-rose-50 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300">
        <CircleSlash2 class="h-5 w-5" stroke-width={2.2} />
      </span>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-rose-700 dark:text-rose-300">
          {t('When not to use it', 'Khi không nên dùng')}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
          {t('Use a gate only when the pause is worth it', 'Chỉ dùng gate khi đáng dừng lại để review')}
        </h2>
      </div>
    </div>
    <ul class="mt-5 space-y-3">
      {avoidCases.map((item) => (
        <li class="flex gap-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-rose-500"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
    <div class="flex items-start gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-50 text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-300">
        <BookOpenText class="h-5 w-5" stroke-width={2.2} />
      </span>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">
          {t('References', 'Nguồn tham khảo')}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
          {t('Official documentation', 'Tài liệu chính thức')}
        </h2>
      </div>
    </div>
    <div class="mt-5 grid gap-2 sm:grid-cols-2">
      {sources.map(([label, href]) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex min-h-11 items-center justify-between gap-3 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:border-cyan-300 hover:bg-cyan-50 hover:text-cyan-800 dark:border-slate-800 dark:bg-slate-900/55 dark:text-slate-200 dark:hover:border-cyan-500/40 dark:hover:bg-cyan-500/10 dark:hover:text-cyan-200"
        >
          <span>{label}</span>
          <ArrowRight class="h-4 w-4 shrink-0 transition group-hover:translate-x-0.5" stroke-width={2.2} />
        </a>
      ))}
    </div>
  </div>
</section>
