---
import type { Language } from '@/i18n';
import TerminalSnippet from '../TerminalSnippet.astro';
import { Smartphone, Wifi, Wrench } from 'lucide-astro';
import { renderInlineCode } from './inline-code';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';
const t = (en: string, vi: string) => isVi ? vi : en;

const remoteCode = `export PLANNOTATOR_REMOTE=1
export PLANNOTATOR_PORT=9999

# Same Wi-Fi
open http://<host-lan-ip>:9999

# Tailscale Serve example
tailscale serve --bg --tcp=10000 9999
open http://<tailscale-ip>:10000/`;

const troubleshooting = [
  t('Port not listening: start a fresh Plannotator session and check the printed `URL/port`.', 'Port chưa listen: mở session Plannotator mới và kiểm tra `URL/port` in ra terminal.'),
  t('Phone cannot connect: confirm same `Wi-Fi`, firewall rules, or that `Tailscale/VPN` is connected on both devices.', 'Phone không connect: kiểm tra cùng `Wi-Fi`, firewall, hoặc `Tailscale/VPN` đã connect ở cả hai máy.'),
  t('`MagicDNS` fails: use the raw `Tailscale IP` first, then fix DNS later.', '`MagicDNS` lỗi: dùng `Tailscale IP` trước, xử DNS sau.'),
  t('`HTTP` vs `HTTPS`: local Plannotator URLs are usually `HTTP` unless your tunnel adds TLS.', '`HTTP` vs `HTTPS`: URL local của Plannotator thường là `HTTP` trừ khi tunnel thêm TLS.'),
  t('Stale sessions: run `plannotator sessions --clean`, then open a new review.', 'Session cũ: chạy `plannotator sessions --clean`, rồi mở review mới.'),
];
---

<section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-950/75 sm:p-6">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(360px,1fr)]">
    <div>
      <div class="flex items-start gap-3">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-50 text-cyan-700 dark:bg-cyan-500/10 dark:text-cyan-300">
          <Smartphone class="h-5 w-5" stroke-width={2.2} />
        </span>
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-cyan-700 dark:text-cyan-300">
            {t('Mobile approval', 'Approve bằng mobile')}
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 dark:text-white">
            {t('Remote control and Plannotator UI are separate channels', 'Remote control và Plannotator UI là hai kênh riêng')}
          </h2>
        </div>
      </div>

      <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-400">
        {t(
          'Codex or Claude Code mobile can approve agent actions through their own remote-control path. Plannotator approval happens in a browser pointed at the Plannotator server, so the phone must be able to reach that server.',
          'Codex hoặc Claude Code mobile có thể approve hành động agent qua kênh remote-control riêng. Approval của Plannotator diễn ra trong browser trỏ tới server Plannotator, nên phone phải truy cập được server đó.'
        )}
      </p>

      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50/75 p-4 dark:border-slate-800 dark:bg-slate-900/55">
          <Wifi class="h-5 w-5 text-emerald-600 dark:text-emerald-300" stroke-width={2.2} />
          <h3 class="mt-2 text-sm font-bold text-slate-950 dark:text-white">{t('Same Wi-Fi', 'Cùng Wi-Fi')}</h3>
          <p
            class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400"
            set:html={renderInlineCode(t('Open the host LAN URL from the phone. `127.0.0.1` will not work because it points to the phone itself.', 'Mở host LAN URL trên phone. `127.0.0.1` không chạy vì nó trỏ về chính phone.'))}
          ></p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-slate-50/75 p-4 dark:border-slate-800 dark:bg-slate-900/55">
          <Wrench class="h-5 w-5 text-amber-600 dark:text-amber-300" stroke-width={2.2} />
          <h3 class="mt-2 text-sm font-bold text-slate-950 dark:text-white">{t('Different network', 'Khác network')}</h3>
          <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-400">
            {t('Use Tailscale, VPN, or a tunnel. The link works only while that Plannotator session is running.', 'Dùng Tailscale, VPN, hoặc tunnel. Link chỉ chạy khi session Plannotator đó còn sống.')}
          </p>
        </div>
      </div>
    </div>

    <div class="space-y-4">
      <TerminalSnippet code={remoteCode} label="mobile remote access" compact />
      <div class="rounded-xl border border-slate-200 bg-slate-50/75 p-4 dark:border-slate-800 dark:bg-slate-900/55">
        <h3 class="text-sm font-bold text-slate-950 dark:text-white">{t('Troubleshooting checklist', 'Checklist debug')}</h3>
        <ul class="mt-3 space-y-2">
          {troubleshooting.map((item) => (
            <li class="flex gap-2 text-sm leading-6 text-slate-600 dark:text-slate-400">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-500"></span>
              <span set:html={renderInlineCode(item)}></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
