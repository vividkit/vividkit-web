---
// Workflows Guide - Stable section: workflow cards with embedded flags
import { useTranslations } from '@/i18n/utils';
import { getLangFromUrl, type Language } from '@/i18n';
import WorkflowsWorkflowCard from './workflows-workflow-card.astro';

interface Props {
  workflows: any[];
  lang?: Language;
}

const { workflows, lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---

<div id="wf-categories-stable" class="space-y-6">
  <!-- Workflow Cards -->
  <div class="grid grid-cols-1 gap-6">
    {workflows.map((workflow) => (
      <WorkflowsWorkflowCard workflow={workflow} lang={currentLang} />
    ))}
  </div>
</div>
