---
import { getLangFromUrl, type Language } from '@/i18n';
import { AGENTKIT_MIGRATION_MAPPING_BY_LOCALE } from '@/data/guides/agentkit/agentkit-migration-mapping';
import AgentKitCommandMapping from './agentkit/agentkit-command-mapping.astro';
import AgentKitHero from './agentkit/agentkit-hero.astro';
import AgentKitHubNav from './agentkit/agentkit-hub-nav.astro';
import AgentKitLegacySkillCleanup from './agentkit/agentkit-legacy-skill-cleanup.astro';
import AgentKitMigrationChecklist from './agentkit/agentkit-migration-checklist.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const mappingRows = AGENTKIT_MIGRATION_MAPPING_BY_LOCALE[currentLang];
const includeStage7Details = import.meta.env.AGENTKIT_INCLUDE_STAGE7_DETAILS === 'true';
---

<article
  class="mt-6 pb-8"
  data-agentkit-lifecycle-guide
  data-agentkit-channel-root
  data-agentkit-surface="hub"
  data-agentkit-locale={currentLang}
  data-agentkit-active-channel="stable"
  data-public-release-channel="stable"
  data-stage-seven-details={includeStage7Details ? 'published' : 'hold'}
>
  <AgentKitChannelSwitcher lang={currentLang} />
  <div data-agentkit-stable-facts>
    <AgentKitHero lang={currentLang} />
    <AgentKitHubNav lang={currentLang} />
    <AgentKitMigrationChecklist lang={currentLang} />
    <AgentKitCommandMapping lang={currentLang} rows={mappingRows} />
    <AgentKitLegacySkillCleanup lang={currentLang} includeStage7Details={includeStage7Details} />
  </div>
</article>
