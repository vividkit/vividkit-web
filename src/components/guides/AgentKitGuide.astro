---
import { getLangFromUrl, type Language } from '@/i18n';
import { getAgentKitSsrChannelState } from '@/data/guides/agentkit/agentkit-channel-policy.mjs';
import AgentKitAdvancedReferences from './agentkit/agentkit-advanced-references.astro';
import AgentKitHeroAndPathSelector from './agentkit/agentkit-hero-and-path-selector.astro';
import AgentKitMigrationChecklist from './agentkit/agentkit-migration-checklist.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';
import AgentKitReaderDecisionNavigation from './agentkit/agentkit-reader-decision-navigation.astro';
import AgentKitRecoveryAndSupport from './agentkit/agentkit-recovery-and-support.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const includeStage7Details = import.meta.env.AGENTKIT_INCLUDE_STAGE7_DETAILS === 'true';
const publicationStatus = import.meta.env.AGENTKIT_PUBLICATION_STATUS ?? 'hold';
const channelState = getAgentKitSsrChannelState(Astro.url.search, publicationStatus);
---

<article
  class="mt-6 pb-8"
  data-agentkit-channel-root
  data-agentkit-surface="hub"
  data-agentkit-locale={currentLang}
  data-agentkit-requested-channel={channelState.requestedChannel}
  data-agentkit-active-channel={channelState.activeChannel}
  data-agentkit-channel-status={channelState.status}
  data-stage-seven-details={includeStage7Details ? 'published' : 'hold'}
>
  <AgentKitHeroAndPathSelector lang={currentLang} />
  <AgentKitChannelSwitcher lang={currentLang} />
  <div data-agentkit-stable-facts>
    <AgentKitReaderDecisionNavigation lang={currentLang} />
    <AgentKitMigrationChecklist lang={currentLang} includeStage7Details={includeStage7Details} />
    <AgentKitRecoveryAndSupport lang={currentLang} />
    <AgentKitAdvancedReferences lang={currentLang} includeStage7Details={includeStage7Details} />
  </div>
</article>
