---
import { getLangFromUrl, type Language } from '@/i18n';
import { AGENTKIT_CLI_FACTS } from '@/data/guides/agentkit/agentkit-cli-facts';
import { AGENTKIT_MIGRATION_MAPPING_BY_LOCALE } from '@/data/guides/agentkit/agentkit-migration-mapping';
import { AGENTKIT_SKILL_FACTS } from '@/data/guides/agentkit/agentkit-skill-facts';
import { AGENTKIT_TARGET_CAPABILITIES } from '@/data/guides/agentkit/agentkit-target-capabilities';
import AgentKitCommandMapping from './agentkit/agentkit-command-mapping.astro';
import AgentKitCompatibilityAndTroubleshooting from './agentkit/agentkit-compatibility-and-troubleshooting.astro';
import AgentKitContinuityFaq from './agentkit/agentkit-continuity-faq.astro';
import AgentKitDesktopAppOverview from './agentkit/agentkit-desktop-app-overview.astro';
import AgentKitHeroAndPathSelector from './agentkit/agentkit-hero-and-path-selector.astro';
import AgentKitKitTargets from './agentkit/agentkit-kit-targets.astro';
import AgentKitLegacySkillCleanup from './agentkit/agentkit-legacy-skill-cleanup.astro';
import AgentKitMigrationChecklist from './agentkit/agentkit-migration-checklist.astro';
import AgentKitOperatorAttestation from './agentkit/agentkit-operator-attestation.astro';
import AgentKitChannelSwitcher from './agentkit/agentkit-channel-switcher.astro';
import AgentKitScenarioCommandGuide from './agentkit/agentkit-scenario-command-guide.astro';

interface Props {
  lang?: Language;
}

const { lang } = Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const mappingRows = AGENTKIT_MIGRATION_MAPPING_BY_LOCALE[currentLang];
const includeStage7Details = import.meta.env.AGENTKIT_INCLUDE_STAGE7_DETAILS === 'true';
---

<article
  class="mt-6 pb-8"
  data-agentkit-lifecycle-guide
  data-agentkit-channel-root
  data-agentkit-surface="hub"
  data-agentkit-locale={currentLang}
  data-agentkit-active-channel="stable"
  data-public-release-channel="stable"
  data-stage-seven-details={includeStage7Details ? 'published' : 'hold'}
>
  <AgentKitChannelSwitcher lang={currentLang} />
  <div data-agentkit-stable-facts>
    <AgentKitHeroAndPathSelector lang={currentLang} />
    <AgentKitContinuityFaq lang={currentLang} />
    <AgentKitMigrationChecklist lang={currentLang} />
    <AgentKitOperatorAttestation lang={currentLang} />
    <AgentKitDesktopAppOverview lang={currentLang} />
    <AgentKitScenarioCommandGuide lang={currentLang} />
    <AgentKitKitTargets
      lang={currentLang}
      cliFacts={AGENTKIT_CLI_FACTS}
      skillFacts={AGENTKIT_SKILL_FACTS}
      targets={AGENTKIT_TARGET_CAPABILITIES}
    />
    <AgentKitLegacySkillCleanup lang={currentLang} includeStage7Details={includeStage7Details} />
    <AgentKitCommandMapping lang={currentLang} rows={mappingRows} />
    <AgentKitCompatibilityAndTroubleshooting lang={currentLang} />
  </div>
</article>

<script>
  import { initializeAgentKitLifecycleGuides } from '@/scripts/agentkit-lifecycle-guide-controller';

  initializeAgentKitLifecycleGuides();
  document.addEventListener('astro:page-load', initializeAgentKitLifecycleGuides);
</script>
