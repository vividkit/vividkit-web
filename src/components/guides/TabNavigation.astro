        href: '/guides/donate',
      },
    ],
  },
];

const insideClaudeKitArticleTabs = [
  'inside-claudekit-plan-modes',
  'inside-claudekit-frontend-design',
  'inside-claudekit-getting-started',
  'inside-claudekit-guard-rails',
];

const flatNavItems = navSections.flatMap((section) => section.items);
---

<style>
  /* Custom scrollbar for sidebar */
  aside::-webkit-scrollbar {
    width: 5px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background: rgba(156, 163, 175, 0.3);
    border-radius: 20px;
  }

  /* Hide scrollbar for mobile nav */
  .mobile-nav-scroll::-webkit-scrollbar {
    display: none;
  }
  .mobile-nav-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<!-- Sidebar Navigation (Desktop) -->
<aside data-guide-sidebar class="hidden lg:block sticky top-32 self-start max-h-[calc(100vh-10rem)] overflow-y-auto rounded-2xl glass-card border border-slate-200/50 dark:border-slate-800/50 backdrop-blur-md">
  <div class="p-4">
    <!-- Sidebar Header -->
    <div class="px-4 mb-4 mt-2">
      <h2 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
        {t('guides.sidebar.title')}
      </h2>
    </div>

    <!-- Navigation Items by Section -->
    <nav class="space-y-4">
      {navSections.map((section) => (
        <div>
          <!-- Section Header -->
          <div class="px-4 py-1.5 text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider">
            {section.label}
          </div>
          <!-- Section Items -->
          <div class="space-y-0.5">
            {section.items.map((item) => (
              (() => {
                const isItemActive = activeTab === item.id || (item.id === 'inside-claudekit' && insideClaudeKitArticleTabs.includes(activeTab));

                return (
                  <div class="space-y-1">
                    <a
                      href={translatePath(item.href)}
                      data-active-guide-item={isItemActive ? 'true' : undefined}
                      class={`group flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 ${
                        isItemActive
                          ? 'bg-blue-50 dark:bg-blue-900/20 text-blue-600 dark:text-blue-400 shadow-sm'
                          : 'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-white/5 hover:text-slate-900 dark:hover:text-slate-200'
                      }`}
                    >
                      <span class={`text-lg transition-transform duration-200 ${isItemActive ? 'scale-110' : 'group-hover:scale-110'}`}>
                        <Fragment set:html={item.icon} />
                      </span>
                      <span>{item.label}</span>
                      {isItemActive && (
                        <div class="ml-auto w-1.5 h-1.5 rounded-full bg-blue-500 dark:bg-blue-400 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></div>
                      )}
                    </a>
                  </div>
                );
              })()
            ))}
          </div>
        </div>
      ))}
    </nav>

  </div>
</aside>

<!-- Mobile Navigation (Sticky Top) -->
<div class="lg:hidden sticky top-20 z-40 -mx-4 sm:-mx-6 lg:-mx-8 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-y border-slate-200/50 dark:border-slate-800/50 px-4 sm:px-6 lg:px-8 py-3 mb-8 overflow-hidden relative">
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-8 bg-gradient-to-r from-white via-white/90 to-transparent dark:from-slate-900 dark:via-slate-900/90"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-8 bg-gradient-to-l from-white via-white/90 to-transparent dark:from-slate-900 dark:via-slate-900/90"></div>
  <div class="mobile-nav-scroll flex w-full max-w-full gap-2 overflow-x-auto overflow-y-hidden no-scrollbar [contain:layout_paint]">
    {flatNavItems.map((item) => {
      const isItemActive = activeTab === item.id || (item.id === 'inside-claudekit' && insideClaudeKitArticleTabs.includes(activeTab));

      return (
        <a
          href={translatePath(item.href)}
          data-active-mobile-guide-item={isItemActive ? 'true' : undefined}
          class={`flex min-h-11 items-center gap-2 rounded-full px-3 py-2 text-sm font-medium whitespace-nowrap transition-all focus-visible:ring-2 focus-visible:ring-blue-500 ${
            isItemActive
              ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20'
              : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
          }`}
        >
          {item.icon ? <span><Fragment set:html={item.icon} /></span> : <span class="h-1.5 w-1.5 rounded-full bg-current"></span>}
          {item.label}
        </a>
      );
    })}
  </div>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .mask-gradient {
    -webkit-mask-image: linear-gradient(to right, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, black 95%, transparent 100%);
  }
</style>

<script>
  function keepActiveGuideItemVisible() {
    const sidebar = document.querySelector('[data-guide-sidebar]');
    const active = sidebar?.querySelector('[data-active-guide-item="true"]');
    if (sidebar instanceof HTMLElement && active instanceof HTMLElement) {
      const sidebarRect = sidebar.getBoundingClientRect();
      const activeRect = active.getBoundingClientRect();
      const activeOutside = activeRect.top < sidebarRect.top || activeRect.bottom > sidebarRect.bottom;
      if (activeOutside) {
        sidebar.scrollTop += activeRect.top - sidebarRect.top - (sidebar.clientHeight / 2) + (active.clientHeight / 2);
      }
    }

    const mobileNav = document.querySelector('.mobile-nav-scroll');
    const activeMobile = mobileNav?.querySelector('[data-active-mobile-guide-item="true"]');
    if (mobileNav instanceof HTMLElement && activeMobile instanceof HTMLElement) {
      const navRect = mobileNav.getBoundingClientRect();
      const itemRect = activeMobile.getBoundingClientRect();
      const itemOutside = itemRect.left < navRect.left || itemRect.right > navRect.right;
      if (itemOutside) {
        mobileNav.scrollLeft += itemRect.left - navRect.left - (mobileNav.clientWidth / 2) + (activeMobile.clientWidth / 2);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', keepActiveGuideItemVisible);
  document.addEventListener('astro:page-load', keepActiveGuideItemVisible);
</script>
