---
import type { Language } from '@/i18n';
import { getAgentKitCliFact } from '@/data/guides/agentkit/agentkit-cli-facts';
import TerminalSnippet from '../TerminalSnippet.astro';

interface Props { lang: Language }
const { lang } = Astro.props;
const isVi = lang === 'vi';
const fact = (id: string) => {
  const value = getAgentKitCliFact(id);
  if (!value) throw new Error(`Missing canonical AgentKit CLI fact: ${id}`);
  return value;
};
const selfUpdate = fact('self-update');
const projectUpdate = fact('update');
const kitRefresh = fact('kit-refresh');
const withoutConfirmation = (command: string) => command.replace(/\s+--yes\b/, '');

const layers = [
  { title: 'CLI binary', command: `${selfUpdate.command} --check`, apply: `${selfUpdate.command} --yes`, detail: isVi ? 'Kiểm tra rồi cập nhật chính binary ak.' : 'Check and then update the ak binary itself.' },
  { title: 'Project files', command: `${projectUpdate.command} --dry-run`, apply: projectUpdate.command, detail: isVi ? 'Preview file do AK quản lý; chỉ apply sau khi đọc diff và xác nhận rollback.' : 'Preview AK-owned files; apply only after reading the diff and confirming rollback.' },
  { title: 'Installed kit', command: withoutConfirmation(kitRefresh.command), apply: kitRefresh.command, detail: isVi ? 'Refresh nội dung kit ở project scope; không chuyển sang global trong pilot.' : 'Refresh kit content at project scope; do not move to global scope during the pilot.' },
];
---

<section id="update-layers" class="scroll-mt-28 space-y-5">
  <div>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">04 · lifecycle</p>
    <h2 class="mt-2 text-2xl font-bold text-slate-950 dark:text-white">{isVi ? 'Ba lớp update độc lập' : 'Three independent update layers'}</h2>
  </div>
  <div class="grid gap-4 lg:grid-cols-3">
    {layers.map((layer) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900">
        <h3 class="font-semibold text-slate-950 dark:text-white">{layer.title}</h3>
        <p class="mt-2 min-h-12 text-sm leading-6 text-slate-600 dark:text-slate-300">{layer.detail}</p>
        <div class="mt-4"><TerminalSnippet code={layer.command} compact label="preview/check" /></div>
        <details class="mt-3 text-sm text-slate-600 dark:text-slate-300">
          <summary class="cursor-pointer rounded-md font-medium text-amber-700 transition-colors duration-200 hover:text-amber-900 focus-visible:ring-2 focus-visible:ring-amber-500 focus-visible:ring-offset-2 active:text-amber-600 dark:text-amber-300 dark:hover:text-amber-100">{isVi ? 'Lệnh apply sau review' : 'Apply after review'}</summary>
          <code class="mt-2 block overflow-x-auto rounded-lg bg-slate-100 p-3 text-slate-700 dark:bg-slate-800/90 dark:text-slate-200">{layer.apply}</code>
        </details>
      </article>
    ))}
  </div>
</section>

<section class="grid gap-4 lg:grid-cols-2">
  <aside class="rounded-2xl border border-rose-200 bg-rose-50 p-5 dark:border-rose-400/20 dark:bg-rose-950/20">
    <h2 class="text-lg font-bold text-rose-900 dark:text-rose-100">{isVi ? 'Trước lệnh destructive' : 'Before destructive commands'}</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-rose-800 dark:text-rose-200">
      <li>{isVi ? 'Chạy dry-run hoặc check và đọc diff.' : 'Run dry-run or check and read the diff.'}</li>
      <li>{isVi ? 'Xác nhận snapshot/backup và rollback path.' : 'Confirm the snapshot/backup and rollback path.'}</li>
      <li>{isVi ? 'Không dùng --force hoặc --yes trong command chưa review.' : 'Do not add --force or --yes to an unreviewed command.'}</li>
    </ul>
  </aside>
  <aside class="rounded-2xl border border-cyan-200 bg-cyan-50 p-5 dark:border-cyan-400/20 dark:bg-cyan-950/20">
    <h2 class="text-lg font-bold text-cyan-900 dark:text-cyan-100">{isVi ? 'CK user?' : 'Coming from CK?'}</h2>
    <p class="mt-3 text-sm leading-6 text-cyan-800 dark:text-cyan-200">{isVi ? 'Giữ CK làm rollback cho đến khi ak, account và target kit đều được verify. Sau đó mới gỡ package cũ và xử lý shim/PATH.' : 'Keep CK as rollback until ak, account, and target kit are verified. Only then remove the old package and resolve shim/PATH collisions.'}</p>
    <a href={isVi ? '/vi/guides/agentkit' : '/guides/agentkit'} class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-cyan-700 px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 hover:bg-cyan-800 focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 active:bg-cyan-900">{isVi ? 'Mở migration checklist' : 'Open migration checklist'}</a>
  </aside>
</section>
