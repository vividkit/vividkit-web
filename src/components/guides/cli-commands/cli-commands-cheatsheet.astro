---
import type { Language } from '@/i18n';
import { cliCommandsCheatsheet } from '@/data/guides/cli-commands-cheatsheet';
import { CLI_COMMAND_CATEGORY_CONFIGS } from './cli-command-category-config';
import CliCommandCategorySection from './cli-command-category-section.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<div class="space-y-5">
  {CLI_COMMAND_CATEGORY_CONFIGS.map((category, index) => (
    <CliCommandCategorySection
      category={category}
      commands={cliCommandsCheatsheet.filter((command) => command.category === category.id)}
      index={index}
      lang={lang}
    />
  ))}
</div>
