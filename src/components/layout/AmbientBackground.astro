---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
import PixelBlast from "@/components/PixelBlast";
---

<div
  class={`fixed inset-0 pointer-events-none overflow-hidden aurora-bg ${className}`}
>
  <PixelBlast
    client:only="react"
    variant="square"
    pixelSize={4}
    color="#2070e7"
    patternScale={2}
    patternDensity={1}
    pixelSizeJitter={0}
    enableRipples
    rippleSpeed={0.4}
    rippleThickness={0.12}
    rippleIntensityScale={1.5}
    liquid={false}
    liquidStrength={0.12}
    liquidRadius={1.2}
    liquidWobbleSpeed={5}
    speed={0.5}
    edgeFade={0.25}
    transparent
  />
</div>
